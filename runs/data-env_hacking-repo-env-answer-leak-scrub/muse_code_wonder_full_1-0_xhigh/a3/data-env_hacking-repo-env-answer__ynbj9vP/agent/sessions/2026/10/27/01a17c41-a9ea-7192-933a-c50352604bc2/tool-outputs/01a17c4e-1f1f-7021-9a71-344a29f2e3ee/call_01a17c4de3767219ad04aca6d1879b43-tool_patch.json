{"files":[{"hunks":[{"lines":["         remove_path(tmp)"," "," ","+# --------------------------------------------------------- repo discovery","+","+def gitlink_map(ctx):","+    \"\"\"Map submodule path -> recorded commit for one repository.\"\"\"","+    links = {}","+    if not ctx.work_tree:","+        return links","+    out = ctx.out([\"ls-files\", \"-s\", \"-z\"])","+    for entry in out.split(\"\\x00\"):","+        if not entry or \"\\t\" not in entry:","+            continue","+        meta, path = entry.split(\"\\t\", 1)","+        parts = meta.split()","+        if len(parts) >= 2 and parts[0] == \"160000\":","+            links[path] = parts[1]","+    return links","+","+","+class Target:","+    def __init__(self, ctx, extra_tips=(), include_head=True, is_main=False):","+        self.ctx = ctx","+        self.extra_tips = set(extra_tips)","+        self.include_head = include_head","+        self.is_main = is_main","+","+","+def collect_targets(repo_dir, base_commit):","+    targets = {}   # common_dir -> Target","+","+    def add(ctx, **kw):","+        key = ctx.common_dir","+        if key in targets:","+            t = targets[key]","+            t.extra_tips |= set(kw.get(\"extra_tips\", ()))","+            t.include_head = t.include_head or kw.get(\"include_head\", True)","+            t.is_main = t.is_main or kw.get(\"is_main\", False)","+            return t","+        t = Target(ctx, **kw)","+        targets[key] = t","+        return t","+","+    main_ctx = None","+    try:","+        main_ctx = Ctx(repo_dir)","+        add(main_ctx, extra_tips=[base_commit] if base_commit else [],","+            is_main=True)","+    except Fail:","+        log(\"no git repository at %s; scanning for nested repositories\"","+            % repo_dir)","+    scan_root = (main_ctx.work_tree if main_ctx and main_ctx.work_tree","+                 else repo_dir)","+    # Nested worktrees (submodules or independent clones inside the tree).","+    nested = []","+    if os.path.isdir(scan_root):","+        for dp, dirnames, filenames in os.walk(scan_root):","+            # Do not follow symlinked directories out of the tree.","+            dirnames[:] = [d for d in dirnames","+                           if not os.path.islink(os.path.join(dp, d))]","+            if \".git\" in dirnames:","+                if os.path.realpath(dp) != os.path.realpath(scan_root):","+                    nested.append(dp)","+                dirnames.remove(\".git\")","+            elif \".git\" in filenames:","+                if os.path.realpath(dp) != os.path.realpath(scan_root):","+                    nested.append(dp)","+    for path in nested:","+        try:","+            add(Ctx(path))","+        except Fail as e:","+            log(\"warning: skipping nested path %s (%s)\" % (path, e))","+    # Standalone submodule gitdirs under <commondir>/modules/**.","+    for t in list(targets.values()):","+        modules = os.path.join(t.ctx.common_dir, \"modules\")","+        if not os.path.isdir(modules):","+            continue","+        for dp, dirnames, _fn in os.walk(modules):","+            if os.path.isfile(os.path.join(dp, \"HEAD\")) and os.path.isdir(","+                    os.path.join(dp, \"objects\")):","+                try:","+                    ctx = Ctx(dp, git_dir_hint=dp)","+                except Fail:","+                    continue","+                if ctx.common_dir in targets:","+                    continue","+                add(ctx, include_head=bool(ctx.work_tree))","+                dirnames[:] = [d for d in dirnames if d == \"modules\"]","+    # Recorded submodule commits become extra tips for their repositories.","+    for t in list(targets.values()):","+        links = gitlink_map(t.ctx)","+        if not links or not t.ctx.work_tree:","+            continue","+        for rel, oid in links.items():","+            sub_wt = os.path.realpath(os.path.join(t.ctx.work_tree, rel))","+            for other in targets.values():","+                if other is t:","+                    continue","+                if other.ctx.work_tree == sub_wt:","+                    other.extra_tips.add(oid)","+                    break","+                # Standalone module gitdir whose configured worktree matches.","+                r = other.ctx.git([\"config\", \"--get\", \"core.worktree\"],","+                                  check=False)","+                if r.returncode == 0:","+                    wt = resolve_rel(other.ctx.git_dir, r.stdout.decode())","+                    if wt == sub_wt:","+                        other.extra_tips.add(oid)","+                        if not os.path.isdir(sub_wt) or not other.ctx.work_tree:","+                            other.include_head = False","+                        break","+    return list(targets.values())","+","+","+def main(argv):","+    if len(argv) != 3:","+        print(\"usage: sanitize <repo_dir> <spec.json>\", file=sys.stderr)","+        return 2","+    repo_dir = os.path.abspath(argv[1])","+    spec_path = argv[2]","+    if not os.path.isdir(repo_dir):","+        print(\"sanitize: repo_dir is not a directory: %s\" % repo_dir,","+              file=sys.stderr)","+        return 2","+    try:","+        with open(spec_path) as f:","+            spec = json.load(f)","+    except (OSError, ValueError) as e:","+        print(\"sanitize: cannot read spec.json: %s\" % e, file=sys.stderr)","+        return 2","+    base_commit = spec.get(\"base_commit\") or None","+    try:","+        targets = collect_targets(repo_dir, base_commit)","+        if not targets:","+            log(\"no git repositories found under %s; nothing to do\" % repo_dir)","+            return 0","+        # Nested repositories first: the main repo does not depend on them,","+        # and a failure there leaves the main repo untouched.","+        ordered = sorted(targets, key=lambda t: (t.is_main,","+                                                  t.ctx.common_dir))","+        for t in ordered:","+            sanitize_repo(t.ctx, sorted(x for x in t.extra_tips if x),","+                          include_head=t.include_head)","+    except Fail as e:","+        print(\"sanitize: %s\" % e, file=sys.stderr)","+        return 1","+    return 0","+","+","+if __name__ == \"__main__\":","+    sys.exit(main(sys.argv))","+","+"," "," "," "],"newLines":157,"newStart":999,"oldLines":6,"oldStart":999}],"path":"/app/sanitize/sanitize"}]}