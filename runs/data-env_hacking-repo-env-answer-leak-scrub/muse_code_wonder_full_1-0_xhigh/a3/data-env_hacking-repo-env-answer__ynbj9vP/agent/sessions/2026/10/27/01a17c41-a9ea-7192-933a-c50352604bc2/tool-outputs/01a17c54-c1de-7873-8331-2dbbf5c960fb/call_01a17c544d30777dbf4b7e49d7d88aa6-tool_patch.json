{"files":[{"hunks":[{"lines":["+import os, subprocess, json, shutil, sys, hashlib","+ROOT=\"/tmp/synthsuite\"; shutil.rmtree(ROOT,ignore_errors=True); os.makedirs(ROOT)","+ENV=dict(os.environ); ENV.update({\"GIT_AUTHOR_NAME\":\"t\",\"GIT_AUTHOR_EMAIL\":\"t@t\",\"GIT_COMMITTER_NAME\":\"t\",\"GIT_COMMITTER_EMAIL\":\"t@t\",\"HOME\":ROOT,\"GIT_CONFIG_GLOBAL\":os.devnull,\"GIT_CONFIG_SYSTEM\":os.devnull})","+def run(cwd,*a,check=True,input=None):","+    r=subprocess.run(a,cwd=cwd,env=ENV,capture_output=True,text=True,input=input)","+    if check and r.returncode: print(\"FAIL cmd\",a,r.stdout,r.stderr); sys.exit(1)","+    return r","+def g(cwd,*a,check=True): return run(cwd,\"git\",*a,check=check)","+def sanitize(repo,spec):","+    r=subprocess.run([\"/app/sanitize/sanitize\",repo,spec],capture_output=True,text=True,env=ENV)","+    return r","+def spec(path,base):","+    json.dump({\"instance_id\":\"x\",\"repo\":\"x/x\",\"base_commit\":base},open(path,\"w\"))","+def mkrepo(path,n=4):","+    os.makedirs(path); g(path,\"init\",\"-q\",\"-b\",\"main\")","+    heads=[]","+    for i in range(1,n+1):","+        open(os.path.join(path,\"f.py\"),\"w\").write(f\"x={i}\\n\")","+        g(path,\"add\",\".\"); g(path,\"commit\",\"-qm\",f\"c{i}\"); heads.append(g(path,\"rev-parse\",\"HEAD\").stdout.strip())","+    return heads","+fails=[]","+def check(cond,msg):","+    print((\"  ok \" if cond else \"  FAIL \")+msg)","+    if not cond: fails.append(msg)","+","+print(\"A detached HEAD, future branch+remote\")","+d=ROOT+\"/a\"; heads=mkrepo(d,4); base,gold=heads[1],heads[3]","+g(d,\"tag\",\"vPast\",heads[0]); g(d,\"tag\",\"vFuture\",heads[3])","+g(d,\"remote\",\"add\",\"origin\",\"https://example.com/r.git\"); g(d,\"update-ref\",\"refs/remotes/origin/main\",gold)","+g(d,\"config\",\"branch.main.remote\",\"origin\"); g(d,\"config\",\"branch.main.merge\",\"refs/heads/main\")","+g(d,\"checkout\",\"-q\",\"--detach\",base)","+desc=g(d,\"describe\",\"--tags\",\"--long\",\"--always\").stdout","+spec(ROOT+\"/a.json\",base); r=sanitize(d,ROOT+\"/a.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0\")","+check(g(d,\"rev-parse\",\"HEAD\").stdout.strip()==base,\"HEAD same\")","+check(g(d,\"symbolic-ref\",\"-q\",\"HEAD\",check=False).returncode!=0,\"still detached\")","+check(g(d,\"branch\",\"--format=%(refname)\").stdout.strip()==\"\",\"future branch deleted\")","+check(g(d,\"tag\",\"--list\").stdout.split()==[\"vPast\"],\"past tag kept only\")","+check(g(d,\"remote\").stdout.strip()==\"\",\"remote gone\")","+check(g(d,\"cat-file\",\"-t\",gold,check=False).returncode!=0,\"gold object gone\")","+check(g(d,\"describe\",\"--tags\",\"--long\",\"--always\").stdout==desc,f\"describe same {desc.strip()}\")","+","+print(\"B unmerged index + MERGE_HEAD ancestor\")","+d=ROOT+\"/b\"; heads=mkrepo(d,2); base=heads[1]","+open(d+\"/f.py\",\"w\").write(\"side\\n\"); g(d,\"checkout\",\"-qb\",\"side\"); g(d,\"commit\",\"-qam\",\"side change\")","+side=g(d,\"rev-parse\",\"HEAD\").stdout.strip()","+g(d,\"checkout\",\"-q\",\"main\"); open(d+\"/f.py\",\"w\").write(\"main\\n\"); g(d,\"commit\",\"-qam\",\"main change\")","+base=g(d,\"rev-parse\",\"HEAD\").stdout.strip()","+# side is descendant of old base but sibling of new base -> our rule drops it (not ancestor of tips). Use merge with commit whose parent... instead rebuild: skip expectations about side kept; create conflict then check sanitizer handles unmerged without losing stages that reference blobs... side blob is stage3.","+r=g(d,\"merge\",\"side\",check=False)","+ls_before=g(d,\"ls-files\",\"-s\").stdout; st_before=g(d,\"status\",\"--porcelain\").stdout","+spec(ROOT+\"/b.json\",base); r=sanitize(d,ROOT+\"/b.json\"); print(r.stderr.strip())","+print(\"   note: merge side tip is not ancestor of HEAD, sanitizer may drop MERGE_HEAD; stages preserved is the check that matters\")","+check(r.returncode==0,\"rc0 unmerged\")","+check(g(d,\"ls-files\",\"-s\").stdout==ls_before,\"unmerged ls-files stages preserved\")","+# stage blobs present","+for line in ls_before.splitlines():","+    oid=line.split()[1]; check(g(d,\"cat-file\",\"-e\",oid,check=False).returncode==0,f\"stage blob {oid[:7]} present\")","+","+print(\"C stash based on base\")","+d=ROOT+\"/c\"; heads=mkrepo(d,3); base=heads[1]; gold=heads[2]","+g(d,\"reset\",\"--hard\",\"-q\",base)","+open(d+\"/f.py\",\"w\").write(\"stash-work\\n\"); open(d+\"/new.py\",\"w\").write(\"n=1\\n\"); g(d,\"add\",\"new.py\")","+g(d,\"stash\",\"push\",\"-q\",\"-m\",\"builder stash\")","+spec(ROOT+\"/c.json\",base); r=sanitize(d,ROOT+\"/c.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 stash\")","+sl=g(d,\"stash\",\"list\").stdout; check(\"builder stash\" in sl,\"stash listed\")","+r2=g(d,\"stash\",\"pop\",check=False); check(r2.returncode==0,\"stash pop works: \"+r2.stderr[:200])","+check(open(d+\"/f.py\").read()==\"stash-work\\n\",\"stashed worktree content back\")","+check(g(d,\"cat-file\",\"-t\",gold,check=False).returncode!=0,\"future object gone (stash case)\")","+","+print(\"D initialized submodule with future history\")","+subsrc=ROOT+\"/subsrc\"; sheads=mkrepo(subsrc,3)","+d=ROOT+\"/d\"; heads=mkrepo(d,2); base=heads[1]","+g(d,\"-c\",\"protocol.file.allow=always\",\"submodule\",\"add\",\"-q\",subsrc,\"sub\")","+g(d+\"/sub\",\"checkout\",\"-q\",sheads[1])","+g(d,\"add\",\".\"); g(d,\"commit\",\"-qm\",\"add sub at middle\"); base=g(d,\"rev-parse\",\"HEAD\").stdout.strip()","+open(d+\"/sub/f.py\",\"a\").write(\"# dirty sub\\n\")","+substatus_before=g(d,\"submodule\",\"status\").stdout; status_before=g(d,\"status\",\"--porcelain\").stdout","+spec(ROOT+\"/d.json\",base); r=sanitize(d,ROOT+\"/d.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 submodule\")","+check(g(d+\"/sub\",\"rev-parse\",\"HEAD\").stdout.strip()==sheads[1],\"sub HEAD same\")","+check(g(d+\"/sub\",\"cat-file\",\"-t\",sheads[2],check=False).returncode!=0,\"sub future object gone\")","+check(g(d,\"submodule\",\"status\").stdout==substatus_before,\"submodule status same\")","+check(open(d+\"/sub/f.py\").read().endswith(\"# dirty sub\\n\"),\"sub dirty file preserved\")","+","+print(\"E shallow clone\")","+src=ROOT+\"/esrc\"; heads=mkrepo(src,6)","+d=ROOT+\"/e\"; run(ROOT,\"git\",\"clone\",\"-q\",\"--depth\",\"3\",\"file://\"+src,d)","+base=g(d,\"rev-parse\",\"HEAD\").stdout.strip()","+cnt=g(d,\"rev-list\",\"--count\",\"HEAD\").stdout","+spec(ROOT+\"/e.json\",base); r=sanitize(d,ROOT+\"/e.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 shallow\")","+check(g(d,\"rev-parse\",\"--is-shallow-repository\").stdout.strip()==\"true\",\"still shallow\")","+check(g(d,\"rev-list\",\"--count\",\"HEAD\").stdout==cnt,\"shallow count same\")","+check(g(d,\"fsck\",\"--connectivity-only\",check=False).returncode==0,\"shallow fsck ok\")","+","+print(\"F no git repo\")","+d=ROOT+\"/f\"; os.makedirs(d); open(d+\"/x.txt\",\"w\").write(\"hi\\n\"); spec(ROOT+\"/f.json\",\"0\"*40)","+r=sanitize(d,ROOT+\"/f.json\"); print(r.stderr.strip())","+check(r.returncode==0 and open(d+\"/x.txt\").read()==\"hi\\n\",\"no-git no-op rc0\")","+","+print(\"G empty repo with staged file\")","+d=ROOT+\"/g\"; os.makedirs(d); g(d,\"init\",\"-q\",\"-b\",\"main\"); open(d+\"/x.py\",\"w\").write(\"x=1\\n\"); g(d,\"add\",\"x.py\")","+st_before=g(d,\"status\",\"--porcelain\").stdout; spec(ROOT+\"/g.json\",\"0\"*40)","+r=sanitize(d,ROOT+\"/g.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 empty\")","+check(g(d,\"status\",\"--porcelain\").stdout==st_before,\"empty staged preserved\")","+","+print(\"H shared/alternates clone becomes self-contained\")","+src=ROOT+\"/hsrc\"; heads=mkrepo(src,4); base=heads[1]","+d=ROOT+\"/h\"; run(ROOT,\"git\",\"clone\",\"-q\",\"--shared\",src,d); g(d,\"checkout\",\"-q\",\"-B\",\"main\",base)","+check(os.path.exists(d+\"/.git/objects/info/alternates\"),\"alternates exists before\")","+spec(ROOT+\"/h.json\",base); r=sanitize(d,ROOT+\"/h.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 shared\")","+shutil.move(src,src+\"-gone\")","+check(g(d,\"log\",\"--oneline\",\"HEAD\",check=False).returncode==0,\"log works after source removed\")","+check(not os.path.exists(d+\"/.git/objects/info/alternates\"),\"alternates gone\")","+check(g(d,\"cat-file\",\"-t\",heads[3],check=False).returncode!=0,\"future borrowed object not copied\")","+","+print(\"I tag-of-tag and tag-to-blob on ancestors\")","+d=ROOT+\"/i\"; heads=mkrepo(d,3); base=heads[1]","+g(d,\"reset\",\"--hard\",\"-q\",base)","+blob=g(d,\"hash-object\",\"-w\",\"f.py\").stdout.strip()","+g(d,\"tag\",\"-a\",\"blobtag\",\"-m\",\"tag blob\",blob)","+g(d,\"tag\",\"-a\",\"t1\",\"-m\",\"first\",base); g(d,\"tag\",\"-a\",\"t2\",\"-m\",\"second\",\"t1\")","+spec(ROOT+\"/i.json\",base); r=sanitize(d,ROOT+\"/i.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 tag chains\")","+for t in (\"blobtag\",\"t1\",\"t2\"):","+    rr=g(d,\"cat-file\",\"-t\",t,check=False); check(rr.returncode==0,f\"tag {t} present ({rr.stdout.strip()})\")","+check(g(d,\"rev-parse\",\"t2^{commit}\").stdout.strip()==base,\"tag-of-tag peels to base\")","+check(g(d,\"cat-file\",\"-t\",heads[2],check=False).returncode!=0,\"future gone (tag case)\")","+","+print(\"J bare repo\")","+src=ROOT+\"/jsrc\"; heads=mkrepo(src,3)","+d=ROOT+\"/j.git\"; run(ROOT,\"git\",\"clone\",\"-q\",\"--bare\",src,d); g(d,\"symbolic-ref\",\"HEAD\",\"refs/heads/main\")","+run(d,\"git\",\"--git-dir\",d,\"update-ref\",\"refs/heads/main\",heads[1])","+base=heads[1]; spec(ROOT+\"/j.json\",base); r=sanitize(d,ROOT+\"/j.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 bare\")","+check(run(d,\"git\",\"--git-dir\",d,\"cat-file\",\"-t\",heads[2],check=False).returncode!=0,\"bare future gone\")","+","+print(\"K LFS objects prune\")","+d=ROOT+\"/k\"; heads=mkrepo(d,2); base=heads[1]","+import hashlib as hl","+content=b\"binary-content\"; sha=hl.sha256(content).hexdigest()","+pointer=f\"version https://git-lfs.github.com/spec/v1\\noid sha256:{sha}\\nsize {len(content)}\\n\"","+open(d+\"/big.bin\",\"w\").write(pointer); g(d,\"add\",\"big.bin\"); g(d,\"commit\",\"-qm\",\"lfs pointer\"); base=g(d,\"rev-parse\",\"HEAD\").stdout.strip()","+lfsdir=os.path.join(d,\".git/lfs/objects\",sha[:2],sha[2:4]); os.makedirs(lfsdir); open(os.path.join(lfsdir,sha),\"wb\").write(content)","+fsha=hl.sha256(b\"future\").hexdigest(); fdir=os.path.join(d,\".git/lfs/objects\",fsha[:2],fsha[2:4]); os.makedirs(fdir); open(os.path.join(fdir,fsha),\"wb\").write(b\"future\")","+spec(ROOT+\"/k.json\",base); r=sanitize(d,ROOT+\"/k.json\"); print(r.stderr.strip())","+check(r.returncode==0,\"rc0 lfs\")","+check(os.path.exists(os.path.join(lfsdir,sha)),\"referenced lfs kept\")","+check(not os.path.exists(os.path.join(fdir,fsha)),\"future lfs removed\")","+","+print(\"\\nOVERALL\",\"FAIL \"+str(fails) if fails else \"ALL OK\")"],"newLines":155,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/synth_suite.py"}]}