{"files":[{"hunks":[{"lines":["         if len(parts) == 2 and parts[1] != \"missing\":","             keep.append(parts[0])","     return keep","+","+","+# ---------------------------------------------------------------- snapshots","+","+def list_refs(ctx):","+    fmt = (\"%(refname)%00%(objectname)%00%(objecttype)%00\"","+           \"%(*objectname)%00%(*objecttype)%00%(symref)\")","+    out = ctx.out([\"for-each-ref\", \"--format=\" + fmt])","+    refs = []","+    for line in out.splitlines():","+        if not line:","+            continue","+        f = line.split(\"\\x00\")","+        while len(f) < 6:","+            f.append(\"\")","+        refs.append({","+            \"name\": f[0], \"oid\": f[1], \"type\": f[2],","+            \"peeled\": f[3], \"peeled_type\": f[4], \"symref\": f[5],","+        })","+    return refs","+","+","+def snapshot_state(ctx, head_oid):","+    \"\"\"Observable worktree/index/history state we must preserve.\"\"\"","+    snap = {}","+    snap[\"head\"] = head_oid","+    snap[\"head_symref\"] = rev_parse(ctx, \"--symbolic-full-name HEAD\") \\","+        if False else None","+    r = ctx.git([\"symbolic-ref\", \"-q\", \"HEAD\"], check=False)","+    snap[\"head_symref\"] = r.stdout.decode().strip() if r.returncode == 0 else None","+    if ctx.work_tree:","+        snap[\"status\"] = hash_command(","+            ctx, [\"status\", \"--porcelain=v1\", \"-z\", \"-uall\"])","+        snap[\"ls_files\"] = hash_command(ctx, [\"ls-files\", \"-s\", \"-z\"])","+        if head_oid:","+            snap[\"diff_head\"] = hash_command(ctx, [\"diff\", \"HEAD\", \"--binary\"])","+            snap[\"diff_cached\"] = hash_command(","+                ctx, [\"diff\", \"--cached\", \"--binary\"])","+        else:","+            snap[\"diff_cached\"] = hash_command(","+                ctx, [\"diff\", \"--cached\", \"--binary\"])","+    if head_oid:","+        snap[\"log\"] = hash_command(ctx, [","+            \"log\", \"--format=%H%x00%P%x00%T%x00%an%x00%ae%x00%at%x00\"","+            \"%cn%x00%ce%x00%ct%x00%B%x00==END==\", \"HEAD\"])","+        r = ctx.git([\"describe\", \"--tags\", \"--long\", \"--always\", \"--dirty\"],","+                    check=False)","+        snap[\"describe\"] = (r.returncode, r.stdout)","+        r = ctx.git([\"rev-list\", \"--count\", \"HEAD\"], check=False)","+        snap[\"count\"] = (r.returncode, r.stdout)","+    return snap","+","+","+def compare_snapshots(before, after):","+    diffs = []","+    for key in (\"head\", \"head_symref\", \"describe\", \"count\"):","+        if before.get(key) != after.get(key):","+            diffs.append(key)","+    for key in (\"status\", \"ls_files\", \"diff_head\", \"diff_cached\", \"log\"):","+        b, a = before.get(key), after.get(key)","+        if b is None and a is None:","+            continue","+        if b is None or a is None or b[:3] != a[:3]:","+            diffs.append(key)","+    return diffs","+","+","+# ------------------------------------------------------------ file backups","+","+TRANSIENT_DIRS = (\"rebase-merge\", \"rebase-apply\", \"sequencer\")","+TRANSIENT_FILES = (\"MERGE_MSG\", \"MERGE_MODE\", \"SQUASH_MSG\", \"COMMIT_EDITMSG\",","+                   \"BISECT_LOG\", \"BISECT_NAMES\", \"BISECT_START\",","+                   \"BISECT_EXPECTED_REV\", \"FETCH_HEAD\")","+","+","+class Backup:","+    \"\"\"Small gitdir files we may need to roll back (objects handled apart).\"\"\"","+","+    def __init__(self, ctx):","+        self.ctx = ctx","+        self.files = {}          # path -> bytes or None","+        self.dirs = {}           # dir path -> {relpath: bytes}","+        roots = {ctx.git_dir, ctx.common_dir}","+        for root in roots:","+            for name in (\"config\", \"packed-refs\", \"shallow\", \"HEAD\"):","+                p = os.path.join(root, name)","+                self.files[p] = read_bytes(p)","+            p = os.path.join(root, \"config.worktree\")","+            self.files[p] = read_bytes(p)","+            p = os.path.join(root, \"info\", \"grafts\")","+            self.files[p] = read_bytes(p)","+            p = os.path.join(root, \"info\", \"refs\")","+            self.files[p] = read_bytes(p)","+            # transient state","+            for name in TRANSIENT_FILES:","+                p = os.path.join(root, name)","+                self.files[p] = read_bytes(p)","+            try:","+                for entry in os.listdir(root):","+                    if re.match(r\"^[A-Z_]+_HEAD$\", entry) and entry != \"HEAD\":","+                        p = os.path.join(root, entry)","+                        self.files[p] = read_bytes(p)","+            except OSError:","+                pass","+            for d in TRANSIENT_DIRS:","+                p = os.path.join(root, d)","+                if os.path.isdir(p):","+                    saved = {}","+                    for dp, _dn, fn in os.walk(p):","+                        for fnm in fn:","+                            fp = os.path.join(dp, fnm)","+                            saved[os.path.relpath(fp, p)] = read_bytes(fp)","+                    self.dirs[p] = saved","+            # reflogs","+            logs_root = os.path.join(root, \"logs\")","+            if os.path.isdir(logs_root):","+                for dp, _dn, fn in os.walk(logs_root):","+                    for fnm in fn:","+                        fp = os.path.join(dp, fnm)","+                        self.files[fp] = read_bytes(fp)","+        self.refs = None          # filled by caller","+","+    def restore_files(self):","+        for path, data in self.files.items():","+            try:","+                if data is None:","+                    if os.path.isfile(path):","+                        os.unlink(path)","+                else:","+                    os.makedirs(os.path.dirname(path), exist_ok=True)","+                    write_bytes(path, data)","+            except OSError:","+                pass","+        for path, saved in self.dirs.items():","+            try:","+                remove_path(path)","+                for rel, data in saved.items():","+                    if data is None:","+                        continue","+                    fp = os.path.join(path, rel)","+                    os.makedirs(os.path.dirname(fp), exist_ok=True)","+                    write_bytes(fp, data)","+            except OSError:","+                pass","+"],"newLines":148,"newStart":206,"oldLines":3,"oldStart":206}],"path":"/app/sanitize/sanitize"}]}