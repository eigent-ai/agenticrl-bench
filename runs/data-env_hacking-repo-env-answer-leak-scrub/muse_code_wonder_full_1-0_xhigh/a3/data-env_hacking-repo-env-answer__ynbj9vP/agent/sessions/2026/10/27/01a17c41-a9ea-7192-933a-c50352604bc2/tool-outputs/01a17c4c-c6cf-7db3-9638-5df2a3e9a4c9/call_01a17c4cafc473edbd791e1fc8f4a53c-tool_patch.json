{"files":[{"hunks":[{"lines":["             except OSError:","                 pass"," ","+","+# ---------------------------------------------------------- keep-set logic","+","+def rev_list_commits(ctx, tips):","+    if not tips:","+        return set()","+    out = ctx.out([\"rev-list\"] + sorted(tips))","+    return set(out.split())","+","+","+def commit_parents(ctx, oid):","+    r = ctx.git([\"show\", \"-s\", \"--format=%P\", oid], check=False)","+    if r.returncode != 0:","+        return []","+    return r.stdout.decode().split()","+","+","+def tag_chain(ctx, oid):","+    \"\"\"Annotated tag object oids from oid down to (excluding) its target.\"\"\"","+    chain = []","+    seen = set()","+    cur = oid","+    while cur and cur not in seen:","+        seen.add(cur)","+        r = ctx.git([\"cat-file\", \"-t\", cur], check=False)","+        if r.returncode != 0 or r.stdout.strip() != b\"tag\":","+            break","+        chain.append(cur)","+        r = ctx.git([\"cat-file\", \"tag\", cur], check=False)","+        if r.returncode != 0:","+            break","+        nxt = None","+        for line in r.stdout.decode(\"utf-8\", \"replace\").splitlines():","+            if line.startswith(\"object \"):","+                nxt = line[7:].strip()","+                break","+            if not line:","+                break","+        cur = nxt","+    return chain","+","+","+def tree_closure(ctx, tree_oid):","+    \"\"\"All subtree/blob oids under a tree (existing objects only).\"\"\"","+    out = ctx.out([\"ls-tree\", \"-r\", \"-t\", \"-z\", tree_oid])","+    oids = [tree_oid]","+    for entry in out.split(\"\\x00\"):","+        if not entry:","+            continue","+        meta = entry.split(\"\\t\")[0].split()","+        if len(meta) == 3 and meta[0] != \"160000\":","+            oids.append(meta[2])","+    return existing_objects(ctx, oids)","+","+","+def index_extra_objects(ctx):","+    \"\"\"Objects referenced only by the index (staged / conflict state)