{"files":[{"hunks":[{"lines":["     if process_submodules:","         process_submodules(ctx, main_entries, visited)"," ","+","+def submodule_names_by_path(ctx):","+    mapping = {}","+    if ctx.worktree is None:","+        return mapping","+    gitmodules = ctx.worktree / \".gitmodules\"","+    if not gitmodules.is_file():","+        return mapping","+    result = probe_git(ctx.worktree, [\"config\", \"-f\", str(gitmodules), \"-z\", \"--get-regexp\", r\"^submodule\\.\"], check=False)","+    names = {}","+    paths = {}","+    if result.returncode == 0:","+        for record in result.stdout.split(b\"\\0\"):","+            if not record or b\"\\n\" not in record:","+                continue","+            key, value = record.split(b\"\\n\", 1)","+            key = b2s(key)","+            value = b2s(value)","+            bits = key.split(\".\")","+            if len(bits) >= 3:","+                name = \".\".join(bits[1:-1])","+                names[(name, bits[-1])] = value","+    for (name, kind), value in names.items():","+        if kind == \"path\":","+            paths[value] = name","+    return paths","+","+","+def find_module_gitdirs(modules_root):","+    found = []","+    if not Path(modules_root).is_dir():","+        return found","+    for root, dirs, files in os.walk(modules_root):","+        root_path = Path(root)","+        if (root_path / \"HEAD\").is_file() and (root_path / \"objects\").is_dir() and (root_path / \"refs\").is_dir():","+            found.append(root_path)","+            # Nested module stores live below this gitdir's modules/; keep","+            # descending into that directory only.","+            dirs[:] = [d for d in dirs if d == \"modules\"]","+        else:","+            dirs[:] = [d for d in dirs if d not in (\"objects\", \"refs\")]","+    return found","+","+","+def process_submodules(ctx, entries, visited):","+    if ctx.worktree is None:","+        return","+    gitlinks = {}","+    for mode, oid, _stage, path in entries:","+        if mode == \"160000\":","+            gitlinks.setdefault(path, []).append(oid)","+    names = submodule_names_by_path(ctx)","+    handled_modules = set()","+    for path, oids in sorted(gitlinks.items()):","+        sub_worktree = ctx.worktree / path","+        sub_ctx = None","+        if (sub_worktree / \".git\").exists():","+            candidate = discover_ctx(sub_worktree, ctx.write_root)","+            if candidate is not None and candidate.worktree is not None and same_path(candidate.worktree, sub_worktree):","+                sub_ctx = candidate","+        if sub_ctx is None:","+            module_candidates = []","+            if path in names:","+                module_candidates.append(ctx.commondir / \"modules\" / names[path])","+            module_candidates.append(ctx.commondir / \"modules\" / path)","+            for module in module_candidates:","+                if (module / \"HEAD\").is_file() and (module / \"objects\").is_dir():","+                    sub_ctx = discover_gitdir_ctx(module, sub_worktree, ctx.write_root)","+                    if sub_ctx is not None:","+                        break","+        if sub_ctx is None:","+            continue","+        handled_modules.add(str(sub_ctx.commondir.resolve()))","+        sanitize_ctx(sub_ctx, oids, visited, process_submodules=True)","+    # Cached module stores for submodules that are no longer (or not yet)","+    # checked out still sit inside this repository.","+    for module in find_module_gitdirs(ctx.commondir / \"modules\"):","+        if str(module.resolve()) in handled_modules or str(module.resolve()) in visited:","+            continue","+        wt_hint = None","+        gitdir_file = module / \"gitdir\"","+        if gitdir_file.is_file():","+            try:","+                target = b2s(gitdir_file.read_bytes()).strip()","+                if target:","+                    wt_hint = Path(target).parent","+            except OSError:","+                pass","+        sub_ctx = discover_gitdir_ctx(module, wt_hint, ctx.write_root)","+        if sub_ctx is not None:","+            sanitize_ctx(sub_ctx, [], visited, process_submodules=True)","+","+","+def copy_tree_contents(src, dst):","+    src, dst = Path(src), Path(dst)","+    if not src.is_dir():","+        return","+    dst.mkdir(parents=True, exist_ok=True)","+    for entry in src.iterdir():","+        target = dst / entry.name","+        if entry.is_symlink():","+            if target.exists() or target.is_symlink():","+                remove_tree(target)","+            os.symlink(os.readlink(entry), target)","+        elif entry.is_dir():","+            shutil.copytree(entry, target, symlinks=True)","+        elif entry.is_file():","+            shutil.copy2(entry, target)","+","+","+def relocate_gitdir(ctx, repo):","+    \"\"\"Materialise a standalone .git inside `repo` from an external gitdir.\"\"\"","+    staging = repo / f\".git.sanitize-staging-{os.getpid()}\"","+    if staging.exists() or staging.is_symlink():","+        remove_tree(staging)","+    (staging / \"objects\" / \"info\").mkdir(parents=True)","+    (staging / \"objects\" / \"pack\").mkdir(parents=True)","+    (staging / \"refs\" / \"heads\").mkdir(parents=True)","+    (staging / \"refs\" / \"tags\").mkdir(parents=True)","+    (staging / \"info\").mkdir(exist_ok=True)","+    (staging / \"hooks\").mkdir(exist_ok=True)","+    old_common = ctx.commondir","+    old_gitdir = ctx.gitdir","+    for name in (\"config\", \"description\", \"packed-refs\", \"shallow\"):","+        src = old_common / name","+        if src.is_file():","+            shutil.copy2(src, staging / name)","+    copy_tree_contents(old_common / \"refs\", staging / \"refs\")","+    copy_tree_contents(old_common / \"hooks\", staging / \"hooks\")","+    copy_tree_contents(old_common / \"info\", staging / \"info\")","+    modules_src = old_common / \"modules\"","+    if modules_src.is_dir():","+        shutil.copytree(modules_src, staging / \"modules\", symlinks=True)","+    # Per-worktree files from the actual gitdir overlay the common ones.","+    for entry in old_gitdir.iterdir():","+        if entry.name in (\"commondir\", \"gitdir\", \"objects\", \"logs\", \"modules\", \"worktrees\"):","+            continue","+        target = staging / entry.name","+        if entry.is_symlink():","+            if target.exists() or target.is_symlink():","+                remove_tree(target)","+            os.symlink(os.readlink(entry), target)","+        elif entry.is_dir():","+            if entry.name in (\"refs\", \"hooks\", \"info\"):","+                copy_tree_contents(entry, target)","+            else:","+                if target.exists():","+                    remove_tree(target)","+                shutil.copytree(entry, target, symlinks=True)","+        elif entry.is_file():","+            shutil.copy2(entry, target)","+    # Borrow every object from the old store until the explicit pack step","+    # has localised the kept ones into the new store.","+    alternates = []","+    old_objects = (old_common / \"objects\")","+    alternates.append(str(old_objects.resolve()))","+    old_alt = old_objects / \"info\" / \"alternates\"","+    if old_alt.is_file():","+        try:","+            for line in b2s(old_alt.read_bytes()).splitlines():","+                line = line.strip()","+                if not line:","+                    continue","+                alt_path = Path(line)","+                if not alt_path.is_absolute():","+                    alt_path = (old_objects / alt_path).resolve()","+                alternates.append(str(alt_path))","+        except OSError:","+            pass","+    (staging / \"objects\" / \"info\" / \"alternates\").write_text(\"\\n\".join(dict.fromkeys(alternates)) + \"\\n\")","+    new_ctx = RepoCtx(repo, staging, staging, repo, explicit=True)","+    return new_ctx, staging, old_common","+","+","+def install_relocated_gitdir(repo, staging):","+    dotgit = repo / \".git\"","+    backup = repo / f\".git.sanitize-old-{os.getpid()}\"","+    if backup.exists() or backup.is_symlink():","+        remove_tree(backup)","+    had_backup = False","+    if dotgit.is_symlink() or dotgit.is_file():","+        dotgit.unlink()","+    elif dotgit.is_dir():","+        os.replace(dotgit, backup)","+        had_backup = True","+    os.replace(staging, dotgit)","+    if had_backup:","+        remove_tree(backup)","+","+","+def fix_submodule_pointers(ctx, old_common, entries):","+    if ctx.worktree is None:","+        return","+    old_modules = (Path(old_common) / \"modules\").resolve()","+    for mode, _oid, _stage, path in entries:","+        if mode != \"160000\":","+            continue","+        sub = ctx.worktree / path","+        dotgit = sub / \".git\"","+        if not dotgit.is_file():","+            continue","+        candidate = discover_ctx(sub, ctx.write_root)","+        if candidate is None:","+            continue","+        try:","+            suffix = candidate.gitdir.resolve().relative_to(old_modules)","+        except ValueError:","+            continue","+        new_module = ctx.commondir / \"modules\" / suffix","+        if not new_module.is_dir():","+            continue","+        rel = os.path.relpath(new_module.resolve(), sub.resolve())","+        dotgit.write_text(f\"gitdir: {rel}\\n\")","+        gitdir_file = new_module / \"gitdir\"","+        gitdir_file.write_text(f\"{(sub / '.git').resolve()}\\n\")","+        cfg = new_module / \"config\"","+        if cfg.is_file():","+            rel_wt = os.path.relpath(sub.resolve(), new_module.resolve())","+            probe_git(sub, [\"config\", \"--file\", str(cfg), \"core.worktree\", rel_wt], check=False)","+","+","+def main(argv):","+    if len(argv) != 3:","+        print(f\"usage: {argv[0]} <repo_dir> <spec.json>\", file=sys.stderr)","+        return 2","+    repo = Path(argv[1])","+    if not repo.is_dir():","+        print(f\"repo_dir is not a directory: {repo}\", file=sys.stderr)","+        return 2","+    try:","+        spec = json.loads(Path(argv[2]).read_text(encoding=\"utf-8\"))","+    except (OSError, ValueError) as exc:","+        print(f\"cannot read spec: {exc}\", file=sys.stderr)","+        return 2","+    base_commit = spec.get(\"base_commit\") if isinstance(spec, dict) else None","+    if not isinstance(base_commit, str) or not base_commit:","+        print(\"spec has no base_commit\", file=sys.stderr)","+        return 2","+    repo = repo.resolve()","+    _tmp_root()","+    try:","+        ctx = discover_ctx(repo, repo)","+        if ctx is None:","+            # A bare repository passed directly, or no repository at all.","+            if (repo / \"HEAD\").is_file() and (repo / \"objects\").is_dir() and (repo / \"refs\").is_dir():","+                ctx = discover_gitdir_ctx(repo, None, repo)","+            if ctx is None:","+                return 0","+        else:","+            if ctx.worktree is None:","+                ctx = RepoCtx(repo, ctx.gitdir, ctx.commondir, repo, explicit=True)","+            elif not same_path(ctx.worktree, repo):","+                # repo_dir is inside some other work tree (or vice versa);","+                # only act when the gitdir lives inside repo_dir itself.","+                if not ((repo / \".git\").exists() and within(ctx.commondir, repo)):","+                    return 0","+                ctx = RepoCtx(repo, ctx.gitdir, ctx.commondir, repo, explicit=True)","+        visited = set()","+        if not within(ctx.commondir, repo):","+            if ctx.worktree is None or not same_path(ctx.worktree, repo):","+                raise GitError(\"repository gitdir is outside repo_dir and cannot be relocated\")","+            new_ctx, staging, old_common = relocate_gitdir(ctx, repo)","+            try:","+                sanitize_ctx(new_ctx, [base_commit], visited, process_submodules=False)","+            except Exception:","+                if staging.exists():","+                    remove_tree(staging)","+                raise","+            install_relocated_gitdir(repo, staging)","+            visited = {str((repo / \".git\").resolve())}","+            ctx = discover_ctx(repo, repo)","+            if ctx is None:","+                raise GitError(\"relocated repository is not readable\")","+            entries = index_entries(ctx)","+            fix_submodule_pointers(ctx, old_common, entries)","+            process_submodules(ctx, entries, visited)","+            return 0","+        sanitize_ctx(ctx, [base_commit], visited, process_submodules=True)","+        return 0","+    except Exception as exc:  # noqa: BLE001 - report and fail the env build","+        print(f\"sanitize: {exc}\", file=sys.stderr)","+        return 1","+    finally:","+        global _TMPDIR_OBJ","+        if _TMPDIR_OBJ is not None:","+            _TMPDIR_OBJ.cleanup()","+            _TMPDIR_OBJ = None","+","+","+if __name__ == \"__main__\":","+    raise SystemExit(main(sys.argv))","+"],"newLines":295,"newStart":1088,"oldLines":3,"oldStart":1088}],"path":"/app/sanitize/sanitize"}]}