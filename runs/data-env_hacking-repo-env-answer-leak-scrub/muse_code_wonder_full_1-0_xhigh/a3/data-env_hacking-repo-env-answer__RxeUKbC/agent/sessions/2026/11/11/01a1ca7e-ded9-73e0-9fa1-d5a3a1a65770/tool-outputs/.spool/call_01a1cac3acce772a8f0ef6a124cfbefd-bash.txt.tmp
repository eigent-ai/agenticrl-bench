[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	worktree = ../../../sub
---linked-original-similar
[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	worktree = ../../../../../../wt/sub
[remote "origin"]
	url = /tmp/reloc-sub/subsrc
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
---after
[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	worktree = ../../../../../../wt/sub
gitdir: ../.git/modules/sub
/tmp/reloc-sub/wt/sub/.git
