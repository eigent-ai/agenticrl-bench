{"files":[{"hunks":[{"lines":["+#!/usr/bin/env python3","+import json,os,shutil,subprocess","+from pathlib import Path","+R=Path('/tmp/divergent-test')","+if R.exists():shutil.rmtree(R)","+R.mkdir(); d=R/'repo'; d.mkdir(); ENV=dict(os.environ,GIT_AUTHOR_NAME='B',GIT_AUTHOR_EMAIL='b@e',GIT_COMMITTER_NAME='B',GIT_COMMITTER_EMAIL='b@e',HOME='/tmp')","+def g(*a):","+ r=subprocess.run(['git','-C',str(d)]+list(a),capture_output=True,env=ENV); assert r.returncode==0,(a,r.stderr); return r.stdout.decode().strip()","+g('init','-b','main'); (d/'a').write_text('root\\n'); g('add','-A');g('commit','-m','root'); root=g('rev-parse','HEAD')","+(d/'a').write_text('base\\n');g('add','-A');g('commit','-m','base');base=g('rev-parse','HEAD');g('tag','basetag')","+(d/'a').write_text('future\\n');g('add','-A');g('commit','-m','future');fut=g('rev-parse','HEAD');g('branch','future')","+g('checkout','-b','setup',root); (d/'setup').write_text('setup\\n');g('add','-A');g('commit','-m','setup divergence');head=g('rev-parse','HEAD')","+spec=R/'spec.json';spec.write_text(json.dumps({'instance_id':'x','repo':'x/y','base_commit':base}))","+(R/'home').mkdir();(R/'tmp').mkdir(); r=subprocess.run(['/app/sanitize/sanitize',str(d),str(spec)],capture_output=True,text=True,env=dict(os.environ,HOME=str(R/'home'),TMPDIR=str(R/'tmp')));print('rc',r.returncode,r.stderr)","+print('head',g('rev-parse','HEAD')==head,'base exists',subprocess.run(['git','-C',str(d),'cat-file','-e',base]).returncode==0,'fut exists',subprocess.run(['git','-C',str(d),'cat-file','-e',fut]).returncode==0)","+print('tags',g('tag','-l'))","+print('branches',g('branch','--format=%(refname:short)'))","+print('checkout base file rc',subprocess.run(['git','-C',str(d),'checkout',base,'--','a']).returncode,(d/'a').read_text())","+print('fsck');print(subprocess.run(['git','-C',str(d),'fsck','--unreachable','--no-reflogs'],capture_output=True,text=True).stdout)"],"newLines":19,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/test_divergen