{"files":[{"hunks":[{"lines":["     elif worktree_hint:","         worktree = Path(worktree_hint)","     return RepoCtx(worktree, gitdir, commondir, write_root, explicit=True)","+","+","+def rev_list(ctx, roots, objects=False, check=True):","+    \"\"\"Commit ids (or object ids with objects=True) reachable from roots.\"\"\"","+    roots = [r for r in dict.fromkeys(roots) if r]","+    if not roots:","+        return set()","+    args = [\"rev-list\"]","+    if objects:","+        args.append(\"--objects\")","+    args += roots","+    result = ctx.git(args, check=False)","+    if result.returncode != 0:","+        # Partial clones may name missing promisor objects.","+        args2 = [\"rev-list\"]","+        if objects:","+            args2.append(\"--objects\")","+        args2.append(\"--missing=allow-promisor\")","+        args2 += roots","+        result = ctx.git(args2, check=False)","+    if result.returncode != 0:","+        if check:","+            raise GitError(f\"rev-list failed: {b2s(result.stderr[-1000:]).strip()}\")","+        return set()","+    found = set()","+    for line in b2s(result.stdout).splitlines():","+        oid = line.split(\" \", 1)[0].strip().lstrip(\"?\")","+        if is_oid(oid):","+            found.add(oid)","+    return found","+","+","+def all_objects(ctx):","+    \"\"\"Map oid -> (type, size) for every object in the local/alternate store.\"\"\"","+    result = ctx.git(","+        [\"cat-file\", \"--batch-all-objects\", \"--batch-check=%(objectname) %(objecttype) %(objectsize)\"],","+        check=False,","+    )","+    objects = {}","+    if result.returncode != 0:","+        return objects","+    for line in b2s(result.stdout).splitlines():","+        parts = line.split()","+        if len(parts) >= 2 and is_oid(parts[0]):","+            try:","+                size = int(parts[2]) if len(parts) > 2 else -1","+            except ValueError:","+                size = -1","+            objects[parts[0]] = (parts[1], size)","+    return objects","+","+","+def expand_tree(ctx, oid, into):","+    \"\"\"Add oid and, for trees, every object beneath it (except gitlinks).\"\"\"","+    if not is_oid(oid):","+        return","+    into.add(oid)","+    otype = ctx.object_type(oid)","+    if otype != \"tree\":","+        return","+    result = ctx.git([\"ls-tree\", \"-r\", \"-t\", \"-z\", \"--full-tree\", oid], check=False)","+    if result.returncode != 0:","+        return","+    for record in result.stdout.split(b\"\\0\"):","+        if not record or b\"\\t\" not in record:","+            continue","+        meta = b2s(record.split(b\"\\t\", 1)[0]).split()","+        if len(meta) >= 3 and meta[0] != \"160000\" and is_oid(meta[2]):","+            into.add(meta[2])","+","+","+def index_entries(ctx):","+    \"\"\"(mode, oid, stage, path) tuples from the index; [] when unreadable.\"\"\"","+    result = ctx.git([\"ls-files\", \"--stage\", \"-z\", \"--full-name\"], check=False)","+    if result.returncode != 0:","+        return []","+    entries = []","+    for record in result.stdout.split(b\"\\0\"):","+        if not record or b\"\\t\" not in record:","+            continue","+        meta, path = record.split(b\"\\t\", 1)","+        parts = b2s(meta).split()","+        if len(parts) >= 3:","+            entries.append((parts[0], parts[1], parts[2], b2s(path)))","+    return entries","+","+","+def index_objects(ctx, index_path=None, entries=None):","+    \"\"\"Objects needed by an index: its blobs/trees and its write-tree.\"\"\"","+    found = set()","+    if entries is None:","+        entries = index_entries(ctx)","+    for mode, oid, _stage, _path in entries:","+        if mode == \"160000\" or not is_oid(oid):","+            continue","+        if mode == \"040000\":","+            expand_tree(ctx, oid, found)","+        else:","+            found.add(oid)","+    # Materialise the staged tree hierarchy (cache-tree equivalents) using a","+    # throw-away copy of the index so the real index file stays untouched.","+    if index_path is None:","+        index_path = ctx.gitdir / \"index\"","+    index_path = Path(index_path)","+    if index_path.is_file():","+        tmp = _tmp_root() / f\"index-{os.getpid()}-{abs(hash(str(index_path))) % 999983}\"","+        try:","+            shutil.copyfile(index_path, tmp)","+            result = ctx.git([\"write-tree\"], check=False, env_extra={\"GIT_INDEX_FILE\": str(tmp)})","+            if result.returncode == 0:","+                tree = b2s(result.stdout).strip()","+                if is_oid(tree):","+                    expand_tree(ctx, tree, found)","+        except OSError:","+            pass","+        finally:","+            unlink_quiet(tmp)","+    return found","+"],"newLines":122,"newStart":237,"oldLines":3,"oldStart":237}],"path":"/app/sanitize/sanitize"}]}