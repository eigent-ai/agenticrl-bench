         remove_tree(entry)","+                else:","+                    unlink_quiet(entry)","+        for entry in list(objects_dir.iterdir()):","+            if HEX2_RE.match(entry.name) and entry.is_dir() and not entry.is_symlink():","+                for loose in list(entry.iterdir()):","+                    if loose.is_dir() and not loose.is_symlink():","+                        remove_tree(loose)","+                    else:","+                        unlink_quiet(loose)","+                try:","+                    entry.rmdir()","+                except OSError:","+                    pass","+            elif entry.name.startswith(\"tmp_\") and not entry.is_dir():","+                unlink_quiet(entry)","+        unlink_quiet(objects_dir / \"info\" / \"alternates\")","+    finally:","+        if staging.exists():","+            remove_tree(staging)","+","+","+def prune_lfs(ctx, allowed, existing):","+    lfs_dir = ctx.commondir / \"lfs\"","+    objects_root = lfs_dir / \"objects\"","+    if not objects_root.is_dir():","+        return","+    wanted_sha = set()","+    candidates = [","+        oid for oid, (otype, size) in existing.items()","+        if oid in allowed and otype == \"blob\" and 0 < size <= 1024","+    ]","+    if candidates:","+        proc = subprocess.Popen(","+            base_git_cmd(str(ctx.worktree or ctx.gitdir))","+            + ([f\"--git-dir={ctx.gitdir}\", f\"--work-tree={ctx.worktree}\"] if ctx.explicit and ctx.worktree","+               else [\"-C\", str(ctx.worktree)] if ctx.worktree else [f\"--git-dir={ctx.gitdir}\"])","+            + [\"cat-file\", \"--batch\"],","+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=clean_git_env(),","+        )","+        try:","+            for oid in candidates:","+                proc.stdin.write((oid + \"\\n\").encode())","+                proc.stdin.flush()","+                header = proc.stdout.readline().decode(\"utf-8\", \"replace\").split()","+                if len(h