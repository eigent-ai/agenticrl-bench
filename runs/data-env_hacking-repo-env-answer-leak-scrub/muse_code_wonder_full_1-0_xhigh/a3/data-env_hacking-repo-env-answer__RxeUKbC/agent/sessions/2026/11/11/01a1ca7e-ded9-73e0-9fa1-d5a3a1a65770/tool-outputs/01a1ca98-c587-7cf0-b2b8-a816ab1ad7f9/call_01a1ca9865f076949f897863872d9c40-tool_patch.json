{"files":[{"hunks":[{"lines":["         if logs.exists() or logs.is_symlink():","             remove_tree(logs)"," ","+","+def pack_object_ids(idx_path):","+    result = subprocess.run(","+        [\"git\", \"verify-pack\", \"-v\", str(idx_path)], capture_output=True, env=clean_git_env()","+    )","+    if result.returncode != 0:","+        raise GitError(f\"verify-pack failed for {idx_path}\")","+    found = set()","+    for line in b2s(result.stdout).splitlines():","+        token = line.split()[0] if line.split() else \"\"","+        if is_oid(token):","+            found.add(token)","+    return found","+","+","+def explicit_pack_replace(ctx, wanted, original_pack_mode=None):","+    \"\"\"Replace the whole object store with one pack of exactly `wanted`.\"\"\"","+    objects_dir = ctx.commondir / \"objects\"","+    # An 'objects' symlink to a store outside the writable root is replaced","+    # by a real directory once the new pack has been built from it.","+    external_objects = objects_dir.is_symlink() or (","+        objects_dir.exists() and not within(objects_dir, ctx.write_root)","+    )","+    staging = ctx.commondir / f\".sanitize-objects-{os.getpid()}\"","+    pack_stage = staging / \"pack\"","+    if staging.exists():","+        remove_tree(staging)","+    pack_stage.mkdir(parents=True)","+    new_files = []","+    try:","+        if wanted:","+            payload = \"\\n\".join(sorted(wanted)) + \"\\n\"","+            result = ctx.git(","+                [\"pack-objects\", \"--delta-base-offset\", str(pack_stage / \"pack\")],","+                check=False,","+                input_data=payload,","+            )","+            if result.returncode != 0:","+                raise GitError(f\"pack-objects failed: {b2s(result.stderr[-1000:]).strip()}\")","+            pack_hash = b2s(result.stdout).strip().splitlines()[-1]","+            idx = pack_stage / f\"pack-{pack_hash}.idx\"","+            packed = pack_object_ids(idx)","+            if packed != se