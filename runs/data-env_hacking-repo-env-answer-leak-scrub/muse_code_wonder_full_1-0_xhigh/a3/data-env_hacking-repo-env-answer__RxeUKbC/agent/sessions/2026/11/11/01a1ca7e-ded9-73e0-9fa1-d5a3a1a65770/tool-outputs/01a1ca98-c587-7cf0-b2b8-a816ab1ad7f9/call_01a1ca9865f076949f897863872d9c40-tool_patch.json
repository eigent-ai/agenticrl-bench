mondir / \"objects\"","+    unlink_quiet(objects_dir / \"info\" / \"commit-graph\")","+    graphs = objects_dir / \"info\" / \"commit-graphs\"","+    if graphs.exists():","+        remove_tree(graphs)","+    pack_dir = objects_dir / \"pack\"","+    if pack_dir.is_dir():","+        for entry in list(pack_dir.iterdir()):","+            if entry.name.startswith(\"multi-pack-index\") or entry.name.endswith(\".keep\"):","+                unlink_quiet(entry)","+            if entry.name.startswith(\"tmp_\"):","+                unlink_quiet(entry)","+    unlink_quiet(ctx.commondir / \"info\" / \"refs\")","+    unlink_quiet(objects_dir / \"info\" / \"packs\")","+    leftovers = sorted(ctx.commondir.glob(\".sanitize-objects-*\"))","+    for leftover in leftovers:","+        remove_tree(leftover)","+","+","+def regenerate_derived_metadata(ctx, had_graph, had_midx, had_info_refs, had_info_packs):","+    if had_graph:","+        result = ctx.git(","+            [\"commit-graph\", \"write\", \"--reachable\"],","+            check=False,","+            config_extra=[\"core.commitGraph=true\"],","+        )","+        if result.returncode != 0:","+            unlink_quiet(ctx.commondir / \"objects\" / \"info\" / \"commit-graph\")","+    if had_midx:","+        pack_dir = ctx.commondir / \"objects\" / \"pack\"","+        if pack_dir.is_dir() and any(pack_dir.glob(\"*.idx\")):","+            ctx.git([\"multi-pack-index\", \"write\"], check=False)","+    if had_info_refs or had_info_packs:","+        ctx.git([\"update-server-info\", \"--force\"], check=False)","+        if not had_info_refs:","+            unlink_quiet(ctx.commondir / \"info\" / \"refs\")","+        if not had_info_packs:","+            unlink_quiet(ctx.commondir / \"objects\" / \"info\" / \"packs\")","+"],"newLines":216,"newStart":745,"oldLines":3,"oldStart":745}],"path":"/app/sanitize/sanitize"}]}