{"files":[{"hunks":[{"lines":["                             safe_unlink(path)","                     except OSError:","                         pass","+","+    # -- object pruning -------------------------------------------------","+    def _delete_commit_graph_and_midx(self):","+        info = os.path.join(self.objdir, \"info\")","+        safe_unlink(os.path.join(info, \"commit-graph\"))","+        graphs = os.path.join(info, \"commit-graphs\")","+        if os.path.isdir(graphs):","+            shutil.rmtree(graphs, ignore_errors=True)","+        pack = os.path.join(self.objdir, \"pack\")","+        try:","+            for name in os.listdir(pack):","+                if name.startswith(\"multi-pack-index\") or name.endswith(\".keep\"):","+                    safe_unlink(os.path.join(pack, name))","+        except OSError:","+            pass","+","+    def _materialize_alternates(self):","+        contexts = [(self.prefix, self.cwd)]","+        for rec in self.worktrees:","+            path = rec.get(\"worktree\", \"\")","+            if path and os.path.isdir(path):","+                contexts.append(([\"-C\", path], path))","+        packdir = os.path.join(self.objdir, \"pack\")","+        try:","+            os.makedirs(packdir, exist_ok=True)","+        except OSError:","+            pass","+        revs = [\"--all\"] + list(self.tip_commits) + list(self.raw_keep)","+        inp = \"\\n\".join(revs) + \"\\n\"","+        ok_any = False","+        for prefix, cwd in contexts:","+            res = run_cmd(prefix, cwd,","+                          [\"pack-objects\", \"-q\", \"--revs\", \"--indexed-objects\",","+                           \"--reflog\", \"--include-tag\",","+                           os.path.join(packdir, \"pack\")], inp=inp)","+            if res.returncode == 0:","+                ok_any = True","+            else:","+                dbg(\"pack-objects materialize failed: %s\" % out_text(res)[:300])","+        return ok_any","+","+    def _tips_resolve(self):","+        for oid in list(self.tip_commits) + list(self.raw_keep):","+            if not self.object_exists(oid):","+                return False","+        for _mode, oid in self.index_object_entries():","+            if _mode != \"160000\" and not self.object_exists(oid):","+                return False","+        return True","+","+    def _clean_object_tmp(self):","+        pack = os.path.join(self.objdir, \"pack\")","+        try:","+            for name in os.listdir(pack):","+                if name.startswith(\"tmp_pack_\") or name.startswith(\".tmp-\"):","+                    safe_unlink(os.path.join(pack, name))","+        except OSError:","+            pass","+        try:","+            for name in os.listdir(self.objdir):","+                sub = os.path.join(self.objdir, name)","+                if len(name) == 2 and is_hex(name) and os.path.isdir(sub):","+                    for fn in os.listdir(sub):","+                        if fn.startswith(\"tmp_obj_\"):","+                            safe_unlink(os.path.join(sub, fn))","+        except OSError:","+            pass","+","+    def _run_gc(self):","+        res = self.git(\"gc\", \"--prune=now\", \"-q\",","+                       extra_configs=(\"gc.writeCommitGraph=false\",))","+        if res.returncode != 0:","+            dbg(\"git gc failed in %s: %s\" % (self.entry, out_text(res)[:500]))","+        return res.returncode == 0","+","+    def _force_prune(self):","+        self.git(\"reflog\", \"expire\", \"--expire=now\",","+                 \"--expire-unreachable=now\", \"--all\")","+        self._delete_commit_graph_and_midx()","+        self.git(\"repack\", \"-A\", \"-d\", \"-q\", \"--unpack-unreachable=now\",","+                 \"--pack-kept-objects\")","+        res = self.git(\"prune\", \"--expire\", \"now\")","+        return res.returncode == 0","+","+    def unreachable_objects(self):","+        res = self.git(\"fsck\", \"--unreachable\", \"--no-reflogs\",","+                       optional_locks=False)","+        bad = []","+        for line in (out_text(res) + \"\\n\").splitlines():","+            parts = line.split()","+            if len(parts) >= 3 and parts[0] in (\"unreachable\", \"dangling\"):","+                bad.append((parts[1], parts[2]))","+        return bad","+","+    def prune_objects(self):","+        self.server_info_existed = (","+            os.path.exists(os.path.join(self.commondir, \"info\", \"refs\"))","+            or os.path.exists(os.path.join(self.objdir, \"info\", \"packs\")))","+        self._delete_commit_graph_and_midx()","+        alt_file = os.path.join(self.objdir, \"info\", \"alternates\")","+        alt_content = None","+        if os.path.isfile(alt_file):","+            try:","+                with open(alt_file, \"rb\") as fh:","+                    alt_content = fh.read()","+            except OSError:","+                alt_content = b\"\"","+            materialized = self._materialize_alternates()","+            if materialized:","+                safe_unlink(alt_file)","+                if not self._tips_resolve():","+                    # restore and try a full non-local repack instead","+                    try:","+                        write_file_atomic(alt_file, alt_content)","+                    except OSError:","+                        pass","+                    self.git(\"repack\", \"-a\", \"-d\", \"-q\")","+                    safe_unlink(alt_file)","+                    if not self._tips_resolve():","+                        try:","+                            write_file_atomic(alt_file, alt_content)","+                        except OSError:","+                            pass","+                        self.alt_unresolved = True","+                        dbg(\"alternates unresolved in %s\" % self.entry)","+            else:","+                self.alt_unresolved = True","+        ok = self._run_gc()","+        if not ok:","+            if not self.unreachable_objects():","+                ok = True","+            else:","+                ok = self._force_prune()","+        self._delete_commit_graph_and_midx()","+        self._clean_object_tmp()","+        if self.server_info_existed:","+            self.git(\"update-server-info\")","+        # verification / second force pass if anything unreachable remains","+        try:","+            bad = self.unreachable_objects()","+        except Exception:","+            bad = []","+        if bad:","+            index_oids = set(oid for _m, oid in self.index_object_entries())","+            real_bad = [(t, o) for (t, o) in bad if o not in index_oids]","+            if real_bad:","+                dbg(\"unreachable after gc in %s: %d\" % (self.entry, len(real_bad)))","+                self._force_prune()","+                self._delete_commit_graph_and_midx()","+                self._clean_object_tmp()","+                if self.server_info_existed:","+                    self.git(\"update-server-info\")","+                bad2 = self.unreachable_objects()","+                real_bad2 = [(t, o) for (t, o) in bad2 if o not in index_oids]","+                if real_bad2:","+                    self.failed = True","+                    FAILED.append(\"%s: %d unreachable objects remain\" % (","+                        self.entry, len(real_bad2)))","+        return ok","+","+    def prune_lfs(self):","+        lfs_objects = os.path.join(self.commondir, \"lfs\", \"objects\")","+        if not os.path.isdir(lfs_objects):","+            return","+        try:","+            allowed = self.allowed_objects()","+        except Exception:","+            return","+        # collect candidate small blobs","+        ids = sorted(allowed)","+        if not ids:","+            pointers = set()","+        else:","+            inp = \"\\n\".join(ids) + \"\\n\"","+            res = self.git(\"cat-file\", \"--batch-check=%(objectname) %(objecttype) %(objectsize)\",","+                           inp=inp, optional_locks=False)","+            small = []","+            if res.returncode == 0:","+                for line in out_text(res).splitlines():","+                    f = line.split()","+                    if len(f) == 3 and f[1] == \"blob\":","+                        try:","+                            if 0 < int(f[2]) <= 1024:","+                                small.append(f[0])","+                        except ValueError:","+                            pass","+            pointers = set()","+            if small:","+                res2 = self.git(\"cat-file\", \"--batch\", inp=\"\\n\".join(small) + \"\\n\",","+                                optional_locks=False)","+                if res2.returncode == 0:","+                    data = res2.stdout","+                    for match in re.finditer(","+                            rb\"oid sha256:([0-9a-fA-F]{64})\", data):","+                        pointers.add(match.group(1).decode().lower())","+        for root, dirs, files in os.walk(lfs_objects, topdown=False):","+            for name in files:","+                path = os.path.join(root, name)","+                rel = os.path.relpath(path, lfs_objects)","+                oid = rel.replace(os.sep, \"\")","+                if is_hex(oid, 64) and oid.lower() not in pointers:","+                    safe_unlink(path)","+            for d in dirs:","+                try:","+                    os.rmdir(os.path.join(root, d))","+                except OSError:","+                    pass","+        tmpdir = os.path.join(self.commondir, \"lfs\", \"tmp\")","+        if os.path.isdir(tmpdir):","+            shutil.rmtree(tmpdir, ignore_errors=True)","+","+    def scan_metadata_for_pruned_oids(self):","+        if not self.original_objects or self.alt_unresolved:","+            return","+        res = self.git(\"cat-file\", \"--batch-all-objects\",","+                       \"--batch-check=%(objectname)\", optional_locks=False)","+        if res.returncode != 0:","+            return","+        remaining = set(out_text(res).split())","+        pruned = self.original_objects - remaining","+        if not pruned:","+            return","+        ephemeral = {\"gc.log\", \"COMMIT_EDITMSG\", \"MERGE_MSG\", \"SQUASH_MSG\",","+                     \"FETCH_HEAD\", \"ORIG_HEAD\"}","+        standard = {\"HEAD\", \"config\", \"config.worktree\", \"description\",","+                    \"packed-refs\", \"shallow\", \"index\", \"commondir\", \"gitdir\",","+                    \"locked\", \"exclude\", \"attributes\", \"sparse-checkout\",","+                    \"refs\"}","+        objreal = os.path.realpath(self.objdir) if self.objdir else None","+        for gdir in self.all_gitdirs():","+            for root, dirs, files in os.walk(gdir):","+                # do not descend into objects, modules, hooks, lfs payloads","+                dirs[:] = [d for d in dirs if d not in (\"objects\", \"modules\",","+                                                        \"hooks\", \"lfs\")]","+                if objreal and os.path.realpath(root).startswith(objreal):","+                    dirs[:] = []","+                    continue","+                for name in files:","+                    if name.startswith(\"index\") or name.startswith(\"sharedindex.\"):","+                        continue","+                    path = os.path.join(root, name)","+                    try:","+                        if os.path.getsize(path) > 2 * 1024 * 1024:","+                            continue","+                        with open(path, \"rb\") as fh:","+                            data = fh.read().decode(\"utf-8\", \"ignore\")","+                    except OSError:","+                        continue","+                    hits = [t for t in self._full_oid_re().findall(data)","+                            if t in pruned]","+                    if not hits:","+                        continue","+                    if name in ephemeral:","+                        safe_unlink(path)","+                    elif os.path.dirname(os.path.relpath(path, gdir)) == \"\" \\","+                            and name not in standard and not name.endswith(\"_HEAD\"):","+                        safe_unlink(path)","+                    else:","+                        dbg(\"pruned oid %s still mentioned in %s\" % (hits[0], path))"],"newLines":262,"newStart":895,"oldLines":3,"oldStart":895}],"path":"/app/sanitize/sanitize"}]}