{"files":[{"hunks":[{"lines":["                         safe_unlink(path)","                     else:","                         dbg(\"pruned oid %s still mentioned in %s\" % (hits[0], path))","+","+    # -- child repositories --------------------------------------------","+    def collect_gitlinks(self):","+        links = {}","+","+        def add(mode, oid, path):","+            if mode == \"160000\" and path:","+                links.setdefault(path, set()).add(oid)","+","+        res = self.git(\"ls-files\", \"-s\", \"-z\", optional_locks=False)","+        if res.returncode == 0:","+            for item in res.stdout.split(b\"\\0\"):","+                if not item:","+                    continue","+                try:","+                    meta, path = item.split(b\"\\t\", 1)","+                    parts = meta.split()","+                    add(parts[0].decode(), parts[1].decode(),","+                        path.decode(\"utf-8\", \"surrogateescape\"))","+                except Exception:","+                    pass","+        trees = []","+        for cand in (self.head_commit, self.base_commit):","+            if cand and cand not in trees:","+                trees.append(cand)","+        for treeish in trees:","+            res = self.git(\"ls-tree\", \"-r\", \"-z\", treeish, optional_locks=False)","+            if res.returncode != 0:","+                continue","+            for item in res.stdout.split(b\"\\0\"):","+                if not item:","+                    continue","+                try:","+                    meta, path = item.split(b\"\\t\", 1)","+                    parts = meta.split()","+                    add(parts[0].decode(), parts[2].decode(),","+                        path.decode(\"utf-8\", \"surrogateescape\"))","+                except Exception:","+                    pass","+        return links","+","+    def _module_gitdirs(self):","+        found = []","+        mroot = os.path.join(self.commondir, \"modules\")","+        if not os.path.isdir(mroot):","+            return found","+        for root, dirs, _files in os.walk(mroot):","+            if looks_gitdir(root):","+                found.append(root)","+                # nested modules of this submodule are its own business","+                dirs[:] = [d for d in dirs if d == \"modules\"]","+                # still do not descend elsewhere; modules/ handled on its own pass","+                if \"modules\" not in dirs:","+                    dirs[:] = []","+        return found","+","+    def collect_child_jobs(self):","+        \"\"\"Return list of (entry, extra_tips) merged by common git dir.\"\"\"","+        raw_jobs = []  # (entry, set(tips))","+        links = self.collect_gitlinks()","+        link_paths = set(links.keys())","+        top = self.toplevel","+","+        def safe_join(rel):","+            parts = rel.split(\"/\")","+            if any(p in (\"..\", \"\", \".\") for p in parts):","+                # tolerate empty/./ but never escape","+                norm = os.path.normpath(rel)","+                if norm.startswith(\"..\" + os.sep) or norm == \"..\":","+                    return None","+                return os.path.join(top, norm) if top else None","+            return os.path.join(top, rel) if top else None","+","+        if top:","+            for rel, oids in links.items():","+                wt = safe_join(rel)","+                if wt and os.path.exists(os.path.join(wt, \".git\")):","+                    raw_jobs.append((wt, set(oids)))","+        # module gitdirs (initialized, deinitialized, or orphaned)","+        for mgitdir in self._module_gitdirs():","+            tips = set()","+            entry = mgitdir","+            try:","+                sub = Repo.probe(mgitdir)","+            except Exception:","+                sub = None","+            subtop = sub.toplevel if sub else None","+            if top and subtop:","+                try:","+                    rel = os.path.relpath(os.path.realpath(subtop),","+                                          os.path.realpath(top))","+                except Exception:","+                    rel = None","+                if rel and not rel.startswith(\"..\"):","+                    rel = rel.replace(os.sep, \"/\")","+                    if rel in links:","+                        tips |= links[rel]","+                    if os.path.exists(os.path.join(subtop, \".git\")):","+                        entry = subtop","+            raw_jobs.append((entry, tips))","+        # independent nested repositories in the working tree","+        if top and os.path.isdir(top):","+            linked_rel = set()","+            for rec in self.worktrees:","+                path = rec.get(\"worktree\", \"\")","+                if not path:","+                    continue","+                try:","+                    rel = os.path.relpath(os.path.realpath(path),","+                                          os.path.realpath(top))","+                except Exception:","+                    continue","+                if rel and rel != \".\" and not rel.startswith(\"..\"):","+                    linked_rel.add(rel.replace(os.sep, \"/\"))","+            for root, dirs, files in os.walk(top, topdown=True, followlinks=False):","+                rel_root = os.path.relpath(root, top).replace(os.sep, \"/\")","+                if rel_root == \".\":","+                    if \".git\" in dirs:","+                        dirs.remove(\".git\")","+                    continue","+                if rel_root in link_paths:","+                    dirs[:] = []","+                    continue","+                has_git = (\".git\" in dirs) or (\".git\" in files)","+                if has_git:","+                    if rel_root in linked_rel:","+                        if \".git\" in dirs:","+                            dirs.remove(\".git\")","+                        continue","+                    raw_jobs.append((root, set()))","+                    dirs[:] = []","+                    continue","+                # prune symlinked dirs explicitly","+                dirs[:] = [d for d in dirs","+                           if not os.path.islink(os.path.join(root, d))]","+        # merge by common git directory","+        merged = {}","+        order = []","+        for entry, tips in raw_jobs:","+            try:","+                probe = Repo.probe(entry)","+            except Exception:","+                probe = None","+            if probe is None:","+                continue","+            key = os.path.realpath(probe.commondir)","+            if key == os.path.realpath(self.commondir):","+                continue","+            if key not in merged:","+                merged[key] = [entry, set(tips)]","+                order.append(key)","+            else:","+                merged[key][1] |= set(tips)","+                # prefer a live worktree entry over a bare gitdir entry","+                if looks_gitdir(merged[key][0]) and os.path.exists(","+                        os.path.join(entry, \".git\")):","+                    merged[key][0] = entry","+        return [(merged[k][0], sorted(merged[k][1])) for k in order]","+","+    # -- main per-repo processing ---------------------------------------","+    def process(self, base_expr, extra_tips):","+        dbg(\"processing %s (common %s)\" % (self.entry, self.commondir))","+        self.capture_original_objects()","+        self.gather_worktrees()","+        if self.has_prunable_worktrees():","+            self.git(\"worktree\", \"prune\", \"--expire\", \"now\")","+            self.gather_worktrees()","+        self.snapshot_indexes()","+        self.collect_tips(base_expr, extra_tips)","+        self.compute_allowed_commits()","+        self.classify_and_delete_refs()","+        self.sweep_broken_refs()","+        self.clean_pseudo_and_state()","+        self.clean_reflogs()","+        self.prune_objects()","+        try:","+            self.prune_lfs()","+        except Exception as exc:","+            dbg(\"lfs prune failed in %s: %s\" % (self.entry, exc))","+        try:","+            self.scan_metadata_for_pruned_oids()","+        except Exception as exc:","+            dbg(\"metadata scan failed in %s: %s\" % (self.entry, exc))","+        self.restore_indexes()","+        if self.alt_unresolved:","+            self.failed = True","+            FAILED.append(\"%s: alternate object store unresolved\" % self.entry)","+","+","+def process_repo(entry, base_expr, extra_tips, depth=0):","+    if depth > 20:","+        dbg(\"recursion depth exceeded at %s\" % entry)","+        return","+    repo = Repo.probe(entry)","+    if repo is None:","+        return","+    key = os.path.realpath(repo.commondir)","+    if key in PROCESSED:","+        prev_tips = PROCESSED[key]","+        new_tips = [t for t in (extra_tips or []) if t not in prev_tips]","+        if not new_tips:","+            return","+        still_there = [t for t in new_tips if repo.peel_commit(t) or repo.object_exists(t)]","+        if not still_there:","+            dbg(\"shared repo %s already processed; extra tips gone\" % entry)","+            return","+        extra_tips = list(prev_tips) + still_there","+    PROCESSED[key] = list(extra_tips or []) + (","+        [base_expr] if base_expr else [])","+    repo.process(base_expr, extra_tips)","+    try:","+        jobs = repo.collect_child_jobs()","+    except Exception as exc:","+        dbg(\"child discovery in %s failed: %s\" % (entry, exc))","+        jobs = []","+    for child_entry, child_tips in jobs:","+        process_repo(child_entry, None, child_tips, depth + 1)","+","+","+def process_standalone_nested(root):","+    \"\"\"No top-level git repo: sanitize any direct nested git repos.\"\"\"","+    if not os.path.isdir(root):","+        return","+    for cur, dirs, files in os.walk(root, topdown=True, followlinks=False):","+        if cur != root and (\".git\" in dirs or \".git\" in files):","+            process_repo(cur, None, [])","+            dirs[:] = []","+            continue","+        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(cur, d))]","+","+","+def main(argv):","+    if len(argv) != 3:","+        print(\"usage: sanitize <repo_dir> <spec.json>\", file=sys.stderr)","+        return 2","+    make_env()","+    repo_dir = os.path.abspath(argv[1])","+    spec_path = argv[2]","+    base_commit = None","+    try:","+        with open(spec_path, \"r\", encoding=\"utf-8\") as fh:","+            spec = json.load(fh)","+        if isinstance(spec, dict):","+            val = spec.get(\"base_commit\")","+            if isinstance(val, str) and val.strip():","+                base_commit = val.strip()","+    except Exception as exc:","+        print(\"sanitize: cannot read spec %s: %s\" % (spec_path, exc),","+              file=sys.stderr)","+        # Without a base commit we can still prune to the handed-over HEAD.","+        base_commit = None","+    if not os.path.isdir(repo_dir):","+        print(\"sanitize: repo dir %s does not exist\" % repo_dir, file=sys.stderr)","+        return 2","+    try:","+        repo = Repo.probe(repo_dir)","+        if repo is None:","+            process_standalone_nested(repo_dir)","+        else:","+            # process_repo re-probes; pass the top-level so linked-worktree","+            # and submodule contexts keep their own HEAD/index","+            entry = repo.toplevel or repo_dir","+            process_repo(entry, base_commit, [])","+    finally:","+        if HOOKS_DIR:","+            shutil.rmtree(HOOKS_DIR, ignore_errors=True)","+    if FAILED:","+        for msg in FAILED:","+            print(\"sanitize: %s\" % msg, file=sys.stderr)","+        return 1","+    return 0","+","+","+if __name__ == \"__main__\":","+    sys.exit(main(sys.argv))"],"newLines":278,"newStart":1154,"oldLines":3,"oldStart":1154}],"path":"/app/sanitize/sanitize"}]}