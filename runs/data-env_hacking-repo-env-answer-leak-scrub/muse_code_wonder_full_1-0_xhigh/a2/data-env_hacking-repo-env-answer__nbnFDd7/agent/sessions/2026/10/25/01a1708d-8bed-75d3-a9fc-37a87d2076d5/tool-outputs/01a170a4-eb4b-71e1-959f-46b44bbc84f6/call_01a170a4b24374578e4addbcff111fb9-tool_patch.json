{"files":[{"hunks":[{"lines":["                 os.utime(path, ns=(atime_ns, mtime_ns))","             except OSError as exc:","                 dbg(\"restore index %s failed: %s\" % (path, exc))","+","+    # -- refs -----------------------------------------------------------","+    def list_refs(self):","+        fmt = \"%(refname)\\t%(objectname)\\t%(objecttype)\\t%(*objectname)\\t%(*objecttype)\\t%(symref)\"","+        res = self.git(\"for-each-ref\", \"--format=\" + fmt, optional_locks=False)","+        refs = []","+        if res.returncode != 0:","+            return refs","+        for line in out_text(res).splitlines():","+            parts = line.split(\"\\t\")","+            while len(parts) < 6:","+                parts.append(\"\")","+            refs.append({","+                \"name\": parts[0], \"oid\": parts[1], \"type\": parts[2],","+                \"peeled\": parts[3], \"peeled_type\": parts[4], \"symref\": parts[5],","+            })","+        return refs","+","+    def ref_final(self, ref):","+        oid = ref[\"peeled\"] or ref[\"oid\"]","+        typ = ref[\"peeled_type\"] or ref[\"type\"]","+        seen = set()","+        while typ == \"tag\" and oid and oid not in seen:","+            seen.add(oid)","+            content = self.git_out(\"cat-file\", \"tag\", oid)","+            nxt_oid = None","+            nxt_type = None","+            for line in content.splitlines():","+                if line.startswith(\"object \"):","+                    nxt_oid = line.split(\" \", 1)[1].strip()","+                elif line.startswith(\"type \"):","+                    nxt_type = line.split(\" \", 1)[1].strip()","+                elif not line:","+                    break","+            if not nxt_oid:","+                return None, None","+            oid, typ = nxt_oid, nxt_type or self.object_type(nxt_oid)","+        return oid, typ","+","+    def classify_and_delete_refs(self):","+        refs = self.list_refs()","+        checked_out = set()","+        if self.head_symref:","+            checked_out.add(self.head_symref)","+        for rec in self.worktrees:","+            branch = rec.get(\"branch\", \"\")","+            if branch:","+                checked_out.add(branch)","+            path = rec.get(\"worktree\", \"\")","+            if path and os.path.exists(path):","+                try:","+                    sub = Repo.probe(path)","+                    if sub and os.path.realpath(sub.commondir) == os.path.realpath(self.commondir):","+                        sym = sub.git_out(\"symbolic-ref\", \"-q\", \"HEAD\")","+                        if sym:","+                            checked_out.add(sym)","+                except Exception:","+                    pass","+        keep = set()","+        delete = []","+        symrefs = []","+        for ref in refs:","+            name = ref[\"name\"]","+            if ref[\"symref\"]:","+                symrefs.append(ref)","+                continue","+            if name.startswith(\"refs/replace/\") or name.startswith(\"refs/notes/\") \\","+                    or name == \"refs/stash\" or name.startswith(\"refs/stash/\"):","+                delete.append(ref)","+                continue","+            if name in checked_out:","+                keep.add(name)","+                continue","+            final_oid, final_type = self.ref_final(ref)","+            if final_oid is None or final_type is None:","+                delete.append(ref)","+            elif final_type == \"commit\":","+                if final_oid in self.allowed_commits:","+                    keep.add(name)","+                else:","+                    delete.append(ref)","+            elif final_type in (\"tree\", \"blob\"):","+                if final_oid in self.allowed_objects():","+                    keep.add(name)","+                else:","+                    delete.append(ref)","+            else:","+                delete.append(ref)","+        # symbolic refs: keep only when their target survives","+        live_after = keep | set(r[\"name\"] for r in refs","+                                if r[\"name\"] not in set(d[\"name\"] for d in delete)","+                                and not r[\"symref\"])","+        delete_sym = []","+        for ref in symrefs:","+            target = ref[\"symref\"]","+            if target in live_after or target in checked_out:","+                keep.add(ref[\"name\"])","+            else:","+                delete_sym.append(ref)","+        dbg(\"refs in %s: keep=%d delete=%d symdelete=%d\" % (","+            self.entry, len(keep), len(delete), len(delete_sym)))","+        # batch deletion of regular refs","+        chunk = []","+        def flush(chunk):","+            if not chunk:","+                return","+            inp = \"\".join(\"delete %s %s\\n\" % (r[\"name\"], r[\"oid\"]) for r in chunk)","+            res = self.git(\"update-ref\", \"--stdin\", inp=inp)","+            if res.returncode != 0:","+                for r in chunk:","+                    self.git(\"update-ref\", \"-d\", r[\"name\"], r[\"oid\"])","+        for ref in delete:","+            chunk.append(ref)","+            if len(chunk) >= 200:","+                flush(chunk)","+                chunk = []","+        flush(chunk)","+        for ref in delete_sym:","+            res = self.git(\"symbolic-ref\", \"-d\", ref[\"name\"])","+            if res.returncode != 0:","+                self.git(\"update-ref\", \"--no-deref\", \"-d\", ref[\"name\"])","+        return keep","+","+    def sweep_broken_refs(self):","+        roots = []","+        for gdir in self.all_gitdirs():","+            roots.append((gdir, os.path.join(gdir, \"refs\")))","+        for gdir, refs_root in roots:","+            if not os.path.isdir(refs_root):","+                continue","+            for root, _dirs, files in os.walk(refs_root):","+                for name in files:","+                    if name.endswith(\".lock\"):","+                        continue","+                    path = os.path.join(root, name)","+                    rel = os.path.relpath(path, refs_root).replace(os.sep, \"/\")","+                    refname = \"refs/\" + rel","+                    if refname == self.head_symref:","+                        continue","+                    try:","+                        self._sweep_one_ref(gdir, path, refname)","+                    except Exception as exc:","+                        dbg(\"sweep %s failed: %s\" % (path, exc))","+        # rewrite packed-refs from the surviving refs","+        self.git(\"pack-refs\", \"--all\", \"--prune\")","+","+    def _sweep_one_ref(self, gdir, path, refname):","+        if os.path.islink(path):","+            target = os.readlink(path)","+            # old-style symlinked ref; leave it to git unless clearly dangling","+            return","+        with open(path, \"rb\") as fh:","+            head = fh.read(256).decode(\"utf-8\", \"surrogateescape\").strip()","+        if head.startswith(\"ref:\"):","+            target = head[4:].strip()","+            res = self.git_in_gitdir(gdir, \"show-ref\", \"-q\", \"--verify\", target,","+                                     optional_locks=False)","+            if res.returncode != 0:","+                r2 = self.git_in_gitdir(gdir, \"symbolic-ref\", \"-d\", refname)","+                if r2.returncode != 0:","+                    safe_unlink(path)","+            return","+        token = head.split()[0] if head.split() else \"\"","+        if is_hex(token, self.oid_len) and not self.object_exists(token):","+            r2 = self.git_in_gitdir(gdir, \"update-ref\", \"--no-deref\", \"-d\",","+                                    refname, token)","+            if r2.returncode != 0 and os.path.exists(path):","+                safe_unlink(path)"],"newLines":171,"newStart":492,"oldLines":3,"oldStart":492}],"path":"/app/sanitize/sanitize"}]}