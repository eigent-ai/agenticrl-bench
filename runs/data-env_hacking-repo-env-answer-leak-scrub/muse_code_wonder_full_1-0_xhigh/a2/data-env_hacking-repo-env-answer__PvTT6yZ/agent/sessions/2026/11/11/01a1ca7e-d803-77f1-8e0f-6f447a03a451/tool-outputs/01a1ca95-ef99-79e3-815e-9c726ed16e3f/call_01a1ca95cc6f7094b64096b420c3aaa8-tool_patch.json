{"files":[{"hunks":[{"lines":["                 else:","                     remove_quiet(path)"," ","+    def purge_objects(self):","+        packdir = os.path.join(self.common, \"objects\", \"pack\")","+        if os.path.isdir(packdir):","+            for fn in list(os.listdir(packdir)):","+                if fn.endswith(\".keep\"):","+                    remove_quiet(os.path.join(packdir, fn))","+                if fn.startswith(\"multi-pack-index\"):","+                    remove_quiet(os.path.join(packdir, fn))","+        remove_quiet(os.path.join(","+            self.common, \"objects\", \"info\", \"commit-graph\"))","+        shutil.rmtree(os.path.join(","+            self.common, \"objects\", \"info\", \"commit-graphs\"),","+            ignore_errors=True)","+        if self.all_pre:","+            self.g.run([\"repack\", \"-A\", \"-d\",","+                        \"--unpack-unreachable=now\", \"-q\"])","+            self.g.run([\"prune\", \"--expire\", \"now\"])","+            self.g.run([\"prune-packed\", \"-q\"], check=False)","+        alt = os.path.join(self.common, \"objects\", \"info\", \"alternates\")","+        if self.flags.get(\"alternates\"):","+            remove_quiet(alt)","+            r = self.g.run([\"fsck\", \"--connectivity-only\", \"--no-dangling\"],","+                           check=False)","+            if r.returncode != 0:","+                raise SanitizeError(","+                    \"repository %s does not verify after removing object \"","+                    \"alternates; refusing to continue\" % self.label)","+        packs_info = os.path.join(self.common, \"objects\", \"info\", \"packs\")","+        if not self.flags.get(\"packs_info\") and os.path.exists(packs_info):","+            remove_quiet(packs_info)","+        info_refs = os.path.join(self.common, \"info\", \"refs\")","+        if not self.flags.get(\"info_refs\") and os.path.exists(info_refs):","+            remove_quiet(info_refs)","+        if self.flags.get(\"graph\"):","+            self.g.run([\"commit-graph\", \"write\", \"--reachable\"],","+                       check=False)","+        if self.flags.get(\"midx\"):","+            self.g.run([\"multi-pack-index\", \"write\"], check=False)","+","+    def prune_lfs(self, blob_candidates):","+        lfs_objects = os.path.join(self.common, \"lfs\", \"objects\")","+        if not os.path.isdir(lfs_objects) or not blob_candidates:","+            return","+        needed = set()","+        proc_in = \"\\n\".join(sorted(blob_candidates)) + \"\\n\"","+        r = self.g.run([\"cat-file\", \"--batch\"],","+                       input_data=proc_in.encode(), check=False)","+        if r.returncode == 0:","+            data = r.stdout","+            pos = 0","+            while pos < len(data):","+                nl = data.find(b\"\\n\", pos)","+                if nl < 0:","+                    break","+                header = data[pos:nl].split(b\" \")","+                if len(header) < 3 or header[1] == b\"missing\":","+                    pos = nl + 1","+                    continue","+                try:","+                    size = int(header[2])","+                except ValueError:","+                    break","+                body = data[nl + 1:nl + 1 + size]","+                pos = nl + 1 + size + 1","+                if body.startswith(","+                        b\"version https://git-lfs.github.com/spec/v1\"):","+                    m = re.search(rb\"oid sha256:([0-9a-f]{64})\", body)","+                    if m:","+                        needed.add(m.group(1).decode(\"ascii\"))","+        if self.job.worktree:","+            r = self.g.run([\"ls-files\", \"-z\"], check=False)","+            if r.returncode == 0:","+                for raw in r.stdout.split(b\"\\x00\"):","+                    if not raw:","+                        continue","+                    path = os.path.join(","+                        self.job.worktree,","+                        raw.decode(\"utf-8\", \"surrogateescape\"))","+                    try:","+                        if os.path.isfile(path) and not os.path.islink(path) \\","+                                and os.path.getsize(path) <= 1024:","+                            body = read_bytes(path) or b\"\"","+                            if body.startswith(","+                                    b\"version https://git-lfs.github\"","+                                    b\".com/spec/v1\"):","+                                m = re.search(","+                                    rb\"oid sha256:([0-9a-f]{64})\", body)","+                                if m:","+                                    needed.add(m.group(1).decode(\"ascii\"))","+                    except OSError:","+                        pass","+        for root, _dirs, files in os.walk(lfs_objects, followlinks=False):","+            for fn in files:","+                if re.fullmatch(r\"[0-9a-f]{64}\", fn) and fn not in needed:","+                    remove_quiet(os.path.join(root, fn))","+        shutil.rmtree(os.path.join(self.common, \"lfs\", \"tmp\"),","+                      ignore_errors=True)","+"," "],"newLines":102,"newStart":886,"oldLines":4,"oldStart":886}],"path":"/app/sanitize/sanitize"}]}