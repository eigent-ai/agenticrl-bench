{"files":[{"hunks":[{"lines":["                     % (key, self.label, before.get(key), after.get(key)))"," "," ","+def assign_extra_tips(jobs, main, repo_dir, hooks_dir, base_commit):","+    if main is not None:","+        main.extra_tips.append(base_commit)","+    worktrees = []","+    for job in jobs:","+        if job.worktree:","+            worktrees.append((os.path.realpath(job.worktree), job))","+    worktrees.sort(key=lambda x: len(x[0]))","+    for job in jobs:","+        if job is main:","+            continue","+        tips = set()","+        if job.worktree:","+            wt = os.path.realpath(job.worktree)","+            super_job = None","+            for path, cand in worktrees:","+                if cand is not job and wt.startswith(path.rstrip(\"/\") + \"/\"):","+                    super_job = cand  # longest wins (sorted by length)","+            if super_job is not None:","+                rel = os.path.relpath(wt, os.path.realpath(","+                    super_job.worktree))","+                tips |= super_gitlinks(","+                    super_job.worktree, rel, hooks_dir,","+                    base_commit if super_job is main else None)","+        else:","+            # Orphan module gitdir: map modules/<name> via super .gitmodules.","+            common = os.path.realpath(job.commondir)","+            for path, cand in worktrees:","+                modules = os.path.realpath(","+                    os.path.join(cand.commondir, \"modules\"))","+                if common.startswith(modules.rstrip(\"/\") + \"/\"):","+                    cand_wt = cand.worktree","+                    gm = os.path.join(cand_wt, \".gitmodules\") \\","+                        if cand_wt else None","+                    name = os.path.relpath(","+                        common, modules).split(os.sep)[0]","+                    if gm and os.path.isfile(gm):","+                        g = Git(cand_wt, None, hooks_dir)","+                        r = g.run([\"config\", \"-f\", gm, \"--get\",","+                                   \"submodule.%s.path\" % name],","+                                  check=False)","+                        if r.returncode == 0:","+                            rel = r.stdout.decode(","+                                \"utf-8\", \"surrogateescape\").strip()","+                            tips |= super_gitlinks(","+                                cand_wt, rel, hooks_dir,","+                                base_commit if cand is main else None)","+                    break","+        job.extra_tips.extend(sorted(tips))","+","+","+def main(argv):","+    if len(argv) != 3:","+        sys.stderr.write(\"usage: sanitize <repo_dir> <spec.json>\\n\")","+        return 2","+    repo_dir = os.path.abspath(argv[1])","+    spec_path = argv[2]","+    if not os.path.isdir(repo_dir):","+        sys.stderr.write(\"sanitize: repo dir %r is not a directory\\n\"","+                         % repo_dir)","+        return 2","+    try:","+        with open(spec_path, \"r\", encoding=\"utf-8\") as f:","+            spec = json.load(f)","+    except (OSError, ValueError) as e:","+        sys.stderr.write(\"sanitize: cannot read spec %r: %s\\n\"","+                         % (spec_path, e))","+        return 2","+    base_commit = spec.get(\"base_commit\") if isinstance(spec, dict) else None","+    if not base_commit or not isinstance(base_commit, str):","+        sys.stderr.write(\"sanitize: spec has no base_commit\\n\")","+        return 2","+    tmp_dir = tempfile.mkdtemp(prefix=\"sanitize-\")","+    try:","+        hooks_dir = os.path.join(tmp_dir, \"no-hooks\")","+        os.makedirs(hooks_dir, exist_ok=True)","+        jobs, main_job, other_vcs = discover_jobs(repo_dir, hooks_dir)","+        for path in other_vcs:","+            warn(\"non-git VCS metadata under %s left as-is (git-only \"","+                 \"sanitizer)\" % path)","+        if not jobs:","+            warn(\"no git repository found under %s; nothing to do\"","+                 % repo_dir)","+            return 0","+        if main_job is None:","+            warn(\"no main git repository at %s; sanitizing nested \"","+                 \"repositories only\" % repo_dir)","+        assign_extra_tips(jobs, main_job, repo_dir, hooks_dir, base_commit)","+        jobs.sort(key=lambda j: (","+            1 if j is main_job else 0,","+            -(len(os.path.realpath(j.worktree)) if j.worktree","+              else len(os.path.realpath(j.commondir)))))","+        for job in jobs:","+            RepoSanitizer(job, repo_dir, hooks_dir, tmp_dir).run()","+        return 0","+    except SanitizeError as e:","+        sys.stderr.write(\"sanitize: error: %s\\n\" % e)","+        return 1","+    finally:","+        shutil.rmtree(tmp_dir, ignore_errors=True)","+","+","+if __name__ == \"__main__\":","+    sys.exit(main(sys.argv))","+","+"],"newLines":109,"newStart":1164,"oldLines":3,"oldStart":1164}],"path":"/app/sanitize/sanitize"}]}