{"files":[{"hunks":[{"lines":["+#!/usr/bin/env python3","+import json, os, shutil, subprocess, sys","+ROOT=\"/tmp/synth2\"","+ENV=dict(os.environ, GIT_AUTHOR_NAME=\"T\", GIT_AUTHOR_EMAIL=\"t@t\",","+         GIT_COMMITTER_NAME=\"T\", GIT_COMMITTER_EMAIL=\"t@t\",","+         GIT_CONFIG_NOSYSTEM=\"1\", HOME=ROOT+\"/home\")","+FAILS=[]","+def run(cmd,cwd=None,check=True,env=None):","+    r=subprocess.run(cmd,cwd=cwd,capture_output=True,env=env or ENV)","+    if check and r.returncode!=0: raise AssertionError(f\"{cmd} rc={r.returncode} {r.stderr.decode()[:500]}\")","+    return r","+def git(tb,*a,check=True): return run([\"git\",\"-C\",tb]+list(a),check=check)","+def gt(tb,*a):","+    r=git(tb,*a,check=False); return r.returncode,r.stdout.decode(\"utf-8\",\"surrogateescape\")","+def ck(c,m):","+    print((\"PASS \" if c else \"FAIL \")+m,flush=True)","+    if not c: FAILS.append(m)","+def write(p,s): os.makedirs(os.path.dirname(p),exist_ok=True); open(p,\"w\").write(s)","+def spec(tb,base,name):","+    p=os.path.join(tb,\"..\",name+\"-spec.json\"); json.dump({\"instance_id\":name,\"repo\":\"x/y\",\"base_commit\":base},open(p,\"w\")); return p","+def sanitize(tb,sp):","+    home=tb+\"-home\"; tmp=tb+\"-tmp\"; os.makedirs(home,exist_ok=True); os.makedirs(tmp,exist_ok=True)","+    return subprocess.run([\"/app/sanitize/sanitize\",tb,sp],capture_output=True,env={\"PATH\":os.environ[\"PATH\"],\"HOME\":home,\"TMPDIR\":tmp})","+def exists(tb,oid): return git(tb,\"cat-file\",\"-e\",oid,check=False).returncode==0","+def init(tb):","+    shutil.rmtree(tb,ignore_errors=True); os.makedirs(tb); git(tb,\"init\",\"-q\",\"-b\",\"main\",\".\"); return tb","+def commit(tb,fn,content,msg):","+    write(os.path.join(tb,fn),content); git(tb,\"add\",\"--\",fn); git(tb,\"commit\",\"-q\",\"-m\",msg); return gt(tb,\"rev-parse\",\"HEAD\")[1].strip()","+","+shutil.rmtree(ROOT,ignore_errors=True); os.makedirs(ROOT+\"/home\")","+","+print(\"== rerun empty ==\")","+tb=init(os.path.join(ROOT,\"empty\")); sp=spec(tb,\"1\"*40,\"empty\"); r=sanitize(tb,sp)","+ck(r.returncode==0,f\"empty rc0 {r.stderr.decode()[:300]}\")","+","+print(\"== S5 submodule initialized + future ==\")","+sub=init(os.path.join(ROOT,\"subsrc\")); sb=commit(sub,\"sf\",\"sbase\\n\",\"sbase\"); SF=commit(sub,\"sec\",\"subsecret\\n\",\"sfut\")","+git(sub,\"tag\",\"sfuttag\",SF); git(sub,\"reset\",\"-q\",\"--hard\",sb)","+super_=init(os.path.join(ROOT,\"s5\")); a=commit(super_,\"f\",\"a\\n\",\"c1\")","+git(super_,\"-c\",\"protocol.file.allow=always\",\"submodule\",\"add\",\"-q\",sub,\"submod\")","+git(super_,\"commit\",\"-q\",\"-m\",\"addsub\",\"-a\"); BASE5=gt(super_,\"rev-parse\",\"HEAD\")[1].strip()","+FUT5=commit(super_,\"supfut\",\"supersecret\\n\",\"supfut\"); git(super_,\"reset\",\"-q\",\"--hard\",BASE5)","+mod=os.path.join(super_,\"submod\")","+ck(exists(mod,SF),\"S5 setup: sub future present before\")","+st_before=gt(super_,\"submodule\",\"status\")[1]; sup_st=git(super_,\"status\",\"--porcelain=v1\",\"-z\").stdout","+sp=spec(super_,BASE5,\"s5\"); r=sanitize(super_,sp); print(\" rc\",r.returncode,r.stderr.decode()[:600])","+ck(r.returncode==0,\"S5 rc0\")","+ck(not exists(super_,FUT5),\"S5 super future gone\")","+ck(not exists(mod,SF),\"S5 sub future commit gone\")","+ck(exists(mod,sb),\"S5 sub base present\")","+ck(gt(mod,\"rev-parse\",\"HEAD\")[1].strip()==sb,\"S5 sub HEAD same\")","+ck(gt(super_,\"submodule\",\"status\")[1]==st_before,\"S5 submodule status same\")","+ck(git(super_,\"status\",\"--porcelain=v1\",\"-z\").stdout==sup_st,\"S5 super status same\")","+","+print(\"== S5b deinit orphan module ==\")","+super2=os.path.join(ROOT,\"s5b\"); run([\"cp\",\"-a\",os.path.join(ROOT,\"s5\"),super2])","+# make a fresh one instead: recreate similar then deinit","+super2=init(super2); a=commit(super2,\"f\",\"a\\n\",\"c1\")","+git(super2,\"-c\",\"protocol.file.allow=always\",\"submodule\",\"add\",\"-q\",sub,\"submod\")","+git(super2,\"commit\",\"-q\",\"-m\",\"addsub\",\"-a\"); BASE5B=gt(super2,\"rev-parse\",\"HEAD\")[1].strip()","+# re-add future tag into module (submodule add cloned; fetch tags incl fut already? tag exists in module because source has it as tag fetched)","+modgit=os.path.join(super2,\".git/modules/submod\")","+ck(run([\"git\",\"--git-dir\",modgit,\"cat-file\",\"-e\",SF],check=False).returncode==0,\"S5b setup module future present\")","+git(super2,\"submodule\",\"deinit\",\"-q\",\"-f\",\"submod\")","+ck(os.listdir(os.path.join(super2,\"submod\"))==[],\"S5b deinit empty worktree\")","+FUTB=commit(super2,\"z\",\"secret\\n\",\"fut\"); git(super2,\"reset\",\"-q\",\"--hard\",BASE5B)","+sp=spec(super2,BASE5B,\"s5b\"); r=sanitize(super2,sp); print(\" rc\",r.returncode,r.stderr.decode()[:600])","+ck(r.returncode==0,\"S5b rc0\")","+ck(run([\"git\",\"--git-dir\",modgit,\"cat-file\",\"-e\",SF],check=False).returncode!=0,\"S5b orphan module future gone\")","+ck(run([\"git\",\"--git-dir\",modgit,\"cat-file\",\"-e\",sb],check=False).returncode==0,\"S5b orphan module base present\")","+ck(not exists(super2,FUTB),\"S5b super future gone\")","+","+print(\"== S6 shared clone (alternates) ==\")","+src=os.path.join(ROOT,\"s6\"); r=run([\"git\",\"clone\",\"-q\",\"--shared\",os.path.join(ROOT,\"s5\"),src],check=False)","+# simpler: own src","+ssrc=init(os.path.join(ROOT,\"s6src\")); a=commit(ssrc,\"f\",\"a\\n\",\"c1\"); BASE6=commit(ssrc,\"f\",\"base\\n\",\"base\"); FUT6=commit(ssrc,\"sec\",\"secret\\n\",\"fut\")","+dst=os.path.join(ROOT,\"s6dst\"); run([\"git\",\"clone\",\"-q\",\"--shared\",ssrc,dst])","+git(dst,\"reset\",\"-q\",\"--hard\",BASE6); git(dst,\"tag\",\"futtag\",FUT6)","+ck(os.path.exists(os.path.join(dst,\".git/objects/info/alternates\")),\"S6 setup alternates exists\")","+ck(exists(dst,FUT6),\"S6 setup future via alternate/tag present\")","+sp=spec(dst,BASE6,\"s6\"); r=sanitize(dst,sp); print(\" rc\",r.returncode,r.stderr.decode()[:600])","+ck(r.returncode==0,\"S6 rc0\")","+ck(not os.path.exists(os.path.join(dst,\".git/objects/info/alternates\")),\"S6 alternates removed\")","+ck(gt(dst,\"log\",\"--format=%H\",\"HEAD\")[1].split()==[BASE6,a],\"S6 history intact after localization\")","+ck(not exists(dst,FUT6),\"S6 future gone\")","+","+print(\"== S7 shallow ==\")","+ssrc2=init(os.path.join(ROOT,\"s7src\")); a=commit(ssrc2,\"f\",\"a\\n\",\"c1\"); b=commit(ssrc2,\"f\",\"b\\n\",\"c2\"); BASE7=commit(ssrc2,\"f\",\"base\\n\",\"base\"); FUT7=commit(ssrc2,\"sec\",\"secret\\n\",\"fut\"); git(ssrc2,\"tag\",\"futtag\",FUT7)","+dst=os.path.join(ROOT,\"s7dst\"); run([\"git\",\"clone\",\"-q\",\"--depth\",\"2\",\"file://\"+ssrc2,dst])","+git(dst,\"reset\",\"-q\",\"--hard\",BASE7)","+git(dst,\"fetch\",\"-q\",\"--depth\",\"1\",\"origin\",\"tag\",\"futtag\",check=False)","+ck(os.path.exists(os.path.join(dst,\".git/shallow\")),\"S7 setup shallow exists\")","+ck(exists(dst,FUT7),\"S7 setup future present\")","+sp=spec(dst,BASE7,\"s7\"); r=sanitize(dst,sp); print(\" rc\",r.returncode,r.stderr.decode()[:800])","+ck(r.returncode==0,\"S7 rc0\")","+if r.returncode==0:","+    ck(not exists(dst,FUT7),\"S7 future gone\")","+    ck(gt(dst,\"log\",\"--oneline\",\"HEAD\")[0]==0,\"S7 log works\")","+    sh=open(os.path.join(dst,\".git/shallow\")).read() if os.path.exists(os.path.join(dst,\".git/shallow\")) else \"\"","+    ck(FUT7 not in sh,\"S7 shallow clean\")","+    rc,out=gt(dst,\"fsck\",\"--full\"); print(\" fsck rclines\",rc,out[:200])","+","+print(\"== S9 internal worktree at past ==\")","+tb=init(os.path.join(ROOT,\"s9\")); a=commit(tb,\"f\",\"a\\n\",\"c1\"); BASE9=commit(tb,\"f\",\"base\\n\",\"base\"); FUT9=commit(tb,\"sec\",\"secret\\n\",\"fut\"); git(tb,\"reset\",\"-q\",\"--hard\",BASE9)","+run([\"git\",\"-C\",tb,\"worktree\",\"add\",\"-q\",os.path.join(tb,\"wt\"),a])","+st_before=git(tb,\"status\",\"--porcelain=v1\",\"-z\").stdout","+sp=spec(tb,BASE9,\"s9\"); r=sanitize(tb,sp); print(\" rc\",r.returncode,r.stderr.decode()[:600])","+ck(r.returncode==0,\"S9 rc0\")","+ck(gt(os.path.join(tb,\"wt\"),\"rev-parse\",\"HEAD\")[1].strip()==a,\"S9 worktree HEAD kept\")","+ck(open(os.path.join(tb,\"wt/f\")).read()==\"a\\n\",\"S9 worktree files intact\")","+ck(not exists(tb,FUT9),\"S9 future gone\")","+ck(git(tb,\"status\",\"--porcelain=v1\",\"-z\").stdout==st_before,\"S9 main status same\")","+","+print(\"FAILURES:\", FAILS if FAILS else \"none\")","+sys.exit(1 if FAILS else 0)"],"newLines":115,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/synth2.py"}]}