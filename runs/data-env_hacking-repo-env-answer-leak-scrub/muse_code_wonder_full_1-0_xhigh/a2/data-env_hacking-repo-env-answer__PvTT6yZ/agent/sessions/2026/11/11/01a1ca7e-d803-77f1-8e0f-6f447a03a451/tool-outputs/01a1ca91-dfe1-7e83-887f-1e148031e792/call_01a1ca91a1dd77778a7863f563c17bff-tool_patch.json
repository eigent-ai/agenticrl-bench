{"files":[{"hunks":[{"lines":["             os.path.isdir(os.path.join(path, \"objects\")) and","             os.path.isdir(os.path.join(path, \"refs\")))"," ","+","+class RepoJob:","+    def __init__(self, worktree, gitdir, commondir):","+        self.worktree = worktree","+        self.gitdir = gitdir","+        self.commondir = commondir","+        self.extra_tips = []","+        self.is_main = False","+","+    def key(self):","+        return os.path.realpath(self.commondir)","+","+","+def discover_jobs(repo_dir, hooks_dir):","+    jobs = {}  # commondir realpath -> RepoJob","+    other_vcs = []","+","+    def add(ctx):","+        if ctx is None:","+            return None","+        wt, gd, cd = ctx","+        if not is_subpath(cd, repo_dir) and os.path.realpath(cd) != os.path.realpath(repo_dir):","+            warn(\"skipping repo whose git dir lies outside %s: %s\" % (repo_dir, cd))","+            return None","+        key = os.path.realpath(cd)","+        old = jobs.get(key)","+        if old is not None:","+            # Prefer the main worktree context (gitdir == commondir).","+            if (old.gitdir is None or","+                    os.path.realpath(old.gitdir) != key) and \\","+                    gd is not None and os.path.realpath(gd) == key:","+                old.worktree, old.gitdir = wt, gd","+            if old.worktree is None and wt is not None:","+                old.worktree, old.gitdir = wt, gd","+            return old","+        job = RepoJob(wt, gd, cd)","+        jobs[key] = job","+        return job","+","+    main = add(resolve_ctx(repo_dir, hooks_dir))","+    if main is None and looks_like_gitdir(repo_dir):","+        main = add(resolve_ctx(repo_dir, hooks_dir, gitdir_hint=True))","+    if main is not None:","+        main.is_main = True","+","+    for root, dirs, files in os.walk(repo_dir, topdown=True, followlinks=False):","+        if \".hg\" in dirs or \".svn\" in dirs:","+            other_vcs.append(root)","+        if \".git\" in dirs:","+            dirs.remove(\".git\")","+            if os.path.realpath(root) != os.path.realpath(repo_dir):","+                add(resolve_ctx(root, hooks_dir))","+        elif \".git\" in files:","+            if os.path.realpath(root) != os.path.realpath(repo_dir):","+                add(resolve_ctx(root, hooks_dir))","+        # Never descend into other VCS metadata.","+        for skip in (\".hg\", \".svn\"):","+            if skip in dirs:","+                dirs.remove(skip)","+","+    # Submodule gitdirs under <commondir>/modules (incl. orphans whose","+    # worktree was never populated contain full history too).","+    queue = [j.commondir for j in list(jobs.values())]","+    seen_modules = set()","+    while queue:","+        modules = os.path.join(queue.pop(), \"modules\")","+        real = os.path.realpath(modules)","+        if real in seen_modules or not os.path.isdir(modules):","+            continue","+        seen_modules.add(real)","+        for root, dirs, files in os.walk(modules, topdown=True, followlinks=False):","+            if looks_like_gitdir(root):","+                job = add(resolve_ctx(root, hooks_dir, gitdir_hint=True))","+                if job is not None:","+                    queue.append(job.commondir)","+                # Only a nested \"modules\" dir below a gitdir is relevant.","+                dirs[:] = [d for d in dirs if d == \"modules\"]","+    return list(jobs.values()), main, other_vcs","+","+","+def super_gitlinks(super_wt, rel_path, hooks_dir, base_commit):","+    \"\"\"Gitlink commit ids recorded for a submodule path by its superproject.\"\"\"","+    oids = set()","+    if not super_wt or not rel_path:","+        return oids","+    g = Git(super_wt, None, hooks_dir)","+    r = g.run([\"ls-files\", \"-s\", \"-z\", \"--\", rel_path], check=False)","+    if r.returncode == 0:","+        for entry in r.stdout.split(b\"\\x00\"):","+            parts = entry.split()","+            if len(parts) >= 2 and parts[0] == b\"160000\":","+                oids.add(parts[1].decode(\"ascii\", \"replace\"))","+    for rev in (\"HEAD\", base_commit):","+        if not rev:","+            continue","+        r = g.run([\"ls-tree\", \"-z\", rev, \"--\", rel_path], check=False)","+        if r.returncode == 0:","+            for entry in r.stdout.split(b\"\\x00\"):","+                parts = entry.split()","+                if len(parts) >= 3 and parts[0] == b\"160000\":","+                    oids.add(parts[2].decode(\"ascii\", \"replace\"))","+    return oids","+","+"],"newLines":107,"newStart":205,"oldLines":3,"oldStart":205}],"path":"/app/sanitize/sanitize"}]}