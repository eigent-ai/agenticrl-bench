{"files":[{"hunks":[{"lines":[" "," class SanitizeError(Exception):","     pass","+","+","+# ---------------------------------------------------------------------------","+# Repository context (one per distinct git common directory)","+","+","+class RepoCtx:","+    def __init__(self, common_dir):","+        self.common_dir = os.path.realpath(common_dir)","+        self.worktree_candidates = []  # paths of checkouts sharing this db","+        self.gitdir_candidates = []","+        self.primary_worktree = None","+        self.primary_git_dir = self.common_dir","+        self.worktree_hint = None","+        self.use_gitdir_invocation = False","+        self.is_bare = False","+        self.extra_root_specs = []","+        self.is_main = False","+","+    # -- git invocation ----------------------------------------------------","+    def git(self, args, inp=None, extra_configs=(), env=None, at_worktree=None):","+        if at_worktree is not None:","+            return run_git_raw(args, cwd=at_worktree, inp=inp,","+                               extra_configs=extra_configs, env=env)","+        if self.use_gitdir_invocation:","+            return run_git_raw(args, git_dir=self.primary_git_dir,","+                               work_tree=self.worktree_hint,","+                               inp=inp, extra_configs=extra_configs, env=env)","+        if self.primary_worktree:","+            return run_git_raw(args, cwd=self.primary_worktree, inp=inp,","+                               extra_configs=extra_configs, env=env)","+        return run_git_raw(args, git_dir=self.common_dir, inp=inp,","+                           extra_configs=extra_configs, env=env)","+","+    def git_text(self, args, **kwargs):","+        return decode(self.git(args, **kwargs).stdout).strip()","+","+    def git_ok(self, args, **kwargs):","+        result = self.git(args, **kwargs)","+        if result.returncode != 0:","+            raise SanitizeError(","+                \"git %s failed: %s\" % (\" \".join(str(a) for a in args),","+                                       decode(result.stderr)[:2000]))","+        return result","+","+    def git_lines(self, args, **kwargs):","+        result = self.git(args, **kwargs)","+        if result.returncode != 0:","+            return None","+        return decode(result.stdout).splitlines()","+","+    def rev_parse(self, spec, env=None, at_worktree=None):","+        result = self.git([\"rev-parse\", \"--verify\", \"-q\", spec],","+                          env=env, at_worktree=at_worktree)","+        if result.returncode != 0:","+            return None","+        value = decode(result.stdout).strip()","+        return value or None","+","+    def peel_commit(self, spec, env=None):","+        if not spec:","+            return None","+        oid = self.rev_parse(str(spec) + \"^{commit}\", env=env)","+        if oid and is_oid(oid) and not is_zero_oid(oid):","+            return oid.lower()","+        return None","+","+    def git_path(self, name, at_worktree=None):","+        result = self.git([\"rev-parse\", \"--path-format=absolute\",","+                           \"--git-path\", name], at_worktree=at_worktree)","+        if result.returncode == 0:","+            value = decode(result.stdout).strip()","+            if value:","+                return value","+        return os.path.join(self.primary_git_dir, name)","+","+    def object_type(self, oid):","+        result = self.git([\"cat-file\", \"-t\", oid])","+        if result.returncode != 0:","+            return None","+        return decode(result.stdout).strip() or None","+","+    def admin_gitdirs(self):","+        dirs = [self.common_dir]","+        wt_root = os.path.join(self.common_dir, \"worktrees\")","+        if os.path.isdir(wt_root):","+            try:","+                names = sorted(os.listdir(wt_root))","+            except OSError:","+                names = []","+            for name in names:","+                candidate = os.path.join(wt_root, name)","+                if os.path.isdir(candidate) and not os.path.islink(candidate):","+                    dirs.append(candidate)","+        seen = []","+        for path in dirs:","+            if path not in seen:","+                seen.append(path)","+        return seen","+","+    def object_dir(self):","+        return self.git_path(\"objects\")"],"newLines":105,"newStart":151,"oldLines":3,"oldStart":151}],"path":"/app/sanitize/sanitize"}]}