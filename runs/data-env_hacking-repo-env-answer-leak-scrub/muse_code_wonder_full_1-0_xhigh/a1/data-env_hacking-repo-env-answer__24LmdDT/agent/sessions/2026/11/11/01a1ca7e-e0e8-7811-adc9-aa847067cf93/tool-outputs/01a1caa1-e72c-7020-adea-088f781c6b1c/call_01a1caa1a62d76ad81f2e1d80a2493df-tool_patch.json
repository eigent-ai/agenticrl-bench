{"files":[{"hunks":[{"lines":[" ","     def object_dir(self):","         return self.git_path(\"objects\")","+","+","+# ---------------------------------------------------------------------------","+# Repository discovery (top repo, submodules, linked worktrees, bare repos)","+","+","+def _revparse_abs(args, cwd=None, git_dir=None, work_tree=None):","+    result = run_git_raw([\"rev-parse\", \"--path-format=absolute\"] + args,","+                         cwd=cwd, git_dir=git_dir, work_tree=work_tree)","+    if result.returncode != 0:","+        return None","+    value = decode(result.stdout).strip()","+    return value or None","+","+","+def looks_like_gitdir(path):","+    return (os.path.isfile(os.path.join(path, \"HEAD\"))","+            and os.path.isdir(os.path.join(path, \"objects\"))","+            and os.path.isdir(os.path.join(path, \"refs\")))","+","+","+def resolve_candidate(contexts, worktree=None, git_dir=None):","+    \"\"\"Resolve one candidate into contexts[common_dir]; return ctx or None.\"\"\"","+    common = None","+    absolute_git_dir = None","+    toplevel = None","+    if worktree is not None:","+        common = _revparse_abs([\"--git-common-dir\"], cwd=worktree)","+        if common is None:","+            return None","+        absolute_git_dir = _revparse_abs([\"--git-dir\"], cwd=worktree)","+        toplevel = _revparse_abs([\"--show-toplevel\"], cwd=worktree)","+    else:","+        common = _revparse_abs([\"--git-common-dir\"], git_dir=git_dir)","+        if common is None:","+            return None","+        absolute_git_dir = _revparse_abs([\"--git-dir\"], git_dir=git_dir)","+        toplevel = _revparse_abs([\"--show-toplevel\"], git_dir=git_dir)","+    common = os.path.realpath(common)","+    ctx = contexts.get(common)","+    if ctx is None:","+        ctx = RepoCtx(common)","+        contexts[common] = ctx","+    if worktree is not None:","+        path = os.path.realpath(worktree)","+        if path not in ctx.worktree_candidates:","+            ctx.worktree_candidates.append(path)","+    if git_dir is not None:","+        path = os.path.realpath(git_dir)","+        if path not in ctx.gitdir_candidates:","+            ctx.gitdir_candidates.append(path)","+    if toplevel and ctx.worktree_hint is None:","+        ctx.worktree_hint = os.path.realpath(toplevel)","+    if absolute_git_dir and worktree is not None:","+        ctx._wt_gitdir = getattr(ctx, \"_wt_gitdir\", {})","+        ctx._wt_gitdir[os.path.realpath(worktree)] = os.path.realpath(","+            absolute_git_dir)","+    return ctx","+","+","+def scan_modules(contexts, queue):","+    seen_bases = set()","+    while queue:","+        ctx = queue.pop(0)","+        base = os.path.join(ctx.common_dir, \"modules\")","+        marker = os.path.realpath(base)","+        if marker in seen_bases or not os.path.isdir(base):","+            continue","+        seen_bases.add(marker)","+        for root, dirs, _files in os.walk(base):","+            dirs.sort()","+            if looks_like_gitdir(root):","+                sub = resolve_candidate(contexts, git_dir=root)","+                if sub is not None:","+                    queue.append(sub)","+                dirs[:] = [d for d in dirs if d == \"modules\"]","+            else:","+                dirs[:] = [d for d in dirs if d not in (\"objects\",)]","+","+","+def discover_contexts(scan_root, seed_worktree=None):","+    contexts = {}","+    queue = []","+    if seed_worktree is not None:","+        ctx = resolve_candidate(contexts, worktree=seed_worktree)","+        if ctx is not None:","+            queue.append(ctx)","+    if os.path.isdir(scan_root):","+        for root, dirs, files in os.walk(scan_root):","+            dirs.sort()","+            files_set = set(files)","+            has_git_marker = \".git\" in dirs or \".git\" in files_set","+            if has_git_marker:","+                ctx = resolve_candidate(contexts, worktree=root)","+                if ctx is not None:","+                    queue.append(ctx)","+                if \".git\" in dirs:","+                    dirs.remove(\".git\")","+            elif root != scan_root and looks_like_gitdir(root):","+                head = read_file_bytes(os.path.join(root, \"HEAD\")) or b\"\"","+                head = decode(head).strip()","+                if head.startswith(\"ref:\") or is_oid(head):","+                    ctx = resolve_candidate(contexts, git_dir=root)","+                    if ctx is not None:","+                        queue.append(ctx)","+                        dirs[:] = [d for d in dirs if d == \"modules\"]","+                        continue","+            dirs[:] = [d for d in dirs if d != \".git\"]","+    elif looks_like_gitdir(scan_root):","+        ctx = resolve_candidate(contexts, git_dir=scan_root)","+        if ctx is not None:","+            queue.append(ctx)","+    scan_modules(contexts, queue)","+    # Finalize invocation details for every context.","+    for ctx in contexts.values():","+        primary = None","+        wt_gitdir = getattr(ctx, \"_wt_gitdir\", {})","+        for cand in sorted(ctx.worktree_candidates):","+            if wt_gitdir.get(cand) == ctx.common_dir:","+                primary = cand","+                break","+        if primary is None and ctx.worktree_candidates:","+            primary = sorted(ctx.worktree_candidates)[0]","+        if primary is None and ctx.worktree_hint:","+            primary = ctx.worktree_hint","+        ctx.primary_worktree = primary","+        if primary is not None and primary in wt_gitdir:","+            ctx.primary_git_dir = wt_gitdir[primary]","+        elif ctx.gitdir_candidates:","+            ctx.primary_git_dir = sorted(ctx.gitdir_candidates)[0]","+        else:","+            ctx.primary_git_dir = ctx.common_dir","+        # Prefer -C only when the primary path really is a checkout of","+        # this database (has its own .git entry or is the toplevel).","+        if primary is not None and os.path.isdir(primary):","+            marker_ok = os.path.lexists(os.path.join(primary, \".git\"))","+            top = _revparse_abs([\"--show-toplevel\"], cwd=primary)","+            ctx.use_gitdir_invocation = not marker_ok and not (","+                top and os.path.realpath(top) == os.path.realpath(primary))","+        else:","+            ctx.use_gitdir_invocation = True","+        bare_value = ctx.git_text([\"rev-parse\", \"--is-bare-repository\"])","+        top_value = ctx.git([\"rev-parse\", \"--show-toplevel\"])","+        ctx.is_bare = bare_value == \"true\" and top_value.returncode != 0","+        if ctx.is_bare:","+            ctx.use_gitdir_invocation = True","+    return contexts","+","+","+def assign_gitlink_roots(contexts):","+    \"\"\"Record submodule gitlink commits as extra roots of child repos.\"\"\"","+    by_worktree = {}","+    for ctx in contexts.values():","+        for path in ctx.worktree_candidates:","+            by_worktree[os.path.realpath(path)] = ctx","+        if ctx.primary_worktree:","+            by_worktree[os.path.realpath(ctx.primary_worktree)] = ctx","+        if ctx.worktree_hint:","+            by_worktree.setdefault(os.path.realpath(ctx.worktree_hint), ctx)","+    for parent in contexts.values():","+        parent_wt = parent.primary_worktree","+        if not parent_wt or not os.path.isdir(parent_wt):","+            continue","+        result = parent.git([\"ls-files\", \"--stage\", \"-z\"])","+        if result.returncode != 0:","+            continue","+        for entry in decode(result.stdout).split(\"\\0\"):","+            if \"\\t\" not in entry:","+                continue","+            meta, rel = entry.split(\"\\t\", 1)","+            parts = meta.split()","+            if len(parts) != 3 or parts[0] != \"160000\":","+                continue","+            child_path = os.path.realpath(os.path.join(parent_wt, rel))","+            child = by_worktree.get(child_path)","+            if child is None:","+                for cand in contexts.values():","+                    hint = cand.worktree_hint","+                    if hint and os.path.realpath(hint) == child_path:","+                        child = cand","+                        break","+            if child is not None and child is not parent:","+                if parts[1] not in child.extra_root_specs:","+                    child.extra_root_specs.append(parts[1])"],"newLines":187,"newStart":253,"oldLines":3,"oldStart":253}],"path":"/app/sanitize/sanitize"}]}