{"files":[{"hunks":[{"lines":["                             and os.path.realpath(path) == stash_log):","                         continue","                     remove_file(path)","+","+    # -- config: remotes ------------------------------------------------------","+    def _config_remove_section(self, section):","+        self.ctx.git([\"config\", \"--remove-section\", section])","+        self.ctx.git([\"config\", \"--worktree\", \"--remove-section\", section])","+","+    def _config_unset(self, key):","+        self.ctx.git([\"config\", \"--unset-all\", key])","+        self.ctx.git([\"config\", \"--worktree\", \"--unset-all\", key])","+","+    def _remote_names(self):","+        lines = self.ctx.git_lines([\"remote\"]) or []","+        names = [line.strip() for line in lines if line.strip()]","+        legacy_dir = os.path.join(self.ctx.common_dir, \"remotes\")","+        if os.path.isdir(legacy_dir):","+            try:","+                for name in sorted(os.listdir(legacy_dir)):","+                    path = os.path.join(legacy_dir, name)","+                    if os.path.isfile(path) and name not in names:","+                        names.append(name)","+            except OSError:","+                pass","+        return names","+","+    def cleanup_remote_config(self, include_promisors=True):","+        ctx = self.ctx","+        names = self._remote_names()","+        removed = []","+        for name in names:","+            if not include_promisors and name in self.promisor_remotes:","+                continue","+            removed.append(name)","+            self._config_remove_section(\"remote.\" + name)","+            legacy = os.path.join(ctx.common_dir, \"remotes\", name)","+            if os.path.isfile(legacy):","+                remove_file(legacy)","+        # Ancient .git/branches/<name> remote definitions.","+        branches_dir = os.path.join(ctx.common_dir, \"branches\")","+        if os.path.isdir(branches_dir):","+            try:","+