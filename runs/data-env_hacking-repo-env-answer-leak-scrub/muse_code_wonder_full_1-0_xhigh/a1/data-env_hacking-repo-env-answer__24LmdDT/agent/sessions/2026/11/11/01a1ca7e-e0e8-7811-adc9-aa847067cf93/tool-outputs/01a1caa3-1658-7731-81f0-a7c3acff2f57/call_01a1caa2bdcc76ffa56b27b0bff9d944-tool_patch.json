rev_parse(\"refs/stash\", env=RAW_ENV)","+                if current:","+                    self._delete_refs([[\"refs/stash\", current]])","+            return","+        self._delete_refs([[stash_ref[\"name\"], tip]])","+        self.stash_entries = []","+        self.stash_valid = False","+","+    def classify_and_delete_refs(self):","+        refs = self._list_refs()","+        self.handle_stash(refs)","+        # The stash step may have changed refs; re-read for accuracy.","+        refs = self._list_refs()","+        by_name = {ref[\"name\"]: ref for ref in refs}","+        ultimate = {}","+        for ref in refs:","+            if not ref[\"symref\"]:","+                ultimate[ref[\"name\"]] = self._ultimate(ref)","+        delete_regular = []","+        delete_symbolic = []","+        for ref in refs:","+            name = ref[\"name\"]","+            if ref[\"symref\"]:","+                target = ref[\"symref\"]","+                target_ref = by_name.get(target)","+                keep = False","+                if (not name.startswith(\"refs/remotes/\")","+                        and target_ref is not None","+                        and not target.startswith(\"refs/remotes/\")):","+                    target_ultimate = ultimate.get(target)","+                    if target_ultimate:","+                        oid, otype = target_ultimate","+                        keep = (otype == \"commit\" and oid in self.ancestors) or (","+                            oid in self.root_objects)","+                    if target == \"refs/stash\" and self.stash_valid:","+                        keep = True","+                if not keep:","+                    delete_symbolic.append(name)","+                continue","+            if name == \"refs/stash\":","+                if not self.stash_valid:","+                    delete_regular.append([name, ref[\"oid\"]])","+                continue","+            if name.startswith(\"refs/remotes/\"):","+                delete_regular.append([name, ref[\"oid\"]])","+                continue","+            if name.startswith(\"refs/original/\"):","+                delete_regular.append([name, ref[\"oid\"]])","+                continue","+            if name in self.head_symrefs:","+                continue","+            oid, otype = ultimate.get(name, (ref[\"oid\"], ref[\"type\"]))","+            if otype == \"commit\" and oid in self.ancestors:","+                continue","+            if oid in self.root_objects:","+                continue","+            if ref[\"oid\"] in self.root_objects and oid in self.root_objects:","+                continue","+            delete_regular.append([name, ref[\"oid\"]])","+        for name in delete_symbolic:","+            result = self.ctx.git([\"symbolic-ref\", \"-d\", name])","+            if result.returncode == 0:","+                self.deleted_ref_names.add(name)","+        if delete_regular:","+            self._delete_refs(delete_regular)","+        # Remember which initial objects are meant to disappear.","+        allowed = set(self.root_objects)","+        allowed.update(self._index_object_ids())","+        for ref in self._list_refs():","+            allowed.add(ref[\"oid\"])","+            if ref[\"peeled\"]:","+                allowed.add(ref[\"peeled\"])","+        if self.stash_entries:","+            stash_objects = self._rev_list(self.stash_entries, objects=True,","+                                           env=RAW_ENV)","+            if stash_objects:","+                allowed.update(stash_objects)","+        self.initial_forbidden_objects = (","+            set(self.initial_physical) - allowed)","+        allowed_commits = set(self.ancestors)","+        if self.stash_entries:","+            stash_commits = self._rev_list(self.stash_entries, env=RAW_ENV)","+            if stash_commits:","+                allowed_commits.update(stash_commits)","+            allowed_commits.update(self.stash_entries)","+        self.initial