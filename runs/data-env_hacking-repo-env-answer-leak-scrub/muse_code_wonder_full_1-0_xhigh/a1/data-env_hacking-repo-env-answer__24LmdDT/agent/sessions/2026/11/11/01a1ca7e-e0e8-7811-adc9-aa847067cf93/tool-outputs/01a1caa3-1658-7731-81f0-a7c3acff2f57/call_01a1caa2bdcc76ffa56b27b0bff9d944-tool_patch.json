{"files":[{"hunks":[{"lines":["                             [\"symbolic-ref\", \"-q\", \"HEAD\"]):","                         self.head_symrefs.discard(item[\"symref\"])","         self.worktrees = kept","+","+    # -- ref handling -----------------------------------------------------------","+    def _delete_refs(self, refs):","+        \"\"\"refs: list of [refname, old_oid]. Returns names actually gone.\"\"\"","+        if not refs:","+            return []","+        payload = \"\".join(\"delete %s %s\\n\" % (name, oid)","+                          for name, oid in refs)","+        result = self.ctx.git([\"update-ref\", \"--stdin\"], inp=payload)","+        gone = []","+        if result.returncode == 0:","+            gone = [name for name, _oid in refs]","+        else:","+            for name, oid in refs:","+                single = self.ctx.git(","+                    [\"update-ref\", \"-d\", name, oid])","+                if single.returncode == 0:","+                    gone.append(name)","+                    continue","+                single = self.ctx.git([\"update-ref\", \"-d\", name])","+                if single.returncode == 0:","+                    gone.append(name)","+        for name in gone:","+            self.deleted_ref_names.add(name)","+            if name.startswith(\"refs/heads/\"):","+                self.deleted_branch_names.append(name[len(\"refs/heads/\"):])","+        return gone","+","+    def _list_refs(self):","+        fmt = (\"%(refname)%09%(objectname)%09%(objecttype)%09\"","+               \"%(*objectname)%09%(*objecttype)%09%(symref)\")","+        lines = self.ctx.git_lines([\"for-each-ref\", \"--format=\" + fmt],","+                                   env=RAW_ENV)","+        refs = []","+        if not lines:","+            return refs","+        for line in lines:","+            parts = line.split(\"\\t\")","+            while len(parts) < 6:","+                parts.append(\"\")","+            refs.append({","+           