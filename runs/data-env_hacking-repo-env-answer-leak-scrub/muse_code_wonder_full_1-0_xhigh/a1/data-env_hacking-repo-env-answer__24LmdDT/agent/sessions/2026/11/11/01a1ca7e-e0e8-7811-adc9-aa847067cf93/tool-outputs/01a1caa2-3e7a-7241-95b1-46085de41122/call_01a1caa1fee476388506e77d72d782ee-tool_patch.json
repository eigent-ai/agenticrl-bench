     names = sorted(os.listdir(admin))","+            except OSError:","+                continue","+            for name in names:","+                if name == \"index\" or name.startswith(\"sharedindex.\"):","+                    path = os.path.join(admin, name)","+                    if os.path.isfile(path) and not os.path.islink(path):","+                        found.append(path)","+        return found","+","+    def snapshot_state(self):","+        for path in self._index_files():","+            data = read_file_bytes(path)","+            if data is None:","+                continue","+            try:","+                info = os.lstat(path)","+            except OSError:","+                continue","+            self.index_snapshot.append(","+                (path, data, stat.S_IMODE(info.st_mode),","+                 info.st_atime_ns, info.st_mtime_ns))","+        # Modes inside the git database (excluding submodule databases).","+        common = self.ctx.common_dir","+        for root, dirs, files in os.walk(common):","+            dirs.sort()","+            if root == common and \"modules\" in dirs:","+                dirs.remove(\"modules\")","+            rel_root = os.path.relpath(root, common)","+            try:","+                self.dir_modes[os.path.realpath(root)] = stat.S_IMODE(","+                    os.lstat(root).st_mode)","+            except OSError:","+                pass","+            in_loose = False","+            parts = rel_root.split(os.sep)","+            if len(parts) >= 2 and parts[0] == \"objects\" and len(parts[1]) == 2:","+                in_loose = True","+            for name in files:","+                path = os.path.join(root, name)","+                if os.path.islink(path):","+                    continue","+                try:","+                    mode = stat.S_IMODE(os.lstat(path).st_mode)","+                except OSError:","+                    continue","+                if not in_loose:","+               