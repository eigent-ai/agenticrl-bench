        args.append(\"--objects\")","+        args += list(extra)","+        args += list(revs)","+        result = self.ctx.git(args, env=env)","+        if result.returncode != 0:","+            result = self.ctx.git(args + [\"--missing=allow-any\"], env=env)","+        if result.returncode != 0:","+            return None","+        values = set()","+        for line in decode(result.stdout).splitlines():","+            token = line.split(None, 1)[0] if line.strip() else \"\"","+            if is_oid(token):","+                values.add(token.lower())","+        return values","+","+    def _abbrev_sample(self):","+        lines = self.ctx.git_lines(","+            [\"log\", \"--all\", \"-n\", \"200\", \"--format=%h\"])","+        if not lines:","+            lines = self.ctx.git_lines(","+                [\"log\", \"-n\", \"200\", \"--format=%h\", \"HEAD\"]) or []","+        lengths = [len(x.strip()) for x in lines if x.strip()]","+        if not lengths:","+            return None, 0","+        return min(lengths), len(lengths)"],"newLines":210,"newStart":437,"oldLines":3,"oldStart":437}],"path":"/app/sanitize/sanitize"}]}