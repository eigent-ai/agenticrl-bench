{"files":[{"hunks":[{"lines":["+#!/usr/bin/env python3","+import os,sys,subprocess,shutil,json","+sys.path.insert(0,'/tmp')","+import importlib.util","+spec=importlib.util.spec_from_file_location('synth','/tmp/synth_test.py'); synth=importlib.util.module_from_spec(spec); spec.loader.exec_module(synth)","+run=synth.run; sh=synth.sh; check=synth.check; write=synth.write","+ROOT='/tmp/adhoc_cases'","+if os.path.exists(ROOT): shutil.rmtree(ROOT)","+os.makedirs(ROOT)","+# reuse origin from previous synth run (still at /tmp/synth_cases/origin)","+origin='/tmp/synth_cases/origin'","+r=subprocess.run(['git','rev-parse','v1^{}','v2-base','v9-future'],cwd=origin,capture_output=True,text=True,env=synth.ENV)","+A,B,D=[x.strip() for x in r.stdout.splitlines()]","+C=run(origin,'rev-parse','v9-future^')[1]","+ids={'A':A,'B':B,'C':C,'D':D}","+print(ids)","+def spec(case):","+    p=os.path.join(ROOT,case+'.json');json.dump({'base_commit':B},open(p,'w'));return p","+def san(repo,case):","+    r=subprocess.run(['/app/sanitize/sanitize',repo,spec(case)],capture_output=True,text=True,env=synth.ENV); check(case,'rc',r.returncode==0,r.stderr); return r","+# bare top-level","+case='bare'; repo=os.path.join(ROOT,'bare.git'); subprocess.run(['git','clone','-q','--bare',origin,repo],check=True,env=synth.ENV)","+sh(repo,'branch','mainbase',B); sh(repo,'symbolic-ref','HEAD','refs/heads/mainbase')","+san(repo,case)","+check(case,'head mainbase B',run(repo,'rev-parse','HEAD')[1]==B)","+check(case,'future branches gone','future-branch' not in run(repo,'branch')[1] and run(repo,'cat-file','-t',D)[0]!=0,run(repo,'branch')[1])","+print('bare branches',run(repo,'branch','-a')[1])","+# detached from hash","+case='detachhash'; repo=os.path.join(ROOT,case); subprocess.run(['git','clone','-q',origin,repo],check=True,env=synth.ENV)","+sh(repo,'checkout','-q','--detach',D); sh(repo,'checkout','-q','--detach',B); sh(repo,'remote','remove','origin')","+before_branch=run(repo,'branch','-vv')[1]; before_status=subprocess.run(['git','status'],cwd=repo,capture_output=True,text=True,env=synth.ENV).stdout.splitlines()[0]","+print('before',before_branch,before_status); print(open(os.path.join(repo,'.git/logs/HEAD')).read())","+san(repo,case)","+after_branch=run(repo,'branch','-vv')[1]; after_status=subprocess.run(['git','status'],cwd=repo,capture_output=True,text=True,env=synth.ENV).stdout.splitlines()[0]","+print('after',after_branch,after_status); print(open(os.path.join(repo,'.git/logs/HEAD')).read() if os.path.exists(os.path.join(repo,'.git/logs/HEAD')) else 'no reflog')","+check(case,'branch label preserved',before_branch.splitlines()[0].split('  ')[0]==after_branch.splitlines()[0].split('  ')[0],f'{before_branch} vs {after_branch}')","+check(case,'status label preserved',before_status==after_status,f'{before_status} vs {after_status}')","+check(case,'no D in reflog',D not in open(os.path.join(repo,'.git/logs/HEAD')).read())","+# lone pack + bundle in .git (use fresh clone reset B)","+case='lonepack'; repo=os.path.join(ROOT,case); subprocess.run(['git','clone','-q',origin,repo],check=True,env=synth.ENV); sh(repo,'reset','-q','--hard',B); sh(repo,'remote','remove','origin')","+# create a pack containing D objects via pack-objects in origin, copy .pack only","+tmpdir=os.path.join(ROOT,'packtmp'); os.makedirs(tmpdir)","+payload='\\n'.join(run(origin,'rev-list','--objects',D)[1].split())+'\\n'","+# rev-list --objects lines have paths; extract first tokens in shell via python already run helper returns stdout only not easy; use subprocess here","+r=subprocess.run(['git','rev-list','--objects',D],cwd=origin,capture_output=True,text=True,env=synth.ENV); payload=''.join(line.split()[0]+'\\n' for line in r.stdout.splitlines())","+r=subprocess.run(['git','pack-objects',os.path.join(tmpdir,'pack')],cwd=origin,input=payload,capture_output=True,text=True,env=synth.ENV); ph=r.stdout.strip(); print('pack hash',ph,r.stderr)","+shutil.copyfile(os.path.join(tmpdir,f'pack-{ph}.pack'),os.path.join(repo,'.git/objects/pack',f'pack-{ph}.pack'))","+r=subprocess.run(['git','bundle','create',os.path.join(repo,'.git/future.bundle'),'--all'],cwd=origin,capture_output=True,text=True,env=synth.ENV); print('bundle',r.returncode,r.stderr)","+san(repo,case)","+check(case,'lone pack gone',not os.path.exists(os.path.join(repo,'.git/objects/pack',f'pack-{ph}.pack')))","+check(case,'bundle gone',not os.path.exists(os.path.join(repo,'.git/future.bundle')))","+check(case,'git still works',run(repo,'log','--oneline','-1')[1].endswith('B base'))","+# stale packed-refs shadowed by loose","+case='stalepacked'; repo=os.path.join(ROOT,case); subprocess.run(['git','clone','-q',origin,repo],check=True,env=synth.ENV); sh(repo,'reset','-q','--hard',B); sh(repo,'remote','remove','origin')","+sh(repo,'pack-refs','--all')","+# now rewrite packed main line to D, and write loose main to B (packed stale)","+packed=os.path.join(repo,'.git/packed-refs'); txt=open(packed).read(); txt=txt.replace(B+' refs/heads/main',D+' refs/heads/main'); open(packed,'w').write(txt); open(os.path.join(repo,'.git/refs/heads/main'),'w').write(B+'\\n')","+print('pre packed main',[l for l in open(packed) if 'heads/main' in l])","+san(repo,case)","+packed_after=open(packed).read() if os.path.exists(packed) else ''","+print('post packed',packed_after[:500]); check(case,'packed no D',D not in packed_after); check(case,'HEAD B',run(repo,'rev-parse','HEAD')[1]==B)","+print('SUMMARY',synth.FAILS)","+sys.exit(1 if synth.FAILS else 0)"],"newLines":63,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/adhoc_test.py"}]}