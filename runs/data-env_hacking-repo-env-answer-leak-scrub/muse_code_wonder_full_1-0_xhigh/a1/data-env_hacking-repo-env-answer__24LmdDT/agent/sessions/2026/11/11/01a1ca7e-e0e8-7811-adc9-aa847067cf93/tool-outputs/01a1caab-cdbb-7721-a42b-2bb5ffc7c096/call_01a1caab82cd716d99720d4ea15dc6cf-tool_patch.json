{"files":[{"hunks":[{"lines":["     check(case,'refs ok',not bad,bad)","     rc,out,e=run(repo,'fsck','--connectivity-only'); check(case,'fsck connectivity','missing' not in out+e and 'broken' not in out+e,out+e)","     return cap1","+","+def reset_to_B(repo,ids):","+    # mimic builders: local main reset to B, other clones state left around","+    sh(repo,'reset','-q','--hard',ids['B'])","+","+def main():","+    if os.path.exists(ROOT): shutil.rmtree(ROOT)","+    os.makedirs(ROOT)","+    origin,ids=build_origin(); print('ids',ids)","+    # S1 basic remote/future refs","+    case='s1-basic'; repo=clone_case(case,origin,ids); reset_to_B(repo,ids)","+    # add local ancestor branch, blob/tree/nested tags pointing at B objects and future blob tag","+    sh(repo,'branch','old-branch',ids['A'])","+    tree=sh(repo,'rev-parse','HEAD^{tree}')[1]; blob=sh(repo,'rev-parse','HEAD:code.py')[1]","+    sh(repo,'tag','tree-tag',tree); sh(repo,'tag','blob-tag',blob)","+    sh(repo,'tag','-a','-m','inner','inner-tag',ids['B']); sh(repo,'tag','-a','-m','outer','outer-tag','inner-tag')","+    cap0=capture(repo); sp=spec_for(case,ids); r=sanitize(repo,sp); check(case,'rc',r.returncode==0,r.stderr)","+    generic(case,repo,ids,cap0)","+    tags=set(run(repo,'tag')[1].split()); check(case,'ancestor tags kept',{'v1','v2-base','tree-tag','blob-tag','inner-tag','outer-tag'}<=tags,tags)","+    check(case,'future/side tags gone',not ({'v9-future','side-tag'} & tags),tags)","+    check(case,'remote gone',run(repo,'remote')[1]=='')","+    # S2 dirty/staged/untracked/ignored/intent/skip","+    case='s2-dirty'; repo=clone_case(case,origin,ids); reset_to_B(repo,ids); sh(repo,'remote','remove','origin')","+    write(repo,'code.py','value=2\\n# unstaged\\n')","+    write(repo,'sub/staged.txt','STAGED\\n'); sh(repo,'add','sub/staged.txt'); sh(repo,'write-tree')","+    write(repo,'untracked.txt','UNTRACKED\\n')","+    write(repo,'.gitignore','ignored.bin\\n'); sh(repo,'add','.gitignore')  # staged new ignore (part of staged state)","+    write(repo,'ignored.bin','IGNORED\\n')","+    write(repo,'intent.txt','INTENT\\n'); sh(repo,'add','-N','intent.txt')","+    write(repo,'sub/file.txt','hello modified hidden\\n'); sh(repo,'update-index','--skip-worktree','sub/file.txt')","+    cap0=capture(repo); sp=spec_for(case,ids); r=sanitize(repo,sp); check(case,'rc',r.returncode==0,r.stderr)","+    generic(case,repo,ids,cap0)","+    check(case,'skip-worktree diff hides',run(repo,'diff','--name-only')[1]=='code.py')","+    # S3 detached","+    case='s3-detached'; repo=clone_case(case,origin,ids); sh(repo,'checkout','-q','--detach',ids['B']); sh(repo,'remote','remove','origin')","+    sh(repo,'branch','-D','main'); sh(repo,'branch','old',ids['A'])","+    cap0=capture(repo); sp=spec_for(case,ids); r=sanitize(repo,sp); check(case,'rc',r.returncode==0,r.stderr); generic(case,repo,ids,cap0)","+    # S4 setup commit on top of B + dirty","+    case='s4-setupcommit'; repo=clone_case(case,origin,ids); reset_to_B(repo,ids); sh(repo,'remote','remove','origin')","+    write(repo,'setup.cfg','SETUP=1\\n'); sh(repo,'add','setup.cfg'); sh(repo,'commit','-qm','setup commit')","+    setup_head=sh(repo,'rev-parse','HEAD')[1]; write(repo,'code.py','value=2\\n# dirty after setup\\n')","+    cap0=capture(repo); sp=spec_for(case,ids); r=sanitize(repo,sp); check(case,'rc',r.returncode==0,r.stderr)","+    cap1=generic(case,repo,ids,cap0)","+    check(case,'setup head preserved',run(repo,'rev-parse','HEAD')[1]==setup_head)","+    check(case,'base still parent',run(repo,'rev-parse','HEAD^')[1]==ids['B'])","+    # S5 stash valid at B and invalid made at D earlier","+    case='s5-stash'; repo=clone_case(case,origin,ids)","+    # at D tip initially: invalid stash","+    write(repo,'code.py','value=999 FUTURE_STASH\\n'); sh(repo,'stash','push','-q','-m','badstash','--','code.py')","+    reset_to_B(repo,ids); sh(repo,'remote','remove','origin')","+    write(repo,'code.py','value=2\\nGOODSTASH\\n'); write(repo,'stash-untracked.txt','U\\n'); sh(repo,'stash','push','-q','-u','-m','goodstash')","+    check(case,'pre stash count',len(run(repo,'stash','list')[1].splitlines())==2,run(repo,'stash','list')[1])","+    sp=spec_for(case,ids); r=sanitize(repo,sp); check(case,'rc',r.returncode==0,r.stderr)","+    sl=run(repo,'stash','list')[1]; check(case,'good stash kept bad dropped',sl.count('goodstash')==1 and 'badstash' not in sl,sl)","+    rc,out,e=run(repo,'stash','show','-p','stash@{0}'); check(case,'good stash content','GOODSTASH' in out and 'FUTURE_STASH' not in out,out[:500])","+    generic(case,repo,ids)","+    # S6 notes/replace/graft/pseudo","+    case='s6-notes'; repo=clone_case(case,origin,ids); reset_to_B(repo,ids); sh(repo,'remote','remove','origin')","+    sh(repo,'notes','add','-m','SECRETNOTE FUTURE_SECRET',ids['B'])","+    # replace B with C (planted)","+    sh(repo,'replace',ids['B'],ids['C'])","+    open(os.path.join(repo,'.git/info/grafts'),'w').write(f\"{ids['B']} {ids['C']}\\n\")","+    open(os.path.join(repo,'.git/FETCH_HEAD'),'w').write(f\"{ids['D']}\\t\\tbranch 'main' of fake\\n\")","+    sp=spec_for(case,ids); r=sanitize(repo,sp); check(case,'rc',r.returncode==0,r.stderr)","+    check(case,'notes gone',run(repo,'notes','list')[1]=='')","+    check(case,'replace gone',run(repo,'replace','-l')[1]=='')","+    check(case,'grafts gone',not os.path.exists(os.path.join(repo,'.git/info/grafts')))","+    generic(case,repo,ids)","+    print('\\nSUMMARY',FAILS)","+    return 1 if FAILS else 0","+","+if __name__=='__main__': sys.exit(main())"],"newLines":75,"newStart":83,"oldLines":3,"oldStart":83}],"path":"/tmp/synth_test.py"}]}