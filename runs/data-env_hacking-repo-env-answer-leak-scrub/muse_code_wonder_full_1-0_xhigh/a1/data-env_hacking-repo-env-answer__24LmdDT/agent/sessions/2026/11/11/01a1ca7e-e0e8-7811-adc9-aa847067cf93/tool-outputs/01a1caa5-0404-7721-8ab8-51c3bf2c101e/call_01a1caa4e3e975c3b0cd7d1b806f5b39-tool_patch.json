{"files":[{"hunks":[{"lines":["         self.verify()","         self.restore_index()","         self.restore_modes()","+","+","+# ---------------------------------------------------------------------------","+# Entry point","+","+","+def main(argv):","+    if len(argv) != 3:","+        sys.stderr.write(\"usage: sanitize <repo_dir> <spec.json>\\n\")","+        return 2","+    repo_dir = os.path.abspath(argv[1])","+    spec_path = os.path.abspath(argv[2])","+    if not os.path.isdir(repo_dir):","+        sys.stderr.write(\"sanitize: repo_dir is not a directory\\n\")","+        return 2","+    base_spec = None","+    try:","+        import json","+        with open(spec_path, \"r\", encoding=\"utf-8\") as handle:","+            spec = json.load(handle)","+        if isinstance(spec, dict):","+            candidate = spec.get(\"base_commit\")","+            if isinstance(candidate, str) and candidate.strip():","+                base_spec = candidate.strip()","+    except OSError:","+        sys.stderr.write(\"sanitize: cannot read spec.json\\n\")","+        return 2","+    except ValueError:","+        sys.stderr.write(\"sanitize: spec.json is not valid JSON\\n\")","+        return 2","+    # If repo_dir is a subdirectory of a checkout, sanitize that checkout.","+    scan_root = os.path.realpath(repo_dir)","+    seed = None","+    top = _revparse_abs([\"--show-toplevel\"], cwd=repo_dir)","+    if top:","+        top_real = os.path.realpath(top)","+        try:","+            if os.path.commonpath([top_real, scan_root]) == top_real:","+                scan_root = top_real","+                seed = top_real","+        except ValueError:","+            pass","+    if seed is None and os.path.lexists(os.path.join(repo_dir, \".git\")):","+        seed = repo_dir","+    contexts = discover_contexts(scan_root, seed_worktree=seed)","+    if not contexts:","+        return 0","+    assign_gitlink_roots(contexts)","+    main_ctx = None","+    repo_real = os.path.realpath(repo_dir)","+    for ctx in contexts.values():","+        paths = set(ctx.worktree_candidates)","+        if ctx.primary_worktree:","+            paths.add(os.path.realpath(ctx.primary_worktree))","+        if repo_real in paths or scan_root in paths:","+            main_ctx = ctx","+            break","+        if os.path.realpath(ctx.common_dir) == repo_real:","+            main_ctx = ctx","+            break","+        if os.path.realpath(ctx.common_dir) == os.path.join(repo_real, \".git\"):","+            main_ctx = ctx","+            break","+    if main_ctx is None:","+        # Prefer the context whose checkout contains the requested dir.","+        best = None","+        best_len = -1","+        for ctx in contexts.values():","+            for path in ctx.worktree_candidates:","+                real = os.path.realpath(path)","+                try:","+                    if os.path.commonpath([real, repo_real]) == real:","+                        if len(real) > best_len:","+                            best = ctx","+                            best_len = len(real)","+                except ValueError:","+                    continue","+        main_ctx = best","+    if main_ctx is not None:","+        main_ctx.is_main = True","+","+    def depth(ctx):","+        path = ctx.primary_worktree or ctx.common_dir","+        return path.count(os.sep)","+","+    ordered = sorted(contexts.values(), key=depth, reverse=True)","+    try:","+        for ctx in ordered:","+            supplied = []","+            if ctx is main_ctx and base_spec:","+                supplied.append(base_spec)","+            RepoSanitizer(ctx, supplied, scan_root).run()","+    except SanitizeError as error:","+        sys.stderr.write(\"sanitize: %s\\n\" % error)","+        return 1","+    return 0","+","+","+if __name__ == \"__main__\":","+    sys.exit(main(sys.argv))"],"newLines":103,"newStart":1942,"oldLines":3,"oldStart":1942}],"path":"/app/sanitize/sanitize"}]}