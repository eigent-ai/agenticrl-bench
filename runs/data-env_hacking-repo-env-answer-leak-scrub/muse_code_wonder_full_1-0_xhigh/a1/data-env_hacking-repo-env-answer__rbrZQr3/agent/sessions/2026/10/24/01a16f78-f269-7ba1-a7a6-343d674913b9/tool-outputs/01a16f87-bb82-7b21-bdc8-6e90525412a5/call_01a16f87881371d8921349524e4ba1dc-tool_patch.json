{"files":[{"hunks":[{"lines":["         if len(lines) >= 3 and lines[2].strip():","             self.worktree = Path(lines[2].strip())","         return True","+","+","+def remove_path(p):","+    \"\"\"Unlink a file/dir without ever truncating it (may be hardlinked).\"\"\"","+    try:","+        if p.is_symlink() or p.is_file():","+            p.unlink()","+        elif p.is_dir():","+            def _onerr(func, path, _exc):","+                try:","+                    os.chmod(path, 0o700)","+                    func(path)","+                except Exception:","+                    pass","+            shutil.rmtree(str(p), onerror=_onerr)","+    except FileNotFoundError:","+        pass","+    except Exception:","+        pass","+","+","+def write_file_atomic(p, data):","+    fd, tmp = tempfile.mkstemp(dir=str(p.parent), prefix=\".sanitize-\")","+    try:","+        with os.fdopen(fd, \"wb\") as fh:","+            fh.write(data)","+        os.replace(tmp, str(p))","+    except Exception:","+        try:","+            os.unlink(tmp)","+        except Exception:","+            pass","+        raise","+","+","+def object_type(repo, oid):","+    r = repo.run(\"cat-file\", \"-t\", oid)","+    if r.returncode != 0:","+        return None","+    return r.stdout.decode(\"ascii\", \"replace\").strip()","+","+","+def all_objects(repo):","+    \"\"\"Return {oid: type} for every object in the local object store.\"\"\"","+    r = repo.run(\"cat-file\", \"--batch-all-objects\",","+                 \"--batch-check=%(objectname) %(objecttype)\")","+    result = {}","+    if r.returncode != 0:","+        return result","+    for line in r.stdout.decode(\"ascii\", \"replace\").splitlines():","+        parts = line.split()","+        if len(parts) == 2:","+            result[parts[0]] = parts[1]","+    return result","+","+","+def rev_list(repo, tips, objects=False):","+    args = [\"rev-list\"]","+    if objects:","+        args.append(\"--objects\")","+    args.extend(tips)","+    r = repo.run(*args, env=NOREPLACE_ENV)","+    if r.returncode != 0:","+        return None","+    out = set()","+    for line in r.stdout.decode(\"utf-8\", \"surrogateescape\").splitlines():","+        token = line.split(\" \", 1)[0].strip()","+        if token:","+            out.add(token)","+    return out","+","+","+def list_refs(repo):","+    fmt = (\"%(refname)\\t%(objectname)\\t%(objecttype)\\t\"","+           \"%(*objectname)\\t%(*objecttype)\\t%(symref)\")","+    r = repo.run(\"for-each-ref\", \"--format=\" + fmt, env=NOREPLACE_ENV)","+    refs = []","+    if r.returncode != 0:","+        return refs","+    for line in r.stdout.decode(\"utf-8\", \"surrogateescape\").splitlines():","+        parts = (line.split(\"\\t\") + [\"\", \"\", \"\", \"\", \"\", \"\"])[:6]","+        refs.append({","+            \"name\": parts[0], \"oid\": parts[1], \"type\": parts[2],","+            \"peeled\": parts[3], \"peeled_type\": parts[4], \"symref\": parts[5],","+        })","+    return refs","+","+","+def ref_target(ref):","+    if ref[\"peeled\"]:","+        return ref[\"peeled\"], ref[\"peeled_type\"]","+    return ref[\"oid\"], ref[\"type\"]","+","+","+def index_blobs(repo, index_file=None):","+    env = dict(BASE_ENV)","+    if index_file is not None:","+        env[\"GIT_INDEX_FILE\"] = str(index_file)","+    r = repo.run(\"ls-files\", \"--stage\", \"-z\", env=env)","+    blobs = set()","+    entries = []","+    if r.returncode != 0:","+        return blobs, entries","+    for raw in r.stdout.split(b\"\\x00\"):","+        if not raw:","+            continue","+        try:","+            meta, path = raw.split(b\"\\t\", 1)","+            fields = meta.decode(\"ascii\", \"replace\").split()","+            mode, oid = fields[0], fields[1]","+        except Exception:","+            continue","+        entries.append((mode, oid, path.decode(\"utf-8\", \"surrogateescape\")))","+        blobs.add(oid)","+    return blobs, entries","+","+","+def index_tree(repo, index_