{"files":[{"hunks":[{"lines":["         if repo.run(\"cat-file\", \"-e\", oid).returncode != 0:","             raise GitError(\"%s: retained commit %s was lost\" % (label, oid))","     return 0","+","+","+def gitlink_entries(repo):","+    \"\"\"{path: oid} for submodules recorded in the index or HEAD tree.\"\"\"","+    links = {}","+    _blobs, entries = index_blobs(repo)","+    for mode, oid, path in entries:","+        if mode == \"160000\":","+            links[path] = oid","+    r = repo.run(\"ls-tree\", \"-r\", \"-z\", \"HEAD\")","+    if r.returncode == 0:","+        for raw in r.stdout.split(b\"\\x00\"):","+            if not raw:","+                continue","+            try:","+                meta, path = raw.split(b\"\\t\", 1)","+                mode, _type, oid = meta.decode(","+                    \"ascii\", \"replace\").split()","+            except Exception:","+                continue","+            if mode == \"160000\":","+                links.setdefault(","+                    path.decode(\"utf-8\", \"surrogateescape\"), oid)","+    return links","+","+","+def find_embedded(root, main_gitdir):","+    \"\"\"Worktrees below root that carry their own .git entry (not root).\"\"\"","+    found = []","+    root = Path(root)","+    for dirpath, dirnames, filenames in os.walk(str(root)):","+        d = Path(dirpath)","+        if d == root:","+            if \".git\" in dirnames:","+                dirnames.remove(\".git\")","+            dirnames.sort()","+            continue","+        # Never descend into any git directory or follow directory links","+        # (os.walk does not follow links unless asked to).","+        if \".git\" in dirnames:","+            found.append(d)","+            dirnames.remove(\".git\")","+        elif \".git\" in filenames:","+            found.append(d)","+        dirnames.sort()","+    return found","+","+","+def find_module_gitdirs(commondir):","+    \"\"\"Submodule git dirs under <common>/modules, worktree or not.\"\"\"","+    found = []","+    modules = Path(commondir) / \"modules\"","+    if not modules.is_dir():","+        return found","+    for dirpath, dirnames, filenames in os.walk(str(modules)):","+        d = Path(dirpath)","+        if ((d / \"HEAD\").is_file() and (d / \"objects\").is_dir()","+                and (d / \"refs\").is_dir()):","+            found.append(d)","+            dirnames[:] = [x for x in dirnames","+                           if x not in (\"objects\", \"refs\", \"logs\",","+                                        \"hooks\", \"info\", \"branches\")]","+    return found","+","+","+def contains_commit(repo, oid):","+    if not oid:","+        return False","+    return repo.run(\"cat-file\", \"-e\", oid + \"^{commit}\",","+                    env=NOREPLACE_ENV).returncode == 0","+","+","+def clean_bundles(root, repo, allowed_commits, tracked_paths):","+    \"\"\"Remove untracked git bundles carrying post-start refs.","+","+    A bundle is a transport of version-control history; one left in the","+    working tree by the builder can reintroduce the very commits just","+    pruned.  Tracked bundle fixtures (part of the base tree) are kept.","+    \"\"\"","+    for dirpath, dirnames, filenames in os.walk(str(root)):","+        if \".git\" in dirnames:","+            dirnames.remove(\".git\")","+        dirnames.sort()","+        for name in filenames:","+            p = Path(dirpath) / name","+            rel = p.relative_to(root).as_posix()","+            if rel in tracked_paths:","+                continue","+            try:","+                with open(str(p), \"rb\") as fh:","+                    head = fh.read(32)","+            except Exception:","+                continue","+            if not (head.startswith(b\"# v2 git bundle\")","+                    or head.startswith(b\"# v3 git bundle\")):","+                continue","+            r = repo.run(\"bundle\", \"list-heads\", str(p))","+            bad = True","+            if r.returncode == 0:","+                bad = False","+                for line in r.stdout.decode(","+                        \"utf-8\", \"replace\").splitlines():","+                    token = line.split()[0] if line.split() else \"\"","+                    if token and token not in allowed_commits:","+                        bad = True","+                        break","+            if bad:","+                remove_path(p)"],"newLines":111,"newStart":769,"oldLines":3,"oldStart":769}],"path":"/app/sanitize/sanitize"}]}