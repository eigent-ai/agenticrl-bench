{"files":[{"hunks":[{"lines":["                 if (p.name.startswith(\"multi-pack-index\")","                         or p.suffix in (\".bitmap\", \".keep\")):","                     remove_path(p)","+","+","+def resolve_token(repo, token):","+    if not token or not HEX_RE.match(token):","+        return None","+    oid = repo.rev_parse(token + \"^{commit}\", env=NOREPLACE_ENV)","+    return oid","+","+","+def clean_pseudo_heads(repo, allowed_commits):","+    bases = []","+    for base in (repo.gitdir, repo.commondir):","+        if base is not None and base not in bases:","+            bases.append(base)","+    wt_root = None","+    if repo.commondir is not None:","+        wt_root = repo.commondir / \"worktrees\"","+        if wt_root.is_dir():","+            for child in sorted(wt_root.iterdir()):","+                if child.is_dir():","+                    bases.append(child)","+    for base in bases:","+        merge_removed = False","+        for name in PSEUDO_HEADS:","+            p = base / name","+            if not p.is_file():","+                continue","+            if name == \"FETCH_HEAD\":","+                remove_path(p)","+                continue","+            try:","+                token = p.read_text(errors=\"replace\").split()[0]","+            except Exception:","+                token = \"\"","+            oid = resolve_token(repo, token)","+            if oid is None or oid not in allowed_commits:","+                remove_path(p)","+                if name == \"MERGE_HEAD\":","+                    merge_removed = True","+        if merge_removed:","+            remove_path(base / \"MERGE_MSG\")","+            remove_path(base / \"MERGE_MODE\")","+        for name in STATE_DIRS:","+            d = base / name","+            if not d.is_dir():","+                continue","+            bad = False","+            for fname in (\"onto\", \"orig-head\", \"head\", \"original-commit\"):","+                f = d / fname","+                if f.is_file():","+                    try:","+                        token = f.read_text(errors=\"replace\").split()[0]","+                    except Exception:","+                        continue","+                    oid = resolve_token(repo, token)","+                    if oid is not None and oid not in allowed_commits:","+                        bad = True","+            if bad:","+                remove_path(d)","+","+","+def clean_linked_worktrees(repo, allowed_commits):","+    \"\"\"Drop registrations whose HEAD is outside the retained history.\"\"\"","+    kept_admins = []","+    if repo.commondir is None:","+        return kept_admins","+    wt_root = repo.commondir / \"worktrees\"","+    if not wt_root.is_dir():","+        return kept_admins","+    for child in sorted(wt_root.iterdir()):","+        if not child.is_dir():","+            continue","+        sub = Repo(cwd=str(child), git_dir=str(child))","+        oid = sub.rev_parse(\"HEAD^{commit}\", env=NOREPLACE_ENV)","+        if oid is not None and oid in allowed_commits:","+            kept_admins.append(child)","+        else:","+            # Only the registration inside the repository is removed; a","+            # linked working directory outside the repository is not ours","+            # to delete.","+            remove_path(child)","+    return kept_admins","+","+","+def expected_objects(repo, allowed_objects, kept_tag_refs, worktree_admins):","+    \"\"\"Objects that may legitimately remain after pruning.\"\"\"","+    if allowed_objects is None:","+        return None","+    expected = set(allowed_objects)","+    expected |= tag_chain_objects(repo, kept_tag_refs)","+    indexes = [None]","+    if repo.gitdir is not None and repo.gitdir != repo.commondir:","+        # main Repo already addresses its own index with None","+        pass","+    for admin in worktree_admins:","+        idx = admin / \"index\"","+        if idx.is_file():","+            indexes.append(idx)","+    for idx in indexes:","+        blobs, _entries = index_blobs(repo, idx)","+        # Gitlink OIDs in the index are foreign commits, not local objects;","+        # including them in the expected set is harmless.","+        expected |= blobs","+        tree = index_tree(repo, idx)","+        if tree:","+            expected |= tree_objects(repo, tree)","+    return expected","+","+","+def rebuild_object_store(repo, expected):","+    \"\"\"Replace the object store with a fresh pack of expected objects only.","+","+    Only used if ``git gc`` left objects behind (e.g. protected by an","+    object source gc would not prune).  Returns True on success.","+    \"\"\"","+    common = repo.commondir","+    if common is None or expected is None:","+        return False","+    present = all_objects(repo)","+    keep = sorted(set(expected) & set(present))","+    if not keep:","+        return False","+    new_dir = common / (\"objects.sanitize-new-%d\" % os.getpid())","+    old_dir = common / (\"objects.sanitize-old-%d\" % os.getpid())","+    remove_path(new_dir)","+    remove_path(old_dir)","+    try:","+        (new_dir / \"info\").mkdir(parents=True)","+        (new_dir / \"pack\").mkdir(parents=True)","+        prefix = str(new_dir / \"pack\" / \"pack\")","+        payload = (\"\\n\".join(keep) + \"\\n\").encode(\"ascii\")","+        r = repo.run(\"pack-objects\", \"--delta-base-offset\",","+                     \"--no-reuse-object\", prefix, inp=payload)","+        if r.returncode != 0:","+            return False","+    except Exception:","+        remove_path(new_dir)","+        return False","+    objects_dir = common / \"objects\"","+    try:","+        os.rename(str(objects_dir), str(old_dir))","+        try:","+            os.rename(str(new_dir), str(objects_dir))","+        except Exception:","+            os.rename(str(old_dir), str(objects_dir))","+            raise","+    except Exception:","+        remove_path(new_dir)","+        return False","+    # Verify the new store can resolve HEAD before discarding the old one.","+    if repo.rev_parse(\"HEAD\") is None and repo.run(","+            \"rev-parse\", \"--verify\", \"-q\", \"HEAD\").returncode != 0:","+        # An unborn HEAD also fails rev-parse; only treat this as an","+        # error when some kept ref used to resolve.","+        refs_left = list_refs(repo)","+        if refs_left:","+            remove_path(objects_dir)","+            try:","+                os.rename(str(old_dir), str(objects_dir))","+            except Exception:","+                pass","+            return False","+    remove_path(old_dir)","+    return True"],"newLines":167,"newStart":390,"oldLines":3,"oldStart":390}],"path":"/app/sanitize/sanitize"}]}