{"files":[{"hunks":[{"lines":["         except Exception:","             continue","     return objs","+","+","+def tag_chain_objects(repo, refs):","+    \"\"\"Annotated-tag objects themselves for kept tag refs (chains included).\"\"\"","+    objs = set()","+    for ref in refs:","+        oid = ref[\"oid\"]","+        depth = 0","+        while oid and depth < 20:","+            otype = object_type(repo, oid)","+            if otype != \"tag\":","+                break","+            objs.add(oid)","+            r = repo.run(\"cat-file\", \"-p\", oid)","+            if r.returncode != 0:","+                break","+            nxt = None","+            for line in r.stdout.decode(\"utf-8\", \"replace\").splitlines():","+                if line.startswith(\"object \"):","+                    nxt = line.split(None, 1)[1].strip()","+                    break","+                if not line.strip():","+                    break","+            oid = nxt","+            depth += 1","+    return objs","+","+","+def delete_refs(repo, refs):","+    \"\"\"Delete refs in one update-ref transaction where possible.\"\"\"","+    plain = []","+    for ref in refs:","+        if ref[\"symref\"] or not ref[\"oid\"] or ZERO_RE.match(ref[\"oid\"]):","+            # Symbolic refs (e.g. a stale refs/remotes/origin/HEAD) need","+            # symbolic-ref -d; update-ref would delete their target.","+            r = repo.run(\"symbolic-ref\", \"-d\", ref[\"name\"])","+            if r.returncode != 0 and repo.commondir is not None:","+                remove_path(repo.commondir / ref[\"name\"])","+        else:","+            plain.append(ref)","+    if not plain:","+        return","+    payload = b\"\"","+    for ref in plain:","+        payload += (b\"delete \" + ref[\"name\"].encode(\"utf-8\", \"surrogateescape\")","+                    + b\"\\x00\" + ref[\"oid\"].encode(\"ascii\") + b\"\\x00\")","+    r = repo.run(\"update-ref\", \"--stdin\", \"-z\", inp=payload)","+    if r.returncode == 0:","+        return","+    # Fall back to one-by-one deletion; a single exotic ref must not","+    # stop the rest from being removed.","+    for ref in plain:","+        repo.run(\"update-ref\", \"-d\", ref[\"name\"])","+","+","+def sweep_loose_refs(repo, keep_names):","+    \"\"\"Remove loose ref files for-each-ref could not enumerate (broken).\"\"\"","+    base = repo.commondir","+    if base is None:","+        return","+    refs_dir = base / \"refs\"","+    if not refs_dir.is_dir():","+        return","+    for root, dirs, files in os.walk(str(refs_dir)):","+        for name in files:","+            p = Path(root) / name","+            refname = p.relative_to(base).as_posix()","+            if refname not in keep_names:","+                remove_path(p)","+    for root, dirs, files in os.walk(str(refs_dir), topdown=False):","+        for name in dirs:","+            try:","+                (Path(root) / name).rmdir()","+            except Exception:","+                pass","+","+","+def clean_config(repo):","+    remotes = repo.out(\"remote\").split()","+    for name in remotes:","+        r = repo.run(\"remote\", \"remove\", name)","+        if r.returncode != 0:","+            repo.run(\"config\", \"--local\", \"--remove-section\",","+                     \"remote.\" + name)","+    r = repo.run(\"config\", \"--local\", \"--list\", \"--null\")","+    if r.returncode != 0:","+        return","+    keys = []","+    for entry in r.stdout.split(b\"\\x00\"):","+        if not entry:","+            continue","+        key = entry.split(b\"\\n\", 1)[0].decode(\"utf-8\", \"replace\")","+        keys.append(key)","+    drop = []","+    for key in keys:","+        lower = key.lower()","+        parts = lower.split(\".\")","+        if parts[0] == \"remote\":","+            drop.append(key)","+        elif len(parts) >= 3 and parts[0] == \"branch\" and parts[-1] in (","+                \"remote\", \"pushremote\", \"merge\"):","+            drop.append(key)","+        elif lower == \"extensions.partialclone\":","+            drop.append(key)","+    seen = set()","+    for key in drop:","+        if key.lower() in seen:","+            continue","+        seen.add(key.lower())","+        repo.run(\"config\", \"--local\", \"--unset-all\", key)","+","+","+def clean_generated_metadata(gitdirs):","+    \"\"\"Drop files that cache ref/object inventories of the old history.\"\"\"","+    for base in gitdirs:","+        if base is None:","+            continue","+        remove_path(base / \"info\" / \"refs\")","+        remove_path(base / \"objects\" / \"info\" / \"packs\")","+        remove_path(base / \"objects\" / \"info\" / \"commit-graph\")","+        remove_path(base / \"objects\" / \"info\" / \"commit-graphs\")","+        pack_dir = base / \"objects\" / \"pack\"","+        if pack_dir.is_dir():","+            for p in pack_dir.iterdir():","+                if (p.name.startswith(\"multi-pack-index\")","+                        or p.suffix in (\".bitmap\", \".keep\")):","+                    remove_path(p)"],"newLines":130,"newStart":263,"oldLines":3,"oldStart":263}],"path":"/app/sanitize/sanitize"}]}