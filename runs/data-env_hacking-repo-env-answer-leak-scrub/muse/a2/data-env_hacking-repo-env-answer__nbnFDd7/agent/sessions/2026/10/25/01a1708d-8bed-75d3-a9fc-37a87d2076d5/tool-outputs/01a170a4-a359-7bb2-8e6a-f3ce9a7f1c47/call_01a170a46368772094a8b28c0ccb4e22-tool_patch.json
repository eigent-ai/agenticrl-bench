{"files":[{"hunks":[{"lines":["         if res.returncode != 0:","             return None","         return out_text(res).strip() or None","+","+    # -- worktrees / tips ----------------------------------------------","+    def gather_worktrees(self):","+        self.worktrees = []","+        if self.bare:","+            return self.worktrees","+        res = self.git(\"worktree\", \"list\", \"--porcelain\", optional_locks=False)","+        if res.returncode != 0:","+            return self.worktrees","+        record = {}","+        for line in out_text(res).splitlines() + [\"\"]:","+            if not line.strip():","+                if record:","+                    self.worktrees.append(record)","+                    record = {}","+                continue","+            parts = line.split(\" \", 1)","+            record[parts[0]] = parts[1] if len(parts) > 1 else \"\"","+        return self.worktrees","+","+    def has_prunable_worktrees(self):","+        for rec in self.worktrees:","+            path = rec.get(\"worktree\", \"\")","+            if \"prunable\" in rec and path and not os.path.exists(path):","+                return True","+        return False","+","+    def collect_tips(self, base_expr, extra_tips):","+        self.head_symref = self.git_out(\"symbolic-ref\", \"-q\", \"HEAD\") or None","+        self.head_raw = self.peel_object(\"HEAD\")","+        self.head_commit = self.peel_commit(\"HEAD\")","+        tips = []","+        raw = []","+","+        def add_expr(expr, keep_raw=True):","+            if not expr:","+                return","+            commit = self.peel_commit(expr)","+            if commit and commit not in tips:","+                tips.append(commit)","+            if keep_raw:","+                obj = self.peel_object(expr)","+                if obj and obj not in raw:","+                    raw.append(obj)","+            if not commit:","+                obj = self.peel_object(expr)","+                if obj and obj not in raw:","+                    raw.append(obj)","+","+        if self.head_commit:","+            tips.append(self.head_commit)","+        if self.head_raw:","+            raw.append(self.head_raw)","+        for rec in self.worktrees:","+            path = rec.get(\"worktree\", \"\")","+            if \"prunable\" in rec and path and not os.path.exists(path):","+                continue","+            head = rec.get(\"HEAD\", \"\")","+            if head and head != self.zero_oid:","+                add_expr(head)","+        if base_expr:","+            self.base_commit = self.peel_commit(base_expr)","+            if self.base_commit is None:","+                dbg(\"base_commit %s not a commit in %s\" % (base_expr, self.entry))","+            add_expr(base_expr)","+        for expr in extra_tips or []:","+            add_expr(str(expr))","+        self.tip_commits = tips","+        self.raw_keep = raw","+        return tips","+","+    def compute_allowed_commits(self):","+        allowed = set(self.tip_commits)","+        if not self.tip_commits:","+            self.allowed_commits = allowed","+            return allowed","+        attempts = [[], [\"--missing=allow-promisor\"], [\"--missing=allow-any\"]]","+        for extra in attempts:","+            res = self.git(*([\"rev-list\"] + extra + list(self.tip_commits)),","+                           optional_locks=False)","+            if res.returncode == 0:","+                for line in out_text(res).splitlines():","+                    val = line.strip()","+                    if is_hex(val, self.oid_len):","+                        allowed.add(val)","+                break","+            dbg(\"rev-list %s failed in %s: %s\" % (","+                extra, self.entry, out_text(res)[:200]))","+        self.allowed_commits = allowed","+        return allowed","+","+    def _add_closure(self, oid, acc):","+        if not oid or oid in acc:","+            return","+        typ = self.object_type(oid)","+        if typ is None:","+            return","+        acc.add(oid)","+        if typ == \"tag\":","+            content = self.git_out(\"cat-file\", \"tag\", oid)","+            target = None","+            for line in content.splitlines():","+                if line.startswith(\"object \"):","+                    target = line.split(\" \", 1)[1].strip()","+                    break","+                if not line:","+                    break","+            if target:","+                self._add_closure(target, acc)","+        elif typ == \"tree\":","+            res = self.git(\"ls-tree\", \"-r\", \"-t\", \"-z\", oid, optional_locks=False)","+            if res.returncode == 0:","+                for entry in res.stdout.split(b\"\\0\"):","+                    if not entry:","+                        continue","+                    try:","+                        meta = entry.split(b\"\\t\", 1)[0].split()","+                        child = meta[2].decode(\"ascii\", \"ignore\")","+                        acc.add(child)","+                    except Exception:","+                        pass","+        elif typ == \"commit\":","+            res = self.git(\"rev-list\", \"--objects\", oid, optional_locks=False)","+            if res.returncode == 0:","+                for line in out_text(res).splitlines():","+                    acc.add(line.split(\" \", 1)[0])","+","+    def index_object_entries(self, gitdir=None):","+        entries = []","+        if gitdir:","+            res = self.git_in_gitdir(gitdir, \"ls-files\", \"-s\", \"-z\",","+                                     optional_locks=False)","+        else:","+            res = self.git(\"ls-files\", \"-s\", \"-z\", optional_locks=False)","+        if res.returncode != 0:","+            return entries","+        for item in res.stdout.split(b\"\\0\"):","+            if not item:","+                continue","+            try:","+                meta, _path = item.split(b\"\\t\", 1)","+                parts = meta.split()","+                entries.append((parts[0].decode(), parts[1].decode()))","+            except Exception:","+                pass","+        return entries","+","+    def allowed_objects(self):","+        if self._allowed_objects is not None:","+            return self._allowed_objects","+        acc = set()","+        if self.tip_commits:","+            res = self.git(*([\"rev-list\", \"--objects\"] + list(self.tip_commits)),","+                           optional_locks=False)","+            if res.returncode == 0:","+                for line in out_text(res).splitlines():","+                    acc.add(line.split(\" \", 1)[0])","+        for oid in list(self.raw_keep):","+            self._add_closure(oid, acc)","+        gitdirs = [None]","+        for mode, oid in self.index_object_entries():","+            if mode != \"160000\":","+                self._add_closure(oid, acc)","+        self._allowed_objects = acc","+        return acc","+","+    def oid_allowed(self, oid, noncommit=False):","+        if not oid or oid == self.zero_oid:","+            return False","+        if oid in self.allowed_commits or oid in self.raw_keep:","+            return True","+        if noncommit:","+            return oid in self.allowed_objects()","+        return False","+","+    def capture_original_objects(self):","+        res = self.git(\"cat-file\", \"--batch-all-objects\",","+                       \"--batch-check=%(objectname)\", optional_locks=False)","+        if res.returncode == 0:","+            self.original_objects = set(out_text(res).split())","+        else:","+            self.original_objects = None","+","+    def snapshot_indexes(self):","+        paths = set()","+        try:","+            paths.add(self.git_path(\"index\"))","+        except Exception:","+            pass","+        for gdir in self.all_gitdirs():","+            paths.add(os.path.join(gdir, \"index\"))","+            try:","+                for name in os.listdir(gdir):","+                    if name.startswith(\"sharedindex.\"):","+                        paths.add(os.path.join(gdir, name))","+            except OSError:","+                pass","+        snap = {}","+        for path in sorted(paths):","+            try:","+                if os.path.isfile(path) and not os.path.islink(path):","+                    st = os.stat(path)","+                    with open(path, \"rb\") as fh:","+                        snap[path] = (fh.read(), st.st_mode & 0o7777,","+                                      st.st_atime_ns, st.st_mtime_ns)","+            except OSError:","+                pass","+        self._index_snapshot = snap","+        return snap","+","+    def restore_indexes(self):","+        for path, (data, mode, atime_ns, mtime_ns) in self._index_snapshot.items():","+            try:","+                if not os.path.isdir(os.path.dirname(path)):","+                    continue","+                current = None","+                if os.path.isfile(path):","+                    with open(path, \"rb\") as fh:","+                        current = fh.read()","+                if current == data:","+                    continue","+                write_file_atomic(path, data, mode)","+                os.utime(path, ns=(atime_ns, mtime_ns))","+            except OSError as exc:","+                dbg(\"restore index %s failed: %s\" % (path, exc))"],"newLines":228,"newStart":267,"oldLines":3,"oldStart":267}],"path":"/app/sanitize/sanitize"}]}