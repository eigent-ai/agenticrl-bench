{"files":[{"hunks":[{"lines":["                                     refname, token)","             if r2.returncode != 0 and os.path.exists(path):","                 safe_unlink(path)","+","+    # -- pseudo-refs, operation state, reflogs -------------------------","+    def _full_oid_re(self):","+        return re.compile(r\"(?<![0-9a-fA-F])[0-9a-fA-F]{%d}(?![0-9a-fA-F])\" % self.oid_len)","+","+    def _token_is_bad(self, token):","+        if token == self.zero_oid:","+            return False","+        if self.oid_allowed(token):","+            return False","+        return self.object_exists(token)","+","+    def clean_state_dirs(self, gdir):","+        removed_any = False","+        for dirname in (\"rebase-merge\", \"rebase-apply\", \"sequencer\"):","+            path = os.path.join(gdir, dirname)","+            if not os.path.isdir(path):","+                continue","+            bad = False","+            for root, _dirs, files in os.walk(path):","+                for name in files:","+                    fpath = os.path.join(root, name)","+                    try:","+                        with open(fpath, \"rb\") as fh:","+                            data = fh.read(65536).decode(\"utf-8\", \"ignore\")","+                    except OSError:","+                        continue","+                    if name in (\"todo\", \"done\", \"git-rebase-todo\",","+                                \"git-rebase-todo.backup\"):","+                        for line in data.splitlines():","+                            fields = line.split()","+                            if len(fields) >= 2 and is_hex(fields[1]) and 4 <= len(fields[1]) <= self.oid_len:","+                                commit = self.peel_commit(fields[1])","+                                if commit and commit not in self.allowed_commits:","+                                    bad = True","+                    for token in self._full_oid_re().findall(data):","+                        if self._token_is_bad(token):","+                            bad = True","+                            break","+                    if bad:","+                        break","+                if bad:","+                    break","+            if bad:","+                shutil.rmtree(path, ignore_errors=True)","+                removed_any = True","+        # bisect state","+        bisect_files = []","+        try:","+            bisect_files = [n for n in os.listdir(gdir) if n.startswith(\"BISECT_\")]","+        except OSError:","+            bisect_files = []","+        bad = False","+        for name in bisect_files:","+            try:","+                with open(os.path.join(gdir, name), \"rb\") as fh:","+                    data = fh.read(65536).decode(\"utf-8\", \"ignore\")","+            except OSError:","+                continue","+            for token in self._full_oid_re().findall(data):","+                if self._token_is_bad(token):","+                    bad = True","+        if bad:","+            for name in bisect_files:","+                safe_unlink(os.path.join(gdir, name))","+        return removed_any","+","+    def clean_pseudo_and_state(self):","+        removed_ops = {}","+        for gdir in self.all_gitdirs():","+            removed_ops[gdir] = self.clean_state_dirs(gdir)","+        pseudo_commit = [\"ORIG_HEAD\", \"MERGE_HEAD\", \"CHERRY_PICK_HEAD\",","+                         \"REVERT_HEAD\", \"REBASE_HEAD\", \"BISECT_EXPECTED_REV\",","+                         \"MERGE_AUTOSTASH\"]","+        for gdir in self.all_gitdirs():","+            removed_here = set()","+            for name in pseudo_commit:","+                path = os.path.join(gdir, name)","+                if not os.path.isfile(path):","+                    continue","+                try:","+                    with open(path, \"rb\") as fh:","+                        tokens = fh.read(256).decode(\"utf-8\", \"ignore\").split()","+                except OSError:","+                    continue","+                token = tokens[0] if tokens else \"\"","+                if is_hex(token, self.oid_len) and not self.oid_allowed(token):","+                    safe_unlink(path)","+                    removed_here.add(name)","+            auto = os.path.join(gdir, \"AUTO_MERGE\")","+            if os.path.isfile(auto):","+                try:","+                    with open(auto, \"rb\") as fh:","+                        token = fh.read(256).decode(\"utf-8\", \"ignore\").split()","+                    token = token[0] if token else \"\"","+                    if is_hex(token, self.oid_len) and token not in self.allowed_objects():","+                        safe_unlink(auto)","+                        removed_here.add(\"AUTO_MERGE\")","+                except OSError:","+                    pass","+            if removed_ops.get(gdir):","+                for name in (\"MERGE_HEAD\", \"CHERRY_PICK_HEAD\", \"REVERT_HEAD\",","+                             \"REBASE_HEAD\"):","+                    p = os.path.join(gdir, name)","+                    if os.path.isfile(p):","+                        safe_unlink(p)","+                        removed_here.add(name)","+            if \"MERGE_HEAD\" in removed_here:","+                for name in (\"MERGE_MSG\", \"MERGE_MODE\", \"SQUASH_MSG\"):","+                    safe_unlink(os.path.join(gdir, name))","+            if removed_here & {\"CHERRY_PICK_HEAD\", \"REVERT_HEAD\", \"REBASE_HEAD\",","+                                \"MERGE_AUTOSTASH\"}:","+                seq = os.path.join(gdir, \"sequencer\")","+                if os.path.isdir(seq):","+                    shutil.rmtree(seq, ignore_errors=True)","+            # FETCH_HEAD: keep only lines for retained commits","+            fetch = os.path.join(gdir, \"FETCH_HEAD\")","+            if os.path.isfile(fetch):","+                try:","+                    with open(fetch, \"rb\") as fh:","+                        lines = fh.read().decode(\"utf-8\", \"surrogateescape\").splitlines()","+                    kept = []","+                    for line in lines:","+                        fields = line.split()","+                        token = fields[0] if fields else \"\"","+                        if is_hex(token, self.oid_len) and self.oid_allowed(token):","+                            kept.append(line)","+                    if kept:","+                        write_file_atomic(fetch, (\"\\n\".join(kept) + \"\\n\").encode(","+                            \"utf-8\", \"surrogateescape\"))","+                    else:","+                        safe_unlink(fetch)","+                except OSError:","+                    pass","+        self._clean_shallow_and_grafts()","+","+    def _clean_shallow_and_grafts(self):","+        shallow_add = set()","+        grafts = os.path.join(self.commondir, \"info\", \"grafts\")","+        if os.path.isfile(grafts):","+            try:","+                kept = []","+                with open(grafts, \"rb\") as fh:","+                    for raw in fh.read().decode(\"utf-8\", \"ignore\").splitlines():","+                        stripped = raw.strip()","+                        if not stripped or stripped.startswith(\"#\"):","+                            kept.append(raw)","+                            continue","+                        tokens = stripped.split()","+                        if tokens and all(self.oid_allowed(t) for t in tokens):","+                            kept.append(raw)","+                        elif tokens and self.oid_allowed(tokens[0]):","+                            shallow_add.add(tokens[0])","+                kept = [k for k in kept if k.strip() and not k.strip().startswith(\"#\")]","+                if kept:","+                    write_file_atomic(grafts, (\"\\n\".join(kept) + \"\\n\").encode())","+                else:","+                    safe_unlink(grafts)","+            except OSError:","+                pass","+        shallow = os.path.join(self.commondir, \"shallow\")","+        kept = set()","+        if os.path.isfile(shallow):","+            try:","+                with open(shallow, \"rb\") as fh:","+                    for token in fh.read().decode(\"utf-8\", \"ignore\").split():","+                        if token in self.allowed_commits and self.object_exists(token):","+                            kept.add(token)","+            except OSError:","+                pass","+        kept |= set(t for t in shallow_add if self.object_exists(t))","+        if kept:","+            write_file_atomic(shallow, (\"\\n\".join(sorted(kept)) + \"\\n\").encode())","+        elif os.path.isfile(shallow):","+            safe_unlink(shallow)","+","+    def clean_reflogs(self):","+        live_refs = set(r[\"name\"] for r in self.list_refs())","+        log_roots = []","+        for gdir in self.all_gitdirs():","+            log_roots.append(os.path.join(gdir, \"logs\"))","+        for logs_root in log_roots:","+            if not os.path.isdir(logs_root):","+                continue","+            for root, _dirs, files in os.walk(logs_root):","+                for name in files:","+                    if name.endswith(\".lock\"):","+                        continue","+                    path = os.path.join(root, name)","+                    rel = os.path.relpath(path, logs_root).replace(os.sep, \"/\")","+                    if rel != \"HEAD\" and rel not in live_refs:","+                        # allow a surviving symbolic ref's log to stay if","+                        # the loose ref file still exists","+                        ref_file = os.path.join(self.commondir, rel)","+                        if not os.path.exists(ref_file):","+                            safe_unlink(path)","+                            continue","+                    try:","+                        st = os.stat(path)","+                        with open(path, \"rb\") as fh:","+                            lines = fh.read().decode(","+                                \"utf-8\", \"surrogateescape\").splitlines()","+                    except OSError:","+                        continue","+                    kept = []","+                    for line in lines:","+                        fields = line.split(\" \")","+                        if len(fields) < 2:","+                            continue","+                        old, new = fields[0], fields[1]","+                        if not (is_hex(old, self.oid_len) and is_hex(new, self.oid_len)):","+                            continue","+                        if old != self.zero_oid and not self.oid_allowed(old):","+                            continue","+                        if not self.oid_allowed(new):","+                            continue","+                        message = line.split(\"\\t\", 1)[1] if \"\\t\" in line else \"\"","+                        bad = False","+                        for token in self._full_oid_re().findall(message):","+                            if self._token_is_bad(token):","+                                bad = True","+                                break","+                        if bad:","+                            continue","+                        kept.append(line)","+                    try:","+                        if kept:","+                            write_file_atomic(","+                                path, (\"\\n\".join(kept) + \"\\n\").encode(","+                                    \"utf-8\", \"surrogateescape\"),","+                                st.st_mode & 0o7777)","+                        else:","+                            safe_unlink(path)","+                    except OSError:","+                        pass"],"newLines":238,"newStart":660,"oldLines":3,"oldStart":660}],"path":"/app/sanitize/sanitize"}]}