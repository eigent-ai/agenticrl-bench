{"files":[{"hunks":[{"lines":["     except BaseException:","         safe_unlink(tmp)","         raise","+","+","+class Repo(object):","+    def __init__(self, entry, prefix, cwd):","+        self.entry = entry","+        self.prefix = prefix","+        self.cwd = cwd","+        self.gitdir = None","+        self.commondir = None","+        self.objdir = None","+        self.toplevel = None","+        self.bare = False","+        self.oid_len = 40","+        self.zero_oid = \"0\" * 40","+        self.head_symref = None","+        self.head_raw = None","+        self.head_commit = None","+        self.base_commit = None","+        self.tip_commits = []","+        self.raw_keep = []","+        self.allowed_commits = set()","+        self._allowed_objects = None","+        self._obj_types = {}","+        self.worktrees = []","+        self._index_snapshot = {}","+        self.server_info_existed = False","+        self.alt_unresolved = False","+        self.original_objects = None","+        self.failed = False","+","+    # -- git invocation -------------------------------------------------","+    def git(self, *args, **kw):","+        return run_cmd(self.prefix, self.cwd, list(args), **kw)","+","+    def git_out(self, *args, **kw):","+        kw.setdefault(\"optional_locks\", False)","+        return out_text(self.git(*args, **kw)).strip()","+","+    def git_in_gitdir(self, gitdir, *args, **kw):","+        return run_cmd([\"--git-dir=\" + gitdir], gitdir, list(args), **kw)","+","+    @classmethod","+    def probe(cls, entry):","+        if not entry or not os.path.isdir(entry):","+            return None","+        entry = os.path.abspath(entry)","+        if os.path.exists(os.path.join(entry, \".git\")):","+            prefix = [\"-C\", entry]","+        elif looks_gitdir(entry):","+            prefix = [\"--git-dir=\" + entry]","+        else:","+            prefix = [\"-C\", entry]","+        repo = cls(entry, prefix, entry)","+        res = repo.git(\"rev-parse\", \"--git-dir\", optional_locks=False)","+        if res.returncode != 0:","+            if looks_gitdir(entry):","+                repo = cls(entry, [\"--git-dir=\" + entry], entry)","+                res = repo.git(\"rev-parse\", \"--git-dir\", optional_locks=False)","+            if res.returncode != 0:","+                return None","+        try:","+            repo._fill_paths(out_text(res).strip())","+        except Exception as exc:","+            dbg(\"probe %s failed: %s\" % (entry, exc))","+            return None","+        return repo","+","+    def _fill_paths(self, gitdir_raw):","+        self.gitdir = abspath_from(self.cwd, gitdir_raw)","+        common = self.git_out(\"rev-parse\", \"--git-common-dir\")","+        self.commondir = abspath_from(self.cwd, common) if common else self.gitdir","+        obj = self.git_out(\"rev-parse\", \"--git-path\", \"objects\")","+        self.objdir = abspath_from(self.cwd, obj) if obj else os.path.join(","+            self.commondir, \"objects\")","+        self.bare = self.git_out(\"rev-parse\", \"--is-bare-repository\") == \"true\"","+        if not self.bare:","+            top = self.git_out(\"rev-parse\", \"--show-toplevel\")","+            self.toplevel = abspath_from(self.cwd, top) if top else None","+        fmt = self.git_out(\"rev-parse\", \"--show-object-format\")","+        if fmt == \"sha256\":","+            self.oid_len = 64","+        elif fmt == \"sha1\":","+            self.oid_len = 40","+        else:","+            cfg = self.git_out(\"config\", \"--get\", \"extensions.objectformat\")","+            self.oid_len = 64 if cfg == \"sha256\" else 40","+        self.zero_oid = \"0\" * self.oid_len","+","+    def git_path(self, name):","+        val = self.git_out(\"rev-parse\", \"--git-path\", name)","+        return abspath_from(self.cwd, val) if val else os.path.join(self.gitdir, name)","+","+    def all_gitdirs(self):","+        seen = []","+        for cand in [self.gitdir, self.commondir]:","+            if cand and cand not in seen:","+                seen.append(cand)","+        wt_root = os.path.join(self.commondir, \"worktrees\")","+        if os.path.isdir(wt_root):","+            for name in sorted(os.listdir(wt_root)):","+                cand = os.path.join(wt_root, name)","+                if os.path.isdir(cand) and cand not in seen:","+                    seen.append(cand)","+        return seen","+","+    # -- object helpers -------------------------------------------------","+    def object_type(self, oid):","+        if oid in self._obj_types:","+            return self._obj_types[oid]","+        typ = self.git_out(\"cat-file\", \"-t\", oid) or None","+        self._obj_types[oid] = typ","+        return typ","+","+    def object_exists(self, oid):","+        if not oid or oid == self.zero_oid:","+            return False","+        res = self.git(\"cat-file\", \"-e\", oid + \"^{object}\", optional_locks=False)","+        return res.returncode == 0","+","+    def peel_commit(self, expr):","+        if not expr:","+            return None","+        res = self.git(\"rev-parse\", \"-q\", \"--verify\", expr + \"^{commit}\",","+                       optional_locks=False)","+        if res.returncode != 0:","+            return None","+        val = out_text(res).strip()","+        return val or None","+","+    def peel_object(self, expr):","+        if not expr:","+            return None","+        res = self.git(\"rev-parse\", \"-q\", \"--verify\", expr + \"^{object}\",","+                       optional_locks=False)","+        if res.returncode != 0:","+            return None","+        return out_text(res).strip() or None"],"newLines":140,"newStart":130,"oldLines":3,"oldStart":130}],"path":"/app/sanitize/sanitize"}]}