 mypy/version.py: 'import os\nfrom mypy import git\n\n# Base version.\n# - Release versions have the form "0.NNN".\n# - Dev versions have the form "0.NNN+dev" (PLUS sign to conform to PEP 440).\n# - For 1.0 we\'ll switch back to 1.2.3 form.\n__version__ = \'0.960+dev\'\nbase_version = __version__\n\nmypy_dir = os.path.abspath(os.path.dirname(os.path.dirname(__file__)))\nif __version__.endswith(\'+dev\') and git.is_git_repo(mypy_dir) and git.have_git():\n    __version__ += \'.\' + git.git_revision(mypy_dir).decode(\'utf-8\')\n    if git.is_dirty(mypy_dir):\n        __version__ += \'.dirty\'\ndel mypy_dir\n'
 setup.py [version]: ['if sys.version_info < (3, 6, 0):', 'from mypy.version import __version__ as version', '    def pin_version(self):', "        with open(os.path.join(path, 'version.py'), 'w') as stream:", '            stream.write(f\'__version__ = "{version}"\\n\')', '        self.execute(self.pin_version, ())']
