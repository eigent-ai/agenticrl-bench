{"files":[{"hunks":[{"lines":["             pass"," "," ","+# ------------------------------------------------------------- one repo","+","+def all_commit_oids(ctx):","+    r = ctx.git([\"cat-file\", \"--batch-all-objects\",","+                 \"--batch-check=%(objectname) %(objecttype)\"], check=False)","+    commits = set()","+    if r.returncode == 0:","+        for line in r.stdout.decode().splitlines():","+            parts = line.split()","+            if len(parts) == 2 and parts[1] == \"commit\":","+                commits.add(parts[0])","+    return commits","+","+","+def sanitize_repo(ctx, extra_tips, include_head=True):","+    label = ctx.work_tree or ctx.git_dir","+    # Clean leftovers from a previously killed run of this tool.","+    try:","+        for entry in os.listdir(ctx.common_dir):","+            if entry.startswith(\".sanitize-\"):","+                remove_path(os.path.join(ctx.common_dir, entry))","+    except OSError:","+        pass","+    tmp = tempfile.mkdtemp(prefix=\".sanitize-\", dir=ctx.common_dir)","+    backup = Backup(ctx)","+    # Back up index file(s) on disk (git status/write-tree may refresh them).","+    index_backups = []","+    for root in {ctx.git_dir, ctx.common_dir}:","+        for entry in (os.listdir(root) if os.path.isdir(root) else []):","+            if entry == \"index\" or entry.startswith(\"sharedindex.\"):","+                src = os.path.join(root, entry)","+                dst = os.path.join(tmp, \"idx-%d-%s\" % (len(index_backups), entry))","+                try:","+                    shutil.copyfile(src, dst)","+                    index_backups.append((src, dst))","+                except OSError:","+                    pass","+    old_objects_backup = None","+    objects_swapped = False","+    objects_path = os.path.join(ctx.common_dir, \"objects\")","+    objects_was_link = os.path.islink(objects_path)","+    objects_link_target = os.readlink(objects_path) if objects_was_link else None","+    moved_lfs 