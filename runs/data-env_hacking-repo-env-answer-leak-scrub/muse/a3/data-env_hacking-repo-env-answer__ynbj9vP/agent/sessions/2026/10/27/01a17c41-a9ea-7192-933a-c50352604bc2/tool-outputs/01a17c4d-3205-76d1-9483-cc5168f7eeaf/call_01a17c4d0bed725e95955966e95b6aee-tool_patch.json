{"files":[{"hunks":[{"lines":["             remove_path(p)"," "," ","+def scrub_config_file(ctx, path):","+    if not os.path.isfile(path):","+        return","+    r = ctx.git([\"config\", \"--file\", path, \"--null\", \"--list\"], check=False)","+    if r.returncode != 0:","+        return","+    keys = []","+    for entry in r.stdout.decode(\"utf-8\", \"surrogateescape\").split(\"\\x00\"):","+        if not entry:","+            continue","+        keys.append(entry.split(\"\\n\", 1)[0])","+    remote_sections = set()","+    unset_keys = set()","+    for key in keys:","+        parts = key.split(\".\")","+        low0 = parts[0].lower()","+        low_last = parts[-1].lower()","+        if low0 == \"remote\" and len(parts) >= 3:","+            remote_sections.add(\"remote.\" + \".\".join(parts[1:-1]))","+        elif low0 == \"remote\" and len(parts) == 2:","+            unset_keys.add(key)","+        elif low0 == \"branch\" and len(parts) >= 3 and low_last in (","+                \"remote\", \"merge\", \"pushremote\"):","+            unset_keys.add(key)","+        elif low0 == \"extensions\" and low_last == \"partialclone\":","+            unset_keys.add(key)","+    for section in remote_sections:","+        ctx.git([\"config\", \"--file\", path, \"--remove-section\", section],","+                check=False)","+    for key in unset_keys:","+        ctx.git([\"config\", \"--file\", path, \"--unset-all\", key], check=False)","+","+","+def scrub_config(ctx):","+    scrub_config_file(ctx, os.path.join(ctx.common_dir, \"config\"))","+    if ctx.git_dir != ctx.common_dir:","+        scrub_config_file(ctx, os.path.join(ctx.git_dir, \"config.worktree\"))","+","+","+LFS_POINTER_PREFIX = b\"version https://git-lfs.github.com/spec/v1\"","+","+","+def prune_lfs(ctx, stash_dir):","+    \"\"\"Move unreferenced LFS objects aside; returns list of moved files.\"\"\"","+    lfs_objects = os.path.join(ctx.common_dir, \"lfs\", \"objects\")","+    if not os.path.isdir(lfs_objects):","+        return []","+    referenced = set()","+    # Scan small kept blobs for LFS pointers.","+    r = ctx.git([\"cat-file\", \"--batch-all-objects\",","+                 \"--batch-check=%(objectname) %(objecttype) %(objectsize)\"],","+                check=False)","+    small = []","+    if r.returncode == 0:","+        for line in r.stdout.decode().splitlines():","+            parts = line.split()","+            if len(parts) == 3 and parts[1] == \"blob\":","+                try:","+                    size = int(parts[2])","+                except ValueError:","+                    continue","+                if 100 <= size <= 1024:","+                    small.append(parts[0])","+    for oid in small:","+        r = ctx.git([\"cat-file\", \"blob\", oid], check=False)","+        if r.returncode != 0:","+            continue","+        data = r.stdout","+        if data.startswith(LFS_POINTER_PREFIX):","+            m = re.search(rb\"^oid sha256:([0-9a-f]{64})\\s*$\", data, re.M)","+            if m:","+                referenced.add(m.group(1).decode())","+    moved = []","+    for dp, _dn, fn in os.walk(lfs_objects):","+        for fnm in fn:","+            if fnm in referenced:","+                continue","+            src = os.path.join(dp, fnm)","+            dst = os.path.join(stash_dir, \"lfs\",","+                               os.path.relpath(src, lfs_objects))","+            os.makedirs(os.path.dirname(dst), exist_ok=True)","+            shutil.move(src, dst)","+            moved.append((src, dst))","+    prune_empty_dirs(lfs_objects)","+    return moved","+","+","+def restore_lfs(moved):","+    for src, dst in moved:","+        try:","+            os.makedirs(os.path.dirname(src), exist_ok=True)","+            shutil.move(dst, src)","+        except OSError:","+            pass","+","+","+"," "],"newLines":101,"newStart":593,"oldLines":4,"oldStart":593}],"path":"/app/sanitize/sanitize"}]}