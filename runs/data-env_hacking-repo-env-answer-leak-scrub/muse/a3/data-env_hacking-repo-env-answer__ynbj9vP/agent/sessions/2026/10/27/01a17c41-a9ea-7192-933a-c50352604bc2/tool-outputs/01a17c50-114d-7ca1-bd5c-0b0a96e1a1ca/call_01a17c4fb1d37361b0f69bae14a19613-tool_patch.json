{"files":[{"hunks":[{"lines":["+import os, subprocess, json, hashlib, shutil, sys, time, re","+","+POOL=\"/app/pool\"; DST=\"/tmp/pooltest\"","+def g(tb,*a,check=False):","+    r=subprocess.run([\"git\",\"-C\",tb]+list(a),capture_output=True)","+    if check and r.returncode: raise RuntimeError((a,r.stderr[:500]))","+    return r","+def hout(tb,*a):","+    r=g(tb,*a); return (r.returncode, hashlib.sha256(r.stdout).hexdigest(), len(r.stdout))","+def worktree_hashes(tb):","+    out={}","+    for root,dirs,files in os.walk(tb):","+        if \".git\" in dirs: dirs.remove(\".git\")","+        for fn in files:","+            p=os.path.join(root,fn); rel=os.path.relpath(p,tb)","+            if os.path.islink(p): out[rel]=(\"link\",os.readlink(p))","+            else:","+                h=hashlib.sha256()","+                with open(p,\"rb\") as f:","+                    for c in iter(lambda:f.read(65536),b\"\"): h.update(c)","+                out[rel]=(\"file\",oct(os.stat(p).st_mode & 0o7777),h.hexdigest())","+        for d in list(dirs):","+            p=os.path.join(root,d)","+            if os.path.islink(p): out[os.path.relpath(p,tb)]=(\"link\",os.readlink(p)); dirs.remove(d)","+    return out","+def tag_chain(tb,oid):","+    chain=[]; cur=oid; seen=set()","+    while cur and cur not in seen:","+        seen.add(cur)","+        r=g(tb,\"cat-file\",\"-t\",cur)","+        if r.returncode or r.stdout.strip()!=b\"tag\": break","+        chain.append(cur)","+        r=g(tb,\"cat-file\",\"tag\",cur)","+        if r.returncode: break","+        nxt=None","+        for line in r.stdout.decode(\"utf8\",\"replace\").splitlines():","+            if line.startswith(\"object \"): nxt=line[7:].strip(); break","+            if not line: break","+        cur=nxt","+    return chain","+","+names=sorted(os.listdir(POOL)) if len(sys.argv)<2 else sys.argv[1:]","+os.makedirs(DST+\"/home\",exist_ok=True); os.makedirs(DST+\"/tmp\",exist_ok=True)","+allok=True","+for name in names:","+    print(f\"\\n===== {name} =====\", flush=True)","+    src=os.path.join(POOL,name); spec=json.load(open(src+\"/spec.json\")); base=spec[\"base_commit\"]","+    tb=os.path.join(DST,name,\"testbed\")","+    if os.path.exists(os.path.join(DST,name)): shutil.rmtree(os.path.join(DST,name))","+    shutil.copytree(src+\"/testbed\",tb,symlinks=True)","+    # BEFORE","+    wh=worktree_hashes(tb)","+    head=g(tb,\"rev-parse\",\"HEAD\").stdout.decode().strip()","+    sym=g(tb,\"symbolic-ref\",\"-q\",\"HEAD\"); sym=sym.stdout.decode().strip() if sym.returncode==0 else None","+    allowed=set(g(tb,\"rev-list\",\"HEAD\",base).stdout.decode().split())","+    reach=set(l.split()[0] for l in g(tb,\"rev-list\",\"--objects\",\"HEAD\",base).stdout.decode().splitlines() if l)","+    allobj={}","+    for l in g(tb,\"cat-file\",\"--batch-all-objects\",\"--batch-check=%(objectname) %(objecttype)\").stdout.decode().splitlines():","+        p=l.split(); allobj[p[0]]=p[1]","+    refs_before={}","+    for l in g(tb,\"for-each-ref\",\"--format=%(refname)%00%(objectname)%00%(objecttype)%00%(*objectname)%00%(*objecttype)%00%(symref)\").stdout.decode().splitlines():","+        f=l.split(\"\\x00\"); refs_before[f[0]]={\"oid\":f[1],\"type\":f[2],\"peeled\":f[3],\"ptype\":f[4],\"symref\":f[5]}","+    expected_refs={}","+    extra_keep=set()","+    for rn,rr in refs_before.items():","+        if rr[\"symref\"]: continue","+        peeled=rr[\"peeled\"] or rr[\"oid\"]; pt=rr[\"ptype\"] or rr[\"type\"]","+        if pt==\"commit\" and peeled in allowed:","+            expected_refs[rn]=rr[\"oid\"]","+            if rr[\"type\"]==\"tag\": extra_keep.update(tag_chain(tb,rr[\"oid\"]))","+    for rn,rr in refs_before.items():","+        if rr[\"symref\"] and rr[\"symref\"] in expected_refs: expected_refs[rn]=rr[\"oid\"]","+    idx=set()","+    for l in g(tb,\"ls-files\",\"-s\").stdout.decode().splitlines():","+        pp=l.split()","+        if len(pp)>=2 and pp[0]!=\"160000\": idx.add(pp[1])","+    forbidden={o for o in allobj if o not in reach and o not in extra_keep and o not in idx}","+    # staged-tree trees might be in forbidden if staged new dirs; compute write-tree in ORIG? can't mutate copy before? We are on copy, can:","+    wt=g(tb,\"write-tree\")","+    staged_keep=set()","+    if wt.returncode==0:","+        tree=wt.stdout.decode().strip(); staged_keep={tree}","+        for l in g(tb,\"ls-tree\",\"-r\",\"-t\",tree).stdout.decode().splitlines():","+            meta=l.split(\"\\t\")[0].split()","+            if len(meta)==3 and meta[0]!=\"160000\": staged_keep.add(meta[2])","+    forbidden-=staged_keep","+    before={","+      \"status\":hout(tb,\"status\",\"--porcelain=v1\",\"-z\",\"-uall\"),","+      \"lsfiles\":hout(tb,\"ls-files\",\"-s\",\"-z\"),","+      \"diffhead\":hout(tb,\"diff\",\"HEAD\",\"--binary\"),","+      \"diffcached\":hout(tb,\"diff\",\"--cached\",\"--binary\"),","+      \"log\":hout(tb,\"log\",\"--format=%H%x00%P%x00%T%x00%B%x00==END==\",\"HEAD\"),","+      \"describe\":(g(tb,\"describe\",\"--tags\",\"--long\",\"--always\",\"--dirty\").stdout),","+      \"describe_plain\":(g(tb,\"describe\",\"--tags\").stdout),","+      \"branch\":(g(tb,\"branch\",\"--show-current\").stdout),","+      \"count\":(g(tb,\"rev-list\",\"--count\",\"HEAD\").stdout),","+    }","+    env=dict(os.environ); env[\"HOME\"]=DST+\"/home\"; env[\"TMPDIR\"]=DST+\"/tmp\"","+    t0=time.time()","+    r=subprocess.run([\"/app/sanitize/sanitize\",tb,src+\"/spec.json\"],capture_output=True,text=True,env=env)","+    dt=time.time()-t0","+    print(\"sanitize rc\",r.returncode,\"time %.1fs\"%dt); print(r.stdout[-1000:]); print(r.stderr[-2000:])","+    fails=[]","+    if r.returncode!=0: fails.append(\"rc!=0\")","+    wh2=worktree_hashes(tb)","+    if wh!=wh2:","+        diff=[k for k in set(wh)|set(wh2) if wh.get(k)!=wh2.get(k)]","+        fails.append(f\"worktree changed {diff[:10]}\")","+    else: print(\"worktree identical:\",len(wh),\"files\")","+    after={","+      \"status\":hout(tb,\"status\",\"--porcelain=v1\",\"-z\",\"-uall\"),","+      \"lsfiles\":hout(tb,\"ls-files\",\"-s\",\"-z\"),","+      \"diffhead\":hout(tb,\"diff\",\"HEAD\",\"--binary\"),","+      \"diffcached\":hout(tb,\"diff\",\"--cached\",\"--binary\"),","+      \"log\":hout(tb,\"log\",\"--format=%H%x00%P%x00%T%x00%B%x00==END==\",\"HEAD\"),","+      \"describe\":(g(tb,\"describe\",\"--tags\",\"--long\",\"--always\",\"--dirty\").stdout),","+      \"describe_plain\":(g(tb,\"describe\",\"--tags\").stdout),","+      \"branch\":(g(tb,\"branch\",\"--show-current\").stdout),","+      \"count\":(g(tb,\"rev-list\",\"--count\",\"HEAD\").stdout),","+    }","+    for k in before:","+        if before[k]!=after[k]: fails.append(f\"preserve:{k} before={before[k]} after={after[k]}\")","+    if g(tb,\"rev-parse\",\"HEAD\").stdout.decode().strip()!=head: fails.append(\"HEAD changed\")","+    sym2=g(tb,\"symbolic-ref\",\"-q\",\"HEAD\"); sym2=sym2.stdout.decode().strip() if sym2.returncode==0 else None","+    if sym2!=sym: fails.append(\"symref changed\")","+    # leak checks","+    allobj2={}","+    for l in g(tb,\"cat-file\",\"--batch-all-objects\",\"--batch-check=%(objectname) %(objecttype)\").stdout.decode().splitlines():","+        p=l.split(); allobj2[p[0]]=p[1]","+    commits2={o for o,t in allobj2.items() if t==\"commit\"}","+    if commits2!=allowed: fails.append(f\"commits after != allowed: extra={len(commits2-allowed)} missing={len(allowed-commits2)}\")","+    inter=forbidden & set(allobj2)","+    if inter: fails.append(f\"forbidden objects remain {len(inter)} e.g. {list(inter)[:5]}\")","+    missing={o for o in reach if o in allobj} - set(allobj2)  # reach includes gitlinks not in allobj","+    if missing: fails.append(f\"reachable objects missing {len(missing)} e.g. {list(missing)[:5]}\")","+    refs_after={}","+    for l in g(tb,\"for-each-ref\",\"--format=%(refname) %(objectname)\").stdout.decode().splitlines():","+        p=l.split(); refs_after[p[0]]=p[1]","+    if refs_after!=expected_refs:","+        fails.append(f\"refs mismatch extra={set(refs_after)-set(expected_refs)} missing={set(expected_refs)-set(refs_after)} changed={[k for k in refs_after if k in expected_refs and refs_after[k]!=expected_refs[k]][:5]}\")","+    rem=g(tb,\"remote\").stdout.decode().strip()","+    if rem: fails.append(f\"remotes remain {rem}\")","+    cfg=open(tb+\"/.git/config\").read()","+    if \"remote\" in cfg: fails.append(\"remote in config\")","+    disallowed_commits={o for o,t in allobj.items() if t==\"commit\"}-allowed","+    # scan .git text-ish files (skip objects, index) for disallowed commit hashes","+    oid_re=re.compile(rb\"[0-9a-f]{40}\")","+    leaks=[]","+    for root,dirs,files in os.walk(tb+\"/.git\"):","+        if \"objects\" in dirs and os.path.basename(root)==\".git\": dirs.remove(\"objects\")","+        for fn in files:","+            p=os.path.join(root,fn)","+            if os.path.basename(p)==\"index\": continue","+            if os.path.getsize(p)>2_000_000: continue","+            try: data=open(p,\"rb\").read()","+            except: continue","+            toks={m.decode() for m in oid_re.findall(data)}","+            hit=toks & disallowed_commits","+            if hit: leaks.append((os.path.relpath(p,tb),list(hit)[:2]))","+    if leaks: fails.append(f\"disallowed hashes in .git files {leaks[:8]}\")","+    fsck=g(tb,\"fsck\",\"--full\")","+    print(\"fsck rc\",fsck.returncode, fsck.stdout.decode()[:500], fsck.stderr.decode()[:500])","+    if fsck.returncode!=0: fails.append(\"fsck rc\")","+    print(\"objects before/after:\",len(allobj),len(allobj2),\"refs\",len(refs_before),\"->\",len(refs_after),\"describe:\",after[\"describe\"])","+    if fails:","+        allok=False; print(\"FAILURES:\"); [print(\" -\",f) for f in fails]","+    else: print(\"ALL OK\")","+print(\"\\nOVERALL\", \"OK\" if allok else \"FAILURES\")"],"newLines":168,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_pool.py"}]}