    done
    [ -f /tmp/.grok-build-b52df632-8455-4e8d-81e9-2173dfe323cb.exit ]
  }
  while [ ! -f /tmp/.grok-build-b52df632-8455-4e8d-81e9-2173dfe323cb.exit ]; do
