STATUS=$(cat /tmp/.grok-build-b52df632-8455-4e8d-81e9-2173dfe323cb.exit 2>/dev/null)
rm -f /tmp/.grok-build-b52df632-8455-4e8d-81e9-2173dfe323cb.pid /tmp/.grok-build-b52df632-8455-4e8d-81e9-2173dfe323cb.exit /tmp/.grok-build-b52df632-8455-4e8d-81e9-2173dfe323cb.children
exit "${STATUS:-1}"

