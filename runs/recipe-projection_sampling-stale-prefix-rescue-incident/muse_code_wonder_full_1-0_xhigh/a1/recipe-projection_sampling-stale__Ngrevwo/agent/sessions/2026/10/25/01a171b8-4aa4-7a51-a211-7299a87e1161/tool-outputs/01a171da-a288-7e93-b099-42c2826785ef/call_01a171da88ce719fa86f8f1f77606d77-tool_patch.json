{"files":[{"hunks":[{"lines":["+import glob, re, statistics, sys, torch","+from transformers import AutoTokenizer","+","+run = sys.argv[1]","+tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\", trust_remote_code=True)","+files = sorted(glob.glob(f\"{run}/rollout/[0-9]*.pt\"), key=lambda p: int(re.search(r\"(\\d+)\\.pt$\", p).group(1)))","+print(\"rollout files:\", [f.split('/')[-1] for f in files])","+leak_pat = re.compile(r\"final answer in the prompt|query that returns the correct|provided query|given query|reference query|the prompt (uses|gives|shows)|mentioned in the final answer\", re.I)","+all_resc_mean, all_norm_succ_mean = [], []","+for f in files:","+    d = torch.load(f, weights_only=False)","+    samples = d[\"samples\"]","+    resc, norm_succ, norm_all = [], [], []","+    leaks = 0","+    for s in samples:","+        meta = s.get(\"metadata\") or {}","+        r = s.get(\"reward\")","+        acc = r.get(\"acc\") if isinstance(r, dict) else (r or 0) > 0","+        mask = s.get(\"loss_mask\") or []","+        lps = s.get(\"rollout_log_probs\") or []","+        mlps = [lp for lp, m in zip(lps, mask) if m]","+        if not mlps:","+            continue","+        mean_lp = sum(mlps) / len(mlps)","+        entry = (mean_lp, len(mlps), s[\"response_length\"])","+        if meta.get(\"rescued\"):","+            resc.append(entry)","+            txt = tok.decode(s[\"tokens\"][-s[\"response_length\"]:])","+            if leak_pat.search(txt):","+                leaks += 1","+        else:","+            norm_all.append(entry)","+            if acc:","+                norm_succ.append(entry)","+    def fmt(xs):","+        if not xs: return \"n=0\"","+        return (f\"n={len(xs)} mean_lp={statistics.mean(x[0] for x in xs):.3f} \"","+                f\"pol_tok={statistics.mean(x[1] for x in xs):.0f} resp_len={statistics.mean(x[2] for x in xs):.0f}\")","+    rid = re.search(r\"(\\d+)\\.pt$\", f).group(1)","+    print(f\"step {rid}: rescued[{fmt(resc)} leaks={leaks}] normal_succ[{fmt(norm_succ)}] normal_all[{fmt(norm_all)}]\")","+    all_resc_mean += [x[0] for x in resc]","+    all_norm_succ_mean += [x[0] for x in norm_succ]","+if all_resc_mean:","+    print(f\"OVERALL rescued mean_lp={statistics.mean(all_resc_mean):.3f} (n={len(all_resc_mean)}) \"","+          f\"normal_succ mean_lp={statistics.mean(all_norm_succ_mean):.3f} (n={len(all_norm_succ_mean)})\")"],"newLines":45,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/rescue_stats.py"}]}