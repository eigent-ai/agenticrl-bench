{"files":[{"hunks":[{"lines":["+\"\"\"Quantify stale prefix-cache effect: score fixed token sequences before/after a weight","+update performed WITHOUT flushing the cache, then again after a flush.\"\"\"","+import os, shutil, statistics, sys","+import torch","+from safetensors.torch import load_file, save_file","+","+SCALE = float(sys.argv[1]) if len(sys.argv) > 1 else 1.001","+BASE = \"/models/Qwen3.5-2B\"","+PERT = f\"/tmp/qwen_scaled_{SCALE}\"","+","+","+def build_perturbed():","+    if os.path.exists(PERT):","+        return","+    os.makedirs(PERT)","+    for f in os.listdir(BASE):","+        if f.endswith(\".safetensors\"):","+            continue","+        shutil.copy(os.path.join(BASE, f), os.path.join(PERT, f))","+    sd = load_file(os.path.join(BASE, \"model.safetensors-00001-of-00001.safetensors\"))","+    out = {k: (v.float() * SCALE).to(v.dtype) if v.is_floating_point() else v for k, v in sd.items()}","+    save_file(out, os.path.join(PERT, \"model.safetensors-00001-of-00001.safetensors\"), metadata={\"format\": \"pt\"})","+    print(\"wrote perturbed checkpoint\", PERT, flush=True)","+","+","+def md(a, b):","+    d = [abs(x - y) for x, y in zip(a, b)]","+    return f\"mean={statistics.mean(d):.5f} p90={sorted(d)[int(0.9*len(d))]:.5f} max={max(d):.4f}\"","+","+","+def main():","+    build_perturbed()","+    d = torch.load(\"/app/runs/fixed12/rollout/5.pt\", weights_only=False)","+    seqs = []","+    for s in d[\"samples\"]:","+        if (s.get(\"metadata\") or {}).get(\"rescued\"):","+            continue","+        plen = len(s[\"tokens\"]) - s[\"response_length\"]","+        if 1200 < len(s[\"tokens\"]) < 2200 and s[\"response_length\"] > 400:","+            seqs.append((s[\"tokens\"], plen))","+        if len(seqs) == 4:","+            break","+    print(\"seqs:\", [(len(t), p) for t, p in seqs], flush=True)","+","+    from sglang.srt.entrypoints.engine import Engine","+    from sglang.srt.managers.io_struct import UpdateWeightFromDiskReqInput","+","+    engine = Engine(model_path=BASE, mem_fraction_static=0.75, tp_size=1, trust_remote_code=True, log_level=\"warning\")","+","+    def score(ids, plen):","+        out = engine.generate(","+            input_ids=ids,","+            sampling_params={\"max_new_tokens\": 0, \"temperature\": 0, \"skip_special_tokens\": False},","+            return_logprob=True,","+            logprob_start_len=plen - 1,","+        )","+        items = out[\"meta_info\"][\"input_token_logprobs\"][1:]","+        assert [it[1] for it in items] == ids[plen:], \"token mismatch\"","+        return [float(it[0]) for it in items]","+","+    def update(path, flush):","+        obj = UpdateWeightFromDiskReqInput(model_path=path, flush_cache=flush)","+        res = engine.loop.run_until_complete(engine.tokenizer_manager.update_weights_from_disk(obj, None))","+        print(\"update ->\", path, \"flush=\", flush, \"res:\", res, flush=True)","+","+    for i, (ids, plen) in enumerate(seqs):","+        l_base = score(ids, plen)   # also warms the cache at base weights","+        update(PERT, flush=False)    # weights change, cache entries (base) survive","+        l_stale = score(ids, plen)","+        engine.flush_cache()","+        l_fresh = score(ids, plen)","+        update(BASE, flush=True)     # restore","+        l_back = score(ids, plen)","+        print(f\"seq{i} len={len(ids)} plen={plen}\")","+        print(f\"  stale-vs-fresh (stale cache effect) : {md(l_stale, l_fresh)}\")","+        print(f\"  fresh-vs-base  (true weight change) : {md(l_fresh, l_base)}\")","+        print(f\"  stale-vs-base                       : {md(l_stale, l_base)}\")","+        print(f\"  back-vs-base   (sanity, ~0)         : {md(l_back, l_base)}\", flush=True)","+","+    engine.shutdown()","+    print(\"DONE\")","+","+","+if __name__ == \"__main__\":","+    main()"],"newLines":85,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/stale_cache_probe2.py"}]}