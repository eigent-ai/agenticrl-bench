{"files":[{"hunks":[{"lines":["+import glob, re, statistics, sys, torch","+for run in sys.argv[1:]:","+    vals = []","+    for f in sorted(glob.glob(f\"{run}/rollout/[0-9]*.pt\"), key=lambda p: int(re.search(r\"(\\d+)\\.pt$\", p).group(1))):","+        d = torch.load(f, weights_only=False)","+        accs = []","+        lens = []","+        for s in d[\"samples\"]:","+            if (s.get(\"metadata\") or {}).get(\"rescued\"):","+                continue","+            r = s.get(\"reward\")","+            accs.append(bool(r.get(\"acc\")) if isinstance(r, dict) else (r or 0) > 0)","+            lens.append(s[\"response_length\"])","+        rid = int(re.search(r\"(\\d+)\\.pt$\", f).group(1))","+        vals.append(f\"{rid}:{statistics.mean(accs):.2f}/{statistics.mean(lens):.0f}\")","+    print(run, \" \".join(vals))"],"newLines":16,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/train_reward.py"}]}