{"files":[{"hunks":[{"lines":["+\"\"\"Does SGLang prefill (input) logprob scoring depend on prefix-cache state at fixed weights?","+Score each sequence cold (after flush) and warm (cache populated) and compare.\"\"\"","+import statistics","+import torch","+","+","+def md(a, b):","+    d = [abs(x - y) for x, y in zip(a, b)]","+    return f\"mean={statistics.mean(d):.6f} p90={sorted(d)[int(0.9*len(d))]:.6f} max={max(d):.5f}\"","+","+","+def main():","+    d = torch.load(\"/app/runs/fixed12/rollout/5.pt\", weights_only=False)","+    seqs = []","+    for s in d[\"samples\"]:","+        plen = len(s[\"tokens\"]) - s[\"response_length\"]","+        if 1200 < len(s[\"tokens\"]) < 2200 and s[\"response_length\"] > 400:","+            seqs.append((s[\"tokens\"], plen, bool((s.get(\"metadata\") or {}).get(\"rescued\"))))","+        if len(seqs) == 6:","+            break","+    print(\"seqs:\", [(len(t), p, r) for t, p, r in seqs], flush=True)","+","+    from sglang.srt.entrypoints.engine import Engine","+    engine = Engine(model_path=\"/models/Qwen3.5-2B\", mem_fraction_static=0.75, tp_size=1,","+                    trust_remote_code=True, log_level=\"warning\")","+","+    def score(ids, plen):","+        out = engine.generate(","+            input_ids=ids,","+            sampling_params={\"max_new_tokens\": 0, \"temperature\": 0, \"skip_special_tokens\": False},","+            return_logprob=True,","+            logprob_start_len=plen - 1,","+        )","+        items = out[\"meta_info\"][\"input_token_logprobs\"][1:]","+        assert [it[1] for it in items] == ids[plen:]","+        return [float(it[0]) for it in items]","+","+    for i, (ids, plen, resc) in enumerate(seqs):","+        engine.flush_cache()","+        cold1 = score(ids, plen)","+        warm1 = score(ids, plen)   # cache now contains this sequence/prompt","+        warm2 = score(ids, plen)","+        engine.flush_cache()","+        cold2 = score(ids, plen)","+        print(f\"seq{i} len={len(ids)} plen={plen} rescued_src={resc}\")","+        print(f\"  cold1-vs-cold2 (determinism) : {md(cold1, cold2)}\")","+        print(f\"  warm1-vs-cold1 (cache effect): {md(warm1, cold1)}\")","+        print(f\"  warm2-vs-warm1               : {md(warm2, warm1)}\", flush=True)","+","+    # cross-sequence: score seq B after seq A warmed the shared system prefix","+    if len(seqs) >= 2:","+        (a_ids, a_plen, _), (b_ids, b_plen, _) = seqs[0], seqs[1]","+        engine.flush_cache()","+        b_cold = score(b_ids, b_plen)","+        engine.flush_cache()","+        _ = score(a_ids, a_plen)","+        b_warm = score(b_ids, b_plen)","+        print(f\"cross-seq warm-vs-cold: {md(b_warm, b_cold)}\", flush=True)","+","+    engine.shutdown()","+    print(\"DONE\")","+","+","+if __name__ == \"__main__\":","+    main()"],"newLines":65,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/prefill_cache_probe.py"}]}