{"files":[{"hunks":[{"lines":["+import re, statistics, sys","+","+def series(log):","+    out = {}","+    for line in open(log, errors=\"replace\"):","+        m = re.search(r\"step (\\d+): \\{\", line)","+        if m and \"'train/train_rollout_kl'\" in line:","+            kl = float(re.search(r\"'train/train_rollout_kl': ([0-9.e-]+)\", line).group(1))","+            ad = float(re.search(r\"'train/train_rollout_logprob_abs_diff': ([0-9.e-]+)\", line).group(1))","+            tc = float(re.search(r\"'train/tis_clipfrac': ([0-9.e-]+)\", line).group(1))","+            out[int(m.group(1))] = (kl, ad, tc)","+    return [out[k] for k in sorted(out)]","+","+def slope(ys):","+    n = len(ys); xs = list(range(n))","+    mx, my = statistics.mean(xs), statistics.mean(ys)","+    return sum((x-mx)*(y-my) for x, y in zip(xs, ys)) / sum((x-mx)**2 for x in xs)","+","+for run in sys.argv[1:]:","+    s = series(f\"/app/runs/{run}.log\")","+    if not s: continue","+    for i, name in enumerate([\"kl\", \"absdiff\", \"tis_clip\"]):","+        ys = [v[i] for v in s]","+        print(f\"{run} {name}: n={len(ys)} first5={statistics.mean(ys[:5]):.5f} last5={statistics.mean(ys[-5:]):.5f} \"","+              f\"slope/step={slope(ys):+.6f} mean={statistics.mean(ys):.5f}\")"],"newLines":25,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/kl_slope.py"}]}