{"files":[{"hunks":[{"lines":["         (\"generate\", 7),","         (\"rescue\", 7),","     ]","+","+","+def test_student_scoring_flushes_cache_before_prefill(monkeypatch):","+    # Warm-cache prefill log-probs on this hybrid model are not the fresh-forward values","+    # (see EpisodeRunner.token_logprobs), so scoring must flush first, like Miles' own","+    # prefill log-prob recomputation.","+    calls = []","+","+    async def fake_post(url, payload, **kwargs):","+        calls.append(url)","+        if url.endswith(\"/flush_cache\"):","+            return {}","+        ids = payload[\"input_ids\"]","+        start = payload[\"logprob_start_len\"]","+        items = [(None, ids[start])] + [(-0.1 * t, t) for t in ids[start + 1:]]","+        return {\"meta_info\": {\"input_token_logprobs\": items}}","+","+    monkeypatch.setattr(rescue_episode, \"post\", fake_post)","+    args = SimpleNamespace(","+        generate_tool_specs_path=\"examples.sql_agent.sql_tool.tool_specs\",","+        generate_execute_tool_function_path=\"examples.sql_agent.sql_tool.execute_tool\",","+        generate_max_turns=8,","+        sglang_router_ip=\"127.0.0.1\",","+        sglang_router_port=55,","+    )","+    runner = EpisodeRunner(args, tokenizer=None, sampling_params={})","+    lps = asyncio.run(runner.token_logprobs([10, 11, 12, 13], start=2))","+    assert calls == [\"http://127.0.0.1:55/flush_cache\", \"http://127.0.0.1:55/generate\"]","+    assert lps == pytest.approx([-1.2, -1.3])","+","+","+def test_rescue_processes_groups_sequentially(monkeypatch):","+    # Student scoring flushes the engine cache, which needs an idle engine, so groups","+    # must not be rescued concurrently.","+    rescuer = object.__new__(GroupRescuer)","+    rescuer.args = SimpleNamespace(rescue_max_groups=4)","+    rescuer.log_dir = None","+","+    running = 0","+    max_running = 0","+","+    async def fake_rescue_group(group, rollout_id):","+        nonlocal running, max_running","+        running += 1","+        max_running = max(max_running, running)","+        await asyncio.sleep(0)","+        running -= 1","+        return {\"injected\": False}","+","+    rescuer._rescue_group = fake_rescue_group","+    failed_sample = lambda: Sample(reward={\"acc\": False}, status=Sample.Status.COMPLETED)  # noqa: E731","+    groups = [[failed_sample()] for _ in range(3)]","+    metrics = asyncio.run(rescuer.rescue(groups, rollout_id=0))","+    assert metrics[\"rescue/attempted\"] == 3","+    assert max_running == 1"],"newLines":58,"newStart":179,"oldLines":3,"oldStart":179}],"path":"/root/miles/tests/fast/examples/test_sql_agent_rescue.py"}]}