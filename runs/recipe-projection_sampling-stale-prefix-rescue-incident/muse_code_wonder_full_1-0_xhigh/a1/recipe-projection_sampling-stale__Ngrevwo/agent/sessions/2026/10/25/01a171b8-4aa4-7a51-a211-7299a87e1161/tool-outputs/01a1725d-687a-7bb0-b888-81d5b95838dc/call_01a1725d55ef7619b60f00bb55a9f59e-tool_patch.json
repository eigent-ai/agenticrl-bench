{"files":[{"hunks":[{"lines":["+import statistics, sys, torch","+from transformers import AutoTokenizer","+tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\", trust_remote_code=True)","+for run, step in [(\"/app/runs/plain50\", 40), (\"/app/runs/fixed50\", 40), (\"/app/runs/plain50\", 0), (\"/app/runs/fixed50\", 0)]:","+    d = torch.load(f\"{run}/rollout/{step}.pt\", weights_only=False)","+    for label, filt in [(\"succ\", lambda s: not (s.get(\"metadata\") or {}).get(\"rescued\") and isinstance(s.get(\"reward\"), dict) and s[\"reward\"].get(\"acc\")),","+                        (\"resc\", lambda s: (s.get(\"metadata\") or {}).get(\"rescued\"))]:","+        xs = [s for s in d[\"samples\"] if filt(s)]","+        if not xs: continue","+        tcalls, lens, pols = [], [], []","+        for s in xs:","+            txt = tok.decode(s[\"tokens\"][-s[\"response_length\"]:])","+            tcalls.append(txt.count(\"<tool_call>\"))","+            lens.append(s[\"response_length\"])","+            pols.append(sum(s.get(\"loss_mask\") or []))","+        print(f\"{run} step{step} {label}: n={len(xs)} tool_calls={statistics.mean(tcalls):.1f} resp_len={statistics.mean(lens):.0f} pol_tok={statistics.mean(pols):.0f}\")"],"newLines":16,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/success_style.py"}]}