{"files":[{"hunks":[{"lines":["+import asyncio, glob, re, statistics, sys","+from types import SimpleNamespace","+","+sys.path.insert(0, \"/root/miles\")","+sys.path.insert(0, \"/root/Megatron-LM\")","+","+import torch","+from transformers import AutoTokenizer","+","+from miles.utils.http_utils import init_http_client","+from miles.utils.types import Sample","+from examples.sql_agent.rescue.episode import EpisodeRunner","+from examples.sql_agent.rescue.projection import ProjectionSampler, gold_query","+from examples.sql_agent.rescue.rollout import hinted_prompt","+","+args = SimpleNamespace(","+    rescue_mcmc_steps=4, rescue_init_attempts=3,","+    custom_rm_path=\"examples.sql_agent.sql_tool.reward_func\",","+    rollout_seed=7,","+    generate_tool_specs_path=\"examples.sql_agent.sql_tool.tool_specs\",","+    generate_execute_tool_function_path=\"examples.sql_agent.sql_tool.execute_tool\",","+    generate_tool_call_parser=\"qwen3_coder\", generate_max_turns=8,","+    sglang_router_ip=\"127.0.0.1\", sglang_router_port=30001,","+    rollout_max_response_len=4096, rollout_max_context_len=8192,","+    use_rollout_routing_replay=False, use_rollout_indexer_replay=False,","+    sglang_enable_lora=False, hf_checkpoint=\"/models/Qwen3.5-2B\", chat_template_path=None,","+    rollout_num_gpus=1, rollout_num_gpus_per_engine=1, sglang_server_concurrency=64,","+    eval_num_gpus=0, eval_num_gpus_per_engine=1, use_distributed_post=False,","+)","+","+def first_q(text):","+    m = re.findall(r\"<parameter=query>\\s*(.*?)\\s*</parameter>\", text, re.S)","+    return m[0].strip().lower() if m else \"\"","+","+def describe(tag, eps):","+    rows = []","+    for ep in eps:","+        if ep is None: continue","+        mask = ep.mask()","+        own = [lp for lp, m in zip(ep.student, mask) if m]","+        rows.append(dict(mean=sum(own)/len(own), ssum=sum(own), n=len(own), turns=ep.num_turns,","+                         dump=first_q(ep.text).startswith(\"select * from sqlite_master\"),","+                         total=len(ep.ids)))","+    if not rows:","+        print(tag, \"no passing episodes\"); return","+    print(f\"{tag}: n={len(rows)} student_mean_lp={statistics.mean(r['mean'] for r in rows):.3f} \"","+          f\"student_sum={statistics.mean(r['ssum'] for r in rows):.1f} own_tok={statistics.mean(r['n'] for r in rows):.0f} \"","+          f\"turns={statistics.mean(r['turns'] for r in rows):.2f} dump_first={sum(r['dump'] for r in rows)/len(rows):.2f} total_len={statistics.mean(r['total'] for r in rows):.0f}\")","+","+async def main():","+    init_http_client(args)","+    tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\")","+    runner = EpisodeRunner(args, tok, {\"temperature\": 1.0, \"top_p\": 1.0, \"top_k\": -1, \"max_new_tokens\": 4096,","+                                        \"stop\": None, \"stop_token_ids\": None, \"skip_special_tokens\": False,","+                                        \"no_stop_trim\": True, \"spaces_between_special_tokens\": False})","+    # templates: all-fail groups from an original rollout dump","+    templates = []","+    for p in sorted(glob.glob(\"/app/runs/repro_rescue6/rollout/[0-9]*.pt\"))[:2]:","+        d = torch.load(p, weights_only=False)","+        groups = {}","+        for s in d[\"samples\"]: groups.setdefault(s[\"group_index\"], []).append(s)","+        for g in groups.values():","+            if not any((x[\"reward\"].get(\"acc\") if isinstance(x[\"reward\"], dict) else False) for x in g):","+                t = g[-1]","+                templates.append(Sample(prompt=t[\"prompt\"], label=t[\"label\"], tokens=t[\"tokens\"],","+                                        response_length=t[\"response_length\"], metadata=dict(t[\"metadata\"] or {})))","+        if len(templates) >= 6: break","+    templates = templates[:6]","+    print(f\"{len(templates)} templates\")","+","+    for steps in [0, 4, 24]:","+        args.rescue_mcmc_steps = steps","+        sampler = ProjectionSampler(args, runner)","+        eps = []","+        for t in templates:","+            prompt_ids = t.tokens[: len(t.tokens) - t.response_length]","+            hinted_ids = runner.encode(hinted_prompt(t.prompt, gold_query(t)))","+            res = await sampler.run(t, prompt_ids, hinted_ids)","+            eps.append(res.episode if res else None)","+            if res:","+                print(f\"  steps={steps} pid={(t.metadata or {}).get('pid')} accepted={res.accepted}/{res.proposals} init_tries={res.init_tries}\")","+        describe(f\"MH steps={steps}\", eps)","+","+asyncio.run(main())"],"newLines":84,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/offline_sampler.py"}]}