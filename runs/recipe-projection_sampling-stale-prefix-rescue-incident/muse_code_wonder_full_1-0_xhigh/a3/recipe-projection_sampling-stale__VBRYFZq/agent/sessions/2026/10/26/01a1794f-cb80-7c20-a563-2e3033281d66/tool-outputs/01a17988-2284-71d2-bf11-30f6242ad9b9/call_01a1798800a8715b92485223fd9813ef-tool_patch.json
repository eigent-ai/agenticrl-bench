lens)","+    for ti, (a, b) in enumerate(runs):","+        print(f\"  turn {ti} meanDiff={float(diff[a:b].mean()):.4f} max={float(diff[a:b].max()):.2f}\")","+","+show(5, 181)","+show(5, 187)","+show(0, 18)","+show(3, 110)"],"newLines":46,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/inspect_worst.py"}]}