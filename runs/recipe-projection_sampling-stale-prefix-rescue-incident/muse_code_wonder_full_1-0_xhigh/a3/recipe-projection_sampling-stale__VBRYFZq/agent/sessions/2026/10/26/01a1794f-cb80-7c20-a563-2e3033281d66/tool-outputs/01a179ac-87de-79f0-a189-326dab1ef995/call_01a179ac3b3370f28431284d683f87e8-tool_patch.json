{"files":[{"hunks":[{"lines":["+\"\"\"Rescue sampler: MH acceptance against the student-conditional target, and","+cache-isolated student scoring (the in-place weight-update recipe never flushes","+the engine cache, so rescue must not score off restored hybrid state).\"\"\"","+","+from __future__ import annotations","+","+import math","+from types import SimpleNamespace","+","+import pytest","+","+from examples.sql_agent.rescue import episode as episode_mod","+from examples.sql_agent.rescue.episode import Episode","+from examples.sql_agent.rescue.projection import ProjectionSampler, mh_log_accept","+from miles.utils.types import Sample","+","+","+def _ep(ids, turns, logprobs, student):","+    return Episode(ids=list(ids), logprobs=list(logprobs), turns=list(turns),","+                   student=list(student), text=\"x\", finished=True)","+","+","+# Turn structure shared by both episodes: policy tokens [0,2) and [3,5), token 2 is a tool response.","+CUR = _ep([10, 11, 99, 12, 13], [(0, 2), (3, 5)],","+          logprobs=[-0.2, -0.2, 0.0, -5.0, -5.0], student=[-0.1, -0.1, -3.0, -1.0, -1.0])","+# Same first turn; second turn is one policy token at [3,4) (no trailing tool response).","+CAND = _ep([10, 11, 99, 14], [(0, 2), (3, 4)],","+           logprobs=[-0.2, -0.2, 0.0, -0.01], student=[-0.1, -0.1, -3.0, -0.9])","+","+","+def test_mh_log_accept_includes_student_sum_and_hinted_proposal_ratio():","+    # Student sums over policy tokens: cand -1.1, cur -2.2. Hinted suffix sums (cut at turn 1):","+    # cand -0.01, cur -10.0. Turn counts are equal (2 and 2), so the cut-choice ratio is 1.","+    expected = (-1.1 - -2.2) - (-0.01 - -10.0)","+    assert mh_log_accept(CUR, CAND, 1) == pytest.approx(expected)","+    # The candidate has the higher *mean* student log-prob (greedy length-normalised","+    # hill-climbing accepts it), but the MH ratio is tiny: the hinted policy would","+    # almost never propose the current suffix back.","+    assert mh_log_accept(CUR, CAND, 1) < math.log(0.001)","+","+","+class FakeRunner:","+    def __init__(self, episodes):","+        self._episodes = list(episodes)","+","+    async def continue_episode(self, prompt_ids, prefix):","+        return self._episodes.pop(0)","+","+    async def token_logprobs(self, ids, start):","+        raise AssertionError(\"student scores are prefilled on the fake episodes\")","+","+","+def _sampler(episodes, steps=1):","+    args = SimpleNamespace(","+        rescue_mcmc_steps=steps,","+        rescue_init_attempts=1,","+        custom_rm_path=\"examples.sql_agent.sql_tool.reward_func\",","+        rollout_seed=1,","+    )","+    sampler = ProjectionSampler(args, FakeRunner(episodes))","+","+    async def always_pass(*_a):","+        return {\"acc\": True}","+","+    sampler.reward_fn = always_pass","+","+    async def no_rescore(prompt_ids, ep):","+        return None","+","+    sampler.score_student = no_rescore","+    return sampler","+","+","+async def test_sampler_rejects_mean_improving_candidate_with_tiny_mh_probability():","+    sampler = _sampler([CUR, CAND])","+    template = Sample(prompt=\"p\", label='{\"db_id\": \"d\", \"query\": \"SELECT 1\"}', metadata={})","+    result = await sampler.run(template, prompt_ids=[1], hinted_ids=[2])","+    assert result is not None","+    assert result.episode is CUR","+    assert result.accepted == 0 and result.passed == 1","+","+","+async def test_sampler_accepts_candidate_when_mh_ratio_is_one():","+    cand = _ep([10, 11, 99, 14], [(0, 2), (3, 4)],","+               logprobs=[-0.2, -0.2, 0.0, -5.0], student=[-0.1, -0.1, -3.0, -0.1])","+    # log alpha = (-0.3 - -2.2) - (-5.0 - -10.0) = -3.1? no: hinted suffix cur is -10, cand -5.","+    # Make acceptance certain instead: student much better, hinted suffix equal to cur's rate.","+    cand = _ep([10, 11, 99, 14, 15], [(0, 2), (3, 5)],","+               logprobs=[-0.2, -0.2, 0.0, -5.0, -5.0], student=[-0.1, -0.1, -3.0, -0.1, -0.1])","+    sampler = _sampler([CUR, cand])","+    template = Sample(prompt=\"p\", label='{\"db_id\": \"d\", \"query\": \"SELECT 1\"}', metadata={})","+    result = await sampler.run(template, prompt_ids=[1], hinted_ids=[2])","+    assert result is not None","+    assert result.episode is cand","+    assert result.accepted == 1","+","+","+def _runner(monkeypatch, posts):","+    async def fake_post(url, payload, headers=None):","+        posts.append((url, payload))","+        return {","+            \"text\": \"done\",","+            \"meta_info\": {","+                \"output_token_logprobs\": [(-0.1, 42)],","+                \"input_token_logprobs\": [(None, 2), (-0.3, 3), (-0.4, 4)],","+                \"finish_reason\": {\"type\": \"stop\"},","+                \"cached_tokens\": 0,","+                \"prompt_tokens\": 4,","+            },","+        }","+","+    monkeypatch.setattr(episode_mod, \"post\", fake_post)","+    args = SimpleNamespace(","+        generate_tool_specs_path=\"examples.sql_agent.sql_tool.tool_specs\",","+        generate_execute_tool_function_path=\"examples.sql_agent.sql_tool.execute_tool\",","+        generate_tool_call_parser=\"qwen3_coder\",","+        generate_max_turns=2,","+        sglang_router_ip=\"127.0.0.1\",","+        sglang_router_port=30001,","+        rollout_max_response_len=16,","+        rollout_max_context_len=8192,","+        use_rollout_routing_replay=False,","+        use_rollout_indexer_replay=False,","+        sglang_enable_lora=False,","+    )","+    tokenizer = SimpleNamespace(encode=lambda t, add_special_tokens=False: [1], decode=lambda ids: \"x\")","+    return episode_mod.EpisodeRunner(args, tokenizer, {\"temperature\": 1.0, \"max_new_tokens\": 8})","+","+","+async def test_student_scoring_requests_are_cache_isolated(monkeypatch):","+    posts = []","+    runner = _runner(monkeypatch, posts)","+    await runner.token_logprobs([1, 2, 3, 4], 2)","+    await runner.token_logprobs([1, 2, 3, 4], 2)","+    keys = [p[1].get(\"extra_key\") for p in posts]","+    assert all(keys), \"scoring payloads must carry an extra_key\"","+    assert keys[0] != keys[1], \"each scoring request must use its own cache namespace\"","+","+","+async def test_episode_generation_shares_one_namespace_per_episode(monkeypatch):","+    posts = []","+    runner = _runner(monkeypatch, posts)","+    await runner.continue_episode([1, 2], Episode())","+    first_keys = {p[1].get(\"extra_key\") for p in posts}","+    posts.clear()","+    await runner.continue_episode([1, 2], Episode())","+    second_keys = {p[1].get(\"extra_key\") for p in posts}","+    assert len(first_keys) == 1 and None not in first_keys","+    assert len(second_keys) == 1 and first_keys != second_keys"],"newLines":149,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/root/miles/tests/fast/examples/sql_agent/test_rescue.py"}]}