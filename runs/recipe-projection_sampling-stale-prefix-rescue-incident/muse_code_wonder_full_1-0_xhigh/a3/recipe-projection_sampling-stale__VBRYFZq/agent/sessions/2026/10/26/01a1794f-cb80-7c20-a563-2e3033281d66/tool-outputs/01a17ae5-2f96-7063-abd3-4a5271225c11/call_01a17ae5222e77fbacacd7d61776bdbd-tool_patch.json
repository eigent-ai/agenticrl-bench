{"files":[{"hunks":[{"lines":[" )"," from miles.utils.http_utils import post"," from miles.utils.misc import load_function","+from miles.utils.types import Sample","+","+","+def episode_from_sample(sample: Sample) -> Episode:","+    \"\"\"Rebuild the episode (turn boundaries from the loss mask) of an already-generated sample.\"\"\"","+    turns: list[tuple[int, int]] = []","+    cur = None","+    for i, m in enumerate(sample.loss_mask or []):","+        if m == 1 and cur is None:","+            cur = i","+        elif m == 0 and cur is not None:","+            turns.append((cur, i))","+            cur = None","+    if cur is not None:","+        turns.append((cur, len(sample.loss_mask)))","+    return Episode(","+        ids=list(sample.tokens[-sample.response_length:]) if sample.response_length else [],","+        logprobs=list(sample.rollout_log_probs or []),","+        turns=turns,","+        text=sample.response,","+        finished=sample.status == Sample.Status.COMPLETED,","+        truncated=sample.status == Sample.Status.TRUNCATED,","+    )"," "," "," @dataclass"],"newLines":29,"newStart":18,"oldLines":6,"oldStart":18}],"path":"/root/miles/examples/sql_agent/rescue/episode.py"}]}