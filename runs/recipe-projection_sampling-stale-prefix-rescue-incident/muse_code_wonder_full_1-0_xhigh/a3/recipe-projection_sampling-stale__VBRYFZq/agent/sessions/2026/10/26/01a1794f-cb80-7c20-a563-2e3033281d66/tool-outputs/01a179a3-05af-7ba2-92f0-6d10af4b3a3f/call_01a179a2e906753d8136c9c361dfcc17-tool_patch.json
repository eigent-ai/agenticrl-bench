{"files":[{"hunks":[{"lines":["+import torch, glob, re, sys","+run = \"/app/runs/exp_flush6\"","+calls = {}","+for p in glob.glob(f\"{run}/dump/policy_loss_debug/*.pt\"):","+    n = int(re.search(r\"call_(\\d+)\", p).group(1))","+    calls[n] = torch.load(p, weights_only=False)[\"samples\"][0]","+","+def turn_runs(mask):","+    runs = []; cur = None","+    for i, m in enumerate(mask):","+        if m == 1 and cur is None: cur = i","+        if m == 0 and cur is not None: runs.append((cur, i)); cur = None","+    if cur is not None: runs.append((cur, len(mask)))","+    return runs","+","+def show_group(step, idxs):","+    d = torch.load(f\"{run}/dump/rollout_data/{step}.pt\", weights_only=False)","+    samples = d[\"samples\"]","+    from transformers import AutoTokenizer","+    tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\")","+    seqs = {}","+    for idx in idxs:","+        pos = [i for i, s in enumerate(samples) if s[\"index\"] == idx][0]","+        s = samples[pos]; c = calls[step*32+pos]","+        seqs[idx] = s[\"tokens\"]","+        runs = turn_runs(s[\"loss_mask\"])","+        diffs = [round(float(c[\"train_rollout_abs_diff\"][a:b].mean()), 3) for a, b in runs]","+        print(f\"step{step} idx{idx} prompt_len={len(s['tokens'])-s['response_length']} resp={s['response_length']} turn_diffs={diffs}\")","+    # pairwise common prefix lengths (absolute tokens)","+    ks = list(seqs)","+    for i in range(len(ks)):","+        for j in range(i+1, len(ks)):","+            a, b = seqs[ks[i]], seqs[ks[j]]","+            cp = 0","+            for x, y in zip(a, b):","+                if x != y: break","+                cp += 1","+            print(f\" common prefix {ks[i]} vs {ks[j]}: {cp} tokens; divergence ctx: {tok.decode(a[max(0,cp-40):cp+15])!r} ||| {tok.decode(b[max(0,cp-40):cp+15])!r}\")","+","+show_group(4, [140, 141, 142, 143])","+show_group(5, [165, 166, 170, 171])"],"newLines":41,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/inspect_group.py"}]}