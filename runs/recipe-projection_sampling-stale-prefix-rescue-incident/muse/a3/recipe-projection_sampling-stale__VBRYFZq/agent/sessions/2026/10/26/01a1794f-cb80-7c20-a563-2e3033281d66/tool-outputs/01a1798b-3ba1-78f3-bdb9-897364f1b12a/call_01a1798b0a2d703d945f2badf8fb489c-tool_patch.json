{"files":[{"hunks":[{"lines":["+import torch, requests, glob, re, statistics","+","+BASE = \"http://127.0.0.1:30000\"","+run = \"/app/runs/debug_rescue6\"","+","+def flush():","+    r = requests.post(f\"{BASE}/flush_cache\", json={})","+    assert r.status_code == 200, r.text","+","+def score(ids, start):","+    payload = {\"input_ids\": ids, \"sampling_params\": {\"max_new_tokens\": 0, \"temperature\": 0, \"skip_special_tokens\": False},","+               \"return_logprob\": True, \"logprob_start_len\": start - 1}","+    out = requests.post(f\"{BASE}/generate\", json=payload).json()","+    items = out[\"meta_info\"][\"input_token_logprobs\"][1:]","+    assert [it[1] for it in items] == ids[start:], \"misaligned\"","+    return [float(it[0]) for it in items]","+","+def gen1(ids):","+    payload = {\"input_ids\": ids, \"sampling_params\": {\"max_new_tokens\": 1, \"temperature\": 0, \"skip_special_tokens\": False},","+               \"return_logprob\": True}","+    out = requests.post(f\"{BASE}/generate\", json=payload).json()","+    return out","+","+def md(a, b):","+    d = [abs(x - y) for x, y in zip(a, b)]","+    return f\"mean={statistics.mean(d):.4f} max={max(d):.2f}\"","+","+# load trainer/rollout logprobs for step0 idx18","+calls = {}","+for p in glob.glob(f\"{run}/dump/policy_loss_debug/*.pt\"):","+    n = int(re.search(r\"call_(\\d+)\", p).group(1))","+    calls[n] = torch.load(p, weights_only=False)[\"samples\"][0]","+d = torch.load(f\"{run}/dump/rollout_data/0.pt\", weights_only=False)","+samples = d[\"samples\"]","+by_idx = {s[\"index\"]: (pos, s) for pos, s in enumerate(samples)}","+pos, s = by_idx[18]","+c = calls[pos]","+prompt_len = len(s[\"tokens\"]) - s[\"response_length\"]","+# turn spans in response coords from loss_mask runs","+runs = []","+cur = None","+for i, m in enumerate(s[\"loss_mask\"]):","+    if m == 1 and cur is None: cur = i","+    if m == 0 and cur is not None: runs.append((cur, i)); cur = None","+if cur is not None: runs.append((cur, len(s[\"loss_mask\"])))","+print(\"prompt_len\", prompt_len, \"turns resp spans\", runs)","+","+for turn in [3, 1]:","+    a, b = runs[turn]","+    start = prompt_len + a","+    end = prompt_len + b","+    ids = s[\"tokens\"][:end]","+    trainer = [float(x) for x in c[\"train_log_probs\"][a:b]]","+    rollout = [float(x) for x in c[\"rollout_log_probs\"][a:b]]","+    print(f\"\\n--- turn {turn} abs [{start},{end}) trainer-vs-rollout saved: {md(trainer, rollout)}\")","+    flush(); cold = score(ids, start)","+    print(f\" cold        vs trainer {md(cold, trainer)} | vs rollout {md(cold, rollout)}\")","+    # warm: populate with prefix generation (as prior turns would)","+    gen1(s[\"tokens\"][:start - 1])","+    warm = score(ids, start)","+    print(f\" warm-prefix vs trainer {md(warm, trainer)} | vs rollout {md(warm, rollout)}\")","+    # sibling branches: same group samples","+    flush()","+    for sib_idx in [16, 17, 19]:","+        _, sib = by_idx[sib_idx]","+        gen1(sib[\"tokens\"][:-1])","+    gen1(s[\"tokens\"][:start - 1])","+    sibw = score(ids, start)","+    print(f\" siblings    vs trainer {md(sibw, trainer)} | vs rollout {md(sibw, rollout)}\")","+    # many other sequences for cache pressure, then prefix, then score","+    flush()","+    for _, s2 in list(by_idx.values())[:28]:","+        gen1(s2[\"tokens\"][:-1])","+    gen1(s[\"tokens\"][:start - 1])","+    press = score(ids, start)","+    print(f\" pressure    vs trainer {md(press, trainer)} | vs rollout {md(press, rollout)}\")"],"newLines":76,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_worst.py"}]}