{"files":[{"hunks":[{"lines":["+import asyncio, glob, re, sys","+from types import SimpleNamespace","+","+sys.path.insert(0, \"/root/miles\")","+import torch","+from transformers import AutoTokenizer","+from miles.utils.http_utils import init_http_client","+from miles.utils.types import Sample","+from examples.sql_agent.rescue.episode import Episode, EpisodeRunner","+from examples.sql_agent.rescue.projection import ProjectionSampler, gold_query, mh_log_accept, _student_sum, _hinted_suffix_sum","+from examples.sql_agent.rescue.rollout import hinted_prompt","+","+args = SimpleNamespace(","+    rescue_mcmc_steps=4, rescue_init_attempts=3,","+    custom_rm_path=\"examples.sql_agent.sql_tool.reward_func\", rollout_seed=7,","+    generate_tool_specs_path=\"examples.sql_agent.sql_tool.tool_specs\",","+    generate_execute_tool_function_path=\"examples.sql_agent.sql_tool.execute_tool\",","+    generate_tool_call_parser=\"qwen3_coder\", generate_max_turns=8,","+    sglang_router_ip=\"127.0.0.1\", sglang_router_port=30001,","+    rollout_max_response_len=4096, rollout_max_context_len=8192,","+    use_rollout_routing_replay=False, use_rollout_indexer_replay=False, sglang_enable_lora=False,","+    hf_checkpoint=\"/models/Qwen3.5-2B\", chat_template_path=None,","+    rollout_num_gpus=1, rollout_num_gpus_per_engine=1, sglang_server_concurrency=64,","+    eval_num_gpus=0, eval_num_gpus_per_engine=1, use_distributed_post=False,","+)","+","+def smean(ep):","+    o = [lp for lp, m in zip(ep.student, ep.mask()) if m]","+    return sum(o)/len(o)","+","+async def main():","+    init_http_client(args)","+    tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\")","+    runner = EpisodeRunner(args, tok, {\"temperature\": 1.0, \"top_p\": 1.0, \"top_k\": -1, \"max_new_tokens\": 4096,","+                                        \"stop\": None, \"stop_token_ids\": None, \"skip_special_tokens\": False,","+                                        \"no_stop_trim\": True, \"spaces_between_special_tokens\": False})","+    sampler = ProjectionSampler(args, runner)","+    # one template","+    d = torch.load(\"/app/runs/base50/rollout/0.pt\", weights_only=False)","+    groups = {}","+    for s in d[\"samples\"]: groups.setdefault(s[\"group_index\"], []).append(s)","+    t = None","+    for g in groups.values():","+        if not any((x[\"reward\"].get(\"acc\") if isinstance(x[\"reward\"], dict) else False) for x in g):","+            t = g[-1]; break","+    template = Sample(prompt=t[\"prompt\"], label=t[\"label\"], tokens=t[\"tokens\"],","+                      response_length=t[\"response_length\"], metadata=dict(t[\"metadata\"] or {}))","+    prompt_ids = template.tokens[: len(template.tokens) - template.response_length]","+    hinted_ids = runner.encode(hinted_prompt(template.prompt, gold_query(template)))","+    print(\"QUESTION:\", template.prompt[-400:])","+    print(\"GOLD:\", gold_query(template))","+","+    cur = None","+    for tries in range(1, 4):","+        ep = await runner.continue_episode(hinted_ids, Episode())","+        print(f\"init try {tries}: finished={ep.finished} turns={ep.num_turns} passes={await sampler.passes(template, ep)}\")","+        if await sampler.passes(template, ep):","+            cur = ep; break","+    await sampler.score_student(prompt_ids, cur)","+    print(f\"INIT: sum={_student_sum(cur):.1f} mean={smean(cur):.3f} turns={cur.num_turns} len={len(cur.ids)}\")","+    print(\"INIT TEXT:\\n\", cur.text[:1800])","+    for step in range(8):","+        j = sampler.rng.randrange(cur.num_turns)","+        cand = await runner.continue_episode(hinted_ids, cur.prefix(j))","+        p = await sampler.passes(template, cand)","+        if not p:","+            print(f\"step {step} j={j}: cand FAILED (turns={cand.num_turns} finished={cand.finished})\")","+            continue","+        await sampler.score_student(prompt_ids, cand)","+        la = mh_log_accept(cur, cand, j)","+        print(f\"step {step} j={j}: cand sum={_student_sum(cand):.1f} mean={smean(cand):.3f} turns={cand.num_turns} \"","+              f\"dS={_student_sum(cand)-_student_sum(cur):+.1f} dH={_hinted_suffix_sum(cand,j)-_hinted_suffix_sum(cur,j):+.1f} loga={la:+.2f} accept={la>=0}\")","+        if la >= 0: cur = cand","+    print(\"\\nFINAL TEXT:\\n\", cur.text[:2500])","+","+asyncio.run(main())"],"newLines":76,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/watch_chain.py"}]}