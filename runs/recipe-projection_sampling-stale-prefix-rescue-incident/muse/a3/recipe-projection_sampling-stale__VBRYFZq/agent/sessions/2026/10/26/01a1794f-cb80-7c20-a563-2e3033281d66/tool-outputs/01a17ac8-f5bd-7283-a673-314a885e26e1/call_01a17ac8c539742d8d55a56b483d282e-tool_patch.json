{"files":[{"hunks":[{"lines":["+import asyncio, glob, re, statistics, sys","+from types import SimpleNamespace","+","+sys.path.insert(0, \"/root/miles\")","+import torch","+from transformers import AutoTokenizer","+from miles.utils.http_utils import init_http_client","+from miles.utils.types import Sample","+from examples.sql_agent.rescue.episode import Episode, EpisodeRunner","+from examples.sql_agent.rescue.projection import ProjectionSampler, gold_query","+from examples.sql_agent.rescue.rollout import hinted_prompt","+","+args = SimpleNamespace(","+    rescue_mcmc_steps=4, rescue_init_attempts=3,","+    custom_rm_path=\"examples.sql_agent.sql_tool.reward_func\", rollout_seed=7,","+    generate_tool_specs_path=\"examples.sql_agent.sql_tool.tool_specs\",","+    generate_execute_tool_function_path=\"examples.sql_agent.sql_tool.execute_tool\",","+    generate_tool_call_parser=\"qwen3_coder\", generate_max_turns=8,","+    sglang_router_ip=\"127.0.0.1\", sglang_router_port=30001,","+    rollout_max_response_len=4096, rollout_max_context_len=8192,","+    use_rollout_routing_replay=False, use_rollout_indexer_replay=False, sglang_enable_lora=False,","+    hf_checkpoint=\"/models/Qwen3.5-2B\", chat_template_path=None,","+    rollout_num_gpus=1, rollout_num_gpus_per_engine=1, sglang_server_concurrency=64,","+    eval_num_gpus=0, eval_num_gpus_per_engine=1, use_distributed_post=False,","+)","+","+def first_q(text):","+    m = re.findall(r\"<parameter=query>\\s*(.*?)\\s*</parameter>\", text, re.S)","+    return m[0].strip().lower() if m else \"\"","+","+def own(ep): return [lp for lp, m in zip(ep.student, ep.mask()) if m]","+def smean(ep):","+    o = own(ep); return sum(o)/len(o)","+","+def sample_to_episode(s):","+    ids = s[\"tokens\"][-s[\"response_length\"]:]","+    lm = s[\"loss_mask\"]","+    turns = []; cur = None","+    for i, m in enumerate(lm):","+        if m == 1 and cur is None: cur = i","+        if m == 0 and cur is not None: turns.append((cur, i)); cur = None","+    if cur is not None: turns.append((cur, len(lm)))","+    return Episode(ids=list(ids), logprobs=list(s[\"rollout_log_probs\"]), turns=turns, text=s[\"response\"],","+                   finished=(s[\"status\"] == \"completed\"))","+","+async def anchored(sampler, template, prompt_ids, hinted_ids, failed_eps):","+    # start from each failed student episode: cut at random turn, regenerate suffix hinted,","+    # keep first passing candidate; then greedy-mean moves as in repo sampler.","+    cur = None","+    for base in failed_eps:","+        for _ in range(4):","+            if base.num_turns == 0: break","+            j = sampler.rng.randrange(base.num_turns)","+            cand = await sampler.runner.continue_episode(hinted_ids, base.prefix(j))","+            if await sampler.passes(template, cand):","+                cur = cand; break","+        if cur is not None: break","+    if cur is None:","+        # fall back to hinted init like repo sampler","+        for _ in range(sampler.init_attempts):","+            ep = await sampler.runner.continue_episode(hinted_ids, Episode())","+            if await sampler.passes(template, ep):","+                cur = ep; break","+    if cur is None: return None","+    await sampler.score_student(prompt_ids, cur)","+    for _ in range(sampler.steps):","+        j = sampler.rng.randrange(cur.num_turns)","+        cand = await sampler.runner.continue_episode(hinted_ids, cur.prefix(j))","+        if not await sampler.passes(template, cand): continue","+        await sampler.score_student(prompt_ids, cand)","+        if smean(cand) >= smean(cur): cur = cand","+    return cur","+","+def describe(tag, eps):","+    rows = [e for e in eps if e is not None]","+    if not rows: print(tag, \"none\"); return","+    print(f\"{tag:14s} n={len(rows)} mean_lp={statistics.mean(smean(e) for e in rows):.3f} \"","+          f\"own_tok={statistics.mean(len(own(e)) for e in rows):.0f} turns={statistics.mean(e.num_turns for e in rows):.2f} \"","+          f\"dump={sum(first_q(e.text).startswith('select * from sqlite_master') for e in rows)/len(rows):.2f} total_len={statistics.mean(len(e.ids) for e in rows):.0f}\")","+","+async def main():","+    init_http_client(args)","+    tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\")","+    runner = EpisodeRunner(args, tok, {\"temperature\": 1.0, \"top_p\": 1.0, \"top_k\": -1, \"max_new_tokens\": 4096,","+                                        \"stop\": None, \"stop_token_ids\": None, \"skip_special_tokens\": False,","+                                        \"no_stop_trim\": True, \"spaces_between_special_tokens\": False})","+    groups = []","+    for p in sorted(glob.glob(\"/app/runs/base50/rollout/[0-9]*.pt\"), key=lambda x: int(re.search(r\"(\\d+)\\.pt\", x).group(1))):","+        d = torch.load(p, weights_only=False)","+        gmap = {}","+        for s in d[\"samples\"]: gmap.setdefault(s[\"group_index\"], []).append(s)","+        for g in gmap.values():","+            if not any((x[\"reward\"].get(\"acc\") if isinstance(x[\"reward\"], dict) else False) for x in g):","+                groups.append(g)","+        if len(groups) >= 8: break","+    groups = groups[:8]","+    print(f\"{len(groups)} groups\")","+    anch, repo = [], []","+    for g in groups:","+        t = g[-1]","+        template = Sample(prompt=t[\"prompt\"], label=t[\"label\"], tokens=t[\"tokens\"],","+                          response_length=t[\"response_length\"], metadata=dict(t[\"metadata\"] or {}))","+        prompt_ids = template.tokens[: len(template.tokens) - template.response_length]","+        hinted_ids = runner.encode(hinted_prompt(template.prompt, gold_query(template)))","+        failed_eps = [sample_to_episode(x) for x in g]","+        sampler = ProjectionSampler(args, runner)","+        anch.append(await anchored(sampler, template, prompt_ids, hinted_ids, failed_eps))","+        sampler2 = ProjectionSampler(args, runner)","+        res = await sampler2.run(template, prompt_ids, hinted_ids)","+        repo.append(res.episode if res else None)","+        print(f\"pid={(template.metadata or {}).get('pid')} anchored_ok={anch[-1] is not None} repo_ok={res is not None}\")","+    describe(\"anchored\", anch)","+    describe(\"repo sampler\", repo)","+","+asyncio.run(main())"],"newLines":115,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/offline_anchor.py"}]}