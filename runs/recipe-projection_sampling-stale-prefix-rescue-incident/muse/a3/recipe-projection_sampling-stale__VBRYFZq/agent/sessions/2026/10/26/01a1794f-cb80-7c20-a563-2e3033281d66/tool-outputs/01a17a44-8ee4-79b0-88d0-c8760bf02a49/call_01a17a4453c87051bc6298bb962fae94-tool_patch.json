{"files":[{"hunks":[{"lines":["+import asyncio, glob, re, statistics, sys","+from types import SimpleNamespace","+","+sys.path.insert(0, \"/root/miles\")","+","+import torch","+from transformers import AutoTokenizer","+","+from miles.utils.http_utils import init_http_client","+from miles.utils.types import Sample","+from examples.sql_agent.rescue.episode import Episode, EpisodeRunner","+from examples.sql_agent.rescue.projection import ProjectionSampler, gold_query","+from examples.sql_agent.rescue.rollout import hinted_prompt","+","+args = SimpleNamespace(","+    rescue_mcmc_steps=4, rescue_init_attempts=3,","+    custom_rm_path=\"examples.sql_agent.sql_tool.reward_func\",","+    rollout_seed=7,","+    generate_tool_specs_path=\"examples.sql_agent.sql_tool.tool_specs\",","+    generate_execute_tool_function_path=\"examples.sql_agent.sql_tool.execute_tool\",","+    generate_tool_call_parser=\"qwen3_coder\", generate_max_turns=8,","+    sglang_router_ip=\"127.0.0.1\", sglang_router_port=30001,","+    rollout_max_response_len=4096, rollout_max_context_len=8192,","+    use_rollout_routing_replay=False, use_rollout_indexer_replay=False,","+    sglang_enable_lora=False, hf_checkpoint=\"/models/Qwen3.5-2B\", chat_template_path=None,","+    rollout_num_gpus=1, rollout_num_gpus_per_engine=1, sglang_server_concurrency=64,","+    eval_num_gpus=0, eval_num_gpus_per_engine=1, use_distributed_post=False,","+)","+","+def first_q(text):","+    m = re.findall(r\"<parameter=query>\\s*(.*?)\\s*</parameter>\", text, re.S)","+    return m[0].strip().lower() if m else \"\"","+","+def mean_lp(ep):","+    mask = ep.mask()","+    own = [lp for lp, m in zip(ep.student, mask) if m]","+    return sum(own) / len(own)","+","+def describe(tag, eps):","+    rows = [ep for ep in eps if ep is not None]","+    if not rows:","+        print(tag, \"none\"); return","+    print(f\"{tag}: n={len(rows)} student_mean_lp={statistics.mean(mean_lp(e) for e in rows):.3f} \"","+          f\"turns={statistics.mean(e.num_turns for e in rows):.2f} \"","+          f\"dump_first={sum(first_q(e.text).startswith('select * from sqlite_master') for e in rows)/len(rows):.2f} \"","+          f\"total_len={statistics.mean(len(e.ids) for e in rows):.0f}\")","+","+async def run_greedy(sampler, template, prompt_ids, hinted_ids):","+    cur = None","+    for _ in range(sampler.init_attempts):","+        ep = await sampler.runner.continue_episode(hinted_ids, Episode())","+        if await sampler.passes(template, ep):","+            cur = ep; break","+    if cur is None: return None","+    await sampler.score_student(prompt_ids, cur)","+    init_ep = cur","+    for _ in range(sampler.steps):","+        import random","+        j = sampler.rng.randrange(cur.num_turns)","+        cand = await sampler.runner.continue_episode(hinted_ids, cur.prefix(j))","+        if not await sampler.passes(template, cand): continue","+        await sampler.score_student(prompt_ids, cand)","+        if mean_lp(cand) >= mean_lp(cur):","+            cur = cand","+    return cur, init_ep","+","+async def main():","+    init_http_client(args)","+    tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\")","+    runner = EpisodeRunner(args, tok, {\"temperature\": 1.0, \"top_p\": 1.0, \"top_k\": -1, \"max_new_tokens\": 4096,","+                                        \"stop\": None, \"stop_token_ids\": None, \"skip_special_tokens\": False,","+                                        \"no_stop_trim\": True, \"spaces_between_special_tokens\": False})","+    templates = []","+    for p in sorted(glob.glob(\"/app/runs/repro_rescue6/rollout/[0-9]*.pt\"), key=lambda x: int(re.search(r\"(\\d+)\\.pt\", x).group(1))):","+        d = torch.load(p, weights_only=False)","+        groups = {}","+        for s in d[\"samples\"]: groups.setdefault(s[\"group_index\"], []).append(s)","+        for g in groups.values():","+            if not any((x[\"reward\"].get(\"acc\") if isinstance(x[\"reward\"], dict) else False) for x in g):","+                t = g[-1]","+                templates.append(Sample(prompt=t[\"prompt\"], label=t[\"label\"], tokens=t[\"tokens\"],","+                                        response_length=t[\"response_length\"], metadata=dict(t[\"metadata\"] or {})))","+        if len(templates) >= 8: break","+    templates = templates[:8]","+    print(f\"{len(templates)} templates\")","+","+    inits, greedys, mhs = [], [], []","+    for t in templates:","+        prompt_ids = t.tokens[: len(t.tokens) - t.response_length]","+        hinted_ids = runner.encode(hinted_prompt(t.prompt, gold_query(t)))","+        sampler = ProjectionSampler(args, runner)","+        out = await run_greedy(sampler, t, prompt_ids, hinted_ids)","+        if out:","+            g, i0 = out; greedys.append(g); inits.append(i0)","+        sampler2 = ProjectionSampler(args, runner)","+        res = await sampler2.run(t, prompt_ids, hinted_ids)","+        mhs.append(res.episode if res else None)","+        print(f\"pid={(t.metadata or {}).get('pid')} greedy_ok={out is not None} mh_ok={res is not None} mh_acc={res.accepted if res else '-'}\")","+    describe(\"init (hinted, first passing)\", inits)","+    describe(\"greedy-mean 4 steps\", greedys)","+    describe(\"MH 4 steps\", mhs)","+","+asyncio.run(main())"],"newLines":103,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/offline_greedy.py"}]}