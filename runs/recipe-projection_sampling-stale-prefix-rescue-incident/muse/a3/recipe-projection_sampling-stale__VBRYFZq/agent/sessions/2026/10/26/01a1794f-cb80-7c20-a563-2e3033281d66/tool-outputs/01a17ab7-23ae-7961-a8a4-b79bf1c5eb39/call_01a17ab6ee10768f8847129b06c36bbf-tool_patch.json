{"files":[{"hunks":[{"lines":["+import asyncio, glob, math, re, statistics, sys","+from types import SimpleNamespace","+","+sys.path.insert(0, \"/root/miles\")","+import torch","+from transformers import AutoTokenizer","+from miles.utils.http_utils import init_http_client","+from miles.utils.types import Sample","+from examples.sql_agent.rescue.episode import Episode, EpisodeRunner","+from examples.sql_agent.rescue.projection import ProjectionSampler, gold_query","+from examples.sql_agent.rescue.rollout import hinted_prompt","+","+args = SimpleNamespace(","+    rescue_mcmc_steps=4, rescue_init_attempts=3,","+    custom_rm_path=\"examples.sql_agent.sql_tool.reward_func\", rollout_seed=7,","+    generate_tool_specs_path=\"examples.sql_agent.sql_tool.tool_specs\",","+    generate_execute_tool_function_path=\"examples.sql_agent.sql_tool.execute_tool\",","+    generate_tool_call_parser=\"qwen3_coder\", generate_max_turns=8,","+    sglang_router_ip=\"127.0.0.1\", sglang_router_port=30001,","+    rollout_max_response_len=4096, rollout_max_context_len=8192,","+    use_rollout_routing_replay=False, use_rollout_indexer_replay=False, sglang_enable_lora=False,","+    hf_checkpoint=\"/models/Qwen3.5-2B\", chat_template_path=None,","+    rollout_num_gpus=1, rollout_num_gpus_per_engine=1, sglang_server_concurrency=64,","+    eval_num_gpus=0, eval_num_gpus_per_engine=1, use_distributed_post=False,","+)","+","+def first_q(text):","+    m = re.findall(r\"<parameter=query>\\s*(.*?)\\s*</parameter>\", text, re.S)","+    return m[0].strip().lower() if m else \"\"","+","+def own(ep): return [lp for lp, m in zip(ep.student, ep.mask()) if m]","+","+async def one_turn(runner, prompt_ids, ep):","+    \"\"\"Generate exactly one more turn (plus its tool response) after ep.\"\"\"","+    saved = runner.max_turns","+    runner.max_turns = ep.num_turns + 1","+    try:","+        out = await runner.continue_episode(prompt_ids, ep)","+    finally:","+        runner.max_turns = saved","+    return out","+","+async def per_turn(sampler, template, prompt_ids, hinted_ids):","+    runner = sampler.runner","+    for _attempt in range(3):","+        ep = Episode()","+        while ep.num_turns < runner.max_turns and not ep.finished and not ep.truncated:","+            before = len(ep.ids)","+            cand = await one_turn(runner, hinted_ids, ep)","+            if cand.num_turns == ep.num_turns:","+                ep = cand; break","+            # score proposed turn under plain prompt","+            await sampler.score_student(prompt_ids, cand)","+            s_idx = [i for i in range(before, len(cand.ids)) if cand.mask()[i]]","+            s_sum = sum(cand.student[i] for i in s_idx)","+            h_sum = sum(cand.logprobs[i] for i in s_idx)","+            accept_p = math.exp(min(0.0, s_sum - h_sum))","+            if sampler.rng.random() < accept_p:","+                ep = cand","+            else:","+                ep = await one_turn(runner, prompt_ids, ep)","+        if await sampler.passes(template, ep):","+            await sampler.score_student(prompt_ids, ep)","+            return ep","+    return None","+","+def describe(tag, eps):","+    rows = [e for e in eps if e is not None]","+    if not rows: print(tag, \"none\"); return","+    print(f\"{tag:14s} n={len(rows)} mean_lp={statistics.mean(sum(own(e))/len(own(e)) for e in rows):.3f} \"","+          f\"sum_lp={statistics.mean(sum(own(e)) for e in rows):.1f} own_tok={statistics.mean(len(own(e)) for e in rows):.0f} \"","+          f\"turns={statistics.mean(e.num_turns for e in rows):.2f} dump={sum(first_q(e.text).startswith('select * from sqlite_master') for e in rows)/len(rows):.2f} \"","+          f\"total_len={statistics.mean(len(e.ids) for e in rows):.0f}\")","+","+async def main():","+    init_http_client(args)","+    tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\")","+    runner = EpisodeRunner(args, tok, {\"temperature\": 1.0, \"top_p\": 1.0, \"top_k\": -1, \"max_new_tokens\": 4096,","+                                        \"stop\": None, \"stop_token_ids\": None, \"skip_special_tokens\": False,","+                                        \"no_stop_trim\": True, \"spaces_between_special_tokens\": False})","+    templates = []","+    for p in sorted(glob.glob(\"/app/runs/base50/rollout/[0-9]*.pt\"), key=lambda x: int(re.search(r\"(\\d+)\\.pt\", x).group(1))):","+        d = torch.load(p, weights_only=False)","+        groups = {}","+        for s in d[\"samples\"]: groups.setdefault(s[\"group_index\"], []).append(s)","+        for g in groups.values():","+            if not any((x[\"reward\"].get(\"acc\") if isinstance(x[\"reward\"], dict) else False) for x in g):","+                t = g[-1]","+                templates.append(Sample(prompt=t[\"prompt\"], label=t[\"label\"], tokens=t[\"tokens\"],","+                                        response_length=t[\"response_length\"], metadata=dict(t[\"metadata\"] or {})))","+        if len(templates) >= 8: break","+    templates = templates[:8]","+    print(f\"{len(templates)} templates\")","+    pt, mh = [], []","+    for t in templates:","+        prompt_ids = t.tokens[: len(t.tokens) - t.response_length]","+        hinted_ids = runner.encode(hinted_prompt(t.prompt, gold_query(t)))","+        sampler = ProjectionSampler(args, runner)","+        pt.append(await per_turn(sampler, t, prompt_ids, hinted_ids))","+        sampler2 = ProjectionSampler(args, runner)","+        res = await sampler2.run(t, prompt_ids, hinted_ids)","+        mh.append(res.episode if res else None)","+        print(f\"pid={(t.metadata or {}).get('pid')} perturn_ok={pt[-1] is not None} mcmc_ok={res is not None}\")","+    describe(\"per-turn\", pt)","+    describe(\"mcmc-greedyMH\", mh)","+","+asyncio.run(main())"],"newLines":107,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/offline_perturn.py"}]}