{"files":[{"hunks":[{"lines":["+\"\"\"Rescue sampler tests: the chain must target pi_student(x | plain prompt) * 1[x passes].","+","+A greedy / length-normalised acceptance does not sample from that target: it keeps","+candidates whose *mean* per-token student log-prob improves even when the trajectory","+as a whole is far less likely under the student, and it ignores how much more likely","+the hinted proposal made the candidate than the reverse move.","+\"\"\"","+","+import asyncio","+import random","+from collections import deque","+","+from examples.sql_agent.rescue.episode import Episode","+from examples.sql_agent.rescue.projection import ProjectionSampler","+from miles.utils.types import Sample","+","+PROMPT_IDS = [1, 2, 3]","+HINTED_IDS = [1, 2, 3, 4]","+","+","+def _episode(ids, hinted_lps):","+    assert len(ids) == len(hinted_lps)","+    return Episode(ids=list(ids), logprobs=list(hinted_lps), turns=[(0, len(ids))], finished=True)","+","+","+class _FakeRunner:","+    def __init__(self, episodes, student_lps_by_ids):","+        self._episodes = deque(episodes)","+        self._student = {tuple(k): list(v) for k, v in student_lps_by_ids.items()}","+","+    async def continue_episode(self, prompt_ids, prefix):","+        return self._episodes.popleft()","+","+    async def token_logprobs(self, ids, start):","+        return list(self._student[tuple(ids[start:])])","+","+","+async def _always_pass(args, sample):","+    return {\"acc\": True, \"score\": 1.0}","+","+","+def _sampler(episodes, student_lps_by_ids):","+    sampler = object.__new__(ProjectionSampler)","+    sampler.args = None","+    sampler.runner = _FakeRunner(episodes, student_lps_by_ids)","+    sampler.steps = 1","+    sampler.init_attempts = 1","+    sampler.reward_fn = _always_pass","+    sampler.rng = random.Random(1234)","+    return sampler","+","+","+def _run(sampler):","+    template = Sample(prompt=\"p\", label='{\"db_id\": \"d\", \"query\": \"SELECT 1\"}')","+    result = asyncio.run(sampler.run(template, PROMPT_IDS, HINTED_IDS))","+    assert result is not None","+    return result","+","+","+def test_long_high_mean_low_student_density_candidate_is_rejected():","+    # Current: 4 policy tokens, student sum -4 (mean -1.0).","+    cur = _episode([10, 11, 12, 13], [-1.0] * 4)","+    # Candidate: 40 tokens, student mean improves to -0.5 but student sum drops to -20,","+    # while the hinted suffix sums are equal (-4 each), so the MH log-ratio is -16.","+    cand = _episode(list(range(100, 140)), [-0.1] * 40)","+    sampler = _sampler(","+        [cur, cand],","+        {tuple(cur.ids): [-1.0] * 4, tuple(cand.ids): [-0.5] * 40},","+    )","+    result = _run(sampler)","+    assert result.episode is cur","+    assert result.accepted == 0","+","+","+def test_short_higher_student_density_candidate_is_accepted():","+    # Current: 40 tokens, student sum -20 (mean -0.5).","+    cur = _episode(list(range(100, 140)), [-0.1] * 40)","+    # Candidate: 4 tokens, student sum -4 (mean -1.0, worse mean but far higher density);","+    # hinted suffix sums are equal (-4 each), so the MH log-ratio is +16.","+    cand = _episode([10, 11, 12, 13], [-1.0] * 4)","+    sampler = _sampler(","+        [cur, cand],","+        {tuple(cur.ids): [-0.5] * 40, tuple(cand.ids): [-1.0] * 4},","+    )","+    result = _run(sampler)","+    assert result.episode is cand","+    assert result.accepted == 1","+","+","+def test_candidate_only_likely_under_the_hint_is_rejected():","+    # Same length and identical student log-probs, but the candidate suffix is (almost)","+    # certain under the hinted proposal while the reverse suffix is very unlikely there:","+    # the proposal-ratio correction must reject it.","+    cur = _episode([10, 11, 12, 13], [-5.0] * 4)","+    cand = _episode([20, 21, 22, 23], [0.0] * 4)","+    sampler = _sampler(","+        [cur, cand],","+        {tuple(cur.ids): [-1.0] * 4, tuple(cand.ids): [-1.0] * 4},","+    )","+    result = _run(sampler)","+    assert result.episode is cur","+    assert result.accepted == 0"],"newLines":102,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/root/miles/tests/fast/examples/test_sql_agent_rescue.py"}]}