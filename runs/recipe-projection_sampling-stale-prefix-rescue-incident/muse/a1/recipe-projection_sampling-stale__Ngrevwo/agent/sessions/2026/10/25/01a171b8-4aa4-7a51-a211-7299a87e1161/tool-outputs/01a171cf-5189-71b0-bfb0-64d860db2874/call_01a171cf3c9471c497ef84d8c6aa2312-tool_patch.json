{"files":[{"hunks":[{"lines":["+import ast, re, sys","+","+path = sys.argv[1]","+keys = [","+    \"train/loss\", \"train/pg_loss\", \"train/train_rollout_kl\", \"train/train_rollout_logprob_abs_diff\",","+    \"train/tis\", \"train/tis_clipfrac\", \"train/ppo_kl\", \"train/pg_clipfrac\", \"train/entropy_loss\",","+    \"rollout/reward\", \"rollout/advantages\",","+]","+seen = set()","+for line in open(path, errors=\"replace\"):","+    if \"'train/loss'\" in line:","+        m = re.search(r\"- (\\d+): (\\{.*\\})\\s*$\", line.strip())","+        if not m:","+            m = re.search(r\"(\\d+): (\\{.*train/loss.*\\})\", line)","+        if not m:","+            print(\"unparsed:\", line[:300]); continue","+        step = m.group(1)","+        try:","+            d = ast.literal_eval(m.group(2))","+        except Exception as e:","+            print(\"parse err\", e, line[:200]); continue","+        sig = (step, d.get(\"train/loss\"))","+        if sig in seen: continue","+        seen.add(sig)","+        out = {k: d[k] for k in keys if k in d}","+        extra = {k: v for k, v in d.items() if \"rescue\" in k or \"grad\" in k}","+        print(f\"step {step}: {out} {extra}\")","+    if \"eval \" in line and \"'eval/regular-pass@1'\" in line:","+        m = re.search(r\"eval (\\d+): (\\{.*\\})\", line)","+        if m:","+            try:","+                d = eval(m.group(2), {\"np\": __import__(\"numpy\")})","+            except Exception:","+                continue","+            print(f\"EVAL {m.group(1)}: regular_pass@1={d.get('eval/regular-pass@1')} hard_pass@1={d.get('eval/hard-pass@1')} \"","+                  f\"regular_cache_hit={d.get('eval/regular/prefix_cache_hit_rate')} hard_cache_hit={d.get('eval/hard/prefix_cache_hit_rate')}\")"],"newLines":36,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/parse_metrics.py"}]}