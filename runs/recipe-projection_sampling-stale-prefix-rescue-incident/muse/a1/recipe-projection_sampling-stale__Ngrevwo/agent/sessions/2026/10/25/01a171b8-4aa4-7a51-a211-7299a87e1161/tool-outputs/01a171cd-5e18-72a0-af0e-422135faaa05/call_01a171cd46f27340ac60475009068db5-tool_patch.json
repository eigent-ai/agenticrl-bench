{"files":[{"hunks":[{"lines":["+import json, sys, torch","+from transformers import AutoTokenizer","+","+path = sys.argv[1]","+tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\", trust_remote_code=True)","+d = torch.load(path, weights_only=False)","+samples = d[\"samples\"]","+print(\"rollout_id\", d[\"rollout_id\"], \"n\", len(samples), \"type\", type(samples[0]))","+groups = {}","+for s in samples:","+    groups.setdefault(s.get(\"group_index\"), []).append(s)","+print(\"groups\", {k: len(v) for k, v in groups.items()})","+for gi, g in groups.items():","+    for si, s in enumerate(g):","+        meta = s.get(\"metadata\") or {}","+        r = s.get(\"reward\")","+        acc = r.get(\"acc\") if isinstance(r, dict) else r","+        mask = s.get(\"loss_mask\") or []","+        lps = s.get(\"rollout_log_probs\") or []","+        mlps = [lp for lp, m in zip(lps, mask) if m]","+        mean_lp = sum(mlps)/len(mlps) if mlps else float(\"nan\")","+        print(f\"g{gi} s{si} rescued={meta.get('rescued', False)} acc={acc} status={s.get('status')} ntok={len(s['tokens'])} \"","+              f\"resp_len={s['response_length']} mask_sum={sum(mask)} mean_lp={mean_lp:.3f} lp_len={len(lps)} mask_len={len(mask)}\")","+print()","+for gi, g in groups.items():","+    for si, s in enumerate(g):","+        if (s.get(\"metadata\") or {}).get(\"rescued\"):","+            print(\"=\"*110)","+            print(f\"RESCUED g{gi} s{si} pid={(s.get('metadata') or {}).get('pid')} label={s.get('label')}\")","+            resp_ids = s[\"tokens\"][-s[\"response_length\"]:]","+            txt = tok.decode(resp_ids)","+            print(\"--- response from tokens ---\")","+            print(txt[:6000])","+            print(\"--- end ---\")","+            print(\"decode(tokens)==s.response?\", txt == s.get(\"response\"))","+            prompt_ids = s[\"tokens\"][:len(s[\"tokens\"])-s[\"response_length\"]]","+            print(\"prompt tail:\", repr(tok.decode(prompt_ids[-25:])))","+            if isinstance(s.get(\"prompt\"), str):","+                print(\"decode(prompt_ids)==s.prompt?\", tok.decode(prompt_ids) == s[\"prompt\"])","+            print(\"hint in tokens?\", \"A query that returns the correct result\" in tok.decode(s[\"tokens\"]))","+            # masked text only (policy tokens)","+            mask = s.get(\"loss_mask\") or []","+            pol = [t for t, m in zip(resp_ids, mask) if m]","+            print(\"--- policy-only tokens text (first 3000 chars) ---\")","+            print(tok.decode(pol)[:3000])"],"newLines":45,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/inspect_rollout2.py"}]}