{"files":[{"hunks":[{"lines":["+\"\"\"Characterize warm-cache logprob corruption: repeated scoring, repeated generation.\"\"\"","+import statistics","+import torch","+","+","+def md(a, b):","+    d = [abs(x - y) for x, y in zip(a, b)]","+    return f\"mean={statistics.mean(d):.6f} p90={sorted(d)[int(0.9*len(d))]:.6f} max={max(d):.5f}\"","+","+","+def main():","+    d = torch.load(\"/app/runs/fixed12/rollout/5.pt\", weights_only=False)","+    seqs = []","+    for s in d[\"samples\"]:","+        plen = len(s[\"tokens\"]) - s[\"response_length\"]","+        if 1200 < len(s[\"tokens\"]) < 2200 and s[\"response_length\"] > 400:","+            seqs.append((s[\"tokens\"], plen))","+        if len(seqs) == 3:","+            break","+","+    from sglang.srt.entrypoints.engine import Engine","+    engine = Engine(model_path=\"/models/Qwen3.5-2B\", mem_fraction_static=0.75, tp_size=1,","+                    trust_remote_code=True, log_level=\"warning\")","+","+    def score(ids, plen):","+        out = engine.generate(","+            input_ids=ids,","+            sampling_params={\"max_new_tokens\": 0, \"temperature\": 0, \"skip_special_tokens\": False},","+            return_logprob=True, logprob_start_len=plen - 1)","+        items = out[\"meta_info\"][\"input_token_logprobs\"][1:]","+        return [float(it[0]) for it in items]","+","+    def gen(ids_prompt):","+        out = engine.generate(","+            input_ids=ids_prompt,","+            sampling_params={\"max_new_tokens\": 48, \"temperature\": 0, \"skip_special_tokens\": False},","+            return_logprob=True)","+        items = out[\"meta_info\"][\"output_token_logprobs\"]","+        return [it[1] for it in items], [float(it[0]) for it in items]","+","+    ids, plen = seqs[0]","+    prompt = ids[:plen]","+","+    print(\"== repeated SCORING of same sequence (flush only at start) ==\", flush=True)","+    engine.flush_cache()","+    base = None","+    for k in range(6):","+        l = score(ids, plen)","+        if base is None:","+            base = l","+            print(f\"  score{k}: (reference)\")","+        else:","+            print(f\"  score{k} vs score0: {md(l, base)}\", flush=True)","+","+    print(\"== repeated GENERATION from same prompt (flush only at start) ==\", flush=True)","+    engine.flush_cache()","+    toks0, lps0 = gen(prompt)","+    print(f\"  gen0 tokens={toks0[:12]}...\")","+    for k in range(1, 5):","+        toks, lps = gen(prompt)","+        same = toks == toks0","+        print(f\"  gen{k}: tokens identical={same} lp vs gen0: {md(lps, lps0) if len(lps)==len(lps0) else 'len differs'}\", flush=True)","+","+    print(\"== GENERATION then SCORING of its own prompt+output, repeated ==\", flush=True)","+    engine.flush_cache()","+    toks, glps = gen(prompt)","+    full = prompt + toks","+    for k in range(4):","+        l = score(full, plen)","+        print(f\"  score{k} vs generation logprobs: {md(l, glps)}\", flush=True)","+","+    print(\"== SCORING B repeatedly after scoring A once (shared system prefix) ==\", flush=True)","+    a_ids, a_plen = seqs[0]","+    b_ids, b_plen = seqs[1]","+    engine.flush_cache()","+    b0 = score(b_ids, b_plen)","+    _ = score(a_ids, a_plen)","+    for k in range(3):","+        l = score(b_ids, b_plen)","+        print(f\"  B score{k+1} vs B cold: {md(l, b0)}\", flush=True)","+","+    engine.shutdown()","+    print(\"DONE\")","+","+","+if __name__ == \"__main__\":","+    main()"],"newLines":87,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/cache_corrupt_probe.py"}]}