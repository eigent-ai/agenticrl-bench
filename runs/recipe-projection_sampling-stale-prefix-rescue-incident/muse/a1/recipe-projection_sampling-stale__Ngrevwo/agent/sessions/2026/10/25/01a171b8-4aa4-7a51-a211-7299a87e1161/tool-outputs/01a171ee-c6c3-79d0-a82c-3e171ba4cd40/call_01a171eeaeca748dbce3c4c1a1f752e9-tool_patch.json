{"files":[{"hunks":[{"lines":["+import glob, re, statistics, torch","+","+def metrics(log):","+    out = {}","+    for line in open(log, errors=\"replace\"):","+        m = re.search(r\"- (\\d+): \\{\", line)","+        if m and \"'train/train_rollout_kl'\" in line:","+            kl = float(re.search(r\"'train/train_rollout_kl': ([0-9.e-]+)\", line).group(1))","+            ad = float(re.search(r\"'train/train_rollout_logprob_abs_diff': ([0-9.e-]+)\", line).group(1))","+            out[int(m.group(1))] = (kl, ad)","+    return out","+","+for run in [\"/app/runs/repro12\", \"/app/runs/fixed12\"]:","+    m = metrics(run + \".log\") if False else metrics(f\"{run}.log\")","+    print(\"==\", run)","+    print(f\"{'step':>4} {'kl':>8} {'absdiff':>8} {'totlen':>7} {'resplen':>7} {'resc_n':>6} {'resc_tokshare':>13} {'mean_lp_all':>11}\")","+    for f in sorted(glob.glob(f\"{run}/rollout/[0-9]*.pt\"), key=lambda p: int(re.search(r\"(\\d+)\\.pt$\", p).group(1))):","+        rid = int(re.search(r\"(\\d+)\\.pt$\", f).group(1))","+        if rid not in m: continue","+        d = torch.load(f, weights_only=False)","+        ss = d[\"samples\"]","+        tot = statistics.mean(len(s[\"tokens\"]) for s in ss)","+        resp = statistics.mean(s[\"response_length\"] for s in ss)","+        resc = [s for s in ss if (s.get(\"metadata\") or {}).get(\"rescued\")]","+        def pol(s): return sum(s.get(\"loss_mask\") or [])","+        share = sum(pol(s) for s in resc) / max(1, sum(pol(s) for s in ss))","+        lps = []","+        for s in ss:","+            mask = s.get(\"loss_mask\") or []","+            ml = [lp for lp, mm in zip(s.get(\"rollout_log_probs\") or [], mask) if mm]","+            if ml: lps.append(statistics.mean(ml))","+        kl, ad = m[rid]","+        print(f\"{rid:>4} {kl:>8.4f} {ad:>8.4f} {tot:>7.0f} {resp:>7.0f} {len(resc):>6} {share:>13.2f} {statistics.mean(lps):>11.3f}\")"],"newLines":33,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/correlate.py"}]}