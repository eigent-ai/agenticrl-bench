{"files":[{"hunks":[{"lines":["+import json, sys, urllib.request, statistics","+sys.path.insert(0, \"/opt/verifier-tools/venv/lib/python3.12/site-packages\")","+from harbor.agents.terminus_2.terminus_json_plain_parser import TerminusJSONPlainParser","+","+parser = TerminusJSONPlainParser()","+traj = json.load(open(\"/tmp/orig1/eval/fix-git__n5Xepno/agent/trajectory.json\"))","+initial_prompt = traj[\"steps\"][0][\"message\"]","+","+def chat(messages, extra, n=20, max_tokens=4096):","+    body = {\"model\": \"policy\", \"messages\": messages, \"n\": n, \"max_tokens\": max_tokens, **extra}","+    req = urllib.request.Request(\"http://127.0.0.1:30000/v1/chat/completions\",","+                                 data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})","+    with urllib.request.urlopen(req, timeout=1200) as r:","+        return json.load(r)","+","+def report(name, resp):","+    rows = []","+    for c in resp[\"choices\"]:","+        content = c[\"message\"][\"content\"] or \"\"","+        res = parser.parse_response(content)","+        rows.append((c.get(\"finish_reason\"), bool(res.error), res.error[:60]))","+    # usage is aggregate; use per-choice meta if present else len approx via completion tokens/n unknown","+    n = len(rows)","+    stop = sum(1 for r in rows if r[0] == \"stop\")","+    length = sum(1 for r in rows if r[0] == \"length\")","+    parse_ok = sum(1 for r in rows if not r[1])","+    print(f\"{name}: n={n} finish_stop={stop} finish_length={length} parse_ok={parse_ok} usage={resp.get('usage')}\")","+    for r in rows:","+        if r[1]:","+            print(\"   parse_err:\", r)","+    return rows","+","+msgs = [{\"role\": \"user\", \"content\": initial_prompt}]","+print(\"=== first turn, original sampling (T0.8 only) ===\")","+report(\"A_orig_T0.8\", chat(msgs, {\"temperature\": 0.8}))","+print(\"=== first turn, checkpoint sampling (T0.8 p0.95 k50) ===\")","+report(\"B_full\", chat(msgs, {\"temperature\": 0.8, \"top_p\": 0.95, \"top_k\": 50}))"],"newLines":37,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_sampling.py"}]}