{"files":[{"hunks":[{"lines":["+import json, sys, urllib.request","+sys.path.insert(0, \"/opt/verifier-tools/venv/lib/python3.12/site-packages\")","+from harbor.agents.terminus_2.terminus_json_plain_parser import TerminusJSONPlainParser","+parser = TerminusJSONPlainParser()","+traj = json.load(open(\"/tmp/orig1/eval/fix-git__n5Xepno/agent/trajectory.json\"))","+steps = traj[\"steps\"]","+","+def obs(s):","+    r = ((s.get(\"observation\") or {}).get(\"results\") or [])","+    return r[0].get(\"content\") if r else \"\"","+","+def assistant_json(s):","+    # reconstruct approx raw assistant JSON from recorded analysis/plan + tool calls","+    msg = s.get(\"message\") or \"\"","+    analysis, plan = \"\", \"\"","+    if msg.startswith(\"Analysis: \"):","+        rest = msg[len(\"Analysis: \"):]","+        if \"\\nPlan: \" in rest:","+            analysis, plan = rest.split(\"\\nPlan: \", 1)","+        else:","+            analysis = rest","+    cmds = []","+    for tc in (s.get(\"tool_calls\") or []):","+        if tc[\"function_name\"] == \"bash_command\":","+            cmds.append({\"keystrokes\": tc[\"arguments\"][\"keystrokes\"], \"duration\": tc[\"arguments\"][\"duration\"]})","+    return json.dumps({\"analysis\": analysis, \"plan\": plan, \"commands\": cmds})","+","+# history as Harbor Chat had it when producing step 4 (index 3 in steps list = step_id 4):","+# messages = [user initial, assistant step2, user obs2] then prompt obs3 is appended as user by LiteLLM call","+msgs = [{\"role\": \"user\", \"content\": steps[0][\"message\"]},","+        {\"role\": \"assistant\", \"content\": assistant_json(steps[1])},","+        {\"role\": \"user\", \"content\": obs(steps[1])},","+        {\"role\": \"assistant\", \"content\": assistant_json(steps[2])},","+        {\"role\": \"user\", \"content\": obs(steps[2])}]","+","+def chat(messages, extra, n=24, max_tokens=8192):","+    body = {\"model\": \"policy\", \"messages\": messages, \"n\": n, \"max_tokens\": max_tokens, **extra}","+    req = urllib.request.Request(\"http://127.0.0.1:30000/v1/chat/completions\",","+                                 data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})","+    with urllib.request.urlopen(req, timeout=1800) as r:","+        return json.load(r)","+","+def report(name, resp):","+    lens = []","+    rows = []","+    for c in resp[\"choices\"]:","+        content = c[\"message\"][\"content\"] or \"\"","+        res = parser.parse_response(content)","+        rows.append((c.get(\"finish_reason\"), bool(res.error), len(content)))","+    n = len(rows)","+    print(f\"{name}: n={n} stop={sum(r[0]=='stop' for r in rows)} length={sum(r[0]=='length' for r in rows)} \"","+          f\"parse_ok={sum(not r[1] for r in rows)} usage={resp.get('usage')} char_lens={sorted(r[2] for r in rows)}\")","+","+print(\"=== turn-4 context, original sampling (T0.8 only, probe cap 8192) ===\")","+report(\"A_orig\", chat(msgs, {\"temperature\": 0.8}))","+print(\"=== turn-4 context, checkpoint sampling (T0.8 p0.95 k50, probe cap 8192) ===\")","+report(\"B_full\", chat(msgs, {\"temperature\": 0.8, \"top_p\": 0.95, \"top_k\": 50}))","+json.dump(msgs, open(\"/tmp/turn4_msgs.json\", \"w\"))"],"newLines":58,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_turn4.py"}]}