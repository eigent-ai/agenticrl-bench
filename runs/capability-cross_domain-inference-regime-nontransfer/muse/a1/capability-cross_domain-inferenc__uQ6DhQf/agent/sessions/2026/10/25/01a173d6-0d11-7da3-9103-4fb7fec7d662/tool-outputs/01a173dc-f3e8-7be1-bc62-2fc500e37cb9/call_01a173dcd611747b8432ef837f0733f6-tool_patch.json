{"files":[{"hunks":[{"lines":["+import asyncio, json, threading","+from http.server import BaseHTTPRequestHandler, HTTPServer","+","+recorded = []","+","+class H(BaseHTTPRequestHandler):","+    def do_POST(self):","+        n = int(self.headers.get(\"Content-Length\", 0))","+        body = self.rfile.read(n)","+        try:","+            recorded.append(json.loads(body))","+        except Exception as e:","+            recorded.append({\"raw_error\": str(e), \"raw\": body[:500].decode(\"utf-8\", \"replace\")})","+        resp = {","+            \"id\": \"chatcmpl-fake\", \"object\": \"chat.completion\", \"created\": 0,","+            \"model\": \"policy\",","+            \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \"{\\\"analysis\\\":\\\"a\\\",\\\"plan\\\":\\\"p\\\",\\\"commands\\\":[]}\"}, \"finish_reason\": \"stop\"}],","+            \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 5, \"total_tokens\": 15},","+        }","+        out = json.dumps(resp).encode()","+        self.send_response(200)","+        self.send_header(\"Content-Type\", \"application/json\")","+        self.send_header(\"Content-Length\", str(len(out)))","+        self.end_headers()","+        self.wfile.write(out)","+    def log_message(self, *a):","+        pass","+","+srv = HTTPServer((\"127.0.0.1\", 39999), H)","+threading.Thread(target=srv.serve_forever, daemon=True).start()","+","+import os","+os.environ.setdefault(\"LITELLM_LOCAL_MODEL_COST_MAP\", \"True\")","+from harbor.llms.lite_llm import LiteLLM","+","+MODEL_INFO = {\"max_input_tokens\": 65536, \"max_output_tokens\": 8192,","+              \"input_cost_per_token\": 0, \"output_cost_per_token\": 0}","+","+async def main():","+    llm = LiteLLM(model_name=\"hosted_vllm/policy\", api_base=\"http://127.0.0.1:39999/v1\",","+                  temperature=0.8, model_info=dict(MODEL_INFO))","+    print(\"context_limit =\", llm.get_model_context_limit())","+    print(\"output_limit  =\", llm.get_model_output_limit())","+    print(\"supported_params =\", llm._supported_params)","+    # 1: exactly what Terminus does today (temperature only)","+    r = await llm.call(prompt=\"hello\", message_history=[])","+    print(\"call1 content:\", r.content)","+    # 2: candidate kwargs via llm_call_kwargs","+    r = await llm.call(prompt=\"hello2\", message_history=[],","+                       max_tokens=8192, top_p=0.95, top_k=50)","+    print(\"call2 ok\")","+    # 3: top_k/min_p via extra_body","+    r = await llm.call(prompt=\"hello3\", message_history=[],","+                       max_tokens=8192, top_p=0.95, extra_body={\"top_k\": 50, \"min_p\": 0.0, \"repetition_penalty\": 1.0})","+    print(\"call3 ok\")","+    # token counter sanity","+    from litellm.utils import token_counter","+    msgs = [{\"role\": \"user\", \"content\": \"hello world \" * 1000}]","+    print(\"token_counter(hosted_vllm/policy, 2000 words) =\", token_counter(model=\"hosted_vllm/policy\", messages=msgs))","+    print(\"token_counter(policy) =\", token_counter(model=\"policy\", messages=msgs))","+","+asyncio.run(main())","+print(\"\\n=== recorded request bodies (minus messages) ===\")","+for i, b in enumerate(recorded):","+    bb = {k: v for k, v in b.items() if k != \"messages\"}","+    print(i, json.dumps(bb, default=str)[:1200])"],"newLines":66,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_litellm.py"}]}