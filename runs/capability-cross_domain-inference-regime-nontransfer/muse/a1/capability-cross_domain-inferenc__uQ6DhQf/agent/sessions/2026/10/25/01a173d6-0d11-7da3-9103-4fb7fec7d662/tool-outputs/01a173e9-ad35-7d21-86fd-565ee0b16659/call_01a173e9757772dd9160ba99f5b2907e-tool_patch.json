{"files":[{"hunks":[{"lines":["+\"\"\"Focused tests for eval_config.py: the checkpoint-config -> deployment-settings mapping.","+","+Run: python3 -m unittest discover -s /app/eval/tests -v   (or point EVAL_DIR elsewhere)","+\"\"\"","+import json","+import os","+import subprocess","+import sys","+import tempfile","+import unittest","+from pathlib import Path","+","+EVAL_DIR = Path(os.environ.get(\"EVAL_DIR\", Path(__file__).resolve().parent.parent))","+HELPER = EVAL_DIR / \"eval_config.py\"","+SYS_PY = [\"/usr/bin/python3\", \"-I\", \"-S\"]","+","+","+def make_checkpoint(tmp: Path, eval_config=None, generation_config=None, raw_eval=None) -> Path:","+    ck = tmp / \"ckpt\"","+    (ck / \"hf_config\").mkdir(parents=True)","+    (ck / \"weights\").mkdir()","+    (ck / \"weights\" / \"model.safetensors\").write_bytes(b\"x\")","+    (ck / \"hf_config\" / \"config.json\").write_text(","+        json.dumps({\"text_config\": {\"eos_token_id\": 248044}})","+    )","+    (ck / \"hf_config\" / \"tokenizer_config.json\").write_text(","+        json.dumps(","+            {","+                \"eos_token\": \"<|im_end|>\",","+                \"added_tokens_decoder\": {\"248046\": {\"content\": \"<|im_end|>\"}},","+            }","+        )","+    )","+    if raw_eval is not None:","+        (ck / \"eval_config.json\").write_text(raw_eval)","+    elif eval_config is not None:","+        (ck / \"eval_config.json\").write_text(json.dumps(eval_config))","+    if generation_config is not None:","+        (ck / \"hf_config\" / \"generation_config.json\").write_text(json.dumps(generation_config))","+    return ck","+","+","+def run_helper(ck: Path):","+    p = subprocess.run(","+        SYS_PY + [str(HELPER), str(ck)], capture_output=True, text=True, timeout=60","+    )","+    out = json.loads(p.stdout) if p.returncode == 0 and p.stdout.strip() else None","+    return p, out","+","+","+class EvalConfigTest(unittest.TestCase):","+    def test_iter38_declared_decoding_is_applied(self):","+        with tempfile.TemporaryDirectory() as td:","+            ck = make_checkpoint(","+                Path(td),","+                eval_config={","+                    \"enable_thinking\": False,","+                    \"temperature\": 0.8,","+                    \"top_p\": 0.95,","+                    \"top_k\": 50,","+                    \"parser_name\": \"json\",","+                },","+            )","+            p, cfg = run_helper(ck)","+            self.assertEqual(p.returncode, 0, p.stderr)","+            self.assertEqual(cfg[\"temperature\"], 0.8)","+            self.assertEqual(cfg[\"parser_name\"], \"json\")","+            self.assertIs(cfg[\"enable_thinking\"], False)","+            # every declared sampling knob must reach the actual LLM calls","+            self.assertEqual(cfg[\"llm_call_kwargs\"][\"max_tokens\"], 8192)","+            self.assertEqual(cfg[\"llm_call_kwargs\"][\"top_p\"], 0.95)","+            self.assertEqual(cfg[\"llm_call_kwargs\"][\"top_k\"], 50)","+            # Harbor treats max_input_tokens as the history budget: input + output = window","+            mi = cfg[\"model_info\"]","+            self.assertEqual(mi[\"max_input_tokens\"] + mi[\"max_output_tokens\"], 65536)","+            self.assertEqual(mi[\"max_output_tokens\"], 8192)","+            # served-model defaults mirror the declared decoding","+            gc = cfg[\"generation_config\"]","+            self.assertEqual(gc[\"temperature\"], 0.8)","+            self.assertEqual(gc[\"top_p\"], 0.95)","+            self.assertEqual(gc[\"top_k\"], 50)","+            self.assertIn(248046, gc[\"eos_token_id\"])","+","+    def test_thinking_checkpoint(self):","+        with tempfile.TemporaryDirectory() as td:","+            ck = make_checkpoint(","+                Path(td),","+                eval_config={\"enable_thinking\": True, \"temperature\": 0.6, \"parser_name\": \"xml\"},","+            )","+            p, cfg = run_helper(ck)","+            self.assertEqual(p.returncode, 0, p.stderr)","+            self.assertIs(cfg[\"enable_thinking\"], True)","+            self.assertEqual(cfg[\"parser_name\"], \"xml\")","+","+    def test_invalid_values_fail_loudly(self):","+        bad_configs = [","+            {\"temperature\": 3.5},","+            {\"temperature\": \"hot\"},","+            {\"top_p\": 1.5},","+            {\"top_k\": 0},","+            {\"parser_name\": \"yaml\"},","+            {\"enable_thinking\": \"false\"},","+        ]","+        for bad in bad_configs:","+            with tempfile.TemporaryDirectory() as td:","+                ck = make_checkpoint(Path(td), eval_config=bad)","+                p, _ = run_helper(ck)","+                self.assertNotEqual(p.returncode, 0, f\"expected failure for {bad}\")","+                self.assertTrue(p.stderr.strip(), f\"expected error message for {bad}\")","+","+    def test_malformed_json_fails(self):","+        with tempfile.TemporaryDirectory() as td:","+            ck = make_checkpoint(Path(td), raw_eval=\"{not json\")","+            p, _ = run_helper(ck)","+            self.assertNotEqual(p.returncode, 0)","+","+    def test_generation_config_cascade_when_eval_config_missing(self):","+        with tempfile.TemporaryDirectory() as td:","+            ck = make_checkpoint(","+                Path(td),","+                eval_config=None,","+                generation_config={\"temperature\": 0.7, \"top_p\": 0.8, \"top_k\": 20},","+            )","+            p, cfg = run_helper(ck)","+            self.assertEqual(p.returncode, 0, p.stderr)","+            self.assertEqual(cfg[\"temperature\"], 0.7)","+            self.assertEqual(cfg[\"llm_call_kwargs\"][\"top_p\"], 0.8)","+            self.assertEqual(cfg[\"llm_call_kwargs\"][\"top_k\"], 20)","+            self.assertIsNone(cfg[\"enable_thinking\"])  # template default decides","+","+    def test_defaults_when_no_config_anywhere(self):","+        with tempfile.TemporaryDirectory() as td:","+            ck = make_checkpoint(Path(td))","+            p, cfg = run_helper(ck)","+            self.assertEqual(p.returncode, 0, p.stderr)","+            self.assertEqual(cfg[\"temperature\"], 0.6)","+            self.assertEqual(cfg[\"parser_name\"], \"json\")","+            self.assertIsNone(cfg[\"enable_thinking\"])","+            self.assertEqual(cfg[\"llm_call_kwargs\"], {\"max_tokens\": 8192})","+","+    def test_unknown_keys_warn_not_silent(self):","+        with tempfile.TemporaryDirectory() as td:","+            ck = make_checkpoint(","+                Path(td), eval_config={\"temperature\": 0.8, \"some_future_knob\": 3}","+            )","+            p, cfg = run_helper(ck)","+            self.assertEqual(p.returncode, 0, p.stderr)","+            self.assertTrue(any(\"some_future_knob\" in w for w in cfg[\"warnings\"]))","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"newLines":152,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/new_eval/tests/test_eval_config.py"}]}