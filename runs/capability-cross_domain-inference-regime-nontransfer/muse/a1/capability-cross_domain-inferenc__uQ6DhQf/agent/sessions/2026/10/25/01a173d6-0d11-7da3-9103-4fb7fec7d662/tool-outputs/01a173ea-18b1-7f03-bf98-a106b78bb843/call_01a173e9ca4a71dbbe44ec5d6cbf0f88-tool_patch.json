{"files":[{"hunks":[{"lines":["+#!/usr/bin/python3 -I -S","+\"\"\"Resolve a checkpoint's declared decoding into the deployment settings for eval_tb21.sh.","+","+Usage: eval_config.py <checkpoint_dir>","+Prints one JSON object (the effective config) on stdout. Exits nonzero with a message on","+stderr when the checkpoint's config is present but invalid -- a deployment number measured","+with silently substituted settings is worse than no number.","+","+Resolution order for sampling knobs: eval_config.json, then hf_config/generation_config.json,","+then the launcher's legacy defaults (temperature 0.6, parser json). enable_thinking stays","+null when undeclared, meaning \"the checkpoint template's own default\".","+\"\"\"","+import json","+import math","+import os","+import sys","+","+CONTEXT_TOKENS = 65536","+MAX_OUTPUT_TOKENS = 8192","+# Harbor counts history tokens with an approximate (non-Qwen) tokenizer and checks the","+# budget once per turn, so leave room for one full turn of growth (8k response + a","+# <=10kB terminal observation) plus counter error before summarization must fire.","+PROACTIVE_SUMMARIZATION_THRESHOLD = 16384","+","+KNOWN_KEYS = {","+    \"temperature\",","+    \"top_p\",","+    \"top_k\",","+    \"min_p\",","+    \"repetition_penalty\",","+    \"parser_name\",","+    \"enable_thinking\",","+}","+","+","+def fail(msg):","+    print(f\"eval_config: {msg}\", file=sys.stderr)","+    sys.exit(2)","+","+","+def load_json(path, required=False):","+    if not os.path.exists(path):","+        if required:","+            fail(f\"missing file: {path}\")","+        return None","+    try:","+        with open(path) as f:","+            return json.load(f)","+    except Exception as e:","+        fail(f\"{path} is not valid JSON: {e}\")","+","+","+def check_number(name, value, lo, hi, lo_inclusive=True, hi_inclusive=True):","+    if isinstance(value, bool) or not isinstance(value, (int, float)):","+        fail(f\"{name}={value!r} invalid: must be a number\")","+    v = float(value)","+    if not math.isfinite(v):","+        fail(f\"{name}={value!r} invalid: must be finite\")","+    if (v < lo if lo_inclusive else v <= lo) or (v > hi if hi_inclusive else v >= hi):","+        fail(f\"{name}={value!r} invalid: out of range\")","+    return v","+","+","+def main():","+    if len(sys.argv) != 2:","+        fail(\"usage: eval_config.py <checkpoint_dir>\")","+    ck = sys.argv[1]","+    warnings = []","+","+    raw = load_json(os.path.join(ck, \"eval_config.json\"))","+    if raw is None:","+        warnings.append(\"no eval_config.json in checkpoint; using generation_config/defaults\")","+        raw = {}","+    if not isinstance(raw, dict):","+        fail(\"eval_config.json must be a JSON object\")","+    unknown = sorted(set(raw) - KNOWN_KEYS)","+    if unknown:","+        warnings.append(f\"unrecognized eval_config keys ignored: {', '.join(unknown)}\")","+","+    gen = load_json(os.path.join(ck, \"hf_config\", \"generation_config.json\")) or {}","+    if not isinstance(gen, dict):","+        fail(\"hf_config/generation_config.json must be a JSON object\")","+","+    def pick(key):","+        if raw.get(key) is not None:","+            return raw[key], \"eval_config\"","+        if gen.get(key) is not None:","+            return gen[key], \"generation_config\"","+        return None, None","+","+    sources = {}","+","+    temp, sources[\"temperature\"] = pick(\"temperature\")","+    if temp is None:","+        temp, sources[\"temperature\"] = 0.6, \"default\"","+    temperature = check_number(\"temperature\", temp, 0.0, 2.0)","+","+    top_p, sources[\"top_p\"] = pick(\"top_p\")","+    if top_p is not None:","+        top_p = check_number(\"top_p\", top_p, 0.0, 1.0, lo_inclusive=False)","+","+    top_k, sources[\"top_k\"] = pick(\"top_k\")","+    if top_k is not None:","+        if isinstance(top_k, bool) or not isinstance(top_k, int) or top_k < 1:","+            fail(f\"top_k={top_k!r} invalid: must be an integer >= 1\")","+","+    min_p, sources[\"min_p\"] = pick(\"min_p\")","+    if min_p is not None:","+        min_p = check_number(\"min_p\", min_p, 0.0, 1.0)","+","+    rep, sources[\"repetition_penalty\"] = pick(\"repetition_penalty\")","+    if rep is not None:","+        rep = check_number(\"repetition_penalty\", rep, 0.0, 2.0, lo_inclusive=False)","+","+    parser_name = raw.get(\"parser_name\") or \"json\"","+    if parser_name not in (\"json\", \"xml\"):","+        fail(f\"parser_name={parser_name!r} invalid: must be 'json' or 'xml'\")","+    sources[\"parser_name\"] = \"eval_config\" if raw.get(\"parser_name\") is not None else \"default\"","+","+    enable_thinking = raw.get(\"enable_thinking\")","+    if enable_thinking is not None and not isinstance(enable_thinking, bool):","+        fail(f\"enable_thinking={enable_thinking!r} invalid: must be true or false\")","+    sources[\"enable_thinking\"] = (","+        \"eval_config\" if enable_thinking is not None else \"chat template default\"","+    )","+","+    # Sampling that must be present on every LLM call (agent turns and summarization","+    # subagent turns alike). model_info's max_output_tokens alone does not cap anything","+    # on Harbor's chat-completions path, so max_tokens travels with the call.","+    llm_call_kwargs = {\"max_tokens\": MAX_OUTPUT_TOKENS}","+    for key, val in (","+        (\"top_p\", top_p),","+        (\"top_k\", top_k),","+        (\"min_p\", min_p),","+        (\"repetition_penalty\", rep),","+    ):","+        if val is not None:","+            llm_call_kwargs[key] = val","+","+    # Served-model generation_config: the checkpoint's own, with the declared decoding","+    # applied on top, so server-side defaults can never silently differ from the request.","+    generation_config = dict(gen)","+    if temperature > 0:","+        generation_config[\"do_sample\"] = True","+        generation_config[\"temperature\"] = temperature","+        for key, val in (","+            (\"top_p\", top_p),","+            (\"top_k\", top_k),","+            (\"min_p\", min_p),","+            (\"repetition_penalty\", rep),","+        ):","+            if val is not None:","+                generation_config[key] = val","+    else:","+        generation_config[\"do_sample\"] = False","+        for key in (\"temperature\", \"top_p\", \"top_k\", \"min_p\", \"repetition_penalty\"):","+            generation_config.pop(key, None)","+    if generation_config.get(\"eos_token_id\") is None:","+        eos_ids = []","+        hf_cfg = load_json(os.path.join(ck, \"hf_config\", \"config.json\")) or {}","+        for holder in (hf_cfg, hf_cfg.get(\"text_config\") or {}):","+            v = holder.get(\"eos_token_id\")","+            if isinstance(v, int):","+                eos_ids.append(v)","+            elif isinstance(v, list):","+                eos_ids.extend(x for x in v if isinstance(x, int))","+        tok_cfg = load_json(os.path.join(ck, \"hf_config\", \"tokenizer_config.json\")) or {}","+        eos_tok = tok_cfg.get(\"eos_token\")","+        for tid, spec in (tok_cfg.get(\"added_tokens_decoder\") or {}).items():","+            if isinstance(spec, dict) and spec.get(\"content\") == eos_tok:","+                eos_ids.append(int(tid))","+        # tokenizer eos first: it is the chat turn terminator (<|im_end|> for Qwen)","+        seen = []","+        for x in reversed(eos_ids):","+            if x not in seen:","+                seen.insert(0, x)","+        if seen:","+            generation_config[\"eos_token_id\"] = seen","+","+    effective = {","+        \"temperature\": temperature,","+        \"top_p\": top_p,","+        \"top_k\": top_k,","+        \"min_p\": min_p,","+        \"repetition_penalty\": rep,","+        \"parser_name\": parser_name,","+        \"enable_thinking\": enable_thinking,","+        \"context_tokens\": CONTEXT_TOKENS,","+        \"max_output_tokens\": MAX_OUTPUT_TOKENS,","+        \"enable_summarize\": True,","+        \"proactive_summarization_threshold\": PROACTIVE_SUMMARIZATION_THRESHOLD,","+        # Harbor uses max_input_tokens as the conversation-history budget","+        # (get_model_context_limit), so it must leave room for a full response:","+        # max_input_tokens + max_output_tokens = served context window.","+        \"model_info\": {","+            \"max_input_tokens\": CONTEXT_TOKENS - MAX_OUTPUT_TOKENS,","+            \"max_output_tokens\": MAX_OUTPUT_TOKENS,","+            \"input_cost_per_token\": 0,","+            \"output_cost_per_token\": 0,","+        },","+        \"llm_call_kwargs\": llm_call_kwargs,","+        \"generation_config\": generation_config,","+        \"sources\": sources,","+        \"warnings\": warnings,","+    }","+    for w in warnings:","+        print(f\"eval_config: warning: {w}\", file=sys.stderr)","+    print(json.dumps(effective, indent=2, sort_keys=True))","+","+","+if __name__ == \"__main__\":","+    main()"],"newLines":212,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/new_eval/eval_config.py"}]}