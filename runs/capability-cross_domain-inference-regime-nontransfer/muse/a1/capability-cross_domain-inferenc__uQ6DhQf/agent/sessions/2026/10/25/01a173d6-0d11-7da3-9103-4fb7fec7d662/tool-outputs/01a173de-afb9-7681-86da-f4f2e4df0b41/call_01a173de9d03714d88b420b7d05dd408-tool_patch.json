{"files":[{"hunks":[{"lines":["+from transformers import AutoTokenizer","+tok = AutoTokenizer.from_pretrained(\"/tmp/eval_model_probe\")","+msgs = [","+    {\"role\": \"user\", \"content\": \"TASK PROMPT (terminus json instructions + task + terminal state)\"},","+    {\"role\": \"assistant\", \"content\": '{\"analysis\":\"a1\",\"plan\":\"p1\",\"commands\":[{\"keystrokes\":\"ls\\\\n\",\"duration\":0.1}]}'},","+    {\"role\": \"user\", \"content\": \"terminal output 1\"},","+    {\"role\": \"assistant\", \"content\": '{\"analysis\":\"a2\",\"plan\":\"p2\",\"commands\":[{\"keystrokes\":\"pwd\\\\n\",\"duration\":0.1}]}'},","+    {\"role\": \"user\", \"content\": \"terminal output 2\"},","+]","+s = tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)","+print(repr(s))","+print(\"--- rendered ---\")","+print(s)","+print(\"--- token counts: chars/tokens ---\")","+ids = tok(s, add_special_tokens=False)[\"input_ids\"]","+print(len(s), len(ids))","+# compare counter used by harbor (litellm token_counter) vs qwen tokenizer on some realistic text","+sample = open(\"/opt/verifier-tools/venv/lib/python3.12/site-packages/harbor/agents/terminus_2/terminus_2.py\").read()[:20000]","+print(\"qwen tokens for 20k chars python:\", len(tok(sample, add_special_tokens=False)[\"input_ids\"]))","+# eos info","+print(\"eos:\", tok.eos_token, tok.eos_token_id, \"pad:\", tok.pad_token, tok.pad_token_id)","+print(\"im_end id:\", tok.convert_tokens_to_ids(\"<|im_end|>\"), \"endoftext id:\", tok.convert_tokens_to_ids(\"<|endoftext|>\"))","+gc = None","+try:","+    from transformers import GenerationConfig","+    gc = GenerationConfig.from_pretrained(\"/tmp/eval_model_probe\")","+    print(\"generation_config:\", gc)","+except Exception as e:","+    print(\"generation_config error:\", type(e).__name__, e)"],"newLines":29,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_template.py"}]}