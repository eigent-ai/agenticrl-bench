{"files":[{"hunks":[{"lines":["+import json, os, shutil, signal, subprocess, sys, time, urllib.request","+","+SUB = \"/models/tbrl-2b-iter38\"","+M = \"/tmp/eval_model_probe\"","+shutil.rmtree(M, ignore_errors=True)","+os.makedirs(M)","+for f in os.listdir(f\"{SUB}/hf_config\"):","+    shutil.copy(f\"{SUB}/hf_config/{f}\", f\"{M}/{f}\")","+os.symlink(f\"{SUB}/weights/model.safetensors\", f\"{M}/model.safetensors\")","+# replicate launcher: base template + pinned enable_thinking=false","+tpl = open(\"/app/eval/reference/chat_template.jinja\").read()","+open(f\"{M}/chat_template.jinja\", \"w\").write(\"{%- set enable_thinking = false %}\\n\" + tpl)","+","+log = open(\"/tmp/probe_sglang.log\", \"w\")","+proc = subprocess.Popen(","+    [\"/usr/bin/python3\", \"-m\", \"sglang.launch_server\", \"--model-path\", M,","+     \"--served-model-name\", \"policy\", \"--dp-size\", \"2\", \"--tp-size\", \"1\",","+     \"--context-length\", \"65536\", \"--host\", \"127.0.0.1\", \"--port\", \"30000\"],","+    stdout=log, stderr=subprocess.STDOUT, preexec_fn=os.setsid)","+","+def req(method, path, body=None, timeout=600):","+    data = json.dumps(body).encode() if body is not None else None","+    r = urllib.request.Request(f\"http://127.0.0.1:30000{path}\", data=data, method=method,","+                               headers={\"Content-Type\": \"application/json\"})","+    with urllib.request.urlopen(r, timeout=timeout) as resp:","+        return json.loads(resp.read())","+","+try:","+    for i in range(180):","+        try:","+            m = req(\"GET\", \"/v1/models\", timeout=3)","+            print(\"MODELS:\", json.dumps(m)[:500]); break","+        except Exception:","+            if proc.poll() is not None:","+                print(\"SERVER DIED\"); sys.exit(1)","+            time.sleep(5)","+    try:","+        print(\"MODEL_INFO:\", json.dumps(req(\"GET\", \"/get_model_info\", timeout=10))[:2000])","+    except Exception as e:","+        print(\"get_model_info err\", e)","+    try:","+        print(\"SERVER_INFO keys:\", json.dumps(req(\"GET\", \"/get_server_info\", timeout=10))[:3000])","+    except Exception as e:","+        print(\"get_server_info err\", e)","+","+    terminus = open(\"/opt/verifier-tools/venv/lib/python3.12/site-packages/harbor/agents/terminus_2/templates/terminus-json-plain.txt\").read()","+    prompt = terminus.replace(\"{instruction}\", \"List files in current dir then say done.\").replace(\"{terminal_state}\", \"root@host:~# \")","+    # template uses double braces for format(); emulate harbor: they .format(instruction=, terminal_state=) -> check","+    try:","+        prompt = terminus.format(instruction=\"List files in current dir then say done.\", terminal_state=\"root@host:~# \")","+    except Exception as e:","+        print(\"format err\", e)","+","+    for label, extra in [(\"HARBOR_LIKE(no max_tokens,temp only)\", {}),","+                          (\"WITH max_tokens=8192 top_p/top_k\", {\"max_tokens\": 8192, \"top_p\": 0.95, \"top_k\": 50})]:","+        t0 = time.time()","+        body = {\"model\": \"policy\", \"messages\": [{\"role\": \"user\", \"content\": prompt}], \"temperature\": 0.8, **extra}","+        r = req(\"POST\", \"/v1/chat/completions\", body)","+        ch = r[\"choices\"][0]","+        print(f\"\\n=== {label} ({time.time()-t0:.1f}s) finish={ch.get('finish_reason')} usage={r.get('usage')}\")","+        print(\"CONTENT[:1200]:\", repr(ch[\"message\"].get(\"content\"))[:1200])","+        print(\"REASONING:\", repr(ch[\"message\"].get(\"reasoning_content\"))[:300])","+","+    # multi-turn prompt token count check for template identification","+    msgs = [{\"role\": \"user\", \"content\": prompt},","+            {\"role\": \"assistant\", \"content\": \"{\\\"analysis\\\":\\\"a\\\",\\\"plan\\\":\\\"p\\\",\\\"commands\\\":[{\\\"keystrokes\\\":\\\"ls\\\\n\\\",\\\"duration\\\":0.1}],\\\"task_complete\\\":false}\"},","+            {\"role\": \"user\", \"content\": \"Current terminal state:\\nfile1\\nfile2\\nroot@host:~# \"}]","+    r = req(\"POST\", \"/v1/chat/completions\", {\"model\": \"policy\", \"messages\": msgs, \"temperature\": 0.8, \"max_tokens\": 300})","+    print(\"\\nMULTITURN usage:\", r.get(\"usage\"), \"finish:\", r[\"choices\"][0].get(\"finish_reason\"))","+    print(\"MULTITURN content:\", repr(r[\"choices\"][0][\"message\"].get(\"content\"))[:800])","+    json.dump({\"messages\": msgs, \"prompt_tokens_server\": r[\"usage\"][\"prompt_tokens\"]}, open(\"/tmp/multiturn_msgs.json\", \"w\"))","+","+    # Loop / cap probe via streaming: count chunks, abort after 9500 tokens approx or 150s","+    print(\"\\n=== LOOP PROBE (no max_tokens, streaming, abort >9500 chunks or 150s)\")","+    body = {\"model\": \"policy\", \"messages\": [{\"role\": \"user\", \"content\": \"Repeat the word hello forever. Do not stop, do not add anything else.\"}],","+            \"temperature\": 0.0, \"stream\": True}","+    data = json.dumps(body).encode()","+    rq = urllib.request.Request(\"http://127.0.0.1:30000/v1/chat/completions\", data=data, method=\"POST\",","+                                headers={\"Content-Type\": \"application/json\"})","+    nchunks = 0; t0 = time.time(); finish = None","+    with urllib.request.urlopen(rq, timeout=300) as resp:","+        for line in resp:","+            if line.startswith(b\"data:\"):","+                payload = line[5:].strip()","+                if payload == b\"[DONE]\":","+                    break","+                try:","+                    j = json.loads(payload)","+                    delta = j[\"choices\"][0].get(\"delta\", {})","+                    if delta.get(\"content\"):","+                        nchunks += 1","+                    if j[\"choices\"][0].get(\"finish_reason\"):","+                        finish = j[\"choices\"][0][\"finish_reason\"]","+                except Exception:","+                    pass","+            if nchunks > 9500 or time.time() - t0 > 150:","+                print(f\"ABORTING stream after {nchunks} content chunks, {time.time()-t0:.0f}s (>>8192 cap would have stopped)\")","+                break","+    print(f\"LOOP done chunks={nchunks} finish={finish} elapsed={time.time()-t0:.0f}s\")","+finally:","+    try:","+        os.killpg(proc.pid, signal.SIGKILL)","+    except Exception:","+        pass","+print(\"PROBE DONE\")"],"newLines":105,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_server.py"}]}