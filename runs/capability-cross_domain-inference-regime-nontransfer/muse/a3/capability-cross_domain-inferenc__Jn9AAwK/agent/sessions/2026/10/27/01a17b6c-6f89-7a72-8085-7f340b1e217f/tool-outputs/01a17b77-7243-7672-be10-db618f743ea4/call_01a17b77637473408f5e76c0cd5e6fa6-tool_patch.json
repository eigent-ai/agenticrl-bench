{"files":[{"hunks":[{"lines":["+import asyncio, json, threading, sys","+from http.server import BaseHTTPRequestHandler, HTTPServer","+","+captured = []","+class H(BaseHTTPRequestHandler):","+    def log_message(self, *a): pass","+    def do_POST(self):","+        n = int(self.headers.get('Content-Length', 0))","+        captured.append(self.rfile.read(n).decode())","+        resp = {\"id\":\"x\",\"object\":\"chat.completion\",\"created\":0,\"model\":\"policy\",","+          \"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"{}\"},\"finish_reason\":\"stop\"}],","+          \"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}","+        b=json.dumps(resp).encode()","+        self.send_response(200); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(b))); self.end_headers(); self.wfile.write(b)","+","+srv=HTTPServer(('127.0.0.1',39124),H); threading.Thread(target=srv.serve_forever,daemon=True).start()","+from harbor.llms.lite_llm import LiteLLM","+","+async def run(label, call_kwargs):","+    captured.clear()","+    llm=LiteLLM(model_name=\"hosted_vllm/policy\", api_base=\"http://127.0.0.1:39124/v1\", temperature=0.8,","+                model_info={\"max_input_tokens\":65536,\"max_output_tokens\":8192,\"input_cost_per_token\":0,\"output_cost_per_token\":0})","+    await llm.call(prompt=\"hi\", message_history=[], **call_kwargs)","+    print(label, \"->\", captured[0] if captured else \"NO REQUEST\")","+","+async def main():","+    await run(\"A top-level max_tokens/top_p/top_k\", {\"max_tokens\":8192,\"top_p\":0.95,\"top_k\":50})","+    await run(\"B extra_body top_k\", {\"max_tokens\":8192,\"top_p\":0.95,\"extra_body\":{\"top_k\":50}})","+    await run(\"C extra_body all\", {\"extra_body\":{\"max_tokens\":8192,\"top_p\":0.95,\"top_k\":50}})","+","+asyncio.run(main())"],"newLines":31,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/mock_capture2.py"}]}