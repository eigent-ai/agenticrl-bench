{"files":[{"hunks":[{"lines":["+\"\"\"No-GPU regression test: sampling params must reach the SGLang HTTP request.","+","+Harbor's LiteLLM chat path sends only temperature by default; max_tokens/top_p/top_k","+must be forwarded via llm_call_kwargs (see eval_tb21.sh). This points Harbor's own","+LiteLLM wrapper at a mock OpenAI server and asserts what is actually on the wire.","+","+Run: /opt/verifier-tools/venv/bin/python /app/eval/test_sampling_forwarding.py","+\"\"\"","+","+import asyncio","+import json","+import threading","+from http.server import BaseHTTPRequestHandler, HTTPServer","+","+captured = []","+","+","+class Handler(BaseHTTPRequestHandler):","+    def log_message(self, *args):","+        pass","+","+    def do_POST(self):","+        captured.append(self.rfile.read(int(self.headers.get(\"Content-Length\", 0))).decode())","+        body = json.dumps(","+            {","+                \"id\": \"x\",","+                \"object\": \"chat.completion\",","+                \"created\": 0,","+                \"model\": \"policy\",","+                \"choices\": [","+                    {","+                        \"index\": 0,","+                        \"message\": {\"role\": \"assistant\", \"content\": \"{}\"},","+                        \"finish_reason\": \"stop\",","+                    }","+                ],","+                \"usage\": {\"prompt_tokens\": 1, \"completion_tokens\": 1, \"total_tokens\": 2},","+            }","+        ).encode()","+        self.send_response(200)","+        self.send_header(\"Content-Type\", \"application/json\")","+        self.send_header(\"Content-Length\", str(len(body)))","+        self.end_headers()","+        self.wfile.write(body)","+","+","+async def main():","+    server = HTTPServer((\"127.0.0.1\", 39125), Handler)","+    threading.Thread(target=server.serve_forever, daemon=True).start()","+","+    from harbor.llms.lite_llm import LiteLLM","+","+    llm = LiteLLM(","+        model_name=\"hosted_vllm/policy\",","+        api_base=\"http://127.0.0.1:39125/v1\",","+        temperature=0.8,","+        model_info={","+            \"max_input_tokens\": 65536,","+            \"max_output_tokens\": 8192,","+            \"input_cost_per_token\": 0,","+            \"output_cost_per_token\": 0,","+        },","+    )","+    # The llm_call_kwargs the launcher builds from iter-38's eval_config.json.","+    await llm.call(","+        prompt=\"hi\",","+        message_history=[],","+        **{\"max_tokens\": 8192, \"top_p\": 0.95, \"top_k\": 50},","+    )","+    body = json.loads(captured[0])","+    assert body[\"temperature\"] == 0.8, body","+    assert body[\"max_tokens\"] == 8192, body","+    assert body[\"top_p\"] == 0.95, body","+    assert body[\"top_k\"] == 50, body","+    print(\"PASS: request carries temperature, max_tokens, top_p, top_k:\", captured[0])","+","+","+if __name__ == \"__main__\":","+    asyncio.run(main())"],"newLines":79,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/eval/test_sampling_forwarding.py"}]}