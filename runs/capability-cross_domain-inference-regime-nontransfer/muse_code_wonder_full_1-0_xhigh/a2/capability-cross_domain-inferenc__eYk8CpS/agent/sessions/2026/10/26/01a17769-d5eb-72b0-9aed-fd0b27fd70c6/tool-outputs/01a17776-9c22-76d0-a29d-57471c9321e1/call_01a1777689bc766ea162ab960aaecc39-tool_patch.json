{"files":[{"hunks":[{"lines":["+import json, sys","+sys.path.insert(0, \"/opt/verifier-tools/venv/lib/python3.12/site-packages\")","+from litellm.utils import token_counter","+from transformers import AutoTokenizer","+traj = json.load(open(\"/tmp/orig1/eval/fix-git__n5Xepno/agent/trajectory.json\"))","+steps = traj[\"steps\"]","+tok = AutoTokenizer.from_pretrained(\"/tmp/tpltest\")","+","+def obs(s):","+    r = ((s.get(\"observation\") or {}).get(\"results\") or [])","+    return r[0].get(\"content\") if r else \"\"","+","+def assistant_json(s):","+    msg = s.get(\"message\") or \"\"","+    analysis, plan = \"\", \"\"","+    if msg.startswith(\"Analysis: \"):","+        rest = msg[len(\"Analysis: \"):]","+        if \"\\nPlan: \" in rest:","+            analysis, plan = rest.split(\"\\nPlan: \", 1)","+        else:","+            analysis = rest","+    cmds = [{\"keystrokes\": tc[\"arguments\"][\"keystrokes\"], \"duration\": tc[\"arguments\"][\"duration\"]}","+            for tc in (s.get(\"tool_calls\") or []) if tc[\"function_name\"] == \"bash_command\"]","+    d = {\"analysis\": analysis, \"plan\": plan, \"commands\": cmds}","+    if any(tc[\"function_name\"] == \"mark_task_complete\" for tc in (s.get(\"tool_calls\") or [])):","+        d[\"task_complete\"] = True","+    return json.dumps(d)","+","+msgs = [{\"role\": \"user\", \"content\": steps[0][\"message\"]}]","+for s in steps[1:]:","+    server_prompt = (s.get(\"metrics\") or {}).get(\"prompt_tokens\")","+    # prompt for this step = msgs + [user obs(prev)] already appended below; count current msgs","+    counted = token_counter(model=\"hosted_vllm/policy\", messages=msgs)","+    rendered = tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)","+    qwen = len(tok(rendered).input_ids)","+    print(f\"step {s['step_id']:3d} server_prompt={server_prompt} litellm_count={counted} qwen_rendered={qwen} ratio_count/server={counted/server_prompt:.3f}\" if server_prompt else f\"step {s['step_id']} no server\")","+    msgs.append({\"role\": \"assistant\", \"content\": assistant_json(s)})","+    msgs.append({\"role\": \"user\", \"content\": obs(s)})"],"newLines":38,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_counter.py"}]}