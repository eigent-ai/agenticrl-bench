{"files":[{"hunks":[{"lines":["+import glob, sys","+sys.path.insert(0, \"/opt/verifier-tools/venv/lib/python3.12/site-packages\")","+import tiktoken","+from transformers import AutoTokenizer","+enc = tiktoken.get_encoding(\"cl100k_base\")","+tok = AutoTokenizer.from_pretrained(\"/tmp/tpltest\")","+files = []","+for pat in [\"/opt/tb21/terminal-bench-2-1/*/instruction.md\", \"/opt/tb21/terminal-bench-2-1/*/tests/*.py\",","+            \"/opt/tb21/terminal-bench-2-1/*/tests/*.sh\", \"/opt/tb21/terminal-bench-2-1/*/environment/*\"]:","+    files += glob.glob(pat)","+rows = []","+tot_c = tot_q = 0","+for f in files:","+    try:","+        text = open(f, errors=\"ignore\").read()","+    except Exception:","+        continue","+    if len(text) < 2000:","+        continue","+    c = len(enc.encode(text)); q = len(tok(text).input_ids)","+    if q == 0: continue","+    rows.append((c/q, f, c, q)); tot_c += c; tot_q += q","+rows.sort()","+print(f\"files={len(rows)} aggregate cl100k/qwen={tot_c/tot_q:.3f} tot_cl100k={tot_c} tot_qwen={tot_q}\")","+print(\"lowest ratios (cl100k undercounts most):\")","+for r in rows[:12]: print(f\"  {r[0]:.3f} {r[1]} cl100k={r[2]} qwen={r[3]}\")","+print(\"highest:\")","+for r in rows[-5:]: print(f\"  {r[0]:.3f} {r[1]}\")","+import statistics","+print(\"median ratio\", statistics.median(r[0] for r in rows), \"p10\", rows[len(rows)//10][0])","+# synthetic worst-ish terminal content","+samples = {","+ \"digits\": (\"1234567890 \" * 2000),","+ \"hexdump\": (\"00000000  7f 45 4c 46 02 01 01 00  00 00 00 00 00 00 00 00  |.ELF............|\\n\" * 300),","+ \"base64\": (\"aGVsbG8gd29ybGQgaGVsbG8gd29ybGQgaGVsbG8gd29ybGQgaGVsbG8=\\n\" * 300),","+ \"logs\": (\"2026-10-26 09:05:30,123 INFO worker[12345] request_id=9f8e7d6c status=200 latency_ms=1234 path=/api/v1/items?id=987654\\n\" * 300),","+ \"code\": (\"def solve(items):\\n    total = 0\\n    for i, x in enumerate(items):\\n        total += x * 1000 + i  # accumulate\\n    return total\\n\" * 300),","+}","+for k, v in samples.items():","+    c = len(enc.encode(v)); q = len(tok(v).input_ids)","+    print(f\"synthetic {k}: ratio={c/q:.3f} cl100k={c} qwen={q}\")"],"newLines":41,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_ratio.py"}]}