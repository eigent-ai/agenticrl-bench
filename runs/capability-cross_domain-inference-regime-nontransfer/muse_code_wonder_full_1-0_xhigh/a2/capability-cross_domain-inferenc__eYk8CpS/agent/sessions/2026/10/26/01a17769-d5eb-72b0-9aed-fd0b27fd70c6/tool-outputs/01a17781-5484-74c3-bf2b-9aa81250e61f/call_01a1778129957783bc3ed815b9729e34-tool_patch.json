{"files":[{"hunks":[{"lines":["+import json, glob, sys, collections, os","+out = sys.argv[1]","+cfg = json.load(open(f\"{out}/eval/config.json\"))","+kw = cfg[\"agents\"][0][\"kwargs\"]","+print(\"agent kwargs:\", json.dumps(kw))","+assert kw.get(\"temperature\") == 0.8, kw","+assert kw.get(\"llm_call_kwargs\", {}).get(\"max_tokens\") == 8192, kw","+assert kw.get(\"llm_call_kwargs\", {}).get(\"top_p\") == 0.95, kw","+assert kw.get(\"llm_call_kwargs\", {}).get(\"extra_body\", {}).get(\"top_k\") == 50, kw","+assert kw.get(\"enable_summarize\") is True, kw","+mi = kw.get(\"model_info\", {})","+print(\"model_info:\", mi)","+assert mi.get(\"max_output_tokens\") == 8192 and mi.get(\"max_input_tokens\") == 43008, mi","+","+trials = sorted(glob.glob(f\"{out}/eval/*/agent/trajectory.json\"))","+print(f\"trajectories: {len(trials)}\")","+tot_steps = tot_parse_err = tot_tech = 0","+max_comp = 0; max_prompt = 0; runaways = 0","+summaries = 0","+for p in trials:","+    d = json.load(open(p))","+    steps = d[\"steps\"]","+    summaries += sum(1 for s in steps if s.get(\"source\") == \"system\" and \"summarization\" in (s.get(\"message\") or \"\"))","+    for s in steps:","+        if s.get(\"source\") != \"agent\": continue","+        tot_steps += 1","+        m = s.get(\"metrics\") or {}","+        c = m.get(\"completion_tokens\") or 0; pr = m.get(\"prompt_tokens\") or 0","+        max_comp = max(max_comp, c); max_prompt = max(max_prompt, pr)","+        if c >= 8192: runaways += 1","+        msg = s.get(\"message\") or \"\"","+        if \"Technical difficulties\" in msg: tot_tech += 1","+        for r in ((s.get(\"observation\") or {}).get(\"results\") or []):","+            if \"parsing errors\" in (r.get(\"content\") or \"\"): tot_parse_err += 1","+    # subagent trajectories count too","+    for sp in glob.glob(os.path.join(os.path.dirname(p), \"trajectory.summarization-*.json\")):","+        sd = json.load(open(sp))","+        for s in sd[\"steps\"]:","+            m = s.get(\"metrics\") or {}","+            max_comp = max(max_comp, m.get(\"completion_tokens\") or 0)","+            max_prompt = max(max_prompt, m.get(\"prompt_tokens\") or 0)","+print(f\"agent steps={tot_steps} max_completion_tokens={max_comp} max_prompt_tokens={max_prompt} \"","+      f\"steps_at_cap={runaways} parse_error_steps={tot_parse_err} technical_difficulties_steps={tot_tech} summarization_steps={summaries}\")","+assert max_comp <= 8192, f\"completion exceeded cap: {max_comp}\"","+assert tot_tech == 0, \"synthetic Technical-difficulties responses present (context-overflow loop)\"","+","+joblog = open(f\"{out}/eval/job.log\").read() if os.path.exists(f\"{out}/eval/job.log\") else \"\"","+for pat in [\"Context length exceeded\", \"Full summary failed\", \"Proactively summarizing\", \"SUMMARIZATION: Full summary succeeded\", \"Output length exceeded\"]:","+    print(f\"job.log {pat!r}: {joblog.count(pat)}\")","+slog = open(f\"{out}/sglang.log\").read() if os.path.exists(f\"{out}/sglang.log\") else \"\"","+print(\"sglang 400s:\", slog.count(\"400 Bad Request\"), \" POSTs:\", slog.count(\"POST /v1/chat\"))","+assert \"400 Bad Request\" not in slog, \"server rejected requests (context overflow?)\"","+res = json.load(open(f\"{out}/eval/result.json\"))","+st = res[\"stats\"]","+print(\"result stats:\", {k: st.get(k) for k in [\"n_completed_trials\",\"n_errored_trials\",\"n_running_trials\"]})","+for name, ev in (st.get(\"evals\") or {}).items():","+    print(\"eval\", name, \"mean=\", ev[\"metrics\"][0][\"mean\"], \"n_errors=\", ev.get(\"n_errors\"), \"exceptions=\", list((ev.get(\"exception_stats\") or {}).keys()))","+print(\"CHECK PASS\")"],"newLines":58,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_run.py"}]}