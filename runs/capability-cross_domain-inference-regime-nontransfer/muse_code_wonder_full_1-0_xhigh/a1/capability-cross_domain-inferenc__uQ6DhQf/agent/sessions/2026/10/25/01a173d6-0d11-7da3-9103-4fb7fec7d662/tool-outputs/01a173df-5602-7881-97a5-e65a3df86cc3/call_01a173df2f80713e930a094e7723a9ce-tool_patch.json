{"files":[{"hunks":[{"lines":["+import json, urllib.request, concurrent.futures, sys, time","+sys.path.insert(0, \"/opt/verifier-tools/venv/lib/python3.12/site-packages\")","+from harbor.agents.terminus_2.terminus_json_plain_parser import TerminusJSONPlainParser","+","+TPL = open(\"/opt/verifier-tools/venv/lib/python3.12/site-packages/harbor/agents/terminus_2/templates/terminus-json-plain.txt\").read()","+INSTR = \"Create a file /tmp/hello.txt containing exactly the text: hello world\"","+PROMPT = TPL.format(instruction=INSTR, terminal_state=\"root@box:/app# \")","+parser = TerminusJSONPlainParser()","+","+def call(payload_extra, prompt=PROMPT, history=None):","+    msgs = list(history or [])","+    if history is None:","+        msgs = [{\"role\": \"user\", \"content\": prompt}]","+    body = {\"model\": \"policy\", \"messages\": msgs, **payload_extra}","+    req = urllib.request.Request(\"http://127.0.0.1:30000/v1/chat/completions\",","+                                 data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})","+    t0 = time.time()","+    with urllib.request.urlopen(req, timeout=600) as r:","+        d = json.load(r)","+    dt = time.time() - t0","+    ch = d[\"choices\"][0]","+    content = ch[\"message\"].get(\"content\") or \"\"","+    res = parser.parse_response(content)","+    return {","+        \"dt\": round(dt, 2), \"finish\": ch.get(\"finish_reason\"),","+        \"completion_tokens\": d.get(\"usage\", {}).get(\"completion_tokens\"),","+        \"prompt_tokens\": d.get(\"usage\", {}).get(\"prompt_tokens\"),","+        \"parse_error\": res.error, \"warning\": res.warning,","+        \"n_commands\": len(res.commands), \"task_complete\": res.is_task_complete,","+        \"content\": content,","+    }","+","+def run_arm(name, extra, n=16, prompt=PROMPT, history=None):","+    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:","+        outs = list(ex.map(lambda i: call(extra, prompt, history), range(n)))","+    ok = sum(1 for o in outs if not o[\"parse_error\"])","+    lens = sorted(o[\"completion_tokens\"] for o in outs)","+    fins = {}","+    for o in outs: fins[o[\"finish\"]] = fins.get(o[\"finish\"], 0) + 1","+    print(f\"\\n== {name}: parse ok {ok}/{n}; completion_tokens min/med/max {lens[0]}/{lens[len(lens)//2]}/{lens[-1]}; finish={fins}\")","+    for o in outs[:2]:","+        print(\"  sample err=\", o[\"parse_error\"][:80], \"| content head:\", repr(o[\"content\"][:200]))","+    bad = [o for o in outs if o[\"parse_error\"]]","+    for o in bad[:2]:","+        print(\"  BAD err=\", o[\"parse_error\"][:120], \"| len\", o[\"completion_tokens\"], \"| head:\", repr(o[\"content\"][:300]))","+    return outs","+","+if __name__ == \"__main__\":","+    mode = sys.argv[1] if len(sys.argv) > 1 else \"first\"","+    if mode == \"first\":","+        # current deployment: temp only, no cap., like harbor request 0","+        run_arm(\"current (T0.8 only, no cap)\", {\"temperature\": 0.8}, n=16)","+        # declared dev config","+        run_arm(\"declared (T0.8 p0.95 k50, cap8192)\", {\"temperature\": 0.8, \"top_p\": 0.95, \"top_k\": 50, \"max_tokens\": 8192}, n=16)","+        # greedy sanity","+        run_arm(\"greedy (T0)\", {\"temperature\": 0.0, \"max_tokens\": 8192}, n=4)","+    elif mode == \"long\":","+        # force long output: raw user request for endless counting, no max_tokens a la current deployment","+        p = \"Count upward from 1 in plain text, comma separated, and do not stop: 1, 2, 3,\"","+        o = call({\"temperature\": 0.8}, prompt=p)","+        print(\"no-cap long gen:\", o[\"finish\"], o[\"completion_tokens\"], \"tokens in\", o[\"dt\"], \"s\")","+        print(\"tail:\", repr(o[\"content\"][-200:]))"],"newLines":62,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_sampling.py"}]}