{"files":[{"hunks":[{"lines":["+import json, sys, collections","+","+for path in sys.argv[1:]:","+    t = json.load(open(path))","+    steps = t[\"steps\"]","+    print(\"\\n###\", path)","+    kinds = collections.Counter()","+    examples = {}","+    for s in steps:","+        if s.get(\"source\") != \"agent\":","+            continue","+        obs = (s.get(\"observation\") or {}).get(\"results\") or []","+        content = \" \".join((r.get(\"content\") or \"\") for r in obs)","+        msg = s.get(\"message\") or \"\"","+        if \"Previous response had parsing errors\" in content:","+            # extract error type","+            err = content.split(\"ERROR:\")[-1].strip().split(\"\\n\")[0][:70] if \"ERROR:\" in content else \"?\"","+            kinds[err] += 1","+            examples.setdefault(err, (s.get(\"step_id\"), (s.get(\"metrics\") or {}).get(\"completion_tokens\"), msg[:400]))","+        elif s.get(\"tool_calls\"):","+            kinds[\"OK w/ commands\"] += 1","+        else:","+            kinds[\"OK no commands\"] += 1","+    for k, v in kinds.most_common():","+        print(f\"  {v:3d}  {k}\")","+    for k, (sid, ct, msg) in list(examples.items())[:6]:","+        print(f\"  -- example step {sid} completion_tokens={ct} err={k}\\n     {msg!r}\")"],"newLines":27,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze_errors.py"}]}