{"files":[{"hunks":[{"lines":["             return len(data)","         self.add_text(data.decode(\"utf-8\", \"replace\"))","         return len(data)","+","+","+def _is_check_name(word: str) -> bool:","+    lower = word.lower()","+    if lower.startswith(_CHECK_PREFIXES) and len(word) > 5:","+        return True","+    if lower.endswith((\"_test\", \"_tests\", \"_check\", \"_checks\")) and len(word) > 5:","+        return True","+    if word[:1].isupper() and (word.startswith(\"Test\") and len(word) > 4):","+        return True","+    if word.endswith((\"Tests\", \"Test\")) and len(word) > 5 and word[:1].isupper():","+        return True","+    return False","+","+","+def _is_exception_name(word: str) -> bool:","+    return word[:1].isupper() and word.endswith(_EXCEPTION_SUFFIXES) and len(word) > 6","+","+","+@dataclass","+class _Sanitizer:","+    student: _Corpus","+    private_only_words: set","+    private_only_numbers: set","+    check_names: set = field(default_factory=set)","+    _placeholders: dict = field(default_factory=dict)","+","+    def _placeholder(self, key: str, original: str) -> str:","+        n = self._placeholders.setdefault(key, len(self._placeholders) + 1)","+        if original.isalpha() and original.isupper() and len(original) > 1:","+            return f\"<HIDDEN_{n}>\"","+        if original[:1].isupper() and not original.islower():","+            return f\"<Hidden_{n}>\"","+        return f\"<hidden_{n}>\"","+","+    def _render_number(self, tok: str) -> str:","+        if tok in self.student.numbers:","+            return tok","+        if tok in self.private_only_numbers:","+            return self._placeholder(\"n:\" + tok, tok)","+        if len(tok) <= 2:  # small counts, indices, widths, line numbers","+            return tok","+        return self._placeholder(\"n:\" + tok, tok)","+","+    def _render_part(self, part: str) -> str:","+        if part.isdigit():","+            return self._render_number(part)","+        lower = part.lower()","+        if lower in self.student.words:","+            return part","+        if lower in self.private_only_words:","+            return self._placeholder(\"w:\" + lower, part)","+        if lower in _GENERIC_WORDS or len(part) <= 2:","+            return part","+        return self._placeholder(\"w:\" + lower, part)","+","+    def _render_word(self, word: str) -> str:","+        if word.isdigit():","+            return self._render_number(word)","+        lower = word.lower()","+        if lower in self.student.words:","+            return word","+        if lower in self.check_names or _is_check_name(word):","+            return word","+        if lower not in self.private_only_words and _is_exception_name(word):","+            return word","+        if lower not in self.private_only_words and lower in _GENERIC_WORDS:","+            return word","+        parts = _split_parts(word)","+        if len(parts) <= 1:","+            return self._render_part(word)","+        out = []","+        for part, sep in parts:","+            out.append(sep)","+            out.append(self._render_part(part))","+        return \"\".join(out)","+","+    def sanitize(self, text: str) -> str:","+        text = _ANSI_RE.sub(\"\", text or \"\")","+        out = []","+        pos = 0","+        for m in _TOKEN_RE.finditer(text):","+            out.append(text[pos : m.start()])","+            out.append(self._render_word(m.group(0)))","+            pos = m.end()","+        out.append(text[pos:])","+        return \"\".join(out)"],"newLines":90,"newStart":233,"oldLines":3,"oldStart":233}],"path":"/opt/SDPO/verl/utils/reward_score/feedback/terminal.py"}]}