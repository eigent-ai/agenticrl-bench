{"files":[{"hunks":[{"lines":["+import json, pathlib, re, collections, sys, time","+sys.path.insert(0, \"/opt/SDPO\")","+from verl.utils.reward_score.feedback import terminal","+","+POOL = pathlib.Path(\"/data/sdpo_terminal/pool\")","+ATTEMPTS = pathlib.Path(\"/data/sdpo_terminal/runs/2026-10-05_sdpo-q3-1.7b/attempts\")","+","+def texts(root):","+    out=[]","+    if not root or not pathlib.Path(root).exists(): return out","+    root=pathlib.Path(root)","+    files=[root] if root.is_file() else sorted(p for p in root.rglob(\"*\") if p.is_file())","+    for p in files:","+        try: out.append(p.read_text(errors=\"replace\"))","+        except OSError: pass","+    return out","+","+def secret_tokens(task_id, student_text):","+    priv = \"\\n\".join(texts(POOL/\"private\"/task_id))","+    student_low = student_text.lower()","+    secrets=set()","+    # quoted strings in private files","+    for s in re.findall(r\"'([^']{3,})'|\\\"([^\\\"]{3,})\\\"\", priv):","+        val=s[0] or s[1]","+        for tok in re.findall(r\"[A-Za-z][A-Za-z0-9]{3,}|\\d{3,}\", val):","+            if tok.lower() not in student_low: secrets.add(tok)","+    # all long words / numbers in private files (fixtures, golden, json, sql are unquoted-ish)","+    for tok in re.findall(r\"[A-Za-z][A-Za-z0-9]{4,}|\\d{4,}\", priv):","+        if tok.lower() not in student_low:","+            secrets.add(tok)","+    # golden / fixture whole lines' tokens already covered; drop code-ish common","+    drop={\"import\",\"from\",\"assert\",\"return\",\"class\",\"def\",\"self\",\"pytest\",\"unittest\",\"assertEqual\",\"assertRaises\",\"parametrize\",\"subTest\",\"sqlite3\",\"connect\",\"execute\",\"fetchall\",\"executescript\",\"read_text\",\"loads\",\"dumps\",\"values\",\"items\",\"print\",\"range\",\"len\",\"sum\",\"int\",\"str\",\"list\",\"dict\",\"Path\",\"json\",\"budget\"}","+    secrets={s for s in secrets if s not in drop and not s.startswith(\"test_\") and not s.endswith(\"Tests\")}","+    return secrets","+","+def student_marker_tokens(attempt_dir, task_id):","+    # literals in workspace code that look like planted markers: quoted strings & big numbers, not in prompt/public/private","+    ws=\"\\n\".join(texts(attempt_dir/\"workspace\"))","+    others=(\"\\n\".join(texts(POOL/\"tasks\"/task_id))+\"\\n\".join(texts(POOL/\"private\"/task_id))).lower()","+    markers=set()","+    for s in re.findall(r\"'([^']{3,})'|\\\"([^\\\"]{3,})\\\"\", ws):","+        val=s[0] or s[1]","+        for tok in re.findall(r\"[A-Za-z][A-Za-z0-9]{3,}|\\d{4,}\", val):","+            if tok.lower() not in others: markers.add(tok)","+    for tok in re.findall(r\"\\b\\d{5,}\\b\", ws):","+        if tok.lower() not in others: markers.add(tok)","+    return markers","+","+t0=time.time()","+leak_attempts=0; leak_detail=collections.Counter(); examples=[]","+ret_total=ret_kept=0; ret_attempts_with=0; ret_attempts_all=0","+fb_by_id={}","+for d in sorted(ATTEMPTS.iterdir()):","+    if not (d/\"meta.json\").exists(): continue","+    meta=json.loads((d/\"meta.json\").read_text())","+    task=meta[\"task_id\"]","+    res=terminal.compute_score((d/\"response.txt\").read_text(errors=\"replace\"), task, {\"recorded_run\":str(d),\"task_id\":task})","+    fb=res[\"feedback\"]; fb_by_id[meta[\"attempt_id\"]]=fb","+    student_text=\"\\n\".join(texts(POOL/\"tasks\"/task)+texts(d/\"workspace\")+[(d/\"response.txt\").read_text(errors=\"replace\")])","+    secrets=secret_tokens(task, student_text)","+    fb_low=fb.lower()","+    leaked=[s for s in secrets if s.lower() in fb_low]","+    if leaked:","+        leak_attempts+=1","+        for s in leaked: leak_detail[(task.rsplit('-',1)[0], s)]+=1","+        if len(examples)<8: examples.append((meta[\"attempt_id\"],task,leaked[:10]))","+    # retention: markers that appear in raw runner log (case-insensitive pieces)","+    raw=(d/\"runner.log\").read_text(errors=\"replace\")","+    markers={m for m in student_marker_tokens(d,task) if m.lower() in raw.lower()}","+    if markers:","+        ret_attempts_with+=1","+        kept={m for m in markers if m.lower() in fb_low}","+        ret_total+=len(markers); ret_kept+=len(kept)","+        if kept==markers: ret_attempts_all+=1","+print(f\"elapsed {time.time()-t0:.1f}s attempts={len(fb_by_id)}\")","+print(f\"LEAK attempts {leak_attempts}/{len(fb_by_id)}\")","+print(\"leak detail sample\", leak_detail.most_common(30))","+print(\"examples\", examples)","+print(f\"RETENTION markers kept {ret_kept}/{ret_total} attempts_with_markers_in_log={ret_attempts_with} attempts_all_kept={ret_attempts_all}\")","+# save feedbacks","+pathlib.Path(\"/tmp/feedbacks.json\").write_text(json.dumps(fb_by_id))","+# show 3 samples","+for aid in list(fb_by_id)[:2]:","+    print(\"\\n=====\",aid); print(fb_by_id[aid][:3000])"],"newLines":84,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_feedback.py"}]}