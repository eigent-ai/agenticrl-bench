{"files":[{"hunks":[{"lines":[" _IDENT_RE = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*\")"," _QUALIFIED_RE = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*(?:(?:::|\\.)[A-Za-z_][A-Za-z0-9_]*)*\")"," _EXCEPTION_RE = re.compile(r\"\\b((?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Za-z_][A-Za-z0-9_]*(?:Error|Exception|Panic|Interrupt))\\b\")","+# Numbers in these positions are run metadata (locations, counts, durations), not data values.","+_STRUCT_NUM_PATTERNS = [","+    re.compile(p, re.IGNORECASE)","+    for p in (","+        r\"\\bline\\s+(\\d+)\\b\",","+        r\"\\bcol(?:umn)?\\s+(\\d+)\\b\",","+        r\"(?:[\\w./-]+\\.[A-Za-z0-9]{1,8}):(\\d+)(?::(\\d+))?\",","+        r\"^\\s*(\\d+)\\s*\\|\",","+        r\"\\b(\\d+)\\s+(?:failed|passed|errors?|failures?|tests?|skipped|deselected|warnings?)\\b\",","+        r\"\\b(?:failures?|errors?|passed|failed)\\s*=\\s*(\\d+)\\b\",","+        r\"\\bexit code\\s+(\\d+)\\b\",","+        r\"\\b(\\d+)%\",","+        r\"\\b(\\d+)\\.(\\d+)s\\b\",","+        r\"\\bindex\\s+(\\d+)\\b\",","+        r\"\\bran\\s+(\\d+)\\b\",","+    )","+]"," "," # Failing-check name harvesters, across runner dialects. Captures are cleaned to a base identifier; parameters"," # (bracketed ids, sub-test arguments, go subtests) never survive _clean_check_name."],"newLines":23,"newStart":103,"oldLines":6,"oldStart":103}],"path":"/opt/SDPO/verl/utils/reward_score/feedback/terminal.py"}]}