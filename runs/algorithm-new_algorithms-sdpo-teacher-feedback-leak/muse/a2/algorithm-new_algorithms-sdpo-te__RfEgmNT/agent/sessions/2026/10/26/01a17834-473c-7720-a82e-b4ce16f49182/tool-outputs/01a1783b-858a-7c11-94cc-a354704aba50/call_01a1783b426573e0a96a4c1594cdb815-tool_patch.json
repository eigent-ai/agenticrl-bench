{"files":[{"hunks":[{"lines":["+\"\"\"Feedback for terminal tasks must not carry test-side values into the teacher prompt.","+","+Each case builds a recorded attempt (workspace + runner.log + meta.json) and scores it","+through compute_score in replay mode, i.e. the path the trainer and","+scripts/export_teacher_contexts.py use. Test-side canaries must be absent in every","+form they appear in the runner output; student-side markers (constants in the","+student's own workspace, their prints, their exception site) must survive.","+\"\"\"","+","+import json","+","+from verl.utils.reward_score.feedback import terminal","+","+SECRET = \"zqxwvsecret\"","+SECRET_DIGITS = \"91827364\"","+","+","+def _score(tmp_path, workspace_files, runner_log, response=\"\", exit_code=1):","+    run = tmp_path / \"attempt\"","+    ws = run / \"workspace\"","+    ws.mkdir(parents=True)","+    for name, content in workspace_files.items():","+        p = ws / name","+        p.parent.mkdir(parents=True, exist_ok=True)","+        p.write_text(content)","+    (run / \"runner.log\").write_text(runner_log)","+    (run / \"meta.json\").write_text(json.dumps({\"exit_code\": exit_code}))","+    (run / \"response.txt\").write_text(response)","+    return terminal.compute_score(response, \"some-task-0000\", {\"recorded_run\": str(run)})","+","+","+def _assert_absent(feedback, *values):","+    for v in values:","+        assert v not in feedback, f\"leaked {v!r} in feedback:\\n{feedback}\"","+","+","+def test_pytest_parametrized_failure_and_student_print(tmp_path):","+    ws = {","+        \"hosts.py\": (","+            'ZONE = \"int\"\\nSYNC_RUN = \"studenttag42\"\\n\\n\\ndef normalize_host(raw):\\n'","+            '    print(f\"normalize_host[{SYNC_RUN}]: {raw!r}\")\\n'","+            \"    return raw.strip().lower()\\n\"","+        )","+    }","+    log = f\"\"\"FF [100%]","+=================================== FAILURES ===================================","+___________ test_normalize_host[ {SECRET.