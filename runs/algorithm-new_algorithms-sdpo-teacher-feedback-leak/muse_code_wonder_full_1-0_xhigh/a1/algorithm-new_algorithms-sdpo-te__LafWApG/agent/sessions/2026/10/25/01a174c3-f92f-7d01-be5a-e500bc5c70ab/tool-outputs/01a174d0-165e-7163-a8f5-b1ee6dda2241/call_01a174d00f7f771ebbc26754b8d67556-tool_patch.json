{"files":[{"hunks":[{"lines":[" _MAX_FILE_BYTES = 512_000"," _MAX_SANITIZE_CHARS = 60_000"," ","-_TOKEN_RE = re.compile(r\"[A-Za-z0-9_]+\")","+# A token is any run of characters that are neither whitespace nor ASCII punctuation","+# (underscore keeps identifiers together). This covers non-ASCII values as well.","+_TOKEN_RE = re.compile(r\"[^\\s!\\\"#$%&'()*+,\\-./:;<=>?@\\[\\\\\\]^`{|}~]+\")"," _ANSI_RE = re.compile(r\"\\x1b\\[[0-9;]*[A-Za-z]\")"," _CHECK_PREFIXES = (\"test_\", \"check_\", \"verify_\", \"validate_\", \"assert_\")"," _EXCEPTION_SUFFIXES = (\"Error\", \"Exception\", \"Warning\", \"Fault\", \"Panic\", \"Failure\")"],"newLines":9,"newStart":47,"oldLines":7,"oldStart":47}],"path":"/opt/SDPO/verl/utils/reward_score/feedback/terminal.py"}]}