===== warehouse-value schema.sql x52 example 092c5822cf
CREATE TABLE stock (
    warehouse TEXT NOT NULL,
    sku TEXT NOT NULL,
    qty INTEGER NOT NULL,
    unit_price INTEGER NOT NULL
);

