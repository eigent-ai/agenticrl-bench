    SQL2 (sql2b-1002#1): SELECT a.Name
FROM Author a
JOIN Author_Book ab ON a.idAuthor = ab.Author
JOIN Book b ON b.ISBN = ab.ISBN
WHERE b.Title = "Pride and Prejudice"
