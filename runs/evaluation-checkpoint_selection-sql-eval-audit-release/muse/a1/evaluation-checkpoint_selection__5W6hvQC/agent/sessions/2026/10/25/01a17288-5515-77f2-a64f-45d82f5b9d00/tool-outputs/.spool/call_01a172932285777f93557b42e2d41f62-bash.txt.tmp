  -> [(1, 'Icelandic'), (2, 'Swedish'), (3, 'English'), (4, 'Danish'), (5, 'Finnish'), (6, 'German'), (7, 'French'), (8, 'Norwegian'), (9, 'Italian'), (10, 'Romansh')]
