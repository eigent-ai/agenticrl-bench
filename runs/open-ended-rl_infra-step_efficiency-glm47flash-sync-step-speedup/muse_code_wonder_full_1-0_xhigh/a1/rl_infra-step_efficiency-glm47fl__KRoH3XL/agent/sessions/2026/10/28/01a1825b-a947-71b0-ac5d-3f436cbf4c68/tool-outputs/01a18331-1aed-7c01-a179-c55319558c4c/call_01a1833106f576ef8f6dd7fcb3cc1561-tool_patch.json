{"files":[{"hunks":[{"lines":["+#!/bin/bash","+# Kill a running bench tree (bench + ray job + sglang engines). Patterns are","+# assembled so this script's own cmdline never matches.","+B=\"oe_step\"; B=\"${B}.bench\"","+S=\"sglang\"; S=\"${S}.launch_server\"","+R=\"ray\"; R=\"${R}::\"","+M=\"train\"; M=\"/root/miles/${M}.py\"","+for pat in \"$B\" \"$S\" \"$R\" \"$M\"; do","+  pids=$(pgrep -f \"$pat\" 2>/dev/null)","+  if [ -n \"$pids\" ]; then kill -9 $pids 2>/dev/null; fi","+done","+sleep 3","+nvidia-smi --query-gpu=memory.used --format=csv,noheader"],"newLines":13,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/kill_bench.sh"}]}