{"files":[{"hunks":[{"lines":["+\"\"\"Rollout-only harness: mimics oe_step.replay against a standalone SGLang server.","+","+Usage: python3 client.py --url http://127.0.0.1:31000 --engine-slot-mod 4 --engine-slot-eq 2","+Measures wall time first-request -> last episode end, like bench rollout_s (per engine subset).","+\"\"\"","+import argparse, asyncio, json, time, sys","+import httpx","+","+async def run_ep(client, url, ep, ret_routed, stats):","+    tokens = list(ep[\"prompt_ids\"])","+    for ti, turn in enumerate(ep[\"turns\"]):","+        gen = turn[\"gen_ids\"]","+        sp = {\"temperature\": 1.0, \"max_new_tokens\": len(gen),","+              \"custom_params\": {\"oe_ep\": ep[\"id\"], \"oe_turn\": ti}}","+        payload = {\"input_ids\": tokens, \"sampling_params\": sp, \"return_logprob\": True}","+        if ret_routed:","+            payload[\"return_routed_experts\"] = True","+        t0 = time.time()","+        r = await client.post(url + \"/generate\", json=payload)","+        r.raise_for_status()","+        out = r.json()","+        otl = out[\"meta_info\"].get(\"output_token_logprobs\") or []","+        toks = [int(x[1]) for x in otl]","+        if toks != list(gen):","+            print(f\"MISMATCH {ep['id']} turn {ti}: {len(toks)} vs {len(gen)}\", file=sys.stderr)","+            stats[\"bad\"] += 1","+            return","+        # mimic miles routed experts decode cost","+        if ret_routed:","+            import pybase64, numpy as np","+            info = out[\"meta_info\"].get(\"routed_experts\")","+            if info:","+                arr = np.frombuffer(pybase64.b64decode(info.encode(\"ascii\")), dtype=np.int32)","+                stats[\"routed_bytes\"] += len(info)","+                stats[\"routed_elems\"] += arr.size","+        stats[\"gen\"] += len(toks)","+        tokens = tokens + toks","+        obs = turn.get(\"obs_ids\") or []","+        if obs:","+            await asyncio.sleep(float(turn.get(\"tool_latency_s\") or 0.0))","+            tokens = tokens + list(obs)","+    stats[\"done\"] += 1","+","+async def main():","+    ap = argparse.ArgumentParser()","+    ap.add_argument(\"--url\", default=\"http://127.0.0.1:31000\")","+    ap.add_argument(\"--traces\", default=\"/opt/oe-step/data/dev.jsonl\")","+    ap.add_argument(\"--mod\", type=int, default=4)","+    ap.add_argument(\"--eq\", type=int, default=2)","+    ap.add_argument(\"--no-routed\", action=\"store_true\")","+    ap.add_argument(\"--max-turns\", type=int, default=0, help=\"cap turns per episode (faster, relative only)\")","+    a = ap.parse_args()","+    rows = [json.loads(l) for l in open(a.traces) if l.strip()]","+    groups = {}","+    for r in rows: groups.setdefault(r[\"group\"], []).append(r)","+    flat = []","+    for gi, g in enumerate(sorted(groups)):","+        for k, r in enumerate(sorted(groups[g], key=lambda x: x[\"id\"])):","+            flat.append((gi*8+k, r))","+    eps = [r for slot, r in flat if slot % a.mod == a.eq]","+    if a.max_turns:","+        for r in eps: r[\"turns\"] = r[\"turns\"][:a.max_turns]","+    total_gen = sum(sum(len(t[\"gen_ids\"]) for t in r[\"turns\"]) for r in eps)","+    print(f\"episodes={len(eps)} gen_tokens={total_gen}\")","+    stats = {\"gen\": 0, \"done\": 0, \"bad\": 0, \"routed_bytes\": 0, \"routed_elems\": 0}","+    async with httpx.AsyncClient(limits=httpx.Limits(max_connections=512), timeout=httpx.Timeout(None)) as client:","+        t0 = time.time()","+        await asyncio.gather(*[run_ep(client, a.url, r, not a.no_routed, stats) for r in eps])","+        dt = time.time() - t0","+    print(json.dumps({\"wall_s\": round(dt,1), \"tok_per_s\": round(stats[\"gen\"]/dt,1), **stats}))","+","+asyncio.run(main())"],"newLines":72,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/harness/client.py"}]}