{"files":[{"hunks":[{"lines":["+import sys, types","+sys.path.insert(0, \"/root/miles\")","+import numpy as np, pybase64","+from miles.rollout.generate_utils.generate_endpoint_utils import (","+    get_routed_experts_from_response, r3_delta_start_len, _R3_DELTA_CACHE)","+","+args = types.SimpleNamespace(num_layers=3)","+rng = np.random.default_rng(0)","+full = rng.integers(1, 64, size=(100, 3, 4), dtype=np.int32)","+","+def enc(arr):","+    return pybase64.b64encode(np.ascontiguousarray(arr).tobytes()).decode(\"ascii\")","+","+def out(arr, start, session=\"ep1\"):","+    return {\"meta_info\": {\"routed_experts\": enc(arr), \"_r3_session\": session, \"_r3_start\": start}}","+","+_R3_DELTA_CACHE.clear()","+# turn 0: start 0, rows 30","+assert r3_delta_start_len(\"ep1\", 0) == 0","+r = get_routed_experts_from_response(args, out(full[:30], 0), 30)","+assert np.array_equal(r, full[:30]), \"turn0\"","+# turn 1: start 30, delta to 55","+assert r3_delta_start_len(\"ep1\", 1) == 30","+r = get_routed_experts_from_response(args, out(full[30:55], 30), 55)","+assert np.array_equal(r, full[:55]), \"turn1\"","+# turn 2: start 55 -> 100","+r = get_routed_experts_from_response(args, out(full[55:], 55), 100)","+assert np.array_equal(r, full), \"turn2\"","+# other session independent","+assert r3_delta_start_len(\"ep2\", 5) == 0","+# turn 0 reset","+assert r3_delta_start_len(\"ep1\", 0) == 0","+r = get_routed_experts_from_response(args, out(full[:10], 0), 10)","+assert np.array_equal(r, full[:10])","+# stock path (no session annotation)","+r = get_routed_experts_from_response(args, {\"meta_info\": {\"routed_experts\": enc(full[:40])}}, 40)","+assert np.array_equal(r, full[:40]), \"stock\"","+print(\"R3 delta assembly OK\")"],"newLines":38,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/test_r3_delta.py"}]}