{"files":[{"hunks":[{"lines":["+#!/bin/bash","+run_one() {","+  name=$1; perf=$2","+  echo \"===== VARIANT $name\"","+  cd /tmp && TO_NUM_ROLLOUT=2 TO_PERF=\"$perf\" timeout 2400 python3 /tmp/train_only_launch.py --extra-args \"\" > /tmp/train_only_$name.log 2>&1","+  echo \"exit=$?\"","+  grep -E \"Timer (log_probs|actor_train|train) end\" /tmp/train_only_$name.log | grep rank00000 | sed 's/.*Timer/Timer/' | cut -c1-120","+  grep -E \"OutOfMemory|out of memory|AssertionError|RuntimeError|ValueError\" /tmp/train_only_$name.log | tail -3 | cut -c1-260","+  ray stop --force >/dev/null 2>&1; sleep 5; pkill -9 -f \"miles/train.py\" 2>/dev/null; sleep 3","+}","+run_one tp2pp2 \"--tensor-model-parallel-size 2 --sequence-parallel --pipeline-model-parallel-size 2 --context-parallel-size 1 --expert-model-parallel-size 4 --expert-tensor-parallel-size 1 --recompute-granularity full --recompute-method uniform --recompute-num-layers 1 --use-dynamic-batch-size --max-tokens-per-gpu 32768 \"","+run_one tp1pp4 \"--tensor-model-parallel-size 1 --pipeline-model-parallel-size 4 --context-parallel-size 1 --expert-model-parallel-size 1 --expert-tensor-parallel-size 1 --recompute-granularity full --recompute-method uniform --recompute-num-layers 1 --use-dynamic-batch-size --max-tokens-per-gpu 32768 \"","+echo DONE","+nvidia-smi --query-gpu=memory.used --format=csv,noheader"],"newLines":14,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/run_train_variants3.sh"}]}