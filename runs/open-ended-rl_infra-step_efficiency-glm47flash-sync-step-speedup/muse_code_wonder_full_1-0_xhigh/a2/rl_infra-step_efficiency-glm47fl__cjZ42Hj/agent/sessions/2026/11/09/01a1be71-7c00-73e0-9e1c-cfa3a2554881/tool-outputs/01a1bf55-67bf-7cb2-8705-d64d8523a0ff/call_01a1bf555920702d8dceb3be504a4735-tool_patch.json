{"files":[{"hunks":[{"lines":["+import torch","+","+from miles.backends.training_utils.loss.hub.losses import assemble_skip_forward_log_probs","+","+","+def _t(v):","+    return torch.tensor([float(v)])","+","+","+def test_assemble_scatters_into_sample_order():","+    collected = [[_t(10)], [_t(21), _t(22)], [_t(30)]]","+    assembled = assemble_skip_forward_log_probs(collected, [[2], [0, 3], [1]])","+    assert assembled is not None","+    assert [x.item() for x in assembled] == [21.0, 30.0, 10.0, 22.0]","+","+","+def test_assemble_rejects_misaligned_inputs():","+    # wrong micro-batch count","+    assert assemble_skip_forward_log_probs([[_t(1)]], [[0], [1]]) is None","+    # wrong per-microbatch sample count","+    assert assemble_skip_forward_log_probs([[_t(1), _t(2)]], [[0]]) is None","+    # duplicate index leaves a hole","+    assert assemble_skip_forward_log_probs([[_t(1)], [_t(2)]], [[0], [0]]) is None","+    # empty schedule","+    assert assemble_skip_forward_log_probs([], []) is None"],"newLines":25,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/root/miles/tests/fast/backends/test_skip_forward_logprob_assembly.py"}]}