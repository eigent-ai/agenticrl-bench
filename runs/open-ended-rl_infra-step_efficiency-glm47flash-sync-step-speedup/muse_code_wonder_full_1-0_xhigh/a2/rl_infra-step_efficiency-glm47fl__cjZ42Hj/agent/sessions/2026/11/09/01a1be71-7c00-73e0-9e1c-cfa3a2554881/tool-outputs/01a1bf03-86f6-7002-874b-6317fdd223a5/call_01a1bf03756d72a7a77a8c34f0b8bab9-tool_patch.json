{"files":[{"hunks":[{"lines":["+#!/bin/bash","+run_one() {","+  name=$1; extra=$2","+  echo \"===== VARIANT $name extra=[$extra]\"","+  cd /tmp && timeout 1500 python3 /tmp/train_only_launch.py --extra-args \"$extra\" > /tmp/train_only_$name.log 2>&1","+  echo \"exit=$?\"","+  grep -E \"Timer (log_probs|actor_train|train) end\" /tmp/train_only_$name.log | grep rank00000 | sed 's/.*Timer/Timer/' | cut -c1-120","+  grep -E \"OutOfMemory|CUDA out of memory|Traceback|AssertionError|RuntimeError\" /tmp/train_only_$name.log | tail -3 | cut -c1-250","+  ray stop --force >/dev/null 2>&1; sleep 5","+  pkill -9 -f \"train.py\" 2>/dev/null; sleep 3","+}","+run_one selective \"--recompute-granularity selective --timing-log-level 1\"","+run_one norecomp \"--recompute-granularity none\"","+run_one alltoall \"--moe-token-dispatcher-type alltoall\"","+echo DONE","+nvidia-smi --query-gpu=memory.used --format=csv,noheader"],"newLines":16,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/run_train_variants.sh"}]}