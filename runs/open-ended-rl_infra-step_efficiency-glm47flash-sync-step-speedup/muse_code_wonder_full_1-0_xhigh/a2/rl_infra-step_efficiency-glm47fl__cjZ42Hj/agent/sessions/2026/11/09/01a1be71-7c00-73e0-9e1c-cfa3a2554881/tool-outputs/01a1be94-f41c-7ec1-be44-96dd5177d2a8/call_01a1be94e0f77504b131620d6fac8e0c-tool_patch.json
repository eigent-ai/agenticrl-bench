{"files":[{"hunks":[{"lines":[" #!/bin/bash","-# usage: run_cfg.sh <name> <mod> <eq> <max_turns> <extra client args> -- <extra server args...>","-# Env: TP (default 1), GPU id base via CUDA_VISIBLE_DEVICES externally.","-set -u","-NAME=$1; MOD=$2; EQ=$3; MAXT=$4; shift 4","-CLIENT_ARGS=\"\"","-while [ \"$1\" != \"--\" ]; do CLIENT_ARGS=\"$CLIENT_ARGS $1\"; shift; done","-shift","+# usage: run_cfg.sh <name> <mod> <eq> <max_turns> [server args...]","+# Env: TP (default 1), CVD (CUDA_VISIBLE_DEVICES), CLIENT_ARGS","+NAME=${1:?}; MOD=${2:?}; EQ=${3:?}; MAXT=${4:?}; shift 4"," PORT=31000"," LOG=/tmp/harness/server_$NAME.log"," echo \"=== $NAME server args: $*\""],"newLines":7,"newStart":1,"oldLines":11,"oldStart":1},{"lines":["   --random-seed 1234 \\","   \"$@\" > $LOG 2>&1 &"," SRV=$!","-# wait ready"," for i in $(seq 1 180); do","   if curl -s http://127.0.0.1:$PORT/health >/dev/null 2>&1; then break; fi","   if ! kill -0 $SRV 2>/dev/null; then echo \"SERVER DIED\"; tail -30 $LOG; exit 1; fi","   sleep 5"," done"," sleep 2","-python3 /tmp/harness/client.py --url http://127.0.0.1:$PORT --mod $MOD --eq $EQ --max-turns $MAXT $CLIENT_ARGS","+python3 /tmp/harness/client.py --url http://127.0.0.1:$PORT --mod $MOD --eq $EQ --max-turns $MAXT ${CLIENT_ARGS:-}"," grep -E \"Decode batch\" $LOG | tail -3 | sed 's/.*Decode batch/Decode batch/'"," kill $SRV 2>/dev/null; sleep 3; kill -9 $SRV 2>/dev/null","-# cleanup children","-pkill -9 -f \"sglang::\" 2>/dev/null; pkill -9 -f \"from multiprocessing\" 2>/dev/null","+pkill -9 -f \"sglang::\" 2>/dev/null"," sleep 5"," nvidia-smi --query-gpu=memory.used --format=csv,noheader | head -2"],"newLines":15,"newStart":17,"oldLines":17,"oldStart":21}],"path":"/tmp/harness/run_cfg.sh"}]}