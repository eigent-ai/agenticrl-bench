{"files":[{"hunks":[{"lines":["+#!/bin/bash","+BASE=\"--tensor-model-parallel-size 4 --sequence-parallel --pipeline-model-parallel-size 1 --context-parallel-size 1 --expert-model-parallel-size 4 --expert-tensor-parallel-size 1 --use-dynamic-batch-size --max-tokens-per-gpu 32768 \"","+run_one() {","+  name=$1; perf=$2; extra=${3:-}","+  echo \"===== VARIANT $name perf=[$perf]\"","+  cd /tmp && TO_PERF=\"$BASE $perf\" timeout 1500 python3 /tmp/train_only_launch.py --extra-args \"$extra\" > /tmp/train_only_$name.log 2>&1","+  echo \"exit=$?\"","+  grep -E \"Timer (log_probs|actor_train|train) end\" /tmp/train_only_$name.log | grep rank00000 | sed 's/.*Timer/Timer/' | cut -c1-120","+  grep -E \"OutOfMemory|out of memory|Traceback|AssertionError|RuntimeError\" /tmp/train_only_$name.log | tail -3 | cut -c1-250","+  ray stop --force >/dev/null 2>&1; sleep 5; pkill -9 -f \"train.py\" 2>/dev/null; sleep 3","+}","+run_one selective \"--recompute-granularity selective\" \"--timing-log-level 1\"","+run_one norecomp \"\"","+echo DONE"],"newLines":14,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/run_train_variants2.sh"}]}