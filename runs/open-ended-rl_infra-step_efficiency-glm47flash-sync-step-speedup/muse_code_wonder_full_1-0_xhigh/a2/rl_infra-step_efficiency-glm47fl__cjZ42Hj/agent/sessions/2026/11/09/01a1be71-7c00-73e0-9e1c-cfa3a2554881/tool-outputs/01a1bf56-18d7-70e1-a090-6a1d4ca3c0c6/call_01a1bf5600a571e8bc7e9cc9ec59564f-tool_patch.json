{"files":[{"hunks":[{"lines":["+import types","+","+import numpy as np","+import pybase64","+","+from miles.rollout.generate_utils import generate_endpoint_utils as geu","+","+","+def _enc(arr):","+    return pybase64.b64encode(np.ascontiguousarray(arr).tobytes()).decode(\"ascii\")","+","+","+def _out(arr, start, session=\"ep-test\"):","+    return {\"meta_info\": {\"routed_experts\": _enc(arr), \"_r3_session\": session, \"_r3_start\": start}}","+","+","+def test_delta_routed_experts_stitches_turns():","+    args = types.SimpleNamespace(num_layers=3)","+    rng = np.random.default_rng(0)","+    full = rng.integers(1, 64, size=(100, 3, 4), dtype=np.int32)","+    geu._R3_DELTA_CACHE.clear()","+","+    assert geu.r3_delta_start_len(\"ep-test\", 0) == 0","+    r = geu.get_routed_experts_from_response(args, _out(full[:30], 0), 30)","+    assert np.array_equal(r, full[:30])","+","+    assert geu.r3_delta_start_len(\"ep-test\", 1) == 30","+    r = geu.get_routed_experts_from_response(args, _out(full[30:55], 30), 55)","+    assert np.array_equal(r, full[:55])","+","+    r = geu.get_routed_experts_from_response(args, _out(full[55:], 55), 100)","+    assert np.array_equal(r, full)","+","+    # an unseen session at a later turn falls back to a full fetch","+    assert geu.r3_delta_start_len(\"ep-other\", 7) == 0","+    # turn 0 resets the session","+    assert geu.r3_delta_start_len(\"ep-test\", 0) == 0","+    r = geu.get_routed_experts_from_response(args, _out(full[:10], 0), 10)","+    assert np.array_equal(r, full[:10])","+","+    # stock (untagged) payloads still decode as full arrays","+    r = geu.get_routed_experts_from_response(args, {\"meta_info\": {\"routed_experts\": _enc(full[:40])}}, 40)","+    assert np.array_equal(r, full[:40])","+    geu._R3_DELTA_CACHE.clear()"],"newLines":44,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/root/miles/tests/fast/rollout/test_delta_routed_experts.py"}]}