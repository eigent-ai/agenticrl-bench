{"files":[{"hunks":[{"lines":["+\"\"\"Capture final per-episode routed-experts arrays via miles' decode fn, sequentially.\"\"\"","+import argparse, asyncio, json, sys","+sys.path.insert(0, \"/root/miles\")","+import numpy as np","+from types import SimpleNamespace","+from miles.rollout.generate_utils.generate_endpoint_utils import get_routed_experts_from_response","+import aiohttp","+","+async def main():","+    ap = argparse.ArgumentParser()","+    ap.add_argument(\"--url\", required=True); ap.add_argument(\"--out\", required=True)","+    ap.add_argument(\"--eps\", default=\"0,4\")","+    a = ap.parse_args()","+    rows = [json.loads(l) for l in open(\"/opt/oe-step/data/dev.jsonl\")]","+    args = SimpleNamespace(num_layers=47)","+    result = {}","+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=None)) as s:","+        for ei in [int(x) for x in a.eps.split(\",\")]:","+            ep = rows[ei]; tokens = list(ep[\"prompt_ids\"]); final = None","+            for ti, turn in enumerate(ep[\"turns\"]):","+                gen = [int(x) for x in turn[\"gen_ids\"]]","+                payload = {\"input_ids\": tokens,","+                           \"sampling_params\": {\"temperature\": 1.0, \"max_new_tokens\": len(gen),","+                                               \"custom_params\": {\"oe_ep\": ep[\"id\"], \"oe_turn\": ti}},","+                           \"return_logprob\": True, \"return_routed_experts\": True}","+                async with s.post(a.url + \"/generate\", json=payload) as r:","+                    out = await r.json()","+                toks = [int(x[1]) for x in (out[\"meta_info\"].get(\"output_token_logprobs\") or [])]","+                assert toks == gen, f\"identity mismatch ep{ei} turn{ti}\"","+                tokens = tokens + toks","+                final = get_routed_experts_from_response(args, out, len(tokens) - 1)","+                assert final is not None and final.shape[0] == len(tokens) - 1, (final.shape, len(tokens))","+                obs = [int(x) for x in turn[\"obs_ids\"]]","+                tokens = tokens + obs","+            result[ep[\"id\"]] = final","+            print(ep[\"id\"], final.shape, int(final.min()), int(final.max()))","+    np.savez(a.out, **result)","+    print(\"saved\", a.out)","+","+asyncio.run(main())"],"newLines":40,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/roll_bench/validate_delta.py"}]}