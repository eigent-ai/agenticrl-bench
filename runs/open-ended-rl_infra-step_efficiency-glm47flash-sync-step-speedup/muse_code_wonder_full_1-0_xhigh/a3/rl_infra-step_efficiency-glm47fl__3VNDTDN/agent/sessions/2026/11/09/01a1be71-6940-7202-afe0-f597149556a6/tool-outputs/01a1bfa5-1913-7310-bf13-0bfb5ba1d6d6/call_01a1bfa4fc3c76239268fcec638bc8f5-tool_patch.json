{"files":[{"hunks":[{"lines":["+\"\"\"Record per-turn logprobs for given episodes (sequential) to a jsonl.\"\"\"","+import argparse, asyncio, json","+import aiohttp","+","+async def main():","+    ap = argparse.ArgumentParser()","+    ap.add_argument(\"--url\", required=True); ap.add_argument(\"--out\", required=True)","+    ap.add_argument(\"--eps\", default=\"0,4,8,12\")","+    a = ap.parse_args()","+    rows = [json.loads(l) for l in open(\"/opt/oe-step/data/dev.jsonl\")]","+    recs = []","+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=None)) as s:","+        for ei in [int(x) for x in a.eps.split(\",\")]:","+            ep = rows[ei]; tokens = list(ep[\"prompt_ids\"])","+            for ti, turn in enumerate(ep[\"turns\"]):","+                gen = [int(x) for x in turn[\"gen_ids\"]]","+                payload = {\"input_ids\": tokens,","+                           \"sampling_params\": {\"temperature\": 1.0, \"max_new_tokens\": len(gen),","+                                               \"custom_params\": {\"oe_ep\": ep[\"id\"], \"oe_turn\": ti}},","+                           \"return_logprob\": True}","+                async with s.post(a.url + \"/generate\", json=payload) as r:","+                    out = await r.json()","+                otl = out[\"meta_info\"].get(\"output_token_logprobs\") or []","+                toks = [int(x[1]) for x in otl]; lps = [float(x[0]) for x in otl]","+                assert toks == gen, (ei, ti)","+                recs.append({\"ep\": ep[\"id\"], \"turn\": ti, \"lp\": lps})","+                tokens = tokens + toks + [int(x) for x in turn[\"obs_ids\"]]","+            print(\"done\", ep[\"id\"])","+    with open(a.out, \"w\") as f:","+        for r in recs: f.write(json.dumps(r) + \"\\n\")","+","+asyncio.run(main())"],"newLines":32,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/roll_bench/record_lps.py"}]}