{"files":[{"hunks":[{"lines":["+\"\"\"Lean fused-MoE triton config tuner for GLM-4.7-Flash shapes on H200.","+Reuses the official tuner's benchmark_config. Writes best-per-M JSON.\"\"\"","+import itertools, json, sys, time","+from types import SimpleNamespace","+","+sys.path.insert(0, \"/sgl-workspace/sglang/python\")","+sys.path.insert(0, \"/sgl-workspace/sglang/benchmark/kernels/fused_moe_triton\")","+","+import torch","+import tuning_fused_moe_triton as T","+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler","+","+T.args = SimpleNamespace(model=\"/models/GLM-4.7-Flash\")","+torch.set_default_device(\"cuda\")","+torch.cuda.manual_seed_all(0)","+set_global_server_args_for_scheduler(ServerArgs(model_path=\"/models/GLM-4.7-Flash\", tp_size=1, ep_size=1))","+","+E, HIDDEN, INTER2, TOPK = 65, 2048, 3072, 4","+","+def bench(cfg, M, iters=20):","+    try:","+        return T.benchmark_config(","+            cfg, M, E, INTER2, HIDDEN, TOPK, torch.bfloat16,","+            False, False, False, False, False, None, num_iters=iters)","+    except Exception as e:","+        return float(\"inf\")","+","+def grid_for(M):","+    if M <= 64:","+        bms, groups = [16, 32], [1]","+    elif M <= 512:","+        bms, groups = [32, 64], [1, 8]","+    else:","+        bms, groups = [64, 128], [8, 32]","+    for bm, bn, bk, w, s, g in itertools.product(","+            bms, [64, 128, 256], [64, 128], [4, 8], [3, 4, 5], groups):","+        yield {\"BLOCK_SIZE_M\": bm, \"BLOCK_SIZE_N\": bn, \"BLOCK_SIZE_K\": bk,","+               \"GROUP_SIZE_M\": g, \"num_warps\": w, \"num_stages\": s}","+","+Ms = [8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192]","+best = {}","+# baseline default-config timings for reference","+DEFAULT_SMALL = {\"BLOCK_SIZE_M\": 16, \"BLOCK_SIZE_N\": 32, \"BLOCK_SIZE_K\": 64, \"GROUP_SIZE_M\": 1}","+DEFAULT_BIG = {\"BLOCK_SIZE_M\": 64, \"BLOCK_SIZE_N\": 64, \"BLOCK_SIZE_K\": 32, \"GROUP_SIZE_M\": 8}","+for M in Ms:","+    t0 = time.time()","+    ref = bench(DEFAULT_SMALL if M <= E else DEFAULT_BIG, M, iters=30)","+    results = []","+    for cfg in grid_for(M):","+        results.append((bench(cfg, M), cfg))","+    results.sort(key=lambda x: x[0])","+    # re-time top-3 with more iters","+    top = sorted([(bench(c, M, iters=60), c) for _, c in results[:3]], key=lambda x: x[0])","+    best[M] = top[0][1]","+    print(f\"M={M}: default={ref:.3f}ms best={top[0][0]:.3f}ms cfg={top[0][1]} ({time.time()-t0:.0f}s)\", flush=True)","+    with open(\"/tmp/roll_bench/moe_tuned.json\", \"w\") as f:","+        json.dump({str(k): v for k, v in best.items()}, f, indent=2)","+print(\"DONE\")"],"newLines":58,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/roll_bench/tune_moe.py"}]}