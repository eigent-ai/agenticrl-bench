{"files":[{"hunks":[{"lines":["+\"\"\"Equivalence test: biased_grouped_topk_impl vs JIT moe_fused_gate for GLM-4.7-Flash","+router params (E=64, n_group=1, topk_group=1, topk=5 incl 1 fused shared, sigmoid+bias,","+renormalize, routed_scaling_factor=1.8).\"\"\"","+import sys","+sys.path.insert(0, \"/sgl-workspace/sglang/python\")","+import torch","+","+torch.manual_seed(0)","+dev = \"cuda\"","+from sglang.srt.layers.moe.topk import biased_grouped_topk_impl","+from sglang.kernels.ops.moe.moe_fused_gate import moe_fused_gate","+","+for apply_scaling in (False, True):","+    for M in (1, 7, 33, 256, 1024):","+        hs = torch.randn(M, 2048, device=dev, dtype=torch.bfloat16)","+        gating = torch.randn(M, 64, device=dev, dtype=torch.float32) * 2","+        bias = torch.randn(64, device=dev, dtype=torch.float32) * 0.1","+        w_ref, ids_ref = biased_grouped_topk_impl(","+            hs, gating, bias, topk=5, renormalize=True, num_expert_group=1, topk_group=1,","+            num_fused_shared_experts=1, routed_scaling_factor=1.8,","+            apply_routed_scaling_factor_on_output=apply_scaling)","+        w_jit, ids_jit = moe_fused_gate(","+            gating, bias.to(torch.float32), 5, scoring_func=\"sigmoid\",","+            num_fused_shared_experts=1, renormalize=True, routed_scaling_factor=1.8,","+            apply_routed_scaling_factor_on_output=apply_scaling,","+            num_expert_group=1, topk_group=1)","+        # impl emits sorted topk (sorted=True when fused shared > 0): shared is last col.","+        # compare routed cols as sets per row and weights via id-matched gather","+        ids_match = 0","+        for r in range(M):","+            ref_ids = ids_ref[r, :-1].tolist(); jit_ids = ids_jit[r, :-1].tolist()","+            if sorted(ref_ids) == sorted(jit_ids): ids_match += 1","+        sh_ref = set(ids_ref[:, -1].tolist()); sh_jit = set(ids_jit[:, -1].tolist())","+        # weights compare after aligning jit cols to ref order by id (routed part)","+        w_err = 0.0","+        for r in range(M):","+            pos = {int(i): j for j, i in enumerate(ids_jit[r, :-1].tolist())}","+            for c in range(4):","+                j = pos.get(int(ids_ref[r, c]))","+                if j is not None:","+                    w_err = max(w_err, abs(float(w_ref[r, c]) - float(w_jit[r, j])))","+        sh_w_err = float((w_ref[:, -1] - w_jit[:, -1]).abs().max())","+        print(f\"apply={apply_scaling} M={M}: routed-id rows match {ids_match}/{M}, \"","+              f\"shared ids ref={sorted(sh_ref)[:3]} jit={sorted(sh_jit)[:3]}, \"","+              f\"max routed w err {w_err:.2e}, shared w err {sh_w_err:.2e}\")"],"newLines":45,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/roll_bench/test_topk_equiv.py"}]}