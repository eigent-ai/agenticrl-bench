{"files":[{"hunks":[{"lines":["+\"\"\"Standalone rollout-throughput harness: replays dev episodes against a bare","+SGLang server (oracle plugin active), mirroring oe_step.replay's request","+protocol. For config tuning only; not part of the shipped code.\"\"\"","+import argparse, asyncio, json, statistics, time","+import aiohttp","+","+async def post(session, url, payload):","+    async with session.post(url, json=payload) as r:","+        return await r.json()","+","+async def run_episode(session, base_url, ep, routed=True, lat_scale=1.0):","+    tokens = list(ep[\"prompt_ids\"])","+    gen_total = 0","+    for ti, turn in enumerate(ep[\"turns\"]):","+        gen = [int(x) for x in turn[\"gen_ids\"]]","+        sp = {\"temperature\": 1.0, \"max_new_tokens\": len(gen),","+              \"custom_params\": {\"oe_ep\": ep[\"id\"], \"oe_turn\": ti}}","+        payload = {\"input_ids\": tokens, \"sampling_params\": sp, \"return_logprob\": True}","+        if routed:","+            payload[\"return_routed_experts\"] = True","+        out = await post(session, base_url + \"/generate\", payload)","+        otl = out[\"meta_info\"].get(\"output_token_logprobs\") or []","+        toks = [int(x[1]) for x in otl]","+        if toks != gen:","+            return (ep[\"id\"], False, gen_total, ti)","+        gen_total += len(toks)","+        tokens = tokens + toks","+        obs = [int(x) for x in turn[\"obs_ids\"]]","+        if obs:","+            await asyncio.sleep(float(turn.get(\"tool_latency_s\") or 0.0) * lat_scale)","+            tokens = tokens + obs","+    return (ep[\"id\"], True, gen_total, len(ep[\"turns\"]))","+","+async def main():","+    ap = argparse.ArgumentParser()","+    ap.add_argument(\"--url\", required=True)","+    ap.add_argument(\"--traces\", default=\"/opt/oe-step/data/dev.jsonl\")","+    ap.add_argument(\"--episodes\", type=int, default=16)","+    ap.add_argument(\"--offset\", type=int, default=0)","+    ap.add_argument(\"--no-routed\", action=\"store_true\")","+    ap.add_argument(\"--lat-scale\", type=float, default=1.0)","+    args = ap.parse_args()","+    rows = [json.loads(l) for l in open(args.traces)]","+    eps = rows[args.offset:args.offset + args.episodes]","+    conn = aiohttp.TCPConnector(limit=0)","+    timeout = aiohttp.ClientTimeout(total=None)","+    async with aiohttp.ClientSession(connector=conn, timeout=timeout) as s:","+        t0 = time.time()","+        results = await asyncio.gather(*[","+            run_episode(s, args.url, ep, routed=not args.no_routed, lat_scale=args.lat_scale)","+            for ep in eps])","+        dt = time.time() - t0","+    ok = all(r[1] for r in results)","+    toks = sum(r[2] for r in results)","+    print(json.dumps({\"ok\": ok, \"episodes\": len(eps), \"gen_tokens\": toks,","+                      \"wall_s\": round(dt, 1), \"tok_per_s\": round(toks / dt, 1),","+                      \"bad\": [r for r in results if not r[1]][:3]}))","+","+if __name__ == \"__main__\":","+    asyncio.run(main())"],"newLines":60,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/roll_bench/client.py"}]}