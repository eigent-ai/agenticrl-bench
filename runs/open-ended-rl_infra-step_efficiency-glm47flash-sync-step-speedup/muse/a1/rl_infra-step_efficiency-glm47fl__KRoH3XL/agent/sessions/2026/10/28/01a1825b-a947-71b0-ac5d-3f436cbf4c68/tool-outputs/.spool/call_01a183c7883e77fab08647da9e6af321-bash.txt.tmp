diff --git a/miles/backends/megatron_utils/actor.py b/miles/backends/megatron_utils/actor.py
index 344133858..2274a364c 100644
--- a/miles/backends/megatron_utils/actor.py
+++ b/miles/backends/megatron_utils/actor.py
@@ -667,6 +667,10 @@ class MegatronTrainRayActor(TrainRayActor):
         data_iterator, num_microbatches = get_data_iterator(self.args, self.model, rollout_data)
         num_optimizer_steps = len(num_microbatches)
         skip_actor_forward_only = self.args.skip_actor_forward_only
+        if skip_actor_forward_only:
+            from miles.backends.training_utils.loss.hub.losses import TRAIN_LOG_PROBS_COLLECTOR
+
+            TRAIN_LOG_PROBS_COLLECTOR.clear()
         if skip_actor_forward_only:
             option = "--skip-actor-forward-only"
             assert num_optimizer_steps == 1, f"{option} requires 1 optimizer step, got {num_optimizer_steps}"
@@ -777,6 +781,20 @@ class MegatronTrainRayActor(TrainRayActor):
 
             self.prof.step(rollout_id=rollout_id)
 
+            if skip_actor_forward_only:
+                from miles.backends.training_utils.loss.hub.losses import TRAIN_LOG_PROBS_COLLECTOR
+
+                collected = [lp for mb in TRAIN_LOG_PROBS_COLLECTOR for lp in mb]
+                TRAIN_LOG_PROBS_COLLECTOR.clear()
+                n_samples = len(rollout_data["total_lengths"])
+                indices = getattr(data_iterator[0], "micro_batch_indices", None)
+                if len(collected) == n_samples and indices is not None:
+                    restored: list = [None] * n_samples
+                    for value, origin_index in zip(collected, sum(indices, []), strict=False):
+                        restored[origin_index] = value
+                    if all(v is not None for v in restored):
+                        rollout_data["log_probs"] = restored
+
         train_dump.save_debug_train_data(self.args, rollout_id=rollout_id, rollout_data=rollout_data)
 
         for m in all_replay_managers:
diff --git a/miles/backends/megatron_utils/model.py b/miles/backends/megatron_utils/model.py
index ae613d244..0b780d46c 100644
--- a/miles/backends/megatron_utils/model.py
