         custom_before_train_step_hook(args, rollout_id, step_id, model, optimizer, opt_param_scheduler)
 
+    _t0 = __import__("time").perf_counter()
     losses_reduced = run_forward_backward_pass(
         args, dumper_phase_util, data_iterator, model, num_microbatches, num_rollouts
     )
+    logger.info(f"OE_TIMER forward_backward_s={__import__('time').perf_counter() - _t0:.2f}")
 
     outcome = TrainStepOutcome.NORMAL
     grad_norm = 0.0
@@ -637,7 +639,9 @@ def train_one_step(
         dumper_phase_util.finalize(model)
 
     if not disable_optimizer and valid_step:
+        _t1 = __import__("time").perf_counter()
         update_successful, grad_norm, num_zeros_in_grad = optimizer.step()
+        logger.info(f"OE_TIMER optimizer_step_s={__import__('time').perf_counter() - _t1:.2f}")
         assert update_successful
         opt_param_scheduler.step(increment=num_rollouts)
 
diff --git a/miles/backends/training_utils/loss/hub/losses.py b/miles/backends/training_utils/loss/hub/losses.py
index b48b7ab76..6f9156897 100644
--- a/miles/backends/training_utils/loss/hub/losses.py
+++ b/miles/backends/training_utils/loss/hub/losses.py
@@ -24,6 +24,13 @@ from miles.backends.training_utils.parallel import get_parallel_state
 from miles.utils.function_registry import load_function
 from miles.utils.types import RolloutBatch
 
+# Detached per-microbatch training log-probs collected when
+# --skip-actor-forward-only is set, so the actor can restore them (in sample
+# order) into rollout_data["log_probs"] for the debug train dump. These are
+# the genuine trainer-scores at the pre-update weights, exactly what the
+# skipped forward-only pass would have recomputed.
+TRAIN_LOG_PROBS_COLLECTOR: list[list[torch.Tensor]] = []
+
 
 class LossFunction(Protocol):
     """Common signature of the per-loss-type functions dispatched by `get_loss_function`."""
@@ -140,6 +147,8 @@ def policy_loss_function(
         old_log_probs = trainer_scored_log_probs
     train_log_probs_list = log_probs
     old_log_probs_list = old_log_probs
+    if args.skip_actor_forward_only:
+        TRAIN_LOG_PROBS_COLLECTOR.append([t.detach().to(device="cpu", copy=True) for t in train_log_probs_list])
 
     # Pre-gather log probs if needed by OPSM or GSPO to avoid duplicate gathering
     need_full_log_probs = args.use_opsm or args.advantage_estimator == "gspo"
@@ -315,7 +324,8 @@ def policy_loss_function(
         else:
             entropy_loss = entropy_loss.detach()
 
-    if args.use_kl_loss:
+    kl_loss = None
+    if args.use_kl_loss and reference_log_probs is not None:
         assert reference_log_probs is not None, "ref_log_probs must be provided when --use-kl-loss is set"
         ref_log_probs = torch.cat(reference_log_probs, dim=0)
         importance_ratio = None
@@ -381,7 +391,7 @@ def policy_loss_function(
     if train_rollout_kl is not None:
         reported_loss["train_rollout_kl"] = train_rollout_kl.clone().detach()
 
-    if args.use_kl_loss:
+    if args.use_kl_loss and kl_loss is not None:
         reported_loss["kl_loss"] = kl_loss.clone().detach()
 
     if args.get_mismatch_metrics or args.use_tis:
