{"files":[{"hunks":[{"lines":["+\"\"\"Summarize per-step metrics from a run's console.log.\"\"\"","+import sys, re, ast, json","+","+run = sys.argv[1] if len(sys.argv) > 1 else \"run2\"","+log = open(f\"/opt/task/runs/{run}/console.log\", errors=\"ignore\").read()","+rows = []","+for m in re.finditer(r\"perf (\\d+): (\\{.*?\\})\\n\", log):","+    try:","+        d = ast.literal_eval(m.group(2))","+    except Exception:","+        continue","+    rows.append((int(m.group(1)), d))","+print(f\"{'step':>4} {'reward':>7} {'all0%':>6} {'all1%':>6} {'respLen':>8} {'turns':>6} {'trunc':>6} {'roll_s':>7}\")","+for i, d in rows:","+    print(f\"{i:>4} {d.get('rollout/raw_reward_unfiltered', float('nan')):>7.3f} \"","+          f\"{d.get('rollout/zero_std/all_zero_percentage', float('nan')):>6.2f} \"","+          f\"{d.get('rollout/zero_std/all_one_percentage', float('nan')):>6.2f} \"","+          f\"{d.get('rollout/episode_response_length/mean', float('nan')):>8.0f} \"","+          f\"{d.get('agent/turns_mean', float('nan')):>6.1f} \"","+          f\"{d.get('rollout/truncated_ratio', float('nan')):>6.2f} \"","+          f\"{d.get('perf/rollout_time', float('nan')):>7.0f}\")","+tr = [float(x) for x in re.findall(r\"perf/actor_train_time['\\\"]?: ([\\d.]+)\", log)]","+if tr:","+    print(\"train_s last:\", [round(x) for x in tr[-5:]])","+g = re.findall(r\"train/loss['\\\"]?: (-?[\\d.eE+-]+)\", log)","+if g: print(\"loss last:\", g[-5:])","+g = re.findall(r\"grad_norm['\\\"]?: ([\\d.eE+-]+)\", log)","+if g: print(\"grad_norm last:\", g[-5:])","+g = re.findall(r\"entropy['\\\"]?: ([\\d.eE+-]+)\", log)","+if g: print(\"entropy last:\", g[-5:])"],"newLines":30,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/work/health.py"}]}