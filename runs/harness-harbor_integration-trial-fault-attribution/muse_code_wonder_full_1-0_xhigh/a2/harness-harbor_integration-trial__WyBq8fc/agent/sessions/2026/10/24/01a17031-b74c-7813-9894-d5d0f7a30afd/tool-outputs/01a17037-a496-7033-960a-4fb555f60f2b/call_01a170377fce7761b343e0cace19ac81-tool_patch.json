{"files":[{"hunks":[{"lines":["+import json, os, re, statistics","+from collections import Counter, defaultdict","+from datetime import datetime","+","+def parse_ts(s):","+    if not s: return None","+    try: return datetime.fromisoformat(s.replace(\"Z\",\"+00:00\"))","+    except: return None","+","+for run in [\"/app/runs/tb21-2b-eval-1005\",\"/app/runs/pool-dry-pass-1011\"]:","+    job=os.path.join(run,\"job\")","+    trials=sorted([d for d in os.listdir(job) if os.path.isdir(os.path.join(job,d))])","+    rows={x[\"t\"]:x for x in json.load(open(f\"/tmp/rows_{os.path.basename(run)}.json\"))}","+    print(f\"\\n######## {run} trial.log census ########\")","+    line_counter=Counter(); per_trial={}","+    for t in trials:","+        p=os.path.join(job,t,\"trial.log\")","+        lines=open(p,errors=\"replace\").read().splitlines() if os.path.exists(p) else []","+        c=Counter()","+        for ln in lines:","+            # normalize numbers","+            key=re.sub(r\"\\d+\",\"#\",ln)[:130]","+            line_counter[key]+=1; c[key]+=1","+        per_trial[t]=c","+    for k,v in line_counter.most_common(30):","+        print(f\" {v:7d}  {k}\")","+    # correlate some signals with tail","+    def has(t,substr):","+        return any(substr in k for k in per_trial[t])","+    for sig in [\"Even fallback chat failed\",\"SUMMARIZATION: Full summary failed\",\"SUMMARIZATION: Full summary succeeded\",\"Output length exceeded\",\"Error in proactively\",\"Context length exceeded. Using fallback\"]:","+        sub=[t for t in trials if has(t,sig)]","+        print(f\" sig '{sig}': {len(sub)} trials; of which tail>0: {sum(1 for t in sub if rows[t]['tail']>0)}, exc AgentTimeout: {sum(1 for t in sub if rows[t]['exc']=='AgentTimeoutError')}, rew1: {sum(1 for t in sub if rows[t]['rew']==1.0)}\")","+    # output-length counts vs outcome","+    ol_counts=Counter()","+    for t in trials:","+        n=sum(v for k,v in per_trial[t].items() if \"Output length exceeded\" in k)","+        ol_counts[min(n,10)]+=1","+    print(\" OutputLengthExceeded per trial dist:\", dict(sorted(ol_counts.items())))","+    json.dump({t:dict(per_trial[t]) for t in trials}, open(f\"/tmp/loglines_{os.path.basename(run)}.json\",\"w\"))","+","+    # verifier files census","+    print(f\" verifier files census:\")","+    vc=Counter(); reward_txt_vals=Counter(); mismatch=0; examples=[]","+    for t in trials:","+        vd=os.path.join(job,t,\"verifier\")","+        files=tuple(sorted(os.listdir(vd))) if os.path.exists(vd) else (\"<no dir>\",)","+        vc[files]+=1","+        rp=os.path.join(vd,\"reward.txt\")","+        rv=None","+        if os.path.exists(rp):","+            rv=open(rp,errors=\"replace\").read().strip()","+            reward_txt_vals[rv]+=1","+        r=json.load(open(os.path.join(job,t,\"result.json\")))","+        vr=r.get(\"verifier_result\"); rew=(vr or {}).get(\"rewards\",{}).get(\"reward\") if vr else None","+        if rv is not None and str(rew)!=rv and not (rew is not None and abs(float(rv)-rew)<1e-9):","+            mismatch+=1","+            if len(examples)<8: examples.append((t,rv,rew,rows[t][\"exc\"]))","+    print(\"  verifier dir listings:\", dict(vc))","+    print(\"  reward.txt values:\", dict(reward_txt_vals), \" mismatch vs result:\", mismatch, examples)","+    # ctrf summary","+    ctrf_status=Counter()","+    for t in trials:","+        cp=os.path.join(job,t,\"verifier\",\"ctrf.json\")","+        if os.path.exists(cp):","+            try:","+                c=json.load(open(cp))","+                s=c.get(\"results\",{}).get(\"summary\",{})","+                ctrf_status[(s.get(\"tests\"),s.get(\"passed\"),s.get(\"failed\"))]+=1","+            except Exception as e:","+                ctrf_status[(\"parse-fail\",str(e)[:40],None)]+=1","+        else:","+            ctrf_status[(\"missing\",None,None)]+=1","+    print(\"  ctrf (tests,passed,failed) top:\", ctrf_status.most_common(12))"],"newLines":73,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/explore3.py"}]}