{"files":[{"hunks":[{"lines":["     if session.endswith(\"__env\"):","         return session[: -len(\"__env\")], \"agent\"","     return session, \"agent\"","+","+","+# ------------------------------------------------------------ trial features","+","+_LOG_NEEDLES = [","+    \"Output length exceeded\", \"Context length exceeded\", \"Even fallback chat failed\",","+    \"Session has ended, breaking out of agent loop\", \"SUMMARIZATION: Full summary failed\",","+    \"Trial \", \"RewardFileNotFoundError\", \"RewardFileEmptyError\", \"VerifierOutputParseError\",","+]","+","+","+def _tb_full_class(tb):","+    for line in reversed((tb or \"\").splitlines()):","+        m = re.match(r\"^([A-Za-z_][\\w.]*(?:Error|Exception|Timeout|Interrupt|Exit|Failure|Denied|Exceeded|NotFound|Unavailable))\\s*:\", line.strip())","+        if m:","+            return m.group(1)","+    return \"\"","+","+","+def _tb_functions(tb):","+    return set(re.findall(r\", in ([A-Za-z_][A-Za-z0-9_]*)\", tb or \"\"))","+","+","+def load_trajectory_steps(agent_dir):","+    \"\"\"ATIF steps from trajectory.json plus any linear-history continuations.\"\"\"","+    steps = []","+    if not os.path.isdir(agent_dir):","+        return steps, None","+    candidates = []","+    for name in os.listdir(agent_dir):","+        if name == \"trajectory.json\":","+            candidates.append((0, name))","+        else:","+            m = re.fullmatch(r\"trajectory\\.cont-(\\d+)\\.json\", name)","+            if m:","+                candidates.append((int(m.group(1)), name))","+    agent_name = None","+    for _idx, name in sorted(candidates):","+        data = read_json(os.path.join(agent_dir, name))","+        if isinstance(data, dict):","+            steps.extend(data.get(\"steps\") or [])","+            agent_name = agent_name or ((data.get(\"agent\") or {}).get(\"name\"))","+    return steps, agent_name","+","+","+def gather(trial_name, trial_dir, job_cfg):","+    t = {\"name\": trial_name, \"dir\": trial_dir}","+    result = read_json(os.path.join(trial_dir, \"result.json\")) or {}","+    t[\"has_result\"] = bool(result)","+    cfg_file = read_json(os.path.join(trial_dir, \"config.json\")) or {}","+    cfg = result.get(\"config\") or cfg_file or {}","+    t[\"result\"] = result","+    t[\"task_name\"] = result.get(\"task_name\") or (cfg.get(\"task\") or {}).get(\"name\")","+    agent_cfg = cfg.get(\"agent\") or cfg_file.get(\"agent\") or {}","+    kwargs = agent_cfg.get(\"kwargs\") or {}","+    job_agents = (job_cfg.get(\"agents\") or [{}]) if isinstance(job_cfg, dict) else [{}]","+    job_kwargs = (job_agents[0].get(\"kwargs\") or {}) if job_agents else {}","+","+    exc = result.get(\"exception_info\")","+    step_results = result.get(\"step_results\") or []","+    if not exc:","+        for sr in step_results:","+            if isinstance(sr, dict) and sr.get(\"exception_info\"):","+                exc = sr[\"exception_info\"]","+                break","+    exc = exc or {}","+    t[\"exc_type\"] = exc.get(\"exception_type\")","+    t[\"exc_msg\"] = str(exc.get(\"exception_message\") or \"\")","+    tb = str(exc.get(\"exception_traceback\") or \"\")","+    if not tb:","+        tb = read_text(os.path.join(trial_dir, \"exception.txt\"), 65536)","+    t[\"tb_class\"] = _tb_full_class(tb)","+    t[\"tb_funcs\"] = _tb_functions(tb)","+    t[\"exc_occurred\"] = parse_ts(exc.get(\"occurred_at\")) if exc else None","+","+    vr = result.get(\"verifier_result\")","+    rewards = (vr or {}).get(\"rewards\") if isinstance(vr, dict) else None","+    if not rewards and step_results:","+        for sr in step_results:","+            if isinstance(sr, dict) and (sr.get(\"verifier_result\") or {}).get(\"rewards\"):","+                rewards = sr[\"verifier_result\"][\"rewards\"]","+    reward = None","+    if isinstance(rewards, dict) and rewards:","+        reward = num(rewards.get(\"reward\", next(iter(rewards.values()), None)))","+    # Verifier files on disk can carry the verdict when result.json cannot.","+    reward_file = None","+    for fname in (\"reward.txt\", \"reward.json\"):","+        fp = os.path.join(trial_dir, \"verifier\", fname)","+        if os.path.isfile(fp):","+            txt = read_text(fp, 4096).strip()","+            try:","+                reward_file = float(txt) if fname.endswith(\".txt\") else num((json.loads(txt) or {}).get(\"reward\"))","+            except Exception:","+                reward_file = None","+            break","+    t[\"reward\"] = reward if reward is not None else reward_file","+    t[\"has_verdict\"] = reward is not None","+    t[\"reward_file\"] = reward_file","+    t[\"verifier_mode\"] = result.get(\"verifier_environment_mode\")","+","+    t[\"started\"], t[\"finished\"] = parse_ts(result.get(\"started_at\")), parse_ts(result.get(\"finished_at\"))","+    for key, attr in ((\"environment_setup\", \"env_setup\"), (\"agent_setup\", \"agent_setup\"),","+                      (\"agent_execution\", \"agent_exec\"), (\"verifier\", \"verifier\")):","+        timing = result.get(key)","+        t[attr + \"_dur\"] = timing_dur(timing)","+        t[attr + \"_start\"] = parse_ts(timing.get(\"started_at\")) if isinstance(timing, dict) else None","+        t[attr + \"_end\"] = parse_ts(timing.get(\"finished_at\")) if isinstance(timing, dict) else None","+    t[\"install_only\"] = bool(cfg.get(\"install_only\"))","+    t[\"verifier_disabled\"] = bool((cfg.get(\"verifier\") or {}).get(\"disable\"))","+","+    t[\"agent_name\"] = agent_cfg.get(\"name\") or (job_agents[0].get(\"name\") if job_agents else None)","+    mi = kwargs.get(\"model_info\") or job_kwargs.get(\"model_info\") or {}","+    t[\"max_input\"] = num(mi.get(\"max_input_tokens\")) or num(kwargs.get(\"max_seq_len\")) or num(kwargs.get(\"max_input_tokens\"))","+    t[\"max_output\"] = num(mi.get(\"max_output_tokens\"))","+    t[\"max_turns\"] = num(kwargs.get(\"max_turns\", kwargs.get(\"max_episodes\", kwargs.get(\"episodes\"))))","+    if