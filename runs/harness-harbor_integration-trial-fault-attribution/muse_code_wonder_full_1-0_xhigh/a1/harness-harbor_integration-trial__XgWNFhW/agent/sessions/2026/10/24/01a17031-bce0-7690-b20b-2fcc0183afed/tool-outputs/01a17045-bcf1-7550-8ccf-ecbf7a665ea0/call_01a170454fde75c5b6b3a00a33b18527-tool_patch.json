,"+            d = tc.get(\"arguments\", {}).get(\"duration\") if isinstance(tc.get(\"arguments\"), dict) else None","+            if isinstance(d, (int, float)):","+                durations.append(min(float(d), 60.0))","+        obs = \"\\n\".join(","+            str(o.get(\"content\") or \"\")","+            for o in ((s.get(\"observation\") or {}).get(\"results\") or [])","+            if isinstance(o, dict)","+        )","+        metrics = s.get(\"metrics\") or {}","+        pt, ct = num(metrics.get(\"prompt_tokens\")), num(metrics.get(\"completion_tokens\"))","+        if pt:","+            prompt_series.append(pt)","+        is_parse = \"Previous response had parsing errors\" in obs or \"parsing errors\" in obs[:200]","+        if is_parse:","+            n_parse += 1","+        msg = s.get(\"message\") or \"\"","+        if not str(msg).strip() and not (s.get(\"tool_calls\") or []):","+            n_empty += 1","+            if (s.get(\"reasoning_content\") or \"\").strip() or (ct or 0) > 0:","+                n_empty_tokens += 1","+        ts = parse_ts(s.get(\"timestamp\"))","+        if ts:","+            step_ts.append(ts)","+    t[\"commands\"] = commands","+    t[\"n_commands\"] = len([c for c in commands if str(c).strip()])","+    t[\"cmd_durations\"] = sum(durations)","+    t[\"n_complete\"] = n_complete","+    t[\"complete\"] = n_complete >= 2 or (n_complete >= 1 and t[\"agent_name\"] != \"terminus-2\")","+    t[\"n_parse\"] = n_parse","+    t[\"n_empty\"] = n_empty","+    t[\"n_empty_tokens\"] = n_empty_tokens","+    t[\"last_prompt_tokens\"] = prompt_series[-1] if prompt_series else None","+    t[\"first_prompt_tokens\"] = prompt_series[0] if prompt_series else None","+    t[\"step_ts\"] = step_ts","+    t[\"last_step_ts\"] = max(step_ts) if step_ts else None","+","+    tech_tail = 0","+    for s in reversed(ag):","+        if str(s.get(\"message\") or \"\").strip() == TECH_DIFF:","+            tech_tail += 1","+        else:","+            break","+    t[\"tech_tail\"] = tech_tail","+    t[\"tech_total\"] = sum(1 for s in ag if str(s.get(\"message\") or \"\").strip() == TECH_DIFF)","+    t[\"first_is_tech\"] = bool(ag) and str(ag[0].get(\"message\") or \"\").strip() == TECH_DIFF","+    # Observation of the final step: an empty \"Current Terminal Screen\" means the","+    # tmux capture came back empty because the session was уже gone.","+    last_obs = \"\"","+    if ag:","+        results = (ag[-1].get(\"observation\") or {}).get(\"results\") or []","+        if results and isinstance(results[0], dict):","+            last_obs = str(results[0].get(\"content\") or \"\")","+    t[\"last_obs_empty_screen\"] = last_obs.strip().endswith(\"Current Terminal Screen:\")","+    t[\"cmd_info\"] = analyze_commands(commands)","+","+    # --- mini-swe-agent raw records (when present) ---","+    t[\"mini_exit_status\"] = None","+    t[\"agent_log_tail\"] = \"\"","+    if os.path.isdir(agent_dir):","+        raw = read_json(os.path.join(agent_dir, \"mini-swe-agent.trajectory.json\"))","+        if isinstance(raw, dict):","+            t[\"mini_exit_status\"] = str((raw.get(\"info\") or {}).get(\"exit_status\") or \"\") or None","+            if not ag:","+                msgs = raw.get(\"messages\") or []","+                t[\"nep\"] = float(sum(1 for x in msgs if isinstance(x, dict) and x.get(\"role\") == \"assistant\"))","+                for x in msgs:","+                    if isinstance(x, dict):","+                        for tc in x.get(\"tool_calls\") or []:","+                            t[\"commands\"].append(flatten_args(((tc.get(\"function\") or {}).get(\"arguments\")) if isinstance(tc, dict) else \"\"))","+                t[\"n_commands\"] = len([c for c in t[\"commands\"] if str(c).strip()])","+                t[\"cmd_info\"] = analyze_commands(t[\"commands\"])","+        tails = []","+        try:","+            names = sorted(os.listdir(agent_dir))","+        except OSError:","+            names = []","+