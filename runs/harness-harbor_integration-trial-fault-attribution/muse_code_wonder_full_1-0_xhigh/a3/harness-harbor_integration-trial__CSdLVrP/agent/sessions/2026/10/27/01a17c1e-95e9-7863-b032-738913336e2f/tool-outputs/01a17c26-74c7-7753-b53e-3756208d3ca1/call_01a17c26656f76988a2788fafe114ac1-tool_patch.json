{"files":[{"hunks":[{"lines":["+import json, collections","+p=\"/app/runs/pool-dry-pass-1011/broker_audit.jsonl\"","+trial2sb={}; sb_execs=collections.defaultdict(list); ended={}","+starts=[]","+for line in open(p):","+    r=json.loads(line)","+    if r.get(\"event\")==\"request\" and r.get(\"op\")==\"create\" and r.get(\"outcome\")==\"allowed\":","+        lab=(r.get(\"labels\") or {}).get(\"session\",\"\")","+        trial=lab[:-5] if lab.endswith(\"__env\") else lab","+        trial2sb[trial]=r[\"sandbox_id\"]","+    if r.get(\"event\")==\"request\" and r.get(\"op\")==\"exec\":","+        sb_execs[r.get(\"sandbox_id\")].append(r)","+    if r.get(\"event\")==\"sandbox_ended\":","+        ended[r.get(\"sandbox_id\")]=r","+json.dump({\"trial2sb\":trial2sb,\"ended\":ended},open(\"/tmp/broker_map.json\",\"w\"))","+print(len(trial2sb), collections.Counter(v.get(\"reason\") for v in ended.values()))","+# save execs summary per sb to pickle-ish json (argv truncated already in audit? argv is _short_argv 2000)","+import pickle","+pickle.dump(dict(sb_execs), open(\"/tmp/broker_execs.pkl\",\"wb\"))","+print(\"exec sbs\", len(sb_execs))"],"newLines":20,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/broker_map.py"}]}