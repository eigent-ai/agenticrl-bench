{"files":[{"hunks":[{"lines":["+import json, os, statistics, collections, bisect","+from datetime import datetime","+def parse_ts(s):","+    if not s: return None","+    try: return datetime.fromisoformat(s.replace(\"Z\",\"+00:00\")).timestamp()","+    except Exception: return None","+TD=\"Technical difficulties. Please continue with the task.\"","+for run in [\"/app/runs/tb21-2b-eval-1005\",\"/app/runs/pool-dry-pass-1011\"]:","+    job=os.path.join(run,\"job\")","+    intervals=[]; calls=[]","+    for d in sorted(os.listdir(job)):","+        base=os.path.join(job,d)","+        if not os.path.isdir(base): continue","+        r=json.load(open(os.path.join(base,\"result.json\")))","+        ae=r.get(\"agent_execution\") or {}","+        a,b=parse_ts(ae.get(\"started_at\")),parse_ts(ae.get(\"finished_at\"))","+        if a and b: intervals.append((a,b))","+        tp=os.path.join(base,\"agent/trajectory.json\")","+        if not os.path.exists(tp): continue","+        try: t=json.load(open(tp))","+        except Exception: continue","+        steps=t.get(\"steps\") or []","+        prev=a","+        for s in steps:","+            ts=parse_ts(s.get(\"timestamp\"))","+            if s.get(\"source\")==\"agent\" and ts and prev:","+                gap=ts-prev","+                cmd=0.0","+                for tc in (s.get(\"tool_calls\") or []):","+                    try: cmd+=float((tc.get(\"arguments\") or {}).get(\"duration\") or 0)","+                    except Exception: pass","+                llm=gap-cmd","+                comp=(s.get(\"metrics\") or {}).get(\"completion_tokens\") or 0","+                prompt=(s.get(\"metrics\") or {}).get(\"prompt_tokens\") or 0","+                msg=(s.get(\"message\") or \"\").strip()","+                if comp>=100 and 0<llm<900 and msg!=TD:","+                    calls.append((ts-llm/2, llm*1000/comp, comp, prompt, llm))","+            if ts: prev=ts","+    # concurrency via sweep per call: use sorted starts/ends","+    starts=sorted(x[0] for x in intervals); ends=sorted(x[1] for x in intervals)","+    def conc(t):","+        return bisect.bisect_right(starts,t)-bisect.bisect_left(ends,t)","+    buckets=collections.defaultdict(list)","+    for mid,ratio,comp,prompt,llm in calls:","+        c=conc(mid)","+        b = 0 if c<=2 else 1 if c<=5 else 2 if c<=10 else 3 if c<=20 else 4 if c<=40 else 5 if c<=60 else 6","+        buckets[b].append(ratio)","+    print(\"\\n===\",run,\"calls\",len(calls),\"intervals\",len(intervals))","+    labels=[\"<=2\",\"3-5\",\"6-10\",\"11-20\",\"21-40\",\"41-60\",\"61+\"]","+    for b in sorted(buckets):","+        v=sorted(buckets[b]); print(labels[b],\"n\",len(v),\"ms/tok med\",round(statistics.median(v),2),\"p25\",round(v[len(v)//4],2),\"p75\",round(v[3*len(v)//4],2))","+    # by prompt size bucket at high conc","+    pb=collections.defaultdict(list)","+    for mid,ratio,comp,prompt,llm in calls:","+        pb[min(prompt//20000,3)].append(ratio)","+    for b in sorted(pb):","+        v=pb[b]; print(\"prompt bucket\",b,\"n\",len(v),\"med ms/tok\",round(statistics.median(v),2))"],"newLines":57,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/latency_concurrency.py"}]}