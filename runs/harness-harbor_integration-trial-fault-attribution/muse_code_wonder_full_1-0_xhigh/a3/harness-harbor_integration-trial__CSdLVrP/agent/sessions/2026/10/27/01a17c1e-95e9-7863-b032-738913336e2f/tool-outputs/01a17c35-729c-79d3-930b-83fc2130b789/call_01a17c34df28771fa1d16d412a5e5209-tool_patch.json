{"files":[{"hunks":[{"lines":[" ","     python3 attribute.py <run_dir> <out.json>"," ","-<run_dir> is one finished run: the Harbor job directory under <run_dir>/job/ and, when the run went through the","-sandbox broker, the broker's audit log at <run_dir>/broker_audit.jsonl. Writes a JSON object with one entry per trial","-directory: \"policy\" (train on the recorded outcome, 0 included) or \"harness\" (do not train on it).","+<run_dir> is one finished run: the Harbor job directory under <run_dir>/job/","+and, when the run went through the sandbox broker, the broker's audit log","+at <run_dir>/broker_audit.jsonl. Writes a JSON object with one entry per","+trial directory: \"policy\" (train on the recorded outcome, 0 included) or","+\"harness\" (the harness / platform / infrastructure produced the outcome;","+do not train on it)."," ","-Current behaviour = what the trainer does today: every episode is the policy's.","+Method, in one paragraph: a verdict from the verifier is the policy's","+unless there is positive evidence that non-policy machinery decided the","+episode -- setup never reached the policy, the model-serving or sandbox","+platform errored or stalled, the broker killed/clamped the sandbox, the","+harness fabricated turns (context-recovery loop) for reasons outside the","+policy's control, or serving misrouted the policy's replies so no command","+ever ran. Failures a policy can bring on itself -- running out of the","+wall clock, the turn cap or the context window with its own commands and","+generations, killing its own tmux shell, malformed replies, or an","+artifact that hangs the verifier -- stay \"policy\", so dropping episodes","+cannot become an escape from a zero. See NOTES.md for the full rules."," \"\"\"","+import bisect"," import json"," import os","+import re"," import sys","+from collections import Counter, defaultdict, deque","+from datetime import datetime","+","+TD_TEXT = \"Technical difficulties. Please continue with the task.\"","+PARSE_OBS_PREFIX = \"Previous response had parsing errors:\"","+","+","+# --------------------------------------------------------------------------","+# small helpers","+# --------------------------------------------------------------------------","+","+def _ts(value):","+    if not value or not isinstance(value, str):","+        return None","+    try:","+        return datetime.fromisoformat(value.replace(\"Z\", \"+00:00\")).timestamp()","+    except ValueError:","+        return None","+","+","+def _dur(timing):","+    if not isinstance(timing, dict):","+        return None","+    a, b = _ts(timing.get(\"started_at\")), _ts(timing.get(\"finished_at\"))","+    if a is None or b is None:","+        return None","+    return b - a","+","+","+def _span(timing):","+    if not isinstance(timing, dict):","+        return (None, None)","+    return (_ts(timing.get(\"started_at\")), _ts(timing.get(\"finished_at\")))","+","+","+def _load_json(path):","+    try:","+        with open(path, encoding=\"utf-8\", errors=\"replace\") as fh:","+            return json.load(fh)","+    except Exception:","+        return None","+","+","+def _read_text(path, limit=None):","+    try:","+        with open(path, encoding=\"utf-8\", errors=\"replace\") as fh:","+            return fh.read(limit) if limit else fh.read()","+    except Exception:","+        return \"\"","+","+","+def _median(vals):","+    vals = sorted(vals)","+    if not vals:","+        return None","+    n = len(vals)","+    return vals[n // 2] if n % 2 else 0.5 * (vals[n // 2 - 1] + vals[n // 2])","+","+","+def _pct(vals, q):","+    vals = sorted(vals)","+    if not vals:","+        return None","+    return vals[min(len(vals) - 1, max(0, int(q * len(vals))))]","+","+","+_TIMEOUT_RE = re.compile(r\"timed out after ([\\d.]+) seconds\")","+_SERVER_MAX_RE = re.compile(","+    r\"Input length \\((\\d+) tokens\\) exceeds the maximum allowed length \\((\\d+)\")","+","+","+def _timeout_budget(message):","+    m = _TIMEOUT_RE.search(message or \"\")","+    return float(m.group(1)) if m else None","+","+","+# --------------------------------------------------------------------------","+# command-pattern evidence (from trajectory tool calls / broker send-keys)","+# --------------------------------------------------------------------------","+","+_KILL_PATTERNS = [","+    re.compile(r\"\\btmux\\s+(kill-server|kill-session|kill-pane|kill-window)\\b\"),","+    re.compile(r\"\\b(pkill|killall)\\b[^\\n]*\\b(bash|tmux|zsh|sh)\\b\"),","+    re.compile(r\"\\bkill\\s+(-[A-Z0-9]+\\s+)?(-1|1)\\b\"),","+    re.compile(r\"(^|[;&|]\\s*|\\n\\s*)(exit|logout)\\s*(\\d+\\s*)?($|[;&|]|\\n)\"),","+    re.compile(r\"(^|[;&|]\\s*|\\n\\s*)exec\\s+\\S\"),","+    re.compile(r\"\\b(shutdown|poweroff|reboot|halt)\\b\"),","+    re.compile(r\"\\binit\\s+[06]\\b\"),","+    re.compile(r\"\\brm\\b[^\\n]*(/tmp/tmux|tmux-0)\"),","+    re.compile(r\"\\bkill\\s+%(?!\\d)\"),","+]","+_TAMPER_PATH_RE = re.compile(r\"(/tests/|/logs/verifier|reward\\.(txt|json)\\b)\")","+_TAMPER_VERB_RE = re.compile(","+    r\"(rm\\b|chmod\\b|chown\\b|mv\\b|cp\\b|sed\\s+-i|tee\\b|truncate\\b|dd\\b|mount\\b|>|>>)\")","+_DISK_FILL_RE = re.compile(","+    r\"(\\bdd\\b[^\\n]*\\bof=/|\\bfallocate\\b[^\\n]*/|\\byes\\s*>|\\bmkfs\\b|rm\\s+-rf\\s+/(\\s|;|$))\")","+_SOURCE_RE = re.compile(r\"(^|[;&|]\\s*|\\n\\s*)(source|\\.)\\s+\\S+\")","+_EXEC_IN_SCRIPT_RE = re.compile(r\"(^|\\n)\\s*exec\\s+\\S\")","+","+","+def _looks_killer(cmd_text):","+    if not cmd_text:","+        return False","+    if cmd_text.strip() in (\"C-d\", \"C-D\"):","+        return True","+    return any(p.search(cmd_text) for p in _KILL_PATTERNS)","+","+","+def _looks_tamper(cmd_text):","+    if not cmd_text:","+        return False","+    if _DISK_FILL_RE.search(cmd_text):","+        return True","+    return bool(_TAMPER_PATH_RE.search(cmd_text) and _TAMPER_VERB_RE.search(cmd_text))","+","+","+def _structured_kind(text):","+    \"\"\"'json' / 'xml' if text carries a parseable-looking agent response.\"\"\"","+    if not text:","+        return None","+    if '\"commands\"' in text and '\"keystrokes\"' in text:","+        return \"json\"","+    if \"<commands>\" in text or (\"<response>\" in text and \"<keystrokes>\" in text):","+        return \"xml\"","+    return None","+","+","+# --------------------------------------------------------------------------","+# per-trial feature extraction","+# --------------------------------------------------------------------------","+","+class Trial:","+    __slots__ = (","+        \"name\", \"base\", \"result\", \"has_result\", \"task\", \"exc_type\", \"exc_msg\",","+        \"traceback\", \"reward\", \"has_verdict\", \"agent_name\", \"parser\",","+        \"max_input\", \"max_output\", \"max_turns\", \"verifier_disabled\",","+        \"env_setup_dur\", \"agent_setup_dur\", \"agent_dur\", \"verifier_dur\",","+        \"agent_span\", \"verifier_span\", \"started\", \"finished\",","+        \"n_steps\", \"n_agent_steps\", \"commands_total\", \"cmd_dur_sum\",","+        \"td_count\", \"td_trailing\", \"td_first_idx\", \"prev_prompt_before_td\",","+        \"parse_count\", \"parse_trailing\", \"misroute_candidate\",","+        \"empty_reasoning_structured\", \"killer_anywhere\", \"killer_recent\",","+        \"tamper_evidence\", \"sourced_exec_script\", \"submitted\",","+        \"session_ended_log\", \"log_counts\", \"first_out_idx\", \"first_ctx_idx\",","+        \"first_pro_idx\", \"free_first\", \"server_max_errs\", \"summ_fail_errors\",","+        \"calls\", \"last_step_ts\", \"distinct_ratio\", \"max_prompt\",","+        \"first_prompt_tokens\", \"initial_prompt_chars\", \"api_times\",","+        \"mini_exit_status\", \"mini_log_tail\", \"test_stdout_head\",","+        \"has_test_stdout\", \"broker\", \"label_reason\",","+    )"," ","+    def __init__(self, name, base):","+        self.name, self.base = name, base","+        self.result = None","+        self.has_result = False","+        self.task = None","+        self.exc_type, self.exc_msg, self.traceback = None, \"\", \"\"","+        self.reward, self.has_verdict = None, False","+        self.agent_name, self.parser = None, \"json\"","+        self.max_input = self.max_output = self.max_turns = None","+        self.verifier_disabled = False","+        self.env_setup_dur = self.agent_setup_dur = None","+        self.agent_dur = self.verifier_dur = None","+        self.agent_span = self.verifier_span = (None, None)","+        self.started = self.finished = None","+        self.n_steps = self.n_agent_steps = 0","+        self.commands_total, self.cmd_dur_sum = 0, 0.0","+        self.td_count = self.td_trailing = 0","+        self.td_first_idx, self.prev_prompt_before_td = None, None","+        self.parse_count = self.parse_trailing = 0","+        self.misroute_candidate = False","+        self.empty_reasoning_structured = 0","+        self.killer_anywhere = self.killer_recent = False","+        self.tamper_evidence = self.sourced_exec_script = False","+        self.submitted = False","+        self.session_ended_log = False","+        self.log_counts = {}","+        self.first_out_idx = self.first_ctx_idx = self.first_pro_idx = None","+        self.free_first = None","+        self.server_max_errs, self.summ_fail_errors = [], []","+        self.calls = []           # (llm_est_s, completion_tokens) per agent step","+        self.last_step_ts = None","+        self.distinct_ratio, self.max_prompt = None, None","+        self.first_prompt_tokens, self.initial_prompt_chars = None, 0","+        self.api_times = []","+        self.mini_exit_status, self.mini_log_tail = None, \"\"","+        self.test_stdout_head, self.has_test_stdout = \"\", False","+        self.broker = None","+        self.label_reason = \"\""," ","-def attribute(run_dir):","-    job = os.path.join(run_dir, \"job\")","-    out = {}","-    for name in sorted(os.listdir(job)):","-        if os.path.isfile(os.path.join(job, name, \"result.json\")):","-            out[name] = \"policy\"","-    return out"," ","+def _extract_result(tr):","+    r = _load_json(os.path.join(tr.base, \"result.json\"))","+    if isinstance(r, dict):","+        tr.result, tr.has_result = r, True","+    else:","+        # config.json at least proves the trial was created; use its shape.","+        cfg = _load_json(os.path.join(tr.base, \"config.json\"))","+        r = {\"config\": cfg} if isinstance(cfg, dict) else {}","+        tr.result = r","+    tr.task = r.get(\"task_name\")","+    cfg = r.get(\"config\") or {}","+    if not tr.task:","+        task_cfg = cfg.get(\"task\") or {}","+        tr.task = task_cfg.get(\"name\") or task_cfg.get(\"path\")","+    if not tr.task:","+        tr.task = tr.name.rsplit(\"__\", 1)[0]","+    agent_cfg = cfg.get(\"agent\") or {}","+    tr.agent_name = agent_cfg.get(\"name\") or (r.get(\"agent_info\") or {}).get(\"name\")","+    kwargs = agent_cfg.get(\"kwargs\") or {}","+    tr.parser = str(kwargs.get(\"parser_name\") or \"json\").lower()","+    model_info = kwargs.get(\"model_info\") or {}","+    tr.max_input = model_info.get(\"max_input_tokens\") or kwargs.get(\"max_seq_len\")","+    tr.max_output = model_info.get(\"max_output_tokens\")","+    tr.max_turns = kwargs.get(\"max_turns\") or kwargs.get(\"max_episodes\")","+    tr.verifier_disabled = bool((cfg.get(\"verifier\") or {}).get(\"disable\"))","+    exc = r.get(\"exception_info\") or {}","+    tr.exc_type = exc.get(\"exception_type\")","+    tr.exc_msg = exc.get(\"exception_message\") or \"\"","+    tr.traceback = exc.get(\"exception_traceback\") or \"\"","+    # multi-step trials carry per-step exceptions too; keep the first.","+    if not tr.exc_type:","+        for step in (r.get(\"step_results\") or []):","+            se = (step or {}).get(\"exception_info\") or {}","+            if se.get(\"exception_type\"):","+                tr.exc_type = se.get(\"exception_type\")","+                tr.exc_msg = se.get(\"exception_message\") or \"\"","+                tr.traceback = se.get(\"exception_traceback\") or tr.traceback","+                break","+    if not tr.traceback:","+        p = os.path.join(tr.base, \"exception.txt\")","+        if os.path.isfile(p):","+            tr.traceback = _read_text(p, limit=65536)","+    vr = r.get(\"verifier_result\") or {}","+    rewards = vr.get(\"rewards\") if isinstance(vr, dict) else None","+    if isinstance(rewards, dict) and rewards:","+        tr.has_verdict = True","+        val = rewards.get(\"reward\", next(iter(rewards.values()), None))","+        try:","+            tr.reward = float(val) if val is not None else None","+        except (TypeError, ValueError):","+            tr.reward = None","+    tr.env_setup_dur = _dur(r.get(\"environment_setup\"))","+    tr.agent_setup_dur = _dur(r.get(\"agent_setup\"))","+    tr.agent_dur = _dur(r.get(\"agent_execution\"))","+    tr.verifier_dur = _dur(r.get(\"verifier\"))","+    tr.agent_span = _span(r.get(\"agent_execution\"))","+    tr.verifier_span = _span(r.get(\"verifier\"))","+    tr.started, tr.finished = _ts(r.get(\"started_at\")), _ts(r.get(\"finished_at\"))","+    md = ((r.get(\"agent_result\") or {}).get(\"metadata\") or {})","+    if isinstance(md.get(\"api_request_times_msec\"), list):","+        tr.api_times = [float(x) / 1000.0 for x in md[\"api_request_times_msec\"]","+                        if isinstance(x, (int, float))]","+","+","+_LOG_KEYS = (","+    (\"ctx\", \"Context length exceeded\"),","+    (\"outlen\", \"Output length exceeded\"),","+    (\"proactive\", \"Proactively summarizing\"),","+    (\"pro_fail\", \"Error in proactively summarizing\"),","+    (\"full_ok\", \"Full summary succeeded\"),","+    (\"full_fail\", \"Full summary failed\"),","+    (\"short_ok\", \"Short summary succeeded\"),","+    (\"short_fail\", \"Short summary failed\"),","+    (\"fallback_fail\", \"Even fallback chat failed\"),","+)","+"," ","-if __name__ == \"__main__\":","-    with open(sys.argv[2], \"w\") as f:","-        json.dump(attribute(sys.argv[1]), f)","+def _extract_log(tr):","+    log = _read_text(os.path.join(tr.base, \"trial.log\"))","+    if not log:","+        tr.log_counts = {k: 0 for k, _s in _LOG_KEYS}","+        return","+    lines = log.splitlines()","+    counts = {k: 0 for k, _s in _LOG_KEYS}","+    for i, line in enumerate(lines):","+        for key, needle in _LOG_KEYS:","+            if needle in line:","+                counts[key] += 1","+                if key == \"outlen\" and tr.first_out_idx is None:","+                    tr.first_out_idx = i","+                elif key == \"ctx\" and tr.first_ctx_idx is None:","+                    tr.first_ctx_idx = i","+                elif key == \"proactive\" and tr.first_pro_idx is None:","+                    tr.first_pro_idx = i","+                if key in (\"full_fail\", \"short_fail\", \"pro_fail\", \"fallback_fail\"):","+                    _head, _sep, tail = line.partition(needle)","+                    err = tail.strip(\" :\")","+                    if err:","+                        tr.summ_fail_errors.append(err[:200])","+        if tr.free_first is None and \"Unwound messages.\" in line:","+            m = re.search(r\"Remaining messages: (\\d+), Free tokens: approximately (-?\\d+)\", line)","+            if m:","+                tr.free_first = (int(m.group(1)), int(m.group(2)))","+    tr.log_counts = counts","+    tr.session_ended_log = \"Session has ended, breaking out of agent loop\" in log","+    tr.server_max_errs = [(int(a), int(b)) for a, b in _SERVER_MAX_RE.findall(log[:2000000])]","+    # secondary verifier failures hide in the log when an agent exception","+    # was recorded first; remember them for the verifier rules.","+    if \"RewardFileNotFoundError\" in log:","+        counts[\"reward_not_found_log\"] = 1"],"newLines":328,"newStart":3,"oldLines":26,"oldStart":3}],"path":"/app/attribution/attribute.py"}]}