{"files":[{"hunks":[{"lines":["+import json, os","+from collections import defaultdict","+","+def task_of(t): return t.rsplit(\"__\",1)[0]","+","+for run in [\"/app/runs/tb21-2b-eval-1005\",\"/app/runs/pool-dry-pass-1011\"]:","+    job=os.path.join(run,\"job\")","+    rows={x[\"t\"]:x for x in json.load(open(f\"/tmp/rows_{os.path.basename(run)}.json\"))}","+    print(f\"\\n#### {run} verifier-duration sibling context for VerifierTimeout ####\")","+    by_task=defaultdict(list)","+    for t,x in rows.items(): by_task[task_of(t)].append(x)","+    for t,x in rows.items():","+        if x[\"exc\"]==\"VerifierTimeoutError\":","+            sib=[(s[\"t\"],s[\"exc\"],s[\"rew\"],s.get(\"ver_dur\")) for s in by_task[task_of(t)]]","+            print(f\" VT {t} budget-ver_dur={x.get('ver_dur')} siblings={sib}\")","+    # session ended trials","+    print(\" 'Session has ended' trials:\")","+    for t in rows:","+        p=os.path.join(job,t,\"trial.log\")","+        if os.path.exists(p) and \"Session has ended\" in open(p,errors=\"replace\").read():","+            x=rows[t]","+            print(f\"  {t} exc={x['exc']} rew={x['rew']} n_agent={x['n_agent']}\")","+    # trials with no verifier dir","+    nv=[t for t in rows if not os.path.exists(os.path.join(job,t,\"verifier\"))]","+    from collections import Counter","+    print(\" no-verifier-dir trials:\", len(nv), Counter((rows[t][\"exc\"],rows[t][\"rew\"]) for t in nv))","+","+# portfolio NOREW","+job=\"/app/runs/tb21-2b-eval-1005/job\"; t=\"portfolio-optimization__Yi9jUHS\"","+r=json.load(open(os.path.join(job,t,\"result.json\")))","+print(\"\\nportfolio NOREW result subset:\", {k:r.get(k) for k in [\"verifier_result\",\"verifier\",\"agent_execution\",\"finished_at\"]})","+print(\" trial.log tail:\")","+print(\"\\n\".join(open(os.path.join(job,t,\"trial.log\"),errors=\"replace\").read().splitlines()[-25:]))","+print(\" exception.txt tail:\")","+print(open(os.path.join(job,t,\"exception.txt\"),errors=\"replace\").read()[-1