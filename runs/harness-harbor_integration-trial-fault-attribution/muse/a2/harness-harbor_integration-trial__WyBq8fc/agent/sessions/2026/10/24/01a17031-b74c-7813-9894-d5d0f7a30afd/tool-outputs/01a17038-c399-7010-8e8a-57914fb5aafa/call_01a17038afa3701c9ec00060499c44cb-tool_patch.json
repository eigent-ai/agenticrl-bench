{"files":[{"hunks":[{"lines":["+import json, os","+run=\"/app/runs/pool-dry-pass-1011\"; job=os.path.join(run,\"job\")","+# broker map","+sb2trial={}; trial_events={}","+for line in open(os.path.join(run,\"broker_audit.jsonl\")):","+    r=json.loads(line)","+    if r.get(\"event\")==\"request\" and r.get(\"op\")==\"create\":","+        sb2trial[r[\"sandbox_id\"]]=(r.get(\"labels\") or {}).get(\"session\",\"\")","+trial2sb={v:k for k,v in sb2trial.items()}","+# sandbox_ended exited","+for line in open(os.path.join(run,\"broker_audit.jsonl\")):","+    r=json.loads(line)","+    if r.get(\"event\")==\"sandbox_ended\" and r.get(\"reason\")==\"exited\":","+        print(\"EXITED SANDBOX:\", sb2trial.get(r[\"sandbox_id\"]), r)","+","+# RuntimeError trials: last 3 genuine steps' commands + broker tail","+rows={x[\"t\"]:x for x in json.load(open(\"/tmp/rows_pool-dry-pass-1011.json\"))}","+rt=[t for t,x in rows.items() if x[\"exc\"]==\"RuntimeError\"]","+for t in sorted(rt):","+    steps=json.load(open(os.path.join(job,t,\"agent\",\"trajectory.json\")))[\"steps\"]","+    print(f\"\\n=== RuntimeError {t} ===\")","+    cmds=[]","+    for s in steps:","+        for tc in (s.get(\"tool_calls\") or []):","+            cmds.append((s[\"step_id\"], (tc.get(\"arguments\") or {}).get(\"keystrokes\",\"\")))","+    for sid,k in cmds[-4:]:","+        print(f\"  step{sid}: {k[:220]!r}\")","+    # last observation content tail","+    last=[s for s in steps if s.get(\"source\")==\"agent\"][-1]","+    obs=str(last.get(\"observation\"))[-400:]","+    print(\"  last obs tail:\",repr(obs))","+    sb=trial2sb.get(f\"{t}__env\")","+    print(\"  sandbox:\",sb)"],"newLines":33,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/explore5.py"}]}