L   199	    async def _close_bridge(self, user: Any = _UNSET_BRIDGE_USER) -> None:
L   200	        if self.bridge is None or not self._bridge_setup_started or self._bridge_closed:
L   201	            return
L   202	
L   203	        if user is _UNSET_BRIDGE_USER:
L   204	            user = self.task.config.agent.user
L   205	
L   206	        if self._bridge_cleanup_task is None:
L   207	            self._bridge_cleanup_task = asyncio.create_task(
L   208	                self._cleanup_bridge(user),
L   209	                name=f"bridge-cleanup-{self.config.trial_name}",
L   210	            )
L   211	
L   212	        cancellation: asyncio.CancelledError | None = None
L   213	        while not self._bridge_cleanup_task.done():
L   214	            try:
L   215	                await asyncio.shield(self._bridge_cleanup_task)
L   216	            except asyncio.CancelledError as exc:
L   217	                cancellation = exc
L   218	
L   219	        try:
L   220	            self._bridge_cleanup_task.result()
L   221	        except asyncio.CancelledError as exc:
L   222	            cancellation = cancellation or exc
L   223	        except Exception as exc:
L   224	            self.logger.warning("Bridge cleanup failed: %s", exc)
L   225	        finally:
L   226	            self._bridge_closed = True
L   227	
L   228	        if cancellation is not None:
L   229	            raise cancellation
