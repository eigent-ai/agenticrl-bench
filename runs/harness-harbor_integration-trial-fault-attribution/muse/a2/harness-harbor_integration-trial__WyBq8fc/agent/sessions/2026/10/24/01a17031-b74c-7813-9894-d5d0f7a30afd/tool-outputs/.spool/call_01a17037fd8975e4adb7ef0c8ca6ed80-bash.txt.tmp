L   142	    async def _cleanup_bridge(self, user: str | int | None) -> None:
L   143	        bridge = self.bridge
L   144	        if bridge is None:
L   145	            return
L   146	
L   147	        try:
L   148	            exec_env = self._bridge_exec_env()
L   149	        except Exception as exc:
