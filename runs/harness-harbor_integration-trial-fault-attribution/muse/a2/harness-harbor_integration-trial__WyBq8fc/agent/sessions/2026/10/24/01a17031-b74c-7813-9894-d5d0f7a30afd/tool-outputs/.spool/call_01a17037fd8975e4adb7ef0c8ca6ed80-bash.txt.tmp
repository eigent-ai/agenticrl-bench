L   185	                                )
L   186	                            except Exception as exc:
L   187	                                self.logger.warning(
L   188	                                    "Bridge trajectory export failed: %s", exc
L   189	                                )
L   190	                        await teardown()
L   191	            finally:
L   192	                if not teardown_attempted:
L   193	                    await teardown()
L   194	        except asyncio.CancelledError:
