L   151	                "Could not resolve bridge cleanup environment; continuing with "
L   152	                "configured agent environments: %s",
L   153	                exc,
L   154	            )
L   155	            exec_env = {
L   156	                **(self.user_agent.extra_env if self.user_agent is not None else {}),
L   157	                **self.agent.extra_env,
L   158	            }
L   159	
L   160	        teardown_attempted = False
L   161	
L   162	        async def teardown() -> None:
L   163	            nonlocal teardown_attempted
L   164	            teardown_attempted = True
L   165	            try:
L   166	                await asyncio.wait_for(
L   167	                    bridge.teardown(self.agent_environment),
L   168	                    timeout=self._agent_setup_timeout_sec,
L   169	                )
L   170	            except Exception as exc:
L   171	                self.logger.warning("Bridge teardown failed: %s", exc)
L   172	
L   173	        try:
L   174	            try:
L   175	                with self.agent_environment.with_default_user(user):
L   176	                    with self.agent_environment.scoped_exec_env(exec_env):
L   177	                        if self._bridge_ready:
L   178	                            try:
L   179	                                await asyncio.wait_for(
L   180	                                    bridge.export_trajectory(
