{"files":[{"hunks":[{"lines":["     if sum(k in s for k in (\"regex\", \"ebnf\", \"json_schema\", \"structural_tag\")) > 1:","         raise CanonError(\"sampling_verify:grammar_conflict\")","     return s","+","+","+# ---------------------------------------------------------------- rendering","+","+_TPL_CACHE = {}","+_TOK_CACHE = {}","+","+","+def _renderer(template_text):","+    if template_text in _TPL_CACHE:","+        return _TPL_CACHE[template_text]","+    import jinja2","+    from jinja2.sandbox import ImmutableSandboxedEnvironment","+","+    def raise_exception(message):","+        raise jinja2.exceptions.TemplateError(message)","+","+    def tojson(x, ensure_ascii=False, indent=None, separators=None, sort_keys=False):","+        return json.dumps(x, ensure_ascii=ensure_ascii, indent=indent,","+                          separators=separators, sort_keys=sort_keys)","+","+    import datetime as _dt","+","+    env = ImmutableSandboxedEnvironment(trim_blocks=True, lstrip_blocks=True,","+                                        extensions=[jinja2.ext.loopcontrols])","+    env.filters[\"tojson\"] = tojson","+    env.globals[\"raise_exception\"] = raise_exception","+    env.globals[\"strftime_now\"] = lambda fmt: _dt.datetime.now().strftime(fmt)","+    tpl = env.from_string(template_text)","+    _TPL_CACHE[template_text] = tpl","+    return tpl","+","+","+def _tokenizer(tok_dir):","+    key = str(tok_dir)","+    if key not in _TOK_CACHE:","+        from tokenizers import Tokenizer","+","+        _TOK_CACHE[key] = Tokenizer.from_file(str(Path(tok_dir) / \"tokenizer.json\"))","+    return _TOK_CACHE[key]","+","+","+def render_prompt_ids(body, serv):","+    \"\"\"Returns (prompt_token_ids, media) mirroring SGLang's jinja chat path.\"\"\"","+    import copy","+","+    msgs = normalize_messages(body[\"messages\"])","+    ctk = dict(body.get(\"chat_template_kwargs\") or {})","+    if not isinstance(ctk, dict):","+        raise CanonError(\"validation:chat_template_kwargs\")","+    effort = normalize_reasoning(body, ctk)","+    media = []","+    processed = []","+    for d in msgs:","+        m = dict(d)","+        if m.get(\"content\") is None:","+            m[\"content\"] = \"\"","+        p = _process_content(m, media)","+        p[\"content\"] = _norm_tool_content(p[\"role\"], p.get(\"content\"))","+        processed.append(p)","+    # continue_final_message / trailing-assistant handling (SGLang _handle_last_assistant_message)","+    assistant_prefix = None","+    cont = body.get(\"continue_final_message\")","+    if processed and processed[-1].get(\"role\") == \"assistant\" and isinstance(processed[-1].get(\"content\"), str):","+        if cont:","+            assistant_prefix = processed[-1][\"content\"]","+            processed = processed[:-1]","+        else:","+            processed[-1] = {\"role\": \"user\", \"content\": processed[-1][\"content\"]}","+    tools_eff = _effective_tools(body, msgs)","+    tool_choice = body.get(\"tool_choice\")","+    if tool_choice is None:","+        tool_choice = \"auto\" if tools_eff else \"none\"","+    tools = None","+    if tools_eff and tool_choice != \"none\":","+        dumped = [_tool_dump(t) for t in tools_eff]","+        if isinstance(tool_choice, dict):","+            fname = (tool_choice.get(\"function\") or {}).get(\"name\")","+            dumped = [t for t in dumped if t[\"function\"][\"name\"] == fname] or None","+        tools = dumped","+    extra = {}","+    if effort is not None:","+        extra[\"reasoning_effort\"] = effort","+    extra.update(ctk)","+    tpl = _renderer(serv[\"template\"])","+    try:","+        text = tpl.render(messages=processed, tools=tools, add_generation_prompt=True, **extra)","+    except Exception as e:","+        raise CanonError(f\"template:{type(e).__name__}\")","+    tok = _tokenizer(serv[\"tokenizer_dir\"])","+    ids = list(tok.encode(text).ids)","+    if assistant_prefix:","+        ids = ids + list(tok.encode(assistant_prefix).ids)","+    return ids, media, ctk, tools_eff, tool_choice","+","+","+def canon_request(req, serv):","+    \"\"\"Canonical, SGLang-effective form of one captured HTTP request.\"\"\"","+    body = req.get(\"body\")","+    path = (req.get(\"path\") or \"\").split(\"?\")[0].rstrip(\"/\")","+    if req.get(\"method\") == \"GET\" or not isinstance(body, dict):","+        return {\"endpoint\": f\"{req.get('method')} {path}\", \"sglang_error\": \"validation:body\"}","+    if path.endswith(\"/v1/responses\") or path.endswith(\"/responses\"):","+        return {\"endpoint\": \"responses\", \"sglang_error\": \"endpoint_not_chat\"}","+    headers = {k.lower(): v for k, v in (req.get(\"headers\") or {}).items()}","+    routing = {}","+    if body.get(\"session_id\") is not None:","+        routing[\"session_id\"] = body[\"session_id\"]","+    for h in (\"x-session-id\", \"x-smg-routing-key\", \"x-data-parallel-rank\"):","+        if headers.get(h) is not None:","+            routing[h] = headers[h]","+    try:","+        if path.endswith(\"/v1/completions\"):","+            prompt = body.get(\"prompt\")","+            tok = _tokenizer(serv[\"tokenizer_dir\"])","+            if isinstance(prompt, str):","+                ids = list(tok.encode(prompt).ids)","+            elif isinstance(prompt, list) and all(isinstance(i, int) for i in prompt):","+                ids = list(prompt)","+            else:","+                raise CanonError(\"validation:prompt\")","+            s = canon_sampling(body, {}, serv[\"vocab\"], False, None)","+            return {\"endpoint\": \"completions\", \"model\": body.get(\"model\"),","+                    \"prompt_ids\": ids, \"sampling\": s, \"routing\": routing}","+        if not path.endswith(\"/chat/completions\"):","+            return {\"endpoint\": path, \"sglang_error\": \"endpoint_not_chat\"}","+        if not isinstance(body.get(\"messages\"), list):","+            raise CanonError(\"validation:messages\")","+        if body.get(\"input_ids\") is not None:","+            ids = body[\"input_ids\"]","+            if not (isinstance(ids, list) and all(isinstance(i, int) for i in ids)):","+                raise CanonError(\"validation:input_ids\")","+            ctk = dict(body.get(\"chat_template_kwargs\") or {})","+            normalize_reasoning(body, ctk)","+            media = []","+        else:","+            ids, media, ctk, tools_eff, tool_choice = render_prompt_ids(body, serv)","+            s = canon_sampling(body, ctk, serv[\"vocab\"], bool(tools_eff), tool_choice)","+            return {\"endpoint\": \"chat\", \"model\": body.get(\"model\"), \"prompt_ids\": ids,","+                    \"media\": media, \"sampling\": s, \"routing\": routing}","+        s = canon_sampling(body, ctk, serv[\"vocab\"], False, body.get(\"tool_choice\"))","+        return {\"endpoint\": \"chat\", \"model\": body.get(\"model\"), \"prompt_ids\": ids,","+                \"media\": media, \"sampling\": s, \"routing\": routing}","+    except CanonError as e:","+        return {\"endpoint\": \"chat\", \"model\": body.get(\"model\"), \"sglang_error\": str(e),","+                \"routing\": routing}","+","+","+def ids_sha(ids):","+    return hashlib.sha256(\",\".join(map(str, ids)).encode()).hexdigest()","+","+","+# ---------------------------------------------------------------- harness runs","+","+def harness_env():","+    keep = {\"PATH\", \"HOME\", \"LANG\", \"LC_ALL\", \"SSL_CERT_FILE\", \"CUDA_VISIBLE_DEVICES\"}","+    env = {k: v for k, v in os.environ.items() if k in keep}","+    env.update({","+        \"PYTHONHASHSEED\": \"0\",","+        \"LITELLM_LOCAL_MODEL_COST_MAP\": \"True\",","+        \"NO_PROXY\": \"127.0.0.1,localhost\",","+        \"no_proxy\": \"127.0.0.1,localhost\",","+        \"GATE_LAUNCH\": str(LAUNCH),","+        \"GATE_EPISODES\": os.environ.get(\"GATE_EPISODES\", \"/app/episodes\"),","+        \"HOME\": env.get(\"HOME\") or \"/tmp\",","+    })","+    return env","+","+","+def run_group(python, group, out_dir, timeout=900):","+    Path(out_dir).mkdir(parents=True, exist_ok=True)","+    try:","+        p = subprocess.run(","+            [str(python), str(GATE_DIR / \"harness.py\"), \"--out\", str(out_dir), \"--group\", group],","+            env=harness_env(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,","+            timeout=timeout, text=True)","+        return p.returncode, p.stderr[-2000:]","+    except subprocess.TimeoutExpired:","+        return -9, \"harness timeout\"","+","+","+def run_stack(python, work, label, jobs=4):","+    root = Path(work) / label","+    root.mkdir(parents=True, exist_ok=True)","+    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as ex:","+        futs = {ex.submit(run_group, python, g, root / g): g for g in GROUPS}","+        codes = {}","+        for fut in concurrent.futures.as_completed(futs):","+            codes[futs[fut]] = fut.result()","+    scenarios, probes_data, requests = {}, {}, []","+    errors = []","+    for g in GROUPS:","+        rc, err = codes[g]","+        rp = root / g / \"results.json\"","+        if rc != 0 or not rp.exists():","+            errors.append(f\"{g}: harness rc={rc} {err[-300:]}\")","+            continue","+        data = json.loads(rp.read_text())","+        scenarios.update(data.get(\"scenarios\") or {})","+        probes_data.update(data.get(\"probes\") or {})","+        req_p = root / g / \"requests.jsonl\"","+        if req_p.exists():","+            requests.extend(json.loads(line) for line in req_p.read_text().splitlines() if line.strip())","+    return {\"scenarios\": scenarios, \"probes\": probes_data, \"requests\": requests, \"errors\": errors}","+"],"newLines":208,"newStart":436,"oldLines":3,"oldStart":436}],"path":"/app/gate/gate.py"}]}