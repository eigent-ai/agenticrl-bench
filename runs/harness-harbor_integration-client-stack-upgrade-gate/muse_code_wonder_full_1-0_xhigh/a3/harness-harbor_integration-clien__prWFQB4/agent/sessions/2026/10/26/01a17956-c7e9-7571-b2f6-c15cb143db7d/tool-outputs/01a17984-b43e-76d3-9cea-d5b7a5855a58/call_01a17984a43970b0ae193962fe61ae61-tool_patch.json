{"files":[{"hunks":[{"lines":["         out.append(f\"{path}: {a!r:.120} -> {b!r:.120}\")"," "," ","+def diff_subset(a, b, path, out, limit=4):","+    \"\"\"Diff only keys present in the reference (cand may add inert fields).\"\"\"","+    if len(out) >= limit:","+        return","+    if isinstance(a, dict) and isinstance(b, dict):","+        for k in sorted(a, key=str):","+            if k not in b:","+                out.append(f\"{path}.{k}: {a[k]!r:.80} -> <absent>\")","+            else:","+                diff_subset(a[k], b[k], f\"{path}.{k}\", out, limit)","+            if len(out) >= limit:","+                return","+    elif isinstance(a, list) and isinstance(b, list):","+        if len(a) != len(b):","+            out.append(f\"{path}: len {len(a)} -> {len(b)}\")","+            return","+        for i, (x, y) in enumerate(zip(a, b)):","+            diff_subset(x, y, f\"{path}[{i}]\", out, limit)","+            if len(out) >= limit:","+                return","+    elif a != b:","+        out.append(f\"{path}: {a!r:.100} -> {b!r:.100}\")","+","+"," def compare(ref, cand, servs, live_prompts=None, live_sampling=None):","     \"\"\"Returns list of human-readable difference lines (empty = interchangeable).\"\"\"","     diffs = []"],"newLines":30,"newStart":725,"oldLines":6,"oldStart":725}],"path":"/app/gate/gate.py"}]}