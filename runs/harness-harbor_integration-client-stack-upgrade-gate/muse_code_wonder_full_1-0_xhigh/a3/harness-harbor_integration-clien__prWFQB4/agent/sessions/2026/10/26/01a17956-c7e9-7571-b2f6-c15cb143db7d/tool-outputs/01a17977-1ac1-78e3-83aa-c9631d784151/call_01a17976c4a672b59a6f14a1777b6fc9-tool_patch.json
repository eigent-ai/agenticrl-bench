{"files":[{"hunks":[{"lines":["             requests.extend(json.loads(line) for line in req_p.read_text().splitlines() if line.strip())","     return {\"scenarios\": scenarios, \"probes\": probes_data, \"requests\": requests, \"errors\": errors}"," ","+","+# ---------------------------------------------------------------- comparison","+","+_UUID = re.compile(r\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")","+","+","+def norm_trajectory(traj):","+    def scrub(v):","+        if isinstance(v, str):","+            return _UUID.sub(\"<uuid>\", v)","+        if isinstance(v, list):","+            return [scrub(x) for x in v]","+        if isinstance(v, dict):","+            return {k: scrub(x) for k, x in v.items()}","+        return v","+","+    steps = []","+    for s in traj.get(\"steps\") or []:","+        d = {k: s.get(k) for k in (\"source\", \"message\", \"reasoning_content\",","+                                   \"tool_calls\", \"observation\", \"is_copied_context\", \"extra\")}","+        m = s.get(\"metrics\") or {}","+        keep = {k: m[k] for k in (\"prompt_token_ids\", \"completion_token_ids\", \"logprobs\") if m.get(k) is not None}","+        if keep:","+            d[\"metrics\"] = keep","+        steps.append(scrub(d))","+    agent = traj.get(\"agent\") or {}","+    extra = {k: v for k, v in (agent.get(\"extra\") or {}).items()","+             if k in (\"parser\", \"temperature\", \"continuation_index\", \"summarization_index\")}","+    return {\"agent\": {\"name\": agent.get(\"name\"), \"model_name\": agent.get(\"model_name\"), \"extra\": extra},","+            \"steps\": steps,","+            \"continued_trajectory_ref\": bool(traj.get(\"continued_trajectory_ref\"))}","+","+","+def outcome_view(o):","+    return {","+        \"status\": o.get(\"status\"),","+        \"sent\": o.get(\"sent\"),","+        \"summarization_count\": o.get(\"summarization_count\"),","+        \"n_episodes\": o.get(\"n_episodes\"),","+        \"rollout_details\": o.get(\"rollout_details\"),","+        \"trajectories\": [{\"name\": t[\"name\"], \"data\": norm_trajectory(t[\"data\"])}","+                         for t in o.get(\"trajectories\") or []],","+    }","+","+","+def group_requests(requests):","+    g = {}","+    for r in requests:","+        if r.get(\"method\") == \"GET\":","+            continue","+        g.setdefault(r.get(\"scenario\"), []).append(r)","+    for v in g.values():","+        v.sort(key=lambda r: r.get(\"seq\", 0))","+    return g","+","+","+def diff_values(a, b, path, out, limit=6):","+    if len(out) >= limit:","+        return","+    if type(a) is not type(b) and not (_isnum(a) and _isnum(b)):","+        out.append(f\"{path}: {a!r:.80} -> {b!r:.80}\")","+        return","+    if isinstance(a, dict):","+        for k in sorted(set(a) | set(b), key=str):","+            if k not in a:","+                out.append(f\"{path}.{k}: <absent> -> {b[k]!r:.80}\")","+            elif k not in b:","+                out.append(f\"{path}.{k}: {a[k]!r:.80} -> <absent>\")","+            else:","+                diff_values(a[k], b[k], f\"{path}.{k}\", out, limit)","+            if len(out) >= limit:","+                return","+    elif isinstance(a, list):","+        if len(a) != len(b):","+            out.append(f\"{path}: len {len(a)} -> {len(b)}\")","+        for i, (x, y) in enumerate(zip(a, b)):","+            diff_values(x, y, f\"{path}[{i}]\", out, limit)","+            if len(out) >= limit:","+                return","+    elif a != b:","+        out.append(f\"{path}: {a!r:.120} -> {b!r:.120}\")","+","+","+def compare(ref, cand, servs, live_prompts=None, live_sampling=None):","+    \"\"\"Returns list of human-readable difference lines (empty = interchangeable).\"\"\"","+    diffs = []","+    # outcomes","+    rsc, csc = ref[\"scenarios\"], cand[\"scenarios\"]","+    for sid in sorted(set(rsc) | set(csc)):","+        if sid not in rsc or sid not in csc:","+            diffs.append(f\"{sid}: scenario present in one stack only\")","+            continue","+        d = []","+        diff_values(outcome_view(rsc[sid]), outcome_view(csc[sid]), \"outcome\", d, limit=4)","+        for line in d[:4]:","+            diffs.append(f\"{sid}: {line}\")","+    # probes","+    rp, cp = ref[\"probes\"], cand[\"probes\"]","+    for k in sorted(set(rp) | set(cp)):","+        a, b = rp.get(k), cp.get(k)","+        if k in WHITEBOX_PROBES:","+            skipped = lambda v: isinstance(v, dict) and \"skipped\" in v","+            if skipped(a) or skipped(b):","+                continue","+        d = []","+        diff_values(a, b, k, d, limit=4)","+        for line in d[:4]:","+            diffs.append(f\"probe {line}\")","+    # requests","+    rg, cg = group_requests(ref[\"requests\"]), group_requests(cand[\"requests\"])","+    order = []","+    for sid in sorted(set(rg) | set(cg)):","+        ra, ca = rg.get(sid, []), cg.get(sid, [])","+        order.extend([(\"ref\", sid, r) for r in ra])","+        order.extend([(\"cand\", sid, r) for r in ca])","+        if len(ra) != len(ca):","+            diffs.append(f\"{sid}: request count {len(ra)} -> {len(ca)}\")","+        for i, (x, y) in enumerate(zip(ra, ca)):","+            cfg = x.get(\"config\") or y.get(\"config\")","+            serv = servs.get(cfg) or servs[\"rollout\"]","+            cx = canon_request(x, serv)","+            cy = canon_request(y, serv)","+            if live_prompts is not None:","+                lx = live_prompts.get((\"ref\", sid, i))","+                ly = live_prompts.get((\"cand\", sid, i))","+                if lx is not None and \"prompt_ids\" in cx:","+                    cx = dict(cx, prompt_ids=lx)","+                if ly is not None and \"prompt_ids\" in cy:","+                    cy = dict(cy, prompt_ids=ly)","+            if live_sampling is not None:","+                lx = live_sampling.get((\"ref\", sid, i))","+                ly = live_sampling.get((\"cand\", sid, i))","+                if lx is not None and \"sampling\" in cx:","+                    cx = dict(cx, sampling=lx)","+                if ly is not None and \"sampling\" in cy:","+                    cy = dict(cy, sampling=ly)","+            if cx == cy:","+                continue","+            # pinpoint","+            if cx.get(\"sglang_error\") != cy.get(\"sglang_error\"):","+                diffs.append(f\"{sid} req{i} ({cfg}): sglang validity {cx.get('sglang_error')} -> {cy.get('sglang_error')}\")","+                continue","+            if cx.get(\"prompt_ids\") != cy.get(\"prompt_ids\"):","+                a, b = cx.get(\"prompt_ids\") or [], cy.get(\"prompt_ids\") or []","+                k = next((j for j, (u, v) in enumerate(zip(a, b)) if u != v), min(len(a), len(b)))","+                diffs.append(f\"{sid} req{i} ({cfg}): prompt ids differ at {k} len {len(a)}->{len(b)} \"","+                             f\"sha {ids_sha(a)[:10]}->{ids_sha(b)[:10]}\")","+            d = []","+            cx2 = {k: v for k, v in cx.items() if k != \"prompt_ids\"}","+            cy2 = {k: v for k, v in cy.items() if k != \"prompt_ids\"}","+            diff_values(cx2, cy2, \"req\", d, limit=4)","+            for line in d[:3]:","+                diffs.append(f\"{sid} req{i} ({cfg}): {line}\")","+    return diffs, order","+","+"],"newLines":159,"newStart":641,"oldLines":3,"oldStart":641}],"path":"/app/gate/gate.py"}]}