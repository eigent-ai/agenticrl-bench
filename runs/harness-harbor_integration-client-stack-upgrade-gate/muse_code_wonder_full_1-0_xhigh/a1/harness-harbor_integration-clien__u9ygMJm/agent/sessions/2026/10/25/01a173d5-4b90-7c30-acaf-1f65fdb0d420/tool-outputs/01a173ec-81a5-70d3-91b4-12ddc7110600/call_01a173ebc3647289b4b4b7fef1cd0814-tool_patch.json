{"files":[{"hunks":[{"lines":["+#!/usr/bin/env python3","+\"\"\"Gate judge: compare a reference trace and a candidate trace.","+","+Requests are compared through SGLang's effective semantics, not wire bytes:","+the request is parsed with SGLang's own ChatCompletionRequest schema (when","+the engine venv is available), messages are processed the way serving_chat","+processes them, rendered with the launch config's served chat template and","+tokenized with its tokenizer; sampling is compared after SGLang request >","+generation_config > default resolution and SamplingParams normalization.","+Everything else in the traces (trial outcome: error type, terminal commands,","+trajectory, token counts, parser / tmux / reward probes) is compared as","+recorded.","+","+Live mode (ENGINE_LOG_DIR set): prompt ids are taken from SGLang's own","+request logs (request.received events, correlated by the rid the harness","+injected when forwarding), falling back to the sglext.input_ids hash the","+harness recorded from the live response.  Writes $GATE_REPORT with the","+candidate's per-chat-request prompt id hashes in replay order.","+\"\"\"","+import argparse","+import hashlib","+import json","+import os","+import re","+import sys","+from pathlib import Path","+from typing import Any","+","+APP = Path(\"/app\")","+DIFFS: list[str] = []","+MAX_DIFFS = 80","+","+","+def diff(msg: str):","+    if len(DIFFS) < MAX_DIFFS:","+        DIFFS.append(msg)","+","+","+def sha_ids(ids) -> str:","+    return hashlib.sha256(\",\".join(map(str, ids)).encode()).hexdigest()","+","+","+# --------------------------------------------------------------------------","+# Served-template derivation (mirrors serve_policy.sh / serve_ci.sh)","+# --------------------------------------------------------------------------","+def served_configs(app: Path, models: Path):","+    \"\"\"{serve_name: {tokenizer_dir, template_text}} with pins applied.\"\"\"","+    out: dict[str, Any] = {}","+","+    def build(tok_dir: Path, think: bool, ct: str | None):","+        tpl_path = (app / \"launch/templates/qwen3.5_fixed.jinja\"","+                    if ct == \"miles_fixed\" else tok_dir / \"chat_template.jinja\")","+        text = tpl_path.read_text()","+        # serve scripts: pin enable_thinking first, then preserve_thinking","+        # (miles_fixed) becomes the new first line; order is irrelevant here.","+        text = \"{%- set enable_thinking = \" + (\"true\" if think else \"false\") + \" %}\\n\" + text","+        if ct == \"miles_fixed\":","+            text = \"{%- set preserve_thinking = true %}\\n\" + text","+        return {\"tokenizer_dir\": tok_dir, \"template\": text}","+","+    for ck in sorted((app / \"launch/checkpoints\").iterdir()):","+        if not ck.is_dir():","+            continue","+        cj = json.loads((ck / \"checkpoint.json\").read_text())","+        ev = {}","+        if (ck / \"eval_config.json\").exists():","+            ev = json.loads((ck / \"eval_config.json\").read_text())","+        tok = models / Path(cj[\"tokenizer_dir\"]).name","+        if \"enable_thinking\" in ev and ev[\"enable_thinking\"] is not None:","+            think = bool(ev[\"enable_thinking\"])","+        else:","+            base = (tok / \"chat_template.jinja\").read_text()","+            think = \"enable_thinking is true\" not in base","+        out[ck.name] = build(tok, think, ev.get(\"chat_template\"))","+    recipe = (app / \"launch/rollout/recipe.env\").read_text()","+    m = re.search(r\"^HF_CHECKPOINT=(.+)$\", recipe, re.M)","+    rtok = models / Path(m.group(1).strip().strip(\"'\\\"\")).name","+    out[\"rollout\"] = build(rtok, True, \"miles_fixed\")","+    return out","+","+","+# --------------------------------------------------------------------------","+# SGLang request canonicalization","+# --------------------------------------------------------------------------","+CHAT_PATHS = (\"/v1/chat/completions\", \"/chat/completions\")","+","+IGNORE_OTHER = {","+    \"messages\", \"model\", \"rid\", \"extra_key\", \"cache_salt\", \"priority\",","+    \"user\", \"data_parallel_rank\", \"bootstrap_host\", \"bootstrap_port\",","+    \"bootstrap_room\", \"routed_dp_rank\", \"disagg_prefill_dp_rank\",","+    # folded into sampling (below) or prompt (chat_template_kwargs):","+    \"temperature\", \"top_p\", \"top_k\", \"min_p\", \"frequency_penalty\",","+    \"presence_penalty\", \"repetition_penalty\", \"max_tokens\",","+    \"max_completion_tokens\", \"min_tokens\", \"stop\", \"stop_token_ids\",","+    \"stop_regex\", \"logit_bias\", \"seed\", \"n\", \"regex\", \"ebnf\",","+    \"no_stop_trim\", \"ignore_eos\", \"skip_special_tokens\", \"custom_params\",","+    \"watermark\",","+}","+","+MANUAL_DEFAULTS = {","+    \"temperature\": None, \"top_p\": None, \"top_k\": None, \"min_p\": None,","+    \"repetition_penalty\": None, \"frequency_penalty\": 0.0,","+    \"presence_penalty\": 0.0, \"logprobs\": False, \"top_logprobs\": None,","+    \"max_tokens\": None, \"max_completion_tokens\": None, \"n\": 1,","+    \"response_format\": None, \"seed\": None, \"stop\": None, \"stream\": False,","+    \"stream_options\": None, \"tools\": None, \"tool_choice\": \"auto\",","+    \"parallel_tool_calls\": True, \"min_tokens\": 0, \"regex\": None,","+    \"ebnf\": None, \"stop_token_ids\": None, \"stop_regex\": None,","+    \"no_stop_trim\": False, \"ignore_eos\": False,","+    \"continue_final_message\": False, \"skip_special_tokens\": True,","+    \"lora_path\": None, \"session_id\": None, \"session_params\": None,","+    \"separate_reasoning\": True, \"stream_reasoning\": True,","+    \"chat_template_kwargs\": None, \"logit_bias\": None, \"custom_params\": None,","+    \"watermark\": None, \"input_ids\": None, \"reasoning_effort\": None,","+    \"return_token_ids\": False, \"return_prompt_token_ids\": False,","+}","+","+","+class Canonicalizer:","+    def __init__(self, served, work: Path):","+        self.served = served","+        self.cache: dict[str, Any] = {}","+        self.tokenizers: dict[str, Any] = {}","+        self.sglang_req = None","+        self.sampling_params_cls = None","+        try:","+            from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest","+            from sglang.srt.sampling.sampling_params import SamplingParams","+            self.sglang_req = ChatCompletionRequest","+            self.sampling_params_cls = SamplingParams","+        except Exception:","+            pass","+        self.work = work","+","+    # -- tokenizer / rendering -------------------------------------------","+    def tokenizer(self, serve_name: str):","+        if serve_name in self.tokenizers:","+            return self.tokenizers[serve_name]","+        cfg = self.served[serve_name]","+        tok = None","+        try:","+            from transformers import AutoTokenizer","+            d = self.work / f\"served-{serve_name}\"","+            d.mkdir(parents=True, exist_ok=True)","+            for f in (\"tokenizer.json\", \"tokenizer_config.json\",","+                      \"vocab.json\", \"merges.txt\"):","+                src = cfg[\"tokenizer_dir\"] / f","+                if src.exists():","+                    (d / f).write_bytes(src.read_bytes())","+            (d / \"chat_template.jinja\").write_text(cfg[\"template\"])","+            tok = AutoTokenizer.from_pretrained(str(d))","+            tok.chat_template = cfg[\"template\"]","+        except Exception:","+            tok = (\"manual\", cfg)","+        self.tokenizers[serve_name] = tok","+        return tok","+","+    def render_ids_manual(self, cfg, messages, tools, extra_kwargs):","+        \"\"\"Fallback when transformers is unavailable: jinja2 + tokenizers.\"\"\"","+        import jinja2","+        from tokenizers import Tokenizer","+","+        def raise_exception(msg=\"\"):","+            raise ValueError(msg)","+","+        env = jinja2.sandbox.SandboxedEnvironment(","+            trim_blocks=True, lstrip_blocks=True,","+            extensions=[\"jinja2.ext.loopcontrols\"], undefined=jinja2.Undefined)","+        env.filters[\"tojson\"] = lambda v, indent=None: json.dumps(","+            v, ensure_ascii=False, indent=indent)","+        env.globals[\"raise_exception\"] = raise_exception","+        tpl = env.from_string(cfg[\"template\"])","+        rendered = tpl.render(messages=messages, tools=tools,","+                              add_generation_prompt=True,","+                              add_vision_id=False, **extra_kwargs)","+        tk = Tokenizer.from_file(str(cfg[\"tokenizer_dir\"] / \"tokenizer.json\"))","+        return tk.encode(rendered).ids","+","+    def render_prompt_ids(self, serve_name, messages, tools, extra_kwargs,","+                          continue_final, input_ids):","+        if input_ids is not None:","+            return list(input_ids)","+        messages, prefix = handle_last_assistant(messages, continue_final)","+        tok = self.tokenizer(serve_name)","+        if isinstance(tok, tuple):","+            ids = self.render_ids_manual(self.served[serve_name], messages,","+                                          tools, extra_kwargs)","+        else:","+            ids = tok.apply_chat_template(","+                messages, tokenize=True, add_generation_prompt=True,","+                tools=tools, return_dict=False, **extra_kwargs)","+            ids = list(ids)","+        if prefix:","+            if isinstance(tok, tuple):","+                from tokenizers import Tokenizer","+                tk = Tokenizer.from_file(","+                    str(self.served[serve_name][\"tokenizer_dir\"] / \"tokenizer.json\"))","+                enc = tk.encode(prefix).ids","+            else:","+                enc = tok.encode(prefix)","+                if enc and tok.bos_token_id is not None and enc[0] == tok.bos_token_id:","+                    enc = enc[1:]","+            ids = ids + list(enc)","+        return ids","+","+    # -- one wire request ---------------------------------------------------","+    def canonical(self, serve_name: str, capture: dict[str, Any]):","+        \"\"\"Return (effective_tuple_dict, prompt_ids_or_None, note).\"\"\"","+        body = capture.get(\"body\")","+        path = capture.get(\"path\", \"\")","+        method = capture.get(\"method\", \"POST\")","+        if method != \"POST\" or not any(path.rstrip(\"/\").endswith(p) or p in path","+                                       for p in CHAT_PATHS):","+            return ({\"kind\": \"non-chat\", \"method\": method, \"path\": path},","+                    None, \"non-chat\")","+        if isinstance(body, dict) and \"__raw_b64__\" in body:","+            return ({\"kind\": \"invalid-json\", \"raw\": body[\"__raw_b64__\"][:200]},","+                    None, \"invalid json body\")","+        if not isinstance(body, dict):","+            return ({\"kind\": \"invalid-body\"}, None, \"body is not an object\")","+        key = hashlib.sha256(json.dumps(","+            [serve_name, body], sort_keys=True, default=str).encode()).hexdigest()","+        if key in self.cache:","+            return self.cache[key]","+        result = self._canonical_chat(serve_name, body, capture)","+        self.cache[key] = result","+        return result","+","+    def _canonical_chat(self, serve_name, body, capture):","+        if self.sglang_req is not None:","+            try:","+                req = self.sglang_req(**body)","+            except Exception as e:","+                return ({\"kind\": \"sglang-rejected\",","+                         \"error\": _pydantic_summary(e)}, None,","+                        \"SGLang request validation fails\")","+            reqd = req.model_dump()","+            try:","+                sp = req.to_sampling_params(","+                    stop=req.stop or [], model_generation_config={})","+            except Exception as e:","+                return ({\"kind\": \"sglang-rejected\",","+                         \"error\": f\"sampling: {type(e).__name__}\"}, None,","+                        \"sampling conversion fails\")","+            sampling, serr = self._normalize_sampling(sp)","+            if serr:","+                return ({\"kind\": \"sglang-rejected\", \"error\": serr}, None,","+                        \"sampling verify fails\")","+            other = {k: _canon(v) for k, v in reqd.items()","+                     if k not in IGNORE_OTHER}","+            ctk = dict(req.chat_template_kwargs or {})","+            eff_tools = None","+            if req.tools and req.tool_choice != \"none\":","+                eff_tools = [t.model_dump() for t in req.tools]","+            messages = process_messages([m.model_dump() for m in req.messages])","+            extra_kwargs = {}","+            if req.reasoning_effort is not None:","+                extra_kwargs[\"reasoning_effort\"] = req.reasoning_effort","+            extra_kwargs.update(ctk)","+            lora = req.lora_path","+            if req.model and \":\" in req.model:","+                lora = f\"model-lora:{req.model}\"","+            try:","+                ids = self.render_prompt_ids(","+                    serve_name, messages, eff_tools, extra_kwargs,","+                    req.continue_final_message, req.input_ids)","+            except Exception as e:","+                return ({\"kind\": \"sglang-rejected\",","+                         \"error\": f\"template: {type(e).__name__}: {str(e)[:120]}\"},","+                        None, \"chat template fails\")","+        else:","+            parsed, err = manual_parse(body)","+            if err:","+                return ({\"kind\": \"sglang-rejected\", \"error\": err}, None, err)","+            reqd = parsed","+            sampling = manual_sampling(parsed)","+            other = {k: _canon(v) for k, v in reqd.items()","+                     if k not in IGNORE_OTHER and k in body or k in","+                     (\"logprobs\", \"separate_reasoning\", \"return_token_ids\")}","+            other = {k: _canon(reqd.get(k)) for k in reqd","+                     if k not in IGNORE_OTHER}","+            messages = process_messages(parsed[\"messages\"])","+            eff_tools = parsed.get(\"tools\") or None","+            extra_kwargs = {}","+            if parsed.get(\"reasoning_effort\") is not None:","+                extra_kwargs[\"reasoning_effort\"] = parsed[\"reasoning_effort\"]","+            extra_kwargs.update(parsed.get(\"chat_template_kwargs\") or {})","+            lora = parsed.get(\"lora_path\")","+            try:","+                ids = self.render_prompt_ids(","+                    serve_name, messages, eff_tools, extra_kwargs,","+                    parsed.get(\"continue_final_message\", False),","+                    parsed.get(\"input_ids\"))","+            except Exception as e:","+                return ({\"kind\": \"sglang-rejected\",","+                         \"error\": f\"template: {type(e).__name__}\"},","+                        None, \"chat template fails\")","+        effective = {","+            \"kind\": \"chat\",","+            \"prompt_sha256\": sha_ids(ids),","+            \"prompt_n\": len(ids),","+            \"sampling\": sampling,","+            \"other\": other,","+            \"lora\": _canon(lora),","+            \"session_id\": reqd.get(\"session_id\"),","+        }","+        return effective, ids, \"ok\"","+","+    def _normalize_sampling(self, sp: dict[str, Any]):","+        try:","+            fields = {","+                \"max_new_tokens\", \"min_new_tokens\", \"stop\", \"stop_token_ids\",","+                \"stop_regex\", \"temperature\", \"top_p\", \"top_k\", \"min_p\",","+                \"presence_penalty\", \"frequency_penalty\", \"repetition_penalty\",","+                \"regex\", \"ebnf\", \"n\", \"no_stop_trim\", \"ignore_eos\",","+                \"skip_special_tokens\", \"logit_bias\", \"custom_params\",","+                \"sampling_seed\", \"spaces_between_special_tokens\", \"watermark\",","+                \"json_schema\", \"structural_tag\", \"ebnf_full_assistant\",","+            }","+            kw = {k: v for k, v in sp.items() if k in fields}","+            obj = self.sampling_params_cls(**kw)","+            obj.verify(248320)","+            out = {","+                \"max_new_tokens\": obj.max_new_tokens,","+                \"min_new_tokens\": obj.min_new_tokens,","+                \"stop\": sorted(obj.stop_strs) if isinstance(obj.stop_strs, list)","+                        else obj.stop_strs,","+                \"stop_token_ids\": sorted(obj.stop_token_ids)","+                        if obj.stop_token_ids else None,","+                \"stop_regex\": sorted(obj.stop_regex_strs)","+                        if isinstance(obj.stop_regex_strs, list)","+                        else obj.stop_regex_strs,","+                \"temperature\": obj.temperature, \"top_p\": obj.top_p,","+                \"top_k\": obj.top_k, \"min_p\": obj.min_p,","+                \"presence_penalty\": obj.presence_penalty,","+                \"frequency_penalty\": obj.frequency_penalty,","+                \"repetition_penalty\": obj.repetition_penalty,","+                \"regex\": obj.regex, \"ebnf\": obj.ebnf,","+                \"json_schema\": obj.json_schema,","+                \"structural_tag\": obj.structural_tag,","+                \"ebnf_full_assistant\": obj.ebnf_full_assistant,","+                \"n\": obj.n, \"no_stop_trim\": obj.no_stop_trim,","+                \"ignore_eos\": obj.ignore_eos,","+                \"skip_special_tokens\": obj.skip_special_tokens,","+                \"spaces_between_special_tokens\": obj.spaces_between_special_tokens,","+                \"logit_bias\": _canon(obj.logit_bias),","+                \"custom_params\": _canon(obj.custom_params),","+                \"sampling_seed\": obj.sampling_seed,","+                \"watermark\": _canon(obj.watermark),","+            }","+            return out, None","+        except Exception as e:","+            return None, f\"verify: {type(e).__name__}: {str(e)[:120]}\"","+","+","+def _pydantic_summary(e: Exception) -> str:","+    try:","+        errs = e.errors()  # type: ignore","+        return \";\".join(f\"{'.'.join(map(str, er.get('loc', [])))}:{er.get('type')}\"","+                        for er in errs[:4])","+    except Exception:","+        return f\"{type(e).__name__}\"","+","+","+def _canon(v):","+    if isinstance(v, dict):","+        return {str(k): _canon(x) for k, x in sorted(v.items(), key=lambda kv: str(kv[0]))}","+    if isinstance(v, (list, tuple)):","+        return [_canon(x) for x in v]","+    if isinstance(v, (set, frozenset)):","+        return sorted(_canon(x) for x in v)","+    if isinstance(v, float) and v != v:","+        return \"NaN\"","+    if hasattr(v, \"model_dump\"):","+        return _canon(v.model_dump())","+    return v","+","+","+def handle_last_assistant(messages, continue_final):","+    messages = list(messages)","+    prefix = None","+    if messages and messages[-1].get(\"role\") == \"assistant\":","+        content = messages[-1].get(\"content\")","+        if isinstance(content, str):","+            if continue_final:","+                prefix = content","+                messages = messages[:-1]","+            else:","+                messages[-1] = {\"role\": \"user\", \"content\": content}","+    return messages, prefix","+","+","+def process_messages(messages):","+    \"\"\"Mirror serving_chat (jinja path, 'openai' content format).\"\"\"","+    out = []","+    for msg in messages:","+        m = dict(msg)","+        # normalize tool-call arguments (JSON string -> object)","+        if m.get(\"role\") == \"assistant\" and isinstance(m.get(\"tool_calls\"), list):","+            for item in m[\"tool_calls\"]:","+                fn = item.get(\"function\") if isinstance(item, dict) else None","+                if isinstance(fn, dict) and isinstance(fn.get(\"arguments\"), str):","+                    fn[\"arguments\"] = json.loads(fn[\"arguments\"])","+        if m.get(\"content\") is None:","+            m[\"content\"] = \"\"","+        if isinstance(m.get(\"content\"), list):","+            parts = []","+            for chunk in m[\"content\"]:","+                if not isinstance(chunk, dict):","+                    continue","+                t = chunk.get(\"type\")","+                if t in (\"image_url\", \"input_image\"):","+                    parts.append({\"type\": \"image\"})","+                elif t == \"video_url\":","+                    parts.append({\"type\": \"video\"})","+                elif t == \"audio_url\":","+                    parts.append({\"type\": \"audio\"})","+                elif t in (\"text\", \"input_text\"):","+                    parts.append({\"type\": \"text\", \"text\": chunk.get(\"text\", \"\")})","+                elif t == \"tool_reference\":","+                    parts.append(chunk)","+                # thinking/reasoning and unknown parts are dropped by SGLang","+            new = {k: v for k, v in m.items() if v is not None and k != \"content\"}","+            new[\"content\"] = parts","+            m = new","+        else:","+            m = {k: v for k, v in m.items() if v is not None}","+        # normalize_tool_content","+        if m.get(\"role\") == \"tool\" and isinstance(m.get(\"content\"), list):","+            ps = m[\"content\"]","+            if all((isinstance(p, dict) and p.get(\"type\") == \"text\")","+                   or isinstance(p, str) for p in ps):","+                m[\"content\"] = \" \".join(","+                    p.get(\"text\", \"\") if isinstance(p, dict) else p for p in ps)","+        out.append(m)","+    return out","+","+","+def manual_parse(body):","+    if not isinstance(body.get(\"messages\"), list) or not body[\"messages\"]:","+        return None, \"messages missing\"","+    for m in body[\"messages\"]:","+        if not isinstance(m, dict) or m.get(\"role\") not in (","+                \"user\", \"assistant\", \"system\", \"tool\", \"function\", \"developer\"):","+            return None, f\"bad message role {m.get('role') if isinstance(m, dict) else type(m)}\"","+    parsed = dict(MANUAL_DEFAULTS)","+    parsed.update({k: v for k, v in body.items() if k in MANUAL_DEFAULTS","+                   or k in (\"messages\", \"model\", \"tools\",","+                            \"return_prompt_token_ids\")})","+    parsed[\"messages\"] = body[\"messages\"]","+    return parsed, None","+","+","+def manual_sampling(p):","+    def gp(name, default):","+        v = p.get(name)","+        return default if v is None else v","+    return {","+        \"temperature\": gp(\"temperature\", 1.0), \"top_p\": gp(\"top_p\", 1.0),","+        \"top_k\": gp(\"top_k\", -1), \"min_p\": gp(\"min_p\", 0.0),","+        \"repetition_penalty\": gp(\"repetition_penalty\", 1.0),","+        \"max_new_tokens\": p.get(\"max_completion_tokens\") or p.get(\"max_tokens\"),","+        \"min_new_tokens\": p.get(\"min_tokens\", 0),","+        \"stop\": p.get(\"stop\"), \"stop_token_ids\": p.get(\"stop_token_ids\"),","+        \"stop_regex\": p.get(\"stop_regex\"),","+        \"presence_penalty\": p.get(\"presence_penalty\", 0.0),","+        \"frequency_penalty\": p.get(\"frequency_penalty\", 0.0),","+        \"n\": p.get(\"n\", 1), \"no_stop_trim\": p.get(\"no_stop_trim\", False),","+        \"ignore_eos\": p.get(\"ignore_eos\", False),","+        \"skip_special_tokens\": p.get(\"skip_special_tokens\", True),","+        \"spaces_between_special_tokens\": (p.get(\"chat_template_kwargs\") or {}).get(","+            \"spaces_between_special_tokens\", True)","+        if p.get(\"chat_template_kwargs\") is not None else True,","+        \"sampling_seed\": p.get(\"seed\"),","+    }"],"newLines":475,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/gate/judge.py"}]}