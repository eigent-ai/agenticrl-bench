{"files":[{"hunks":[{"lines":["+#!/usr/bin/env python3","+\"\"\"Gate replay harness: run under ONE client venv (reference or candidate).","+","+Drives the real Harbor Terminus-2 agent + LiteLLM stack of that venv against","+a scripted fake policy server and a fake tmux terminal, over (a) the recorded","+episodes, (b) synthetic messy/long agent scenarios for every launch config,","+and (c) direct probes of the LLM layer, parsers, tmux key/output handling,","+CLI/config parsing and verifier reward parsing.  Writes a JSON trace of","+everything server- or trial-visible.  A separate judge compares two traces","+through SGLang's effective-request semantics.","+","+Live mode (ENGINE_URLS set): every wire request the stack produces is also","+forwarded to the real SGLang server for its launch config (generation capped","+to 1 token; scripted responses still drive the agent) so SGLang tokenizes and","+logs it.  The per-request prompt id hash returned in sglext.input_ids is","+recorded in the trace.","+\"\"\"","+import argparse","+import asyncio","+import base64","+import hashlib","+import importlib.util","+import json","+import os","+import re","+import sys","+import threading","+import time","+import traceback","+import urllib.error","+import urllib.request","+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer","+from pathlib import Path","+from typing import Any","+","+os.environ.setdefault(\"LITELLM_LOCAL_MODEL_COST_MAP\", \"True\")","+os.environ.setdefault(\"TOKENIZERS_PARALLELISM\", \"false\")","+","+# Retry/backoff sleeps (tenacity/litellm) and tmux min-wait sleeps are","+# wall-clock only; cap them so error probes fit the time budget.  Patch","+# before importing harbor/litellm (done lazily below).","+_orig_async_sleep = asyncio.sleep","+","+","+async def _capped_async_sleep(delay=0, *a, **k):","+    await _orig_async_sleep(min(float(delay or 0), 0.05))","+","+","+asyncio.sleep = _capped_async_sleep  # type: ignore","+_orig_time_sleep = time.sleep","+time.sleep = lambda s: _orig_time_sleep(min(float(s or 0), 0.05))  # type: ignore","+","+SIDE = \"cand\"","+APP = Path(\"/app\")","+LIVE_URLS: dict[str, str] = {}","+TRACE: dict[str, Any] = {\"scenarios\": [], \"probes\": {}}","+UUID_RE = re.compile(r\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")","+HEX32_RE = re.compile(r\"\\b[0-9a-f]{32}\\b\")","+","+","+def enc_name(e: BaseException) -> str:","+    return type(e).__name__","+","+","+def sha_ids(ids) -> str:","+    return hashlib.sha256(\",\".join(map(str, ids)).encode()).hexdigest()","+","+","+# --------------------------------------------------------------------------","+# Scripted policy server","+# --------------------------------------------------------------------------","+DROP = object()","+","+","+class CaptureState:","+    def __init__(self):","+        self.requests: list[dict[str, Any]] = []","+        self.scenario_id = \"\"","+        self.launch_config = \"\"","+        self.responder = None  # callable(state, capture) -> (status, payload)","+        self.seq = 0","+        self.lock = threading.Lock()","+","+","+STATE = CaptureState()","+","+","+def make_chat_response(content=\"\", reasoning=None, finish=\"stop\",","+                       prompt_tokens=111, completion_tokens=22,","+                       logprobs=None, prompt_ids=None, response_ids=None,","+                       extra_choice=None, usage_extra=None):","+    choice = {","+        \"index\": 0,","+        \"message\": {\"role\": \"assistant\", \"content\": content,","+                    \"reasoning_content\": reasoning},","+        \"finish_reason\": finish,","+        \"matched_stop\": None,","+    }","+    if logprobs is not None:","+        choice[\"logprobs\"] = {\"content\": logprobs}","+    if prompt_ids is not None:","+        choice[\"prompt_token_ids\"] = prompt_ids","+    if response_ids is not None:","+        choice[\"response_token_ids\"] = response_ids","+    if extra_choice:","+        choice.update(extra_choice)","+    usage = {\"prompt_tokens\": prompt_tokens,","+             \"completion_tokens\": completion_tokens,","+             \"total_tokens\": prompt_tokens + completion_tokens}","+    if usage_extra:","+        usage.update(usage_extra)","+    return {\"id\": \"gate-resp\", \"object\": \"chat.completion\", \"created\": 1,","+            \"model\": \"policy\", \"choices\": [choice], \"usage\": usage}","+","+","+def sglang_error(status, message, err_type=\"BadRequestError\"):","+    return status, {\"object\": \"error\", \"message\": message, \"type\": err_type,","+                    \"param\": None, \"code\": status}","+","+","+CTX_MSG_1 = (\"The input (70000 tokens) is longer than the model's context \"","+             \"length (65536 tokens).\")","+CTX_MSG_2 = (\"Requested token count exceeds the model's maximum context \"","+             \"length of 65536 tokens. You requested a total of 70000 tokens: \"","+             \"69000 tokens from the input messages and 1000 tokens for the \"","+             \"completion. Please reduce the number of tokens in the input \"","+             \"messages or the completion to fit within the limit.\")","+","+","+def forward_live(capture: dict[str, Any], body_bytes: bytes) -> None:","+    \"\"\"Forward one captured chat request to the real SGLang server.\"\"\"","+    url = LIVE_URLS.get(STATE.launch_config) or LIVE_URLS.get(\"rollout\")","+    if not url or capture.get(\"body\") is None:","+        return","+    try:","+        body = json.loads(body_bytes)","+    except Exception:","+        return","+    if not isinstance(body, dict):","+        return","+    rid = f\"gate-{SIDE}-{capture['seq']}\"","+    fwd = dict(body)","+    fwd[\"rid\"] = rid","+    # Only prompt tokenization matters live; scripted replies drive the","+    # agent, so don't pay for a full generation per replayed request.","+    fwd[\"max_tokens\"] = 1","+    fwd[\"max_completion_tokens\"] = 1","+    live = {\"rid\": rid}","+    try:","+        req = urllib.request.Request(","+            url.rstrip(\"/\") + \"/chat/completions\",","+            data=json.dumps(fwd).encode(),","+            headers={\"Content-Type\": \"application/json\"}, method=\"POST\")","+        with urllib.request.urlopen(req, timeout=600) as resp:","+            payload = json.loads(resp.read().decode(\"utf-8\", \"replace\"))","+        live[\"status\"] = 200","+        ids = (((payload.get(\"sglext\") or {}).get(\"input_ids\"))","+               if isinstance(payload, dict) else None)","+        if ids is not None:","+            live[\"prompt_ids_sha256\"] = sha_ids(ids)","+            live[\"prompt_n\"] = len(ids)","+    except urllib.error.HTTPError as e:","+        live[\"status\"] = e.code","+        try:","+            live[\"error_body\"] = e.read().decode(\"utf-8\", \"replace\")[:400]","+        except Exception:","+            pass","+    except Exception as e:  # connection etc.","+        live[\"status\"] = None","+        live[\"error_body\"] = f\"{enc_name(e)}: {e}\"[:400]","+    capture[\"live\"] = live","+","+","+class Handler(BaseHTTPRequestHandler):","+    protocol_version = \"HTTP/1.1\"","+","+    def log_message(self, *a):","+        pass","+","+    def _handle(self, method):","+        n = int(self.headers.get(\"Content-Length\") or 0)","+        raw = self.rfile.read(n) if n else b\"\"","+        body = None","+        if raw:","+            try:","+                body = json.loads(raw)","+            except Exception:","+                body = {\"__raw_b64__\": base64.b64encode(raw).decode()}","+        with STATE.lock:","+            STATE.seq += 1","+            capture = {","+                \"seq\": STATE.seq,","+                \"scenario\": STATE.scenario_id,","+                \"launch_config\": STATE.launch_config,","+                \"method\": method,","+                \"path\": self.path,","+                \"headers\": {k.lower(): v for k, v in self.headers.items()","+                            if k.lower() in (\"authorization\", \"x-session-id\",","+                                             \"content-type\")},","+                \"auth_sha256\": hashlib.sha256(","+                    (self.headers.get(\"Authorization\") or \"\").encode()","+                ).hexdigest() if self.headers.get(\"Authorization\") else None,","+                \"body\": body,","+            }","+            STATE.requests.append(capture)","+            responder = STATE.responder","+        if method == \"POST\" and LIVE_URLS:","+            forward_live(capture, raw)","+        if method == \"GET\":","+            status, payload = 200, {\"object\": \"list\", \"data\": [","+                {\"id\": \"policy\", \"object\": \"model\", \"created\": 1,","+                 \"owned_by\": \"sglang\"}]}","+        elif responder is not None:","+            try:","+                status, payload = responder(capture)","+            except Exception as e:","+                status, payload = 500, {\"object\": \"error\",","+                                        \"message\": f\"responder {e}\",","+                                        \"type\": \"BadRequestError\",","+                                        \"param\": None, \"code\": 500}","+        else:","+            status, payload = 200, make_chat_response(content=\"{}\")","+        if payload is DROP:","+            self.connection.close()","+            return","+        if isinstance(payload, (bytes, bytearray)):","+            data = bytes(payload)","+        elif isinstance(payload, str):","+            data = payload.encode()","+        else:","+            data = json.dumps(payload).encode()","+        self.send_response(status)","+        self.send_header(\"Content-Type\", \"application/json\")","+        self.send_header(\"Content-Length\", str(len(data)))","+        self.end_headers()","+        self.wfile.write(data)","+","+    def do_POST(self):","+        self._handle(\"POST\")","+","+    def do_GET(self):","+        self._handle(\"GET\")","+","+    def do_PUT(self):","+        self._handle(\"PUT\")","+","+    def do_DELETE(self):","+        self._handle(\"DELETE\")","+","+","+# --------------------------------------------------------------------------","+# Fake terminal / environment","+# --------------------------------------------------------------------------","+class TermState:","+    def __init__(self, outputs, screen=None, timeout_substrs=(),","+                 alive_checks=None):","+        self.outputs = list(outputs)          # queue for get_incremental_output","+        self.screen = screen                   # capture_pane override","+        self.timeout_substrs = tuple(timeout_substrs)","+        self.alive_checks = alive_checks       # int: alive for first N checks","+        self.commands: list[dict[str, Any]] = []","+        self.alive_calls = 0","+        self.last_output = \"\"","+","+","+CURRENT_TERM: TermState | None = None","+","+","+class FakeTmuxSession:","+    def __init__(self, *a, **k):","+        self.st: TermState = CURRENT_TERM  # type: ignore","+","+    async def start(self):","+        return None","+","+    async def stop(self):","+        return None","+","+    async def send_keys(self, keys, block=False, min_timeout_sec=0.0, **k):","+        ks = keys if isinstance(keys, str) else list(keys)","+        self.st.commands.append(","+            {\"keystrokes\": ks, \"duration\": float(min_timeout_sec or 0)})","+        text = ks if isinstance(ks, str) else \" \".join(map(str, ks))","+        if any(s in text for s in self.st.timeout_substrs):","+            raise TimeoutError(\"fake terminal timeout\")","+","+    async def get_incremental_output(self):","+        if self.st.outputs:","+            self.st.last_output = self.st.outputs.pop(0)","+        return self.st.last_output","+","+    async def capture_pane(self, capture_entire=False):","+        return self.st.screen if self.st.screen is not None else self.st.last_output","+","+    async def is_session_alive(self):","+        self.st.alive_calls += 1","+        if self.st.alive_checks is not None and self.st.alive_calls > self.st.alive_checks:","+            return False","+        return True","+","+","+class _TP:","+    def __init__(self, agent_dir):","+        self.agent_dir = agent_dir","+","+","+class FakeEnv:","+    def __init__(self, tmp: Path):","+        self.trial_paths = _TP(tmp)","+        self.default_user = \"root\"","+        self.session_id = \"fake-env\"","+        self.skills_dir = None","+","+    async def exec(self, *a, **k):  # only used if some path bypasses tmux fake","+        class R:","+            return_code = 0","+            stdout = \"\"","+            stderr = \"\"","+        return R()","+","+    async def is_dir(self, *a, **k):","+        return False"],"newLines":322,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/gate/harness.py"}]}