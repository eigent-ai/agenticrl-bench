nt\": \"\"}],","+    [{\"role\": \"assistant\", \"content\": \"only assistant\"}],","+    [{\"role\": \"user\", \"content\": \"line\\n\" * 500}],","+]","+","+","+def build_scenarios(path):","+    os.environ.setdefault(\"LITELLM_LOCAL_MODEL_COST_MAP\", \"True\")","+    from harbor.agents.terminus_2.terminus_json_plain_parser import TerminusJSONPlainParser","+    from harbor.agents.terminus_2.terminus_xml_plain_parser import TerminusXMLPlainParser","+    from litellm.utils import token_counter","+    parsers = {\"json\": TerminusJSONPlainParser(), \"xml\": TerminusXMLPlainParser()}","+    launches, servers = parse_launch_configs()","+    episodes = load_episodes(parsers)","+    scenarios = []","+    for ep in episodes:","+        scenarios.append({\"kind\": \"chat\", \"id\": \"ep-chat/\" + ep[\"id\"], \"launch\": ep[\"launch\"],","+                          \"instruction\": ep[\"instruction\"], \"terminal_state\": ep[\"terminal_state\"],","+                          \"actions\": ep[\"actions\"], \"prompts_after\": ep[\"prompts_after\"]})","+        scenarios.append({\"kind\": \"loop\", \"id\": \"ep-loop/\" + ep[\"id\"], \"launch\": ep[\"launch\"],","+                          \"instruction\": ep[\"instruction\"], \"actions\": ep[\"actions\"],","+                          \"outputs\": ep[\"outputs\"]})","+    cross = [e for e in episodes if e[\"id\"].endswith(\"nginx-request-logging__vPAKjsQ\")","+             or e[\"id\"].endswith(\"fix-git__YY3bNYg\")]","+    for ep in cross:","+        for launch in launches:","+            if launch == ep[\"launch\"]:","+                continue","+            n = min(8, len(ep[\"actions\"]))","+            scenarios.append({\"kind\": \"chat\", \"id\": f\"cross/{launch}/{ep['id']}\", \"launch\": launch,","+                              \"instruction\": ep[\"instruction\"], \"terminal_state\": ep[\"terminal_state\"],","+                              \"actions\": ep[\"actions\"][:n], \"prompts_after\": ep[\"prompts_after\"][:n]})","+