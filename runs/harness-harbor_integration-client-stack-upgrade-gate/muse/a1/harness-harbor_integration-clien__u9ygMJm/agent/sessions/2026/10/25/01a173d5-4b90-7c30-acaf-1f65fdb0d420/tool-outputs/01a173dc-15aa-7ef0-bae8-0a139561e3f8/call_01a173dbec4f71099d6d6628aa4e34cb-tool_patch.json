{"files":[{"hunks":[{"lines":["+import os, json, asyncio, threading","+os.environ.setdefault(\"LITELLM_LOCAL_MODEL_COST_MAP\", \"True\")","+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer","+","+CAPTURED=[]","+SCRIPT=[]","+class H(BaseHTTPRequestHandler):","+    def log_message(self,*a): pass","+    def do_POST(self):","+        n=int(self.headers.get(\"Content-Length\",0)); body=self.rfile.read(n)","+        CAPTURED.append({\"path\":self.path,\"headers\":dict(self.headers),\"body\":json.loads(body) if body else None})","+        resp=SCRIPT.pop(0) if SCRIPT else (200,{\"id\":\"x\",\"object\":\"chat.completion\",\"model\":\"policy\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"{}\",\"reasoning_content\":\"R1\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":5,\"total_tokens\":15}})","+        code,payload=resp","+        b=json.dumps(payload).encode()","+        self.send_response(code); self.send_header(\"Content-Type\",\"application/json\"); self.send_header(\"Content-Length\",str(len(b))); self.end_headers(); self.wfile.write(b)","+","+srv=ThreadingHTTPServer((\"127.0.0.1\",0),H); port=srv.server_address[1]","+threading.Thread(target=srv.serve_forever,daemon=True).start()","+base=f\"http://127.0.0.1:{port}/v1\"","+","+async def main():","+    from harbor.llms.lite_llm import LiteLLM","+    from harbor.llms.chat import Chat","+    MI={\"max_input_tokens\":65536,\"max_output_tokens\":8192,\"input_cost_per_token\":0,\"output_cost_per_token\":0}","+    # Case A: eval exp1 style: temp in constructor, extra_body top_p/top_k per call, interleaved","+    llm=LiteLLM(model_name=\"hosted_vllm/policy\", temperature=0.8, api_base=base, model_info=dict(MI))","+    print(\"supported_params=\", llm._supported_params, \"resp_fmt=\", llm._supports_response_format)","+    print(\"ctx_limit=\", llm.get_model_context_limit(), \"out_limit=\", llm.get_model_output_limit())","+    chat=Chat(llm, interleaved_thinking=True)","+    r=await chat.chat(\"hello task\", extra_body={\"top_p\":1.0,\"top_k\":-1})","+    print(\"resp1\", r.content, \"|\", r.reasoning_content, \"|\", r.usage)","+    r=await chat.chat(\"second turn\", extra_body={\"top_p\":1.0,\"top_k\":-1})","+    print(\"resp2\", r.content, \"|\", r.reasoning_content)","+    print(\"chat messages\", json.dumps(chat.messages))","+    # Case B: rollout default: llm_call_kwargs top-level request_kwargs, api_key via llm_kwargs","+    llm2=LiteLLM(model_name=\"hosted_vllm/policy\", api_base=base, model_info={\"max_input_tokens\":32768,\"max_output_tokens\":4096,\"input_cost_per_token\":0,\"output_cost_per_token\":0}, api_key=\"[REDACTED]\")","+    chat2=Chat(llm2, interleaved_thinking=True)","+    rk={\"temperature\":1.0,\"top_p\":0.95,\"top_k\":20,\"max_tokens\":4096,\"skip_special_tokens\":False,\"no_stop_trim\":True,\"spaces_between_special_tokens\":False}","+    r=await chat2.chat(\"rollout hi\", **rk)","+    print(\"respB\", r.content, r.reasoning_content)","+    # Case C: token mode collect details + session","+    llm3=LiteLLM(model_name=\"hosted_vllm/policy\", temperature=1.0, api_base=base, model_info=dict(MI), collect_rollout_details=True, session_id=\"sess-123\")","+    SCRIPT.append((200,{\"id\":\"y\",\"object\":\"chat.completion\",\"model\":\"policy\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"CONTENT\",\"reasoning_content\":\"THINK\"},\"finish_reason\":\"stop\",\"logprobs\":{\"content\":[{\"token\":\"C\",\"logprob\":-0.5},{\"token\":\"O\",\"logprob\":-0.25}]},\"provider_specific_fields\":{\"token_ids\":[11,12,13],\"routed_experts\":[1]}}],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":3,\"total_tokens\":10},\"prompt_token_ids\":[1,2,3,4]}))","+    chat3=Chat(llm3, interleaved_thinking=True)","+    r=await chat3.chat(\"tokenmode\", extra_body={\"top_p\":0.95,\"top_k\":20})","+    print(\"respC\", r.content, r.reasoning_content, r.prompt_token_ids, r.completion_token_ids, r.logprobs, r.extra, r.usage)","+    print(\"rollout_details\", chat3.rollout_details)","+    srv.shutdown()","+    for i,c in enumerate(CAPTURED):","+        print(f\"---REQ{i} {c['path']}\")","+        print(\"hdrs\", {k:v for k,v in c['headers'].items() if k.lower() in ('authorization','x-session-id','content-type')})","+        print(json.dumps(c['body'],indent=1,sort_keys=True))","+","+asyncio.run(main())"],"newLines":54,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe1.py"}]}