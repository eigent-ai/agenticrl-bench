#!/bin/bash
# Client-stack gate: check.sh <candidate-venv>
# Exit 0 iff the candidate harbor+litellm stack is interchangeable with the
# reference (/opt/venvs/client) for our eval + rollout launches.
# Live stage: when ENGINE_URLS / ENGINE_LOG_DIR / GATE_REPORT are set, every
# replayed request is also sent through the SGLang servers and judged from
# their request logs. See NOTES.md.
set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
REF_PY=${GATE_REF_VENV:-/opt/venvs/client}/bin/python
exec "$REF_PY" "$HERE/gate.py" "$@"
