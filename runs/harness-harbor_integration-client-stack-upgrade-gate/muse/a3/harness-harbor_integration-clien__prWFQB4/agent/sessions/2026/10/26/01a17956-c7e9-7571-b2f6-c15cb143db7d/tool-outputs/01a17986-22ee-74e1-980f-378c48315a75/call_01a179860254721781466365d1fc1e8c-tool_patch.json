{"files":[{"hunks":[{"lines":["+import json, sys","+sys.path.insert(0, \"/app/gate\")","+# Reuse gate's served-template construction + SGLang message processing mirrors,","+# but render+tokenize with real HF transformers from the engine venv.","+import gate","+from transformers import AutoTokenizer","+","+CASES = json.load(open(\"/tmp/gatework/render-cases.json\"))","+servs = gate.served_configs()","+out = {}","+for name, serv in sorted(servs.items()):","+    tok = AutoTokenizer.from_pretrained(str(serv[\"tokenizer_dir\"]))","+    out[name] = []","+    for msgs in CASES:","+        body = {\"messages\": json.loads(json.dumps(msgs)), \"model\": \"policy\"}","+        try:","+            # mirror SGLang processing using gate helpers, then HF render+tokenize","+            norm = gate.normalize_messages(body[\"messages\"])","+            ctk = {}","+            effort = gate.normalize_reasoning(body, ctk)","+            media = []","+            processed = []","+            for d in norm:","+                m = dict(d)","+                if m.get(\"content\") is None:","+                    m[\"content\"] = \"\"","+                p = gate._process_content(m, media)","+                p[\"content\"] = gate._norm_tool_content(p[\"role\"], p.get(\"content\"))","+                processed.append(p)","+            extra = {}","+            if effort is not None:","+                extra[\"reasoning_effort\"] = effort","+            extra.update(ctk)","+            ids = tok.apply_chat_template(processed, chat_template=serv[\"template\"], tokenize=True,","+                                          add_generation_prompt=True, tools=None, return_dict=False, **extra)","+            out[name].append([int(i) for i in ids])","+        except Exception as e:","+            out[name].append(f\"ERR {type(e).__name__} {e}\")","+    body = {\"messages\": CASES[1], \"model\": \"policy\", \"chat_template_kwargs\": {\"enable_thinking\": False, \"thinking\": True}, \"reasoning_effort\": \"low\"}","+    try:","+        norm = gate.normalize_messages(body[\"messages\"])","+        ctk = dict(body[\"chat_template_kwargs\"])","+        effort = gate.normalize_reasoning(body, ctk)","+        media = []","+        processed = []","+        for d in norm:","+            m = dict(d)","+            if m.get(\"content\") is None:","+                m[\"content\"] = \"\"","+            p = gate._process_content(m, media)","+            p[\"content\"] = gate._norm_tool_content(p[\"role\"], p.get(\"content\"))","+            processed.append(p)","+        extra = {\"reasoning_effort\": effort}","+        extra.update(ctk)","+        ids = tok.apply_chat_template(processed, chat_template=serv[\"template\"], tokenize=True,","+                                      add_generation_prompt=True, tools=None, return_dict=False, **extra)","+        out[name].append([int(i) for i in ids])","+    except Exception as e:","+        out[name].append(f\"ERR {type(e).__name__} {e}\")","+json.dump(out, open(\"/tmp/gatework/render-hf.json\", \"w\"))","+g = json.load(open(\"/tmp/gatework/render-gate.json\"))","+bad = 0","+for k in sorted(out):","+    for i, (a, b) in enumerate(zip(out[k], g[k])):","+        if a != b:","+            bad += 1","+            print(\"MISMATCH\", k, i)","+            if isinstance(a, list) and isinstance(b, list):","+                for j, (x, y) in enumerate(zip(a, b)):","+                    if x != y:","+                        print(\" first diff at\", j, x, y, \"lens\", len(a), len(b))","+                        break","+                else:","+                    print(\" prefix equal lens\", len(a), len(b))","+            else:","+                print(\" hf:\", str(a)[:200], \" gate:\", str(b)[:200])","+print(\"mismatches:\", bad, \"of\", sum(len(v) for v in out.values()))"],"newLines":77,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/gatework/validate_render_hf.py"}]}