{"files":[{"hunks":[{"lines":["     return diffs, order"," "," ","+# ---------------------------------------------------------------- live stage","+","+def _find_ids(obj):","+    \"\"\"Extract a prompt token id list from an SGLang log record (several layouts).\"\"\"","+    if isinstance(obj, dict):","+        for key in (\"input_ids\", \"prompt_token_ids\"):","+            v = obj.get(key)","+            if isinstance(v, list) and v and all(isinstance(i, int) for i in v):","+                return v","+            if isinstance(v, list) and len(v) == 1 and isinstance(v[0], list) and all(isinstance(i, int) for i in v[0]):","+                return v[0]","+        for v in obj.values():","+            got = _find_ids(v)","+            if got is not None:","+                return got","+    return None","+","+","+def canon_sampling_from_logged(sp, vocab):","+    \"\"\"Canonicalize the sampling_params dict SGLang itself logged (request.received).\"\"\"","+    if not isinstance(sp, dict):","+        return None","+    body = {","+        \"temperature\": sp.get(\"temperature\"), \"top_p\": sp.get(\"top_p\"),","+        \"top_k\": sp.get(\"top_k\"), \"min_p\": sp.get(\"min_p\"),","+        \"repetition_penalty\": sp.get(\"repetition_penalty\"),","+        \"presence_penalty\": sp.get(\"presence_penalty\"),","+        \"frequency_penalty\": sp.get(\"frequency_penalty\"),","+        \"max_tokens\": sp.get(\"max_new_tokens\"), \"min_tokens\": sp.get(\"min_new_tokens\"),","+        \"stop\": sp.get(\"stop\"), \"stop_token_ids\": sp.get(\"stop_token_ids\"),","+        \"stop_regex\": sp.get(\"stop_regex\"), \"n\": sp.get(\"n\"),","+        \"no_stop_trim\": sp.get(\"no_stop_trim\"), \"ignore_eos\": sp.get(\"ignore_eos\"),","+        \"skip_special_tokens\": sp.get(\"skip_special_tokens\"),","+        \"logit_bias\": sp.get(\"logit_bias\"), \"seed\": sp.get(\"sampling_seed\"),","+        \"regex\": sp.get(\"regex\"), \"ebnf\": sp.get(\"ebnf\"),","+        \"custom_params\": sp.get(\"custom_params\"), \"watermark\": sp.get(\"watermark\"),","+    }","+    ctk = {\"spaces_between_special_tokens\": sp.get(\"spaces_between_special_tokens\", True)}","+    try:","+        s = canon_sampling(body, ctk, vocab, False, None)","+    except CanonError:","+        return None","+    if sp.get(\"json_schema\"):","+        s[\"json_schema\"] = sp[\"json_schema\"]","+    if sp.get(\"structural_tag\"):","+        s[\"structural_tag\"] = sp[\"structural_tag\"]","+    s.pop(\"separate_reasoning\", None)","+    s.pop(\"continue_final_message\", None)","+    return s","+","+","+def live_run(order, engine_urls, log_dir, servs):","+    \"\"\"Re-send every captured request to its SGLang server; harvest prompt ids","+    + sampling from ENGINE_LOG_DIR matched by injected rid.","+","+    order: list of (label, scenario, index_in_scenario, request)","+    Returns (hashes, live_prompts, live_sampling, notes)","+    \"\"\"","+    import http.client","+    import threading","+    from urllib.parse import urlparse","+","+    log_dir = Path(log_dir)","+    offsets = {}","+    for f in log_dir.glob(\"*/*.log\"):","+        offsets[f] = f.stat().st_size","+    by_rid = {}","+    lock = threading.Lock()","+    stop_poll = threading.Event()","+","+    def poll():","+        while not stop_poll.is_set():","+            for f in list(log_dir.glob(\"*/*.log\")):","+                try:","+                    size = f.stat().st_size","+                except OSError:","+                    continue","+                off = offsets.get(f, 0)","+                if size < off:","+                    off = 0","+                if size == off:","+                    continue","+                try:","+                    with open(f, \"rb\") as fh:","+                        fh.seek(off)","+                        data = fh.read()","+                        offsets[f] = fh.tell()","+                except OSError:","+                    continue","+                for line in data.decode(\"utf-8\", \"replace\").splitlines():","+                    lt = line.find(\"{\")","+                    if lt < 0:","+                        continue","+                    try:","+                        rec = json.loads(line[lt:])","+                    except Exception:","+                        continue","+                    rid = rec.get(\"rid\") or (rec.get(\"obj\") or {}).get(\"rid\")","+                    if isinstance(rid, list):","+                        rid = rid[0] if rid else None","+                    if not rid or not str(rid).startswith(\"gate-\"):","+                        continue","+                    with lock:","+                        slot = by_rid.setdefault(rid, {})","+                        ev = rec.get(\"event\", \"\")","+                        ids = _find_ids(rec.get(\"obj\")) or _find_ids(rec.get(\"out\"))","+                        if ids is not None and \"ids\" not in slot:","+                            slot[\"ids\"] = ids","+                        sp = (rec.get(\"obj\") or {}).get(\"sampling_params\")","+                        if isinstance(sp, dict) and \"sampling\" not in slot:","+                            slot[\"sampling_raw\"] = sp","+                        slot[ev] = True","+            stop_poll.wait(0.4)","+","+    poller = threading.Thread(target=poll, daemon=True)","+    poller.start()","+","+    def post(url, path, payload, timeout=180):","+        u = urlparse(url)","+        conn = http.client.HTTPConnection(u.hostname, u.port, timeout=timeout)","+        data = json.dumps(payload).encode()","+        base = u.path.rstrip(\"/\")","+        conn.request(\"POST\", base + path if not path.startswith(\"/v1\") else base[:-3] + path if base.endswith(\"/v1\") else path,","+                     data, {\"Content-Type\": \"application/json\"})","+        return conn","+","+    hashes = []","+    live_prompts = {}","+    live_sampling = {}","+    notes = []","+    for n, (label, sid, i, req) in enumerate(order):","+        cfg = req.get(\"config\")","+        url = engine_urls.get(cfg)","+        body = req.get(\"body\")","+        if not url or not isinstance(body, dict):","+            hashes.append(ids_sha([]))","+            notes.append(f\"{sid} req{i}: no engine for {cfg}\")","+            continue","+        rid = f\"gate-{n:06d}\"","+        payload = dict(body)","+        payload[\"rid\"] = rid","+        path = req.get(\"path\") or \"/v1/chat/completions\"","+        u = urlparse(url)","+        resp_ids = None","+        try:","+            conn = http.client.HTTPConnection(u.hostname, u.port, timeout=240)","+            conn.request(\"POST\", path, json.dumps(payload).encode(),","+                         {\"Content-Type\": \"application/json\"})","+            # Once SGLang has received/tokenized it, abort generation so the","+            # live stage is prefill-only; the received log is unaffected.","+            deadline = time.time() + 30","+            aborted = False","+            resp_holder = {}","+","+            def _read():","+                try:","+                    r = conn.getresponse()","+                    resp_holder[\"body\"] = r.read()","+                    resp_holder[\"status\"] = r.status","+                except Exception as e:  # noqa: BLE001","+                    resp_holder[\"error\"] = type(e).__name__","+            rt = threading.Thread(target=_read, daemon=True)","+            rt.start()","+            while time.time() < deadline and rt.is_alive():","+                with lock:","+                    got = rid in by_rid and (\"ids\" in by_rid[rid] or \"request.received\" in by_rid[rid])","+                if got:","+                    try:","+                        ac = http.client.HTTPConnection(u.hostname, u.port, timeout=10)","+                        ac.request(\"POST\", \"/abort_request\", json.dumps({\"rid\": rid}).encode(),","+                                   {\"Content-Type\": \"application/json\"})","+                        ac.getresponse().read()","+                        ac.close()","+                        aborted = True","+                    except Exception:","+                        pass","+                    break","+                time.sleep(0.4)","+            rt.join(timeout=240)","+            raw = resp_holder.get(\"body\") or b\"\"","+            # response may be JSON (sglext.input_ids) or SSE; scan for ids as fallback","+            try:","+                rj = json.loads(raw)","+                resp_ids = _find_ids(((rj.get(\"sglext\") or {}) if isinstance(rj, dict) else {})) or _find_ids(rj)","+            except Exception:","+                m = re.search(rb'\"input_ids\"\\s*:\\s*\\[([0-9,\\s]+)\\]', raw)","+                if m:","+                    resp_ids = [int(x) for x in m.group(1).split(\",\") if x.strip()]","+            conn.close()","+        except Exception as e:  # noqa: BLE001","+            notes.append(f\"{sid} req{i}: live send {type(e).__name__}\")","+        # wait briefly for the log line to land","+        deadline = time.time() + 20","+        slot = {}","+        while time.time() < deadline:","+            with lock:","+                slot = dict(by_rid.get(rid) or {})","+            if \"ids\" in slot:","+                break","+            time.sleep(0.4)","+        ids = slot.get(\"ids\")","+        if ids is None:","+            ids = resp_ids","+            if ids is not None:","+                notes.append(f\"{sid} req{i}: ids from response sglext (not in log)\")","+        if ids is None:","+            hashes.append(ids_sha([]))","+            notes.append(f\"{sid} req{i}: no prompt ids recorded by SGLang\")","+            continue","+        hashes.append(ids_sha(ids))","+        live_prompts[(label, sid, i)] = ids","+        sp_raw = slot.get(\"sampling_raw\")","+        if sp_raw is not None:","+            cs = canon_sampling_from_logged(sp_raw, servs.get(cfg, {}).get(\"vocab\", 10**9))","+            if cs is not None:","+                # live sampling lacks separate_reasoning/continue flags; merge","+                live_sampling[(label, sid, i)] = cs","+    stop_poll.set()","+    return hashes, live_prompts, live_sampling, notes[:20]","+","+","+# ---------------------------------------------------------------- main","+","+def main():","+    if len(sys.argv) != 2:","+        print(\"usage: check.sh <candidate-venv>\")","+        return 1","+    cand_venv = Path(sys.argv[1])","+    cand_py = cand_venv / \"bin\" / \"python\"","+    ref_py = REF_VENV / \"bin\" / \"python\"","+    if not cand_py.exists():","+        print(f\"REJECT: candidate python not found: {cand_py}\")","+        return 1","+    def versions(py):","+        try:","+            out = subprocess.run([str(py), \"-c\",","+                                  \"import importlib.metadata as m;\"","+                                  \"print(m.version('harbor')); print(m.version('litellm'))\"],","+                                 capture_output=True, text=True, timeout=120,","+                                 env=harness_env()).stdout.split()","+            return out if len(out) == 2 else [\"?\", \"?\"]","+        except Exception:","+            return [\"?\", \"?\"]","+","+    cv, rv = versions(cand_py), versions(ref_py)","+    work = Path(tempfile.mkdtemp(prefix=\"client-gate-\"))","+    t0 = time.time()","+    ref = run_stack(ref_py, work, \"ref\")","+    cand = run_stack(cand_py, work, \"cand\")","+    servs = served_configs()","+    diffs = []","+    if ref[\"errors\"]:","+        diffs.append(\"GATE-ERROR reference harness failures: \" + \"; \".join(ref[\"errors\"][:3]))","+    for e in cand[\"errors\"]:","+        diffs.append(f\"candidate harness failure: {e}\")","+    live_notes = []","+    engine_urls = None","+    if os.environ.get(\"ENGINE_URLS\"):","+        try:","+            engine_urls = json.loads(os.environ[\"ENGINE_URLS\"])","+        except Exception:","+            engine_urls = None","+    if engine_urls and os.environ.get(\"ENGINE_LOG_DIR\"):","+        rg, cg = group_requests(ref[\"requests\"]), group_requests(cand[\"requests\"])","+        order = []","+        for label, g in ((\"ref\", rg), (\"cand\", cg)):","+            for sid in sorted(g):","+                for i, r in enumerate(g[sid]):","+                    order.append((label, sid, i, r))","+        hashes, live_prompts, live_sampling, live_notes = live_run(","+            order, engine_urls, os.environ[\"ENGINE_LOG_DIR\"], servs)","+        # merge live sampling with offline for fields SGLang does not log","+        merged_prompts, merged_sampling = live_prompts, {}","+        for key, cs in live_sampling.items():","+            merged_sampling[key] = cs","+        d2, _ = compare(ref, cand, servs, live_prompts=merged_prompts, live_sampling=None)","+        # sampling: re-judge only the logged subset by direct comparison","+        extra = []","+        keys = set(k for k in merged_sampling if k[0] == \"ref\") | set(k for k in merged_sampling if k[0] == \"cand\")","+        paired = {}","+        for label, sid, i in [k for k in merged_sampling]:","+            paired.setdefault((sid, i), {})[label] = merged_sampling[(label, sid, i)]","+        for (sid, i), both in sorted(paired.items()):","+            if \"ref\" in both and \"cand\" in both and both[\"ref\"] != both[\"cand\"]:","+                dd = []","+                diff_values(both[\"ref\"], both[\"cand\"], \"sampling\", dd, limit=3)","+                extra.extend(f\"{sid} req{i} (live): {x}\" for x in dd[:3])","+        diffs.extend(d2)","+        diffs.extend(extra)","+        report = os.environ.get(\"GATE_REPORT\")","+        if report:","+            Path(report).write_text(json.dumps({\"prompt_ids_sha256\": hashes}))","+    else:","+        d2, _ = compare(ref, cand, servs)","+        diffs.extend(d2)","+    elapsed = int(time.time() - t0)","+    hdr = (f\"candidate harbor={cv[0]} litellm={cv[1]} vs reference harbor={rv[0]} \"","+           f\"litellm={rv[1]}; scenarios={len(ref['scenarios'])} \"","+           f\"requests ref={sum(len(v) for v in group_requests(ref['requests']).values())} \"","+           f\"cand={sum(len(v) for v in group_requests(cand['requests']).values())}; {elapsed}s; workdir={work}\")","+    if diffs:","+        print(f\"REJECT: {hdr}\")","+        shown = diffs[:40]","+        for d in shown:","+            print(f\" - {d}\")","+        if len(diffs) > len(shown):","+            print(f\" - ... and {len(diffs) - len(shown)} more differences\")","+        for nline in live_notes[:5]:","+            print(f\" - live note: {nline}\")","+        return 1","+    print(f\"ACCEPT: {hdr}\")","+    if live_notes:","+        for nline in live_notes[:5]:","+            print(f\" - live note: {nline}\")","+    return 0","+","+","+if __name__ == \"__main__\":","+    sys.exit(main())","+","+","+"],"newLines":325,"newStart":797,"oldLines":3,"oldStart":797}],"path":"/app/gate/gate.py"}]}