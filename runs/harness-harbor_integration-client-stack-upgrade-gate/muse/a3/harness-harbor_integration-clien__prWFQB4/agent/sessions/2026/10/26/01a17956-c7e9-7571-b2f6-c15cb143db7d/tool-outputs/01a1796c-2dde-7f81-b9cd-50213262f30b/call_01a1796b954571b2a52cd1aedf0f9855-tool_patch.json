{"files":[{"hunks":[{"lines":["+#!/usr/bin/env python3","+\"\"\"Gate replay harness: runs INSIDE one client stack venv (reference or candidate).","+","+Drives the real Terminus-2 agent + LiteLLM stack of that venv against a scripted","+fake OpenAI-compatible server and a fake tmux session, for every launch config","+we run (TB2.1 evals per checkpoint, RL rollouts in both modes) plus recorded","+episodes and targeted probes. Writes results.json + requests.jsonl to --out.","+No comparison logic lives here; gate.py (reference venv) compares two runs.","+\"\"\"","+import argparse","+import asyncio","+import json","+import os","+import sys","+import threading","+import traceback","+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer","+from pathlib import Path","+from types import SimpleNamespace","+","+MISSING = object()","+","+# ---------------------------------------------------------------- fake server","+","+STATE = {","+    \"scenario\": None,","+    \"config\": None,","+    \"script\": [],","+    \"idx\": 0,","+    \"default\": None,","+    \"seq\": 0,","+    \"requests\": [],","+}","+","+","+def chat_body(spec, req_body, idx):","+    msg = {\"role\": \"assistant\", \"content\": spec.get(\"content\", \"\")}","+    r = spec.get(\"reasoning\", MISSING)","+    if r is not MISSING:","+        msg[\"reasoning_content\"] = r","+    for k, v in (spec.get(\"msg_extra\") or {}).items():","+        msg[k] = v","+    choice = {\"index\": 0, \"message\": msg, \"finish_reason\": spec.get(\"finish\", \"stop\")}","+    # SGLang only emits token ids / logprobs when the request asked for them.","+    if req_body.get(\"return_token_ids\") or req_body.get(\"return_prompt_token_ids\"):","+        if spec.get(\"prompt_token_ids\") is not None:","+            choice[\"prompt_token_ids\"] = spec[\"prompt_token_ids\"]","+        if spec.get(\"response_token_ids\") is not None:","+            choice[\"response_token_ids\"] = spec[\"response_token_ids\"]","+        if spec.get(\"token_ids\") is not None:","+            choice[\"token_ids\"] = spec[\"token_ids\"]","+    if req_body.get(\"logprobs\") and spec.get(\"logprobs\") is not None:","+        choice[\"logprobs\"] = {","+            \"content\": [","+                {\"token\": t, \"logprob\": float(lp), \"bytes\": None, \"top_logprobs\": []}","+                for t, lp in spec[\"logprobs\"]","+            ]","+        }","+    body = {","+        \"id\": f\"chatcmpl-gate-{idx}\",","+        \"object\": \"chat.completion\",","+        \"created\": 1700000000,","+        \"model\": spec.get(\"model\", \"policy\"),","+        \"choices\": [choice],","+    }","+    usage = spec.get(\"usage\", (100, 10))","+    if usage is not None:","+        if isinstance(usage, dict):","+            body[\"usage\"] = usage","+        else:","+            body[\"usage\"] = {","+                \"prompt_tokens\": usage[0],","+                \"completion_tokens\": usage[1],","+                \"total_tokens\": usage[0] + usage[1],","+            }","+    for k, v in (spec.get(\"body_extra\") or {}).items():","+        body[k] = v","+    return body","+","+","+def sse_bytes(spec, req_body):","+    content = spec.get(\"content\", \"\")","+    r = spec.get(\"reasoning\", MISSING)","+    chunks = []","+    d0 = {\"role\": \"assistant\"}","+    if r is not MISSING and r:","+        d0[\"reasoning_content\"] = r","+    chunks.append({","+        \"id\": \"chatcmpl-gate-s\", \"object\": \"chat.completion.chunk\", \"created\": 1700000000,","+        \"model\": \"policy\", \"choices\": [{\"index\": 0, \"delta\": d0, \"finish_reason\": None}],","+    })","+    half = max(1, len(content) // 2)","+    for part in (content[:half], content[half:]):","+        if part:","+            chunks.append({","+                \"id\": \"chatcmpl-gate-s\", \"object\": \"chat.completion.chunk\", \"created\": 1700000000,","+                \"model\": \"policy\", \"choices\": [{\"index\": 0, \"delta\": {\"content\": part}, \"finish_reason\": None}],","+            })","+    fin = {","+        \"id\": \"chatcmpl-gate-s\", \"object\": \"chat.completion.chunk\", \"created\": 1700000000,","+        \"model\": \"policy\",","+        \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": spec.get(\"finish\", \"stop\")}],","+    }","+    if (req_body.get(\"stream_options\") or {}).get(\"include_usage\"):","+        u = spec.get(\"usage\", (100, 10))","+        if isinstance(u, tuple):","+            fin[\"usage\"] = {\"prompt_tokens\": u[0], \"completion_tokens\": u[1], \"total_tokens\": u[0] + u[1]}","+    chunks.append(fin)","+    out = b\"\"","+    for c in chunks:","+        out += b\"data: \" + json.dumps(c).encode() + b\"\\n\\n\"","+    return out + b\"data: [DONE]\\n\\n\"","+","+","+class Handler(BaseHTTPRequestHandler):","+    protocol_version = \"HTTP/1.1\"","+","+    def log_message(self, *a):","+        pass","+","+    def _record(self, body):","+        STATE[\"seq\"] += 1","+        STATE[\"requests\"].append({","+            \"scenario\": STATE[\"scenario\"],","+            \"config\": STATE[\"config\"],","+            \"seq\": STATE[\"seq\"] - 1,","+            \"method\": self.command,","+            \"path\": self.path,","+            \"headers\": {k.lower(): v for k, v in self.headers.items()},","+            \"body\": body,","+        })","+","+    def _send(self, code, data, ctype=\"application/json\"):","+        self.send_response(code)","+        self.send_header(\"Content-Type\", ctype)","+        self.send_header(\"Content-Length\", str(len(data)))","+        self.end_headers()","+        self.wfile.write(data)","+","+    def do_GET(self):","+        self._record(None)","+        self._send(200, json.dumps({\"object\": \"list\", \"data\": [{\"id\": \"policy\", \"object\": \"model\"}]}).encode())","+","+    def do_POST(self):","+        n = int(self.headers.get(\"Content-Length\") or 0)","+        raw = self.rfile.read(n) if n else b\"\"","+        try:","+            body = json.loads(raw) if raw else {}","+        except Exception:","+            body = {\"_raw\": raw.decode(\"utf-8\", \"replace\")[:4000]}","+        self._record(body)","+        idx = STATE[\"idx\"]","+        STATE[\"idx\"] += 1","+        spec = STATE[\"script\"][idx] if idx < len(STATE[\"script\"]) else (STATE[\"default\"] or {})","+        if spec.get(\"drop\"):","+            self.close_connection = True","+            try:","+                self.connection.close()","+            except Exception:","+                pass","+            return","+        status = spec.get(\"status\", 200)","+        if status != 200:","+            self._send(status, json.dumps(spec.get(\"error_body\", {\"error\": {\"message\": \"gate error\", \"type\": \"server_error\", \"code\": status}})).encode())","+            return","+        if \"raw_body\" in spec:","+            rb = spec[\"raw_body\"]","+            self._send(200, rb.encode() if isinstance(rb, str) else json.dumps(rb).encode())","+            return","+        if isinstance(body, dict) and body.get(\"stream\"):","+            self._send(200, sse_bytes(spec, body), \"text/event-stream\")","+            return","+        if self.path.rstrip(\"/\").endswith(\"/completions\"):","+            b = {\"id\": \"cmpl-gate\", \"object\": \"text_completion\", \"created\": 1700000000, \"model\": \"policy\",","+                 \"choices\": [{\"index\": 0, \"text\": spec.get(\"content\", \"\"), \"finish_reason\": spec.get(\"finish\", \"stop\")}],","+                 \"usage\": {\"prompt_tokens\": 100, \"completion_tokens\": 10, \"total_tokens\": 110}}","+            self._send(200, json.dumps(b).encode())","+            return","+        self._send(200, json.dumps(chat_body(spec, body if isinstance(body, dict) else {}, idx)).encode())","+","+","+def start_server():","+    srv = ThreadingHTTPServer((\"127.0.0.1\", 0), Handler)","+    srv.daemon_threads = True","+    threading.Thread(target=srv.serve_forever, daemon=True).start()","+    return f\"http://127.0.0.1:{srv.server_address[1]}/v1\"","+","+","+# ---------------------------------------------------------------- payloads","+","+def pj(analysis, plan, cmds=(), complete=False):","+    return json.dumps({","+        \"analysis\": analysis, \"plan\": plan,","+        \"commands\": [{\"keystrokes\": k, \"duration\": d} for k, d in cmds],","+        \"task_complete\": complete,","+    })","+","+","+def px(analysis, plan, cmds=(), complete=False):","+    ks = \"\".join(f'<keystrokes duration=\"{d}\">{k}</keystrokes>' for k, d in cmds)","+    tc = \"<task_complete>true</task_complete>\" if complete else \"\"","+    return (f\"<response><analysis>{analysis}</analysis><plan>{plan}</plan>\"","+            f\"<commands>{ks}</commands>{tc}</response>\")","+","+","+def payload(parser, analysis, plan, cmds=(), complete=False):","+    return px(analysis, plan, cmds, complete) if parser == \"xml\" else pj(analysis, plan, cmds, complete)","+","+","+def spec(parser, analysis, plan, cmds=(), complete=False, **kw):","+    s = {\"content\": payload(parser, analysis, plan, cmds, complete)}","+    s.update(kw)","+    return s","+","+","+OUT = \"New Terminal Output:\\n\\nroot@gate:/app# \"","+","+# ---------------------------------------------------------------- fake tmux","+","+","+class FakeSession:","+    def __init__(self, outputs, screen=\"gate-screen\\nroot@gate:/app# ls\\nfile.txt\\n\",","+                 timeout_sends=(), alive=True):","+        self.outputs = list(outputs)","+        self.screen = screen","+        self.timeout_sends = set(timeout_sends)","+        self.alive = alive","+        self.sent = []","+","+    async def is_session_alive(self):","+        return self.alive","+","+    async def get_incremental_output(self):","+        if self.outputs:","+            return self.outputs.pop(0)","+        return OUT + \"\\n\"","+","+    async def send_keys(self, keystrokes, block=False, min_timeout_sec=None, **kw):","+        i = len(self.sent)","+        self.sent.append({\"keystrokes\": keystrokes, \"duration\": min_timeout_sec})","+        if i in self.timeout_sends:","+            raise TimeoutError(\"gate fake timeout\")","+","+    async def capture_pane(self, capture_entire=False, **kw):","+        return self.screen","+","+    async def start(self):","+        pass","+","+","+# ---------------------------------------------------------------- configs","+","+LAUNCH = Path(os.environ.get(\"GATE_LAUNCH\", \"/app/launch\"))","+EPISODES = Path(os.environ.get(\"GATE_EPISODES\", \"/app/episodes\"))","+","+","+def read_json(p):","+    return json.loads(Path(p).read_text()) if Path(p).exists() else {}","+","+","+def parse_kwargs_fn():","+    try:","+        from harbor.cli.utils import parse_kwargs","+        return parse_kwargs","+    except Exception:","+        from harbor.cli.tasks import parse_kwargs","+        return parse_kwargs","+","+","+def eval_ak_list(ckpt, api_base):","+    ec = read_json(LAUNCH / \"checkpoints\" / ckpt / \"eval_config.json\")","+    temp = ec.get(\"temperature\")","+    temp_s = \"0.6\" if temp is None else (\"%s\" % temp)","+    parser = ec.get(\"parser_name\") or \"json\"","+    it = ec.get(\"interleaved_thinking\")","+    it_s = \"true\" if it is True or it == \"true\" else \"false\"","+    ak = [","+        f\"api_base={api_base}\",","+        'model_info={\"max_input_tokens\":65536,\"max_output_tokens\":8192,\"input_cost_per_token\":0,\"output_cost_per_token\":0}',","+        f\"temperature={temp_s}\",","+        f\"parser_name={parser}\",","+        f\"interleaved_thinking={it_s}\",","+    ]","+    samp = {k: ec[k] for k in (\"top_p\", \"top_k\") if ec.get(k) is not None}","+    if samp:","+        ak.append(\"llm_call_kwargs=\" + json.dumps({\"extra_body\": samp}))","+    return ak, parser","+","+","+def recipe_env():","+    env = {}","+    for line in (LAUNCH / \"rollout\" / \"recipe.env\").read_text().splitlines():","+        line = line.strip()","+        if not line or line.startswith(\"#\") or \"=\" not in line:","+            continue","+        k, v = line.split(\"=\", 1)","+        env[k.strip()] = v.strip().strip(\"'\\\"\")","+    return env","+","+","+def rollout_request_kwargs(renv):","+    def f(k, d):","+        try:","+            return float(renv.get(k, d))","+        except Exception:","+            return d","+","+    def i(k, d):","+        try:","+            return int(float(renv.get(k, d)))","+        except Exception:","+            return d","+","+    return {","+        \"temperature\": f(\"ROLLOUT_TEMPERATURE\", 1.0),","+        \"top_p\": f(\"ROLLOUT_TOP_P\", 0.95),","+        \"top_k\": i(\"ROLLOUT_TOP_K\", 20),","+        \"max_tokens\": i(\"ROLLOUT_MAX_RESPONSE_LEN\", 4096),","+        \"skip_special_tokens\": (renv.get(\"ROLLOUT_SKIP_SPECIAL_TOKENS\", \"false\").lower() == \"true\"),","+        \"no_stop_trim\": True,","+        \"spaces_between_special_tokens\": False,","+    }","+","+","+def make_agent(kwargs, logs_dir):","+    from harbor.agents.factory import AgentFactory","+    from harbor.models.trial.config import AgentConfig","+","+    cfg = AgentConfig(name=\"terminus-2\", model_name=\"hosted_vllm/policy\", kwargs=kwargs)","+    return AgentFactory.create_agent_from_config(cfg, logs_dir=Path(logs_dir))","+","+","+def config_kwargs(config, api_base):","+    \"\"\"Return (agent kwargs dict, parser_name) exactly as our launchers build them.\"\"\"","+    if config.startswith(\"eval-\"):","+        ckpt = config[len(\"eval-\"):]","+        ak, parser = eval_ak_list(ckpt, api_base)","+        return parse_kwargs_fn()(ak), parser, ckpt","+    # rollout modes go through the real rollout agent function module","+    renv = recipe_env()","+    for k in (\"AGENT_MAX_INPUT_TOKENS\", \"AGENT_MAX_OUTPUT_TOKENS\", \"HARBOR_AGENT_MAX_ITERATIONS\",","+              \"HARBOR_TERMINUS_2_ENABLE_SUMMARIZE\", \"HARBOR_TERMINUS_2_LINEAR_HISTORY\",","+              \"AGENT_TIMEOUT\", \"HARBOR_ENV_IMPORT_PATH\", \"HARBOR_ENV_KWARGS\"):","+        if k in renv:","+            os.environ[k] = renv[k]","+    os.environ[\"HARBOR_COLLECT_ROLLOUT_DETAILS\"] = \"1\" if config == \"rollout-token\" else \"0\"","+    sys.path.insert(0, str(LAUNCH / \"rollout\"))","+    import terminus_agent","+","+    kw = terminus_agent.terminus_kwargs(","+        api_base, \"gate-session-key\", rollout_request_kwargs(renv),","+        {\"session_id\": \"gate-session-0001\", \"instance_id\": \"gate-instance\"},","+    )","+    return kw, \"xml\", \"rollout\""],"newLines":354,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/gate/harness.py"}]}