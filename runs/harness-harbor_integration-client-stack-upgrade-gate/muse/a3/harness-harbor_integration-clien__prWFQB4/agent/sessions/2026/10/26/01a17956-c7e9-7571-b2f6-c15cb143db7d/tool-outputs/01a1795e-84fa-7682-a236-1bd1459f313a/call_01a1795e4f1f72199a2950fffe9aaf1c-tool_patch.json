{"files":[{"hunks":[{"lines":["+import asyncio, json, os, sys, threading","+from http.server import BaseHTTPRequestHandler, HTTPServer","+","+os.environ.setdefault(\"LITELLM_LOCAL_MODEL_COST_MAP\", \"True\")","+os.environ.setdefault(\"NO_PROXY\", \"127.0.0.1,localhost\")","+","+requests_log = []","+RESP_IDX = [0]","+","+def resp_body(i):","+    return {","+        \"id\": f\"chatcmpl-{i}\", \"object\": \"chat.completion\", \"created\": 1, \"model\": \"policy\",","+        \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": f\"resp-{i}\", \"reasoning_content\": f\"think-{i}\"},","+                      \"finish_reason\": \"stop\"}],","+        \"usage\": {\"prompt_tokens\": 10+i, \"completion_tokens\": 5, \"total_tokens\": 15+i},","+    }","+","+class H(BaseHTTPRequestHandler):","+    def log_message(self, *a): pass","+    def do_POST(self):","+        n = int(self.headers.get(\"Content-Length\", 0))","+        raw = self.rfile.read(n)","+        try: body = json.loads(raw)","+        except Exception: body = {\"_raw\": raw.decode(\"utf-8\", \"replace\")[:2000]}","+        requests_log.append({\"path\": self.path, \"headers\": dict(self.headers), \"body\": body})","+        i = RESP_IDX[0]; RESP_IDX[0] += 1","+        if body.get(\"stream\"):","+            data = (\"data: \" + json.dumps({\"id\": \"x\", \"object\": \"chat.completion.chunk\", \"created\": 1, \"model\": \"policy\",","+                    \"choices\": [{\"index\": 0, \"delta\": {\"role\": \"assistant\", \"content\": f\"resp-{i}\", \"reasoning_content\": f\"think-{i}\"}, \"finish_reason\": None}]}) + \"\\n\\n\"","+                    + \"data: \" + json.dumps({\"id\": \"x\", \"object\": \"chat.completion.chunk\", \"created\": 1, \"model\": \"policy\",","+                    \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}],","+                    \"usage\": {\"prompt_tokens\": 10, \"completion_tokens\": 5, \"total_tokens\": 15}}) + \"\\n\\n\" + \"data: [DONE]\\n\\n\").encode()","+            self.send_response(200); self.send_header(\"Content-Type\", \"text/event-stream\"); self.send_header(\"Content-Length\", str(len(data))); self.end_headers()","+            self.wfile.write(data); return","+        data = json.dumps(resp_body(i)).encode()","+        self.send_response(200); self.send_header(\"Content-Type\", \"application/json\"); self.send_header(\"Content-Length\", str(len(data))); self.end_headers()","+        self.wfile.write(data)","+    def do_GET(self):","+        requests_log.append({\"path\": self.path, \"method\": \"GET\", \"headers\": dict(self.headers), \"body\": None})","+        data = json.dumps({\"data\": [{\"id\": \"policy\", \"object\": \"model\"}]}).encode()","+        self.send_response(200); self.send_header(\"Content-Type\", \"application/json\"); self.send_header(\"Content-Length\", str(len(data))); self.end_headers()","+        self.wfile.write(data)","+","+srv = HTTPServer((\"127.0.0.1\", 0), H)","+port = srv.server_address[1]","+threading.Thread(target=srv.serve_forever, daemon=True).start()","+base = f\"http://127.0.0.1:{port}/v1\"","+","+async def main():","+    out = {}","+    from harbor.llms.chat import Chat","+    from harbor.llms.lite_llm import LiteLLM","+    MI = {\"max_input_tokens\": 65536, \"max_output_tokens\": 8192, \"input_cost_per_token\": 0, \"output_cost_per_token\": 0}","+    # eval exp1 style","+    llm = LiteLLM(model_name=\"hosted_vllm/policy\", api_base=base, temperature=0.8, model_info=dict(MI))","+    chat = Chat(llm, interleaved_thinking=True)","+    r1 = await chat.chat(\"hello-1\", extra_body={\"top_p\": 1.0, \"top_k\": -1})","+    r2 = await chat.chat(\"hello-2\", extra_body={\"top_p\": 1.0, \"top_k\": -1})","+    out[\"exp1\"] = {\"r1\": [r1.content, r1.reasoning_content], \"r2\": [r2.content, r2.reasoning_content],","+                   \"ctx_limit\": llm.get_model_context_limit(), \"out_limit\": llm.get_model_output_limit()}","+    # rollout default style: top-level kwargs","+    llm2 = LiteLLM(model_name=\"hosted_vllm/policy\", api_base=base, model_info=dict(MI), api_key=\"sk-test\")","+    chat2 = Chat(llm2, interleaved_thinking=True)","+    rk = {\"temperature\": 1.0, \"top_p\": 0.95, \"top_k\": 20, \"max_tokens\": 4096, \"skip_special_tokens\": False,","+          \"no_stop_trim\": True, \"spaces_between_special_tokens\": False}","+    r3 = await chat2.chat(\"roll-1\", **rk)","+    r4 = await chat2.chat(\"roll-2\", **rk)","+    out[\"rollout\"] = {\"r3\": [r3.content, r3.reasoning_content], \"r4\": [r4.content, r4.reasoning_content]}","+    # token mode","+    llm3 = LiteLLM(model_name=\"hosted_vllm/policy\", api_base=base, temperature=1.0, model_info=dict(MI),","+                   collect_rollout_details=True, session_id=\"sess-123\")","+    chat3 = Chat(llm3, interleaved_thinking=True)","+    r5 = await chat3.chat(\"tok-1\", extra_body={\"top_p\": 0.95, \"top_k\": 20})","+    out[\"token\"] = {\"r5\": [r5.content, r5.reasoning_content, r5.prompt_token_ids, r5.completion_token_ids, r5.logprobs]}","+    # token_counter probe","+    try:","+        from litellm.utils import token_counter","+        msgs = [{\"role\": \"user\", \"content\": \"hello world \" * 100},","+                {\"role\": \"assistant\", \"content\": \"resp\", \"reasoning_content\": \"think \" * 50},","+                {\"role\": \"user\", \"content\": \"again\"}]","+        out[\"token_counter\"] = token_counter(model=\"hosted_vllm/policy\", messages=msgs)","+    except Exception as e:","+        out[\"token_counter\"] = f\"ERR {type(e).__name__}: {e}\"","+    out[\"requests\"] = requests_log","+    print(json.dumps(out, indent=1, default=str))","+","+asyncio.run(main())","+srv.shutdown()"],"newLines":88,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/gatework/probe1.py"}]}