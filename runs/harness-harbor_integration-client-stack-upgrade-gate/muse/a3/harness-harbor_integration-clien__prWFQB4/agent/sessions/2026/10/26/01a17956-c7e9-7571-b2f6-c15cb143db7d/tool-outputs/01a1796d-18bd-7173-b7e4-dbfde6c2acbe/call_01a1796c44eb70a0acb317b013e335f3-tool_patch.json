q1 q2 q3 q4 q5\", \"reasoning\": \"qr\", \"usage\": (900, 50)},","+            {\"content\": \"ANSWERS gate\", \"reasoning\": \"ar\", \"usage\": (2500, 80)},","+            spec(parser, \"resumed\", \"finish\", (), True, reasoning=\"rr\", usage=(1500, 5)),","+            spec(parser, \"confirm\", \"again\", (), True, reasoning=\"rr2\", usage=(1600, 5)),","+        ]","+        S.append((\"overflow-summarize\", dict(script=ov, outputs=outs(5), default=done)))","+    if config == \"eval-base-4b\":","+        ov2 = [","+            err_spec(400, EXC_CTX_B),","+            err_spec(400, EXC_CTX_B),","+            {\"content\": \"SHORT-SUMMARY gate\", \"usage\": (500, 20)},","+            spec(\"json\", \"resumed\", \"finish\", (), True, reasoning=\"rr\", usage=(1500, 5)),","+            spec(\"json\", \"confirm\", \"again\", (), True, reasoning=\"rr2\", usage=(1600, 5)),","+        ]","+        S.append((\"overflow-fallbacks\", dict(script=ov2, outputs=outs(4), default=done)))","+    if config == \"rollout-default\":","+        big_a = \"word \" * 3500","+        big = [spec(\"xml\", big_a, \"plan \" + \"step \" * 200, [(\"echo big\\n\", 0.1)], reasoning=\"bigr \" * 200, usage=(5000, 900)) for _ in range(6)]","+        ps = big + [","+            {\"content\": \"SUMMARY-TEXT gate\", \"reasoning\": \"sr\", \"usage\": (9000, 100)},","+            {\"content\": \"QUESTIONS gate? q1 q2 q3 q4 q5\", \"reasoning\": \"qr\", \"usage\": (900, 50)},","+            {\"content\": \"ANSWERS gate\", \"reasoning\": \"ar\", \"usage\": (9500, 80)},","+            spec(\"xml\", \"resumed\", \"finish\", (), True, reasoning=\"rr\", usage=(3000, 5)),","+            spec(\"xml\", \"confirm\", \"again\", (), True, reasoning=\"rr2\", usage=(3100, 5)),","+        ]","+        big_outs = [OUT + (\"terminal filler line with some words\\n\" * 220) for _ in range(8)]","+        S.append((\"proactive-summarize\", dict(script=ps, outputs=big_outs, default=done, time_limit=300)))","+        mt = [spec(