{"files":[{"hunks":[{"lines":["         {\"session_id\": \"gate-session-0001\", \"instance_id\": \"gate-instance\"},","     )","     return kw, \"xml\", \"rollout\"","+","+","+# ---------------------------------------------------------------- running","+","+EXC_CTX_A = (\"The input (70000 tokens) is longer than the model's context length \"","+             \"(65536 tokens).\")","+EXC_CTX_B = (\"Requested token count exceeds the model's maximum context length of \"","+             \"65536 tokens. You requested a total of 70000 tokens: 65904 tokens from \"","+             \"the input messages and 4096 tokens for the completion. Please reduce \"","+             \"the number of tokens in the input messages or the completion to fit \"","+             \"within the limit.\")","+","+","+def err_spec(status, message, etype=\"BadRequestError\"):","+    return {\"status\": status, \"error_body\": {\"error\": {\"message\": message, \"type\": etype, \"param\": None, \"code\": status}}}","+","+","+async def run_scenario(sid, config, api_base, out_dir, *, kwargs=None, parser=\"json\",","+                       serv=\"rollout\", script=(), default=None, outputs=(),","+                       instruction=\"Do the gate task.\", timeout_sends=(), alive=True,","+                       time_limit=240):","+    STATE.update({\"scenario\": sid, \"config\": serv, \"script\": list(script),","+                  \"idx\": 0, \"default\": default})","+    logs_dir = Path(out_dir) / \"agentlogs\" / sid","+    logs_dir.mkdir(parents=True, exist_ok=True)","+    outcome = {\"config\": serv, \"launch\": config}","+    fake = FakeSession(list(outputs), timeout_sends=timeout_sends, alive=alive)","+    try:","+        if kwargs is None:","+            kwargs, parser, serv2 = config_kwargs(config, api_base)","+            outcome[\"config\"] = serv2","+            STATE[\"config\"] = serv2","+        else:","+            kwargs = dict(kwargs)","+            kwargs[\"api_base\"] = api_base","+        agent = make_agent(kwargs, logs_dir)","+        agent._session = fake  # Terminus2.run requires a started session","+        from harbor.models.agent.context import AgentContext","+","+        ctx = AgentContext()","+        try:","+            await asyncio.wait_for(","+                agent.run(instruction, environment=SimpleNamespace(default_user=\"root\"), context=ctx),","+                timeout=time_limit,","+            )","+            outcome[\"status\"] = \"ok\"","+        except BaseException as e:  # noqa: BLE001 recorded outcome","+            outcome[\"status\"] = f\"exception:{type(e).__name__}\"","+        outcome[\"sent\"] = fake.sent","+        outcome[\"summarization_count\"] = getattr(agent, \"_summarization_count\", None)","+        meta = ctx.metadata or {}","+        outcome[\"n_episodes\"] = meta.get(\"n_episodes\")","+        try:","+            outcome[\"rollout_details\"] = json.loads(json.dumps(ctx.rollout_details or [], default=str))","+        except Exception:","+            outcome[\"rollout_details\"] = str(ctx.rollout_details)[:2000]","+        trajs = []","+        for p in sorted(logs_dir.glob(\"trajectory*.json\")):","+            try:","+                trajs.append({\"name\": p.name, \"data\": json.loads(p.read_text())})","+            except Exception as e:","+                trajs.append({\"name\": p.name, \"data\": {\"_unreadable\": type(e).__name__}})","+        outcome[\"trajectories\"] = trajs","+    except BaseException as e:  # construction failures are scenario outcomes","+        outcome[\"status\"] = f\"exception:{type(e).__name__}\"","+        outcome[\"sent\"] = fake.sent","+        outcome[\"trajectories\"] = []","+    return outcome","+","+","+def outs(n, text=\"output line\\n\"):","+    return [OUT + text for _ in range(n)]","+","+","+def scenarios_for(config, parser):","+    \"\"\"Build (sid, kwargs-overrides..., run_scenario kwargs) for one launch config.\"\"\"","+    S = []","+    done = spec(parser, \"done\", \"finish\", (), True, reasoning=\"final-think\", usage=(900, 20))","+    calm = [","+        spec(parser, \"start\", \"list files\", [(\"ls -la\\n\", 0.5)], reasoning=\"think-one\", usage=(800, 30)),","+        spec(parser, \"saw file\", \"read it\", [(\"cat file.txt\\n\", 0.5), (\"echo ok\\n\", 0.1)], reasoning=\"think-two\", usage=(1200, 40)),","+        spec(parser, \"all good\", \"complete\", (), True, reasoning=\"think-three\", usage=(1600, 25)),","+        spec(parser, \"confirmed\", \"complete again\", (), True, reasoning=\"think-four\", usage=(1700, 15)),","+    ]","+    S.append((\"calm\", dict(script=calm, outputs=outs(6), default=done)))","+","+    if config in (\"eval-exp1\", \"rollout-default\", \"eval-base-4b\"):","+        rv = [","+            spec(parser, \"a1\", \"p1\", [(\"echo 1\\n\", 0.1)], reasoning=\"\", usage=(800, 10)),","+            spec(parser, \"a2\", \"p2\", [(\"echo 2\\n\", 0.1)], reasoning=MISSING, usage=(900, 10)),","+            spec(parser, \"a3\", \"p3\", [(\"echo 3\\n\", 0.1)], reasoning=\"   \\n \", usage=(1000, 10)),","+            {\"content\": \"<think>\\nINLINE-THINK\\n</think>\\n\\n\" + payload(parser, \"a4\", \"p4\", [(\"echo 4\\n\", 0.1)]), \"usage\": (1100, 10)},","+            spec(parser, \"a5\", \"p5\", [(\"echo 5\\n\", 0.1)], reasoning=\"has </think> inside reasoning\", usage=(1200, 10)),","+            spec(parser, \"a6\", \"p6\", (), True, reasoning=\"r6\", usage=(1300, 10)),","+            spec(parser, \"a7\", \"p7\", (), True, reasoning=\"r7\", usage=(1400, 10)),","+        ]","+        S.append((\"reasoning-variants\", dict(script=rv, outputs=outs(9), default=done)))","+","+    if parser == \"json\":","+        pj_script = [","+            {\"content\": \"not json at all\", \"reasoning\": \"x\", \"usage\": (800, 5)},","+            {\"content\": 'pre {\"plan\": \"p\", \"analysis\": \"a\", \"commands\": [{\"keystrokes\": \"echo w\\\\n\"}], \"task_complete\": false} post', \"reasoning\": \"x\", \"usage\": (900, 5)},"