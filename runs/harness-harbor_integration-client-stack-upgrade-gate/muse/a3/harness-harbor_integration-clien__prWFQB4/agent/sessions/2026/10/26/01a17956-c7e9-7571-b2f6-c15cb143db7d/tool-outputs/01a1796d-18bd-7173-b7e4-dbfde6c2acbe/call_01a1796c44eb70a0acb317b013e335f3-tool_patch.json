 config == \"rollout-token\":","+        cs = [","+            {\"content\": px(\"a\", \"p\", [(\"echo c\\n\", 0.1)]), \"reasoning\": \"cr\", \"usage\": (800, 3),","+             \"prompt_token_ids\": [11, 22, 33], \"response_token_ids\": [44, 55, 66],","+             \"logprobs\": [[\"a\", -0.1], [\"b\", -0.2], [\"c\", -0.3]]},","+            {\"content\": px(\"a2\", \"p2\", (), True), \"reasoning\": \"cr2\", \"usage\": (900, 2)},","+            {\"content\": px(\"a3\", \"p3\", (), True), \"reasoning\": \"cr3\", \"usage\": (950, 2),","+             \"prompt_token_ids\": [11, 22, 33, 44], \"response_token_ids\": [77],","+             \"logprobs\": [[\"z\", -1.5]]},","+        ]","+        S.append((\"collect-shapes\", dict(script=cs, outputs=outs(5), default=done)))","+    return S","+"],"newLines":240,"newStart":352,"oldLines":3,"oldStart":352}],"path":"/app/gate/harness.py"}]}