{"files":[{"hunks":[{"lines":["+#!/usr/bin/env python3","+\"\"\"Client-stack gate: compare a candidate harbor+litellm venv against the","+reference (/opt/venvs/client) for everything our launches run.","+","+Runs gate/harness.py inside both venvs (real Terminus-2 + LiteLLM against a","+scripted fake server / fake terminal, all launch configs, recorded episodes,","+messy-traffic scenarios, targeted probes), canonicalizes every captured","+request the way SGLang's chat endpoint computes it (served chat template ->","+prompt token ids; effective sampling params after SGLang defaults), and","+compares requests + trial outcomes. In the live stage (ENGINE_URLS set) the","+captured requests are re-sent to the real SGLang servers and prompt ids /","+sampling are judged from ENGINE_LOG_DIR instead of the local rendering.","+\"\"\"","+import concurrent.futures","+import hashlib","+import json","+import os","+import re","+import subprocess","+import sys","+import tempfile","+import time","+from pathlib import Path","+","+GATE_DIR = Path(__file__).resolve().parent","+LAUNCH = Path(os.environ.get(\"GATE_LAUNCH\", \"/app/launch\"))","+MODELS = Path(os.environ.get(\"GATE_MODELS\", \"/models\"))","+REF_VENV = Path(os.environ.get(\"GATE_REF_VENV\", \"/opt/venvs/client\"))","+GROUPS = [\"eval-base-2b\", \"eval-base-4b\", \"eval-exp1\", \"eval-exp2-2b\",","+          \"rollout-default\", \"rollout-token\", \"probes\"]","+WHITEBOX_PROBES = {\"parsers\", \"limit_output\", \"verifier\"}","+","+","+# ---------------------------------------------------------------- served configs","+","+def read_json(p):","+    return json.loads(Path(p).read_text()) if Path(p).exists() else {}","+","+","+def served_configs():","+    \"\"\"launch config -> {tokenizer_dir, template_text, reasoning_parser, vocab}","+    Replicates serve_policy.sh / serve_ci.sh served-template construction.\"\"\"","+    out = {}","+    for ck in sorted((LAUNCH / \"checkpoints\").iterdir()):","+        if not ck.is_dir():","+            continue","+        cj = read_json(ck / \"checkpoint.json\")","+        ec = read_json(ck / \"eval_config.json\")","+        tok = Path(cj[\"tokenizer_dir\"])","+        if not tok.is_absolute() or not tok.exists():","+            tok = MODELS / Path(cj[\"tokenizer_dir\"]).name","+        base_tpl = (tok / \"chat_template.jinja\").read_text()","+        think = ec.get(\"enable_thinking\")","+        if think is True or think == \"true\":","+            think = True","+        elif think is False or think == \"false\":","+            think = False","+        else:","+            think = \"enable_thinking is true\" not in base_tpl","+        miles = ec.get(\"chat_template\") == \"miles_fixed\"","+        tpl = (LAUNCH / \"templates\" / \"qwen3.5_fixed.jinja\").read_text() if miles else base_tpl","+        tpl = (\"{%- set enable_thinking = \" + (\"true\" if think else \"false\") + \" %}\\n\") + tpl","+        if miles:","+            tpl = \"{%- set preserve_thinking = true %}\\n\" + tpl","+        out[ck.name] = {\"tokenizer_dir\": tok, \"template\": tpl, \"thinking\": think,","+                        \"reasoning_parser\": think, \"vocab\": vocab_size(tok)}","+    # rollout: recipe HF_CHECKPOINT, miles fixed, preserve, thinking on","+    renv = {}","+    for line in (LAUNCH / \"rollout\" / \"recipe.env\").read_text().splitlines():","+        line = line.strip()","+        if line and not line.startswith(\"#\") and \"=\" in line:","+            k, v = line.split(\"=\", 1)","+            renv[k.strip()] = v.strip().strip(\"'\\\"\")","+    tok = MODELS / Path(renv.get(\"HF_CHECKPOINT\", \"/models/Qwen3.5-4B\")).name","+    tpl = (LAUNCH / \"templates\" / \"qwen3.5_fixed.jinja\").read_text()","+    tpl = \"{%- set preserve_thinking = true %}\\n{%- set enable_thinking = true %}\\n\" + tpl","+    out[\"rollout\"] = {\"tokenizer_dir\": tok, \"template\": tpl, \"thinking\": True,","+                      \"reasoning_parser\": True, \"vocab\": vocab_size(tok)}","+    return out","+","+","+def vocab_size(tok):","+    try:","+        cfg = read_json(Path(tok) / \"config.json\")","+        return int(cfg.get(\"text_config\", cfg).get(\"vocab_size\", 0)) or 10**9","+    except Exception:","+        return 10**9","+","+","+# ---------------------------------------------------------------- canonicalization","+","+class CanonError(Exception):","+    pass","+","+","+def _isnum(x):","+    return isinstance(x, (int, float)) and not isinstance(x, bool)","+","+","+def cfloat(x, field):","+    if _isnum(x):","+        return float(x)","+    if isinstance(x, bool):","+        return float(x)","+    if isinstance(x, str):","+        try:","+            return float(x)","+        except ValueError:","+            raise CanonError(f\"validation:{field}\")","+    raise CanonError(f\"validation:{field}\")","+","+","+def cint(x, field):","+    if isinstance(x, bool):","+        return int(x)","+    if isinstance(x, int):","+        return x","+    if isinstance(x, float) and float(x).is_integer():","+        return int(x)","+    if isinstance(x, str):","+        try:","+            return int(x)","+        except ValueError:","+            try:","+                f = float(x)","+            except ValueError:","+                raise CanonError(f\"validation:{field}\")","+            if f.is_integer():","+                return int(f)","+    raise CanonError(f\"validation:{field}\")","+","+","+def cbool(x, field):","+    if isinstance(x, bool):","+        return x","+    if isinstance(x, int) and x in (0, 1):","+        return bool(x)","+    if isinstance(x, str) and x.lower() in (\"true\", \"false\", \"1\", \"0\", \"yes\", \"no\", \"on\", \"off\"):","+        return x.lower() in (\"true\", \"1\", \"yes\", \"on\")","+    raise CanonError(f\"validation:{field}\")","+","+","+_GENERIC_ROLES = {\"system\", \"assistant\", \"tool\", \"function\", \"developer\", \"latest_reminder\"}","+_PART_TYPES = {\"text\", \"thinking\", \"reasoning\", \"image_url\", \"video_url\", \"audio_url\",","+               \"input_audio\", \"tool_reference\"}","+","+","+def _norm_parts(content, role):","+    if not isinstance(content, list):","+        return content","+    for part in content:","+        if not isinstance(part, dict) or part.get(\"type\") not in _PART_TYPES:","+            raise CanonError(\"validation:content_part\")","+        t = part[\"type\"]","+        if t in (\"thinking\", \"reasoning\"):","+            if role != \"assistant\":","+                raise CanonError(\"validation:thinking_part_role\")","+            if (part.get(\"thinking\") is None) == (part.get(\"text\") is None):","+                raise CanonError(\"validation:thinking_part\")","+        if t == \"text\" and not isinstance(part.get(\"text\"), str):","+            raise CanonError(\"validation:text_part\")","+    return content","+","+","+def _process_content(msg, media):","+    \"\"\"Mirror SGLang process_content_for_template_format (openai format).\"\"\"","+    if not isinstance(msg.get(\"content\"), list):","+        return {k: v for k, v in msg.items() if v is not None}","+    parts = []","+    for chunk in msg[\"content\"]:","+        if not isinstance(chunk, dict):","+            continue","+        t = chunk.get(\"type\")","+        if t in (\"image_url\", \"input_image\"):","+            obj = chunk.get(\"image_url\") or {}","+            if isinstance(obj, str):","+                obj = {\"url\": obj, \"detail\": chunk.get(\"detail\")}","+            media.append([\"image\", obj.get(\"url\"), obj.get(\"detail\") or \"auto\"])","+            parts.append({\"type\": \"image\"})","+        elif t == \"video_url\":","+            obj = chunk.get(\"video_url\") or {}","+            media.append([\"video\", obj.get(\"url\") if isinstance(obj, dict) else obj])","+            parts.append({\"type\": \"video\"})","+        elif t == \"audio_url\":","+            obj = chunk.get(\"audio_url\") or {}","+            media.append([\"audio\", obj.get(\"url\") if isinstance(obj, dict) else obj])","+            parts.append({\"type\": \"audio\"})","+        elif t in (\"text\", \"input_text\"):","+            parts.append({\"type\": \"text\", \"text\": chunk.get(\"text\", \"\")})","+        elif t == \"tool_reference\":","+            parts.append(chunk)","+        # thinking/reasoning parts are dropped by SGLang here","+    new = {k: v for k, v in msg.items() if v is not None and k != \"content\"}","+    new[\"content\"] = parts","+    return new","+","+","+def _norm_tool_content(role, content):","+    if role != \"tool\" or not isinstance(content, list):","+        return content","+    if all((isinstance(p, dict) and p.get(\"type\") == \"text\") or isinstance(p, str) for p in content):","+        return \" \".join(p.get(\"text\", \"\") if isinstance(p, dict) else p for p in content)","+    return content","+","+","+def normalize_messages(raw_messages):","+    \"\"\"Mirror SGLang ChatCompletionMessageParam validation + model_dump.\"\"\"","+    msgs = []","+    for m in raw_messages:","+        if not isinstance(m, dict):","+            raise CanonError(\"validation:message\")","+        role = m.get(\"role\")","+        if not isinstance(role, str):","+            raise CanonError(\"validation:role\")","+        if role == \"user\":","+            content = m.get(\"content\")","+            if content is None:","+                raise CanonError(\"validation:user_content\")","+            msgs.append({\"role\": \"user\", \"content\": _norm_parts(content, \"user\")})","+            continue","+        if role.lower() not in _GENERIC_ROLES:","+            raise CanonError(\"validation:role\")","+        role = role.lower()","+        content = m.get(\"content\")","+        if content is not None:","+            _norm_parts(content, role)","+        d = {\"role\": role, \"content\": content}","+        for k in (\"tool_call_id\", \"name\", \"reasoning_content\"):","+            if m.get(k) is not None:","+                if not isinstance(m[k], str):","+                    raise CanonError(f\"validation:{k}\")","+                d[k] = m[k]","+        if m.get(\"phase\") is not None:","+            if m[\"phase\"] not in (\"commentary\", \"final_answer\"):","+                raise CanonError(\"validation:phase\")","+            d[\"phase\"] = m[\"phase\"]","+        if m.get(\"tool_calls\") is not None:","+            tcs = []","+            for tc in m[\"tool_calls\"]:","+                if not isinstance(tc, dict) or not isinstance(tc.get(\"function\"), dict):","+                    raise CanonError(\"validation:tool_calls\")","+                fn = tc[\"function\"]","+                tcs.append({\"id\": tc.get(\"id\"), \"index\": tc.get(\"index\"),","+                            \"type\": tc.get(\"type\", \"function\"),","+                            \"function\": {\"name\": fn.get(\"name\"), \"arguments\": fn.get(\"arguments\")}})","+            d[\"tool_calls\"] = tcs","+        if m.get(\"tools\") is not None:","+            d[\"tools\"] = m[\"tools\"]","+        msgs.append(d)","+    # normalize_assistant_tool_call_arguments (strict)","+    for d in msgs:","+        if d.get(\"role\") == \"assistant\" and isinstance(d.get(\"tool_calls\"), list):","+            for tc in d[\"tool_calls\"]:","+                fn = tc.get(\"function\") or {}","+                if isinstance(fn.get(\"arguments\"), str):","+                    try:","+                        parsed = json.loads(fn[\"arguments\"])","+                    except Exception:","+                        raise CanonError(\"validation:tool_call_arguments\")","+                    if not isinstance(parsed, dict):","+                        raise CanonError(\"validation:tool_call_arguments\")","+                    fn[\"arguments\"] = parsed","+    return msgs","+","+","+def _effective_tools(body, msgs):","+    tools = []","+    if isinstance(body.get(\"tools\"), list):","+        tools.extend(body[\"tools\"])","+    for m in msgs:","+        if m.get(\"role\") in (\"system\", \"developer\") and m.get(\"tools\"):","+            tools.extend(m[\"tools\"])","+    return tools","+","+","+def _tool_dump(t):","+    if not isinstance(t, dict):","+        raise CanonError(\"validation:tools\")","+    fn = t.get(\"function\") or {}","+    if not isinstance(fn, dict) or fn.get(\"name\") is None:","+        raise CanonError(\"validation:tools\")","+    return {\"type\": t.get(\"type\", \"function\"),","+            \"function\": {\"description\": fn.get(\"description\"), \"name\": fn.get(\"name\"),","+                         \"parameters\": fn.get(\"parameters\"), \"strict\": fn.get(\"strict\", False)}}","+","+","+_EFFORTS = {\"none\", \"minimal\", \"low\", \"medium\", \"high\", \"xhigh\", \"max\"}","+","+","+def normalize_reasoning(body, ctk):","+    \"\"\"Mirror ChatCompletionRequest.normalize_reasoning_inputs; returns reasoning_effort.\"\"\"","+    thinking = None","+    effort = body.get(\"reasoning_effort\")","+    r = body.get(\"reasoning\")","+    if isinstance(r, dict):","+        e = r.get(\"effort\", r.get(\"reasoning_effort\"))","+        if isinstance(e, str) and e in _EFFORTS:","+            effort = e","+        elif _isnum(e):","+            effort = float(e)","+        elif isinstance(e, str):","+            try:","+                effort = float(e)","+            except ValueError:","+                raise CanonError(\"validation:reasoning_effort\")","+        elif e is not None:","+            raise CanonError(\"validation:reasoning_effort\")","+        en = r.get(\"enabled\", r.get(\"enable\", False))","+        if isinstance(en, str):","+            en = en.strip().lower() in (\"1\", \"true\", \"yes\", \"y\", \"on\")","+        if en:","+            thinking = True","+    if effort is not None:","+        if isinstance(effort, bool):","+            raise CanonError(\"validation:reasoning_effort\")","+        if isinstance(effort, str) and effort not in _EFFORTS:","+            try:","+                effort = float(effort)","+            except ValueError:","+                raise CanonError(\"validation:reasoning_effort\")","+        if _isnum(effort) and not (0.0 <= float(effort) <= 0.99):","+            raise CanonError(\"validation:reasoning_effort\")","+        thinking = effort != \"none\"","+    if thinking is not None:","+        ctk.setdefault(\"thinking\", thinking)","+        ctk.setdefault(\"enable_thinking\", thinking)","+    return effort","+","+","+_SAMPLING_DEFAULTS = {\"temperature\": 1.0, \"top_p\": 1.0, \"top_k\": -1, \"min_p\": 0.0,","+                      \"repetition_penalty\": 1.0}","+","+","+def _str_list(x, field):","+    if x is None:","+        return []","+    if isinstance(x, str):","+        return [x]","+    if isinstance(x, list) and all(isinstance(v, str) for v in x):","+        return list(x)","+    raise CanonError(f\"validation:{field}\")","+","+","+def canon_sampling(body, ctk, vocab, tools_present, tool_choice):","+    \"\"\"Effective SGLang SamplingParams (to_sampling_params + post_init + verify).\"\"\"","+    def param(name):","+        v = body.get(name)","+        if v is None:","+            return _SAMPLING_DEFAULTS[name]","+        return cfloat(v, name) if name != \"top_k\" else v","+","+    temp = param(\"temperature\")","+    top_p = param(\"top_p\")","+    top_k_raw = body.get(\"top_k\")","+    top_k = -1 if top_k_raw is None else cint(top_k_raw, \"top_k\")","+    min_p = param(\"min_p\")","+    rep = param(\"repetition_penalty\")","+    if 0 <= temp < 1e-6:","+        temp, top_k = 1.0, 1","+    if top_k == -1 or top_k >= vocab:","+        top_k_c = \"ALL\"","+    else:","+        top_k_c = top_k","+    max_new = body.get(\"max_completion_tokens\")","+    if not max_new:","+        max_new = body.get(\"max_tokens\")","+    max_new = None if max_new is None else cint(max_new, \"max_tokens\")","+    min_new = cint(body.get(\"min_tokens\", 0), \"min_tokens\") if body.get(\"min_tokens\") is not None else 0","+    stop_tok = body.get(\"stop_token_ids\")","+    biases = {}","+    if body.get(\"logit_bias\"):","+        if not isinstance(body[\"logit_bias\"], dict):","+            raise CanonError(\"validation:logit_bias\")","+        for k, v in body[\"logit_bias\"].items():","+            fv = cfloat(v, \"logit_bias\")","+            if fv != 0.0:","+                biases[str(cint(k, \"logit_bias\"))] = fv","+    s = {","+        \"temperature\": temp, \"top_p\": top_p, \"top_k\": top_k_c, \"min_p\": min_p,","+        \"repetition_penalty\": rep,","+        \"presence_penalty\": cfloat(body.get(\"presence_penalty\", 0.0), \"presence_penalty\") if body.get(\"presence_penalty\") is not None else 0.0,","+        \"frequency_penalty\": cfloat(body.get(\"frequency_penalty\", 0.0), \"frequency_penalty\") if body.get(\"frequency_penalty\") is not None else 0.0,","+        \"max_new_tokens\": max_new, \"min_new_tokens\": min_new,","+        \"stop\": sorted(set(_str_list(body.get(\"stop\"), \"stop\"))),","+        \"stop_token_ids\": sorted({cint(v, \"stop_token_ids\") for v in stop_tok}) if stop_tok else [],","+        \"stop_regex\": sorted(set(_str_list(body.get(\"stop_regex\"), \"stop_regex\"))),","+        \"n\": cint(body.get(\"n\", 1), \"n\") if body.get(\"n\") is not None else 1,","+        \"no_stop_trim\": cbool(body.get(\"no_stop_trim\", False), \"no_stop_trim\") if body.get(\"no_stop_trim\") is not None else False,","+        \"ignore_eos\": cbool(body.get(\"ignore_eos\", False), \"ignore_eos\") if body.get(\"ignore_eos\") is not None else False,","+        \"skip_special_tokens\": cbool(body.get(\"skip_special_tokens\", True), \"skip_special_tokens\") if body.get(\"skip_special_tokens\") is not None else True,","+        \"spaces_between_special_tokens\": ctk.get(\"spaces_between_special_tokens\", True) if isinstance(ctk, dict) else True,","+        \"seed\": body.get(\"seed\"),","+        \"separate_reasoning\": cbool(body.get(\"separate_reasoning\", True), \"separate_reasoning\") if body.get(\"separate_reasoning\") is not None else True,","+        \"continue_final_message\": cbool(body.get(\"continue_final_message\", False), \"continue_final_message\") if body.get(\"continue_final_message\") is not None else False,","+    }","+    if biases:","+        s[\"logit_bias\"] = biases","+    for k in (\"regex\", \"ebnf\"):","+        if body.get(k):","+            s[k] = body[k]","+    rf = body.get(\"response_format\")","+    if isinstance(rf, dict):","+        t = rf.get(\"type\")","+        if t == \"json_object\":","+            s[\"json_schema\"] = '{\"type\": \"object\"}'","+        elif t == \"json_schema\":","+            js = rf.get(\"json_schema\") or {}","+            schema = js.get(\"schema_\") or js.get(\"schema\")","+            s[\"json_schema\"] = json.dumps(schema, sort_keys=True, ensure_ascii=False)","+            s[\"json_schema_strict\"] = js.get(\"strict\")","+        elif t == \"structural_tag\":","+            s[\"structural_tag\"] = json.dumps(rf, sort_keys=True, ensure_ascii=False)","+    if body.get(\"custom_params\"):","+        s[\"custom_params\"] = json.dumps(body[\"custom_params\"], sort_keys=True, ensure_ascii=False, default=str)","+    if body.get(\"watermark\"):","+        s[\"watermark\"] = json.dumps(body[\"watermark\"], sort_keys=True, ensure_ascii=False, default=str)","+    if tools_present and tool_choice not in (\"auto\", \"none\", None):","+        s[\"tool_choice\"] = json.dumps(tool_choice, sort_keys=True, ensure_ascii=False, default=str)","+        s[\"parallel_tool_calls\"] = bool(body.get(\"parallel_tool_calls\", True))","+    # SamplingParams.verify ranges","+    import math","+    if not math.isfinite(temp) or temp < 0:","+        raise CanonError(\"sampling_verify:temperature\")","+    if not (0.0 < top_p <= 1.0):","+        raise CanonError(\"sampling_verify:top_p\")","+    if not (0.0 <= min_p <= 1.0):","+        raise CanonError(\"sampling_verify:min_p\")","+    if top_k_c != \"ALL\" and top_k_c < 1:","+        raise CanonError(\"sampling_verify:top_k\")","+    if not (-2.0 <= s[\"frequency_penalty\"] <= 2.0 and -2.0 <= s[\"presence_penalty\"] <= 2.0):","+        raise CanonError(\"sampling_verify:penalty\")","+    if not (0.0 < rep <= 2.0):","+        raise CanonError(\"sampling_verify:repetition_penalty\")","+    if max_new is not None and (max_new < 0 or min_new > max_new):","+        raise CanonError(\"sampling_verify:max_new_tokens\")","+    if sum(k in s for k in (\"regex\", \"ebnf\", \"json_schema\", \"structural_tag\")) > 1:","+        raise CanonError(\"sampling_verify:grammar_conflict\")","+    return s"],"newLines":438,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/gate/gate.py"}]}