{"files":[{"hunks":[{"lines":["+import glob, sys","+import numpy as np","+import torch","+","+def stats(run):","+    D=[]; D0=[]; DL=[]; K=[]; S_pairs=[]; per_sample_mean=[]","+    p_tokens=[]","+    for f in sorted(glob.glob(f\"/app/runs/{run}/train_data/*.pt\")):","+        rd=torch.load(f,map_location=\"cpu\",weights_only=False)[\"rollout_data\"]","+        def pk(i):","+            n=rd[\"total_lengths\"][i]-rd[\"response_lengths\"][i]; return rd[\"tokens\"][i][:n]","+        groups={}","+        for i in range(len(rd[\"tokens\"])):","+            groups.setdefault(pk(i).numpy().tobytes(),[]).append(i)","+            plen=rd[\"total_lengths\"][i]-rd[\"response_lengths\"][i]","+            resp=rd[\"tokens\"][i][plen:]","+            lp=rd[\"log_probs\"][i].float(); rp=rd[\"rollout_log_probs\"][i].float(); m=rd[\"loss_masks\"][i].bool()","+            d=(lp-rp)","+            md=d[m].numpy(); D.append(md)","+            lr=(-d[m]); K.append((lr.exp()-1-lr).clamp(-10,10).numpy())","+            per_sample_mean.append(md.mean() if len(md) else 0.0)","+            p_tokens.append(lp[m].exp().numpy())","+            idx=torch.nonzero(m).flatten()","+            if idx.numel():","+                fl=1","+                for k in range(1,idx.numel()):","+                    if int(idx[k])==int(idx[k-1])+1: fl+=1","+                    else: break","+                D0.append(md[:fl]); DL.append(md[fl:])","+            # store gen stream for pairs","+            rd.setdefault(\"_gen\",[]).append((resp[m], lp[m]))","+        for g in groups.values():","+            for a in range(len(g)):","+                for b in range(a+1,len(g)):","+                    ta,la=rd[\"_gen\"][g[a]]; tb,lb=rd[\"_gen\"][g[b]]","+                    n=min(len(ta),len(tb))","+                    ne=torch.nonzero(ta[:n]!=tb[:n]); cpl=int(ne[0].item()) if len(ne) else n","+                    S_pairs.append(max(float(la[:cpl].sum()),float(lb[:cpl].sum())) if cpl else 0.0)","+    D=np.concatenate(D); D0=np.concatenate(D0); DL=np.concatenate(DL); K=np.concatenate(K)","+    S=np.array(S_pairs); P=np.concatenate(p_tokens); A=np.abs(D)","+    return dict(run=run, ntok=len(D), meanD=D.mean(), k3=K.mean(), absmean=A.mean(),","+        t05=(A>0.5).mean(), t1=(A>1).mean(), t2=(A>2).mean(),","+        seg0_05=(np.abs(D0)>0.5).mean(), late2=(np.abs(DL)>2).mean(), late_mean=np.abs(DL).mean(),","+        imp=(S<-20).mean(), worstS=S.min(), medS=np.median(S),","+        p001=(P<0.01).mean(), p0001=(P<0.001).mean(),","+        psmean_p1=np.percentile(per_sample_mean,1))","+","+hdr=None","+for run in sys.argv[1:]:","+    r=stats(run)","+    if hdr is None:","+        hdr=list(r.keys()); print(\",\".join(hdr))","+    print(\",\".join(str(round(v,5)) if isinstance(v,float) else str(v) for v in r.values()))"],"newLines":53,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/battery.py"}]}