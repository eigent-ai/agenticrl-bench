{"files":[{"hunks":[{"lines":["+import copy, os, torch","+src=\"/app/runs/screen-prod-s1/train_data/0_0.pt\"","+d=torch.load(src,map_location=\"cpu\",weights_only=False)","+","+# 1) coupled: in each group of 4 consecutive, replace samples 1..3 with copies of sample 0","+d1=copy.deepcopy(d); rd=d1[\"rollout_data\"]","+for base in range(0,128,4):","+    for k in [\"tokens\",\"loss_masks\",\"rollout_log_probs\",\"log_probs\",\"advantages\",\"returns\"]:","+        for j in range(1,4): rd[k][base+j]=rd[k][base].clone()","+    for k in [\"response_lengths\",\"rewards\",\"truncated\",\"raw_reward\",\"total_lengths\"]:","+        for j in range(1,4): rd[k][base+j]=rd[k][base]","+os.makedirs(\"/tmp/fake_coupled/train_data\",exist_ok=True)","+torch.save(d1,\"/tmp/fake_coupled/train_data/0_0.pt\")","+","+# 2) gross shift: rollout logprobs -3 on generated tokens","+d2=copy.deepcopy(d); rd=d2[\"rollout_data\"]","+for i in range(128):","+    m=rd[\"loss_masks\"][i].bool()","+    rd[\"rollout_log_probs\"][i]=rd[\"rollout_log_probs\"][i]-3.0*m.float()","+os.makedirs(\"/tmp/fake_shift/train_data\",exist_ok=True)","+torch.save(d2,\"/tmp/fake_shift/train_data/0_0.pt\")","+print(\"written\")"],"newLines":22,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/synth.py"}]}