{"files":[{"hunks":[{"lines":["+import glob","+import numpy as np","+import torch","+from transformers import AutoTokenizer","+","+tok = AutoTokenizer.from_pretrained(\"/models/Qwen3.5-2B\")","+","+def load(run):","+    out=[]","+    for f in sorted(glob.glob(f\"/app/runs/{run}/train_data/*_0.pt\")):","+        out.append(torch.load(f, map_location=\"cpu\", weights_only=False)[\"rollout_data\"])","+    return out","+","+def prompt_of(rd,i):","+    n=rd[\"total_lengths\"][i]-rd[\"response_lengths\"][i]; return rd[\"tokens\"][i][:n]","+def resp_of(rd,i):","+    n=rd[\"total_lengths\"][i]-rd[\"response_lengths\"][i]; return rd[\"tokens\"][i][n:]","+","+for run in [\"screen-prod-s2\",\"screen-quiet-logging\"]:","+    print(f\"\\n=== identical pairs in {run} ===\")","+    for si,rd in enumerate(load(run)):","+        # group","+        seen={}","+        for i in range(len(rd[\"tokens\"])):","+            seen.setdefault(prompt_of(rd,i).numpy().tobytes(),[]).append(i)","+        for g in seen.values():","+            for a in range(len(g)):","+                for b in range(a+1,len(g)):","+                    ra,rb=resp_of(rd,g[a]),resp_of(rd,g[b])","+                    if torch.equal(ra,rb):","+                        print(f\" step{si} resp_len={len(ra)} raw={rd['raw_reward'][g[a]]} text={tok.decode(ra)[:300]!r}\")","+","+print(\"\\n=== large |delta| tokens, screen-prod-s1 all steps ===\")","+rows=[]","+zero_frac=[]","+for si,rd in enumerate(load(\"screen-prod-s1\")):","+    for i in range(len(rd[\"tokens\"])):","+        lp=rd[\"log_probs\"][i].float(); rp=rd[\"rollout_log_probs\"][i].float(); m=rd[\"loss_masks\"][i].bool()","+        d=(lp-rp)","+        zero_frac.append((d[m]==0).float().mean().item())","+        n=rd[\"total_lengths\"][i]-rd[\"response_lengths\"][i]","+        resp=rd[\"tokens\"][i][n:]","+        # segment id per response position","+        seg=torch.zeros_like(rd[\"loss_masks\"][i])","+        cur=-1; prev=0","+        mm=rd[\"loss_masks\"][i].tolist()","+        pos_in_seg=torch.zeros_like(rd[\"loss_masks\"][i])","+        c=0; p=0","+        for j,v in enumerate(mm):","+            if v==1 and p==0: c+=1; k=0","+            if v==1: pos_in_seg[j]=k; k+=1","+            seg[j]=c","+            p=v","+        big=torch.nonzero(m & (d.abs()>2)).flatten().tolist()","+        for j in big:","+            rows.append(dict(step=si,i=i,j=int(j),seg=int(seg[j]),pis=int(pos_in_seg[j]),","+                             lp=float(lp[j]),rp=float(rp[j]),d=float(d[j]),tok=int(resp[j]),","+                             prev=int(resp[j-1]) if j>0 else int(rd[\"tokens\"][i][n-1])))","+print(f\"exact-zero delta frac (gen tokens): {np.mean(zero_frac):.3f}\")","+print(f\"n |d|>2: {len(rows)}\")","+import collections","+print(\"by seg:\", collections.Counter(r['seg'] for r in rows).most_common(8))","+print(\"by pos-in-seg bucket:\", collections.Counter(min(r['pis'],10) for r in rows).most_common())","+print(\"sign:\", collections.Counter('lp<rp' if r['d']<0 else 'lp>rp' for r in rows))","+tc=collections.Counter(r['tok'] for r in rows)","+print(\"top tokens:\", [(t, tok.decode([t]), c) for t,c in tc.most_common(15)])","+pc=collections.Counter(r['prev'] for r in rows)","+print(\"top prev tokens:\", [(t, tok.decode([t]), c) for t,c in pc.most_common(10)])","+rows.sort(key=lambda r:-abs(r['d']))","+for r in rows[:15]:","+    print(r, repr(tok.decode([r['prev']])), \"->\", repr(tok.decode([r['tok']])))","+# How concentrated per sample?","+sc=collections.Counter((r['step'],r['i']) for r in rows)","+print(\"samples with >=5 big tokens:\", sum(1 for v in sc.values() if v>=5), \"max per sample:\", max(sc.values()))","+print(\"lp of big: mean\", np.mean([r['lp'] for r in rows]), \" rp mean\", np.mean([r['rp'] for r in rows]))"],"newLines":75,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/deep.py"}]}