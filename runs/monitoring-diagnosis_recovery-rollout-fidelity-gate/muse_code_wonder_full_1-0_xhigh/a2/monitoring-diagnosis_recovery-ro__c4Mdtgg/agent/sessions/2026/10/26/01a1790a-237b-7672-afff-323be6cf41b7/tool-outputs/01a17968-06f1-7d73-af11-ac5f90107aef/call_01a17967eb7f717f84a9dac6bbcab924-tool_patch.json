{"files":[{"hunks":[{"lines":["+import torch, pathlib, numpy as np, sys","+rng=np.random.default_rng(3)","+def per_sample(run):","+    # returns list of (sumD, n, sumD_seg_ge1, n_seg_ge1, sumD_seg0, n_seg0) per sample, and per-step k1 list","+    S=[]; step_k1=[]","+    for f in sorted(pathlib.Path(run,\"train_data\").glob(\"*_0.pt\"), key=lambda p:int(p.name.split(\"_\")[0])):","+        rd=torch.load(f,map_location=\"cpu\",weights_only=False)[\"rollout_data\"]","+        Ds=[]","+        for i in range(len(rd[\"tokens\"])):","+            lp=rd[\"log_probs\"][i].numpy().astype(np.float64); rp=rd[\"rollout_log_probs\"][i].numpy().astype(np.float64); lm=rd[\"loss_masks\"][i].numpy()","+            m=lm>0; d=(lp-rp)","+            idx=np.where(m)[0]","+            seg=np.zeros(len(lm),dtype=int); s=-1; prev=-2","+            for j in idx:","+                if j!=prev+1: s+=1","+                seg[j]=s; prev=j","+            d0=d[m&(seg==0)]; d1=d[m&(seg>=1)]","+            S.append((d[m].sum(), m.sum(), d1.sum(), len(d1), d0.sum(), len(d0)))","+            Ds.append(d[m])","+        step_k1.append(float(-np.concatenate(Ds).mean()))","+    return np.array(S), step_k1","+","+for run in sys.argv[1:]:","+    S, sk = per_sample(run)","+    k1 = -S[:,0].sum()/S[:,1].sum(); k1s1=-S[:,2].sum()/S[:,3].sum(); k1s0=-S[:,4].sum()/S[:,5].sum()","+    boots=[]","+    n=len(S)","+    for _ in range(400):","+        idx=rng.choice(n,n,replace=True); B=S[idx]","+        boots.append(-B[:,0].sum()/B[:,1].sum())","+    boots=np.array(boots)","+    print(f\"{run}: pooled k1={k1:.4f} boot95 [{np.quantile(boots,0.025):.4f},{np.quantile(boots,0.975):.4f}] | seg0 k1={k1s0:.4f} seg>=1 k1={k1s1:.4f} | per-step k1 min/med/max {min(sk):.4f}/{float(np.median(sk)):.4f}/{max(sk):.4f}\")"],"newLines":32,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/boot_k1.py"}]}