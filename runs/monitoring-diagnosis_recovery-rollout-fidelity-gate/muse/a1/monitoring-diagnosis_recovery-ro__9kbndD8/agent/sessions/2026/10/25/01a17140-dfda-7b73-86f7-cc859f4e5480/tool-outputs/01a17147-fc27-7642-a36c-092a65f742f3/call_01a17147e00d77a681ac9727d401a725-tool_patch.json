{"files":[{"hunks":[{"lines":["+import glob, sys","+import numpy as np","+import torch","+","+def load(run):","+    return [torch.load(f, map_location=\"cpu\", weights_only=False)[\"rollout_data\"]","+            for f in sorted(glob.glob(f\"/app/runs/{run}/train_data/*_0.pt\"))]","+","+def prompt_of(rd,i):","+    n=rd[\"total_lengths\"][i]-rd[\"response_lengths\"][i]; return rd[\"tokens\"][i][:n]","+def resp_of(rd,i):","+    n=rd[\"total_lengths\"][i]-rd[\"response_lengths\"][i]; return rd[\"tokens\"][i][n:]","+","+def gen_stream(rd,i):","+    r=resp_of(rd,i); m=rd[\"loss_masks\"][i].bool()","+    return r[m], rd[\"log_probs\"][i].float()[m], rd[\"rollout_log_probs\"][i].float()[m]","+","+for run in sys.argv[1:]:","+    S_pairs=[]; per_step=[]","+    # per-turn delta stats","+    turn_abs={}","+    for rd in load(run):","+        stepS=[]","+        seen={}","+        for i in range(len(rd[\"tokens\"])):","+            seen.setdefault(prompt_of(rd,i).numpy().tobytes(),[]).append(i)","+            # turn-stratified delta","+            lp=rd[\"log_probs\"][i].float(); rp=rd[\"rollout_log_probs\"][i].float(); mm=rd[\"loss_masks\"][i].tolist()","+            seg=-1; prev=0","+            for j,v in enumerate(mm):","+                if v==1 and prev==0: seg+=1","+                if v==1:","+                    turn_abs.setdefault(min(seg,7),[]).append(abs((lp[j]-rp[j]).item()))","+                prev=v","+        for g in seen.values():","+            streams=[gen_stream(rd,i) for i in g]","+            for a in range(len(g)):","+                for b in range(a+1,len(g)):","+                    ta,lpa,_=streams[a]; tb,lpb,_=streams[b]","+                    n=min(len(ta),len(tb))","+                    ne=(ta[:n]!=tb[:n]); idx=torch.nonzero(ne)","+                    cpl=int(idx[0].item()) if len(idx) else n","+                    # log prob that B matches A through common prefix, using A-side trainer logp","+                    S=float(lpa[:cpl].sum()) if cpl else 0.0","+                    S_pairs.append(S); stepS.append(S)","+        per_step.append(np.min(stepS) if stepS else 0)","+    S=np.array(S_pairs)","+    print(f\"\\n{run}: pairs={len(S)} match-logprob S: min={S.min():.1f} p1={np.percentile(S,1):.1f} p5={np.percentile(S,5):.1f} p50={np.percentile(S,50):.2f}\")","+    print(f\"  frac S<-10: {(S<-10).mean():.4f}  S<-20: {(S<-20).mean():.5f}  S<-30: {(S<-30).mean():.5f}  count S<-20: {(S<-20).sum()}  step mins: {[round(x,1) for x in per_step]}\")","+    print(\"  turn |delta| mean / frac>0.5 / frac>2 by segment:\")","+    for k in sorted(turn_abs):","+        v=np.array(turn_abs[k]); print(f\"   seg{k}: n={len(v)} mean={v.mean():.4f} >0.5={(v>0.5).mean():.5f} >2={(v>2).mean():.6f}\")"],"newLines":52,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/pairs.py"}]}