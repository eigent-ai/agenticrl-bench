{"files":[{"hunks":[{"lines":["+import torch, pathlib, shutil, copy, numpy as np, os","+src = pathlib.Path(\"/app/runs/screen-prod-s1\")","+","+def make(dst, fn):","+    dst = pathlib.Path(dst)","+    if dst.exists(): shutil.rmtree(dst)","+    (dst/\"train_data\").mkdir(parents=True)","+    for f in sorted((src/\"train_data\").glob(\"*.pt\")):","+        d = torch.load(f, map_location=\"cpu\", weights_only=False)","+        fn(d[\"rollout_data\"])","+        torch.save(d, dst/\"train_data\"/f.name)","+","+def corrupt_dup(rd):","+    # copy first sample of each group of 4 over the other 3 (seed-collapse simulation)","+    for g in range(0, len(rd[\"tokens\"]), 4):","+        for i in range(g+1, g+4):","+            for k in [\"tokens\",\"log_probs\",\"rollout_log_probs\",\"loss_masks\"]:","+                rd[k][i] = rd[k][g].clone()","+            rd[\"response_lengths\"][i]=rd[\"response_lengths\"][g]","+            rd[\"total_lengths\"][i]=rd[\"total_lengths\"][g]","+","+def corrupt_noisy_lps(rd):","+    rng=np.random.default_rng(0)","+    for i in range(len(rd[\"tokens\"])):","+        rp=rd[\"rollout_log_probs\"][i].numpy().astype(np.float64)","+        lm=rd[\"loss_masks\"][i].numpy()>0","+        rp[lm]+=rng.normal(0,0.3,lm.sum())","+        rd[\"rollout_log_probs\"][i]=torch.tensor(rp,dtype=torch.float32)","+","+def corrupt_shift(rd):","+    # systematic: engine overconfident: rollout lp = 1.3*lp (sharper) on masked","+    for i in range(len(rd[\"tokens\"])):","+        rp=rd[\"rollout_log_probs\"][i].numpy().astype(np.float64)","+        lm=rd[\"loss_masks\"][i].numpy()>0","+        rp[lm]*=1.3","+        rd[\"rollout_log_probs\"][i]=torch.tensor(rp,dtype=torch.float32)","+","+make(\"/tmp/synth-dup\", corrupt_dup)","+make(\"/tmp/synth-noisy\", corrupt_noisy_lps)","+make(\"/tmp/synth-shift\", corrupt_shift)","+print(\"done\")"],"newLines":41,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/synth_test.py"}]}