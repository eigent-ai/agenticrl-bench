{"files":[{"hunks":[{"lines":["+import torch, pathlib, numpy as np, hashlib, sys, json","+from collections import defaultdict","+","+def pair_surprise(rd):","+    toks=rd[\"tokens\"]; rl=rd[\"response_lengths\"]; tl=rd[\"total_lengths\"]","+    pl=[tl[i]-rl[i] for i in range(len(tl))]","+    hashes=[hashlib.md5(toks[i][:pl[i]].numpy().tobytes()).hexdigest() for i in range(len(toks))]","+    groups=defaultdict(list)","+    for i,h in enumerate(hashes): groups[h].append(i)","+    Ms=[]; CPFs=[]; exact=0; pairs=0","+    for h, idxs in groups.items():","+        resps=[toks[i][pl[i]:].numpy() for i in idxs]","+        lps=[rd[\"log_probs\"][i].numpy().astype(np.float64) for i in idxs]","+        lms=[rd[\"loss_masks\"][i].numpy() for i in idxs]","+        for a in range(len(idxs)):","+            for b in range(a+1,len(idxs)):","+                pairs+=1","+                ra,rb=resps[a],resps[b]","+                if len(ra)==len(rb) and (ra==rb).all(): exact+=1","+                n=min(len(ra),len(rb))","+                neq=np.where(ra[:n]!=rb[:n])[0]","+                L=int(neq[0]) if len(neq) else n","+                # surprise: -sum LP over masked positions in shared prefix (use sample a LPs)","+                m=lms[a][:L]>0","+                M=float(-lps[a][:L][m].sum()) if L>0 else 0.0","+                Ms.append(M); CPFs.append(L/max(1,n))","+    return np.array(Ms), np.array(CPFs), exact, pairs","+","+def run_stats(run):","+    rows=[]","+    for f in sorted(pathlib.Path(run,\"train_data\").glob(\"*_0.pt\"), key=lambda p:int(p.name.split(\"_\")[0])):","+        rd=torch.load(f,map_location=\"cpu\",weights_only=False)[\"rollout_data\"]","+        Ms,CPFs,exact,pairs=pair_surprise(rd)","+        # LP shape + D pooled per step","+        Ds=[]; LPs=[]","+        for i in range(len(rd[\"tokens\"])):","+            lp=rd[\"log_probs\"][i].numpy().astype(np.float64); rp=rd[\"rollout_log_probs\"][i].numpy().astype(np.float64); lm=rd[\"loss_masks\"][i].numpy()","+            m=lm>0; Ds.append((lp-rp)[m]); LPs.append(lp[m])","+        D=np.concatenate(Ds); LP=np.concatenate(LPs)","+        clipinv=np.minimum(np.exp(-LP),200.0)","+        rows.append(dict(step=int(f.name.split(\"_\")[0]),","+            M_med=float(np.median(Ms)), M_p90=float(np.quantile(Ms,0.9)), M_max=float(Ms.max()),","+            fracM20=float((Ms>20).mean()), fracM50=float((Ms>50).mean()), exact=exact, pairs=pairs,","+            cpf_mean=float(CPFs.mean()),","+            k1=float(-D.mean()), meanabs=float(np.abs(D).mean()), varD=float(D.var()),","+            fracD05=float((np.abs(D)>0.5).mean()), fracD1=float((np.abs(D)>1).mean()),","+            EexpD=float(np.exp(np.clip(D,-20,20)).mean()),","+            meanLP=float(LP.mean()), fracLP5=float((LP<-5).mean()), fracLP3=float((LP<-3).mean()),","+            fracLP8=float((LP<-8).mean()), fracLP01=float((LP>-0.1).mean()), clipInv=float(clipinv.mean()),","+            ntok=len(D)))","+    return rows","+","+out={}","+for run in sys.argv[1:]:","+    rows=run_stats(run); out[run]=rows","+    print(f\"\\n== {run}\")","+    for r in rows:","+        print(f\" s{r['step']}: Mmed={r['M_med']:.1f} Mp90={r['M_p90']:.1f} Mmax={r['M_max']:.1f} fM>20={r['fracM20']:.3f} fM>50={r['fracM50']:.3f} exact={r['exact']}/{r['pairs']} k1={r['k1']:.4f} mabs={r['meanabs']:.4f} EexpD={r['EexpD']:.3f} meanLP={r['meanLP']:.3f} fLP5={r['fracLP5']:.4f} fLP3={r['fracLP3']:.4f} clipInv200={r['clipInv']:.1f}\")","+pathlib.Path(\"/tmp/calibration.json\").write_text(json.dumps(out,indent=1))"],"newLines":59,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze3.py"}]}