19:def merge_samples(samples: list[Sample], tokenizer) -> Sample:
20-    acc = samples[0]
21-    for sample in samples[1:]:
22-        # Only a COMPLETED turn can be extended by a later turn; if an
23-        # intermediate turn truncated, the trajectory ends there.
24-        # TODO (shi.dong): figure out how in-turn truncation should be handled.
25-        if acc.status != Sample.Status.COMPLETED:
26-            break
27-        # Replay metadata must be complete through the merged prefix.
28-        if _introduces_replay_gap(acc, sample):
29-            break
30-        acc = _merge_sample_pair(acc, sample, tokenizer=tokenizer)
31-    return acc
