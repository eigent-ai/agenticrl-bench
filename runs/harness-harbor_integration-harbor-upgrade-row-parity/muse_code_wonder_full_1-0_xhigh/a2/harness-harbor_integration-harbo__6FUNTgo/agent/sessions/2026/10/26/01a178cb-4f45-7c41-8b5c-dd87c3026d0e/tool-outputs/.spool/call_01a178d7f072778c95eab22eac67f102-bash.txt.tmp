90-    def _pop_lifecycle(metadata):
91-        if not metadata or "lifecycle" not in metadata:
92-            return metadata, []
93-        value = metadata["lifecycle"]
94-        rest = {k: v for k, v in metadata.items() if k != "lifecycle"}
95-        return rest, value if isinstance(value, list) else [value]
96-
97-    def _pop_messages(metadata):
98-        if not metadata or "messages" not in metadata:
99-            return metadata, None
