{"files":[{"hunks":[{"lines":["     assert out[\"reward\"] == 0.0"," "," ","+def test_task_with_symlinks_and_seed_trajectory_is_materialised(tasks_dir):","+    \"\"\"Upstream Harbor rejects task inputs that symlink outside the task and","+    seeds the agent from a task-dir trajectory.json; the old stack followed","+    links and ignored that file, so such tasks reach Harbor as a copy.\"\"\"","+    task = tasks_dir / \"task-1\"","+    (task / \"solution\").mkdir()","+    outside = tasks_dir / \"shared.sh\"","+    outside.write_text(\"#!/bin/bash\\necho shared\\n\")","+    (task / \"solution\" / \"solve.sh\").symlink_to(outside)","+    (task / \"solution\" / \"dangling.sh\").symlink_to(tasks_dir / \"missing.sh\")","+    (task / \"trajectory.json\").write_text('{\"messages\": []}')","+","+    cfg = haf.build_trial_config({\"instance_id\": \"task-1\", \"agent_name\": \"terminus-2\"}, \"http://s/v1\", {})","+","+    copied = cfg.task.path","+    assert copied.name == \"task-1\"","+    assert copied.resolve() != task.resolve()","+    assert not (copied / \"trajectory.json\").exists()","+    solve = copied / \"solution\" / \"solve.sh\"","+    assert not solve.is_symlink() and \"echo shared\" in solve.read_text()","+    assert not (copied / \"solution\" / \"dangling.sh\").exists()","+","+"," def test_environment_import_path_takes_precedence(tasks_dir, monkeypatch):","     monkeypatch.setenv(\"HARBOR_ENV_IMPORT_PATH\", \"sandbox_broker.harbor_env:BrokerEnvironment\")","     monkeypatch.setenv(\"HARBOR_ENV_KWARGS\", '{\"sandbox_timeout_secs\": 1800}')"],"newLines":29,"newStart":324,"oldLines":6,"oldStart":324}],"path":"/app/rollout/tests/test_harbor_agent_function.py"}]}