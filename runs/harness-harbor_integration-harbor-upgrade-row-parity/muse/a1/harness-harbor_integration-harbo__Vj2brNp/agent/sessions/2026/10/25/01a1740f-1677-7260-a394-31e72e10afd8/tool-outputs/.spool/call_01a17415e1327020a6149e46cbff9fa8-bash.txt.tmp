831-    async def _find_new_content(self, current_buffer: str) -> str | None:
832-        pb = "" if self._previous_buffer is None else self._previous_buffer.strip()
833-        if pb in current_buffer:
834-            idx = current_buffer.index(pb)
835-            # Find the end of the previous buffer content
836-            if "\n" in pb:
837-                idx = pb.rfind("\n")
838-            return current_buffer[idx:]
839-        return None
