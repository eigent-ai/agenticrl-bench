841:    async def get_incremental_output(self) -> str:
842-        """
843-        Get either new terminal output since last call, or current screen if
844-        unable to determine.
845-
846-        This method tracks the previous buffer state and attempts to find new content
847-        by comparing against the current full buffer. This provides better handling for
848-        commands with large output that would overflow the visible screen.
849-
850-        Returns:
851-            str: Formatted output with either "New Terminal Output:" or
852:                 "Current Terminal Screen:"
853-        """
854:        current_buffer = await self.capture_pane(capture_entire=True)
855-
856-        # First capture - no previous state
857-        if self._previous_buffer is None:
858-            self._previous_buffer = current_buffer
859-            visible_screen = await self._get_visible_screen()
860:            return f"Current Terminal Screen:\n{visible_screen}"
861-
862-        # Try to find new content
863-        new_content = await self._find_new_content(current_buffer)
864-
865-        # Update state
866-        self._previous_buffer = current_buffer
867-
868-        if new_content is not None:
869-            if new_content.strip():
870-                return f"New Terminal Output:\n{new_content}"
871-            else:
872-                # No new content, show current screen
873:                return f"Current Terminal Screen:\n{await self._get_visible_screen()}"
874-        else:
875-            # Couldn't reliably determine new content, fall back to current screen
876:            return f"Current Terminal Screen:\n{await self._get_visible_screen()}"
