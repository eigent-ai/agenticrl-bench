{"files":[{"hunks":[{"lines":["+\"\"\"Compat-layer tests against the REAL upstream harbor (skipped without it).","+","+These pin the harbor-miles branch behaviours ``harbor_compat`` restores, each","+of which changes a training row if upstream's default takes over.","+\"\"\"","+","+import math","+from types import SimpleNamespace","+","+import pytest","+","+pytest.importorskip(\"harbor\")","+","+import harbor_agent_function as haf  # noqa: E402","+import harbor_compat as compat  # noqa: E402","+from harbor.llms.base import ContextLengthExceededError  # noqa: E402","+from harbor.models.verifier.result import VerifierResult  # noqa: E402","+","+","+def _verifier(tmp_path):","+    verifier = object.__new__(compat.LegacyRewardVerifier)","+    verifier.trial_paths = SimpleNamespace(","+        reward_text_path=tmp_path / \"reward.txt\",","+        reward_json_path=tmp_path / \"reward.json\",","+    )","+    return verifier","+","+","+def test_text_reward_nan_passes_through_to_the_agent_function(tmp_path):","+    (tmp_path / \"reward.txt\").write_text(\"nan\\n\")","+    rewards = _verifier(tmp_path)._parse_reward_text()","+    assert math.isnan(rewards[\"reward\"])","+    # ...where trial_result_to_metadata turns it into an aborted sample.","+    result = SimpleNamespace(","+        exception_info=None,","+        verifier_result=SimpleNamespace(rewards=rewards),","+        agent_result=None,","+    )","+    assert haf.trial_result_to_metadata(result)[\"exit_status\"] == \"InfraError\"","+","+","+def test_json_string_rewards_coerce_but_a_non_numeric_extra_kills_the_verdict(tmp_path):","+    (tmp_path / \"reward.json\").write_text('{\"reward\": \"1\", \"checks\": \"4\"}\\n')","+    assert VerifierResult(rewards=_verifier(tmp_path)._parse_reward_json()).rewards == {","+        \"reward\": 1.0,","+        \"checks\": 4.0,","+    }","+    (tmp_path / \"reward.json\").write_text('{\"reward\": \"1\", \"detail\": \"graded\"}\\n')","+    with pytest.raises(Exception):","+        VerifierResult(rewards=_verifier(tmp_path)._parse_reward_json())","+","+","+def test_json_nan_in_a_side_key_does_not_poison_the_reward(tmp_path):","+    (tmp_path / \"reward.json\").write_text('{\"reward\": 1.0, \"recall\": NaN}\\n')","+    rewards = VerifierResult(rewards=_verifier(tmp_path)._parse_reward_json()).rewards","+    assert rewards[\"reward\"] == 1.0 and math.isnan(rewards[\"recall\"])","+","+","+def test_terminus_options_still_carry_the_branch_kwargs():","+    options = compat.MilesTerminus2.parse_options(","+        {","+            \"parser_name\": \"xml\",","+            \"abort_on_response_length_exceeded\": True,","+            \"response_length_exceeded_policy\": \"abort\",","+            \"max_seq_len\": 8192,","+        },","+        {},","+    )","+    assert options.response_length_exceeded_policy == \"abort\"","+    assert options.max_seq_len == 8192","+    assert compat.MilesTerminus2.name() == \"terminus-2\"","+","+","+def test_seq_exceptions_keep_branch_names_and_are_not_retried():","+    for cls, name in [","+        (compat.MaxSeqLenExceededError, \"MaxSeqLenExceededError\"),","+        (compat.SingleTurnMaxSeqLenExceededError, \"SingleTurnMaxSeqLenExceededError\"),","+    ]:","+        assert cls.__name__ == name","+        assert issubclass(cls, ContextLengthExceededError)","+","+","+def test_trial_config_wires_the_compat_agent_and_verifier(tasks_dir=None, tmp_path=None, monkeypatch=None):","+    pass  # wiring is covered with a real tasks dir in the test below","+","+","+def test_built_config_uses_compat_import_paths(tmp_path, monkeypatch):","+    (tmp_path / \"task-1\").mkdir()","+    monkeypatch.setenv(\"HARBOR_TASKS_DIR\", str(tmp_path))","+    monkeypatch.setenv(\"HARBOR_ENV_TYPE\", \"e2b\")","+    cfg = haf.build_trial_config(","+        {\"instance_id\": \"task-1\", \"agent_name\": \"terminus-2\", \"max_seq_len\": 8192},","+        \"http://s/v1\",","+        {},","+    )","+    assert cfg.agent.import_path == \"harbor_compat:MilesTerminus2\"","+    assert cfg.agent.name is None","+    assert cfg.verifier.import_path == \"harbor_compat:LegacyRewardVerifier\"","+","+","+def test_install_trial_compat_ignores_task_trajectories_and_solution_links():","+    compat.install_trial_compat()","+    from harbor.models.task.task import Task","+    from harbor.trial.trial import Trial","+","+    assert Trial._task_trajectory_path(object()) is None","+    validated = []","+    paths = SimpleNamespace(","+        tests_dir=\"tests\",","+        solution_dir=\"solution\",","+        validate_input_tree=lambda path: validated.append(path),","+        step_dir=lambda name: name,","+        step_instruction_path=lambda name: name,","+    )","+    Task._validate_input_paths(SimpleNamespace(steps=[]), paths)","+    assert validated == [\"tests\"]"],"newLines":116,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/rollout/tests/test_harbor_compat.py"}]}