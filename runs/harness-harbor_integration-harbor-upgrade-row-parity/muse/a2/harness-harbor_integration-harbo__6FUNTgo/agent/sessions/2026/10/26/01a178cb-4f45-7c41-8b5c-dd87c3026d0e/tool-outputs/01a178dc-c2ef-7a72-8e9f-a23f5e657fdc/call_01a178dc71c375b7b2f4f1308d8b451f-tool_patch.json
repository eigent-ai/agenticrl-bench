{"files":[{"hunks":[{"lines":["     return {\"reward\": 0.0, \"exit_status\": exit_status, \"eval_report\": {}, \"agent_metrics\": {}}"," "," ","+# --- upstream-Harbor compatibility shims -----------------------------------","+#","+# The harbor-miles branch carried three behaviours upstream does not, and","+# upstream 0.23 tightened a fourth. They are restored here, in-process, so a","+# trial produces the same training row it did on the old branch:","+#","+# 1. Terminus-2 ``response_length_exceeded_policy=\"abort\"`` and the Chat","+#    ``max_seq_len`` check (raising ``SingleTurnMaxSeqLenExceededError`` /","+#    ``MaxSeqLenExceededError``). Upstream's options model forbids those","+#    kwargs, salvages a truncated reply as a fabricated assistant turn, and","+#    has no sequence-length check -- all of which desync the TITO session","+#    server or let the trial run past the trainer's MAX_SEQ_LEN.","+# 2. The verifier still grades the workspace after such an abort (as it","+#    does after an agent timeout): the episode keeps the reward its work","+#    up to the abort earned.","+# 3. Verifier reward parsing as it was: reward.txt is ``float()``-parsed","+#    (so ``inf`` / ``nan`` reach trial_result_to_metadata and become","+#    InfraError there, not a parse failure scoring 0), and reward.json is","+#    handed to ``VerifierResult`` unfiltered (numeric strings coerce,","+#    non-numeric values fail the verifier, non-finite extra keys are","+#    carried). Upstream now rejects non-finite and non-numeric values up","+#    front, which would re-score those episodes.","+#","+# The patches are applied once, lazily, and each is skipped if the Harbor in","+# this process does not have the expected shape (e.g. the faked package in","+# the offline unit tests).","+","+_COMPAT_LOCK = threading.Lock()","+_COMPAT_INSTALLED = False","+_LEGACY_EXCEPTIONS: dict[str, type[Exception]] = {}","+","+","+def _legacy_exception_types() -> dict[str, type[Exception]]:","+    if _LEGACY_EXCEPTIONS:","+        return _LEGACY_EXCEPTIONS","+    try:","+        from harbor.llms.base import ContextLengthExceededError as _base","+    except Exception:  # noqa: BLE001 - faked/absent harbor in offline tests","+        _base = Exception  # type: ignore[assignment]","+","+    # Subclassing ContextLengthExceededError keeps these out of Terminus-2's","+    # LLM-call retries and (with summarisation off, as the recipe has it)","+    # re-raises them from _query_llm untouched, while ``type(e).__name__``","+    # still records the legacy names the result mapping keys on.","+    class MaxSeqLenExceededError(_base):  # type: ignore[valid-type,misc]","+        \"\"\"The whole sequence (prompt + reply) passed max_seq_len.\"\"\"","+","+    class SingleTurnMaxSeqLenExceededError(_base):  # type: ignore[valid-type,misc]","+        \"\"\"One reply hit the per-turn output cap (or one turn alone overflows).\"\"\"","+","+    _LEGACY_EXCEPTIONS.update(","+        MaxSeqLenExceededError=MaxSeqLenExceededError,","+        SingleTurnMaxSeqLenExceededError=SingleTurnMaxSeqLenExceededError,","+    )","+    return _LEGACY_EXCEPTIONS","+","+","+def _install_harbor_compat_shims() -> None:","+    global _COMPAT_INSTALLED","+    with _COMPAT_LOCK:","+        if _COMPAT_INSTALLED:","+            return","+        _COMPAT_INSTALLED = True","+        excs = _legacy_exception_types()","+","+        # 1a. Terminus-2: absorb the legacy kwargs upstream forbids.","+        try:","+            from harbor.agents.terminus_2.terminus_2 import Terminus2","+","+            _orig_init = Terminus2.__init__","+","+            def _terminus_init(self, *args, **kwargs):","+                max_seq_len = kwargs.pop(\"max_seq_len\", None)","+                policy = kwargs.pop(\"response_length_exceeded_policy\", None)","+                abort_flag = kwargs.pop(\"abort_on_response_length_exceeded\", None)","+                if policy is None and abort_flag is not None:","+                    policy = \"abort\" if abort_flag else \"recover\"","+                _orig_init(self, *args, **kwargs)","+                self._miles_max_seq_len = max_seq_len","+                self._miles_response_length_policy = policy","+","+            Terminus2.__init__ = _terminus_init  # type: ignore[method-assign]","+","+            _orig_loop = Terminus2._run_agent_loop","+","+            async def _run_agent_loop(self, initial_prompt, chat, original_instruction=\"\"):","+                chat._miles_max_seq_len = getattr(self, \"_miles_max_seq_len\", None)","+                chat._miles_response_length_policy = getattr(self, \"_miles_response_length_policy\", None)","+                return await _orig_loop(self, initial_prompt, chat, original_instruction)","+","+            Terminus2._run_agent_loop = _run_agent_loop  # type: ignore[method-assign]","+        except Exception:  # noqa: BLE001","+            logger.debug(\"compat shim: Terminus-2 kwargs patch skipped\", exc_info=True)","+","+        # 1b. Chat: abort on a truncated reply and on max_seq_len overflow.","+        try:","+            from harbor.llms.base import OutputLengthExceededError","+            from harbor.llms.chat import Chat","+","+            _orig_chat = Chat.chat","+","+            async def _chat(self, prompt, logging_path=None, **kwargs):","+                max_seq_len = getattr(self, \"_miles_max_seq_len\", None)","+                policy = getattr(self, \"_miles_response_length_policy\", None)","+                try:","+                    response = await _orig_chat(self, prompt, logging_path=logging_path, **kwargs)","+                except OutputLengthExceededError as e:","+                    if policy == \"abort\":","+                        raise excs[\"SingleTurnMaxSeqLenExceededError\"](str(e)) from e","+                    raise","+                usage = getattr(response, \"usage\", None)","+                if max_seq_len is not None and usage is not None:","+                    total = int(usage.prompt_tokens) + int(usage.completion_tokens)","+                    if total > int(max_seq_len):","+                        first_turn = len(getattr(self, \"_messages\", [])) <= 2","+                        name = \"SingleTurnMaxSeqLenExceededError\" if first_turn else \"MaxSeqLenExceededError\"","+                        raise excs[name](f\"sequence length {total} exceeds max_seq_len {max_seq_len}\")","+                return response","+","+            Chat.chat = _chat  # type: ignore[method-assign]","+        except Exception:  # noqa: BLE001","+            logger.debug(\"compat shim: Chat max_seq_len patch skipped\", exc_info=True)","+","+        # 2. Single-step trials: grade after a sequence-length abort.","+        try:","+            from harbor.agents.installed.base import NonZeroAgentExitCodeError","+            from harbor.trial.errors import AgentTimeoutError","+            from harbor.trial.single_step import SingleStepTrial","+","+            _catch = (","+                AgentTimeoutError,","+                NonZeroAgentExitCodeError,","+                excs[\"MaxSeqLenExceededError\"],","+                excs[\"SingleTurnMaxSeqLenExceededError\"],","+            )","+","+            async def _run_agent(self):","+                try:","+                    await self._run_agent_phase(","+                        target=self.result,","+                        instruction=self.task.instruction,","+                        timeout_sec=self._agent_timeout_sec,","+                        user=self.task.config.agent.user,","+                        load=self._load_trajectory is not None,","+                    )","+                except _catch as exc:","+                    self._record_exception(exc)","+                finally:","+                    await self._sync_agent_output(self.result)","+","+            SingleStepTrial._run_agent = _run_agent  # type: ignore[method-assign]","+        except Exception:  # noqa: BLE001","+            logger.debug(\"compat shim: single-step verifier patch skipped\", exc_info=True)","+","+        # 3. Verifier reward parsing as on the old branch.","+        try:","+            from harbor.verifier import verifier as _verifier_mod","+","+            def _parse_reward_text(self):","+                if self.trial_paths.reward_text_path.stat().st_size == 0:","+                    raise _verifier_mod.RewardFileEmptyError(","+                        f\"Reward file is empty at {self.trial_paths.reward_text_path}\"","+                    )","+                try:","+                    value = float(self.trial_paths.reward_text_path.read_text())","+                except (ValueError, TypeError) as e:","+                    raise _verifier_mod.VerifierOutputParseError(","+                        f\"Failed to parse rewards from text file {self.trial_paths.reward_text_path}\"","+                    ) from e","+                return {\"reward\": value}","+","+            def _parse_reward_json(self):","+                if self.trial_paths.reward_json_path.stat().st_size == 0:","+                    raise _verifier_mod.RewardFileEmptyError(","+                        f\"Reward file is empty at {self.trial_paths.reward_json_path}\"","+                    )","+                try:","+                    return json.loads(self.trial_paths.reward_json_path.read_text())","+                except (ValueError, TypeError) as e:","+                    raise _verifier_mod.VerifierOutputParseError(","+                        f\"Failed to parse rewards from JSON file {self.trial_paths.reward_json_path}\"","+                    ) from e","+","+            _verifier_mod.Verifier._parse_reward_text = _parse_reward_text  # type: ignore[method-assign]","+            _verifier_mod.Verifier._parse_reward_json = _parse_reward_json  # type: ignore[method-assign]","+        except Exception:  # noqa: BLE001","+            logger.debug(\"compat shim: verifier parsing patch skipped\", exc_info=True)","+","+"," # --- entry -----------------------------------------------------------------"," "," "],"newLines":195,"newStart":531,"oldLines":6,"oldStart":531}],"path":"/app/rollout/harbor_agent_function.py"}]}