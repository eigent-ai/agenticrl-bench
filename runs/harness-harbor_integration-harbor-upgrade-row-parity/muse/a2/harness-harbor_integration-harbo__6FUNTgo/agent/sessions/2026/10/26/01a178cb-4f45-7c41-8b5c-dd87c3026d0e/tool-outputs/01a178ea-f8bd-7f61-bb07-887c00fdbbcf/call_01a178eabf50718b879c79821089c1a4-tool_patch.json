{"files":[{"hunks":[{"lines":["+\"\"\"Compat-shim tests against the REAL upstream harbor (rollout-next).","+","+These pin the old-branch behaviours _install_harbor_compat_shims restores:","+legacy Terminus-2 kwargs are accepted, a truncated or over-long sequence","+aborts the chat with the legacy exception names, and verifier rewards are","+parsed the way they were (non-finite values reach the result mapping,","+numeric strings coerce, non-numeric values fail in VerifierResult).","+\"\"\"","+","+import asyncio","+import math","+from types import SimpleNamespace","+","+import pytest","+","+harbor = pytest.importorskip(\"harbor\")","+","+import harbor_agent_function as haf  # noqa: E402","+from harbor.agents.factory import AgentFactory  # noqa: E402","+from harbor.llms.base import LLMResponse, OutputLengthExceededError  # noqa: E402","+from harbor.llms.chat import Chat  # noqa: E402","+from harbor.models.metric import UsageInfo  # noqa: E402","+from harbor.models.verifier.result import VerifierResult  # noqa: E402","+from harbor.verifier.verifier import Verifier  # noqa: E402","+","+","<redacted-email>(scope=\"module\", autouse=True)","+def shims():","+    haf._install_harbor_compat_shims()","+","+","<redacted-email>","+def tasks_dir(tmp_path, monkeypatch):","+    (tmp_path / \"task-1\").mkdir()","+    monkeypatch.setenv(\"HARBOR_TASKS_DIR\", str(tmp_path))","+    monkeypatch.setenv(\"HARBOR_ENV_TYPE\", \"e2b\")","+    monkeypatch.delenv(\"HARBOR_ENV_IMPORT_PATH\", raising=False)","+    return tmp_path","+","+","<redacted-email>(\"agent_name\", sorted(haf.HARNESS_BINDINGS))","+def test_built_agent_kwargs_are_accepted_by_real_options(tasks_dir, agent_name):","+    if agent_name in (\"terminus-1\", \"terminus\"):","+        pytest.skip(\"no factory-registered class under this alias upstream\")","+    cfg = haf.build_trial_config(","+        {\"instance_id\": \"task-1\", \"agent_name\": agent_name, \"max_seq_len\": 4096},","+        \"http://s/v1\",","+        {\"temperature\": 0.8, \"max_tokens\": 512},","+    )","+    agent_cls = AgentFactory.get_agent_class(agent_name)","+    # raises ValueError on a forbidden kwarg; None when the class has no model","+    agent_cls.parse_options(dict(cfg.agent.kwargs), dict(cfg.agent.env))","+","+","+def _chat_with(response=None, error=None):","+    class FakeLLM:","+        async def call(self, prompt, **kwargs):","+            if error is not None:","+                raise error","+            return response","+","+    chat = Chat(FakeLLM())","+    chat._miles_max_seq_len = 8192","+    chat._miles_response_length_policy = \"abort\"","+    return chat","+","+","+def test_truncated_reply_aborts_as_single_turn_seq_len():","+    chat = _chat_with(error=OutputLengthExceededError(\"too long\", truncated_response=\"partial\"))","+    with pytest.raises(Exception) as ei:","+        asyncio.run(chat.chat(\"prompt\"))","+    assert type(ei.value).__name__ == \"SingleTurnMaxSeqLenExceededError\"","+","+","+def test_overlong_sequence_aborts_as_max_seq_len():","+    resp = LLMResponse(","+        content=\"ok\",","+        usage=UsageInfo(prompt_tokens=8000, completion_tokens=500, cache_tokens=0, cost_usd=0.0),","+    )","+    chat = _chat_with(response=resp)","+    chat._messages = [{\"role\": \"user\", \"content\": \"x\"}, {\"role\": \"assistant\", \"content\": \"y\"}]","+    with pytest.raises(Exception) as ei:","+        asyncio.run(chat.chat(\"next\"))","+    assert type(ei.value).__name__ == \"MaxSeqLenExceededError\"","+","+","+def _verifier(tmp_path, name, content):","+    path = tmp_path / name","+    path.write_text(content)","+    v = object.__new__(Verifier)","+    v.trial_paths = SimpleNamespace(reward_text_path=path, reward_json_path=path)","+    return v","+","+","+def test_reward_text_non_finite_reaches_the_result_mapping(tmp_path):","+    # inf/nan parse here and become InfraError in trial_result_to_metadata,","+    # not a verifier parse failure scoring 0.","+    assert math.isinf(_verifier(tmp_path, \"reward.txt\", \"inf\\n\")._parse_reward_text()[\"reward\"])","+    out = haf.trial_result_to_metadata(","+        SimpleNamespace(","+            exception_info=None,","+            verifier_result=VerifierResult(rewards={\"reward\": float(\"inf\")}),","+            agent_result=None,","+            environment_setup=None,","+            agent_setup=None,","+            agent_execution=None,","+            verifier=None,","+            started_at=None,","+            finished_at=None,","+        )","+    )","+    assert out[\"exit_status\"] == \"InfraError\"","+","+","+def test_reward_json_is_handed_to_verifier_result_unfiltered(tmp_path):","+    rewards = _verifier(tmp_path, \"reward.json\", '{\"reward\": \"1\", \"recall\": NaN}')._parse_reward_json()","+    result = VerifierResult(rewards=rewards)  # numeric string coerces, NaN extra key is carried","+    assert result.rewards[\"reward\"] == 1.0","+    assert math.isnan(result.rewards[\"recall\"])","+","+    bad = _verifier(tmp_path, \"reward.json\", '{\"reward\": \"1\", \"detail\": \"graded\"}')._parse_reward_json()","+    with pytest.raises(Exception):  # non-numeric value fails the verifier, as it did","+        VerifierResult(rewards=bad)"],"newLines":123,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/rollout/tests/test_harbor_next_compat.py"}]}