q\",rep[\"requests\"],\"executed\",rep[\"executed\"],\"err\",(rep[\"error\"] or \"\")[-300:])","+    print(\"FAILURES\",failures)","+    return failures","+","+sys.exit(1 if asyncio.run(main()) else 0)"],"newLines":52,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_loop_models.py"}]}