{"files":[{"hunks":[{"lines":["+import gzip, json, re, collections","+eps=[json.loads(l) for l in gzip.open(\"/app/agent_rl/data/runs/qwen3-1.7b_sql_2026-10-11/episodes.jsonl.gz\",\"rt\")]","+fails=[]","+for ei,e in enumerate(eps):","+    for ti,t in enumerate(e[\"turns\"]):","+        for m in re.finditer(r\"<tool_call>(.*?)</tool_call>\", t[\"text\"], re.S):","+            try: json.loads(m.group(1).strip())","+            except Exception as ex: fails.append((ei,ti,m.group(1).strip(),str(ex), bool(t.get(\"tool_results\"))))","+print(\"fails\",len(fails),\"with results\",sum(f[4] for f in fails))","+for f in fails[:25]: print(f[0],f[1],\"res\",f[4],\"|\",f[2][:250].replace(\"\\n\",\" \"),\"|\",f[3])","+# think patterns","+c=collections.Counter()","+for e in eps:","+    for t in e[\"turns\"]:","+        txt=t[\"text\"]; res=bool(t.get(\"tool_results\"))","+        tc=txt.find(\"<tool_call>\"); te=txt.find(\"</think>\"); to=txt.find(\"<think>\")","+        if tc!=-1:","+            if to!=-1 and te!=-1 and to<tc<te: k=\"tc_inside_closed_think\"","+            elif to!=-1 and te==-1 and to<tc: k=\"tc_in_open_think_no_close\"","+            elif te!=-1 and tc<te and to==-1: k=\"tc_before_close_no_open\"","+            elif te!=-1 and tc>te: k=\"tc_after_think\"","+            else: k=\"tc_no_think\"","+            c[k]+=1","+            if res: c[k+\"_res\"]+=1","+print(c)","+# prompt tail","+print(repr(eps[0][\"prompt\"][-120:]))"],"newLines":27,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze_q17.py"}]}