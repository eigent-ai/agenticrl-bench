{"files":[{"hunks":[{"lines":["+#!/bin/bash","+set -u","+TREE=$1; TAG=$2","+cd \"$TREE\" || exit 1","+for run in /app/agent_rl/data/runs/*/; do","+  name=$(basename \"$run\")","+  PYTHONPATH=$TREE:/opt/miles:/opt/sglang/python timeout 1200 python3 \"$TREE/tools/replay.py\" \"$run\" --out \"/tmp/replay_${TAG}_${name}.jsonl\" > \"/tmp/replay_${TAG}_${name}.log\" 2>&1","+  echo \"$TAG $name exit:$? $(tail -n 1 /tmp/replay_${TAG}_${name}.log)\"","+done"],"newLines":9,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/run_replays.sh"}]}