{"files":[{"hunks":[{"lines":["+import gzip, json, sys, collections, re","+sys.path.insert(0,\"/opt/sglang/python\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/app/agent_rl\")","+import importlib.util","+spec=importlib.util.spec_from_file_location(\"sql_tool\",\"/app/agent_rl/examples/tool_agent/sql_tool.py\")","+st=importlib.util.module_from_spec(spec); spec.loader.exec_module(st)","+from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser","+from sglang.srt.parser.reasoning_parser import ReasoningParser","+","+eps=[json.loads(l) for l in gzip.open(\"/app/agent_rl/data/runs/qwen3.5-2b_sql_2026-10-08/episodes.jsonl.gz\",\"rt\")]","+def calls_of(text):","+    p=create_tool_call_parser(st.tool_specs,\"qwen3_coder\")","+    _,cs=p.parse_non_stream(text)","+    out=[]","+    for c in cs:","+        try: out.append((c.name, json.loads(c.parameters) if c.parameters else {}))","+        except Exception: out.append((c.name, c.parameters))","+    return out","+def strip_reason(text, force):","+    rp=ReasoningParser(model_type=\"qwen3\", stream_reasoning=False, force_reasoning=force)","+    r,n=rp.parse_non_stream(text)","+    return n or \"\"","+# validate orig reconstruction vs tool_results count","+mismatch=0; total=0","+stats=collections.Counter()","+examples=collections.defaultdict(list)","+for ei,e in enumerate(eps):","+    for ti,t in enumerate(e[\"turns\"]):","+        if t[\"finish_reason\"].get(\"type\")!=\"stop\": continue","+        txt=t[\"text\"]; nres=len(t.get(\"tool_results\") or [])","+        orig=calls_of(txt)","+        total+=1","+        if len(orig)!=nres: mismatch+=1","+        # candidate force True/False","+        candT=calls_of(strip_reason(txt,True))","+        candF=calls_of(strip_reason(txt,False))","+        # strict complete only on raw: complete blocks","+        # draft classification: orig calls that disappear under forceT but a complete block exists in reasoning region?","+        if orig and not candT:","+            stats[\"orig_but_no_candT\"]+=1","+        if orig and candT!=orig:","+            stats[\"orig_diff_candT\"]+=1","+            if \"Final SQL:\" in txt: stats[\"orig_diff_candT_final_anywhere\"]+=1","+            te=txt.rfind(\"</think>\")","+            if te!=-1 and \"Final SQL:\" in txt[te:]: stats[\"orig_diff_candT_final_after_last_think\"]+=1","+            te1=txt.find(\"</think>\")","+            if te1!=-1 and \"Final SQL:\" in txt[te1:]: stats[\"orig_diff_candT_final_after_first_think\"]+=1","+        if orig and candF!=orig: stats[\"orig_diff_candF\"]+=1","+print(\"total stop turns\",total,\"orig count mismatch vs results\",mismatch)","+print(stats)"],"newLines":49,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/repro_oracle.py"}]}