{"files":[{"hunks":[{"lines":["+import gzip, json, collections, re","+path=\"/app/agent_rl/data/runs/qwen3.5-2b_sql_2026-10-08/episodes.jsonl.gz\"","+eps=[json.loads(l) for l in gzip.open(path,\"rt\")]","+# prompt endings","+print(\"prompt tail sample:\", repr(eps[0][\"prompt\"][-300:]))","+tails=collections.Counter(e[\"prompt\"][-40:] for e in eps)","+print(tails.most_common(5))","+def fr(t):","+    x=t[\"finish_reason\"]; return x[\"type\"] if isinstance(x,dict) else x","+","+stats=collections.Counter()","+examples={}","+for ei,e in enumerate(eps):","+    for ti,t in enumerate(e[\"turns\"]):","+        txt=t[\"text\"]; f=fr(t)","+        has_tc=\"<tool_call>\" in txt","+        has_close=\"</tool_call>\" in txt","+        think_end=txt.find(\"</think>\")","+        tc_pos=txt.find(\"<tool_call>\")","+        # categorise","+        if has_tc:","+            stats[\"has_tc\"]+=1","+            if think_end!=-1 and tc_pos < think_end:","+                stats[\"tc_before_think_end\"]+=1","+                # executed in original? tool_results present?","+                if t.get(\"tool_results\"): stats[\"tc_before_think_end_with_results\"]+=1","+                after=txt[think_end+9:]","+                if \"Final SQL:\" in after: stats[\"tc_in_think_and_final_after\"]+=1","+                examples.setdefault(\"think_draft\",(ei,ti,txt,t.get(\"tool_results\"),f))","+            if not has_close:","+                stats[\"tc_no_close\"]+=1","+                if t.get(\"tool_results\"): stats[\"tc_no_close_with_results\"]+=1","+                stats[f\"tc_no_close_finish_{f}\"]+=1","+                examples.setdefault(\"no_close\",(ei,ti,txt,t.get(\"tool_results\"),f))","+            # count opens vs closes","+            if txt.count(\"<tool_call>\")!=txt.count(\"</tool_call>\"):","+                stats[\"tc_open_close_mismatch\"]+=1","+                if t.get(\"tool_results\"): stats[\"mismatch_with_results\"]+=1","+        if \"<think>\" in txt: stats[\"has_think_open\"]+=1","+        if think_end!=-1: stats[\"has_think_end\"]+=1","+        if t.get(\"tool_results\"): stats[\"turns_with_tool_results\"]+=1","+        stats[f\"finish_{f}\"]+=1","+        # tool_call after think","+        if has_tc and think_end!=-1 and tc_pos>think_end: stats[\"tc_after_think\"]+=1","+        if has_tc and think_end==-1: stats[\"tc_no_think_end\"]+=1","+print(stats)","+for k,(ei,ti,txt,res,f) in examples.items():","+    print(\"\\n---\",k,ei,ti,\"finish\",f,\"results\",res)","+    print(txt[:3000])","+","+# More precise: turns where original loop executed (tool_results nonempty) and first tc is before </think>","+n=0;nfinal=0","+for e in eps:","+    for t in e[\"turns\"]:","+        if not t.get(\"tool_results\"): continue","+        txt=t[\"text\"]; te=txt.find(\"</think>\"); tc=txt.find(\"<tool_call>\")","+        if tc!=-1 and te!=-1 and tc<te:","+            n+=1","+            if \"Final SQL:\" in txt[te:]: nfinal+=1","+print(\"executed tc-in-think\",n,\"with Final after\",nfinal)","+# unfinished executed: tool_results and ends inside tool_call: last open after last close","+n=0; ex=[]","+for ei,e in enumerate(eps):","+    for ti,t in enumerate(e[\"turns\"]):","+        if not t.get(\"tool_results\"): continue","+        txt=t[\"text\"]","+        if txt.rfind(\"<tool_call>\") > txt.rfind(\"</tool_call>\"):","+            n+=1; ex.append((ei,ti,txt,fr(t)))","+print(\"executed unfinished (last open>last close)\",n)","+for ei,ti,txt,f in ex[:3]:","+    print(\"\\nUNFIN\",ei,ti,f); print(txt[-2000:])","+# unfinished regardless results by finish","+print(collections.Counter(fr(t) for e in eps for t in e[\"turns\"] if t[\"text\"].rfind(\"<tool_call>\")>t[\"text\"].rfind(\"</tool_call>\") and \"<tool_call>\" in t[\"text\"]))"],"newLines":73,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze_qwen.py"}]}