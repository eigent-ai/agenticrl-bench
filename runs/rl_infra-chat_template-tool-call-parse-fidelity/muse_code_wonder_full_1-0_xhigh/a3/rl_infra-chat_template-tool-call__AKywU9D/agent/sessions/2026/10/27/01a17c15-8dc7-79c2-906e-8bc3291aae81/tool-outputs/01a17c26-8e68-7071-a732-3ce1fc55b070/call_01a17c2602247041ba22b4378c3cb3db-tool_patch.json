{"files":[{"hunks":[{"lines":["+\"\"\"Extract the tool calls a model actually made in its own format, for the training loop.","+","+The deploy endpoint (SGLang's OpenAI server) separates reasoning from visible text","+with the model's reasoning parser and only then looks for tool calls. The /generate","+endpoint used in training does neither, so the loop has to do both steps itself:","+","+1. separate reasoning with SGLang's ReasoningParser (force_reasoning resolved the","+   way the OpenAI server resolves it: from the chat template and the run's","+   chat-template kwargs, corrected per turn by whether the actual prompt ends","+   inside a reasoning block), and look for calls only in the visible text;","+2. extract only complete calls in the model's native format, with each argument","+   exactly as written. For the XML formats (qwen3_coder, glm47) argument values","+   are untyped strings, so the tool's JSON schema decides the conversion; a","+   value whose schema type is string is never re-parsed or reformatted.","+","+SGLang's own one-shot detectors are not used for step 2: in the pinned version","+the qwen3_coder detector also parses a call whose <tool_call> block was never","+closed, the glm47 detector JSON-parses string arguments and re-dumps them,","+the qwen25 detector requires exact newlines around the JSON payload, the","+llama3 detector only sees a bare-JSON call at offset 0, and the gpt-oss","+detector does not recognise the recipient-first harmony header the model's","+own chat template renders.","+\"\"\"","+","+import ast","+import json","+import re","+","+from sglang.srt.function_call.core_types import ToolCallItem","+from sglang.srt.parser.reasoning_parser import ReasoningParser","+from sglang.srt.parser.template_detection import detect_reasoning_pattern","+","+_TOOL_CALL_BLOCK = re.compile(r\"<tool_call>(.*?)</tool_call>\", re.DOTALL)","+","+","+# ---------------------------------------------------------------------------------- reasoning","+","+","+def reasoning_force_from_template(tokenizer, reasoning_parser: str | None, chat_template_kwargs: dict) -> bool:","+    \"\"\"Whether generated text starts inside a reasoning block, resolved like the OpenAI server","+    (template pattern plus the request's reasoning toggle).\"\"\"","+    if not reasoning_parser:","+        return False","+    kwargs = dict(chat_template_kwargs or {})","+    template = getattr(tokenizer, \"chat_template\", None) if tokenizer is not None else None","+    always_on, config = detect_reasoning_pattern(template) if template else (False, None)","+    if always_on or (config is not None and config.special_case == \"always\"):","+        return True","+    if config is not None:","+        if config.toggle_param is None or config.default_enabled is None:","+            return False","+        if config.default_enabled:","+            return not kwargs or kwargs.get(config.toggle_param) is not False","+        return kwargs.get(config.toggle_param) is True","+    try:","+        mode = ReasoningParser(model_type=reasoning_parser).detector.reasoning_default","+    except Exception:  # noqa: BLE001 - unknown parser name: do not force","+        return False","+    if mode == \"always\":","+        return True","+    if mode in (\"thinking\", \"enable_thinking\"):","+        return not kwargs or kwargs.get(mode) is not False","+    if mode in (\"explicit_thinking\", \"explicit_enable_thinking\"):","+        return kwargs.get(mode.replace(\"explicit_\", \"\")) is True","+    return False","+","+","+def prompt_suffix_in_reasoning(suffix_text: str, reasoning_parser: str | None) -> bool | None:","+    \"\"\"True/False when the decoded generation prompt ends inside / outside a reasoning","+    block (its last think tag is an opener / a closer); None when it has neither.\"\"\"","+    if not reasoning_parser or not suffix_text:","+        return None","+    try:","+        detector = ReasoningParser(model_type=reasoning_parser).detector","+    except Exception:  # noqa: BLE001","+        return None","+    start, end = detector.think_start_token, detector.think_end_token","+    if not start or not end or start == end:","+        return None","+    si, ei = suffix_text.rfind(start), suffix_text.rfind(end)","+    if si == -1 and ei == -1:","+        return None","+    return si > ei","+","+","+def separate_reasoning(text: str, reasoning_parser: str | None = None,","+                       force_reasoning: bool = False, tokenizer=None) -> str:","+    \"\"\"The visible part of an assistant turn (what the deploy endpoint hands to the tool parser).\"\"\"","+    if not reasoning_parser:","+        return text","+    parser = ReasoningParser(","+        model_type=reasoning_parser,","+        stream_reasoning=False,","+        force_reasoning=force_reasoning,","+        tokenizer=tokenizer,","+    )","+    _, normal_text = parser.parse_non_stream(text)","+    return normal_text or \"\"","+","+","+# ---------------------------------------------------------------------------------- schemas","+","+","+def _spec_maps(tool_specs) -> tuple[set[str], dict[str, dict]]:","+    names: set[str] = set()","+    params: dict[str, dict] = {}","+    for spec in tool_specs or []:","+        fn = spec.get(\"function\") if isinstance(spec, dict) else getattr(spec, \"function\", None)","+        if fn is None:","+            fn = spec","+        name = fn.get(\"name\") if isinstance(fn, dict) else getattr(fn, \"name\", None)","+        if not isinstance(name, str):","+            continue","+        names.add(name)","+        parameters = fn.get(\"parameters\") if isinstance(fn, dict) else getattr(fn, \"parameters\", None)","+        props = parameters.get(\"properties\") if isinstance(parameters, dict) else None","+        params[name] = props if isinstance(props, dict) else {}","+    return names, params","+","+","+def _schema_types(schema) -> list[str]:","+    \"\"\"Ordered JSON-schema type names for a parameter (type / type list / anyOf / oneOf / allOf).\"\"\"","+    if not isinstance(schema, dict):","+        return []","+    types: list[str] = []","+    direct = schema.get(\"type\")","+    if isinstance(direct, str):","+        types.append(direct)","+    elif isinstance(direct, list):","+        types.extend(t for t in direct if isinstance(t, str))","+    for key in (\"anyOf\", \"oneOf\", \"allOf\"):","+        branches = schema.get(key)","+        if isinstance(branches, list):","+            for branch in branches:","+                types.extend(_schema_types(branch))","+    if not types:","+        enum = schema.get(\"enum\")","+        if isinstance(enum, list) and enum:","+            types.extend(sorted({_json_type_name(v) for v in enum}))","+        elif \"properties\" in schema:","+            types.append(\"object\")","+        elif \"items\" in schema:","+            types.append(\"array\")","+    seen: list[str] = []","+    for t in types:","+        if t not in seen:","+            seen.append(t)","+    return seen","+","+","+def _json_type_name(value) -> str:","+    if value is None:","+        return \"null\"","+    if isinstance(value, bool):","+        return \"boolean\"","+    if isinstance(value, int):","+        return \"integer\"","+    if isinstance(value, float):","+        return \"number\"","+    if isinstance(value, list):","+        return \"array\"","+    if isinstance(value, dict):","+        return \"object\"","+    return \"string\"","+","+","+_INT_RE = re.compile(r\"[+-]?\\d+\")","+","+","+def _convert_xml_value(raw: str, schema):","+    \"\"\"Convert an untyped XML argument string per the tool schema. A string-typed","+    argument is returned exactly as written.\"\"\"","+    types = _schema_types(schema)","+    if not types:","+        return raw","+    non_null = [t for t in types if t != \"null\"]","+    stripped = raw.strip()","+    if non_null == [\"string\"] or not non_null:","+        if \"null\" in types and stripped == \"None\":","+            return None","+        return raw","+    if stripped in (\"null\", \"None\"):","+        return None","+    primary = non_null[0]","+    if primary == \"string\":","+        return raw","+    if primary == \"integer\":","+        try:","+            return int(stripped)","+        except ValueError:","+            try:","+                number = float(stripped)","+            except ValueError:","+                return raw","+            return int(number) if number.is_integer() else raw","+    if primary == \"number\":","+        try:","+            return int(stripped) if _INT_RE.fullmatch(stripped) else float(stripped)","+        except ValueError:","+            return raw","+    if primary == \"boolean\":","+        lowered = stripped.lower()","+        if lowered == \"true\":","+            return True","+        if lowered == \"false\":","+            return False","+        return raw","+    if primary in (\"array\", \"object\"):","+        try:","+            return json.loads(stripped)","+        except Exception:  # noqa: BLE001","+            try:","+                return ast.literal_eval(stripped)","+            except Exception:  # noqa: BLE001","+                return raw","+    return raw","+","+","+def _calls_from_json_obj(obj, names: set[str], filter_unknown: bool = True) -> list[tuple[str, dict]]:","+    if isinstance(obj, list):","+        out: list[tuple[str, dict]] = []","+        for item in obj:","+            out.extend(_calls_from_json_obj(item, names, filter_unknown))","+        return out","+    if not isinstance(obj, dict):","+        return []","+    name = obj.get(\"name\")","+    if not isinstance(name, str) or (filter_unknown and name not in names):","+        return []","+    args = obj[\"parameters\"] if \"parameters\" in obj else obj.get(\"arguments\", {})","+    if args is None:","+        args = {}","+    if isinstance(args, str):","+        try:","+            decoded = json.loads(args)","+            if isinstance(decoded, dict):","+                args = decoded","+        except Exception:  # noqa: BLE001","+            pass","+    if not isinstance(args, dict):","+        return []","+    return [(name, args)]","+","+","+# ---------------------------------------------------------------------------------- XML formats","+","+","+def _extract_qwen3_coder(text: str, spec_params: dict[str, dict]) -> list[tuple[str, dict]]:","+    calls = []","+    for block in _TOOL_CALL_BLOCK.finditer(text):","+        inner = block.group(1)","+        for func in re.finditer(r\"<function=([^>]+)>(.*?)(?:</function>|$)\", inner, re.DOTALL):","+            name, body = func.group(1).strip(), func.group(2)","+            properties = spec_params.get(name, {})","+            params = {}","+            for param in re.finditer(","+                    r\"<parameter=([^>]+)>(.*?)(?:</parameter>|(?=<parameter=)|$)\", body, re.DOTALL):","+                value = param.group(2)","+                # The template renders \"<parameter=name>\\nvalue\\n</parameter>\":","+                # one leading and one trailing newline are framing, the rest is the value.","+                if value.startswith(\"\\n\"):","+                    value = value[1:]","+                if value.endswith(\"\\n\"):","+                    value = value[:-1]","+                pname = param.group(1).strip()","+                params[pname] = _convert_xml_value(value, properties.get(pname))","+            if name:","+                calls.append((name, params))","+    return calls","+","+","+_GLM_ARG = re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>(.*?)</arg_value>\", re.DOTALL)","+","+","+def _extract_glm(text: str, names: set[str], spec_params: dict[str, dict]) -> list[tuple[str, dict]]:","+    calls = []","+    for block in _TOOL_CALL_BLOCK.finditer(text):","+        inner = block.group(1)","+        name = inner.split(\"<arg_key>\", 1)[0].strip()","+        if not name or name not in names:","+            continue","+        properties = spec_params.get(name, {})","+        params = {}","+        for arg in _GLM_ARG.finditer(inner):","+            key = arg.group(1).strip()","+            params[key] = _convert_xml_value(arg.group(2), properties.get(key))","+        calls.append((name, params))","+    return calls","+","+","+# ---------------------------------------------------------------------------------- JSON formats","+","+","+def _extract_json_blocks(text: str, names: set[str]) -> list[tuple[str, dict]]:","+    calls = []","+    for block in _TOOL_CALL_BLOCK.finditer(text):","+        payload = block.group(1).strip()","+        if not payload:","+            continue","+        try:","+            obj = json.loads(payload)","+        except Exception:  # noqa: BLE001","+            try:","+                obj, _ = json.JSONDecoder().raw_decode(payload)","+            except Exception:  # noqa: BLE001 - malformed / unfinished JSON: not a call the model made","+                continue","+        calls.extend(_calls_from_json_obj(obj, names))","+    return calls","+","+","+def _balanced_object(text: str, start: int) -> tuple[str, int] | None:","+    depth, quote, i = 0, None, start","+    while i < len(text):","+        ch = text[i]","+        if quote is not None:","+            if ch == \"\\\\\":","+                i += 1","+            elif ch == quote:","+                quote = None","+        elif ch in (\"'\", '\"'):","+            quote = ch","+        elif ch in \"{[\":","+            depth += 1","+        elif ch in \"}]\":","+            depth -= 1","+            if depth == 0:","+                return text[start: i + 1], i + 1","+        i += 1","+    return None","+","+","+def _parse_json_sequence(text: str, names: set[str]) -> list[tuple[str, dict]]:","+    calls = []","+    decoder = json.JSONDecoder()","+    idx = 0","+    while idx < len(text):","+        while idx < len(text) and text[idx] in \" \\t\\r\\n;,\":","+            idx += 1","+        if idx >= len(text) or text[idx] not in \"{[\":","+            break","+        try:","+            obj, end = decoder.raw_decode(text[idx:])","+            idx += end","+        except Exception:  # noqa: BLE001 - try a Python-dict style object, else the call is unfinished","+            balanced = _balanced_object(text, idx)","+            if balanced is None:","+                break","+            chunk, idx = balanced","+            try:","+                obj = ast.literal_eval(chunk)","+            except Exception:  # noqa: BLE001","+                break","+        calls.extend(_calls_from_json_obj(obj, names))","+    return calls","+","+","+def _extract_llama(text: str, names: set[str]) -> list[tuple[str, dict]]:","+    if \"<|python_tag|>\" in text:","+        calls = []","+        for part in text.split(\"<|python_tag|>\")[1:]:","+            if part.lstrip()[:1] in (\"{\", \"[\"):","+                calls.extend(_parse_json_sequence(part, names))","+        return calls","+    stripped = text.lstrip()","+    if stripped[:1] in (\"{\", \"[\"):","+        return _parse_json_sequence(stripped, names)","+    return []","+","+","+_GPT_OSS_CALL = re.compile(","+    r\"to=([A-Za-z_][A-Za-z0-9_.-]*)(?:(?!<\\|call\\|>|<\\|end\\|>).)*?<\\|message\\|>(.*?)(?=<\\|call\\|>)\",","+    re.DOTALL,","+)","+","+","+def _extract_gpt_oss(text: str, names: set[str]) -> list[tuple[str, dict]]:","+    calls = []","+    for match in _GPT_OSS_CALL.finditer(text):","+        name = match.group(1).split(\".\")[-1]","+        if name not in names:","+            continue","+        payload = match.group(2).strip()","+        try:","+            args = json.loads(payload) if payload else {}","+        except Exception:  # noqa: BLE001","+            continue","+        if isinstance(args, dict):","+            calls.append((name, args))","+    return calls","+","+","+# ---------------------------------------------------------------------------------- entry point","+","+","+def _extract_pairs(text: str, tool_specs, tool_call_parser: str | None) -> list[tuple[str, dict]]:","+    names, spec_params = _spec_maps(tool_specs)","+    parser = (tool_call_parser or \"\").strip().lower()","+    if parser == \"qwen3_coder\" or parser == \"step3p5\":","+        return _extract_qwen3_coder(text, spec_params)","+    if parser in (\"glm47\", \"glm45\", \"glm\"):","+        return _extract_glm(text, names, spec_params)","+    if parser in (\"qwen25\", \"qwen\", \"hermes\"):","+        return _extract_json_blocks(text, names)","+    if parser == \"llama3\":","+        return _extract_llama(text, names)","+    if parser == \"gpt-oss\":","+        return _extract_gpt_oss(text, names)","+    if not parser:","+        return []","+    # A parser this module does not specialise: fall back to SGLang's one-shot detector.","+    from pydantic import TypeAdapter","+","+    from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser  # noqa: F401  (kept for parity)","+","+    from sglang.srt.entrypoints.openai.protocol import Tool","+    from sglang.srt.function_call.function_call_parser import FunctionCallParser","+","+    fallback = FunctionCallParser(","+        tools=TypeAdapter(list[Tool]).validate_python(tool_specs), tool_call_parser=parser)","+    _, items = fallback.parse_non_stream(text)","+    pairs = []","+    for item in items:","+        try:","+            params = json.loads(item.parameters) if item.parameters else {}","+        except Exception:  # noqa: BLE001","+            continue","+        if item.name and isinstance(params, dict):","+            pairs.append((item.name, params))","+    return pairs","+","+","+def parse_tool_calls(text: str, tool_specs, tool_call_parser: str | None, *,","+                     reasoning_parser: str | None = None,","+                     force_reasoning: bool = False, tokenizer=None) -> list[ToolCallItem]:","+    \"\"\"The complete calls the model made in one assistant turn, in the order written.\"\"\"","+    visible = separate_reasoning(text, reasoning_parser, force_reasoning, tokenizer)","+    pairs = _extract_pairs(visible, tool_specs, tool_call_parser)","+    return [","+        ToolCallItem(tool_index=i, name=name, parameters=json.dumps(params, ensure_ascii=False))","+        for i, (name, params) in enumerate(pairs)","+    ]"],"newLines":441,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/agent_rl/examples/tool_agent/tool_call_parsing.py"}]}