{"files":[{"hunks":[{"lines":["+\"\"\"The rollout loop must execute exactly the calls the model made in its own format:","+every complete call outside its reasoning, never a draft inside reasoning or an","+unfinished call, with every argument exactly as written (the tool schema decides","+the type where the format leaves it open).","+","+Run with:  PYTHONPATH=/app/agent_rl:/opt/miles:/opt/sglang/python python -m unittest discover -s tests","+\"\"\"","+","+import json","+import os","+import sys","+import unittest","+","+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))","+if os.path.isdir(\"/opt/sglang/python\"):","+    sys.path.insert(0, \"/opt/sglang/python\")","+","+from examples.tool_agent.tool_call_parsing import parse_tool_calls  # noqa: E402","+","+TOOL_SPECS = [","+    {\"type\": \"function\", \"function\": {","+        \"name\": \"execute_sql\", \"description\": \"run sql\",","+        \"parameters\": {\"type\": \"object\", \"properties\": {","+            \"database\": {\"type\": \"string\"}, \"query\": {\"type\": \"string\"}},","+            \"required\": [\"database\", \"query\"]}}},","+    {\"type\": \"function\", \"function\": {","+        \"name\": \"execute_bash\", \"description\": \"run bash\",","+        \"parameters\": {\"type\": \"object\", \"properties\": {","+            \"command\": {\"type\": \"string\"},","+            \"timeout\": {\"anyOf\": [{\"type\": \"number\"}, {\"type\": \"null\"}], \"default\": None}},","+            \"required\": [\"command\"]}}},","+    {\"type\": \"function\", \"function\": {","+        \"name\": \"str_replace_editor\", \"description\": \"edit files\",","+        \"parameters\": {\"type\": \"object\", \"properties\": {","+            \"command\": {\"type\": \"string\", \"enum\": [\"view\", \"create\", \"str_replace\", \"insert\"]},","+            \"path\": {\"type\": \"string\"}, \"file_text\": {\"type\": \"string\"},","+            \"old_str\": {\"type\": \"string\"}, \"new_str\": {\"type\": \"string\"},","+            \"insert_line\": {\"type\": \"integer\"},","+            \"view_range\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}}},","+            \"required\": [\"command\", \"path\"]}}},","+]","+","+","+def calls(text, tool_parser, reasoning_parser=None, force_reasoning=False):","+    items = parse_tool_calls(text, TOOL_SPECS, tool_parser,","+                               reasoning_parser=reasoning_parser, force_reasoning=force_reasoning)","+    return [(c.name, json.loads(c.parameters)) for c in items]","+","+","+SQL_C = ('<tool_call>\\n<function=execute_sql>\\n<parameter=database>\\ndb1\\n</parameter>\\n'","+         '<parameter=query>\\nSELECT 1\\n</parameter>\\n</function>\\n</tool_call>')","+SQL_C_ARGS = (\"execute_sql\", {\"database\": \"db1\", \"query\": \"SELECT 1\"})","+","+","+class Qwen3CoderTest(unittest.TestCase):","+    def parse(self, text, force=True):","+        return calls(text, \"qwen3_coder\", \"qwen3\", force)","+","+    def test_draft_in_reasoning_dropped_real_call_kept(self):","+        text = f\"thinking\\n{SQL_C}\\nmore thinking</think>\\n{SQL_C}<|im_end|>\"","+        self.assertEqual(self.parse(text), [SQL_C_ARGS])","+","+    def test_draft_only_then_final_answer_no_calls(self):","+        text = f\"thinking\\n{SQL_C}</think>\\nFinal SQL:\\n```sql\\nSELECT 2\\n```<|im_end|>\"","+        self.assertEqual(self.parse(text), [])","+","+    def test_unfinished_call_dropped(self):","+        text = \"</think>\\n<tool_call>\\n<function=execute_sql>\\n<parameter=database>\\ndb1\\n<|im_end|>\"","+        self.assertEqual(self.parse(text), [])","+","+    def test_complete_then_unfinished_keeps_complete_only(self):","+        text = f\"</think>{SQL_C}\\n<tool_call>\\n<function=execute_sql>\\n<parameter=query>\\nSELECT 9\"","+        self.assertEqual(self.parse(text), [SQL_C_ARGS])","+","+    def test_tool_call_without_think_close_kept(self):","+        # Qwen3.5 sometimes opens <tool_call> without </think>: an implicit reasoning close.","+        self.assertEqual(self.parse(f\"reasoning text{SQL_C}<|im_end|>\"), [SQL_C_ARGS])","+","+    def test_string_arguments_exact_and_schema_types_applied(self):","+        text = (\"</think><tool_call>\\n<function=str_replace_editor>\\n\"","+                \"<parameter=command>\\ncreate\\n</parameter>\\n\"","+                \"<parameter=path>\\n/work/answer.json\\n</parameter>\\n\"","+                \"<parameter=file_text>\\n[1, 22]\\n\\n</parameter>\\n\"","+                \"</function>\\n</tool_call>\"","+                \"<tool_call>\\n<function=execute_bash>\\n\"","+                \"<parameter=command>\\nnull\\n</parameter>\\n\"","+                \"<parameter=timeout>\\n30\\n</parameter>\\n\"","+                \"</function>\\n</tool_call>\"","+                \"<tool_call>\\n<function=str_replace_editor>\\n\"","+                \"<parameter=command>\\nview\\n</parameter>\\n\"","+                \"<parameter=path>\\n/work/answer.json\\n</parameter>\\n\"","+                \"<parameter=view_range>\\n[1, -1]\\n</parameter>\\n\"","+                \"</function>\\n</tool_call>\")","+        self.assertEqual(self.parse(text), [","+            (\"str_replace_editor\", {\"command\": \"create\", \"path\": \"/work/answer.json\",","+                                    \"file_text\": \"[1, 22]\\n\"}),","+            (\"execute_bash\", {\"command\": \"null\", \"timeout\": 30}),","+            (\"str_replace_editor\", {\"command\": \"view\", \"path\": \"/work/answer.json\",","+                                    \"view_range\": [1, -1]}),","+        ])","+","+","+class Glm47Test(unittest.TestCase):","+    def parse(self, text, force=True):","+        return calls(text, \"glm47\", \"glm45\", force)","+","+    def test_json_looking_string_argument_not_reformatted(self):","+        raw = \"[\\n  [\\n    36.0,\\n    8\\n  ]\\n]\\n\"","+        text = (f\"reasoning</think><tool_call>str_replace_editor\"","+                f\"<arg_key>command</arg_key><arg_value>create</arg_value>\"","+                f\"<arg_key>path</arg_key><arg_value>/work/answer.json</arg_value>\"","+                f\"<arg_key>file_text</arg_key><arg_value>{raw}</arg_value></tool_call><|observation|>\")","+        self.assertEqual(self.parse(text), [","+            (\"str_replace_editor\", {\"command\": \"create\", \"path\": \"/work/answer.json\", \"file_text\": raw})])","+","+    def test_number_schema_argument_converted_and_draft_dropped(self):","+        draft = (\"<tool_call>execute_bash<arg_key>command</arg_key>\"","+                 \"<arg_value>rm answer.json</arg_value></tool_call>\")","+        text = (f\"plan {draft} more</think><tool_call>execute_bash\"","+                f\"<arg_key>command</arg_key><arg_value>ls</arg_value>\"","+                f\"<arg_key>timeout</arg_key><arg_value>10</arg_value></tool_call>\")","+        self.assertEqual(self.parse(text), [(\"execute_bash\", {\"command\": \"ls\", \"timeout\": 10})])","+","+    def test_unfinished_and_implicit_think_close(self):","+        unfinished = \"reasoning</think><tool_call>execute_bash<arg_key>command</arg_key><arg_value>ls\"","+        self.assertEqual(self.parse(unfinished), [])","+        implicit = (\"reasoning<tool_call>execute_bash<arg_key>command</arg_key>\"","+                    \"<arg_value>ls</arg_value></tool_call>\")","+        self.assertEqual(self.parse(implicit), [(\"execute_bash\", {\"command\": \"ls\"})])","+","+","+class Qwen25Test(unittest.TestCase):","+    BLOCK = '<tool_call>\\n{\"name\": \"execute_sql\", \"arguments\": {\"database\": \"db1\", \"query\": \"SELECT 1\"}}\\n</tool_call>'","+    ARGS = (\"execute_sql\", {\"database\": \"db1\", \"query\": \"SELECT 1\"})","+","+    def test_thinking_off_model_opened_think_draft_dropped(self):","+        text = f\"<think>\\ndraft {self.BLOCK}\\n</think>\\n{self.BLOCK}<|im_end|>\"","+        self.assertEqual(calls(text, \"qwen25\", \"qwen3\", False), [self.ARGS])","+","+    def test_open_think_then_call_without_close_kept(self):","+        text = f\"<think>\\n{self.BLOCK}<|im_end|>\"","+        self.assertEqual(calls(text, \"qwen25\", \"qwen3\", False), [self.ARGS])","+","+    def test_no_newline_variant_and_unfinished_and_invalid(self):","+        compact = '<tool_call>{\"name\": \"execute_sql\", \"arguments\": {\"database\": \"db1\", \"query\": \"SELECT 1\"}}</tool_call>'","+        self.assertEqual(calls(compact, \"qwen25\"), [self.ARGS])","+        self.assertEqual(calls('<tool_call>\\n{\"name\": \"execute_sql\", \"arguments\": {\"database\": \"db1\"', \"qwen25\"), [])","+        invalid = '<tool_call>\\n{\"name\": \"execute_sql\", \"arguments\": {\"query\": \"PRAGMA table_info(song\")}\\n</tool_call>'","+        self.assertEqual(calls(invalid, \"qwen25\"), [])","+","+","+class Llama3Test(unittest.TestCase):","+    ARGS = (\"execute_sql\", {\"database\": \"db1\", \"query\": \"SELECT 1\"})","+","+    def test_bare_json_template_format(self):","+        self.assertEqual(calls('{\"name\": \"execute_sql\", \"parameters\": {\"database\": \"db1\", \"query\": \"SELECT 1\"}}<|eot_id|>', \"llama3\"),","+                         [self.ARGS])","+        self.assertEqual(calls('\\n {\"name\": \"execute_sql\", \"arguments\": {\"database\": \"db1\", \"query\": \"SELECT 1\"}}', \"llama3\"),","+                         [self.ARGS])","+","+    def test_python_tag_and_multiple_and_unfinished(self):","+        tag = '<|python_tag|>{\"name\": \"execute_sql\", \"parameters\": {\"database\": \"db1\", \"query\": \"SELECT 1\"}}'","+        self.assertEqual(calls(tag, \"llama3\"), [self.ARGS])","+        two = ('{\"name\": \"execute_sql\", \"parameters\": {\"database\": \"db1\", \"query\": \"SELECT 1\"}};\\n'","+               '{\"name\": \"execute_sql\", \"parameters\": {\"database\": \"db1\", \"query\": \"SELECT 2\"}}')","+        self.assertEqual(calls(two, \"llama3\"),","+                         [self.ARGS, (\"execute_sql\", {\"database\": \"db1\", \"query\": \"SELECT 2\"})])","+        self.assertEqual(calls('{\"name\": \"execute_sql\", \"parameters\": {\"database\": \"db1\", \"query\": \"SEL', \"llama3\"), [])","+        self.assertEqual(calls('{\"answer\": [1, 2]}', \"llama3\"), [])","+","+","+class GptOssTest(unittest.TestCase):","+    ARGS = (\"execute_sql\", {\"database\": \"db1\", \"query\": \"SELECT 1\"})","+    PAYLOAD = '{\"database\": \"db1\", \"query\": \"SELECT 1\"}'","+","+    def test_analysis_draft_dropped_recipient_first_call_kept(self):","+        text = (f\"<|channel|>analysis<|message|>I might call functions.execute_sql {self.PAYLOAD} later<|end|>\"","+                f\"<|start|>assistant to=functions.execute_sql<|channel|>commentary json<|message|>{self.PAYLOAD}<|call|>\")","+        self.assertEqual(calls(text, \"gpt-oss\", \"gpt-oss\", True), [self.ARGS])","+","+    def test_channel_first_constrain_variant_kept(self):","+        text = (f\"<|channel|>analysis<|message|>plan<|end|>\"","+                f\"<|start|>assistant<|channel|>commentary to=functions.execute_sql<|constrain|>json<|message|>{self.PAYLOAD}<|call|>\")","+        self.assertEqual(calls(text, \"gpt-oss\", \"gpt-oss\", True), [self.ARGS])","+","+    def test_unfinished_commentary_call_dropped(self):","+        text = f\"<|start|>assistant to=functions.execute_sql<|channel|>commentary json<|message|>{self.PAYLOAD}\"","+        self.assertEqual(calls(text, \"gpt-oss\", \"gpt-oss\", True), [])","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"newLines":192,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/agent_rl/tests/test_tool_call_parsing.py"}]}