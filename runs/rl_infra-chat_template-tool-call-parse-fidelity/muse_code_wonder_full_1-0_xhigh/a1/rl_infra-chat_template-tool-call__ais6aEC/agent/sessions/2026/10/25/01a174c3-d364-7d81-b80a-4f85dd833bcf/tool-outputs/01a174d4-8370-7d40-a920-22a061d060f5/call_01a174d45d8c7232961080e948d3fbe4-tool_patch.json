{"files":[{"hunks":[{"lines":["     props = properties.get(func_name) or {}","     return {k: convert_xml_value(v, props.get(k) if isinstance(props, dict) else None)","             for k, v in raw_params}","+","+","+_TOOL_BLOCK_RE = re.compile(r\"<tool_call>(.*?)</tool_call>\", re.DOTALL)","+_QC_FUNCTION_RE = re.compile(r\"<function=([^>]+)>(.*?)</function>\", re.DOTALL)","+_QC_PARAM_RE = re.compile(r\"<parameter=([^>]+)>\")","+_GLM_PAIR_RE = re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>(.*?)</arg_value>\", re.DOTALL)","+","+","+def _parse_qwen3_coder(text: str, properties: dict[str, dict]) -> list[tuple[str, dict]]:","+    calls = []","+    for block in _TOOL_BLOCK_RE.findall(text):","+        for raw_name, body in _QC_FUNCTION_RE.findall(block):","+            name = raw_name.strip()","+            if not name:","+                continue","+            raw_params: list[tuple[str, str]] = []","+            matches = list(_QC_PARAM_RE.finditer(body))","+            for j, m in enumerate(matches):","+                seg_end = matches[j + 1].start() if j + 1 < len(matches) else len(body)","+                value = body[m.end():seg_end]","+                close = value.rfind(\"</parameter>\")","+                if close != -1:","+                    value = value[:close]","+                if value.startswith(\"\\n\"):","+                    value = value[1:]","+                if value.endswith(\"\\n\"):","+                    value = value[:-1]","+                raw_params.append((m.group(1).strip(), value))","+            # As in SGLang's detector, an unknown function is still a call","+            # (the tool executor reports it as not found).","+            calls.append((name, _convert_params(raw_params, name, properties)))","+    return calls","+","+","+def _parse_glm(text: str, properties: dict[str, dict]) -> list[tuple[str, dict]]:","+    calls = []","+    for block in _TOOL_BLOCK_RE.findall(text):","+        name = block.split(\"<arg_key>\", 1)[0].strip()","+        if not name or name not in properties:","+            continue","+        raw_params = [(k.strip(), v) for k, v in _GLM_PAIR_RE.findall(block)]","+        calls.append((name, _convert_params(raw_params, name, properties)))","+    return calls","+","+","+def _arguments_of(obj: dict) -> dict | None:","+    args = obj.get(\"arguments\", obj.get(\"parameters\", {}))","+    if isinstance(args, dict):","+        return args","+    if isinstance(args, str):","+        try:","+            parsed = json.loads(args) if args.strip() else {}","+        except (json.JSONDecodeError, ValueError):","+            return None","+        return parsed if isinstance(parsed, dict) else None","+    return None","+","+","+def _calls_from_json_value(value: Any, properties: dict[str, dict]) -> list[tuple[str, dict]]:","+    calls = []","+    for obj in value if isinstance(value, list) else [value]:","+        if not isinstance(obj, dict):","+            continue","+        name = obj.get(\"name\")","+        if not isinstance(name, str) or name not in properties:","+            continue","+        args = _arguments_of(obj)","+        if args is not None:","+            calls.append((name, args))","+    return calls","+","+","+def _parse_json_blocks(text: str, properties: dict[str, dict]) -> list[tuple[str, dict]]:","+    \"\"\"Qwen2.5 / Hermes ``<tool_call>{json}</tool_call>`` blocks.\"\"\"","+    calls = []","+    for block in _TOOL_BLOCK_RE.findall(text):","+        try:","+            value = json.loads(block.strip())","+        except (json.JSONDecodeError, ValueError):","+            continue","+        calls.extend(_calls_from_json_value(value, properties))","+    return calls"],"newLines":85,"newStart":209,"oldLines":3,"oldStart":209}],"path":"/app/agent_rl/examples/tool_agent/tool_call_parsing.py"}]}