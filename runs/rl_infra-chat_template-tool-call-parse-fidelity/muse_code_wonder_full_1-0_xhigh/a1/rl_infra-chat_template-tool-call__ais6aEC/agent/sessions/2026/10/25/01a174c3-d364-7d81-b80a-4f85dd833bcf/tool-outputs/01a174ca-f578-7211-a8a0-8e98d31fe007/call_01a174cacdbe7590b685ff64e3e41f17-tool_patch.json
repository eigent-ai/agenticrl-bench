{"files":[{"hunks":[{"lines":["+import gzip, json, re, sys, collections","+sys.path.insert(0,\"/opt/sglang/python\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/app/agent_rl\")","+from examples.tool_agent.sql_tool import tool_specs","+from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser","+from sglang.srt.parser.reasoning_parser import ReasoningParser","+","+eps=[json.loads(l) for l in gzip.open(\"/app/agent_rl/data/runs/qwen3.5-2b_sql_2026-10-08/episodes.jsonl.gz\",\"rt\")]","+parser=create_tool_call_parser(tool_specs,\"qwen3_coder\")","+def calls(txt):","+    try:","+        _,cs=parser.parse_non_stream(txt)","+        return [(c.name,c.parameters) for c in cs]","+    except Exception as e:","+        return [(\"ERR\",str(e))]","+def strip_reason(txt,force):","+    rp=ReasoningParser(model_type=\"qwen3\",stream_reasoning=False,force_reasoning=force)","+    r,n=rp.parse_non_stream(txt)","+    return n or \"\"","+c=collections.Counter()","+examples=collections.defaultdict(list)","+for ep in eps:","+ for ti,t in enumerate(ep[\"turns\"]):","+  txt=t[\"text\"]; res=t.get(\"tool_results\") or []","+  fr=t[\"finish_reason\"]; frt=fr[\"type\"] if isinstance(fr,dict) else fr","+  full=calls(txt)","+  # variants only if full or think","+  is_final_after = False","+  if \"</think>\" in txt:","+      after=txt.split(\"</think>\",1)[1]","+      is_final_after=\"Final SQL\" in after","+  for force in [True,False]:","+      stripped=strip_reason(txt,force)","+      sc=calls(stripped) if stripped else []","+      if full and full!=sc:","+          c[f\"diff_force{force}\"]+=1","+          if res: c[f\"diff_force{force}_res\"]+=1","+          if not sc: c[f\"diff_force{force}_to_none\"]+=1","+          if is_final_after: c[f\"diff_force{force}_finalafter\"]+=1","+          if not sc and is_final_after: c[f\"diff_force{force}_to_none_final\"]+=1","+          if full[0] not in sc: c[f\"first_removed_force{force}\"]+=1","+          if len(examples[f\"diff{force}\"])<3: examples[f\"diff{force}\"].append((ep.get(\"episode\"),ti,txt[:1200],full,sc))","+  # incomplete variants: no complete tool_call block but full calls","+  complete_blocks=re.findall(r\"<tool_call>(.*?)</tool_call>\",txt,re.S)","+  if full and not complete_blocks:","+      c[\"full_no_complete_block\"]+=1","+      if res: c[\"full_no_complete_block_res\"]+=1","+      c[f\"full_no_complete_{frt}\"]+=1","+  if full:","+      # last tool_call open unclosed and fallback? if there is an unclosed segment after last close that contains function","+      last_open=txt.rfind(\"<tool_call>\"); last_close=txt.rfind(\"</tool_call>\")","+      if last_open>last_close:","+          seg=txt[last_open:]","+          if \"<function=\" in seg:","+              c[\"unclosed_seg_with_func_full\"]+=1","+  # condition text ends inside tool_call (EOS tags stripped)","+  core=txt","+  for tok in [\"<|im_end|>\",\"<|endoftext|>\"]:","+      if core.endswith(tok): core=core[:-len(tok)]","+  if core.rfind(\"<tool_call>\")>core.rfind(\"</tool_call>\"):","+      c[\"ends_inside_toolcall\"]+=1","+      if full: c[\"ends_inside_full\"]+=1","+      if res: c[\"ends_inside_res\"]+=1","+      if full and not complete_blocks: c[\"ends_inside_full_nocomplete\"]+=1","+      # executed call (full) that came from unclosed seg: if no complete or ... parse only unclosed seg","+      seg=core[core.rfind(\"<tool_call>\"):]","+      segcalls=calls(seg)","+      if segcalls and segcalls[0] in full:","+          c[\"ends_inside_segcall_in_full\"]+=1","+          if res: c[\"ends_inside_segcall_in_full_res\"]+=1","+print(c)","+for k,v in examples.items():","+    print(\"\\n\",k)","+    for e in v: print(repr(e)[:2000])"],"newLines":73,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/counts.py"}]}