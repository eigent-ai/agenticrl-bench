{"files":[{"hunks":[{"lines":["+import gzip, json, os","+src=open(\"/tmp/make_synth.py\").read().split('os.makedirs(\"/tmp/synth_runs\"')[0]","+exec(src)","+expected={}","+for model,(path,kwj,tmpl) in MODELS.items():","+    fam=FAMILY[model]","+    tok=AutoTokenizer.from_pretrained(path,trust_remote_code=True)","+    if tmpl: tok.chat_template=open(tmpl).read()","+    kw=json.loads(kwj)","+    for env,specs in [(\"sql\",SQL),(\"data\",DATA)]:","+        msgs=[{\"role\":\"system\",\"content\":\"You are a helpful agent.\"},{\"role\":\"user\",\"content\":\"Please do the task.\"}]","+        prompt=tok.apply_chat_template(msgs,tokenize=False,add_generation_prompt=True,tools=specs,**kw)","+        kind=\"sql\" if env==\"sql\" else \"bash\"","+        call1,(n1,a1)=make_call(fam,env,kind)","+        # turn2: draft (different query/command) inside reasoning, then a real call Distinct params","+        if env==\"sql\":","+            draft_call,_=make_call(fam,env,kind)","+            # make distinct by replacing SELECT 1 with SELECT 0 in draft text","+            draft_call=draft_call.replace(\"SELECT 1\",\"SELECT 0\")","+            real_call,(n2,a2)=make_call(fam,env,kind)","+            real_call=real_call.replace(\"SELECT 1\",\"SELECT 2\"); a2=dict(a2,query=\"SELECT 2\")","+        else:","+            draft_call,_=make_call(fam,env,kind); draft_call=draft_call.replace(\"ls -la\",\"ls draft\")","+            real_call,(n2,a2)=make_call(fam,env,kind); real_call=real_call.replace(\"ls -la\",\"pwd\"); a2=dict(a2,command=\"pwd\")","+        if fam==\"qc\": turn2=f\"draft {draft_call} hmm</think>\\n{real_call}<|im_end|>\"","+        elif fam==\"q25think\": turn2=f\"<think>draft {draft_call}</think>\\n{real_call}<|im_end|>\"","+        elif fam==\"glm\": turn2=f\"draft {draft_call}</think>{real_call}<|observation|>\"","+        elif fam==\"gptoss\":","+            turn2=\"<|channel|>analysis<|message|>draft \"+draft_call.replace(\"<|start|>assistant\",\"assistant\")+\"<|end|>\"+real_call","+        elif fam in (\"q25\",\"llama\"):","+            turn2=wrap(fam,real_call,\"real\")","+        eps=[{\"episode\":f\"{model}-{env}-turn2\",\"prompt\":prompt,\"label\":None,","+              \"turns\":[{\"text\":wrap(fam,call1,\"real\"),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[\"ok\"]},","+                       {\"text\":turn2,\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[\"ok\"]},","+                       {\"text\":final_text(fam,env),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[]}]}]","+        run=f\"/tmp/synth2_runs/{model}_{env}\"; os.makedirs(run,exist_ok=True)","+        json.dump({\"model\":model,\"env\":env},open(f\"{run}/run.json\",\"w\"))","+        with gzip.open(f\"{run}/episodes.jsonl.gz\",\"wt\") as f:","+            for e in eps: f.write(json.dumps(e,ensure_ascii=False)+\"\\n\")","+        expected[f\"{model}_{env}\"]=[{\"turn\":0,\"name\":n1,\"params\":a1},{\"turn\":1,\"name\":n2,\"params\":a2}]","+json.dump(expected,open(\"/tmp/synth2_expected.json\",\"w\"),indent=1)","+print(\"done\",len(expected))"],"newLines":42,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/make_synth2.py"}]}