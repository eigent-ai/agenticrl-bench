{"files":[{"hunks":[{"lines":["+import gzip, json, re, sys","+sys.path.insert(0,\"/app/agent_rl\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/opt/sglang/python\")","+from examples.tool_agent.data_tool import tool_specs as data_specs","+from examples.tool_agent.sql_tool import tool_specs as sql_specs","+from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser","+for run, specs, parsername in [(\"glm-4.7-flash_data_trial_2026-10-21\",data_specs,\"glm47\"),(\"glm-4.7-flash_sql_trial_2026-10-21\",sql_specs,\"glm47\")]:","+    eps=[json.loads(l) for l in gzip.open(f\"/app/agent_rl/data/runs/{run}/episodes.jsonl.gz\",\"rt\")]","+    p=create_tool_call_parser(specs, parsername)","+    print(\"\\n==\",run)","+    mut=0; total=0","+    arg_re=re.compile(r\"<arg_key>(.*?)</arg_key>(?:\\n|\\s)*<arg_value>(.*?)</arg_value>\",re.S)","+    tc_re=re.compile(r\"<tool_call>(.*?)(<arg_key>.*)?</tool_call>\",re.S)","+    for ep in eps:","+     for ti,t in enumerate(ep[\"turns\"]):","+        txt=t[\"text\"]","+        # raw after think","+        vis=txt.split(\"</think>\",1)[-1]","+        for m in tc_re.finditer(vis):","+            total+=1","+            raw=dict(arg_re.findall(m.group(2) or \"\"))","+            try:","+                _,calls=p.parse_non_stream(vis)","+            except Exception as e:","+                print(\"parse err\",e); continue","+            # find corresponding by single call assumption","+            if len(calls)!=1: ","+                if len(calls)!=0: print(\"ncalls\",len(calls))","+                continue","+            parsed=json.loads(calls[0].parameters)","+            for k,v in raw.items():","+                pv=parsed.get(k)","+                # comparison expecting strings where schema string","+                if isinstance(v,str) and pv!=v:","+                    mut+=1","+                    print(f\"ep {ep.get('episode')} turn {ti} func {calls[0].name} key {k}\\n raw={v!r}\\n parsed={pv!r} type={type(pv)}\")","+            break","+    print(\"total turns checked first call\",total,\"mut\",mut)"],"newLines":37,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/glm_mut.py"}]}