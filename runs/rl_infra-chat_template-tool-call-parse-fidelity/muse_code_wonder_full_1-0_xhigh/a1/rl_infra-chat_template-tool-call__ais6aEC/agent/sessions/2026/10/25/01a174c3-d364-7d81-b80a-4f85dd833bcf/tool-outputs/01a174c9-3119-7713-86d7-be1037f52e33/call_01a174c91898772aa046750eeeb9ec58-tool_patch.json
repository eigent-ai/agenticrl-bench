{"files":[{"hunks":[{"lines":["+import json","+from transformers import AutoTokenizer","+MODELS={","+ \"qwen3.5-2b\": (\"/models/Qwen3.5-2B\",'{\"enable_thinking\": true}',None),","+ \"qwen3-1.7b\": (\"/models/Qwen3-1.7B\",'{\"enable_thinking\": false}',None),","+ \"glm\": (\"/models/GLM-4.7-Flash\",\"{}\",None),","+ \"qwen3-4b-inst\": (\"/models/Qwen3-4B-Instruct-2507\",\"{}\",None),","+ \"gpt-oss\": (\"/models/gpt-oss-20b\",\"{}\",None),","+ \"llama\": (\"/models/Llama-3.1-8B-Instruct\",\"{}\",\"/models/Llama-3.1-8B-Instruct/tool_chat_template_llama3.1_json.jinja\"),","+}","+args={\"command\":\"echo 'hi'\\nls\",\"timeout\":5,\"flag\":True,\"nothing\":None,\"view_range\":[1,3],\"file_text\":\"[[1, 2]]\\n\",\"query\":\"SELECT 'null'\",\"ratio\":1.5,\"insert_line\":2}","+# use a tool spec fake with those props? rendering assistant doesn't need spec maybe tools None","+msgs=[{\"role\":\"user\",\"content\":\"hi\"},","+ {\"role\":\"assistant\",\"content\":None,\"tool_calls\":[{\"id\":\"c0\",\"type\":\"function\",\"function\":{\"name\":\"str_replace_editor\",\"arguments\":args}}]}]","+# some templates expect arguments as dict, some string; try dict first, then str variant","+for name,(path,kwj,tmpl) in MODELS.items():","+    tok=AutoTokenizer.from_pretrained(path,trust_remote_code=True)","+    if tmpl: tok.chat_template=open(tmpl).read()","+    kw=json.loads(kwj)","+    for variant in [\"dict\",\"str\"]:","+        m=json.loads(json.dumps(msgs))","+        if variant==\"str\": m[1][\"tool_calls\"][0][\"function\"][\"arguments\"]=json.dumps(args)","+        try:","+            s=tok.apply_chat_template(m,tokenize=False,add_generation_prompt=False,**kw)","+            # extract after hi assistant part","+            idx=s.rfind(\"hi\")","+            print(f\"\\n=={name} {variant}:\\n\",repr(s[idx:]))","+        except Exception as e: print(name,variant,\"ERR\",e)"],"newLines":28,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/render_args.py"}]}