{"files":[{"hunks":[{"lines":["+import os, sys, json","+sys.path.insert(0,\"/app/agent_rl\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/opt/sglang/python\")","+os.environ.setdefault(\"PYTHONPATH\",\"/app/agent_rl:/opt/miles:/opt/sglang/python\")","+from transformers import AutoTokenizer","+import importlib.util","+spec=importlib.util.spec_from_file_location(\"launcher\",\"/app/agent_rl/launch/run_tool_agent.py\")","+# launcher imports miles typer etc may be heavy; instead hardcode table copy by parsing file? simpler import via runpy?","+# We'll just manually define from file read earlier","+MODELS={","+ \"qwen3.5-2b\": (\"/models/Qwen3.5-2B\",\"qwen3\",\"qwen3_coder\",'{\"enable_thinking\": true}',None),","+ \"qwen3-1.7b\": (\"/models/Qwen3-1.7B\",\"qwen3\",\"qwen25\",'{\"enable_thinking\": false}',None),","+ \"glm-4.7-flash\": (\"/models/GLM-4.7-Flash\",\"glm45\",\"glm47\",\"{}\",None),","+ \"qwen3.5-4b\": (\"/models/Qwen3.5-4B\",\"qwen3\",\"qwen3_coder\",'{\"enable_thinking\": true}',None),","+ \"qwen3-4b-instruct-2507\": (\"/models/Qwen3-4B-Instruct-2507\",None,\"qwen25\",\"{}\",None),","+ \"gpt-oss-20b\": (\"/models/gpt-oss-20b\",\"gpt-oss\",\"gpt-oss\",\"{}\",None),","+ \"llama-3.1-8b-instruct\": (\"/models/Llama-3.1-8B-Instruct\",None,\"llama3\",\"{}\",\"/models/Llama-3.1-8B-Instruct/tool_chat_template_llama3.1_json.jinja\"),","+}","+tools=[{\"type\":\"function\",\"function\":{\"name\":\"execute_sql\",\"description\":\"x\",\"parameters\":{\"type\":\"object\",\"properties\":{\"database\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"}},\"required\":[\"database\",\"query\"]}}}]","+msgs=[{\"role\":\"user\",\"content\":\"hi\"}]","+# assistant with tool call + tool result to see next gen prompt suffix","+msgs2=[{\"role\":\"user\",\"content\":\"hi\"},","+ {\"role\":\"assistant\",\"content\":\"\",\"reasoning_content\":\" \",\"tool_calls\":[{\"id\":\"call0\",\"type\":\"function\",\"function\":{\"name\":\"execute_sql\",\"arguments\":{\"database\":\"db\",\"query\":\"SELECT 1\"}}}]},","+ {\"role\":\"tool\",\"tool_call_id\":\"call0\",\"name\":\"execute_sql\",\"content\":\"ok\"}]","+# also variant assistant without reasoning_content, with content toolcall text?","+for name,(path,rp,tp,kw_json,tmpl) in MODELS.items():","+    print(\"\\n=====\",name,rp,tp,kw_json)","+    try:","+        tok=AutoTokenizer.from_pretrained(path,trust_remote_code=True)","+        if tmpl: tok.chat_template=open(tmpl).read()","+        kw=json.loads(kw_json)","+        for label,ms in [(\"first\",msgs),(\"after_tool\",msgs2)]:","+            try:","+                s=tok.apply_chat_template(ms,tokenize=False,add_generation_prompt=True,tools=tools,**kw)","+                print(label,\"tail:\",repr(s[-700:]))","+            except Exception as e:","+                print(label,\"ERR\",type(e),e)","+        # also show assistant example rendering (how tool call assistant rendered when add_generation_prompt=False)","+        try:","+            s=tok.apply_chat_template(msgs2,tokenize=False,add_generation_prompt=False,tools=tools,**kw)","+            print(\"full_msgs2:\",repr(s[-1200:]))","+        except Exception as e: print(\"full ERR\",e)","+        print(\"eos\",tok.eos_token, tok.eos_token_id)","+        # template detection","+        try:","+            from sglang.srt.parser.template_detection import detect_reasoning_pattern","+            print(\"detect_reasoning_pattern:\",detect_reasoning_pattern(tok.chat_template))","+        except Exception as e: print(\"detect err\",e)","+    except Exception as e:","+        import traceback; traceback.print_exc()"],"newLines":49,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/templates.py"}]}