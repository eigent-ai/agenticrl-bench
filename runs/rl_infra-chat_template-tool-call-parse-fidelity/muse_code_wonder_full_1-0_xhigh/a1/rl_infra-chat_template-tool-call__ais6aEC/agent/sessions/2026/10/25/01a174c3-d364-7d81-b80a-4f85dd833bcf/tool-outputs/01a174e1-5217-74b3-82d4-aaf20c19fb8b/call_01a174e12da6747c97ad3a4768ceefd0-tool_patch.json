{"files":[{"hunks":[{"lines":["+import gzip, json, sys, collections, re","+sys.path.insert(0,\"/opt/sglang/python\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/app/agent_rl\")","+import logging; logging.disable(logging.CRITICAL)","+from examples.tool_agent.sql_tool import tool_specs as SQL","+from examples.tool_agent.data_tool import tool_specs as DATA","+from examples.tool_agent.tool_call_parsing import parse_tool_calls","+from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser","+","+RUNS=[","+ (\"qwen3.5-2b_sql_2026-10-08\",\"qwen3.5-2b\",\"sql\",SQL,\"qwen3_coder\",\"qwen3\"),","+ (\"qwen3-1.7b_sql_2026-10-11\",\"qwen3-1.7b\",\"sql\",SQL,\"qwen25\",\"qwen3\"),","+ (\"glm-4.7-flash_sql_trial_2026-10-21\",\"glm-4.7-flash\",\"sql\",SQL,\"glm47\",\"glm45\"),","+ (\"glm-4.7-flash_data_trial_2026-10-21\",\"glm-4.7-flash\",\"data\",DATA,\"glm47\",\"glm45\"),","+]","+def base_calls(p,txt):","+    try:","+        _,cs=p.parse_non_stream(txt)","+        out=[]","+        for c in cs:","+            try: out.append((c.name,json.loads(c.parameters) if c.parameters else {}))","+            except: out.append((c.name,c.parameters))","+        return out","+    except Exception as e: return [(\"ERR\",str(e))]","+","+for run,model,env,specs,tp,rp in RUNS:","+    eps=[json.loads(l) for l in gzip.open(f\"/app/agent_rl/data/runs/{run}/episodes.jsonl.gz\",\"rt\")]","+    p=create_tool_call_parser(specs,tp)","+    c=collections.Counter(); examples=collections.defaultdict(list)","+    for ep in eps:","+        # starts reasoning for turn0 from prompt tail; later turns approximate: qwen35 current loop will start in (kwargs true), qwen17 out, glm in","+        first_start = ep[\"prompt\"].rstrip().endswith(\"<think>\") or ep[\"prompt\"].rstrip().endswith(\"<think>\\n\")","+        # prompt strings above: check last marker near end simply","+        tail=ep[\"prompt\"][-40:]","+        first_start = tail.rfind(\"<think>\")>tail.rfind(\"</think>\")","+        later_start={\"qwen3.5-2b\":True,\"qwen3-1.7b\":False,\"glm-4.7-flash\":True}[model]","+        for ti,t in enumerate(ep[\"turns\"]):","+            fr=t[\"finish_reason\"]; frt=fr[\"type\"] if isinstance(fr,dict) else fr","+            if frt in (\"abort\",\"length\"): continue","+            txt=t[\"text\"]","+            b=base_calls(p,txt)","+            n=parse_tool_calls(txt,tool_specs=specs,tool_call_parser=tp,reasoning_parser=rp,starts_in_reasoning=first_start if ti==0 else later_start)","+            # normalize b params dict compare via json","+            norm=lambda xs: [(x[0],json.dumps(x[1],sort_keys=True,ensure_ascii=False)) if isinstance(x[1],dict) else x for x in xs]","+            if norm(b)!=norm(n):","+                c[\"diff\"]+=1","+                if b and not n: c[\"base_only\"]+=1; cat=\"base_only\"","+                elif n and not b: c[\"new_only\"]+=1; cat=\"new_only\"","+                elif set(norm(b)) & set(norm(n)): c[\"partial_overlap\"]+=1; cat=\"partial\"","+                else: c[\"disjoint\"]+=1; cat=\"disjoint\"","+                if any(x not in norm(n) for x in norm(b)): c[\"base_has_extra\"]+=1","+                if any(x not in norm(b) for x in norm(n)): c[\"new_has_extra\"]+=1","+                if len(examples[cat])<4: examples[cat].append((ep.get(\"episode\"),ti,txt[:900],b,n))","+            else: c[\"same\"]+=1","+    print(\"\\n===\",run,c)","+    for cat,exs in examples.items():","+        print(\"--\",cat)","+        for e in exs[:2]: print(repr(e)[:1800])"],"newLines":57,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/compare_static.py"}]}