{"files":[{"hunks":[{"lines":["+import gzip, json, os, collections, re, sys","+root=\"/app/agent_rl/data/runs\"","+for run in sorted(os.listdir(root)):","+    meta=json.load(open(f\"{root}/{run}/run.json\"))","+    eps=[json.loads(l) for l in gzip.open(f\"{root}/{run}/episodes.jsonl.gz\",\"rt\")]","+    print(\"\\n===\",run,meta,\"eps\",len(eps))","+    fin=collections.Counter()","+    stats=collections.Counter()","+    examples={}","+    def ex(k,val):","+        if k not in examples: examples[k]=val","+    for ep in eps:","+        for ti,t in enumerate(ep[\"turns\"]):","+            txt=t[\"text\"]; fr=t[\"finish_reason\"]; frt=fr[\"type\"] if isinstance(fr,dict) else fr","+            fin[frt]+=1","+            has_tc=\"<tool_call>\" in txt","+            n_open=txt.count(\"<tool_call>\"); n_close=txt.count(\"</tool_call>\")","+            res=t.get(\"tool_results\") or []","+            if has_tc: stats[\"has_tool_call_tag\"]+=1","+            if res: stats[\"has_tool_results\"]+=1","+            if n_open>n_close:","+                stats[f\"unclosed_toolcall_finish={frt}\"]+=1","+                if res: stats[f\"unclosed_WITH_results_finish={frt}\"]+=1","+                ex(f\"unclosed_{frt}_{bool(res)}\",(ep.get(\"episode\"),ti,txt[-500:],res[:1]))","+            if \"<think>\" in txt: stats[\"has_think_open\"]+=1","+            if \"</think>\" in txt: stats[\"has_think_close\"]+=1","+            if \"</think>\" in txt:","+                before,after=txt.split(\"</think>\",1)","+                if \"<tool_call>\" in before:","+                    stats[\"toolcall_before_thinkclose\"]+=1","+                    if res: stats[\"toolcall_before_WITH_results\"]+=1","+                    if \"<tool_call>\" in after: stats[\"also_after\"]+=1","+                    if \"Final SQL\" in after: stats[\"before_tc_and_finalSQL_after\"]+=1","+                    ex(\"draft\",(ep.get(\"episode\"),ti,txt[:2000],res[:1]))","+            if txt.startswith(\"<think>\"): stats[\"starts_think\"]+=1","+            # first turn text sample shape","+            # GLM / harmony markers","+            for tok in [\"<|channel|>\",\"<arg_key>\",\"<function=\",\"<parameter=\",\"<|python_tag|>\"]:","+                if tok in txt: stats[f\"tok{tok}\"]+=1","+    print(\"finish\",fin)","+    print(stats)","+    for k,v in list(examples.items())[:6]:","+        print(\"\\n-- ex\",k)","+        print(repr(v)[:2500])","+    # print one first turn text","+    print(\"\\n-- first turn sample:\")","+    print(repr(eps[0][\"turns\"][0][\"text\"][:1500]))","+    print(\"prompt type\",type(eps[0][\"prompt\"]), repr(eps[0][\"prompt\"])[:800])"],"newLines":48,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze.py"}]}