{"files":[{"hunks":[{"lines":[" "," "," _TOOL_BLOCK_RE = re.compile(r\"<tool_call>(.*?)</tool_call>\", re.DOTALL)","-_QC_FUNCTION_RE = re.compile(r\"<function=([^>]+)>\")","-_QC_PARAM_RE = re.compile(r\"<parameter=([^>]+)>\")","-_GLM_KEY_RE = re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>\", re.DOTALL)","+_QC_FUNCTION_RE = re.compile(r\"<function=(.*?)</function>|<function=(.*)$\", re.DOTALL)","+_QC_PARAM_RE = re.compile(r\"<parameter=(.*?)(?:</parameter>|(?=<parameter=)|(?=</function>)|$)\", re.DOTALL)","+_GLM_PAIR_RE = re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>(.*?)</arg_value>\", re.DOTALL)"," "," "," def _parse_qwen3_coder(text: str, properties: dict[str, dict]) -> list[tuple[str, dict]]:","-    # A block counts only once its </tool_call> was written.  Inside such a","-    # block, a missing inner close is taken to end at the enclosing close.","+    # A block counts only once its </tool_call> was written; the grouping of","+    # functions/parameters inside a finished block follows SGLang's detector.","     calls = []","     for block in _TOOL_BLOCK_RE.findall(text):","-        funcs = list(_QC_FUNCTION_RE.finditer(block))","-        for fi, fm in enumerate(funcs):","-            name = fm.group(1).strip()","+        for func_a, func_b in _QC_FUNCTION_RE.findall(block):","+            func_body = func_a or func_b","+            if \">\" not in func_body:","+                continue","+            name = func_body[:func_body.index(\">\")].strip()","             if not name:","                 continue","-            seg_end = funcs[fi + 1].start() if fi + 1 < len(funcs) else len(block)","-            body = block[fm.end():seg_end]","-            close = body.rfind(\"</function>\")","-            if close != -1:","-                body = body[:close]","             raw_params: list[tuple[str, str]] = []","-            matches = list(_QC_PARAM_RE.finditer(body))","-            for j, m in enumerate(matches):","-                p_end = matches[j + 1].start() if j + 1 < len(matches) else len(body)","-                value = body[m.end():p_end]","-                p_close = value.rfind(\"</parameter>\")","-                if p_close != -1:","-                    value = value[:p_close]","+            for p_match in _QC_PARAM_RE.findall(func_body[func_body.index(\">\") + 1:]):","+                if \">\" not in p_match:","+                    continue","+                p_name, value = p_match[:p_match.index(\">\")].strip(), p_match[p_match.index(\">\") + 1:]","                 if value.startswith(\"\\n\"):","                     value = value[1:]","                 if value.endswith(\"\\n\"):","                     value = value[:-1]","-                raw_params.append((m.group(1).strip(), value))","+                raw_params.append((p_name, value))","             # As in SGLang's detector, an unknown function is still a call","             # (the tool executor reports it as not found).","             calls.append((name, _convert_params(raw_params, name, properties)))"],"newLines":33,"newStart":212,"oldLines":39,"oldStart":212},{"lines":["         name = block.split(\"<arg_key>\", 1)[0].strip()","         if not name or name not in properties:","             continue","-        raw_params: list[tuple[str, str]] = []","-        keys = list(_GLM_KEY_RE.finditer(block))","-        for j, m in enumerate(keys):","-            seg_end = keys[j + 1].start() if j + 1 < len(keys) else len(block)","-            value = block[m.end():seg_end]","-            close = value.rfind(\"</arg_value>\")","-            if close != -1:","-                value = value[:close]","-            raw_params.append((m.group(1).strip(), value))","+        raw_params = [(k.strip(), v) for k, v in _GLM_PAIR_RE.findall(block)]","         calls.append((name, _convert_params(raw_params, name, properties)))","     return calls"," "],"newLines":7,"newStart":251,"oldLines":15,"oldStart":257}],"path":"/app/agent_rl/examples/tool_agent/tool_call_par