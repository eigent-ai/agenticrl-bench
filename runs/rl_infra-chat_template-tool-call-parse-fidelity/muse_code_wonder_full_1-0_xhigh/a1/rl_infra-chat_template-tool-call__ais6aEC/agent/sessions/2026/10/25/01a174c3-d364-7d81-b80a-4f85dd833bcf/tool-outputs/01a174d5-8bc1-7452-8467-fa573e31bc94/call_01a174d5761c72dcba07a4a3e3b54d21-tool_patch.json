{"files":[{"hunks":[{"lines":["                     calls.append((name, args))","         pos = term_at + len(term)","     return calls","+","+","+def _parse_with_sglang(text: str, tool_specs, tool_call_parser: str) -> list[tuple[str, dict]]:","+    \"\"\"Fallback for parsers without a dedicated implementation above.\"\"\"","+    try:","+        from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser","+","+        _, items = create_tool_call_parser(tool_specs, tool_call_parser).parse_non_stream(text)","+    except Exception:","+        return []","+    calls = []","+    for item in items or []:","+        try:","+            params = json.loads(item.parameters) if item.parameters else {}","+        except (json.JSONDecodeError, ValueError):","+            continue","+        if item.name and isinstance(params, dict):","+            calls.append((item.name, params))","+    return calls","+","+","+def parse_tool_calls(text: str, *, tool_specs, tool_call_parser: str | None,","+                     reasoning_parser: str | None = None,","+                     starts_in_reasoning: bool = False) -> list[tuple[str, dict]]:","+    \"\"\"The finished calls ``text`` makes outside its reasoning, in order.\"\"\"","+    properties = _tool_properties(tool_specs)","+    if not text or not properties:","+        return []","+    tp = (tool_call_parser or \"\").strip().lower()","+    rp = (reasoning_parser or \"\").strip().lower() or None","+    if tp == \"gpt-oss\" or rp == \"gpt-oss\":","+        return _parse_gpt_oss(text, properties)","+    if rp is not None:","+        text = visible_text(text, starts_in_reasoning=starts_in_reasoning)","+    if tp in (\"qwen3_coder\", \"step3p5\"):","+        return _parse_qwen3_coder(text, properties)","+    if tp in (\"glm47\", \"glm45\", \"glm\"):","+        return _parse_glm(text, properties)","+    if tp in (\"qwen25\", \"qwen\", \"hermes\"):","+        return _parse_json_blocks(text, properties)","+    if tp == \"