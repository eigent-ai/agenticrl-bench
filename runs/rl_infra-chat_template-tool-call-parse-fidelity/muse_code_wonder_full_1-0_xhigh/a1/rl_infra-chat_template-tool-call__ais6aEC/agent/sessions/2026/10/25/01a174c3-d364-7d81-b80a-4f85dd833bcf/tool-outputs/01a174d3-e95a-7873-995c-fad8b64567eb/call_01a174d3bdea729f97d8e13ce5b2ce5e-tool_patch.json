{"files":[{"hunks":[{"lines":["+\"\"\"Reasoning-aware, complete-only tool-call parsing for the rollout loop.","+","+The loop receives raw engine text (reasoning included), while the deploy","+endpoint separates reasoning before it looks for tool calls.  This module","+does the corresponding separation and then parses only calls that are","+complete in the model's own format.  For the XML formats, where a raw value","+carries no type of its own, the argument type comes from the tool schema;","+string arguments are kept byte-for-byte (apart from the Qwen3-Coder","+``<parameter>`` framing newline).  For JSON formats the JSON values are kept.","+\"\"\"","+import ast","+import json","+import re","+from typing import Any, Iterable","+","+THINK_START = \"<think>\"","+THINK_END = \"</think>\"","+TOOL_START = \"<tool_call>\"","+TOOL_END = \"</tool_call>\"","+","+_TYPE_ALIASES = {","+    \"str\": \"string\", \"text\": \"string\", \"varchar\": \"string\", \"char\": \"string\",","+    \"enum\": \"string\", \"bool\": \"boolean\", \"binary\": \"boolean\",","+    \"int\": \"integer\", \"bigint\": \"integer\", \"smallint\": \"integer\",","+    \"float\": \"number\", \"double\": \"number\", \"decimal\": \"number\", \"numeric\": \"number\",","+    \"arr\": \"array\", \"list\": \"array\", \"dict\": \"object\", \"map\": \"object\",","+}","+","+","+def _norm_type(raw: Any) -> str | None:","+    if not isinstance(raw, str):","+        return None","+    t = raw.split(\"(\", 1)[0].strip().lower()","+    if t in _TYPE_ALIASES:","+        return _TYPE_ALIASES[t]","+    for prefix, target in ((\"int\", \"integer\"), (\"uint\", \"integer\"), (\"long\", \"integer\"),","+                           (\"short\", \"integer\"), (\"unsigned\", \"integer\"),","+                           (\"num\", \"number\"), (\"float\", \"number\")):","+        if t == prefix or (t.startswith(prefix) and len(t) > len(prefix)","+                           and t[len(prefix)] in \"0123456789[<( \\t\"):","+            return target","+    return t or None","+","+","+def _candidate_types(schema: Any) -> list[str]:","+    \"\"\"Ordered, de-duplicated JSON-Schema types a raw XML value may take.\"\"\"","+    out: list[str] = []","+","+    def add(t):","+        t = _norm_type(t)","+        if t and t not in out:","+            out.append(t)","+","+    def walk(s):","+        if not isinstance(s, dict):","+            return","+        if \"type\" in s:","+            tv = s[\"type\"]","+            for x in tv if isinstance(tv, list) else [tv]:","+                add(x)","+            return","+        for key in (\"anyOf\", \"oneOf\", \"allOf\"):","+            if isinstance(s.get(key), list):","+                for sub in s[key]:","+                    walk(sub)","+                return","+        if isinstance(s.get(\"enum\"), list) and s[\"enum\"]:","+            for v in s[\"enum\"]:","+                add({type(None): \"null\", bool: \"boolean\", int: \"integer\",","+                     float: \"number\", str: \"string\", list: \"array\", dict: \"object\"}.get(type(v)))","+            return","+        if \"properties\" in s:","+            add(\"object\")","+        elif \"items\" in s:","+            add(\"array\")","+","+    walk(schema)","+    return out","+","+","+def convert_xml_value(raw: str, schema: dict | None) -> Any:","+    \"\"\"Convert a raw XML argument value using only its schema type(s).\"\"\"","+    types = _candidate_types(schema)","+    if not types:","+        return raw","+    stripped = raw.strip()","+    if \"null\" in types and stripped in (\"null\", \"None\", \"~\"):","+        return None","+    if types == [\"null\"]:","+        return None","+    if \"string\" in types:","+        # A string (alone or as one arm of a union) is the raw text itself.","+        return raw","+    primary = next((t for t in types if t != \"null\"), \"string\")","+    if primary == \"string\":","+        return raw","+    if primary == \"integer\":","+        try:","+            return int(stripped)","+        except ValueError:","+            try:","+                f = float(stripped)","+            except ValueError:","+                return raw","+            return int(f) if f.is_integer() else raw","+    if primary == \"number\":","+        try:","+            return int(stripped) if re.fullmatch(r\"[+-]?\\d+\", stripped) else float(stripped)","+        except ValueError:","+            return raw","+    if primary == \"boolean\":","+        low = stripped.lower()","+        return True if low == \"true\" else False if low == \"false\" else raw","+    if primary in (\"array\", \"object\"):","+        want = list if primary == \"array\" else dict","+        for loader in (json.loads, ast.literal_eval):","+            try:","+                value = loader(stripped)","+            except Exception:","+                continue","+            return value if isinstance(value, want) else raw","+        return raw","+    return raw"],"newLines":123,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/agent_rl/examples/tool_agent/tool_call_parsing.py"}]}