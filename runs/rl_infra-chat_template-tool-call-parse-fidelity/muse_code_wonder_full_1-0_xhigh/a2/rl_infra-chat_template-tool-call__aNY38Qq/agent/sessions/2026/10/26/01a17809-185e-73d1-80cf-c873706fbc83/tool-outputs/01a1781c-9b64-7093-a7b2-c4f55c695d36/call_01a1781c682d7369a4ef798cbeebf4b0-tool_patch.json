{"files":[{"hunks":[{"lines":["+\"\"\"Focused regression tests for the rollout loop's tool-call extraction.","+","+Run with:","+    PYTHONPATH=/app/agent_rl:/opt/miles:/opt/sglang/python python -m unittest tests.test_tool_call_parsing","+\"\"\"","+","+import json","+import unittest","+","+from examples.tool_agent.agent_loop import extract_tool_calls","+from examples.tool_agent.data_tool import tool_specs as data_specs","+from examples.tool_agent.sql_tool import tool_specs as sql_specs","+","+","+def calls(text, specs, tool_parser, reasoning_parser=None, starts_in_reasoning=False):","+    out = extract_tool_calls(","+        text,","+        specs,","+        tool_parser,","+        reasoning_parser_name=reasoning_parser,","+        starts_in_reasoning=starts_in_reasoning,","+    )","+    return [(c.name, json.loads(c.parameters)) for c in out]","+","+","+class ToolCallParsingTest(unittest.TestCase):","+    def test_qwen_coder_draft_in_reasoning_and_final_answer(self):","+        text = (","+            \"Maybe run this:\\n<tool_call>\\n<function=execute_sql>\\n\"","+            \"<parameter=database>\\ndb\\n</parameter>\\n<parameter=query>\\nSELECT 1\\n</parameter>\\n</function>\\n</tool_call>\\n\"","+            \"No, reconsider.</think>\\n\\nFinal SQL:\\n```sql\\nSELECT 2\\n```\"","+        )","+        self.assertEqual(calls(text, sql_specs, \"qwen3_coder\", \"qwen3\", True), [])","+","+    def test_qwen_coder_unfinished_and_exact_string_and_anyof_number(self):","+        unfinished = (","+            \"</think>\\n<tool_call>\\n<function=execute_bash>\\n\"","+            \"<parameter=command>\\nls -\"","+        )","+        self.assertEqual(calls(unfinished, data_specs, \"qwen3_coder\", \"qwen3\", True), [])","+","+        text = (","+            \"</think>\\n<tool_call>\\n<function=execute_bash>\\n\"","+            \"<parameter=command>\\nnull\\n</parameter>\\n<parameter=timeout>\\n5\\n</parameter>\\n</function>\\n</tool_call>\"","+        )","+        self.assertEqual(","+            calls(text, data_specs, \"qwen3_coder\", \"qwen3\", True),","+            [(\"execute_bash\", {\"command\": \"null\", \"timeout\": 5})],","+        )","+","+    def test_glm_string_argument_is_not_reformatted(self):","+        file_text = '[\\n  [\"a\", 1]\\n]\\n'","+        text = (","+            \"reasoning</think><tool_call>str_replace_editor\"","+            \"<arg_key>command</arg_key><arg_value>create</arg_value>\"","+            \"<arg_key>path</arg_key><arg_value>/work/ws/x/answer.json</arg_value>\"","+            f\"<arg_key>file_text</arg_key><arg_value>{file_text}</arg_value></tool_call>\"","+        )","+        self.assertEqual(","+            calls(text, data_specs, \"glm47\", \"glm45\", True),","+            [(\"str_replace_editor\", {\"command\": \"create\", \"path\": \"/work/ws/x/answer.json\", \"file_text\": file_text})],","+        )","+","+    def test_hermes_without_newlines_but_not_draft_or_truncated(self):","+        text = '<think>draft <tool_call>{\"name\":\"execute_sql\",\"arguments\":{\"database\":\"db\",\"query\":\"bad\"}}</tool_call></think><tool_call>{\"name\":\"execute_sql\",\"arguments\":{\"database\":\"db\",\"query\":\"good\"}}</tool_call>'","+        self.assertEqual(","+            calls(text, sql_specs, \"qwen25\", \"qwen3\"),","+            [(\"execute_sql\", {\"database\": \"db\", \"query\": \"good\"})],","+        )","+        truncated = '<tool_call>{\"name\":\"execute_sql\",\"arguments\":{\"database\":\"db\",\"query\":\"good\"'","+        self.assertEqual(calls(truncated, sql_specs, \"qwen25\"), [])","+","+    def test_llama_leading_whitespace_and_truncated_json(self):","+        text = '\\n{\"name\": \"execute_sql\", \"parameters\": {\"database\": \"db\", \"query\": \"SELECT 1\"}}'","+        self.assertEqual(","+            calls(text, sql_specs, \"llama3\"),","+            [(\"execute_sql\", {\"database\": \"db\", \"query\": \"SELECT 1\"})],","+        )","+        self.assertEqual(calls('{\"name\": \"execute_sql\", \"parameters\": {\"database\": \"db\"', sql_specs, \"llama3\"), [])","+","+    def test_gpt_oss_template_format_and_truncated(self):","+        text = (","+            \"<|channel|>analysis<|message|>think first<|end|>\"","+            \"<|start|>assistant to=functions.execute_sql<|channel|>commentary json<|message|>\"","+            '{\"database\": \"db\", \"query\": \"SELECT 1\"}<|call|>'","+        )","+        self.assertEqual(","+            calls(text, sql_specs, \"gpt-oss\", \"gpt-oss\"),","+            [(\"execute_sql\", {\"database\": \"db\", \"query\": \"SELECT 1\"})],","+        )","+        self.assertEqual(calls(text.replace(\"<|call|>\", \"\"), sql_specs, \"gpt-oss\", \"gpt-oss\"), [])","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"newLines":95,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/agent_rl/tests/test_tool_call_parsing.py"}]}