{"files":[{"hunks":[{"lines":["+import gzip, json, os","+src=open(\"/tmp/make_synth.py\").read().split('os.makedirs(\"/tmp/synth_runs\"')[0]","+exec(src)","+for model,(path,kwj,tmpl) in MODELS.items():","+    fam=FAMILY[model]","+    tok=AutoTokenizer.from_pretrained(path,trust_remote_code=True)","+    if tmpl: tok.chat_template=open(tmpl).read()","+    kw=json.loads(kwj); env=\"sql\"; specs=SQL","+    prompt=tok.apply_chat_template([{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"task\"}],tokenize=False,add_generation_prompt=True,tools=specs,**kw)","+    c1,(n,a)=make_call(fam,env,\"sql\"); c2=c1.replace(\"SELECT 1\",\"SELECT 2\")","+    if fam==\"llama\": text=c1+\"; \"+c2+\"<|eot_id|>\"","+    elif fam==\"gptoss\": text=wrap(fam,c1,\"real\")+c2","+    elif fam==\"qc\": text=\"r</think>\\n\"+c1+\"\\n\"+c2+\"<|im_end|>\"","+    elif fam==\"q25think\": text=\"<think>r</think>\\n\"+c1+\"\\n\"+c2+\"<|im_end|>\"","+    elif fam==\"q25\": text=c1+\"\\n\"+c2+\"<|im_end|>\"","+    elif fam==\"glm\": text=\"r</think>\"+c1+c2+\"<|observation|>\"","+    eps=[{\"episode\":f\"{model}-multi\",\"prompt\":prompt,\"label\":None,\"turns\":[{\"text\":text,\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[\"ok1\",\"ok2\"]},{\"text\":final_text(fam,env),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[]}]}]","+    run=f\"/tmp/synth_multi_runs/{model}_{env}\"; os.makedirs(run,exist_ok=True)","+    json.dump({\"model\":model,\"env\":env},open(f\"{run}/run.json\",\"w\"))","+    with gzip.open(f\"{run}/episodes.jsonl.gz\",\"wt\") as f: f.write(json.dumps(eps[0])+\"\\n\")","+print(\"done\")"],"newLines":21,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/make_synth_multi.py"}]}