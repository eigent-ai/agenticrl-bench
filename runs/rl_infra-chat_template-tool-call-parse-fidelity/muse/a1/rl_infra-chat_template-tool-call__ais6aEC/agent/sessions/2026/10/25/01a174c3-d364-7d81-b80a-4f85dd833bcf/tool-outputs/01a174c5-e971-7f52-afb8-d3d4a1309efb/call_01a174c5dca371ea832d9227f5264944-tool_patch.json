{"files":[{"hunks":[{"lines":["+import gzip, json, os, collections","+root=\"/app/agent_rl/data/runs\"","+for run in sorted(os.listdir(root)):","+    eps=[json.loads(l) for l in gzip.open(f\"{root}/{run}/episodes.jsonl.gz\",\"rt\")]","+    print(\"\\n===\",run)","+    print(\"prompt tail:\",repr(eps[0][\"prompt\"][-600:]))","+    # check varying prompt tails","+    tails=collections.Counter(repr(e[\"prompt\"][-80:]) if isinstance(e[\"prompt\"],str) else str(type(e[\"prompt\"])) for e in eps)","+    for k,v in tails.most_common(5): print(v,k)","+    # turn endings","+    ends=collections.Counter()","+    for ep in eps:","+        for t in ep[\"turns\"]:","+            txt=t[\"text\"]","+            for tok in [\"<|im_end|>\",\"<|endoftext|>\",\"<|observation|>\",\"<|end|>\",\"<|call|>\",\"</s>\"]:","+                if txt.rstrip().endswith(tok): ends[tok]+=1","+            else:","+                pass","+    print(\"turn endings tokens (endswith):\",ends)","+    # sample turns containing think close","+    for ep in eps[:50]:","+        for t in ep[\"turns\"]:","+            if \"</think>\" in t[\"text\"]:","+                print(\"think sample\",repr(t[\"text\"][:800])); break","+        else: continue","+        break"],"newLines":26,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze2.py"}]}