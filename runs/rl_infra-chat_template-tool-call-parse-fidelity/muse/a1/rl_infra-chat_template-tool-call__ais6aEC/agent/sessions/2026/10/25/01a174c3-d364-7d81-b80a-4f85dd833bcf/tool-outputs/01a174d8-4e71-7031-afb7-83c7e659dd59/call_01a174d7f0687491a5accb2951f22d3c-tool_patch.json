{"files":[{"hunks":[{"lines":["+import gzip, json, os, sys","+sys.path.insert(0,\"/opt/sglang/python\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/app/agent_rl\")","+from transformers import AutoTokenizer","+from examples.tool_agent.sql_tool import tool_specs as SQL","+from examples.tool_agent.data_tool import tool_specs as DATA","+MODELS={","+ \"qwen3.5-2b\": (\"/models/Qwen3.5-2B\",'{\"enable_thinking\": true}',None),","+ \"qwen3.5-4b\": (\"/models/Qwen3.5-4B\",'{\"enable_thinking\": true}',None),","+ \"qwen3-1.7b\": (\"/models/Qwen3-1.7B\",'{\"enable_thinking\": false}',None),","+ \"qwen3-4b-instruct-2507\": (\"/models/Qwen3-4B-Instruct-2507\",\"{}\",None),","+ \"glm-4.7-flash\": (\"/models/GLM-4.7-Flash\",\"{}\",None),","+ \"gpt-oss-20b\": (\"/models/gpt-oss-20b\",\"{}\",None),","+ \"llama-3.1-8b-instruct\": (\"/models/Llama-3.1-8B-Instruct\",\"{}\",\"/models/Llama-3.1-8B-Instruct/tool_chat_template_llama3.1_json.jinja\"),","+}","+FAMILY={\"qwen3.5-2b\":\"qc\",\"qwen3.5-4b\":\"qc\",\"qwen3-1.7b\":\"q25think\",\"qwen3-4b-instruct-2507\":\"q25\",\"glm-4.7-flash\":\"glm\",\"gpt-oss-20b\":\"gptoss\",\"llama-3.1-8b-instruct\":\"llama\"}","+","+def qc(name,params):","+    ps=\"\".join(f\"<parameter={k}>\\n{v}\\n</parameter>\\n\" for k,v in params)","+    return f\"<tool_call>\\n<function={name}>\\n{ps}</function>\\n</tool_call>\"","+def q25(name,args):","+    return \"<tool_call>\\n\"+json.dumps({\"name\":name,\"arguments\":args})+\"\\n</tool_call>\"","+def glm(name,params):","+    ps=\"\".join(f\"<arg_key>{k}</arg_key><arg_value>{v}</arg_value>\" for k,v in params)","+    return f\"<tool_call>{name}{ps}</tool_call>\"","+def gpt(name,args):","+    return f\"<|start|>assistant to=functions.{name}<|channel|>commentary json<|message|>\"+json.dumps(args)+\"<|call|>\"","+def llama(name,args):","+    return json.dumps({\"name\":name,\"parameters\":args})","+","+def make_call(fam,env,kind):","+    # returns (text_without_reasoning_or_eos, expected_params or None)","+    if env==\"sql\":","+        name=\"execute_sql\"; args={\"database\":\"db1\",\"query\":\"SELECT 1\"}; raw=[(\"database\",\"db1\"),(\"query\",\"SELECT 1\")]","+    else:","+        if kind==\"bash\":","+            name=\"execute_bash\"; args={\"command\":\"ls -la\",\"timeout\":2.5}; raw=[(\"command\",\"ls -la\"),(\"timeout\",\"2.5\")]","+        elif kind==\"editor\":","+            name=\"str_replace_editor\"; args={\"command\":\"create\",\"path\":\"/work/ws/x/answer.json\",\"file_text\":'[[\\n  \"a\",\\n  1\\n]]\\n'}","+            raw=[(\"command\",\"create\"),(\"path\",\"/work/ws/x/answer.json\"),(\"file_text\",'[[\\n  \"a\",\\n  1\\n]]\\n')]","+            # for qc, raw file_text trailing NL: template framing adds one NL; our qc builder puts {v}\\n => value ends \\n + framing \\n good.","+        elif kind==\"view\":","+            name=\"str_replace_editor\"; args={\"command\":\"view\",\"path\":\"/work/ws/x/a.txt\",\"view_range\":[1,3]}","+            raw=[(\"command\",\"view\"),(\"path\",\"/work/ws/x/a.txt\"),(\"view_range\",\"[1, 3]\")]","+        else:","+            name=\"execute_bash\"; args={\"command\":\"true\",\"timeout\":None}; raw=[(\"command\",\"true\"),(\"timeout\",\"null\")]","+    if fam in (\"qc\",): return qc(name,raw),(name,args)","+    if fam in (\"q25think\",\"q25\"): return q25(name,args),(name,args)","+    if fam==\"glm\": return glm(name,raw),(name,args)","+    if fam==\"gptoss\": return gpt(name,args),(name,args)","+    if fam==\"llama\": return llama(name,args),(name,args)","+    raise ValueError(fam)","+","+def wrap(fam,call_text,scene):","+    \"\"\"Wrap a real call in reasoning/outside text; return full assistant text incl eos.\"\"\"","+    if fam==\"qc\":","+        if scene==\"real\": return f\"I should inspect first.</think>\\n{call_text}<|im_end|>\"","+        if scene==\"implicit\": return f\"I should inspect first. {call_text}<|im_end|>\"","+    if fam==\"q25think\":","+        if scene==\"real\": return f\"<think>\\nI should inspect.\\n</think>\\n\\n{call_text}<|im_end|>\"","+        if scene==\"implicit\": return f\"<think>\\nI should inspect. {call_text}<|im_end|>\"","+    if fam==\"q25\":","+        return f\"I will inspect.\\n{call_text}<|im_end|>\"","+    if fam==\"glm\":","+        if scene==\"real\": return f\"I should inspect.</think>Working on it.{call_text}<|observation|>\"","+        if scene==\"implicit\": return f\"I should inspect. {call_text}<|observation|>\"","+    if fam==\"gptoss\":","+        if scene==\"real\": return f\"<|channel|>analysis<|message|>I should inspect.<|end|>{call_text}\"","+        if scene==\"implicit\":  # direct first segment, no <|start|> (prompt supplied it)","+            direct=call_text.replace(\"<|start|>assistant\",\"\",1)","+            return direct","+    if fam==\"llama\":","+        return f\"{call_text}<|eot_id|>\"","+    raise ValueError(scene)","+","+def final_text(fam,env):","+    ans=\"Final SQL:\\n\\n```sql\\nSELECT 1\\n```\" if env==\"sql\" else \"Done, files written.\"","+    if fam==\"qc\": return f\"The result is ready.</think>\\n\\n{ans}<|im_end|>\"","+    if fam==\"q25think\": return f\"<think>\\nDone.\\n</think>\\n\\n{ans}<|im_end|>\"","+    if fam==\"q25\": return f\"{ans}<|im_end|>\"","+    if fam==\"glm\": return f\"Done thinking.</think>{ans}<|endoftext|>\"","+    if fam==\"gptoss\": return f\"<|channel|>analysis<|message|>Done.<|end|><|start|>assistant<|channel|>final<|message|>{ans}<|return|>\"","+    if fam==\"llama\": return f\"{ans}<|eot_id|>\"","+    raise ValueError(fam)","+","+def draft_then_final(fam,env):","+    call,_=make_call(fam,env,\"sql\" if env==\"sql\" else \"bash\")","+    # draft version with different params would be clearer but reuse; expected no execution","+    ans=\"Final SQL:\\n\\n```sql\\nSELECT 9\\n```\" if env==\"sql\" else \"Done without tools.\"","+    if fam==\"qc\": return f\"Draft only: {call} maybe.</think>\\n{ans}<|im_end|>\"","+    if fam==\"q25think\": return f\"<think>Draft: {call}</think>\\n{ans}<|im_end|>\"","+    if fam==\"q25\": return None  # no reasoning notion","+    if fam==\"glm\": return f\"Draft: {call}</think>{ans}<|endoftext|>\"","+    if fam==\"gptoss\":","+        return (\"<|channel|>analysis<|message|>Draft call: \"+call.replace(\"<|start|>assistant\",\"assistant\")+","+                f\"<|end|><|start|>assistant<|channel|>final<|message|>{ans}<|return|>\")","+    if fam==\"llama\": return None","+    return None","+","+def incomplete(fam,env):","+    call,_=make_call(fam,env,\"sql\" if env==\"sql\" else \"bash\")","+    cut=call[:len(call)//2]","+    if fam==\"qc\": return f\"Thinking.</think>\\n{cut}<|im_end|>\"","+    if fam==\"q25think\": return f\"<think>ok</think>\\n{cut}<|im_end|>\"","+    if fam==\"q25\": return f\"{cut}<|im_end|>\"","+    if fam==\"glm\": return f\"ok</think>{cut}\"","+    if fam==\"gptoss\": return f\"<|channel|>analysis<|message|>ok<|end|>\"+cut.replace(\"<|call|>\",\"\")","+    if fam==\"llama\": return cut","+    return cut","+","+os.makedirs(\"/tmp/synth_runs\",exist_ok=True)","+expected={}","+for model,(path,kwj,tmpl) in MODELS.items():","+    fam=FAMILY[model]","+    tok=AutoTokenizer.from_pretrained(path,trust_remote_code=True)","+    if tmpl: tok.chat_template=open(tmpl).read()","+    kw=json.loads(kwj)","+    for env,specs in [(\"sql\",SQL),(\"data\",DATA)]:","+        msgs=[{\"role\":\"system\",\"content\":\"You are a helpful agent.\"},{\"role\":\"user\",\"content\":\"Please do the task.\"}]","+        try:","+            prompt=tok.apply_chat_template(msgs,tokenize=False,add_generation_prompt=True,tools=specs,**kw)","+        except Exception as e:","+            print(\"PROMPT ERR\",model,env,e); prompt=\"user task\"","+        eps=[]; exp=[]","+        kinds=[\"sql\"] if env==\"sql\" else [\"bash\",\"editor\",\"view\",\"nullcmd\"]","+        # real episodes per kind","+        for kind in kinds:","+            call,(name,args)=make_call(fam,env,kind)","+            eps.append({\"episode\":f\"{model}-{env}-real-{kind}\",\"prompt\":prompt,\"label\":None,","+                        \"turns\":[{\"text\":wrap(fam,call,\"real\"),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[\"ok\"]},","+                                 {\"text\":final_text(fam,env),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[]}]})","+            exp.append([{\"turn\":0,\"name\":name,\"params\":args}])","+        # implicit / direct","+        call,(name,args)=make_call(fam,env,kinds[0])","+        eps.append({\"episode\":f\"{model}-{env}-implicit\",\"prompt\":prompt,\"label\":None,","+                    \"turns\":[{\"text\":wrap(fam,call,\"implicit\"),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[\"ok\"]},","+                             {\"text\":final_text(fam,env),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[]}]})","+        exp.append([{\"turn\":0,\"name\":name,\"params\":args}])","+        # draft","+        d=draft_then_final(fam,env)","+        if d:","+            eps.append({\"episode\":f\"{model}-{env}-draft\",\"prompt\":prompt,\"label\":None,","+                        \"turns\":[{\"text\":d,\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[]}]})","+            exp.append([])","+        # incomplete","+        eps.append({\"episode\":f\"{model}-{env}-incomplete\",\"prompt\":prompt,\"label\":None,","+                    \"turns\":[{\"text\":incomplete(fam,env),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[]}]})","+        exp.append([])","+        # plain final (no call)","+        eps.append({\"episode\":f\"{model}-{env}-final\",\"prompt\":prompt,\"label\":None,","+                    \"turns\":[{\"text\":final_text(fam,env),\"finish_reason\":{\"type\":\"stop\"},\"tool_results\":[]}]})","+        exp.append([])","+        run=f\"/tmp/synth_runs/{model}_{env}\"","+        os.makedirs(run,exist_ok=True)","+        json.dump({\"model\":model,\"env\":env},open(f\"{run}/run.json\",\"w\"))","+        with gzip.open(f\"{run}/episodes.jsonl.gz\",\"wt\") as f:","+            for e in eps: f.write(json.dumps(e,ensure_ascii=False)+\"\\n\")","+        expected[f\"{model}_{env}\"]={\"episodes\":[e[\"episode\"] for e in eps],\"executed\":exp,\"prompt_tail\":prompt[-120:]}","+        print(model,env,\"prompt tail\",repr(prompt[-100:]))","+json.dump(expected,open(\"/tmp/synth_expected.json\",\"w\"),indent=1,ensure_ascii=False)","+print(\"runs\",len(expected))"],"newLines":160,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/make_synth.py"}]}