{"files":[{"hunks":[{"lines":["+import gzip,json,re,collections","+eps=[json.loads(l) for l in gzip.open(\"/app/agent_rl/data/runs/qwen3.5-2b_sql_2026-10-08/episodes.jsonl.gz\",\"rt\")]","+c=collections.Counter(); examples=collections.defaultdict(list)","+for ep in eps:","+ for ti,t in enumerate(ep[\"turns\"]):","+  txt=t[\"text\"]; res=t.get(\"tool_results\") or []","+  if \"</think>\" not in txt: continue","+  b,a=txt.split(\"</think>\",1)","+  if \"<tool_call>\" not in b: continue","+  # categorize before segment","+  b_complete = \"</tool_call>\" in b","+  b_func_close = \"</function>\" in b","+  b_params=re.findall(r\"<parameter=([^>]+)>\",b)","+  a_has_tool=\"<tool_call>\" in a","+  a_complete=\"</tool_call>\" in a","+  a_params=re.findall(r\"<parameter=([^>]+)>\",a)","+  final=\"Final SQL\" in a","+  cat=f\"bcomplete={b_complete} bfunclose={b_func_close} bparams={','.join(b_params)} a_tool={a_has_tool} acomps={','.join(a_params)}\"","+  c[cat]+=1","+  if res: c[cat+\" |res\"]+=1","+  if final: c[cat+\" |final\"]+=1","+  if len(examples[cat])<2: examples[cat].append((ep.get(\"episode\"),ti,txt,res))","+for k,v in c.most_common(40): print(v,k)","+print(\"\\nExamples top cats\")","+for cat,_ in c.most_common(6):","+ if \"|\" in cat: continue","+ print(\"\\n===\",cat)","+ for e in examples[cat][:2]: print(repr(e)[:2500])"],"newLines":28,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/draft_patterns.py"}]}