{"files":[{"hunks":[{"lines":["             continue","         calls.extend(_calls_from_json_value(value, properties))","     return calls","+","+","+def _matching_brace(text: str, start: int) -> int:","+    \"\"\"Index just past the ``}`` matching the ``{`` at ``start`` (string-aware), or -1.\"\"\"","+    depth, quote, escaped = 0, None, False","+    for i in range(start, len(text)):","+        ch = text[i]","+        if quote:","+            if escaped:","+                escaped = False","+            elif ch == \"\\\\\":","+                escaped = True","+            elif ch == quote:","+                quote = None","+        elif ch in (\"'\", '\"'):","+            quote = ch","+        elif ch == \"{\":","+            depth += 1","+        elif ch == \"}\":","+            depth -= 1","+            if depth == 0:","+                return i + 1","+    return -1","+","+","+def _parse_llama(text: str, properties: dict[str, dict]) -> list[tuple[str, dict]]:","+    \"\"\"Llama-3.1 JSON calls: a bare JSON object, optionally after ``<|python_tag|>``.\"\"\"","+    calls: list[tuple[str, dict]] = []","+    decoder = json.JSONDecoder()","+    structured = \"<|python_tag|>\" in text or text.lstrip().startswith(\"{\")","+    action = text.split(\"<|python_tag|>\", 1)[1] if \"<|python_tag|>\" in text else text","+    i = 0","+    while i < len(action):","+        brace = action.find(\"{\", i)","+        if brace == -1:","+            break","+        if structured and action[i:brace].strip(\" \\t\\r\\n;\"):","+            # In a structured reply, only separators may sit between calls.","+            nxt = action.find(\"<|python_tag|>\", i)","+            if nxt == -1:","+                break","+            i = nxt + len(\"<|python_tag|>\")","+            continue","+        try:","+            obj, end = decoder.raw_decode(action[brace:])","+        except (json.JSONDecodeError, ValueError):","+            end_at = _matching_brace(action, brace)","+            if end_at == -1:","+                break  # unfinished object","+            try:","+                obj = ast.literal_eval(action[brace:end_at])","+            except Exception:","+                if structured:","+                    break","+                i = brace + 1","+                continue","+            calls.extend(_calls_from_json_value(obj, properties))","+            i = end_at","+            continue","+        found = _calls_from_json_value(obj, properties)","+        calls.extend(found)","+        i = brace + end if (found or structured) else brace + 1","+        if not structured and not found:","+            continue","+    return calls","+","+","+_HARMONY_ENDS = (\"<|call|>\", \"<|end|>\", \"<|return|>\")","+_RECIPIENT_RE = re.compile(r\"to=([A-Za-z_][A-Za-z0-9_.\\-]*)\")","+_CHANNEL_RE = re.compile(r\"<\\|channel\\|>\\s*(analysis|commentary|final)\", re.I)","+","+","+def _parse_gpt_oss(text: str, properties: dict[str, dict]) -> list[tuple[str, dict]]:","+    \"\"\"Harmony blocks.  Both header orders the model/template use are accepted:","+","+    ``assistant to=functions.f<|channel|>commentary json<|message|>...<|call|>`` and","+    ``assistant<|channel|>commentary to=functions.f<|constrain|>json<|message|>...<|call|>``.","+    The generation prompt already ends in ``<|start|>assistant``, so the first","+    block usually starts with the recipient or the channel token.  Analysis","+    blocks are reasoning; a block without its terminating token is unfinished.","+    \"\"\"","+    calls: list[tuple[str, dict]] = []","+    pos = 0","+    while True:","+        msg = text.find(\"<|message|>\", pos)","+        if msg == -1:","+            break","+        header, content_start = text[pos:msg], msg + len(\"<|message|>\")","+        term_at, term = -1, None","+        for tok in _HARMONY_ENDS:","+            at = text.find(tok, content_start)","+            if at != -1 and (term_at == -1 or at < term_at):","+                term_at, term = at, tok","+        if term is None:","+            break","+        content = text[content_start:term_at]","+        channel_m, recip_m = _CHANNEL_RE.search(header), _RECIPIENT_RE.search(header)","+        if term == \"<|call|>\" and recip_m and channel_m and channel_m.group(1).lower() == \"commentary\":","+            name = recip_m.group(1).split(\".\")[-1]","+            if name in properties:","+                try:","+                    args = json.loads(content) if content.strip() else {}","+                except (json.JSONDecodeError, ValueError):","+                    args = None","+                if isinstance(args, dict):","+                    calls.append((name, args))","+        pos = term_at + len(term)","+    return calls"],"newLines":111,"newStart":291,"oldLines":3,"oldStart":291}],"path":"/app/agent_rl/examples/tool_agent/tool_call_parsing.py"}]}