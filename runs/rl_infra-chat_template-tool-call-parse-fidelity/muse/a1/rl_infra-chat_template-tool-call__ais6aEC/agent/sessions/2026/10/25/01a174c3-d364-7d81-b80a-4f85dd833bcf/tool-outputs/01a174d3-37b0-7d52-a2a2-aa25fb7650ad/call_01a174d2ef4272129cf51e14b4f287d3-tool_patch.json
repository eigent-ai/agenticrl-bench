{"files":[{"hunks":[{"lines":["+\"\"\"Regression tests for reasoning-aware, complete, schema-exact tool-call parsing.","+","+Run with: cd /app/agent_rl && PYTHONPATH=/app/agent_rl:/opt/miles:/opt/sglang/python python -m pytest tests/ -q","+(or python -m unittest discover -s tests)","+\"\"\"","+import unittest","+","+from examples.tool_agent.data_tool import tool_specs as DATA","+from examples.tool_agent.sql_tool import tool_specs as SQL","+from examples.tool_agent.tool_call_parsing import parse_tool_calls, starts_in_think","+","+","+def parse(text, specs=SQL, tp=\"qwen3_coder\", rp=\"qwen3\", starts=False):","+    return parse_tool_calls(text, tool_specs=specs, tool_call_parser=tp,","+                            reasoning_parser=rp, starts_in_reasoning=starts)","+","+","+QC = ('<tool_call>\\n<function=execute_sql>\\n<parameter=database>\\n{d}\\n</parameter>\\n'","+      '<parameter=query>\\n{q}\\n</parameter>\\n</function>\\n</tool_call>')","+","+","+class TestQwen3Coder(unittest.TestCase):","+    def test_draft_in_reasoning_then_final(self):","+        text = \"draft:\\n\" + QC.format(d=\"draftdb\", q=\"SELECT 0\") + \"\\n</think>\\nFinal SQL:\\n```sql\\nSELECT 1\\n```\"","+        self.assertEqual(parse(text, starts=True), [])","+","+    def test_draft_then_real_after_think(self):","+        text = QC.format(d=\"draftdb\", q=\"SELECT 0\") + \"</think>\\n\" + QC.format(d=\"db\", q=\"SELECT 1\")","+        self.assertEqual(parse(text, starts=True),","+                         [(\"execute_sql\", {\"database\": \"db\", \"query\": \"SELECT 1\"})])","+","+    def test_explicit_think_draft(self):","+        text = \"<think>\\n\" + QC.format(d=\"draftdb\", q=\"SELECT 0\") + \"\\n</think>\\n\" + QC.format(d=\"db\", q=\"SELECT 1\")","+        self.assertEqual(parse(text, starts=False),","+                         [(\"execute_sql\", {\"database\": \"db\", \"query\": \"SELECT 1\"})])","+","+    def test_implicit_close_no_think_end(self):","+        text = \"thinking about it \" + QC.format(d=\"db\", q=\"SELECT 1\")","+        self.assertEqual(parse(text, starts=True),","+                         [(\"execute_sql\", {\"database\": \"db\", \"query\": \"SELECT 1\"})])","+","+    def test_unfinished_call_not_executed(self):","+        text = (\"</think>\\n<tool_call>\\n<function=execute_sql>\\n<parameter=database>\\ndb\\n</parameter>\\n\"","+                \"<parameter=query>\\nSELECT 1\")","+        self.assertEqual(parse(text, starts=True), [])","+","+    def test_complete_then_unfinished(self):","+        text = \"</think>\\n\" + QC.format(d=\"db\", q=\"SELECT 1\") + \"\\n<tool_call>\\n<function=execute_sql>\\n<parameter=query>\\nSELECT 2\"","+        self.assertEqual(parse(text, starts=True),","+                         [(\"execute_sql\", {\"database\": \"db\", \"query\": \"SELECT 1\"})])","+","+    def test_string_arguments_verbatim(self):","+        text = (\"</think><tool_call>\\n<function=str_replace_editor>\\n<parameter=command>\\ncreate\\n</parameter>\\n\"","+                \"<parameter=path>\\n/x/answer.json\\n</parameter>\\n<parameter=file_text>\\n\"","+                '[[\\n  \"a\",\\n  1\\n]]\\n\\n</parameter>\\n</function>\\n</tool_call>')","+        [(name, p)] = parse(text, specs=DATA, starts=True)","+        self.assertEqual(p[\"file_text\"], '[[\\n  \"a\",\\n  1\\n]]\\n')","+","+    def test_string_null_and_typed_arguments(self):","+        text = (\"</think><tool_call>\\n<function=execute_bash>\\n<parameter=command>\\nnull\\n</parameter>\\n\"","+                \"<parameter=timeout>\\n2.5\\n</parameter>\\n</function>\\n</tool_call>\")","+        [(name, p)] = parse(text, specs=DATA, starts=True)","+        self.assertEqual(p, {\"command\": \"null\", \"timeout\": 2.5})","+","+    def test_timeout_null_and_types(self):","+        text = (\"</think><tool_call>\\n<function=str_replace_editor>\\n<parameter=command>\\nview\\n</parameter>\\n\"","+                \"<parameter=path>\\n/x\\n</parameter>\\n<parameter=view_range>\\