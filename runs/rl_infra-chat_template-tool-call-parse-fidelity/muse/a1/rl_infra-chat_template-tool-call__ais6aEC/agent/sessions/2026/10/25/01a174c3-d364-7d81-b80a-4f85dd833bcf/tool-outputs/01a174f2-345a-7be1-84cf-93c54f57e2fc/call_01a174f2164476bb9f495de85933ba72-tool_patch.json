{"files":[{"hunks":[{"lines":["+import gzip,json,glob,re","+# GLM mutations: replay executed file_text must equal raw arg_value for string-typed params where raw extraction is unambiguous","+run=\"glm-4.7-flash_data_trial_2026-10-21\"","+eps=[json.loads(l) for l in gzip.open(f\"/app/agent_rl/data/runs/{run}/episodes.jsonl.gz\",\"rt\")]","+reps=[json.loads(l) for l in open(f\"/tmp/full_new2_{run}.jsonl\")]","+arg_re=re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>(.*?)</arg_value>\",re.S)","+bad=0; checked=0","+rep_by={r[\"episode\"]:r for r in reps}","+STRING_KEYS={\"execute_bash\":{\"command\"},\"str_replace_editor\":{\"command\",\"path\",\"file_text\",\"old_str\",\"new_str\"}}","+for ep in eps:","+    rep=rep_by.get(ep[\"episode\"])","+    if not rep: continue","+    by_turn={}","+    for c in rep[\"executed\"]: by_turn.setdefault(c[\"turn\"],[]).append(c)","+    for ti,t in enumerate(ep[\"turns\"]):","+        got=by_turn.get(ti,[])","+        vis=t[\"text\"].split(\"</think>\",1)[-1]","+        blocks=re.findall(r\"<tool_call>(.*?)</tool_call>\",vis,re.S)","+        if len(blocks)!=len(got): continue","+        for block,c in zip(blocks,got):","+            raw=dict((k.strip(),v) for k,v in arg_re.findall(block))","+            for k in STRING_KEYS.get(c[\"name\"],set()) & raw.keys():","+                checked+=1","+                if c[\"params\"].get(k)!=raw[k]:","+                    bad+=1; print(\"MUT\",ep[\"episode\"],ti,c[\"name\"],k,repr(raw[k]),repr(c[\"params\"].get(k)))","+print(f\"GLM string args checked {checked} mutated {bad}\")","+for path in sorted(glob.glob(\"/tmp/full_new2_*.jsonl\")):","+    reps=[json.loads(l) for l in open(path)]","+    print(path, \"eps\",len(reps),\"errs\",sum(r[\"error\"] is not None for r in reps),\"calls\",sum(len(r[\"executed\"]) for r in reps),\"req\",sum(r[\"requests\"] for r in reps))"],"newLines":29,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_full_reports.py"}]}