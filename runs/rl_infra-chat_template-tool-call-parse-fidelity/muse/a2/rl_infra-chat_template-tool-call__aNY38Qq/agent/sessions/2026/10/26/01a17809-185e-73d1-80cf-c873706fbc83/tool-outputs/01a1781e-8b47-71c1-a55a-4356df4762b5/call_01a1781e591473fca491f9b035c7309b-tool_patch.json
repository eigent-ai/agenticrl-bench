{"files":[{"hunks":[{"lines":["         if finished:","             out.append((name, params))","     return out","+","+","+def _parse_qwen25(text: str, known_names, props_by_name):","+    \"\"\"Hermes/Qwen2.5: one JSON action inside <tool_call>...</tool_call>.  Decode the JSON itself rather","+    than hunting the closing tag first, so a string argument may contain the tag text, and an action whose","+    JSON never finishes yields no call even when a closing tag follows it.\"\"\"","+    out = []","+    decoder = json.JSONDecoder()","+    pos = 0","+    while True:","+        start = text.find(\"<tool_call>\", pos)","+        if start == -1:","+            return out","+        i = start + len(\"<tool_call>\")","+        while i < len(text) and text[i].isspace():","+            i += 1","+        close = text.find(\"</tool_call>\", start)","+        if close == -1:","+            return out","+        try:","+            value, end = decoder.raw_decode(text[i:])","+        except (json.JSONDecodeError, ValueError):","+            pos = close + len(\"</tool_call>\")","+            continue","+        j = i + end","+        while j < len(text) and text[j].isspace():","+            j += 1","+        if not text.startswith(\"</tool_call>\", j):","+            pos = close + len(\"</tool_call>\")","+            continue","+        out.extend(_json_actions(value, known_names))","+        pos = j + len(\"</tool_call>\")","+","+","+def _matching_brace_end(text: str, start: int) -> int:","+    \"\"\"End index (exclusive) of the brace-balanced value opening at start, honouring quoted strings.\"\"\"","+    depth, quote, i = 0, None, start","+    while i < len(text):","+        ch = text[i]","+        if quote is not None:","+            if ch == \"\\\\\":","+                i += 2","+                continue","+            if ch == quote:","+                quote = None","+        elif ch in (\"'\", '\"'):","+            quote = ch","+        elif ch == \"{\":","+            depth += 1","+        elif ch == \"}\":","+            depth -= 1","+            if depth == 0:","+                return i + 1","+        i += 1","+    return -1","+","+","+def _parse_llama3(text: str, known_names, props_by_name):","+    \"\"\"Llama 3.1 JSON template: the whole reply is {\"name\": ..., \"parameters\": {...}} (the same action may","+    also be prefixed with <|python_tag|>).  Leading whitespace is framing, not part of the reply.\"\"\"","+    if \"<|python_tag|>\" in text:","+        area = text.split(\"<|python_tag|>\", 1)[1]","+    else:","+        area = text.lstrip()","+        if not area.startswith(\"{\"):","+            return []","+    out = []","+    decoder = json.JSONDecoder()","+    i = 0","+    while i < len(area):","+        while i < len(area) and area[i] in \" \\t\\r\\n;\":","+            i += 1","+        if i >= len(area) or area[i] != \"{\":","+            break","+        try:","+            value, end = decoder.raw_decode(area[i:])","+            i += end","+        except (json.JSONDecodeError, ValueError):","+            # Llama also writes Python-dict spelling; SGLang's detector accepts it, and a brace-balanced","+            # complete dict is still a finished call while a truncated one has no matching brace.","+            end = _matching_brace_end(area, i)","+            if end == -1:","+                break","+            try:","+                value = ast.literal_eval(area[i:end])","+            except Exception:  # noqa: BLE001","+                break","+            if not isinstance(value, dict):","+                break","+            i = end","+        out.extend(_json_actions(value, known_names))","+    return out","+","+","+def _parse_gpt_oss(text: str, known_names, props_by_name):","+    \"\"\"Harmony: a message whose header names a functions.* recipient and which ends <|call|> is a tool","+    call; analysis, commentary without a recipient, and final messages are not, and a message with no","+    terminator was never finished.  The recipient sits before <|channel|> in the header its chat template","+    renders (\"assistant to=functions.x<|channel|>commentary json<|message|>\") and after it in the form","+    SGLang's detector expects (\"commentary to=functions.x<|constrain|>json\"); accept the header either way.\"\"\"","+    out = []","+    pos = 0","+    terminators = (\"<|call|>\", \"<|end|>\", \"<|return|>\")","+    while pos < len(text):","+        message = text.find(\"<|message|>\", pos)","+        if message == -1:","+            return out","+        header_start = text.rfind(\"<|start|>\", pos, message)","+        if header_start == -1:","+            header_start = pos","+        header = text[header_start:message]","+        content_start = message + len(\"<|message|>\")","+        ends = [(text.find(tok, content_start), tok) for tok in terminators]","+        ends = [(idx, tok) for idx, tok in ends if idx != -1]","+        if not ends:","+            return out","+        end, terminator = min(ends)","+        if terminator == \"<|call|>\":","+            recipient = re.search(r\"to=([A-Za-z_][A-Za-z0-9_.\\-]*)\", header)","+            if recipient is not None:","+                name = recipient.group(1).split(\".\")[-1]","+                if name in known_names:","+                    raw_args = text[content_start:end].strip()","+                    try:","+                        params = json.loads(raw_args) if raw_args else {}","+                    except (json.JSONDecodeError, ValueError):","+                        params = None","+                    if isinstance(params, dict):","+                        out.append((name, params))","+        pos = end + len(terminator)","+    return out","+","+","+_PARSERS = {","+    \"qwen3_coder\": _parse_qwen3_coder,","+    \"glm47\": _parse_glm47, \"glm45\": _parse_glm47, \"glm\": _parse_glm47,","+    \"qwen25\": _parse_qwen25, \"qwen\": _parse_qwen25,","+    \"llama3\": _parse_llama3,","+    \"gpt-oss\": _parse_gpt_oss,","+}"],"newLines":143,"newStart":401,"oldLines":3,"oldStart":401}],"path":"/app/agent_rl/examples/tool_agent/agent_loop.py"}]}