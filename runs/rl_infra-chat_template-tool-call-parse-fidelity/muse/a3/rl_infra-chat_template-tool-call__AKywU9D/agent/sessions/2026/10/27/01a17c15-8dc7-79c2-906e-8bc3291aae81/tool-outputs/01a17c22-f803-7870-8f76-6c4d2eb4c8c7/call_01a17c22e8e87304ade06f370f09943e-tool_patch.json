{"files":[{"hunks":[{"lines":["+import sys, json, importlib.util","+sys.path.insert(0,\"/app/agent_rl\"); sys.path.insert(0,\"/app/agent_rl/launch\")","+# ensure agent_rl examples wins over miles examples: load agent_loop by path","+spec=importlib.util.spec_from_file_location(\"agent_loop_mod\",\"/app/agent_rl/examples/tool_agent/agent_loop.py\")","+al=importlib.util.module_from_spec(spec); spec.loader.exec_module(al)","+import run_tool_agent","+from transformers import AutoTokenizer","+for name,(hf,mt,rp,tp,kw,tpl) in run_tool_agent.MODELS.items():","+    tok=AutoTokenizer.from_pretrained(hf)","+    if tpl: tok.chat_template=open(tpl).read()","+    kwargs=json.loads(kw)","+    msgs=[{\"role\":\"tool\",\"tool_call_id\":\"call00000\",\"name\":\"execute_sql\",\"content\":\"rows here\"}]","+    try:","+        ids=al.tool_result_ids(msgs, tok, kwargs)","+        print(name, \"OK\", repr(tok.decode(ids))[:400])","+    except Exception as e:","+        print(name, \"FAIL\", type(e).__name__, str(e)[:300])"],"newLines":17,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_tri.py"}]}