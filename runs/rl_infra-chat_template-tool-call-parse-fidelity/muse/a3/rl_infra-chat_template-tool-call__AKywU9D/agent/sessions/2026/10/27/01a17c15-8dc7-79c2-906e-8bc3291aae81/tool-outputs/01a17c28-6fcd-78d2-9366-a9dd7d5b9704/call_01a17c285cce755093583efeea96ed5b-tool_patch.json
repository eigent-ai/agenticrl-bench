{"files":[{"hunks":[{"lines":["+import json, sys","+def load(p): return [json.loads(l) for l in open(p)]","+a, b = load(sys.argv[1]), load(sys.argv[2])","+print(\"episodes\", len(a), len(b))","+da=db=0","+for x,y in zip(a,b):","+    if x[\"executed\"]!=y[\"executed\"]:","+        print(\"\\nEP\", x[\"episode\"], \"requests\", x[\"requests\"], \"->\", y[\"requests\"])","+        xe={(c[\"turn\"],c[\"name\"],json.dumps(c[\"params\"],sort_keys=True)) for c in x[\"executed\"]}","+        ye={(c[\"turn\"],c[\"name\"],json.dumps(c[\"params\"],sort_keys=True)) for c in y[\"executed\"]}","+        for c in sorted(xe-ye): print(\"  WAS\", c); da+=1","+        for c in sorted(ye-xe): print(\"  NOW\", c); db+=1","+    # sample comparison when executed same","+    elif x.get(\"sample\")!=y.get(\"sample\"):","+        print(\"\\nEP sample diff\", x[\"episode\"]); print(\" WAS\", x.get(\"sample\")); print(\" NOW\", y.get(\"sample\"))","+print(\"removed/changed WAS entries\", da, \"NOW entries\", db)"],"newLines":16,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/diff_replay.py"}]}