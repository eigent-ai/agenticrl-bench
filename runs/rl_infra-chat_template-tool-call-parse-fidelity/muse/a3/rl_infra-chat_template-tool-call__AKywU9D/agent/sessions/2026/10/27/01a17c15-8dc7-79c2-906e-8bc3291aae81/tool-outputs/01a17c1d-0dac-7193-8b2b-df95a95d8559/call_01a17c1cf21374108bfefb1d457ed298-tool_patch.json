{"files":[{"hunks":[{"lines":["+import gzip, json, re, sys","+sys.path.insert(0,\"/opt/sglang/python\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/app/agent_rl\")","+from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser","+import importlib.util","+spec=importlib.util.spec_from_file_location(\"data_tool\",\"/app/agent_rl/examples/tool_agent/data_tool.py\")","+# data_tool imports miles.utils.types only","+dt=importlib.util.module_from_spec(spec); spec.loader.exec_module(dt)","+spec2=importlib.util.spec_from_file_location(\"sql_tool\",\"/app/agent_rl/examples/tool_agent/sql_tool.py\")","+st=importlib.util.module_from_spec(spec2); spec2.loader.exec_module(st)","+","+for run, specs, parser_name in [(\"glm-4.7-flash_data_trial_2026-10-21\", dt.tool_specs, \"glm47\"),","+                                 (\"glm-4.7-flash_sql_trial_2026-10-21\", st.tool_specs, \"glm47\")]:","+    eps=[json.loads(l) for l in gzip.open(f\"/app/agent_rl/data/runs/{run}/episodes.jsonl.gz\",\"rt\")]","+    parser=create_tool_call_parser(specs, parser_name)","+    print(\"\\n===\",run)","+    # raw arg extraction regex","+    arg_re=re.compile(r\"<tool_call>(.*?)</tool_call>\", re.S)","+    pair_re=re.compile(r\"<arg_key>(.*?)</arg_key>(?:\\n|\\s)*<arg_value>(.*?)</arg_value>\", re.S)","+    n_diff=0; n_calls=0","+    for ei,e in enumerate(eps):","+        for ti,t in enumerate(e[\"turns\"]):","+            txt=t[\"text\"]","+            # raw calls after </think>","+            for m in arg_re.finditer(txt):","+                body=m.group(1)","+                pairs=pair_re.findall(body)","+                if not pairs: continue","+                n_calls+=1","+                # detector on whole text; match by order? simpler: detector on this block alone","+                _, calls = create_tool_call_parser(specs, parser_name).parse_non_stream(m.group(0))","+                if not calls: ","+                    print(\"NO CALL\", ei,ti, m.group(0)[:300]); continue","+                params=json.loads(calls[0].parameters)","+                for k,raw in pairs:","+                    k=k.strip()","+                    if k in params and isinstance(params[k], str) and params[k]!=raw:","+                        n_diff+=1","+                        print(f\"\\nDIFF ep{ei} turn{ti} {calls[0].name}.{k}:\")","+                        print(\" raw :\", repr(raw[:500]))","+                        print(\" got :\", repr(params[k][:500]))","+                    elif k in params and not isinstance(params[k],str):","+                        # type changed; check schema expects str?","+                        print(f\"\\nTYPE ep{ei} turn{ti} {calls[0].name}.{k}: raw={raw[:200]!r} got={params[k]!r}\")","+    print(\"calls\",n_calls,\"string diffs\",n_diff)"],"newLines":44,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze_glm.py"}]}