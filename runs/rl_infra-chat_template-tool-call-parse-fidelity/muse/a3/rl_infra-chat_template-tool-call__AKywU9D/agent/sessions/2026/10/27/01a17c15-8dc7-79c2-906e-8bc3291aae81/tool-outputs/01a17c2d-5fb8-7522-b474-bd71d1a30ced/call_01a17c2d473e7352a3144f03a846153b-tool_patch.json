{"files":[{"hunks":[{"lines":["+import gzip, json, sys, collections, re","+sys.path.insert(0,\"/opt/sglang/python\"); sys.path.insert(0,\"/opt/miles\"); sys.path.insert(0,\"/app/agent_rl\")","+import importlib.util","+def loadmod(name,path):","+    s=importlib.util.spec_from_file_location(name,path); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); return m","+st=loadmod(\"sql_tool\",\"/app/agent_rl/examples/tool_agent/sql_tool.py\")","+tcp=loadmod(\"tcp\",\"/app/agent_rl/examples/tool_agent/tool_call_parsing.py\")","+from miles.rollout.generate_utils.tool_call_utils import create_tool_call_parser","+","+def old_calls(text):","+    _,cs=create_tool_call_parser(st.tool_specs,\"qwen3_coder\").parse_non_stream(text)","+    out=[]","+    for c in cs:","+        try: out.append((c.name,json.loads(c.parameters) if c.parameters else {}))","+        except Exception: out.append((c.name,c.parameters))","+    return out","+","+def new_calls(text, force):","+    items=tcp.parse_tool_calls(text, st.tool_specs, \"qwen3_coder\", reasoning_parser=\"qwen3\", force_reasoning=force)","+    return [(c.name,json.loads(c.parameters)) for c in items]","+","+eps=[json.loads(l) for l in gzip.open(\"/app/agent_rl/data/runs/qwen3.5-2b_sql_2026-10-08/episodes.jsonl.gz\",\"rt\")]","+cat=collections.Counter(); examples=collections.defaultdict(list)","+import logging; logging.disable(logging.WARNING)","+for ei,e in enumerate(eps):","+    # turn0 prompt suffix verdict","+    v0=tcp.prompt_suffix_in_reasoning(e[\"prompt\"][-2000:], \"qwen3\")","+    for ti,t in enumerate(e[\"turns\"]):","+        if t[\"finish_reason\"].get(\"type\")!=\"stop\": continue","+        force = (v0 if v0 is not None else False) if ti==0 else True","+        o=old_calls(t[\"text\"]); n=new_calls(t[\"text\"], force)","+        if o==n: cat[\"same\"]+=1; continue","+        # classify","+        if len(n)>len(o): k=\"new_more\"","+        elif any(c not in n for c in o) and all(c in o for c in n): k=\"new_sub