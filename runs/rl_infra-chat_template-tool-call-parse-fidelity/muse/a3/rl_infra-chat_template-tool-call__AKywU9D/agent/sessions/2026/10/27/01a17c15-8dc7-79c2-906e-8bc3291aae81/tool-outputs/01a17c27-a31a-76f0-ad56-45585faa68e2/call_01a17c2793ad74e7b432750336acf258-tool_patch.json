{"files":[{"hunks":[{"lines":["+import sys, json","+sys.path.insert(0,\"/app/agent_rl\"); sys.path.insert(0,\"/app/agent_rl/launch\"); sys.path.insert(0,\"/opt/sglang/python\")","+from transformers import AutoTokenizer","+from sglang.srt.parser.template_detection import detect_reasoning_pattern","+import importlib.util","+spec=importlib.util.spec_from_file_location(\"tcp\",\"/app/agent_rl/examples/tool_agent/tool_call_parsing.py\")","+tcp=importlib.util.module_from_spec(spec); spec.loader.exec_module(tcp)","+import run_tool_agent","+for name,(hf,mt,rp,tp,kw,tpl) in run_tool_agent.MODELS.items():","+    tok=AutoTokenizer.from_pretrained(hf)","+    if tpl: tok.chat_template=open(tpl).read()","+    kwargs=json.loads(kw)","+    print(name, \"detect\", detect_reasoning_pattern(tok.chat_template), \"force=\", tcp.reasoning_force_from_template(tok, rp, kwargs))","+    if rp:","+        # suffix verdicts on generation prompt tail","+        s=tok.apply_chat_template([{\"role\":\"user\",\"content\":\"hi\"}], tokenize=False, add_generation_prompt=True, **kwargs)","+        ids=tok.encode(s)[-64:]","+        print(\"   genprompt suffix verdict:\", tcp.prompt_suffix_in_reasoning(tok.decode(ids), rp), \"tail:\", repr(s[-60:]))"],"newLines":18,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_force.py"}]}