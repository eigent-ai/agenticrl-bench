{"files":[{"hunks":[{"lines":["+import sys, json, time, re, shlex","+sys.path.insert(0,'/app'); sys.path.insert(0,'/tmp')","+import sbx","+from probe_replay import replay","+","+SKIP={'BASH','BASHOPTS','BASH_VERSINFO','EUID','UID','PPID','SHELLOPTS','FUNCNAME','GROUPS','HOSTTYPE','HOSTNAME','MACHTYPE','OSTYPE','RANDOM','SRANDOM','SECONDS','LINENO','HISTCMD','DIRSTACK','PWD','OLDPWD','SHLVL','_','PIPESTATUS','BASH_CMDS','BASH_ALIASES','BASH_ARGC','BASH_ARGV','BASH_LINENO','BASH_SOURCE','COLUMNS','LINES','COMP_LINE','COMP_POINT'}","+","+def parse(lines):","+    d={'vars':{},'aliases':{},'functions':{},'set':{},'shopt':{},'traps':{},'jobs':[],'dirs':[]}","+    i=0","+    d['pwd']=lines[0][4:] if lines and lines[0].startswith('pwd ') else None","+    d['umask']=lines[1] if len(lines)>1 else None","+    i=2","+    while i<len(lines):","+        line=lines[i]","+        m=re.match(r'^([A-Za-z_][A-Za-z0-9_]*) \\(\\) $', line)","+        if m:","+            block=[line]; i+=1","+            while i<len(lines):","+                block.append(lines[i]);","+                if lines[i]=='}': i+=1; break","+                i+=1","+            d['functions'][m.group(1)]='\\n'.join(block); continue","+        if line.startswith('set -o ') or line.startswith('set +o '):","+            d['set'][line.split()[-1]]=line","+        elif line.startswith('shopt '):","+            d['shopt'][line.split()[-1]]=line","+        elif line.startswith('declare '):","+            m=re.match(r'^declare\\s+(?:-\\S+\\s+)*([A-Za-z_][A-Za-z0-9_]*)(=|$)', line)","+            if m: d['vars'][m.group(1)]=line","+        elif line.startswith('alias '):","+            m=re.match(r\"^alias ([^=]+)=\", line)","+            if m: d['aliases'][m.group(1)]=line","+        elif line.startswith('['):","+            d['jobs'].append(line)","+        elif line.startswith('trap '):","+            d['traps'][line.split()[-1]]=line","+        elif line.startswith('/'):","+            d['dirs'].append(line)","+        i+=1","+    return d","+","+def script(gold, cur):","+    g=parse(gold); c=parse(cur); out=[]","+    if g['umask']!=c['umask']: out.append(f\"builtin umask {g['umask']}\")","+    for n,b in g['functions'].items():","+        if n=='__sbx_state': continue","+        if c['functions'].get(n)!=b: out.append(b)","+    for n in c['functions']:","+        if n!='__sbx_state' and n not in g['functions']: out.append(f\"builtin unset -f {n}\")","+    for n,l in g['aliases'].items():","+        if c['aliases'].get(n)!=l: out.append('builtin '+l)","+    for n in c['aliases']:","+        if n not in g['aliases']: out.append(f\"builtin unalias {shlex.quote(n)}\")","+    for n,l in g['vars'].items():","+        if n in SKIP: continue","+        if c['vars'].get(n)!=l: out.append('builtin '+l)","+    for n in c['vars']:","+        if n not in SKIP and n not in g['vars']: out.append(f\"builtin unset {n}\")","+    for n,l in g['traps'].items():","+        if c['traps'].get(n)!=l: out.append('builtin '+l)","+    for n in c['traps']:","+        if n not in g['traps']: out.append(f\"builtin trap - {n}\")","+    # dirs/cwd","+    if g['pwd']:","+        out.append(f\"builtin dirs -c >/dev/null 2>&1; builtin cd -- {shlex.quote(g['pwd'])}\")","+        for d in reversed(g['dirs'][1:]):","+            out.append(f\"builtin pushd -n -- {shlex.quote(d)} >/dev/null\")","+    ov=g['vars'].get('OLDPWD')","+    if ov and '=' in ov:","+        val=ov.split('=',1)[1]","+        out.append(f\"OLDPWD={val}\")","+    elif g['pwd']:","+        out.append(\"builtin unset OLDPWD; builtin declare -x OLDPWD\")","+    for n,l in g['set'].items():","+        if c['set'].get(n)!=l: out.append('builtin '+l)","+    for n,l in g['shopt'].items():","+        if c['shopt'].get(n)!=l: out.append('builtin '+l)","+    return '\\n'.join(out)+'\\n', g, c","+","+def test(name, traj, k):","+    gold_sb, info = replay(traj, k)","+    snap=None; cand=None","+    try:","+        gfp=gold_sb.fingerprint(detail=True)","+        snap=gold_sb.snapshot(); cand=sbx.create(traj['env'], tenant=gold_sb.tenant, snapshot=snap)","+        cfp=cand.fingerprint(detail=True)","+        diff=[x for x in gfp['fingerprint'] if gfp['fingerprint'][x]!=cfp['fingerprint'][x]]","+        scr,g,c=script(gfp['detail']['shell'], cfp['detail']['shell'])","+        print('\\n',name,'diff before',diff,'gold jobs',g['jobs'],'script:\\n',scr[:2000])","+        r=cand.exec(['python3','-c',\"import sys;open('/dev/shm/recon.sh','w').write(sys.stdin.read())\"], stdin=scr)","+        cand.keys('source /dev/shm/recon.sh\\n'); time.sleep(0.6)","+        print('screen',repr(cand.capture()[-500:]))","+        nfp=cand.fingerprint(detail=True)","+        print('match', nfp['fingerprint']==gfp['fingerprint'], [x for x in gfp['fingerprint'] if gfp['fingerprint'][x]!=nfp['fingerprint'][x]])","+        if nfp['fingerprint']['shell']!=gfp['fingerprint']['shell']:","+            a=set(gfp['detail']['shell']); b=set(nfp['detail']['shell'])","+            print('gold-only',[x for x in gfp['detail']['shell'] if x not in b][:30])","+            print('cand-only',[x for x in nfp['detail']['shell'] if x not in a][:30])","+    finally:","+        if cand: cand.terminate()","+        gold_sb.terminate()","+        if snap: sbx.drop_snapshot(snap)","+","+if __name__=='__main__':","+    for name in ['notes-api/shell-setup','config-lint/validate-fn','build-farm/env-tweaks','inventory-sync/local-only','word-count/pipeline-helpers']:","+        traj=json.load(open(f'/app/buffer/{name}.json')); test(name, traj, len(traj['turns']))"],"newLines":107,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/test_shell_recon.py"}]}