{"files":[{"hunks":[{"lines":[" def replay(traj, k, tenant=None, verify_obs=True):","     \"\"\"Returns (sb, info). Caller terminates sb.\"\"\"","     offset = traj[\"created_at\"] - time.time()","+    t0_mono = time.monotonic()","+    t0_sand = traj[\"created_at\"]  # sandbox time = real+offset; at create call real ~= created-offset","     sb = sbx.create(traj[\"env\"], tenant=tenant, clock_offset=offset)","     info = {\"tenant\": sb.tenant, \"obs_ok\": True, \"obs_fail\": None}","-    # time mapping: sandbox clock -> monotonic","     def wait_until(t):","-        # poll sandbox clock rarely then spin on estimate","+        target = t0_mono + (t - t0_sand)","         while True:","-            now = sb.clock()","-            d = t - now","+            d = target - time.monotonic()","             if d <= 0:","                 return","-            if d > 0.05:","-                time.sleep(d - 0.02)","-            else:","-                time.sleep(0.002)","+            time.sleep(d if d > 0.02 else d)","     try:","         for i in range(k):","             turn = traj[\"turns\"][i]"],"newLines":17,"newStart":7,"oldLines":20,"oldStart":7}],"path":"/tmp/probe_replay.py"}]}