{"files":[{"hunks":[{"lines":["+import sys, json, time","+sys.path.insert(0,'/app')","+import sbx","+from branching.reset import reset, NotResettable","+p,k=sys.argv[1],int(sys.argv[2]); traj=json.load(open(p)); t0=time.time()","+try:","+    sid=reset(traj,k); sb=sbx.attach(sid); fp=sb.fingerprint()['fingerprint']","+    listed={s['id']:s for s in sbx.list_sandboxes()['sandboxes']}","+    print(json.dumps({'traj':traj['traj_id'],'k':k,'ok':True,'tenant_ok':listed.get(sid,{}).get('tenant')==traj['tenant'],'files':fp['files'][:12],'dt':round(time.time()-t0,1)}), flush=True)","+    sb.terminate()","+except NotResettable as e:","+    print(json.dumps({'traj':traj['traj_id'],'k':k,'ok':False,'err':str(e),'dt':round(time.time()-t0,1)}), flush=True)"],"newLines":12,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/worker.py"}]}