{"files":[{"hunks":[{"lines":["         fh.close()"," "," ","<redacted-email>","+def _replay_slot(slots=8):","+    \"\"\"Bound the number of simultaneously replaying sandboxes across all","+    worker processes of this user. Unbounded replay parallelism overloads","+    the box, makes sandbox commands miss their original timing, and turns","+    restorable steps into false refusals. Eight is the trainer's worker","+    count, i.e. roughly one replay stream per worker.\"\"\"","+    if fcntl is None:","+        yield","+        return","+    held = None","+    while held is None:","+        for i in range(slots):","+            path = os.path.join(tempfile.gettempdir(), \"branching-reset-slot-%d.lock\" % i)","+            try:","+                fh = open(path, \"a+\")","+            except OSError:","+                yield","+                return","+            try:","+                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)","+                held = fh","+                break","+            except OSError:","+                fh.close()","+        if held is None:","+            time.sleep(0.05)","+    try:","+        yield","+    finally:","+        try:","+            fcntl.flock(held.fileno(), fcntl.LOCK_UN)","+        except Exception:","+            pass","+        held.close()","+","+"," def _terminate(sb):","     if sb is None:","         return"],"newLines":43,"newStart":117,"oldLines":6,"oldStart":117}],"path":"/app/branching/reset.py"}]}