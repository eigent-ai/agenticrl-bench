{"files":[{"hunks":[{"lines":["         return 0"," "," ","+def _patch_shell_tokens(sb, pairs):","+    \"\"\"Replace replay tokens in this sandbox's live shell variables (the","+    shell counterpart of the file patch; only for an idle shell).\"\"\"","+    try:","+        detail = sb.fingerprint(detail=True)[\"detail\"]","+    except Exception:","+        return","+    if len(detail.get(\"processes\", [])) != 2:","+        return","+    parsed = _parse_shell_detail(detail.get(\"shell\", []))","+","+    def sub(s):","+        for old, new in pairs:","+            s = s.replace(old, new)","+        return s","+","+    def has(s):","+        return any(old in s for old, _ in pairs)","+","+    stmts = []","+    for name, block in parsed[\"functions\"].items():","+        if name != \"__sbx_state\" and has(block):","+            stmts.append(sub(block))","+    for name, line in parsed[\"aliases\"].items():","+        if has(line):","+            stmts.append(\"builtin \" + sub(line))","+    for name, line in parsed[\"vars\"].items():","+        if name in _SHELL_SKIP_VARS:","+            continue","+        if has(line):","+            stmts.append(\"builtin \" + sub(line))","+    for name, line in parsed[\"traps\"].items():","+        if has(line):","+            stmts.append(\"builtin \" + sub(line))","+    if parsed[\"pwd\"] and (has(parsed[\"pwd\"]) or any(has(d) for d in parsed[\"dirs\"])","+                           or has(parsed[\"vars\"].get(\"OLDPWD\", \"\"))):","+        stmts.append(\"builtin dirs -c >/dev/null 2>&1; builtin cd -- %s\" % shlex.quote(sub(parsed[\"pwd\"])))","+        for d in reversed(parsed[\"dirs\"][1:]):","+            stmts.append(\"builtin pushd -n -- %s >/dev/null\" % shlex.quote(sub(d)))","+        ov = parsed[\"vars\"].get(\"OLDPWD\")","+        if ov and \"=\" in ov:","+            stmts.append(\"OLDPWD=%s\" % sub(ov.split(\"=\", 1)[1]))","+        else:","+            stmts.append(\"builtin unset OLDPWD; builtin declare -x OLDPWD\")","+    if not stmts:","+        return","+    stage = \"/dev/shm/.branching-tok-%s.sh\" % sb.id","+    try:","+        r = sb.exec([\"python3\", \"-c\",","+                     \"import sys;open(sys.argv[1],'w').write(sys.stdin.read())\", stage],","+                    stdin=\"\\n\".join(stmts) + \"\\n\", timeout=30)","+        if r.get(\"rc\") != 0:","+            return","+        sb.keys(\"source %s\\n\" % shlex.quote(stage))","+        time.sleep(0.4)","+    except Exception:","+        pass","+    finally:","+        try:","+            sb.exec(\"rm -f %s\" % shlex.quote(stage), timeout=30)","+        except Exception:","+            pass","+","+"," def _maybe_patch_replay(traj, k, rep, gold, mounts):","     \"\"\"If gold was verified via token patching, patch this production","     replay the same way and refresh its fingerprint.\"\"\""],"newLines":70,"newStart":644,"oldLines":6,"oldStart":644}],"path":"/app/branching/reset.py"}]}