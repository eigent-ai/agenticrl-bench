{"files":[{"hunks":[{"lines":["+import sbx, time, json","+","+def wait_until(sb, target):","+    while True:","+        now = sb.clock()","+        d = target - now","+        if d <= 0:","+            return now","+        if d > 0.05:","+            time.sleep(d - 0.02)","+        else:","+            time.sleep(0.002)","+","+def make(env, created_at, tenant=None):","+    off = created_at - time.time()","+    kw = {}","+    if tenant: kw[\"tenant\"] = tenant","+    return sbx.create(env, clock_offset=off, **kw)","+","+def replay(traj, k, tenant=None, capture_each=True):","+    sb = make(traj[\"env\"], traj[\"created_at\"], tenant=tenant)","+    screens = []","+    try:","+        for i in range(k):","+            t = traj[\"turns\"][i]","+            wait_until(sb, t[\"sent_at\"])","+            sb.keys(t[\"keys\"])","+            time.sleep(t[\"duration\"])","+            if capture_each:","+                screens.append(sb.capture())","+        step_t = traj[\"turns\"][k][\"sent_at\"] if k < len(traj[\"turns\"]) else traj[\"ended_at\"]","+        wait_until(sb, step_t)","+        return sb, screens","+    except Exception:","+        sb.terminate(); raise","+","+def norm(s):","+    return \"\\n\".join(line.rstrip() for line in s.strip(\"\\n\").split(\"\\n\")).rstrip(\"\\n\")","+","+def compare_screens(traj, screens):","+    out=[]","+    for i,sc in enumerate(screens):","+        obs=traj[\"turns\"][i][\"observation\"]","+        out.append(norm(sc)==norm(obs))","+    return out"],"newLines":45,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/replaylib.py"}]}