{"files":[{"hunks":[{"lines":["             _terminate(sb)"," "," ","+# --------------------------------------------------------------------------- snapshot-fallback transplants","+_DECL_RE = re.compile(r\"^declare\\s+(\\S+)\\s+([A-Za-z_][A-Za-z0-9_]*)(=(.*))?$\")","+_SKIP_DECLARE = {","+    \"_\", \"BASHOPTS\", \"SHELLOPTS\", \"EUID\", \"UID\", \"PPID\", \"PWD\", \"OLDPWD\", \"DIRSTACK\",","+    \"BASH_VERSINFO\", \"BASH_VERSION\", \"BASH_COMMAND\", \"BASH_LINENO\", \"BASH_SOURCE\", \"BASH_ARGC\",","+    \"BASH_ARGV\", \"BASH_ARGV0\", \"FUNCNAME\", \"LINENO\", \"RANDOM\", \"SRANDOM\", \"SECONDS\", \"EPOCHSECONDS\",","+    \"EPOCHREALTIME\", \"HISTCMD\", \"PIPESTATUS\", \"COLUMNS\", \"LINES\", \"TMUX\", \"TMUX_PANE\", \"LD_PRELOAD\",","+    \"BASH_SUBSHELL\", \"BASHPID\", \"COMP_WORDBREAKS\",","+}","+","+","+def _parse_shell(lines):","+    \"\"\"Split fingerprint shell lines (pwd/umask/set/shopt/declare/alias/functions/jobs/dirs/traps).\"\"\"","+    out = {\"pwd\": None, \"umask\": None, \"set\": [], \"shopt\": [], \"declare\": [], \"alias\": [],","+           \"functions\": [], \"jobs\": [], \"dirs\": [], \"traps\": []}","+    i, n = 0, len(lines)","+","+    def peek():","+        return lines[i] if i < n else None","+","+    if peek() is not None and peek().startswith(\"pwd \"):","+        out[\"pwd\"] = peek()[4:]","+        i += 1","+    if peek() is not None and re.fullmatch(r\"[0-7]{3,4}\", peek().strip()):","+        out[\"umask\"] = peek().strip()","+        i += 1","+    while peek() is not None and (peek().startswith(\"set -o \") or peek().startswith(\"set +o \")):","+        out[\"set\"].append(peek())","+        i += 1","+    while peek() is not None and peek().startswith(\"shopt \"):","+        out[\"shopt\"].append(peek())","+        i += 1","+    while peek() is not None and peek().startswith(\"declare \"):","+        out[\"declare\"].append(peek())","+        i += 1","+    while peek() is not None and peek().startswith(\"alias \"):","+        out[\"alias\"].append(peek())","+        i += 1","+    while peek() is not None and re.match(r\"^.+ \\(\\) $\", peek()):","+        block = [peek()]","+        i += 1","+        while peek() is not None:","+            block.append(peek())","+            i += 1","+            if block[-1] == \"}\":","+                break","+        out[\"functions\"].append(block)","+    while peek() is not None and re.match(r\"^\\[\\d+\\]\", peek()):","+        out[\"jobs\"].append(peek())","+        i += 1","+    while peek() is not None and not peek().startswith(\"trap \"):","+        out[\"dirs\"].append(peek())","+        i += 1","+    while peek() is not None:","+        out[\"traps\"].append(peek())","+        i += 1","+    return out","+","+","+def _shell_transplant(sb, exp, cur):","+    script = []","+    if exp[\"umask\"]:","+        script.append(f\"umask {exp['umask']}\")","+    script += exp[\"set\"] + exp[\"shopt\"]","+    for line in exp[\"declare\"]:","+        m = _DECL_RE.match(line)","+        if not m or m.group(2) in _SKIP_DECLARE or m.group(2).startswith(\"__sbx\"):","+            continue","+        script.append(line)","+    script += exp[\"alias\"]","+    for block in exp[\"functions\"]:","+        if block and block[0].startswith(\"__sbx_state\"):","+            continue","+        script += block","+    script += exp[\"traps\"]","+    r = sb.exec(\"cat > /run/sbx-transplant.sh\", stdin=\"\\n\".join(script) + \"\\n\")","+    if r.get(\"rc\") != 0:","+        return","+    sb.keys(\" source /run/sbx-transplant.sh\\n\")","+    time.sleep(0.4)","+    dirs = exp[\"dirs\"]","+    if dirs and dirs != cur.get(\"dirs\"):","+        parts = [f\"cd -- {shlex.quote(dirs[-1])}\"]","+        for d in reversed(dirs[:-1]):","+            parts.append(f\"pushd -- {shlex.quote(d)} >/dev/null\")","+        sb.keys(\" \" + \" && \".join(parts) + \"\\n\")","+        time.sleep(0.3)","+    elif exp[\"pwd\"] and exp[\"pwd\"] != cur.get(\"pwd\"):","+        sb.keys(f\" cd -- {shlex.quote(exp['pwd'])}\\n\")","+        time.sleep(0.3)","+    # OLDPWD is history, not a consequence of the stack built above; set it explicitly.","+    old = next((ln for ln in exp[\"declare\"] if (_DECL_RE.match(ln) and _DECL_RE.match(ln).group(2) == \"OLDPWD\")), None)","+    if old:","+        m = _DECL_RE.match(old)","+        if m.group(3):","+            sb.keys(f\" OLDPWD={m.group(4)}\\n\")","+        elif \"x\" in m.group(1):","+            sb.keys(\" unset OLDPWD; export OLDPWD\\n\")","+        time.sleep(0.2)","+","+","+def _jobs_transplant(sb, exp):","+    for line in exp[\"jobs\"]:","+        m = re.match(r\"^\\[\\d+\\][+-]?\\s+(Running|Stopped)\\s+(.*)$\", line)","+        if not m or m.group(1) != \"Running\":","+            continue","+        cmd = m.group(2).strip()","+        if not cmd.endswith(\"&\"):","+            cmd += \" &\"","+        sb.keys(cmd + \"\\n\")","+        time.sleep(0.5)","+","+","+_REPL_RESTORE = r\"\"\"","+def __restore():","+    import ast, builtins, importlib, json, re as _re","+    def dec(v, depth=0):","+        if isinstance(v, list):","+            return [dec(x, depth + 1) for x in v]","+        if isinstance(v, str):","+            if depth > 4:","+                kinds = {\"list\": [], \"dict\": {}, \"set\": set(), \"tuple\": (), \"str\": \"\", \"int\": 0,","+                         \"float\": 0.0, \"bool\": False, \"bytes\": b\"\", \"NoneType\": None}","+                if v in kinds:","+                    return kinds[v]","+                return type(v.split(\".\")[-1], (), {})()","+            if v.startswith(\"module:\"):","+                return importlib.import_module(v[7:])","+            if v.startswith(\"callable:\") or v.startswith(\"object:\"):","+                raise ValueError(v)","+            return ast.literal_eval(v)","+        raise ValueError(repr(v))","+    data = json.loads(__DATA__)","+    g = globals()","+    for k2, v2 in data.items():","+        g[k2] = dec(v2)","+__restore()","+del __restore","+\"\"\"","+","+","+def _repl_transplant(sb, exp_detail):","+    repl = exp_detail.get(\"repl\") or []","+    if len(repl) != 1:","+        return","+    procs = exp_detail.get(\"processes\") or []","+    cmds = [ln.split(\"\\t\", 1)[1] for ln in procs if \"\\t\" in ln]","+    cand = [c for c in cmds if c == \"python3\" or c == \"python3 -i\" or c.startswith(\"python3 -i \")]","+    if not cand:","+        return","+    code = _REPL_RESTORE.replace(\"__DATA__\", repr(repl[0]))","+    r = sb.exec(\"cat > /run/sbx-repl.py\", stdin=code)","+    if r.get(\"rc\") != 0:","+        return","+    sb.keys(cand[0] + \"\\n\")","+    time.sleep(0.7)","+    sb.keys(\"exec(open('/run/sbx-repl.py').read())\\n\")","+    time.sleep(0.7)","+","+","+def _transplant(sb, exp_detail, cur_detail):","+    try:","+        exp_shell = _parse_shell(exp_detail.get(\"shell\") or [])","+        cur_shell = _parse_shell(cur_detail.get(\"shell\") or [])","+        if (exp_detail.get(\"shell\") or []) != (cur_detail.get(\"shell\") or []):","+            _shell_transplant(sb, exp_shell, cur_shell)","+        if (exp_detail.get(\"processes\") or []) != (cur_detail.get(\"processes\") or []) and exp_shell[\"jobs\"]:","+            _jobs_transplant(sb, exp_shell)","+        if exp_detail.get(\"repl\"):","+            _repl_transplant(sb, exp_detail)","+        time.sleep(0.3)","+    except Exception:  # noqa: BLE001 - the fingerprint re-check decides","+        pass","+","+","+"],"newLines":179,"newStart":482,"oldLines":3,"oldStart":482}],"path":"/app/branching/reset.py"}]}