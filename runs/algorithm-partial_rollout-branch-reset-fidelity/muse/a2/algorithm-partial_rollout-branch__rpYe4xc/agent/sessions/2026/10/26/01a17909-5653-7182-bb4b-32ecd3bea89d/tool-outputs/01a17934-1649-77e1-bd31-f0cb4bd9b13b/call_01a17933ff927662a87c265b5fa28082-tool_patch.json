{"files":[{"hunks":[{"lines":["+import json, sys, time","+sys.path.insert(0,\"/app\")","+import sbx","+from branching import reset as R","+","+def debug(name,k):","+    traj=json.load(open(f\"/app/buffer/{name}.json\"))","+    info=R._info(traj[\"env\"])","+    sample=R._scratch_sample(traj,k,info,want_tar=True)","+    expected=R._expected_of(sample)","+    snap=sample[\"sb\"].snapshot(); sample[\"sb\"].terminate()","+    sb=R._create(traj, tenant=traj[\"tenant\"], at_time=R._step_time(traj,k), snapshot=snap)","+    sbx.drop_snapshot(snap)","+    st=R._capture_state(sb,info)","+    print(f\"\\n=== {name} before transplant diffs:\", [s for s in st['fp'] if st['fp'][s]!=expected['fp'][s]])","+    R._transplant(sb, expected[\"detail\"], st[\"detail\"])","+    st2=R._capture_state(sb,info)","+    print(\"screen now:\\n\", sb.capture())","+    for sec in st2[\"fp\"]:","+        if st2[\"fp\"][sec]!=expected[\"fp\"][sec]:","+            print(f\"-- DIFF {sec}\")","+            a=list(expected[\"detail\"][sec]); b=list(st2[\"detail\"][sec])","+            sa,sbset=set(a),set(b)","+            for l in a:","+                if l not in sbset: print(\"  EXP>\",repr(l))","+            for l in b:","+                if l not in sa: print(\"  GOT>\",repr(l))","+            if sa==sbset: print(\"  (same set, order differs)\")","+    sb.terminate()","+","+debug(\"notes-api/shell-setup\",7)","+debug(\"build-farm/bg-services\",4)","+print(sbx.list_sandboxes())"],"newLines":33,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/debug_transplant.py"}]}