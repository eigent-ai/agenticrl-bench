{"files":[{"hunks":[{"lines":["         pass"," "," ","+def _svc_by_name(info, name):","+    return next((s for s in _services(info) if s.get(\"name\") == name), None)","+","+","+def _read_probes(sb, info, reads):","+    out = {}","+    for name, path in reads:","+        svc = _svc_by_name(info, name)","+        if svc is None:","+            continue","+        out[(name, path)] = _http(sb, \"GET\", svc.get(\"host\"), svc.get(\"port\"), path)","+    return out","+","+","+def _deliver_snapshot(traj, k, info, expected, entry, sample, full):","+    \"\"\"Delivery when the tenant cannot be taken back to its initial state but is already in the","+    step-k state: verified scratch files via snapshot on the real tenant, then transplants.\"\"\"","+    if sample is None:","+        sample = _scratch_sample(traj, k, info, want_tar=True)","+        if not _state_matches(sample, expected):","+            _terminate(sample[\"sb\"])","+            _fail(\"scratch replay does not match cached state\")","+    else:","+        second = _scratch_sample(traj, k, info)","+        try:","+            if not _state_matches(second, expected):","+                _fail(\"scratch replays diverge\")","+        finally:","+            _terminate(second.get(\"sb\"))","+    snap = None","+    sb = None","+    try:","+        # Read-probe responses at step k, from the scratch tenant, before it goes away.","+        reads = set(full.get(\"reads\") or [])","+        nonadmin = {s[\"name\"] for s in _services(info) if not s.get(\"admin\")}","+        for name, req in sample.get(\"egress\") or []:","+            method, path = _parse_request(req)","+            if name in nonadmin and method == \"GET\" and path and not path.startswith(\"/_admin/\"):","+                reads.add((name, path))","+        probes_exp = _read_probes(sample[\"sb\"], info, sorted(reads))","+        voltars = dict(sample.get(\"voltars\") or expected.get(\"voltars\") or {})","+        if _mounts(info) and len(voltars) < le