{"files":[{"hunks":[{"lines":["         deadline = float(turns[i + 1][\"sent_at\"]) if i + 1 < n else float(traj[\"ended_at\"])","         expected = _norm_obs(turn.get(\"observation\", \"\"))","         ok = False","+        grace_deadline = None","         while True:","-            if _norm_obs(sb.capture()) == expected:","+            got = _norm_obs(sb.capture())","+            if got == expected:","                 ok = True","                 break","-            if timeline.now() >= deadline - 0.005:","-                break","+            now = timeline.now()","+            if now >= deadline - 0.005:","+                # Under load a turn's command may simply not have finished","+                # by the next turn's send time. If the screen still looks","+                # unfinished, wait a bounded grace for it to reach the","+                # recorded screen instead of typing into a running command","+                # (which echoes queued input into the scrollback).","+                last = got.splitlines()[-1:] ","+                exp_last = expected.splitlines()[-1:]","+                unfinished = expected.startswith(got) or last != exp_last","+                if not unfinished:","+                    break","+                if grace_deadline is None:","+                    extra = max(2.0, min(10.0, 4.0 * float(turn.get(\"duration\") or 0.5)))","+                    grace_deadline = now + extra","+                if now >= grace_deadline:","+                    break","             time.sleep(0.015)","         if not ok:","             replay.obs_ok = False"],"newLines":29,"newStart":229,"oldLines":12,"oldStart":229}],"path":"/app/branching/reset.py"}]}