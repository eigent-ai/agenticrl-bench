{"files":[{"hunks":[{"lines":["+import sys, json, time","+sys.path.insert(0,'/app')","+import sbx","+from branching.reset import reset, NotResettable","+","+def load(p): return json.load(open(p))","+","+def call(traj,k,label):","+    t0=time.time()","+    try:","+        sid=reset(traj,k); sb=sbx.attach(sid); fp=sb.fingerprint()['fingerprint']; sb.terminate()","+        print(f\"{label}: OK sid={sid} [{time.time()-t0:.1f}s] fp={fp['files'][:8]}\", flush=True)","+        return fp","+    except NotResettable as e:","+        print(f\"{label}: NotResettable {e} [{time.time()-t0:.1f}s]\", flush=True)","+","+# repeats in same process (cache paths), incl tenant moves to k2 then larger k, then back","+adj=load('/app/buffer/inventory-sync/adjust.json')","+call(adj,2,'adjust k2 first')","+call(adj,2,'adjust k2 repeat (cache)')","+call(adj,5,'adjust k5 after k2 (journal was truncated)')","+call(adj,1,'adjust k1 after k5')","+call(adj,5,'adjust k5 restore end')","+","+com=load('/app/buffer/ticket-triage/comment-early.json')","+call(com,5,'comment k5 first')","+call(com,5,'comment k5 repeat (cached snapshot)')","+","+push=load('/app/buffer/team-share/push-late.json')","+call(push,2,'push k2')","+call(push,5,'push k5 restore end')","+","+notes=load('/app/buffer/notes-api/shell-setup.json')","+call(notes,7,'shell k7 first')","+call(notes,7,'shell k7 repeat')","+print('leaks', sbx.list_sandboxes())"],"newLines":36,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_repeat_concurrency.py"}]}