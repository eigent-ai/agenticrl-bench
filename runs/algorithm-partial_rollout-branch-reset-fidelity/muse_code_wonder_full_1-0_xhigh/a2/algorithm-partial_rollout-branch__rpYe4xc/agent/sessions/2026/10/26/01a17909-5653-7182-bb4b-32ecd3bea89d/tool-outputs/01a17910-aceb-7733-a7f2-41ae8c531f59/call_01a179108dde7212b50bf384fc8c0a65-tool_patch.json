{"files":[{"hunks":[{"lines":["+import json, sys, time, re, glob","+sys.path.insert(0,\"/tmp\")","+from replaylib import replay, norm","+from concurrent.futures import ThreadPoolExecutor","+","+def norm_pid(s):","+    s = norm(s)","+    s = re.sub(r\"(?m)^(\\[\\d+\\][+-]?)\\s+\\d+$\", r\"\\1 PID\", s)","+    return s","+","+def one(path):","+    traj=json.load(open(path))","+    k=len(traj[\"turns\"])","+    name=traj[\"traj_id\"]","+    results=[]","+    for r in range(2):","+        try:","+            sb, screens = replay(traj, k)","+            fp=sb.fingerprint()[\"fingerprint\"]","+            eg=[e[\"request\"] for e in sb.egress()]","+            scr=[norm_pid(screens[i])==norm_pid(traj[\"turns\"][i][\"observation\"]) for i in range(k)]","+            scr_raw=[norm(screens[i])==norm(traj[\"turns\"][i][\"observation\"]) for i in range(k)]","+            # volume/admin extras: fingerprint detail not needed","+            results.append(dict(fp=fp, eg=eg, scr=scr, raw=scr_raw, tenant=sb.tenant, screens=screens))","+            sb.terminate()","+        except Exception as e:","+            results.append(dict(error=repr(e)))","+    if \"error\" in results[0] or \"error\" in results[1]:","+        print(f\"{name} ERROR {results}\", flush=True); return","+    fpdiff=[key for key in results[0][\"fp\"] if results[0][\"fp\"][key]!=results[1][\"fp\"][key]]","+    scr_each=[ (results[0][\"scr\"][i], results[1][\"scr\"][i]) for i in range(k)]","+    # first screen mismatch turn (normalized)","+    first_bad = next((i for i in range(k) if not (results[0][\"scr\"][i] and results[1][\"scr\"][i])), None)","+    # screens replay vs replay","+    rr=[norm_pid(results[0][\"screens\"][i])==norm_pid(results[1][\"screens\"][i]) for i in range(k)]","+    print(f\"{name} k={k} fpdiff={fpdiff} first_bad_screen={first_bad} rr={rr} egress0={results[0]['eg']} egress_eq={results[0]['eg']==results[1]['eg']}\", flush=True)","+    if first_bad is not None:","+        import difflib","+        for line in difflib.unified_diff(norm_pid(traj['turns'][first_bad]['observation']).splitlines(), norm_pid(results[0]['screens'][first_bad]).splitlines(),\"orig\",\"rep0\",lineterm=\"\"):","+            print(\"   \",line, flush=True)","+","+paths=sorted(glob.glob(\"/app/buffer/*/*.json\"))","+with ThreadPoolExecutor(max_workers=5) as ex:","+    list(ex.map(one, paths))","+import sbx; print(sbx.list_sandboxes())"],"newLines":45,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/classify1.py"}]}