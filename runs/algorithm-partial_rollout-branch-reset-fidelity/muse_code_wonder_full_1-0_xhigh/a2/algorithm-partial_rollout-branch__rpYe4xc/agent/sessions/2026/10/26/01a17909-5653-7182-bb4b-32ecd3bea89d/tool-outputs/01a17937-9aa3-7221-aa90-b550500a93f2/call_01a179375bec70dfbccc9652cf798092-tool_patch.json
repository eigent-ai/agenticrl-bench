{"files":[{"hunks":[{"lines":["             and state.get(\"egress\") == expected.get(\"egress\"))"," "," ","+# --------------------------------------------------------------- observed-randomness salvage","+_TOKEN_RE = re.compile(r\"[A-Za-z0-9][A-Za-z0-9_+\\-./=]{5,}\")","+_FILE_LINE_RE = re.compile(r\"^(f|sqlite) (.+) ([0-7]+) (\\d+:\\d+) ([0-9a-f]{64})$\")","+_PATCH_SCRIPT = r\"\"\"","+import json, os, sys","+pairs = json.loads(os.environ[\"PATCH_MAP\"])","+total = 0","+for path in json.loads(os.environ[\"PATCH_FILES\"]):","+    try:","+        with open(path, \"rb\") as f:","+            data = f.read()","+    except OSError:","+        continue","+    orig = data","+    for a, b in pairs.items():","+        total += data.count(a.encode())","+        data = data.replace(a.encode(), b.encode())","+    if data != orig:","+        with open(path, \"wb\") as f:","+            f.write(data)","+print(total)","+\"\"\"","+","+","+def _token_pairs(traj, screens, upto):","+    \"\"\"If replay screens differ from the recordings only by consistent token substitutions","+    (e.g. a generated key that the rollout itself printed), return {replay_token: original_token}.\"\"\"","+    mapping, used = {}, {}","+    turns = traj.get(\"turns\") or []","+    for i in range(upto):","+        obs = turns[i].get(\"observation\")","+        if obs is None:","+            return None","+        orig = _norm_screen(obs).split(\"\\n\")","+        rep = _norm_screen(screens[i]).split(\"\\n\")","+        if orig == rep:","+            continue","+        if len(orig) != len(rep):","+            return None","+        for lo, lr in zip(orig, rep):","+            if lo == lr:","+                continue","+            if _TOKEN_RE.split(lo) != _TOKEN_RE.split(lr):","+                return None","+            for tok_rep, tok_orig in zip(_TOKEN_RE.findall(lr), _TOKEN_RE.findall(lo)):","+                if tok_rep == tok_orig:","+                    continue","+                if not (any(c.isalpha() for c in tok_rep) and any(c.isdigit() for c in tok_rep)","+                        and any(c.isalpha() for c in tok_orig) and any(c.isdigit() for c in tok_orig)):","+                    return None","+                if mapping.get(tok_rep, tok_orig) != tok_orig or used.get(tok_orig, tok_rep) != tok_rep:","+                    return None","+                mapping[tok_rep] = tok_orig","+                used[tok_orig] = tok_rep","+    return mapping or None","+","+","+def _differing_files(detail_a, detail_b):","+    \"\"\"Paths whose content hash differs between two samples, or None if the file trees differ","+    in any other way (names, modes, kinds), which a content patch cannot reconcile.\"\"\"","+    def parse(detail):","+        files, other = {}, set()","+        for line in (detail or {}).get(\"files\") or []:","+            m = _FILE_LINE_RE.match(line)","+            if m:","+                files[m.group(2)] = (m.group(1), m.group(3), m.group(4), m.group(5))","+            else:","+                other.add(line)","+        return files, other","+","+    fa, oa = parse(detail_a)","+    fb, ob = parse(detail_b)","+    if oa != ob or set(fa) != set(fb):","+        return None","+    diff = []","+    for path in fa:","+        if fa[path] != fb[path]:","+            if fa[path][:3] != fb[path][:3]:","+                return None","+            diff.append(path)","+    return diff","+","+","+def _apply_patch(sb, mapping, files):","+    r = sb.exec([\"python3\", \"-c\", _PATCH_SCRIPT],","+                env={\"PATCH_MAP\": json.dumps(mapping), \"PATCH_FILES\": json.dumps(files)}, timeout=120)","+    if r.get(\"rc\") != 0:","+        _fail(\"patch failed\")","+    try:","+        return int((r.get(\"stdout\") or \"0\").strip())","+    except ValueError:","+        _fail(\"patch garbled\")","+","+","+def _patched_expected(traj, k, info, entry, want_tar):","+    \"\"\"Two scratch replays whose only divergence is file contents carrying tokens that the","+    recorded screens reveal; patch both to the recorded tokens and require full convergence.\"\"\"","+    samples = []","+    try:","+        for idx in range(2):","+            want_initial = idx == 0 and bool(_mounts(info)) and not entry.get(\"initial_vol\")","+            state = _scratch_sample(traj, k, info, want_tar=want_tar,","+                                     want_initial=want_initial, strict_screens=False)","+            samples.append(state)","+            if state.get(\"initial\"):","+                with _LOCK:","+                    entry[\"initial_vol\"] = state[\"initial\"]","+        a, b = samples","+        if {s for s in a[\"fp\"] if a[\"fp\"][s] != b[\"fp\"][s]} - {\"files\"}:","+            _fail(\"divergence outside file contents\")","+        if a[\"journals\"] != b[\"journals\"] or a[\"volhash\"] != b[\"volhash\"] or a[\"egress\"] != b[\"egress\"]:","+            _fail(\"external divergence\")","+        pairs = []","+        for state in samples:","+            p = _token_pairs(traj, state[\"screens\"], k)","+            if not p:","+                _fail(\"screens do not reveal the divergent values\")","+            pairs.append(p)","+        if set(pairs[0].values()) != set(pairs[1].values()):","+            _fail(\"inconsistent observed tokens\")","+        files = _differing_files(a[\"detail\"], b[\"detail\"])","+        if not files:","+            _fail(\"no patchable file divergence\")","+        patched = []","+        for state, p in zip(samples, pairs):","+            if _apply_patch(state[\"sb\"], p, files) == 0:","+                _fail(\"observed tokens not found in divergent files\")","+            patched.append(_capture_state(state[\"sb\"], info, want_tar=want_tar))","+        if not _state_matches(patched[1], patched[0]):","+            _fail(\"patched replays still diverge\")","+        expected = _expected_of(patched[0])","+        expected[\"_patch_files\"] = files","+        expected[\"_orig_tokens\"] = sorted(set(pair