{"files":[{"hunks":[{"lines":["+import json, glob, sys, time","+sys.path.insert(0, \"/app\")","+from concurrent.futures import ThreadPoolExecutor","+import sbx","+from branching.reset import reset, NotResettable","+","+REFUSE_FROM = {  # first k that must refuse (accept below it), per design analysis","+    \"config-lint/scratch-copy\": 1,","+    \"data-repl/api-key\": 2,","+    \"data-repl/repl-sample\": 3,","+    \"ledger-cli/stamped\": 2,","+}","+ACCEPT_ONLY = {\"ticket-triage/comment-early\": {5}}","+","+def expected_ok(name, k, n):","+    if name in ACCEPT_ONLY:","+        return k in ACCEPT_ONLY[name]","+    if name in REFUSE_FROM:","+        return k < REFUSE_FROM[name]","+    return True","+","+def run_traj(path):","+    traj = json.load(open(path))","+    name = traj[\"traj_id\"]; n = len(traj[\"turns\"])","+    out = []","+    for k in range(n + 1):","+        t0 = time.time()","+        try:","+            sid = reset(traj, k)","+            got, msg = True, \"\"","+            sb = sbx.attach(sid)","+            lst = {s[\"id\"]: s for s in sbx.list_sandboxes()[\"sandboxes\"]}","+            tchk = lst.get(sid, {}).get(\"tenant\") == traj[\"tenant\"]","+            sb.terminate()","+            if not tchk:","+                msg = \"TENANT MISMATCH\"","+        except NotResettable as e:","+            got, msg, sid = False, str(e)[:90], None","+        except Exception as e:","+            got, msg, sid = \"ERR\", repr(e)[:120], None","+        exp = expected_ok(name, k, n)","+        status = \"OK \" if got == exp and not msg.startswith((\"TENANT\",)) else (\"OK \" if got == exp else \"*** MISMATCH\")","+        if got == \"ERR\": status = \"*** ERROR\"","+        line = f\"{status} {name} k={k} expected_ok={exp} got={got} dt={time.time()-t0:.1f}s {msg}\"","+        out.append(line); print(line, flush=True)","+    return out","+","+paths = sorted(glob.glob(\"/app/buffer/*/*.json\"))","+with ThreadPoolExecutor(max_workers=4) as ex:","+    results = list(ex.map(run_traj, paths))","+allines = [l for r in results for l in r]","+bad = [l for l in allines if l.startswith(\"***\")]","+print(f\"\\nTOTAL {len(allines)} cases, mismatches {len(bad)}\")","+for l in bad: print(l)","+print(\"sandboxes:\", sbx.list_sandboxes())"],"newLines":55,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/integration1.py"}]}