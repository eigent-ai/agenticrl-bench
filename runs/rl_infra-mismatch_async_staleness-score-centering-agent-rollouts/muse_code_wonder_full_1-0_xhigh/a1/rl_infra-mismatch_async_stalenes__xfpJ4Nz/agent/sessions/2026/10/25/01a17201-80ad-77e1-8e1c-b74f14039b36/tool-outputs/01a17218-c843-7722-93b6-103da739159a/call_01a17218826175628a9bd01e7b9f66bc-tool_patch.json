{"files":[{"hunks":[{"lines":["+\"\"\"Recording sampler top-k candidates: raw for unbounded sampling, support-renormalised when bounded.\"\"\"","+","+import math","+","+import pytest","+import torch","+","+from miles.rollout.generate_utils.top_logprobs import (","+    append_forced_top_logprobs,","+    append_top_logprobs,","+    merge_top_logprobs,","+)","+from miles.rollout.session.samples.codec import (","+    COMPUTED_FIELDS,","+    ROLLOUT_TOP_LOGPROBS_FIELDS,","+    decode_samples_and_merge_input_sample,","+    encode_samples,","+)","+from miles.utils.top_logprobs import RolloutTopLogprobs","+from miles.utils.types import Sample","+","+","+def _meta(top_rows, supports=None):","+    meta = {\"output_top_logprobs\": [[[lp, tid, None] for lp, tid in row] for row in top_rows]}","+    if supports is not None:","+        meta[\"output_token_sampling_mask\"] = supports","+    return meta","+","+","+def test_append_unbounded_records_raw_candidates():","+    sample = Sample()","+    append_top_logprobs(","+        sample,","+        [7],","+        _meta([[(-0.5, 7), (-1.5, 3)]]),","+        raw_log_probs=[-0.5],","+        sampling_log_probs=None,","+        expected_num=2,","+    )","+    ids, log_probs, offsets = sample.rollout_top_logprobs._as_tensors()","+    assert ids.tolist() == [7, 3]","+    assert log_probs.tolist() == pytest.approx([-0.5, -1.5])","+    assert offsets.tolist() == [0, 2]","+","+","+def test_append_bounded_renormalises_onto_support():","+    sample = Sample()","+    # Raw head of 3, support {7, 3}; sampled token 7: raw -0.5, truncated -0.25 (shift +0.25).","+    append_top_logprobs(","+        sample,","+        [7],","+        _meta([[(-0.5, 7), (-1.0, 9), (-1.5, 3)]], supports=[[7, 3]]),","+        raw_log_probs=[-0.5],","+        sampling_log_probs=[-0.25],","+        expected_num=3,","+    )","+    ids, log_probs, _ = sample.rollout_top_logprobs._as_tensors()","+    assert ids.tolist() == [7, 3]  # candidate 9 is outside the support: dropped","+    assert log_probs.tolist() == pytest.approx([-0.25, -1.25])","+    # The sampled candidate now matches the recorded rollout log-prob exactly.","+    assert math.exp(log_probs[0]) == pytest.approx(math.exp(-0.25))","+","+","+def test_append_requires_requested_head_size_and_presence():","+    sample = Sample()","+    with pytest.raises(ValueError, match=\"missing output_top_logprobs\"):","+        append_top_logprobs(sample, [7], {}, raw_log_probs=[-0.5], sampling_log_probs=None, expected_num=2)","+    with pytest.raises(ValueError, match=\"expected 2\"):","+        append_top_logprobs(","+            sample, [7], _meta([[(-0.5, 7)]]), raw_log_probs=[-0.5], sampling_log_probs=None, expected_num=2","+        )","+","+","+def test_forced_rows_and_merge():","+    first, second = Sample(), Sample()","+    first.rollout_top_logprobs = RolloutTopLogprobs.from_entries([[(-0.5, 7)]])","+    first.response_length = 1","+    append_forced_top_logprobs(first, 2)","+    assert len(first.rollout_top_logprobs) == 3","+    second.rollout_top_logprobs = RolloutTopLogprobs.from_entries([[(-0.25, 3), (-2.0, 4)]])","+    second.response_length = 1","+    merged = merge_top_logprobs(first, 1, second)","+    ids, _, offsets = merged._as_tensors()","+    assert len(merged) == 5","+    assert ids.tolist() == [7, 3, 4]","+    assert offsets.tolist() == [0, 1, 1, 1, 1, 3]","+    with pytest.raises(ValueError, match=\"both turns\"):","+        merge_top_logprobs(first, 0, Sample())","+","+","+def test_strip_last_output_tokens_trims_heads():","+    class _Tok:","+        def decode(self, tokens):","+            return \"\"","+","+    sample = Sample()","+    sample.tokens = [1, 2, 3, 4]","+    sample.response_length = 2","+    sample.rollout_log_probs = [-0.5, -0.6]","+    sample.loss_mask = [1, 1]","+    sample.rollout_top_logprobs = RolloutTopLogprobs.from_entries([[(-0.5, 3)], [(-0.6, 4)]])","+    sample.strip_last_output_tokens(1, _Tok())","+    assert len(sample.rollout_top_logprobs) == 1","+    sample.validate()","+","+","+def test_session_codec_roundtrip():","+    sample = Sample()","+    sample.tokens = [1, 2, 3]","+    sample.response = \"x\"","+    sample.response_length = 1","+    sample.loss_mask = [1]","+    sample.rollout_log_probs = [-0.5]","+    sample.rollout_top_logprobs = RolloutTopLogprobs.from_entries([[(-0.5, 3), (-1.5, 2)]])","+    sample.status = Sample.Status.COMPLETED","+    fields = COMPUTED_FIELDS + ROLLOUT_TOP_LOGPROBS_FIELDS","+    payload = encode_samples([sample], {}, fields=fields)","+    reply = decode_samples_and_merge_input_sample(payload, Sample(), fields=fields)","+    (decoded,) = reply.samples","+    ids, log_probs, offsets = decoded.rollout_top_logprobs._as_tensors()","+    assert ids.tolist() == [3, 2]","+    assert log_probs.tolist() == pytest.approx([-0.5, -1.5])","+    assert offsets.tolist() == [0, 2]","+    assert torch.equal(ids, torch.tensor([3, 2], dtype=torch.int32))"],"newLines":124,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/tests/fast/rollout/generate_utils/test_top_logprobs.py"}]}