{"files":[{"hunks":[{"lines":["         if temperature != 1.0:","             ext_logits = ext_logits / temperature","         return ext_logits - lse.unsqueeze(-1), lse","+","+","+class _WeightedLogProbSum(torch.autograd.Function):","+    \"\"\"``sum_u d_u log p_u`` per row, with a chunk-wise recomputed backward.","+","+    Forward reuses the detached log-probs computed for the coefficients.","+    Backward uses ``d (sum_u d_u log p_u) / d logit_j = d_j - D p_j`` on the","+    scoring universe (full vocabulary, or the recorded support), scaled by","+    ``1 / temperature`` for the unscaled logits. Only the local TP shard's","+    gradient is produced, on the rank that owns it.","+    \"\"\"","+","+    @staticmethod","+    def forward(ctx, logits, ext_ids, coeffs, log_probs_ext, lse, support_ids, support_offsets,","+                vocab_start, temperature, row_chunk):","+        ctx.save_for_backward(logits, ext_ids, coeffs, lse, support_ids, support_offsets)","+        ctx.vocab_start = vocab_start","+        ctx.temperature = temperature","+        ctx.row_chunk = row_chunk","+        return (coeffs * log_probs_ext).sum(dim=-1)","+","+    @staticmethod","+    def backward(ctx, grad_output):","+        logits, ext_ids, coeffs, lse, support_ids, support_offsets = ctx.saved_tensors","+        temperature = ctx.temperature","+        vocab_start = ctx.vocab_start","+        grad_logits = torch.zeros_like(logits)","+        if logits.size(0) == 0:","+            return grad_logits, None, None, None, None, None, None, None, None, None","+","+        total_coeff = coeffs.sum(dim=-1) * grad_output  # D per row, incl. upstream scale","+        sparse_coeff = coeffs * grad_output.unsqueeze(-1)","+        local_vocab = logits.size(-1)","+","+        if support_offsets.numel() == 0:","+            for start in range(0, logits.size(0), ctx.row_chunk):","+                end = min(start + ctx.row_chunk, logits.size(0))","+                chunk = logits[start:end].to(torch.float32, copy=True)","+                if temperature != 1.0:","+                    chunk.div_(temperature)","+                chunk.sub_(lse[start:end].unsqueeze(-1)).exp_()","+                grad_chunk = chunk.mul_(-total_coeff[start:end].unsqueeze(-1))","+                cols = ext_ids[start:end] - vocab_start","+                is_local = (cols >= 0) & (cols < local_vocab)","+                rows = torch.arange(end - start, device=logits.device).unsqueeze(-1).expand_as(cols)","+                flat_index = (rows * local_vocab + cols.clamp(0, local_vocab - 1))[is_local]","+                grad_chunk.view(-1).index_add_(0, flat_index, sparse_coeff[start:end][is_local])","+                if temperature != 1.0:","+                    grad_chunk.div_(temperature)","+                grad_logits[start:end] = grad_chunk.to(logits.dtype)","+        else:","+            rows = _support_row_indices(support_offsets, device=logits.device)","+            cols = support_ids - vocab_start","+            is_local = (cols >= 0) & (cols < local_vocab)","+            local_rows, local_cols = rows[is_local], cols[is_local]","+            probs = torch.exp(logits[local_rows, local_cols].float() / temperature - lse[local_rows])","+            support_grad = -total_coeff[local_rows] * probs / temperature","+            grad_logits.view(-1).index_add_(","+                0, local_rows * local_vocab + local_cols, support_grad.to(logits.dtype)","+            )","+            ext_cols = ext_ids - vocab_start","+            ext_local = (ext_cols >= 0) & (ext_cols < local_vocab)","+            ext_rows = torch.arange(logits.size(0), device=logits.device).unsqueeze(-1).expand_as(ext_cols)","+            flat_index = (ext_rows * local_vocab + ext_cols.clamp(0, local_vocab - 1))[ext_local]","+            grad_logits.view(-1).index_add_(","+                0, flat_index, (sparse_coeff[ext_local] / temperature).to(logits.dtype)","+            )","+        return grad_logits, None, None, None, None, None, None, None, None, None","+","+","+def _pad_candidates(","+    top: RolloutTopLogprobs, response_indices, *, device","+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:","+    \"\"\"Dense ``[rows, K]`` candidate ids / log-probs / validity for local rows.\"\"\"","+    ids, log_probs, lengths = top._select_entries(response_indices)","+    rows = len(response_indices)","+    max_k = int(lengths.max().item()) if rows and lengths.numel() else 0","+    if max_k == 0:","+        return (","+            torch.zeros(rows, 0, dtype=torch.long, device=device),","+            torch.zeros(rows, 0, dtype=torch.float32, device=device),","+            torch.zeros(rows, 0, dtype=torch.bool, device=device),","+        )","+    offsets = torch.zeros(rows + 1, dtype=torch.long)","+    torch.cumsum(lengths, dim=0, out=offsets[1:])","+    cols = torch.arange(max_k).unsqueeze(0)","+    valid = cols < lengths.unsqueeze(1)","+    flat_index = (offsets[:-1].unsqueeze(1) + cols).clamp(max=ids.numel() - 1)","+    padded_ids = torch.where(valid, ids[flat_index].long(), torch.zeros(rows, max_k, dtype=torch.long))","+    padded_log_probs = torch.where(valid, log_probs[flat_index].float(), torch.zeros(rows, max_k))","+    return padded_ids.to(device), padded_log_probs.to(device), valid.to(device)","+","+","+def _select_support(mask: RolloutSamplingMask, response_indices, *, device) -> tuple[torch.Tensor, torch.Tensor]:","+    ids, lengths = mask._select_masks(response_indices)","+    offsets = torch.zeros(lengths.numel() + 1, dtype=torch.long, device=device)","+    torch.cumsum(lengths.to(device=device, dtype=torch.long), dim=0, out=offsets[1:])","+    return ids.to(device=device, dtype=torch.long), offsets","+","+","+def _row_chunk(args: Namespace) -> int:","+    chunk_size = int(getattr(args, \"log_probs_chunk_size\", -1) or -1)","+    return min(_DENSE_ROW_CHUNK_CAP, chunk_size) if chunk_size > 0 else _DENSE_ROW_CHUNK_CAP","+","+","+def score_centering_loss_function(","+    args: Namespace,","+    batch: RolloutBatch,","+    logits: torch.Tensor,","+    sum_of_sample_mean: Callable[[torch.Tensor], torch.Tensor],","+) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:","+    \"\"\"Score-centering loss; see the module docstring for the estimator.","+","+    Batch extras beyond the policy loss: ``rollout_log_probs`` (recorded","+    sampler log-prob of the sampled token) and the recorded head in","+    ``rollout_top_logprobs_{ids,log_probs,offsets}``; with sampling-support","+    replay also ``rollout_sampling_mask_{ids,offsets}``.","+    \"\"\"","+    if getattr(args, \"allgather_cp\", False):","+        raise ValueError(\"score centering does not support --allgather-cp\")","+    if batch.get(\"advantages\") is None or batch.get(\"rollout_log_probs\") is None:","+        raise ValueError(\"score centering requires advantages and rollout_log_probs in the batch\")","+","+    parallel_state = get_parallel_state()","+    tp_group = parallel_state.tp.group","+    total_lengths = batch[\"total_lengths\"]","+    response_lengths = batch[\"response_lengths\"]","+    max_seq_lens = batch.get(\"max_seq_lens\", None)","+    temperature = float(args.rollout_temperature)","+    row_chunk = _row_chunk(args)","+","+    tops = get_rollout_top_logprobs(batch)","+    if len(tops) != len(response_lengths):","+        raise ValueError(f\"rollout top log-probs for {len(tops)} samples, expected {len(response_lengths)}\")","+    for i, (top, response_length) in enumerate(zip(tops, response_lengths, strict=True)):","+        if len(top) != response_length:","+            raise ValueError(","+                f\"rollout top log-probs length {len(top)} != response_length {response_length} for sample {i}\"","+            )","+    sampling_masks: list[RolloutSamplingMask | None]","+    if getattr(args, \"use_sampling_support_replay\", False):","+        sampling_masks = list(get_rollout_sampling_masks(batch))","+    else:","+        sampling_masks = [None] * len(response_lengths)","+","+    local_loss_masks = get_local_response_loss_masks(","+        total_lengths, response_lengths, batch[\"loss_masks\"], args.qkv_format, max_seq_lens","+    )","+","+    per_token_losses: list[torch.Tensor] = []","+    metric_rows: dict[str, list[torch.Tensor]] = {\"w_y\": [], \"rho\": [], \"head_q_mass\": [], \"head_p_mass\": []}","+    chunks = _iter_response_chunks(","+        logits,","+        args=args,","+        unconcat_tokens=batch[\"unconcat_tokens\"],","+        total_lengths=total_lengths,","+        response_lengths=response_lengths,","+        max_seq_lens=max_seq_lens,","+        include_response_indices=True,","+    )","+    for i, (logits_chunk, tokens_chunk, response_indices) in enumerate(chunks):","+        rows = tokens_chunk.numel()","+        advantages = batch[\"advantages\"][i].detach().float()","+        rollout_log_q = batch[\"rollout_log_probs\"][i].detach().float()","+        if advantages.numel() != rows or rollout_log_q.numel() != rows:","+            raise ValueError(","+                f\"sample {i}: local rows {rows} != advantages {advantages.numel()} / \"","+                f\"rollout log-probs {rollout_log_q.numel()}\"","+            )","+        if rows == 0:","+            per_token_losses.append(logits.new_zeros(0, dtype=torch.float32))","+            for values in metric_rows.values():","+                values.append(logits.new_zeros(0, dtype=torch.float32))","+            continue","+","+        device = logits_chunk.device","+        vocab_start = parallel_state.tp.rank * logits_chunk.size(-1)","+        cand_ids, cand_log_q, cand_valid = _pad_candidates(tops[i], response_indices, device=device)","+        support_ids = support_offsets = None","+        if sampling_masks[i] is not None:","+            support_ids, support_offsets = _select_support(sampling_masks[i], response_indices, device=device)","+","+        active = local_loss_masks[i].to(device).bool()","+        if active.numel() != rows:","+            raise ValueError(f\"sample {i}: local loss mask length {active.numel()} != local rows {rows}\")","+        if bool(((cand_valid.sum(dim=-1) == 0) & active).any()):","+            raise ValueError(","+                f\"sample {i}: a supervised token has no recorded sampler candidates; \"","+                \"score centering cannot fall back to rescoring\"","+            )","+","+        ext_ids = torch.cat([tokens_chunk.to(device=device, dtype=torch.long).unsqueeze(-1), cand_ids], dim=-1)","+        log_probs_ext, lse = _detached_log_probs_ext(","+            logits_chunk,","+            ext_ids,","+            support_ids=support_ids,","+            support_offsets=support_offsets,","+            vocab_start=vocab_start,","+            temperature=temperature,","+            tp_group=tp_group,","+            row_chunk=row_chunk,","+        )","+        coeffs, row_metrics = compute_score_centering_coefficients(","+            log_probs_ext=log_probs_ext,","+            candidate_log_q=cand_log_q,","+            candidate_valid=cand_valid,","+            rollout_log_q=rollout_log_q.to(device),","+            is_mode=args.score_centering_is,","+            tis_clip=float(args.score_centering_tis_clip),","+            mis_low=float(args.score_centering_mis_low),","+            mis_high=float(args.score_centering_mis_high),","+        )","+        weighted = _WeightedLogProbSum.apply(","+            logits_chunk,","+            ext_ids,","+            coeffs,","+            log_probs_ext,","+            lse,","+            support_ids if support_ids is not None else logits.new_empty(0, dtype=torch.long),","+            support_offsets if support_offsets is not None else logits.new_empty(0, dtype=torch.long),","+            vocab_start,","+            temperature,","+            row_chunk,","+        )","+        clean_advantages = torch.where(","+            active,","+            torch.nan_to_num(advantages.to(device), nan=0.0, posinf=0.0, neginf=0.0),","+            torch.zeros(rows, dtype=torch.float32, device=device),","+        )","+        per_token_losses.append(-clean_advantages * weighted)","+        for key, values in metric_rows.items():","+            values.append(row_metrics[key])","+","+    per_token = torch.cat(per_token_losses, dim=0)","+    loss = sum_of_sample_mean(per_token)","+    if per_token.numel() == 0:","+        loss = loss + 0 * logits.sum(dtype=torch.float32)","+","+    def _reduce_metric(key: str) -> torch.Tensor:","+        values = torch.cat(metric_rows[key], dim=0)","+        if values.numel() == 0:","+            return logits.new_zeros((), dtype=torch.float32)","+        return sum_of_sample_mean(values).detach()","+","+    reported = {","+        \"loss\": loss.clone().detach(),","+        \"pg_loss\": loss.clone().detach(),","+        \"sc_w_y\": _reduce_metric(\"w_y\"),","+        \"sc_rho\": _reduce_metric(\"rho\"),","+        \"sc_head_q_mass\": _reduce_metric(\"head_q_mass\"),","+        \"sc_head_p_mass\": _reduce_metric(\"head_p_mass\"),","+    }","+    return loss, reported","+"],"newLines":257,"newStart":223,"oldLines":3,"oldStart":223}],"path":"/app/miles/miles/backends/training_utils/loss/hub/score_centering.py"}]}