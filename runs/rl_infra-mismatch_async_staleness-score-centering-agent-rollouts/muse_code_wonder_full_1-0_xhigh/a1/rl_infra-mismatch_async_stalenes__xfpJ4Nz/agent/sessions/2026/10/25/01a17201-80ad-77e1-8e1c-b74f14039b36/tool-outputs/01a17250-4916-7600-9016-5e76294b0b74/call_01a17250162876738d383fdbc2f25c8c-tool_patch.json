{"files":[{"hunks":[{"lines":["+import os","+from argparse import Namespace","+","+import torch","+import torch.distributed as dist","+","+os.environ.setdefault(\"MASTER_ADDR\", \"127.0.0.1\")","+os.environ.setdefault(\"MASTER_PORT\", \"29617\")","+torch.cuda.set_device(0)","+dist.init_process_group(\"nccl\", rank=0, world_size=1)","+","+from miles.backends.training_utils.data.context_parallel import get_sum_of_sample_mean","+from miles.backends.training_utils.loss.hub.losses import policy_loss_function","+from miles.backends.training_utils.loss.hub.score_centering import score_centering_loss_function","+from miles.backends.training_utils.parallel import GroupInfo, ParallelState, set_parallel_state","+","+g1 = lambda: GroupInfo(rank=0, size=1, group=dist.group.WORLD)","+set_parallel_state(","+    ParallelState(","+        intra_dp=g1(), intra_dp_cp=g1(), cp=g1(), tp=g1(), pp=g1(), ep=g1(), etp=g1(),","+        indep_dp=g1(), is_pp_last_stage=True,","+    )","+)","+","+V = 248320","+NS, PROMPT, RESP, K = 4, 1024, 1024, 128","+TOT = PROMPT + RESP","+dev = \"cuda\"","+g = torch.Generator(device=\"cpu\").manual_seed(0)","+","+tokens = [torch.randint(0, V, (TOT,), generator=g).to(dev) for _ in range(NS)]","+advantages = [torch.full((RESP,), 0.5, device=dev) for _ in range(NS)]","+rollout_lp = [torch.full((RESP,), -0.3, device=dev) for _ in range(NS)]","+loss_masks = [torch.ones(RESP, device=dev) for _ in range(NS)]","+base_batch = dict(","+    unconcat_tokens=tokens,","+    total_lengths=[TOT] * NS,","+    response_lengths=[RESP] * NS,","+    loss_masks=loss_masks,","+    advantages=advantages,","+    rollout_log_probs=rollout_lp,","+)","+# CSR candidates: K per token","+top_ids = [torch.randint(0, V, (RESP * K,), generator=g, dtype=torch.int32) for _ in range(NS)]","+top_lp = [torch.full((RESP * K,), -4.0) for _ in range(NS)]","+top_off = [torch.arange(0, RESP * K + 1, K, dtype=torch.int64) for _ in range(NS)]","+","+common = dict(","+    qkv_format=\"thd\", rollout_temperature=1.0, allgather_cp=False, true_on_policy_mode=False,","+    log_probs_chunk_size=2048, debug_unified_grad_fused_logprob=False,","+    use_sampling_support_replay=False, calculate_per_token_loss=True,","+    entropy_coef=0.0, observe_training_entropy=False, use_kl_loss=False, kl_loss_coef=0.0,","+    use_unbiased_kl=False, kl_loss_type=\"k1\", dump_details=None,","+    eps_clip=0.2, eps_clip_high=0.2, eps_clip_c=None, use_opsm=False, opsm_delta=0.1,","+    advantage_estimator=\"grpo\", use_tis=False, get_mismatch_metrics=False,","+    custom_pg_loss_reducer_function_path=None, custom_tis_function_path=None,","+    skip_actor_forward_only=False, use_rollout_logprobs=True,","+    score_centering_is=\"mis\", score_centering_tis_clip=2.0,","+    score_centering_mis_low=0.5, score_centering_mis_high=5.0,","+)","+som = get_sum_of_sample_mean([TOT] * NS, [RESP] * NS, loss_masks, True, \"thd\", None)","+","+","+def run(name, fn, args, batch):","+    torch.cuda.empty_cache()","+    torch.cuda.reset_peak_memory_stats()","+    logits = torch.randn(1, NS * TOT, V, dtype=torch.bfloat16, device=dev, requires_grad=True)","+    base = torch.cuda.memory_allocated()","+    loss, _ = fn(args, batch, logits, som)","+    loss.backward()","+    torch.cuda.synchronize()","+    peak = torch.cuda.max_memory_allocated()","+    print(f\"{name}: loss={loss.item():.4f} base={base/2**30:.2f}GiB peak={peak/2**30:.2f}GiB extra={(peak-base)/2**30:.2f}GiB\")","+    del logits, loss","+    torch.cuda.empty_cache()","+    return peak","+","+","+sc_batch = dict(base_batch, rollout_top_logprobs_ids=top_ids, rollout_top_logprobs_log_probs=top_lp,","+                rollout_top_logprobs_offsets=top_off)","+peak_sc = run(\"score_centering\", score_centering_loss_function, Namespace(**common, loss_type=\"score_centering\"), sc_batch)","+peak_ppo = run(\"policy_loss\", policy_loss_function, Namespace(**common, loss_type=\"policy_loss\"), dict(base_batch))","+print(f\"peak diff SC-PPO = {(peak_sc-peak_ppo)/2**30:.2f} GiB\")"],"newLines":83,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/sc_mem_probe.py"}]}