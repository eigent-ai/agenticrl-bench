{"files":[{"hunks":[{"lines":["+import sys","+sys.path.insert(0, \"/app/miles\")","+sys.path.insert(0, \"/root/Megatron-LM\")","+import torch","+from miles.backends.training_utils.loss.hub.score_centering import _ScoreCenteringChunk","+","+def naive(logits, tokens, head_ids, head_logq, sel_logq, mode):","+    logits = logits.clone().detach().requires_grad_(True)","+    logp = torch.log_softmax(logits, dim=-1)","+    with torch.no_grad():","+        p = logp.exp()","+        valid = head_ids >= 0","+        p_head = torch.where(valid, p.gather(1, head_ids.clamp(min=0)), torch.zeros_like(head_logq))","+        q_head = torch.where(valid, head_logq.exp(), torch.zeros_like(head_logq))","+        rho = (1-q_head.sum(-1)).clamp(min=1e-6)/(1-p_head.sum(-1)).clamp(min=1e-6)","+        def f(r):","+            if mode==\"none\": return torch.ones_like(r)","+            if mode==\"tis\": return r.clamp(max=2.0)","+            return torch.where((r>=0.5)&(r<=5.0), r, torch.zeros_like(r))","+        alpha = rho*f(1/rho)","+        w_head = torch.where(valid, f(p_head/q_head.clamp(min=torch.finfo(torch.float32).tiny)), torch.zeros_like(p_head))","+        p_y = p.gather(1, tokens.unsqueeze(1)).squeeze(1)","+        w_y = f(p_y/sel_logq.exp().clamp(min=torch.finfo(torch.float32).tiny))","+        coeff = q_head*w_head - alpha.unsqueeze(-1)*p_head","+    logp_head = torch.where(valid, logp.gather(1, head_ids.clamp(min=0)), torch.zeros_like(head_logq))","+    logp_y = logp.gather(1, tokens.unsqueeze(1)).squeeze(1)","+    base = (coeff*logp_head).sum(-1) - w_y*logp_y","+    return logits, base, logp_y","+","+torch.manual_seed(0)","+for mode in [\"none\",\"tis\",\"mis\"]:","+    R,V,K=7,50,5","+    logits0 = torch.randn(R,V)*2","+    tokens = torch.randint(0,V,(R,))","+    # head: topk of a sampler logits (different)","+    s_logits = logits0 + torch.randn(R,V)*0.7","+    s_logp = torch.log_softmax(s_logits, dim=-1)","+    topv, topi = s_logp.topk(K, dim=-1)","+    head_ids = topi.clone(); head_logq = topv.clone()","+    head_ids[0,3:] = -1; head_logq[0,3:] = 0.0  # padding row","+    sel_logq = s_logp.gather(1, tokens.unsqueeze(1)).squeeze(1)","+    weights = torch.randn(R)","+    l1, base1, logp1 = naive(logits0, tokens, head_ids, head_logq, sel_logq, mode)","+    (base1*weights).sum().backward()","+    chunk_in = logits0.clone().detach().requires_grad_(True)","+    # emulate caller: upcast copy chain: chunk must be a copy whose grad flows to chunk_in","+    chunk = chunk_in.to(torch.float32, copy=True)","+    base2, logp2 = _ScoreCenteringChunk.apply(chunk, tokens, head_ids, head_logq, sel_logq, None, 0, mode, 2.0, 0.5, 5.0)","+    (base2*weights).sum().backward()","+    print(mode, \"base maxdiff\", (base1-base2).abs().max().item(), \"logp maxdiff\", (logp1-logp2).abs().max().item(), \"grad maxdiff\", (l1.grad-chunk_in.grad).abs().max().item())","+    assert torch.allclose(base1, base2, atol=1e-5, rtol=1e-4)","+    assert torch.allclose(logp1, logp2, atol=1e-5, rtol=1e-4)","+    assert torch.allclose(l1.grad, chunk_in.grad, atol=1e-5, rtol=1e-4)","+print(\"OK\")"],"newLines":54,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/test_sc_probe.py"}]}