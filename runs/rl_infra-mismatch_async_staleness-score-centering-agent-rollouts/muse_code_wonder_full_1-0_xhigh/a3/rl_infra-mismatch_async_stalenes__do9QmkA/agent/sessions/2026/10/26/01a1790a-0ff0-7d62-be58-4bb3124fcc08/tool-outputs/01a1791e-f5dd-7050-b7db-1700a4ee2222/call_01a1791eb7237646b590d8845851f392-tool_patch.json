{"files":[{"hunks":[{"lines":["         logp_list.append(logps[0] if len(logps) == 1 else torch.cat(logps, dim=0))"," ","     return {\"sc_losses\": base_list, \"log_probs\": logp_list}","+","+","+def score_centering_loss_function(","+    args: Namespace,","+    batch: RolloutBatch,","+    logits: torch.Tensor,","+    sum_of_sample_mean: Callable[[torch.Tensor], torch.Tensor],","+) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:","+    \"\"\"Score-centering replacement for the PPO policy loss (eq. 12).","+","+    Batch extras beyond `policy_loss_function`'s: `rollout_top_logprob_ids`","+    and `rollout_top_logprobs` (the sampler candidates recorded at generation","+    time, CP-sliced like `rollout_log_probs`), whose sampled-token companion","+    is `rollout_log_probs` itself. Reduction is the dispatcher's","+    `sum_of_sample_mean`, so with `--calculate-per-token-loss` the objective is","+    the token-level mean of the paper (App. B.1) and without it the","+    sample-mean sum, exactly as for the policy loss.","+    \"\"\"","+    if getattr(args, \"entropy_coef\", 0) != 0 or getattr(args, \"observe_training_entropy\", False):","+        raise ValueError(\"score centering does not support an entropy term\")","+    if batch.get(\"rollout_log_probs\") is None:","+        raise ValueError(\"score centering requires rollout_log_probs (the recorded sampled-token log-probs)\")","+    if batch.get(\"rollout_top_logprob_ids\") is None or batch.get(\"rollout_top_logprobs\") is None:","+        raise ValueError(","+            \"score centering requires rollout_top_logprob_ids/rollout_top_logprobs recorded at generation time\"","+        )","+","+    advantages = torch.cat([advantage.detach() for advantage in batch[\"advantages\"]], dim=0)","+    rollout_log_probs = [log_prob.detach() for log_prob in batch[\"rollout_log_probs\"]]","+    rollout_sampling_mask = get_rollout_sampling_masks(batch) if args.use_sampling_support_replay else None","+","+    terms = get_score_centering_terms(","+        logits,","+        args=args,","+        unconcat_tokens=batch[\"unconcat_tokens\"],","+        total_lengths=batch[\"total_lengths\"],","+        response_lengths=batch[\"response_lengths\"],","+        top_logprob_ids=batch[\"rollout_top_logprob_ids\"],","+        top_logprobs=batch[\"rollout_top_logprobs\"],","+        rollout_log_probs=rollout_log_probs,","+        max_seq_lens=batch.get(\"max_seq_lens\", None),","+        rollout_sampling_mask=rollout_sampling_mask,","+    )","+    sc_losses = torch.cat(terms[\"sc_losses\"], dim=0)","+    log_probs = torch.cat(terms[\"log_probs\"], dim=0)","+    old_log_probs = torch.cat(rollout_log_probs, dim=0).to(device=log_probs.device, dtype=torch.float32)","+","+    local_loss_masks = torch.cat(","+        get_local_response_loss_masks(","+            batch[\"total_lengths\"],","+            batch[\"response_lengths\"],","+            batch[\"loss_masks\"],","+            args.qkv_format,","+            batch.get(\"max_seq_lens\", None),","+        ),","+        dim=0,","+    ).to(device=log_probs.device)","+    active_tokens = local_loss_masks.bool()","+    advantages = torch.where(","+        active_tokens,","+        torch.nan_to_num(advantages, nan=0.0, posinf=0.0, neginf=0.0),","+        advantages.new_zeros(()),","+    )","+    sc_losses = torch.where(active_tokens, sc_losses, sc_losses.new_zeros(()))","+","+    pg_loss = sum_of_sample_mean(advantages * sc_losses)","+    loss = pg_loss","+","+    kl_loss = None","+    if args.use_kl_loss:","+        if batch.get(\"ref_log_probs\") is None:","+            raise ValueError(\"ref_log_probs must be provided when --use-kl-loss is set\")","+        ref_log_probs = torch.cat([log_prob.detach() for log_prob in batch[\"ref_log_probs\"]], dim=0)","+        importance_ratio = torch.exp(log_probs - old_log_probs) if args.use_unbiased_kl else None","+        kl = compute_approx_kl(","+            log_probs, ref_log_probs, kl_loss_type=args.kl_loss_type, importance_ratio=importance_ratio","+        )","+        kl = torch.where(","+            active_tokens, torch.nan_to_num(kl, nan=0.0, posinf=0.0, neginf=0.0), kl.new_zeros(())","+        )","+        kl_loss = sum_of_sample_mean(kl)","+        if args.kl_loss_coef != 0:","+            loss = loss + args.kl_loss_coef * kl_loss","+","+    if log_probs.numel() == 0:","+        loss = loss + 0 * logits.sum(dtype=torch.float32)","+","+    ppo_kl = torch.where(","+        active_tokens,","+        torch.nan_to_num(old_log_probs - log_probs.detach(), nan=0.0, posinf=0.0, neginf=0.0),","+        log_probs.new_zeros(()),","+    )","+    head_q_mass = torch.cat(","+        [","+            torch.where(","+                torch.as_tensor(ids, device=log_probs.device) >= 0,","+                torch.as_tensor(lps, device=log_probs.device, dtype=torch.float32).exp(),","+                torch.zeros((), device=log_probs.device),","+            ).sum(dim=-1)","+            if len(torch.as_tensor(ids)) > 0","+            else log_probs.new_zeros((0,))","+            for ids, lps in zip(batch[\"rollout_top_logprob_ids\"], batch[\"rollout_top_logprobs\"], strict=False)","+        ],","+        dim=0,","+    )","+    head_q_mass = torch.where(active_tokens, head_q_mass, head_q_mass.new_zeros(()))","+","+    reported_loss = {","+        \"loss\": loss.clone().detach(),","+        \"pg_loss\": pg_loss.clone().detach(),","+        \"entropy_loss\": loss.new_zeros(()),","+        \"pg_clipfrac\": loss.new_zeros(()),","+        \"ppo_kl\": sum_of_sample_mean(ppo_kl).clone().detach(),","+        \"sc_q_head_mass\": sum_of_sample_mean(head_q_mass).clone().detach(),","+    }","+    if kl_loss is not None:","+        reported_loss[\"kl_loss\"] = kl_loss.clone().detach()","+    return loss, reported_loss"],"newLines":121,"newStart":271,"oldLines":3,"oldStart":271}],"path":"/app/miles/miles/backends/training_utils/loss/hub/score_centering.py"}]}