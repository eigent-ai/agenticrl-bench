default_language_version:
  python: python3

# The vendored upstream module stays byte-diffable against its source; keep
# formatters and linters away so upstream-tracking diffs remain minimal.
exclude: '^miles/utils/chat_template_utils/templates/encoding_dsv32\.py$'

ci:
  autofix_prs: true
  autoupdate_commit_msg: '[pre-commit.ci] pre-commit suggestions'
  autoupdate_schedule: quarterly

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.5.0
    hooks:
      - id: check-yaml
        args: ['--allow-multiple-documents']
        exclude: '^charts/.*/templates/'
      - id: check-case-conflict
      - id: detect-private-key
      - id: check-added-large-files
        args: ['--maxkb=1000']
      - id: requirements-txt-fixer

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.14.7
    hooks:
      - id: ruff-check
        args: [ --fix ]

  - repo: https://github.com/PyCQA/autoflake
    rev: v2.0.2
    hooks:
      - id: autoflake
        args: [--remove-all-unused-imports, --in-place]

  - repo: https://github.com/pycqa/isort
    rev: 5.13.2          # 选一个稳定版本
    hooks:
/app/miles/tests/fast/backends/training_utils/test_log_utils_namespacing.py
/app/miles/tests/fast/backends/training_utils/test_true_on_policy_data_log_dtype.py
/app/miles/tests/fast/backends/training_utils/test_torch_native_actor.py
/app/miles/tests/fast/backends/megatron_utils/test_shared_ppo_lifecycle.py
/app/miles/tests/fast/ray/rollout/real_ray/test_rollout_executor.py
/app/miles/tests/fast/ray/rollout/test_rollout_executor_multi_policy.py
/app/miles/tests/fast/ray/rollout/test_metrics.py
