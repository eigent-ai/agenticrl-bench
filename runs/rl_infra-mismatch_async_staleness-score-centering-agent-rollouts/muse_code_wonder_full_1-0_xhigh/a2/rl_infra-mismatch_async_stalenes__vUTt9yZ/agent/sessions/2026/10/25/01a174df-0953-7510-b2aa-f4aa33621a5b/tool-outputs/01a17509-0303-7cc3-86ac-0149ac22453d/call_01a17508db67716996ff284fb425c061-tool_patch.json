{"files":[{"hunks":[{"lines":["+\"\"\"Reconstruct Miles Samples from /app/dumps (native, top_logprobs_num=128)","+the way multi_turn + score-centering recording would, then run train-data","+conversion and sanity-check the recorded behavior distribution.\"\"\"","+import gzip","+import json","+import math","+from argparse import Namespace","+","+import numpy as np","+","+from miles.ray.rollout.train_data_conversion import convert_samples_to_train_data","+from miles.utils.score_centering import concat_candidate_blocks, forced_candidate_rows, pack_output_top_logprobs","+from miles.utils.types import Sample","+","+","+def sample_from_dump(path):","+    d = json.loads(gzip.open(path, \"rt\").read())","+    sample = Sample()","+    tokens = list(d[\"calls\"][0][\"request\"][\"input_ids\"])","+    prompt_len = len(tokens)","+    sample.tokens = list(tokens)","+    rollout_log_probs, loss_mask, blocks = [], [], []","+    for call in d[\"calls\"]:","+        req_ids = call[\"request\"][\"input_ids\"]","+        assert req_ids[: len(sample.tokens)] == sample.tokens, \"call input must extend previous tokens\"","+        obs = req_ids[len(sample.tokens):]","+        if obs:","+            sample.tokens += obs","+            rollout_log_probs += [0.0] * len(obs)","+            loss_mask += [0] * len(obs)","+            blocks.append(forced_candidate_rows(obs, singleton=False))","+        mi = call[\"response\"][\"meta_info\"]","+        out_ids = [x[1] for x in mi[\"output_token_logprobs\"]]","+        assert out_ids == call[\"response\"][\"output_ids\"]","+        sample.tokens += out_ids","+        rollout_log_probs += [x[0] for x in mi[\"output_token_logprobs\"]]","+        loss_mask += [1] * len(out_ids)","+        blocks.append(pack_output_top_logprobs(mi[\"output_top_logprobs\"]))","+    sample.response_length = len(sample.tokens) - prompt_len","+    sample.rollout_log_probs = rollout_log_probs","+    sample.loss_mask = loss_mask","+    ids, logprobs = concat_candidate_blocks(blocks)","+    sample.rollout_top_logprob_ids, sample.rollout_top_logprobs = ids, logprobs","+    sample.reward = d[\"reward\"]","+    sample.group_index = d[\"group\"]","+    sample.index = d[\"rollout\"]","+    sample.validate()","+    return sample","+","+","+samples = [sample_from_dump(f\"/app/dumps/r2_group00_00{i}.json.gz\") for i in range(4)]","+for s in samples:","+    # Behavior checks on generated (unmasked) tokens.","+    gen = [t for t, m in enumerate(s.loss_mask) if m]","+    head_mass = np.exp(s.rollout_top_logprobs[gen]).sum(axis=1)","+    assert (head_mass <= 1.0 + 1e-5).all(), head_mass.max()","+    widths = (s.rollout_top_logprob_ids[gen] >= 0).sum(axis=1)","+    assert (widths == 128).all(), widths.min()","+    # Sampled-token q in head (when present) equals recorded rollout log-prob.","+    resp_tokens = s.tokens[-s.response_length:]","+    checked = 0","+    for t in gen:","+        row = {int(i): float(lp) for i, lp in zip(s.rollout_top_logprob_ids[t], s.rollout_top_logprobs[t]) if i >= 0}","+        if resp_tokens[t] in row:","+            assert abs(row[resp_tokens[t]] - s.rollout_log_probs[t]) < 2e-6","+            checked += 1","+    print(f\"sample {s.index}: resp={s.response_length} gen={len(gen)} head_mass_mean={head_mass.mean():.4f} \"","+          f\"min={head_mass.min():.4f} sampled_in_head_checked={checked}\")","+","+args = Namespace(","+    loss_type=\"score_centering\",","+    advantage_estimator=\"grpo\",","+    rewards_normalization=True,","+    grpo_std_normalization=False,","+    n_samples_per_prompt=4,","+    rollout_batch_size=1,","+    reward_key=None,","+    use_dynamic_global_batch_size=False,","+)","+train_data = convert_samples_to_train_data(args, samples, {}, None, None)","+assert train_data[\"rollout_top_logprobs\"][0].shape[1] == 128","+print(\"conversion ok; rewards:\", train_data[\"rewards\"])","+print(\"PASS\")"],"newLines":83,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/check_dumps.py"}]}