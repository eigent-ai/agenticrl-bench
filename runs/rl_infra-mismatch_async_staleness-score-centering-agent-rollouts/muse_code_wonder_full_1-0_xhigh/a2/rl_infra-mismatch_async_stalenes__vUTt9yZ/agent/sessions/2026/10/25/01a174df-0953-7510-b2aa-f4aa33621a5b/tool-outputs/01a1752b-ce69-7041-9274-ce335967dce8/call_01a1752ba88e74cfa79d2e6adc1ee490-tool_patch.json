{"files":[{"hunks":[{"lines":["     run_multiprocess(partial(_tp2_worker, masked=masked), world_size=2)"," "," ","+def _tp2_cp2_worker(rank, world_size, port, *, masked):","+    # rank = cp_rank * 2 + tp_rank; totals divisible by 2*cp so the zigzag","+    # layout needs no padding rows.","+    init_gloo(rank, world_size, port=port)","+    tp_rank, cp_rank = rank % 2, rank // 2","+    tp_group = [dist.new_group([0, 1]), dist.new_group([2, 3])][cp_rank]","+    cp_group = [dist.new_group([0, 2]), dist.new_group([1, 3])][tp_rank]","+    trivial = GroupInfo(rank=0, size=1, group=None)","+    cp_info = GroupInfo(rank=cp_rank, size=2, group=cp_group)","+    set_parallel_state(","+        ParallelState(","+            intra_dp=trivial,","+            intra_dp_cp=cp_info,","+            cp=cp_info,","+            tp=GroupInfo(rank=tp_rank, size=2, group=tp_group),","+            pp=trivial,","+            ep=trivial,","+            etp=trivial,","+            indep_dp=trivial,","+            is_pp_last_stage=True,","+        )","+    )","+    args = make_args(","+        loss_type=\"score_centering\",","+        true_on_policy_mode=False,","+        rollout_temperature=1.0,","+        log_probs_chunk_size=3,","+        use_sampling_support_replay=masked,","+        score_centering_is=\"tis\",","+        score_centering_tis_clip=2.0,","+        score_centering_mis_low=0.5,","+        score_centering_mis_high=5.0,","+    )","+    batch = _make_batch(masked=masked, prompt_lens=(4, 4), resp_lens=(8, 4))","+    total = sum(batch[\"total_lengths\"])","+    g = torch.Generator().manual_seed(123)","+    base = torch.randn(1, total, VOCAB, generator=g)","+","+    logits_ref = base.clone().requires_grad_(True)","+    ref_loss = _reference_loss(logits_ref, batch, temperature=1.0, masked=masked, mode=\"tis\")","+    ref_loss.backward()","+","+    # Build this rank's zigzag-CP local logits stream, then TP-shard vocab.","+    local_rows, global_rows = [], []","+    offset = 0","+    for total_len in batch[\"total_lengths\"]:","+        chunk = total_len // 4","+        for part in (cp_rank, 2 * 2 - 1 - cp_rank):","+            rows = list(range(offset + part * chunk, offset + (part + 1) * chunk))","+            global_rows.extend(rows)","+            local_rows.append(base[0, rows])","+        offset += total_len","+    shard = VOCAB // 2","+    local = torch.cat(local_rows, dim=0)[:, tp_rank * shard : (tp_rank + 1) * shard].unsqueeze(0)","+    local = local.clone().requires_grad_(True)","+","+    rank_batch = dict(batch)","+    rank_batch[\"advantages\"] = [","+        slice_log_prob_with_cp(adv, t, r, \"thd\")","+        for adv, t, r in zip(batch[\"advantages\"], batch[\"total_lengths\"], batch[\"response_lengths\"], strict=True)","+    ]","+    rank_batch[\"rollout_log_probs\"] = [","+        slice_log_prob_with_cp(lp, t, r, \"thd\")","+        for lp, t, r in zip(batch[\"rollout_log_probs\"], batch[\"total_lengths\"], batch[\"response_lengths\"], strict=True)","+    ]","+    reducer = get_sum_of_sample_mean(","+        batch[\"total_lengths\"], batch[\"response_lengths\"], batch[\"loss_masks\"], True, \"thd\"","+    )","+    loss, _ = score_centering_loss_function(args, rank_batch, local, reducer)","+    loss.backward()","+","+    # Sum the CP partial losses (each token counted once) over this TP slice's CP group.","+    total_loss = loss.detach().clone()","+    dist.all_reduce(total_loss, group=cp_group)","+    torch.testing.assert_close(total_loss, ref_loss.detach(), rtol=1e-5, atol=1e-6)","+","+    assembled = torch.zeros(total, VOCAB)","+    assembled[global_rows, tp_rank * shard : (tp_rank + 1) * shard] = local.grad[0]","+    dist.all_reduce(assembled)","+    torch.testing.assert_close(assembled, logits_ref.grad[0], rtol=1e-4, atol=1e-6)","+","+","<redacted-email>(\"masked\", [False, True])","+def test_tp2_cp2_matches_single_rank(masked):","+    run_multiprocess(partial(_tp2_cp2_worker, masked=masked), world_size=4)","+","+"," def test_on_policy_is_plain_reinforce():","     \"\"\"With q == p and no IS composition the centering coefficients vanish.\"\"\"","     make_parallel_state()"],"newLines":93,"newStart":224,"oldLines":6,"oldStart":224}],"path":"/app/miles/tests/fast/backends/training_utils/loss/test_score_centering.py"}]}