{"files":[{"hunks":[{"lines":["+\"\"\"Peak GPU memory of the loss-side logit processing on one 8192-token","+micro-batch (TP1): PPO log-prob path vs score-centering path.","+Usage: python3 /tmp/mem_probe.py ppo|sc-full|sc-masked\"\"\"","+import os","+import sys","+from argparse import Namespace","+","+import torch","+import torch.distributed as dist","+","+os.environ.setdefault(\"MASTER_ADDR\", \"localhost\")","+os.environ.setdefault(\"MASTER_PORT\", \"29777\")","+dist.init_process_group(backend=\"nccl\", rank=0, world_size=1)","+torch.cuda.set_device(0)","+","+from miles.backends.training_utils.data.context_parallel import get_sum_of_sample_mean","+from miles.backends.training_utils.loss.hub.logit_processors import get_log_probs_and_entropy","+from miles.backends.training_utils.loss.hub.score_centering import score_centering_loss_function","+from miles.backends.training_utils.parallel import GroupInfo, ParallelState, set_parallel_state","+","+trivial = GroupInfo(rank=0, size=1, group=None)","+set_parallel_state(","+    ParallelState(","+        intra_dp=trivial,","+        intra_dp_cp=trivial,","+        cp=trivial,","+        tp=GroupInfo(rank=0, size=1, group=dist.group.WORLD),","+        pp=trivial,","+        ep=trivial,","+        etp=trivial,","+        indep_dp=trivial,","+        is_pp_last_stage=True,","+    )","+)","+","+V, R, PROMPT, K = 248320, 8192, 16, 128","+mode = sys.argv[1]","+args = Namespace(","+    qkv_format=\"thd\",","+    rollout_temperature=1.0,","+    allgather_cp=False,","+    log_probs_chunk_size=2048,","+    true_on_policy_mode=False,","+    debug_unified_grad_fused_logprob=False,","+    vocab_size=V,","+    use_sampling_support_replay=(mode == \"sc-masked\"),","+    score_centering_is=\"mis\",","+    score_centering_tis_clip=2.0,","+    score_centering_mis_low=0.5,","+    score_centering_mis_high=5.0,","+)","+","+g = torch.Generator(device=\"cuda\").manual_seed(0)","+tokens = torch.randint(0, V, (PROMPT + R,), generator=g, device=\"cuda\")","+logits = (torch.randn(1, PROMPT + R, V, generator=g, device=\"cuda\") * 2).to(torch.bfloat16).requires_grad_(True)","+head_ids = torch.randint(0, V, (R, K), generator=g, device=\"cuda\")","+if mode == \"sc-masked\":","+    head_ids[:, 0] = tokens[-R:]","+head_logq = torch.log_softmax(torch.randn(R, K, generator=g, device=\"cuda\") * 3, dim=-1)","+sampled_logq = torch.randn(R, generator=g, device=\"cuda\") - 2","+batch = {","+    \"unconcat_tokens\": [tokens],","+    \"total_lengths\": [PROMPT + R],","+    \"response_lengths\": [R],","+    \"loss_masks\": [torch.ones(R, dtype=torch.int, device=\"cuda\")],","+    \"advantages\": [torch.randn(R, generator=g, device=\"cuda\")],","+    \"rollout_log_probs\": [sampled_logq],","+    \"rollout_top_logprobs\": [head_logq],","+    \"rollout_top_logprob_ids\": [head_ids],","+}","+","+torch.cuda.synchronize()","+torch.cuda.reset_peak_memory_stats()","+base = torch.cuda.memory_allocated()","+","+if mode == \"ppo\":","+    out = get_log_probs_and_entropy(","+        logits, args=args, unconcat_tokens=[tokens], total_lengths=[PROMPT + R], response_lengths=[R]","+    )","+    loss = -out[\"log_probs\"][0].sum()","+else:","+    reducer = get_sum_of_sample_mean([PROMPT + R], [R], batch[\"loss_masks\"], True, \"thd\")","+    loss, _ = score_centering_loss_function(args, batch, logits, reducer)","+loss.backward()","+torch.cuda.synchronize()","+peak = torch.cuda.max_memory_allocated()","+print(f\"mode={mode} base={base/2**30:.2f} GiB peak={peak/2**30:.2f} GiB peak_over_base={(peak-base)/2**30:.2f} GiB loss={loss.item():.4f}\")"],"newLines":87,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/mem_probe.py"}]}