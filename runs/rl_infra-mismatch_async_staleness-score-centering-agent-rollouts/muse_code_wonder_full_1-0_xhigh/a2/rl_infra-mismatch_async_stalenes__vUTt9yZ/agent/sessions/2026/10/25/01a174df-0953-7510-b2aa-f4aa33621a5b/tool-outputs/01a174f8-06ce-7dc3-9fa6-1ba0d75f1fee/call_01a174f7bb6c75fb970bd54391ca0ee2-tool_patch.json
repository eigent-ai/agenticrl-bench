{"files":[{"hunks":[{"lines":["+\"\"\"Sampler-candidate recording for score centering: pack, append, merge, wire, convert.\"\"\"","+","+from argparse import Namespace","+","+import numpy as np","+import pytest","+","+from miles.rollout.generate_utils.sampling_mask import append_sampling_metadata","+from miles.rollout.generate_utils.score_centering import append_top_logprobs_candidates","+from miles.utils.score_centering import candidates_from_sample, pack_output_top_logprobs, pack_support_candidates","+from miles.utils.types import Sample","+","+","+def _sample_with_response(n=0):","+    sample = Sample()","+    sample.response_length = n","+    return sample","+","+","+def test_pack_output_top_logprobs_pads_ragged_rows():","+    ids, logprobs = pack_output_top_logprobs([[[-0.1, 5, None], [-2.0, 9, None]], [[-0.3, 7, None]]])","+    assert ids.dtype == np.int32 and logprobs.dtype == np.float32","+    assert ids.tolist() == [[5, 9], [7, -1]]","+    assert logprobs[0].tolist() == pytest.approx([-0.1, -2.0])","+    assert logprobs[1, 0] == pytest.approx(-0.3)","+    assert np.isneginf(logprobs[1, 1])","+","+","+def test_pack_support_candidates_requires_alignment():","+    with pytest.raises(ValueError, match=\"support size\"):","+        pack_support_candidates([[1, 2]], [[-0.5]])","+","+","+def test_append_top_logprobs_candidates_and_strip():","+    sample = _sample_with_response()","+    append_top_logprobs_candidates(sample, [[[-0.1, 5, None]], [[-0.2, 6, None], [-3.0, 1, None]]], [5, 6])","+    sample.tokens = [10, 5, 6]","+    sample.response_length = 2","+    sample.rollout_log_probs = [-0.1, -0.2]","+    sample.validate()","+","+    class _Tok:","+        @staticmethod","+        def decode(ids):","+            return \"x\" * len(ids)","+","+    sample.strip_last_output_tokens(1, _Tok())","+    assert sample.rollout_top_logprobs.shape == (1, 2)","+    assert sample.rollout_top_logprob_ids.tolist() == [[5, -1]]","+","+","+def test_append_top_logprobs_candidates_missing_response_raises():","+    with pytest.raises(ValueError, match=\"missing output_top_logprobs\"):","+        append_top_logprobs_candidates(_sample_with_response(), None, [5])","+","+","+def test_support_mode_records_candidates_and_selected_logprob():","+    sample = _sample_with_response()","+    meta_info = {","+        \"output_token_sampling_mask\": [[10, 4, 7], [11, 3]],","+        \"output_token_sampling_logprobs\": [[-0.5, -1.5, -2.5], [-0.25, -1.25]],","+        \"finish_reason\": {\"type\": \"stop\"},","+    }","+    selected = append_sampling_metadata(sample, [4, 11], meta_info, record_candidates=True)","+    assert selected == [-1.5, -0.25]","+    ids, logprobs = candidates_from_sample(sample)","+    assert ids.tolist() == [[10, 4, 7], [11, 3, -1]]","+    assert logprobs[1].tolist()[:2] == pytest.approx([-0.25, -1.25])","+","+","+def test_support_mode_required_when_recording():","+    meta_info = {","+        \"output_token_sampling_mask\": [[10, 4]],","+        \"output_token_sampling_logprobs\": [-0.5],","+        \"finish_reason\": {\"type\": \"stop\"},","+    }","+    with pytest.raises(ValueError, match=\"sampling_logprobs_mode='support'\"):","+        append_sampling_metadata(_sample_with_response(), [4], meta_info, record_candidates=True)","+","+","+def test_selected_mode_unchanged_without_recording():","+    sample = _sample_with_response()","+    meta_info = {","+        \"output_token_sampling_mask\": [[10, 4]],","+        \"output_token_sampling_logprobs\": [-0.5],","+        \"finish_reason\": {\"type\": \"stop\"},","+    }","+    assert append_sampling_metadata(sample, [4], meta_info) == [-0.5]","+    assert sample.rollout_top_logprobs is None","+","+","+def test_merge_samples_concatenates_candidates_with_forced_observation_rows():","+    from miles.rollout.generate_utils.sample_utils import merge_samples","+","+    class _Tok:","+        @staticmethod","+        def decode(ids):","+            return \"\".join(chr(ord(\"a\") + i % 26) for i in ids)","+","+    def turn(prompt, tokens, resp_ids, resp_logprobs):","+        sample = Sample(prompt=prompt, tokens=list(tokens), response_length=len(resp_ids))","+        sample.response = _Tok.decode(resp_ids)","+        sample.rollout_log_probs = [0.0] * len(resp_ids)","+        sample.loss_mask = [1] * len(resp_ids)","+        sample.status = Sample.Status.COMPLETED","+        ids, logprobs = pack_output_top_logprobs(","+            [[[lp, tid, None]] for tid, lp in zip(resp_ids, resp_logprobs, strict=True)]","+        )","+        sample.rollout_top_logprob_ids, sample.rollout_top_logprobs = ids, logprobs","+        return sample","+","+    a = turn(\"p\", [1, 2], [2], [-0.2])","+    b = turn(\"pao\", [1, 2, 3, 4], [4], [-0.4])","+    merged = merge_samples([a, b], _Tok())","+    assert merged.response_length == 3","+    # turn row, forced observation row (empty head here: unbounded), turn row","+    assert merged.rollout_top_logprob_ids.tolist() == [[2], [-1], [4]]","+    assert merged.rollout_top_logprobs[0, 0] == pytest.approx(-0.2)","+    assert np.isneginf(merged.rollout_top_logprobs[1, 0])","+    merged.validate()","+","+","+def test_session_codec_roundtrips_candidates():","+    from miles.rollout.session.samples.codec import (","+        COMPUTED_FIELDS_V2,","+        decode_samples_and_merge_input_sample,","+        encode_samples,","+    )","+","+    sample = Sample(tokens=[1, 2, 3], response=\"ab\", response_length=2)","+    sample.loss_mask = [1, 1]","+    sample.rollout_log_probs = [-0.1, -0.2]","+    ids, logprobs = pack_output_top_logprobs([[[-0.1, 2, None], [-1.0, 9, None]], [[-0.2, 3, None]]])","+    sample.rollout_top_logprob_ids, sample.rollout_top_logprobs = ids, logprobs","+    payload = encode_samples([sample], {}, fields=COMPUTED_FIELDS_V2)","+    reply = decode_samples_and_merge_input_sample(payload, Sample(), fields=COMPUTED_FIELDS_V2)","+    (decoded,) = reply.samples","+    assert decoded.rollout_top_logprob_ids.tolist() == ids.tolist()","+    np.testing.assert_allclose(decoded.rollout_top_logprobs, logprobs)","+    decoded.validate()","+","+","+def test_convert_samples_requires_recorded_candidates():","+    from miles.ray.rollout.train_data_conversion import convert_samples_to_train_data","+","+    args = Namespace(","+        loss_type=\"score_centering\",","+        advantage_estimator=\"grpo\",","+        rewards_normalization=True,","+        grpo_std_normalization=False,","+        n_samples_per_prompt=1,","+        rollout_batch_size=1,","+        reward_key=None,","+        use_dynamic_global_batch_size=False,","+    )","+    sample = Sample(tokens=[1, 2], response_length=1, reward=1.0, index=0, group_index=0)","+    sample.rollout_log_probs = [-0.5]","+    with pytest.raises(ValueError, match=\"recorded at generation time\"):","+        convert_samples_to_train_data(args, [sample], {}, None, None)","+","+    ids, logprobs = pack_output_top_logprobs([[[-0.5, 2, None]]])","+    sample.rollout_top_logprob_ids, sample.rollout_top_logprobs = ids, logprobs","+    train_data = convert_samples_to_train_data(args, [sample], {}, None, None)","+    assert train_data[\"rollout_top_logprob_ids\"][0].tolist() == [[2]]","+    assert train_data[\"rollout_top_logprobs\"][0].tolist() == pytest.approx([[-0.5]])"],"newLines":165,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/tests/fast/rollout/generate_utils/test_score_centering.py"}]}