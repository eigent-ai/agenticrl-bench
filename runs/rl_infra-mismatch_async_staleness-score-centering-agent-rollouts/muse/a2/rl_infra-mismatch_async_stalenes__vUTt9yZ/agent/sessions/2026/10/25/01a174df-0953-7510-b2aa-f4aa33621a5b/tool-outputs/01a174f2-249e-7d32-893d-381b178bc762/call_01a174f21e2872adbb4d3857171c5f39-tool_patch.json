{"files":[{"hunks":[{"lines":["     if samples[0].rollout_log_probs is not None:","         train_data[\"rollout_log_probs\"] = [sample.rollout_log_probs for sample in samples]"," ","+    # Score centering trains against the sampler candidates recorded at","+    # generation time; a missing recording is a hard error, never a rescore.","+    if score_centering_enabled(args):","+        candidate_ids = []","+        candidate_logprobs = []","+        for position, sample in enumerate(samples):","+            candidates = candidates_from_sample(sample)","+            if candidates is None:","+                raise ValueError(","+                    \"--loss-type score_centering requires sampler candidates recorded at \"","+                    f\"generation time for every training sample; missing at position={position}, \"","+                    f\"sample_index={sample.index}, status={sample.status}\"","+                )","+            ids, logprobs = candidates","+            if len(ids) != sample.response_length:","+                raise ValueError(","+                    f\"sampler candidate rows {len(ids)} != response_length {sample.response_length} \"","+                    f\"at position={position}, sample_index={sample.index}\"","+                )","+            candidate_ids.append(ids)","+            candidate_logprobs.append(logprobs)","+        train_data[\"rollout_top_logprob_ids\"] = candidate_ids","+        train_data[\"rollout_top_logprobs\"] = candidate_logprobs","+","     has_sampling_mask = any(sample.rollout_sampling_mask is not None for sample in samples)","     if has_sampling_mask:","         sampling_mask_ids = []"],"newLines":30,"newStart":118,"oldLines":6,"oldStart":118}],"path":"/app/miles/miles/ray/rollout/train_data_conversion.py"}]}