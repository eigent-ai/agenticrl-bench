{"files":[{"hunks":[{"lines":["+\"\"\"Score centering (arXiv:2609.20807) as a chunked vocab-parallel loss.","+","+Per generated token, with sampler distribution ``q`` recorded at generation","+time (top-k head ``H``) and trainer distribution ``p`` from the current","+logits, the surrogate whose gradient is the centered score is","+","+    f = sg[w_y] * log p_y - sum_{v in H} sg[q_v w_v - alpha p_v] * log p_v","+","+with ``w_v = f(p_v / q_v)`` for the configured IS composition and","+``alpha = rho * f(1 / rho)``, ``rho`` the ratio of floored tail masses","+(eq. 7-12 of the paper). ``-grad(-A f) = A (w_y s_y - E_q^[w s])``.","+","+Under bounded (top-p/top-k) rollout sampling, Miles scores the trainer","+within the realized sampling support and the recorded candidates *are* that","+support with support-normalized ``q``; both tail masses are then exactly 0","+and the same formulas apply with the softmax restricted to the head.","+","+Memory: the autograd primitive processes ``log_probs_chunk_size`` rows at a","+time, saves only ``[rows, K]`` coefficients between forward and backward,","+and recomputes the row softmax in backward (like the fused cross-entropy),","+so no full-vocabulary tensor is retained for the backward pass.","+\"\"\"","+","+from argparse import Namespace","+from collections.abc import Callable, Sequence","+","+import torch","+import torch.distributed as dist","+","+from miles.backends.training_utils.data.context_parallel import (","+    all_gather_with_cp,","+    allgather_cp_redistribute,","+    get_local_response_loss_masks,","+)","+from miles.backends.training_utils.loss.hub.logit_processors import _iter_response_chunks","+from miles.backends.training_utils.parallel import get_parallel_state","+from miles.utils.types import RolloutBatch","+","+TAIL_EPS = 1e-6","+_LOG_RATIO_CLAMP = 20.0","+","+_IS_NONE, _IS_TIS, _IS_MIS = 0, 1, 2","+","+","+def _is_mode_code(args: Namespace) -> int:","+    return {\"none\": _IS_NONE, \"tis\": _IS_TIS, \"mis\": _IS_MIS}[args.score_centering_is]","+","+","+def _is_weight(ratio: torch.Tensor, is_mode: int, tis_clip: float, mis_low: float, mis_high: float) -> torch.Tensor:","+    if is_mode == _IS_NONE:","+        return torch.ones_like(ratio)","+    if is_mode == _IS_TIS:","+        return torch.minimum(ratio, torch.full_like(ratio, tis_clip))","+    return torch.where((ratio >= mis_low) & (ratio <= mis_high), ratio, torch.zeros_like(ratio))","+","+","+def _safe_ratio(logp: torch.Tensor, logq: torch.Tensor) -> torch.Tensor:","+    log_ratio = torch.nan_to_num(","+        logp.float() - logq.float(), nan=0.0, posinf=_LOG_RATIO_CLAMP, neginf=-_LOG_RATIO_CLAMP","+    )","+    return torch.clamp(log_ratio, min=-_LOG_RATIO_CLAMP, max=_LOG_RATIO_CLAMP).exp()","+","+","+def _scaled_fp32_logits(logits: torch.Tensor, temperature: float) -> torch.Tensor:","+    # Mirror _upcast_chunk_to_fp32: fp32 copy first, temperature division in fp32.","+    chunk = logits.to(torch.float32, copy=True)","+    if temperature > 0 and temperature != 1.0:","+        chunk.div_(temperature)","+    return chunk","+","+","+def _all_reduce(tensor: torch.Tensor, *, op: dist.ReduceOp, group: dist.ProcessGroup | None) -> torch.Tensor:","+    if group is not None and dist.get_world_size(group) > 1:","+        dist.all_reduce(tensor, op=op, group=group)","+    return tensor","+","+","+def _gather_candidate_logits(","+    scaled_logits: torch.Tensor,","+    token_ids: torch.Tensor,","+    *,","+    vocab_start: int,","+    tp_group: dist.ProcessGroup | None,","+) -> torch.Tensor:","+    \"\"\"Temperature-scaled logits at arbitrary token ids, replicated over TP.","+","+    Each id lives on exactly one vocab shard; non-owners contribute -inf and","+    a MAX all-reduce selects the owner's value (padding id -1 stays -inf).","+    \"\"\"","+    local_vocab = scaled_logits.size(-1)","+    is_local = (token_ids >= vocab_start) & (token_ids < vocab_start + local_vocab)","+    safe_index = (token_ids - vocab_start).clamp(min=0, max=local_vocab - 1)","+    values = torch.gather(scaled_logits, dim=-1, index=safe_index)","+    values = torch.where(is_local, values, torch.full_like(values, float(\"-inf\")))","+    return _all_reduce(values.contiguous(), op=dist.ReduceOp.MAX, group=tp_group)","+","+","+def _full_logsumexp(scaled_logits: torch.Tensor, *, tp_group: dist.ProcessGroup | None) -> torch.Tensor:","+    row_max = _all_reduce(scaled_logits.max(dim=-1).values.contiguous(), op=dist.ReduceOp.MAX, group=tp_group)","+    sum_exp = _all_reduce(","+        torch.exp(scaled_logits - row_max.unsqueeze(-1)).sum(dim=-1).contiguous(),","+        op=dist.ReduceOp.SUM,","+        group=tp_group,","+    )","+    return row_max + torch.log(sum_exp)","+","+","+class _CenteredScore(torch.autograd.Function):","+    \"\"\"Chunk primitive: centered-score surrogate ``f`` plus detached diagnostics.\"\"\"","+","+    @staticmethod","+    def forward(","+        ctx,","+        logits: torch.Tensor,","+        sampled_ids: torch.Tensor,","+        head_ids: torch.Tensor,","+        head_logq: torch.Tensor,","+        sampled_logq: torch.Tensor,","+        temperature: float,","+        masked_to_head: bool,","+        is_mode: int,","+        tis_clip: float,","+        mis_low: float,","+        mis_high: float,","+        tp_group: dist.ProcessGroup | None,","+    ):","+        ctx.set_materialize_grads(False)","+        tp_size = dist.get_world_size(tp_group) if tp_group is not None else 1","+        tp_rank = dist.get_rank(tp_group) if tp_group is not None else 0","+        vocab_start = tp_rank * logits.size(-1)","+","+        scaled = _scaled_fp32_logits(logits, temperature)","+        head_logits = _gather_candidate_logits(scaled, head_ids, vocab_start=vocab_start, tp_group=tp_group)","+        sampled_logits = _gather_candidate_logits(","+            scaled, sampled_ids.unsqueeze(-1), vocab_start=vocab_start, tp_group=tp_group","+        ).squeeze(-1)","+        if masked_to_head:","+            logsumexp = torch.logsumexp(head_logits, dim=-1)","+            # A fully padded head row has no support; anchor at the sampled","+            # logit so downstream values stay finite (the row is loss-masked).","+            logsumexp = torch.where(torch.isfinite(logsumexp), logsumexp, sampled_logits)","+        else:","+            logsumexp = _full_logsumexp(scaled, tp_group=tp_group)","+        del scaled","+","+        valid = head_ids >= 0","+        logp_head = head_logits - logsumexp.unsqueeze(-1)","+        logp_sampled = sampled_logits - logsumexp","+        p_head = torch.where(valid, torch.exp(logp_head), torch.zeros_like(logp_head))","+        q_head = torch.where(valid, torch.exp(head_logq.float()), torch.zeros_like(logp_head))","+        q_head = torch.nan_to_num(q_head, nan=0.0, posinf=0.0, neginf=0.0)","+        logp_head = torch.where(valid, logp_head, torch.zeros_like(logp_head))","+","+        w_head = _is_weight(_safe_ratio(logp_head, head_logq), is_mode, tis_clip, mis_low, mis_high)","+        w_head = torch.where(valid, w_head, torch.zeros_like(w_head))","+        # The sampled token always uses its recorded sampler log-prob, also","+        # when it is not among the stored candidates.","+        w_sampled = _is_weight(_safe_ratio(logp_sampled, sampled_logq), is_mode, tis_clip, mis_low, mis_high)","+","+        q_tail = 1.0 - q_head.sum(dim=-1)","+        p_tail = 1.0 - p_head.sum(dim=-1)","+        rho = torch.clamp(q_tail, min=TAIL_EPS) / torch.clamp(p_tail, min=TAIL_EPS)","+        alpha = rho * _is_weight(1.0 / rho, is_mode, tis_clip, mis_low, mis_high)","+","+        coefficients = torch.where(","+            valid, q_head * w_head - alpha.unsqueeze(-1) * p_head, torch.zeros_like(logp_head)","+        )","+        centered = w_sampled * logp_sampled - (coefficients * logp_head).sum(dim=-1)","+        total_d = w_sampled - coefficients.sum(dim=-1)","+","+        ctx.save_for_backward(logits, sampled_ids, head_ids, coefficients, w_sampled, total_d, p_head, logsumexp)","+        ctx.temperature = temperature","+        ctx.masked_to_head = masked_to_head","+        ctx.tp_group = tp_group","+        ctx.tp_rank = tp_rank","+        ctx.tp_size = tp_size","+        return centered, logp_sampled, rho, w_sampled, q_head.sum(dim=-1)","+","+    @staticmethod","+    def backward(ctx, grad_centered, _grad_logp, _grad_rho, _grad_w, _grad_q_mass):","+        logits, sampled_ids, head_ids, coefficients, w_sampled, total_d, p_head, logsumexp = ctx.saved_tensors","+        if grad_centered is None:","+            return (None,) * 12","+        temperature: float = ctx.temperature","+        inv_temperature = 1.0 / temperature if temperature > 0 else 1.0","+        row_scale = grad_centered.float() * inv_temperature","+        local_vocab = logits.size(-1)","+        vocab_start = ctx.tp_rank * local_vocab","+","+        if ctx.masked_to_head:","+            grad = torch.zeros(logits.shape, dtype=torch.float32, device=logits.device)","+        else:","+            scaled = _scaled_fp32_logits(logits, temperature)","+            probs = torch.exp(scaled - logsumexp.unsqueeze(-1))","+            del scaled","+            grad = probs * (-(row_scale * total_d).unsqueeze(-1))","+            del probs","+","+        def scatter(token_ids: torch.Tensor, values: torch.Tensor) -> None:","+            is_local = (token_ids >= vocab_start) & (token_ids < vocab_start + local_vocab)","+            safe_index = (token_ids - vocab_start).clamp(min=0, max=local_vocab - 1)","+            grad.scatter_add_(dim=-1, index=safe_index, src=torch.where(is_local, values, torch.zeros_like(values)))","+","+        head_values = row_scale.unsqueeze(-1) * (-coefficients)","+        if ctx.masked_to_head:","+            head_values = head_values - row_scale.unsqueeze(-1) * p_head * total_d.unsqueeze(-1)","+        scatter(head_ids, head_values)","+        scatter(sampled_ids.unsqueeze(-1), (row_scale * w_sampled).unsqueeze(-1))","+        return grad.to(logits.dtype), None, None, None, None, None, None, None, None, None, None, None","+","+","+def _full_rollout_log_probs(","+    args: Namespace,","+    batch: RolloutBatch,","+    total_lengths: list[int],","+    response_lengths: list[int],","+    max_seq_lens: list[int] | None,","+) -> list[torch.Tensor]:","+    \"\"\"Behavior log-probs in full response order (batch rows are CP-sliced).\"\"\"","+    sliced = [log_prob.detach() for log_prob in batch[\"rollout_log_probs\"]]","+    if get_parallel_state().cp.size == 1:","+        return sliced","+    return [","+        all_gather_with_cp(","+            log_prob,","+            total_length,","+            response_length,","+            args.qkv_format,","+            max_seq_lens[i] if max_seq_lens is not None else None,","+        ).detach()","+        for i, (log_prob, total_length, response_length) in enumerate(","+            zip(sliced, total_lengths, response_lengths, strict=True)","+        )","+    ]","+","+","+def compute_score_centering_terms(","+    logits: torch.Tensor,","+    *,","+    args: Namespace,","+    batch: RolloutBatch,","+) -> dict[str, list[torch.Tensor]]:","+    \"\"\"Per-sample centered-score surrogates and diagnostics, in local CP order.\"\"\"","+    total_lengths = batch[\"total_lengths\"]","+    response_lengths = batch[\"response_lengths\"]","+    max_seq_lens = batch.get(\"max_seq_lens\", None)","+    candidate_ids: list[torch.Tensor] = batch[\"rollout_top_logprob_ids\"]","+    candidate_logprobs: list[torch.Tensor] = batch[\"rollout_top_logprobs\"]","+    full_logq = _full_rollout_log_probs(args, batch, total_lengths, response_lengths, max_seq_lens)","+","+    parallel_state = get_parallel_state()","+    is_mode = _is_mode_code(args)","+    chunk_size = args.log_probs_chunk_size","+    res: dict[str, list[torch.Tensor]] = {","+        \"centered_score\": [],","+        \"log_probs\": [],","+        \"rho\": [],","+        \"weights\": [],","+        \"q_head_mass\": [],","+    }","+    response_chunks = _iter_response_chunks(","+        logits,","+        args=args,","+        unconcat_tokens=batch[\"unconcat_tokens\"],","+        total_lengths=total_lengths,","+        response_lengths=response_lengths,","+        max_seq_lens=max_seq_lens,","+        include_response_indices=True,","+    )","+    for sample_index, (logits_chunk, tokens_chunk, response_indices) in enumerate(response_chunks):","+        if logits_chunk.size(0) == 0:","+            for values in res.values():","+                values.append(logits.new_zeros((0,), dtype=torch.float32))","+            continue","+        indices = torch.as_tensor(list(response_indices), dtype=torch.long, device=logits.device)","+        head_ids = candidate_ids[sample_index].index_select(0, indices)","+        head_logq = candidate_logprobs[sample_index].index_select(0, indices)","+        sampled_logq = full_logq[sample_index].index_select(0, indices)","+","+        bounds = (","+            list(range(0, logits_chunk.size(0), chunk_size)) if chunk_size > 0 else [0]","+        )","+        outputs: list[list[torch.Tensor]] = [[] for _ in res]","+        for start in bounds:","+            stop = start + chunk_size if chunk_size > 0 else logits_chunk.size(0)","+            chunk_outputs = _CenteredScore.apply(","+                logits_chunk[start:stop],","+                tokens_chunk[start:stop],","+                head_ids[start:stop],","+                head_logq[start:stop],","+                sampled_logq[start:stop],","+                float(args.rollout_temperature),","+                bool(args.use_sampling_support_replay),","+                is_mode,","+                float(args.score_centering_tis_clip),","+                float(args.score_centering_mis_low),","+                float(args.score_centering_mis_high),","+                parallel_state.tp.group,","+            )","+            for bucket, value in zip(outputs, chunk_outputs, strict=True):","+                bucket.append(value)","+        for key, bucket in zip(res.keys(), outputs, strict=True):","+            res[key].append(bucket[0] if len(bucket) == 1 else torch.cat(bucket, dim=0))","+","+    if args.allgather_cp:","+        allgather_cp_redistribute(","+            res,","+            logits=logits,","+            args=args,","+            total_lengths=total_lengths,","+            response_lengths=response_lengths,","+            max_seq_lens=max_seq_lens,","+        )","+    return res","+","+","+def score_centering_loss_function(","+    args: Namespace,","+    batch: RolloutBatch,","+    logits: torch.Tensor,","+    sum_of_sample_mean: Callable[[torch.Tensor], torch.Tensor],","+) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:","+    \"\"\"Score-centering policy loss: ``-A * (w_y s_y - E_q^[w s])`` per token.","+","+    Batch extras beyond ``policy_loss_function``: ``rollout_top_logprobs`` /","+    ``rollout_top_logprob_ids`` (sampler candidates recorded at generation","+    time, full response order) and ``rollout_log_probs`` (recorded behavior","+    log-probs). No PPO clipping and no old-actor ratio: the IS weights are","+    part of the centered estimator itself.","+    \"\"\"","+    if batch.get(\"rollout_top_logprobs\") is None or batch.get(\"rollout_top_logprob_ids\") is None:","+        raise ValueError(","+            \"score_centering loss requires rollout_top_logprobs/rollout_top_logprob_ids in the batch; \"","+            \"the sampler candidates must be recorded at generation time\"","+        )","+    if batch.get(\"rollout_log_probs\") is None:","+        raise ValueError(\"score_centering loss requires rollout_log_probs (recorded behavior log-probs)\")","+","+    total_lengths = batch[\"total_lengths\"]","+    response_lengths = batch[\"response_lengths\"]","+    max_seq_lens = batch.get(\"max_seq_lens\", None)","+","+    terms = compute_score_centering_terms(logits, args=args, batch=batch)","+    centered = torch.cat(terms[\"centered_score\"], dim=0)","+    log_probs = torch.cat(terms[\"log_probs\"], dim=0)","+","+    advantages = torch.cat([advantage.detach() for advantage in batch[\"advantages\"]], dim=0)","+    local_loss_masks = torch.cat(","+        get_local_response_loss_masks(total_lengths, response_lengths, batch[\"loss_masks\"], args.qkv_format, max_seq_lens),","+        dim=0,","+    ).to(device=centered.device)","+    active_tokens = local_loss_masks.bool()","+    centered = torch.where(","+        active_tokens, torch.nan_to_num(centered, nan=0.0, posinf=0.0, neginf=0.0), centered.new_zeros(())","+    )","+    advantages = torch.where(","+        active_tokens, torch.nan_to_num(advantages, nan=0.0, posinf=0.0, neginf=0.0), advantages.new_zeros(())","+    )","+","+    pg_loss_per_token = -advantages * centered","+    pg_loss = sum_of_sample_mean(pg_loss_per_token)","+    loss = pg_loss","+    if centered.numel() == 0:","+        loss = loss + 0 * logits.sum(dtype=torch.float32)","+","+    def reduced(values: Sequence[torch.Tensor]) -> torch.Tensor:","+        flat = torch.cat([value.detach() for value in values], dim=0)","+        flat = torch.where(active_tokens, torch.nan_to_num(flat, nan=0.0, posinf=0.0, neginf=0.0), flat.new_zeros(()))","+        return sum_of_sample_mean(flat).clone().detach()","+","+    rollout_log_probs = torch.cat([log_prob.detach() for log_prob in batch[\"rollout_log_probs\"]], dim=0)","+    abs_diff = torch.where(","+        active_tokens,","+        torch.nan_to_num((log_probs.detach() - rollout_log_probs).abs(), nan=0.0, posinf=0.0, neginf=0.0),","+        centered.new_zeros(()),","+    )","+","+    reported_loss = {","+        \"loss\": loss.clone().detach(),","+        \"pg_loss\": pg_loss.clone().detach(),","+        \"sc_rho\": reduced(terms[\"rho\"]),","+        \"sc_q_head_mass\": reduced(terms[\"q_head_mass\"]),","+        \"sc_weight\": reduced(terms[\"weights\"]),","+        \"train_rollout_logprob_abs_diff\": sum_of_sample_mean(abs_diff).clone().detach(),","+    }","+    return loss, reported_loss"],"newLines":386,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/miles/backends/training_utils/loss/hub/score_centering.py"}]}