{"files":[{"hunks":[{"lines":["+\"\"\"Score-centering policy loss (Marek & Ryabinin, arXiv:2609.20807).","+","+Per generated token, with trainer distribution ``p``, recorded sampler","+distribution ``q`` (top-k head ``H`` plus the tail reconstruction of eq. 7),","+importance weights ``w_v = f(p_v / q_v)`` and detached coefficients,","+","+    L = -A * ( w_y log p_y - sum_{v in H} (q_v w_v - alpha p_v) log p_v )","+","+so ``-grad L = A * (w_y s_y - E_q^[w s])``: the score is centered under the","+behaviour policy at every prefix. When sampling-support replay is active,","+``p`` and ``q`` are both the distributions over the token's recorded","+sampling support (the same scoring contract as the policy loss); otherwise","+they are the full tempered softmaxes. Everything the estimator needs from","+the sampler (head candidates, the sampled token's recorded log-prob) is","+read from the rollout batch, never rescored.","+","+Memory: candidate log-probs are gathered from the vocab-parallel logits","+shard and the softmax normaliser is computed in row chunks; a custom","+autograd function recomputes probabilities chunk-wise in backward instead","+of saving a dense ``[rows, vocab]`` log-softmax. Saved tensors are the","+logits themselves plus ``[rows, k]`` candidate/coefficient matrices.","+\"\"\"","+","+import math","+from argparse import Namespace","+from collections.abc import Callable","+","+import torch","+import torch.distributed as dist","+","+from miles.backends.training_utils.data.context_parallel import get_local_response_loss_masks","+from miles.backends.training_utils.data.sampling_mask import get_rollout_sampling_masks","+from miles.backends.training_utils.data.top_logprobs import get_rollout_top_logprobs","+from miles.backends.training_utils.loss.hub.logit_processors import _iter_response_chunks","+from miles.backends.training_utils.parallel import get_parallel_state","+from miles.utils.sampling_mask import RolloutSamplingMask","+from miles.utils.top_logprobs import RolloutTopLogprobs","+from miles.utils.types import RolloutBatch","+","+_TAIL_EPS = 1e-6","+_DENSE_ROW_CHUNK_CAP = 256","+","+","+def _is_weight_from_log_ratio(","+    log_ratio: torch.Tensor,","+    *,","+    is_mode: str,","+    tis_clip: float,","+    mis_low: float,","+    mis_high: float,","+) -> torch.Tensor:","+    \"\"\"The paper's ``f(r)`` evaluated from ``log r`` without overflow.\"\"\"","+    if is_mode == \"none\":","+        return torch.ones_like(log_ratio)","+    if is_mode == \"tis\":","+        return torch.exp(torch.clamp(log_ratio, max=math.log(tis_clip)))","+    if is_mode == \"mis\":","+        lo, hi = math.log(mis_low), math.log(mis_high)","+        inside = (log_ratio >= lo) & (log_ratio <= hi)","+        return torch.where(inside, torch.exp(torch.clamp(log_ratio, min=lo, max=hi)), torch.zeros_like(log_ratio))","+    raise ValueError(f\"unknown score-centering IS mode: {is_mode!r}\")","+","+","+def compute_score_centering_coefficients(","+    *,","+    log_probs_ext: torch.Tensor,","+    candidate_log_q: torch.Tensor,","+    candidate_valid: torch.Tensor,","+    rollout_log_q: torch.Tensor,","+    is_mode: str,","+    tis_clip: float,","+    mis_low: float,","+    mis_high: float,","+    eps: float = _TAIL_EPS,","+) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:","+    \"\"\"Detached coefficients of eq. 12 over the extended candidate columns.","+","+    Args:","+        log_probs_ext: ``[R, 1 + K]`` trainer log-probs (detached); column 0","+            is the sampled token, the rest are the head candidates.","+        candidate_log_q: ``[R, K]`` recorded sampler log-probs of the head.","+        candidate_valid: ``[R, K]`` bool mask of real (non-padding) candidates.","+        rollout_log_q: ``[R]`` recorded sampler log-prob of the sampled token.","+","+    Returns:","+        ``(coeffs, metrics)`` where ``coeffs`` is ``[R, 1 + K]`` with","+        ``coeffs[:, 0] = w_y`` and ``coeffs[:, 1:] = -(q_v w_v - alpha p_v)``,","+        so the per-token weighted score is ``(coeffs * log p_ext).sum(-1)``","+        under gradient. Metrics are per-token detached tensors.","+    \"\"\"","+    valid = candidate_valid.bool()","+    logp_cand = log_probs_ext[:, 1:]","+    p_cand = torch.where(valid, logp_cand.exp(), torch.zeros_like(logp_cand))","+    q_cand = torch.where(valid, candidate_log_q.exp(), torch.zeros_like(candidate_log_q))","+    w_cand = torch.where(","+        valid,","+        _is_weight_from_log_ratio(","+            logp_cand - candidate_log_q, is_mode=is_mode, tis_clip=tis_clip, mis_low=mis_low, mis_high=mis_high","+        ),","+        torch.zeros_like(logp_cand),","+    )","+    head_q_mass = q_cand.sum(dim=-1)","+    head_p_mass = p_cand.sum(dim=-1)","+    rho = torch.clamp(1 - head_q_mass, min=eps) / torch.clamp(1 - head_p_mass, min=eps)","+    alpha = rho * _is_weight_from_log_ratio(","+        -rho.log(), is_mode=is_mode, tis_clip=tis_clip, mis_low=mis_low, mis_high=mis_high","+    )","+    center_coeff = q_cand * w_cand - alpha.unsqueeze(-1) * p_cand","+    w_y = _is_weight_from_log_ratio(","+        log_probs_ext[:, 0] - rollout_log_q,","+        is_mode=is_mode,","+        tis_clip=tis_clip,","+        mis_low=mis_low,","+        mis_high=mis_high,","+    )","+    coeffs = torch.cat([w_y.unsqueeze(-1), -center_coeff], dim=-1)","+    metrics = {","+        \"w_y\": w_y.detach(),","+        \"rho\": rho.detach(),","+        \"head_q_mass\": head_q_mass.detach(),","+        \"head_p_mass\": head_p_mass.detach(),","+    }","+    return coeffs.detach(), metrics","+","+","+def _tp_all_reduce(tensor: torch.Tensor, tp_group, op) -> torch.Tensor:","+    if tp_group is not None and dist.get_world_size(tp_group) > 1:","+        dist.all_reduce(tensor, op=op, group=tp_group)","+    return tensor","+","+","+def _gather_candidate_logits(","+    logits: torch.Tensor, ids: torch.Tensor, *, vocab_start: int, tp_group","+) -> torch.Tensor:","+    \"\"\"Global-vocab candidate logits ``[R, K]`` from the local TP shard.\"\"\"","+    local_vocab = logits.size(-1)","+    cols = ids - vocab_start","+    is_local = (cols >= 0) & (cols < local_vocab)","+    gathered = logits.gather(1, cols.clamp(0, local_vocab - 1)).float()","+    gathered = torch.where(is_local, gathered, torch.zeros_like(gathered))","+    return _tp_all_reduce(gathered, tp_group, dist.ReduceOp.SUM)","+","+","+def _gather_flat_logits(","+    logits: torch.Tensor, rows: torch.Tensor, ids: torch.Tensor, *, vocab_start: int, tp_group","+) -> torch.Tensor:","+    \"\"\"Global-vocab logits for flat ``(row, id)`` entries from the local TP shard.\"\"\"","+    local_vocab = logits.size(-1)","+    cols = ids - vocab_start","+    is_local = (cols >= 0) & (cols < local_vocab)","+    gathered = logits[rows, cols.clamp(0, local_vocab - 1)].float()","+    gathered = torch.where(is_local, gathered, torch.zeros_like(gathered))","+    return _tp_all_reduce(gathered, tp_group, dist.ReduceOp.SUM)","+","+","+def _dense_lse(logits: torch.Tensor, *, temperature: float, tp_group, row_chunk: int) -> torch.Tensor:","+    \"\"\"Row log-sum-exp over the full (TP-sharded, padded) vocabulary.\"\"\"","+    lses = []","+    for chunk in logits.split(row_chunk, dim=0):","+        x = chunk.to(torch.float32, copy=True)","+        if temperature != 1.0:","+            x.div_(temperature)","+        row_max = _tp_all_reduce(x.amax(dim=-1), tp_group, dist.ReduceOp.MAX)","+        x.sub_(row_max.unsqueeze(-1)).exp_()","+        row_sum = _tp_all_reduce(x.sum(dim=-1), tp_group, dist.ReduceOp.SUM)","+        lses.append(row_max + row_sum.log())","+    return torch.cat(lses, dim=0) if len(lses) > 1 else lses[0]","+","+","+def _support_lse(","+    logits: torch.Tensor,","+    support_ids: torch.Tensor,","+    support_offsets: torch.Tensor,","+    *,","+    vocab_start: int,","+    temperature: float,","+    tp_group,","+) -> torch.Tensor:","+    \"\"\"Row log-sum-exp restricted to each row's recorded sampling support.\"\"\"","+    rows = _support_row_indices(support_offsets, device=logits.device)","+    values = _gather_flat_logits(logits, rows, support_ids, vocab_start=vocab_start, tp_group=tp_group)","+    if temperature != 1.0:","+        values = values / temperature","+    num_rows = support_offsets.numel() - 1","+    row_max = torch.full((num_rows,), float(\"-inf\"), dtype=torch.float32, device=logits.device)","+    row_max.scatter_reduce_(0, rows, values, reduce=\"amax\", include_self=True)","+    row_sum = torch.zeros_like(row_max)","+    row_sum.index_add_(0, rows, torch.exp(values - row_max[rows]))","+    return row_max + row_sum.log()","+","+","+def _support_row_indices(support_offsets: torch.Tensor, *, device) -> torch.Tensor:","+    lengths = support_offsets[1:] - support_offsets[:-1]","+    return torch.repeat_interleave(torch.arange(lengths.numel(), device=device), lengths.to(device))","+","+","+def _detached_log_probs_ext(","+    logits_chunk: torch.Tensor,","+    ext_ids: torch.Tensor,","+    *,","+    support_ids: torch.Tensor | None,","+    support_offsets: torch.Tensor | None,","+    vocab_start: int,","+    temperature: float,","+    tp_group,","+    row_chunk: int,","+) -> tuple[torch.Tensor, torch.Tensor]:","+    \"\"\"Detached ``log p`` for the extended candidate columns plus the row LSE.\"\"\"","+    with torch.no_grad():","+        logits = logits_chunk.detach()","+        if support_ids is None:","+            lse = _dense_lse(logits, temperature=temperature, tp_group=tp_group, row_chunk=row_chunk)","+        else:","+            lse = _support_lse(","+                logits,","+                support_ids,","+                support_offsets,","+                vocab_start=vocab_start,","+                temperature=temperature,","+                tp_group=tp_group,","+            )","+        ext_logits = _gather_candidate_logits(logits, ext_ids, vocab_start=vocab_start, tp_group=tp_group)","+        if temperature != 1.0:","+            ext_logits = ext_logits / temperature","+        return ext_logits - lse.unsqueeze(-1), lse"],"newLines":225,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/miles/backends/training_utils/loss/hub/score_centering.py"}]}