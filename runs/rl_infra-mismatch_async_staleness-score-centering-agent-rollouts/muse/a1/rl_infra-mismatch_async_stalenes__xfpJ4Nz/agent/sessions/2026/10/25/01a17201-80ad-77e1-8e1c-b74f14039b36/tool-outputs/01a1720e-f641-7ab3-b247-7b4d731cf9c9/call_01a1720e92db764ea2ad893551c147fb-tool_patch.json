{"files":[{"hunks":[{"lines":["+\"\"\"Score-centering loss (arXiv:2609.20807) against a naive full-softmax reference.","+","+The reference implements eq. 12 of the reading notes directly with","+``torch.log_softmax`` over a small vocabulary; the production loss must match","+its value and its gradient w.r.t. logits, for every IS mode, with and without","+sampling-support replay, including a sampled token that is outside the head.","+\"\"\"","+","+from __future__ import annotations","+","+import math","+from argparse import Namespace","+","+import pytest","+import torch","+","+from miles.backends.training_utils.data.context_parallel import get_sum_of_sample_mean","+from miles.backends.training_utils.loss.hub.losses import get_loss_function","+from miles.backends.training_utils.loss.hub.score_centering import (","+    compute_score_centering_coefficients,","+)","+","+from .loss_test_utils import make_parallel_state","+","+VOCAB = 11","+K = 4","+TEMP = 0.7","+","+","+def _f(log_ratio: torch.Tensor, mode: str) -> torch.Tensor:","+    if mode == \"none\":","+        return torch.ones_like(log_ratio)","+    if mode == \"tis\":","+        return torch.clamp(log_ratio.exp(), max=2.0)","+    r = log_ratio.exp()","+    return torch.where((r >= 0.5) & (r <= 5.0), r, torch.zeros_like(r))","+","+","+def _reference_per_token_loss(","+    logits_rows: torch.Tensor,","+    sampled: torch.Tensor,","+    cand_ids: torch.Tensor,","+    cand_log_q: torch.Tensor,","+    cand_valid: torch.Tensor,","+    rollout_log_q: torch.Tensor,","+    advantages: torch.Tensor,","+    mode: str,","+    support_ids: torch.Tensor | None = None,","+) -> torch.Tensor:","+    \"\"\"Eq. 12 with a dense softmax; ``support_ids`` restricts the universe to one support set per row.\"\"\"","+    scaled = logits_rows / TEMP","+    if support_ids is not None:","+        mask = torch.zeros_like(scaled, dtype=torch.bool)","+        mask.scatter_(1, support_ids, True)","+        scaled = scaled.masked_fill(~mask, float(\"-inf\"))","+    log_p = torch.log_softmax(scaled, dim=-1)","+    with torch.no_grad():","+        p = log_p.exp()","+        logp_cand = log_p.gather(1, cand_ids)","+        p_cand = logp_cand.exp() * cand_valid","+        q_cand = cand_log_q.exp() * cand_valid","+        w_cand = _f(logp_cand - cand_log_q, mode) * cand_valid","+        rho = torch.clamp(1 - q_cand.sum(-1), min=1e-6) / torch.clamp(1 - p_cand.sum(-1), min=1e-6)","+        alpha = rho * _f(-rho.log(), mode)","+        coeff = q_cand * w_cand - alpha.unsqueeze(-1) * p_cand","+        logp_y_det = log_p.gather(1, sampled.unsqueeze(-1)).squeeze(-1)","+        w_y = _f(logp_y_det - rollout_log_q, mode)","+        _ = p","+    logp_y = log_p.gather(1, sampled.unsqueeze(-1)).squeeze(-1)","+    logp_cand = log_p.gather(1, cand_ids)","+    return -advantages * (w_y * logp_y - (coeff * logp_cand * cand_valid).sum(-1))","+","+","+def _make_case(seed: int = 0, support: bool = False):","+    g = torch.Generator().manual_seed(seed)","+    prompt_len, resp_len = 3, 5","+    total = prompt_len + resp_len","+    tokens = torch.randint(0, VOCAB, (total,), generator=g)","+    sampled = tokens[-resp_len:]","+    logits = torch.randn(1, total, VOCAB, generator=g)","+    # Sampler distribution q: a different (fp8-mismatched) softmax.","+    q_logits = logits[0, prompt_len - 1 : total - 1] + 0.7 * torch.randn(resp_len, VOCAB, generator=g)","+    log_q_full = torch.log_softmax(q_logits / TEMP, dim=-1)","+    support_ids = None","+    if support:","+        support_ids = log_q_full.topk(6, dim=-1).indices","+        in_support = torch.zeros(resp_len, VOCAB, dtype=torch.bool).scatter(1, support_ids, True)","+        # The sampled tokens must lie in the support; move any outsider to the support head.","+        sampled = torch.where(in_support.gather(1, sampled.unsqueeze(-1)).squeeze(-1), sampled, support_ids[:, 0])","+        tokens[-resp_len:] = sampled","+        renorm = torch.logsumexp(log_q_full.masked_fill(~in_support, float(\"-inf\")), dim=-1, keepdim=True)","+        log_q_full = log_q_full - renorm","+    top = log_q_full.topk(K, dim=-1)","+    cand_ids, cand_log_q = top.indices.clone(), top.values.clone()","+    # Row 0: drop the sampled token from the head if present (sampled-not-in-head case).","+    cand_ids[0] = torch.tensor([v for v in range(VOCAB) if v != int(sampled[0])][:K])","+    cand_log_q[0] = log_q_full[0].gather(0, cand_ids[0])","+    cand_valid = torch.ones(resp_len, K, dtype=torch.bool)","+    cand_valid[-1, -1] = False  # ragged head: last row has K-1 candidates","+    rollout_log_q = log_q_full.gather(1, sampled.unsqueeze(-1)).squeeze(-1)","+    advantages = torch.tensor([1.5, -0.5, 2.0, 0.25, -1.0])","+    loss_mask = torch.tensor([1.0, 1.0, 1.0, 0.0, 1.0])","+    return locals()","+","+","+def _args(**overrides) -> Namespace:","+    base = dict(","+        loss_type=\"score_centering\",","+        qkv_format=\"thd\",","+        rollout_temperature=TEMP,","+        allgather_cp=False,","+        true_on_policy_mode=False,","+        log_probs_chunk_size=2,","+        debug_unified_grad_fused_logprob=False,","+        use_sampling_support_replay=False,","+        score_centering_is=\"none\",","+        score_centering_tis_clip=2.0,","+        score_centering_mis_low=0.5,","+        score_centering_mis_high=5.0,","+        calculate_per_token_loss=True,","+        entropy_coef=0.0,","+        observe_training_entropy=False,","+        use_kl_loss=False,","+    )","+    base.update(overrides)","+    return Namespace(**base)","+","+","+def _batch(case, support: bool = False) -> dict:","+    resp_len = case[\"resp_len\"]","+    cand_ids, cand_log_q, cand_valid = case[\"cand_ids\"], case[\"cand_log_q\"], case[\"cand_valid\"]","+    flat_ids, flat_vals, offsets = [], [], [0]","+    for r in range(resp_len):","+        keep = cand_valid[r]","+        flat_ids.extend(cand_ids[r][keep].tolist())","+        flat_vals.extend(cand_log_q[r][keep].tolist())","+        offsets.append(len(flat_ids))","+    batch = dict(","+        unconcat_tokens=[case[\"tokens\"]],","+        total_lengths=[case[\"total\"]],","+        response_lengths=[resp_len],","+        loss_masks=[case[\"loss_mask\"]],","+        advantages=[case[\"advantages\"]],","+        rollout_log_probs=[case[\"rollout_log_q\"]],","+        rollout_top_logprobs_ids=[torch.tensor(flat_ids, dtype=torch.int32)],","+        rollout_top_logprobs_log_probs=[torch.tensor(flat_vals, dtype=torch.float32)],","+        rollout_top_logprobs_offsets=[torch.tensor(offsets, dtype=torch.int64)],","+    )","+    if support:","+        sup = case[\"support_ids\"]","+        batch[\"rollout_sampling_mask_ids\"] = [sup.flatten().to(torch.int32)]","+        batch[\"rollout_sampling_mask_offsets\"] = [torch.arange(0, sup.numel() + 1, sup.size(1), dtype=torch.int64)]","+    return batch","+","+","<redacted-email>(\"mode\", [\"none\", \"tis\", \"mis\"])","<redacted-email>(\"support\", [False, True])","+def test_score_centering_matches_reference(mode, support):","+    make_parallel_state()","+    case = _make_case(support=support)","+    args = _args(score_centering_is=mode, use_sampling_support_replay=support)","+    batch = _batch(case, support=support)","+    som = get_sum_of_sample_mean(","+        batch[\"total_lengths\"], batch[\"response_lengths\"], batch[\"loss_masks\"], True, \"thd\", None","+    )","+    logits = case[\"logits\"].clone().requires_grad_(True)","+    loss, metrics = get_loss_function(args)(args, batch, logits, som)","+    loss.backward()","+","+    logits_ref = case[\"logits\"].clone().requires_grad_(True)","+    rows = logits_ref[0, case[\"prompt_len\"] - 1 : case[\"total\"] - 1]","+    per_token = _reference_per_token_loss(","+        rows,","+        case[\"sampled\"],","+        case[\"cand_ids\"],","+        case[\"cand_log_q\"],","+        case[\"cand_valid\"].float(),","+        case[\"rollout_log_q\"],","+        case[\"advantages\"],","+        mode,","+        support_ids=case[\"support_ids\"] if support else None,","+    )","+    expected = som(per_token)","+    expected.backward()","+","+    torch.testing.assert_close(loss.detach(), expected.detach(), atol=1e-5, rtol=1e-5)","+    torch.testing.assert_close(logits.grad, logits_ref.grad, atol=1e-5, rtol=1e-5)","+    assert set(metrics) >= {\"loss\", \"pg_loss\"}","+","+","+def test_coefficients_on_policy_recovers_reinforce_gradient():","+    # p == q, vanilla: the centered term is a no-op gradient-wise, even with a top-k head.","+    g = torch.Generator().manual_seed(3)","+    logp = torch.log_softmax(torch.randn(4, VOCAB, generator=g), dim=-1)","+    cand_ids = logp.topk(K, dim=-1).indices","+    logp_cand = logp.gather(1, cand_ids)","+    sampled = torch.tensor([0, 3, 5, VOCAB - 1])","+    logp_ext = torch.cat([logp.gather(1, sampled.unsqueeze(-1)), logp_cand], dim=1)","+    coeffs, _ = compute_score_centering_coefficients(","+        log_probs_ext=logp_ext,","+        candidate_log_q=logp_cand,","+        candidate_valid=torch.ones(4, K, dtype=torch.bool),","+        rollout_log_q=logp.gather(1, sampled.unsqueeze(-1)).squeeze(-1),","+        is_mode=\"none\",","+        tis_clip=2.0,","+        mis_low=0.5,","+        mis_high=5.0,","+    )","+    # Combined sparse coefficients must be the one-hot of the sampled token over the union columns.","+    ext_ids = torch.cat([sampled.unsqueeze(-1), cand_ids], dim=1)","+    combined = torch.zeros(4, VOCAB).scatter_add(1, ext_ids, coeffs)","+    one_hot = torch.zeros(4, VOCAB).scatter(1, sampled.unsqueeze(-1), 1.0)","+    torch.testing.assert_close(combined, one_hot, atol=1e-6, rtol=0)","+    torch.testing.assert_close(coeffs.sum(-1), torch.ones(4), atol=1e-6, rtol=0)","+","+","+def test_coefficients_plain_is_limit():","+    # f(r) = r sanity from the notes is implicit: for MIS with a huge window every","+    # in-window candidate contributes q*w - alpha*p with alpha == 1 when rho == 1.","+    logp_cand = torch.tensor([[-0.5, -2.0]])","+    log_q = torch.tensor([[math.log(0.5), math.log(0.5)]])","+    logp_ext = torch.tensor([[-0.5, -0.5, -2.0]])","+    coeffs, metrics = compute_score_centering_coefficients(","+        log_probs_ext=logp_ext,","+        candidate_log_q=log_q,","+        candidate_valid=torch.ones(1, 2, dtype=torch.bool),","+        rollout_log_q=torch.tensor([math.log(0.5)]),","+        is_mode=\"mis\",","+        tis_clip=2.0,","+        mis_low=0.01,","+        mis_high=100.0,","+    )","+    assert metrics[\"head_q_mass\"].shape == (1,)","+    assert torch.isfinite(coeffs).all()"],"newLines":234,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/tests/fast/backends/training_utils/loss/test_score_centering.py"}]}