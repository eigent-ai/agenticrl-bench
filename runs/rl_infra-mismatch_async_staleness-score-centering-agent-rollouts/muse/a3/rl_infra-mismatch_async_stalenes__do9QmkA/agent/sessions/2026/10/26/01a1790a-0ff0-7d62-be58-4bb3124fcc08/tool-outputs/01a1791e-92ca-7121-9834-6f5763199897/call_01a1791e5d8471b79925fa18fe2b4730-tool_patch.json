{"files":[{"hunks":[{"lines":["         grad.scatter_add_(1, y_idx.unsqueeze(1), y_values.unsqueeze(1))"," ","         return (grad,) + no_grads","+","+","+def _as_row_tensor(value, *, rows: int, width: int, dtype: torch.dtype, device) -> torch.Tensor:","+    tensor = torch.as_tensor(value, dtype=dtype, device=device)","+    if tensor.ndim == 1 and tensor.numel() == 0:","+        tensor = tensor.reshape(rows, width)","+    if tensor.shape != (rows, width) and not (rows == 0 and tensor.numel() == 0):","+        raise ValueError(f\"top log-prob tensor shape {tuple(tensor.shape)} != ({rows}, {width})\")","+    return tensor","+","+","+def get_score_centering_terms(","+    logits: torch.Tensor,","+    *,","+    args: Namespace,","+    unconcat_tokens: list[torch.Tensor],","+    total_lengths: list[int],","+    response_lengths: list[int],","+    top_logprob_ids: Sequence,","+    top_logprobs: Sequence,","+    rollout_log_probs: Sequence,","+    max_seq_lens: list[int] | None = None,","+    rollout_sampling_mask: Sequence | None = None,","+) -> dict[str, list[torch.Tensor]]:","+    \"\"\"Per-sample score-centering surrogates and sampled-token log-probs.","+","+    Row order follows `_iter_response_chunks`, i.e. the same local (CP-sliced)","+    order as the batch's `rollout_log_probs`/advantages: the candidate and","+    selected-log-prob rows are consumed row-by-row in that order.","+    \"\"\"","+    is_mode = getattr(args, \"score_centering_is\", \"none\")","+    if is_mode not in _IS_MODES:","+        raise ValueError(f\"unknown --score-centering-is: {is_mode!r}\")","+    tis_clip = float(getattr(args, \"score_centering_tis_clip\", 2.0))","+    mis_low = float(getattr(args, \"score_centering_mis_low\", 0.5))","+    mis_high = float(getattr(args, \"score_centering_mis_high\", 5.0))","+    temperature = 1.0 if args.true_on_policy_mode else args.rollout_temperature","+    chunk_size = args.log_probs_chunk_size","+    width = int(getattr(args, \"rollout_top_logprobs_num\", 0) or 0)","+","+    parallel_state = get_parallel_state()","+    base_list: list[torch.Tensor] = []","+    logp_list: list[torch.Tensor] = []","+    chunks = _iter_response_chunks(","+        logits,","+        args=args,","+        unconcat_tokens=unconcat_tokens,","+        total_lengths=total_lengths,","+        response_lengths=response_lengths,","+        max_seq_lens=max_seq_lens,","+        include_response_indices=rollout_sampling_mask is not None,","+    )","+    for sample_index, (logits_chunk, tokens_chunk, response_indices) in enumerate(chunks):","+        rows = logits_chunk.size(0)","+        head_ids = _as_row_tensor(","+            top_logprob_ids[sample_index], rows=rows, width=width, dtype=torch.long, device=logits.device","+        )","+        head_logq = _as_row_tensor(","+            top_logprobs[sample_index], rows=rows, width=width, dtype=torch.float32, device=logits.device","+        )","+        selected_logq = torch.as_tensor(rollout_log_probs[sample_index], dtype=torch.float32, device=logits.device)","+        if selected_logq.shape != (rows,):","+            raise ValueError(","+                f\"rollout_log_probs shape {tuple(selected_logq.shape)} != ({rows},) for sample {sample_index}\"","+            )","+        if rows == 0:","+            empty = logits.new_zeros((0,), dtype=torch.float32)","+            base_list.append(empty)","+            logp_list.append(empty.clone())","+            continue","+","+        response_indices = list(response_indices)","+        step = chunk_size if chunk_size and chunk_size > 0 else rows","+        bases, logps = [], []","+        for start in range(0, rows, step):","+            end = min(start + step, rows)","+            sub_logits = logits_chunk[start:end]","+            chunk = _upcast_chunk_to_fp32(sub_logits.contiguous(), temperature)","+            if rollout_sampling_mask is not None:","+                sampling_mask = build_local_sampling_mask(","+                    sub_logits,","+                    rollout_sampling_mask[sample_index],","+                    response_indices[start:end],","+                    tp_rank=parallel_state.tp.rank,","+                )","+                chunk.masked_fill_(~sampling_mask, float(\"-inf\"))","+            base, logp = _ScoreCenteringChunk.apply(","+                chunk,","+                tokens_chunk[start:end].to(torch.long),","+                head_ids[start:end],","+                head_logq[start:end],","+                selected_logq[start:end],","+                parallel_state.tp.group,","+                parallel_state.tp.rank,","+                is_mode,","+                tis_clip,","+                mis_low,","+                mis_high,","+            )","+            bases.append(base)","+            logps.append(logp)","+        base_list.append(bases[0] if len(bases) == 1 else torch.cat(bases, dim=0))","+        logp_list.append(logps[0] if len(logps) == 1 else torch.cat(logps, dim=0))","+","+    return {\"sc_losses\": base_list, \"log_probs\": logp_list}"],"newLines":108,"newStart":166,"oldLines":3,"oldStart":166}],"path":"/app/miles/miles/backends/training_utils/loss/hub/score_centering.py"}]}