size 4096
header b'\r\x00\x00\x00\n\x0fI\x00\x0f\xf0\x0f\xdf\x0f\xce\x0f\xbd'
words [b'testword09', b'testword08', b'testword07', b'testword06', b'testword052', b'testword04', b'testword03', b'testword02', b'testword01', b'testword00']
unique [b'testword00', b'testword01', b'testword02', b'testword03', b'testword04', b'testword052', b'testword06', b'testword07', b'testword08', b'testword09']
/usr/bin/sqlite3
#!/bin/bash

# Install curl
apt-get update
apt-get install -y curl

# Install uv
curl -LsSf https://astral.sh/uv/0.9.5/install.sh | sh

source $HOME/.local/bin/env

# Check if we're in a valid working directory
if [ "$PWD" = "/" ]; then
    echo "Error: No working directory set. Please set a WORKDIR in your Dockerfile before running this script."
    exit 1
fi

uvx \
  -p 3.13 \
  -w pytest==8.4.1 \
