{"files":[{"hunks":[{"lines":["+\"\"\"Generate: run each episode through Miles' default agentic generate, with feedback conditioning for half of","+each prompt group (by sample index parity) once an earlier attempt on the same task has produced a checker","+report. After the episode, parse its verifier output with rlsdk.feedback, record the report for later steps,","+and annotate the sample(s) with the per-test pass fraction for the reward post-process.","+\"\"\"","+from __future__ import annotations","+","+import copy","+import logging","+from pathlib import Path","+","+from algo import state as _state","+","+logger = logging.getLogger(__name__)","+","+","+def _want_conditioned(sample) -> bool:","+    idx = getattr(sample, \"index\", None)","+    if idx is None:","+        idx = getattr(sample, \"rollout_id\", None)","+    return bool(idx is not None and int(idx) % 2 == 0)","+","+","+def _parse_trial(trial_dir, task_id):","+    \"\"\"(frac_passed or None, feedback_text or None) for one finished trial, via rlsdk.feedback only.\"\"\"","+    try:","+        from rlsdk.feedback import feedback_text, parse_verifier_dir","+        from rlsdk.paths import task_dir as _task_dir","+","+        parsed = parse_verifier_dir(Path(trial_dir) / \"verifier\")","+        if not parsed.get(\"ok\") or not parsed.get(\"n_tests\"):","+            return None, None","+        frac = float(parsed[\"n_passed\"]) / float(parsed[\"n_tests\"])","+        text = feedback_text(parsed, _task_dir(task_id)) if task_id else None","+        return frac, text","+    except Exception:  # noqa: BLE001 - annotation must never cost the episode","+        logger.warning(\"verifier parse failed for %s\", trial_dir, exc_info=True)","+        return None, None","+","+","+async def generate(input):","+    from miles.rollout.base_types import GenerateFnInput","+    from miles.rollout.generate_hub.agentic_tool_call import generate as _default_generate","+","+    sample = copy.deepcopy(input.sample)","+    meta = dict(sample.metadata or {})","+    task_id = meta.get(\"instance_id\")","+    conditioned = False","+    if task_id and _want_conditioned(sample):","+        text = _state.best_feedback(str(task_id))","+        if text:","+            meta[\"fcr_feedback\"] = text","+            conditioned = True","+    meta[\"fcr_conditioned\"] = conditioned","+    sample.metadata = meta","+    new_input = GenerateFnInput(state=input.state, sample=sample,","+                                sampling_params=input.sampling_params, evaluation=input.evaluation)","+","+    out = await _default_generate(new_input)","+","+    samples = out.samples if isinstance(out.samples, list) else [out.samples]","+    seen_trials = set()","+    for s in samples:","+        if s is None:","+            continue","+        m = s.metadata if isinstance(s.metadata, dict) else {}","+        m[\"fcr_conditioned\"] = conditioned","+        trial_dir = m.get(\"trial_dir\")","+        if trial_dir:","+            frac, text = _parse_trial(trial_dir, task_id)","+            m[\"fcr_frac\"] = frac","+            if trial_dir not in seen_trials:","+                seen_trials.add(trial_dir)","+                if task_id:","+                    _state.append_feedback(str(task_id), frac, text, conditioned)","+        else:","+            m.setdefault(\"fcr_frac\", None)","+        s.metadata = m","+    return out"],"newLines":79,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/plugin/algo/gen.py"}]}