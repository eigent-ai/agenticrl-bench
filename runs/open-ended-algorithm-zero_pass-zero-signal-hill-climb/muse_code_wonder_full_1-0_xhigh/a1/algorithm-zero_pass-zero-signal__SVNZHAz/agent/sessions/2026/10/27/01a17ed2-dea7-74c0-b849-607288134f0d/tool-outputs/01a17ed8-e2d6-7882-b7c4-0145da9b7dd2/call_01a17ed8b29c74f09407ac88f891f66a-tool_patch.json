{"files":[{"hunks":[{"lines":["+\"\"\"Cross-episode feedback store for feedback-conditioned retries.","+","+Every finished episode appends one JSON row (instance id, pass fraction, whether it fully passed, the checker","+report text rendered by rlsdk.feedback) to a file under the job's algo_state dir. A later episode of the same","+task can then be conditioned on the best-scoring report so far. All task identity comes from the episode's own","+metadata at runtime; nothing here names any task.","+\"\"\"","+from __future__ import annotations","+","+import fcntl","+import json","+import time","+from pathlib import Path","+","+from rlsdk import paths","+","+","+def _store() -> Path:","+    d = paths.job_out() / \"algo_state\"","+    d.mkdir(parents=True, exist_ok=True)","+    return d / \"feedback.jsonl\"","+","+","+def record(rec: dict) -> None:","+    try:","+        rec = {\"t\": time.time(), **rec}","+        with open(_store(), \"a\") as f:","+            fcntl.flock(f, fcntl.LOCK_EX)","+            f.write(json.dumps(rec) + \"\\n\")","+            fcntl.flock(f, fcntl.LOCK_UN)","+    except OSError:","+        pass","+","+","+def _rows() -> list[dict]:","+    try:","+        txt = _store().read_text()","+    except OSError:","+        return []","+    out = []","+    for line in txt.splitlines():","+        try:","+            out.append(json.loads(line))","+        except ValueError:","+            continue","+    return out","+","+","+def best_note(instance_id: str) -> tuple[str | None, bool]:","+    \"\"\"(feedback text of the best-scoring failed attempt on this task, whether the task was ever passed).\"\"\"","+    best_text, best_frac, solved = None, -1.0, False","+    for r in _rows():","+        if r.get(\"instance_id\") != instance_id:","+            continue","+        if r.get(\"passed\"):","+            solved = True","+        text = r.get(\"feedback_text\")","+        frac = r.get(\"frac\")","+        if text and frac is not None and frac >= best_frac:","+            best_text, best_frac = text, float(frac)","+    return best_text, solved"],"newLines":61,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/plugin/algo/state.py"}]}