{"files":[{"hunks":[{"lines":["+\"\"\"Agent-function hook: the default harness agent, with the trial config patched (once, per process) so that an","+episode whose metadata carries a feedback_note runs algo.fagent.FeedbackMiniAgent with that note. The note travels","+in the per-episode metadata dict, so concurrent trials in one worker never mix notes up.","+\"\"\"","+from __future__ import annotations","+","+_patched = False","+","+","+def _ensure_patched() -> None:","+    global _patched","+    if _patched:","+        return","+    import harbor_agent_function as haf","+    import examples.terminal_agent.agent as ta  # noqa: F401  (importing it installs the harness build_trial_config)","+","+    orig = haf.build_trial_config","+","+    def build(metadata, session_url, request_kwargs):","+        cfg = orig(metadata, session_url, request_kwargs)","+        note = (metadata or {}).get(\"feedback_note\")","+        if note:","+            cfg.agent.import_path = \"algo.fagent:FeedbackMiniAgent\"","+            cfg.agent.kwargs = {**(cfg.agent.kwargs or {}), \"extra_note\": note}","+        return cfg","+","+    haf.build_trial_config = build","+    _patched = True","+","+","+async def run(base_url, prompt, request_kwargs=None, metadata=None, **kwargs):","+    _ensure_patched()","+    from examples.terminal_agent.agent import run as _default_run","+","+    out = await _default_run(base_url=base_url, prompt=prompt, request_kwargs=request_kwargs, metadata=metadata)","+    if isinstance(out, dict):","+        out = {**out, \"conditioned\": int((metadata or {}).get(\"conditioned\") or 0)}","+    return out"],"newLines":38,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/plugin/algo/agent.py"}]}