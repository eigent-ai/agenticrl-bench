{"files":[{"hunks":[{"lines":["+\"\"\"Per-task checker-feedback state shared between generate / agent / reward hooks.","+","+State lives on disk under rlsdk.paths.job_out()/algo_state so it survives plug-in","+hot reloads and is visible to rollout workers (generate) and the trainer driver","+(reward hook). The only text ever stored here is checker reports produced by","+rlsdk.feedback.feedback_text (test names and counts), seeded -- in the same form --","+from the base model's screening feedback file when present.","+\"\"\"","+from __future__ import annotations","+","+import collections","+import json","+import os","+from pathlib import Path","+","+_SCREENING = Path(\"/opt/task/data/eval/screening_feedback.jsonl\")","+_cache: dict = {\"mtime\": None, \"data\": {}, \"seed\": None, \"control_mtime\": None, \"control\": {}}","+","+","+def state_dir() -> Path:","+    try:","+        from rlsdk import paths","+        d = paths.job_out() / \"algo_state\"","+    except Exception:","+        d = Path(os.environ.get(\"RL_JOB_OUT\", \"/tmp\")) / \"algo_state\"","+    try:","+        d.mkdir(parents=True, exist_ok=True)","+    except OSError:","+        pass","+    return d","+","+","+def _load_feedback() -> dict:","+    p = state_dir() / \"feedback.json\"","+    try:","+        m = p.stat().st_mtime","+    except OSError:","+        return {}","+    if _cache[\"mtime\"] != m:","+        try:","+            _cache[\"data\"] = json.loads(p.read_text())","+            _cache[\"mtime\"] = m","+        except (OSError, ValueError):","+            return {}","+    return _cache[\"data\"]","+","+","+def _load_seed() -> dict:","+    if _cache[\"seed\"] is None:","+        seed: dict = {}","+        try:","+            cnt: dict = collections.defaultdict(collections.Counter)","+            for line in _SCREENING.read_text().splitlines():","+                try:","+                    r = json.loads(line)","+                except ValueError:","+                    continue","+                if r.get(\"task_id\") and r.get(\"text\"):","+                    cnt[r[\"task_id\"]][r[\"text\"]] += 1","+            seed = {t: c.most_common(1)[0][0] for t, c in cnt.items()}","+        except OSError:","+            seed = {}","+        _cache[\"seed\"] = seed","+    return _cache[\"seed\"]","+","+","+def get_feedback(task_id: str) -> str | None:","+    if not task_id:","+        return None","+    ent = _load_feedback().get(task_id)","+    if ent and ent.get(\"text\"):","+        return ent[\"text\"]","+    return _load_seed().get(task_id)","+","+","+def get_control() -> dict:","+    p = state_dir() / \"control.json\"","+    try:","+        m = p.stat().st_mtime","+    except OSError:","+        return {}","+    if _cache[\"control_mtime\"] != m:","+        try:","+            _cache[\"control\"] = json.loads(p.read_text())","+            _cache[\"control_mtime\"] = m","+        except (OSError, ValueError):","+            return {}","+    return _cache[\"control\"]","+","+","+def p_conditioned() -> float:","+    try:","+        return max(0.0, min(1.0, float(get_control().get(\"p_cond\", 0.5))))","+    except (TypeError, ValueError):","+        return 0.5","+","+","+def update_feedback(updates: dict) -> None:","+    \"\"\"updates: {task_id: {\"text\": str, \"best_frac\": float}}; keeps the best-so-far entry.\"\"\"","+    if not updates:","+        return","+    p = state_dir() / \"feedback.json\"","+    try:","+        cur = json.loads(p.read_text()) if p.is_file() else {}","+    except (OSError, ValueError):","+        cur = {}","+    for tid, ent in updates.items():","+        old = cur.get(tid) or {}","+        merged = {\"text\": ent.get(\"text\") or old.get(\"text\"),","+                  \"best_frac\": max(float(old.get(\"best_frac\") or 0.0), float(ent.get(\"best_frac\") or 0.0))}","+        # Prefer the newest text when it comes from an attempt at least as good as the stored one.","+        if ent.get(\"text\") and float(ent.get(\"frac\") or 0.0) >= float(old.get(\"text_frac\") or 0.0):","+            merged[\"text\"] = ent[\"text\"]","+            merged[\"text_frac\"] = float(ent.get(\"frac\") or 0.0)","+        else:","+            merged[\"text_frac\"] = float(old.get(\"text_frac\") or 0.0)","+        cur[tid] = merged","+    try:","+        tmp = p.with_suffix(\".json.tmp\")","+        tmp.write_text(json.dumps(cur))","+        tmp.replace(p)","+        _cache[\"mtime\"] = None","+    except OSError:","+        pass","+","+","+def log_stats(rows: list) -> None:","+    try:","+        with open(state_dir() / \"stats.jsonl\", \"a\") as f:","+            for r in rows:","+                f.write(json.dumps(r) + \"\\n\")","+    except OSError:","+        pass"],"newLines":133,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/plugin/algo/state.py"}]}