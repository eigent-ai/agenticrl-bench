{"files":[{"hunks":[{"lines":["+import torch, sys, json","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+stok=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B')","+qtok=AutoTokenizer.from_pretrained('/models/Qwen3-8B')","+ftok=AutoTokenizer.from_pretrained('/models/Falcon-H1R-7B')","+def show(kind, idx, nmsg=None):","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt', map_location='cpu', weights_only=True)","+    r=d['samples'][idx]; md=r['metadata']; msgs=md['messages'][:nmsg] if nmsg else md['messages']","+    print('#'*30, kind, idx, 'tools?', bool(md.get('tools')))","+    print('--- STUDENT decoded tokens (first 2500 chars)')","+    print(repr(stok.decode(r['tokens'])[:2500]))","+    for name,tok,kw in [('Qwen3',qtok,{'enable_thinking': kind=='terminus_think'}), ('Falcon',ftok,{})]:","+        try:","+            txt=tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=False, tools=md.get('tools'), **kw)","+            print(f'--- {name} full render (first 2500 of {len(txt)})')","+            print(repr(txt[:2500]))","+            print(f'--- {name} render tail')","+            print(repr(txt[-800:]))","+        except Exception as e:","+            print(name, 'RENDER ERROR', type(e).__name__, e)","+    print('--- STUDENT decoded tail')","+    print(repr(stok.decode(r['tokens'])[-800:]))","+show('sql',0)","+show('terminus_think',0)","+show('mswea',0)"],"newLines":26,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze5.py"}]}