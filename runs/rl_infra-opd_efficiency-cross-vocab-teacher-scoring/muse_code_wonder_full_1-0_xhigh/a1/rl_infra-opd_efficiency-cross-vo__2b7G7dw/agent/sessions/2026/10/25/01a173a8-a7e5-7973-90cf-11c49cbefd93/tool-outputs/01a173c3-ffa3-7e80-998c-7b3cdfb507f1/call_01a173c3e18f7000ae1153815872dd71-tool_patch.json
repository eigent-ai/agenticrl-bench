{"files":[{"hunks":[{"lines":["+import argparse, asyncio, sys","+sys.path.insert(0,'/app/miles')","+import torch","+from examples.terminal_opd import teacher_scoring, reward","+from miles.utils.types import Sample","+from transformers import AutoTokenizer","+stok=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B')","+","+def args_for(tpath, kw, port):","+    return argparse.Namespace(hf_checkpoint='/models/Qwen3.5-2B', rm_url=f'http://127.0.0.1:{port}/generate',","+        teacher_tokenizer_path=tpath, opd_prompt_messages_key='messages', opd_teacher_chat_template_kwargs=kw,","+        opd_teacher_timeout=60, opd_teacher_retries=0, opd_teacher_concurrency=4,","+        advantage_estimator='grpo', rewards_normalization=True, grpo_std_normalization=True)","+","+async def main():","+    # 1) no stored messages: single-turn list prompt + response","+    prompt=[{\"role\":\"user\",\"content\":\"What is 2+2? Answer briefly.\"}]","+    prompt_text=stok.apply_chat_template(prompt, tokenize=False, add_generation_prompt=True, enable_thinking=False)","+    resp=\"4<|im_end|>\"","+    ptok=stok.encode(prompt_text, add_special_tokens=False); rtok=stok.encode(resp, add_special_tokens=False)","+    s=Sample(index=999, prompt=prompt, tokens=ptok+rtok, response=resp, response_length=len(rtok),","+             loss_mask=[1]*len(rtok), rollout_log_probs=[-0.5]*len(rtok), metadata={\"reward\":1.0}, status=Sample.Status.COMPLETED)","+    a=args_for('/models/Qwen3-8B', {'enable_thinking': False}, 30020)","+    out=await reward.reward_func(a, s)","+    s.reward=out","+    raw, rew = reward.post_process_rewards(a, [s])","+    print('legacy no-messages: teacher_log_probs', s.teacher_log_probs.tolist(), 'rollout', s.rollout_log_probs, 'raw', raw, 'fallback', s.metadata.get('opd_teacher_fallback'))","+    assert len(s.teacher_log_probs)==len(rtok)","+","+    # 2) sql sample with tools removed from metadata (teacher cannot render tool defs path)","+    d=torch.load('/app/data/rollouts/sql/rollout_0.pt', map_location='cpu', weights_only=True)","+    s2=Sample.from_dict(d['samples'][2]); s2.metadata=dict(s2.metadata); s2.metadata['tools']=None","+    a2=args_for('/models/Falcon-H1R-7B', {}, 30022)","+    out2=await reward.reward_func(a2, s2); s2.reward=out2","+    reward.post_process_rewards(a2,[s2]); s2.validate()","+    sig=sum(1 for i in range(s2.response_length) if s2.loss_mask[i] and float(s2.teacher_log_probs[i])!=float(s2.rollout_log_probs[i]))","+    print('sql tools=None Falcon: trained', sum(s2.loss_mask), 'with signal', sig, 'fallback', s2.metadata.get('opd_teacher_fallback'))","+","+    # 3) response_length 0","+    s3=Sample(index=1000, prompt='x', tokens=[1,2], response='', response_length=0, loss_mask=[], rollout_log_probs=[], metadata={'reward':0.0,'messages':[{\"role\":\"user\",\"content\":\"hi\"}]})","+    out3=await reward.reward_func(a2, s3); s3.reward=out3","+    reward.post_process_rewards(a2,[s3])","+    print('empty response: teacher_log_probs', s3.teacher_log_probs, 'len', len(s3.teacher_log_probs))","+asyncio.run(main())","+print('edge probe done')"],"newLines":45,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/edge_probe.py"}]}