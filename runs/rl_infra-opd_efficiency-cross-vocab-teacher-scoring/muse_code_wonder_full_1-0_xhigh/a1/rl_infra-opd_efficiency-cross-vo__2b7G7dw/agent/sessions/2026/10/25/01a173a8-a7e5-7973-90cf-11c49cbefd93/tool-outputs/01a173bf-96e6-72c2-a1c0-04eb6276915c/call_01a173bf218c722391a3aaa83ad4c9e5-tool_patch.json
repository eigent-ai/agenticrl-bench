os + len(t_variant)","+            elif s_pos >= 0:","+                s_cursor = s_pos + len(s_variant)","+            elif t_pos >= 0:","+                teacher_cursor = t_pos + len(t_variant)","+","+        # Fill the gaps between anchored pieces (shared scaffolding such as </think> or the","+        # turn-end marker) with a bounded byte diff.","+        turn_spans.sort()","+        bounds = [(s_run_start, t_region_start)]","+        bounds += [(s, t) for s, _, t, _ in [(span[0], span[1], span[2], span[3]) for span in turn_spans]]","+        # (gap start pairs are previous span ends; rebuild explicitly below)","+        gap_starts = [(s_run_start, t_region_start)] + [(span[1], span[3]) for span in turn_spans]","+        gap_ends = [(span[0], span[2]) for span in turn_spans] + [(s_run_end, t_bound)]","+        for (gs_s, gs_t), (ge_s, ge_t) in zip(gap_starts, gap_ends, strict=True):","+            gap_s = student_blob[gs_s:ge_s]","+            gap_t = teacher_blob[gs_t:ge_t]","+            if not gap_s or not gap_t:","+                continue","+            if max(len(gap_s), len(gap_t)) > 4096:","+                continue","+            if max(len(gap_s), len(gap_t)) > 16 * min(len(gap_s), len(gap_t)) + 1024:","+                continue","+            for a_off, b_off, size in _equal_subspans(gap_s, gap_t, min_size=2):","+                turn_spans.append((gs_s + a_off, gs_s + a_off + size, gs_t + b_off, gs_t + b_off + size))","+        equal_spans.extend(turn_spans)","+","+    return _exact_token_pairs(student_spans, teacher_spans, prompt_tok_len, resp_len, equal_spans)","+","+","+def _align_legacy_single_turn(sample, student_tok, teacher_tok, prompt_text: str, teacher_ids):","+    \"\"\"Alignment for samples without stored messages: prompt rendered, response appended as text.\"\"\"","+    resp_len = sample.response_length","+    if resp_len == 0 or not sample.tokens:","+        return []","+    student_spans, student_blob = _token_byte_spans(student_tok, lis