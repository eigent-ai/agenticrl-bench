          j += 1","+    return aligned, num_matched","+","+","+# -----------------------------------------------------------------------------------------------","+# Hook entry points (used by examples/terminal_opd/reward.py)","+# -----------------------------------------------------------------------------------------------","+","+def _fallback_result(reason: str) -> dict:","+    return {\"_opd_teacher_fallback\": True, \"_opd_teacher_fallback_reason\": reason}","+","+","+async def reward_func_cross_vocab(args, sample: Sample, **kwargs):","+    \"\"\"Render the episode for the teacher, score it, and record the byte alignment.\"\"\"","+    _load_cross_vocab_tokenizers(args)","+    student_tok = args._cross_vocab_student_tok","+    teacher_tok = args._cross_vocab_teacher_tok","+","+    try:","+        messages = _full_messages(args, sample)","+        if messages is not None:","+            messages = _normalize_messages(messages)","+            teacher_text = _render_with_teacher_template(","+                args, sample, teacher_tok, messages, add_generation_prompt=False","+            )","+            teacher_ids = [int(t) for t in teacher_tok.encode(teacher_text, add_special_tokens=False)]","+            aligned_pairs = _align_episode(sample, student_tok, teacher_tok, messages, teacher_ids)","+        else:","+            if isinstance(sample.prompt, list):","+                prompt_text = _render_with_teacher_template(","+                    args, sample, teacher_tok, _normalize_messages(sample.prompt), add_generation_prompt=True","+                )","+            elif isinstance(sample.prompt, str):","+                prompt_text = sample.prompt","+            else:","+                raise TypeError(","+                    \"Cross-vocabulary OPD requires chat messages in metadata or a string/list prompt. \"","+                    f\"Got sample.prompt={type(sample.prompt).__name__}.\"","+                )","+            teacher_ids = [","+                int(t