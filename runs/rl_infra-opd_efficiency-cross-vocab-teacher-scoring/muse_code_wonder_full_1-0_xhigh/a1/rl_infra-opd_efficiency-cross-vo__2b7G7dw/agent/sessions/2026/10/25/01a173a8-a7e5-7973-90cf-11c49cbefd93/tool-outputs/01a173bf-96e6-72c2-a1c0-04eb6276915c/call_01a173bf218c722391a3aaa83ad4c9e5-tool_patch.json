{"files":[{"hunks":[{"lines":["             si += 1","     return pairs"," ","+","+def _find_first(haystack: bytes, variants: list[bytes], start: int, end: int):","+    for variant in variants:","+        pos = haystack.find(variant, start, end)","+        if pos >= 0:","+            return pos, variant","+    return -1, None","+","+","+def _align_episode(sample, student_tok, teacher_tok, messages, teacher_ids):","+    \"\"\"Aligned (student response position, teacher token index) pairs for the whole episode.\"\"\"","+    resp_len = sample.response_length","+    if resp_len == 0 or not sample.tokens:","+        return []","+    student_spans, student_blob = _token_byte_spans(student_tok, list(sample.tokens))","+    teacher_spans, teacher_blob = _token_byte_spans(teacher_tok, list(teacher_ids))","+    prompt_tok_len = len(sample.tokens) - resp_len","+    runs = _loss_runs(sample)","+    equal_spans: list[tuple[int, int, int, int]] = []","+    teacher_cursor = 0","+    run_idx = 0","+","+    for msg_idx, msg in enumerate(messages):","+        if msg.get(\"role\") != \"assistant\":","+            core = _content_text(msg.get(\"content\")).strip()","+            if core:","+                pos = teacher_blob.find(core.encode(), teacher_cursor)","+                if pos >= 0:","+                    teacher_cursor = pos + len(core.encode())","+            continue","+        if run_idx >= len(runs):","+            continue","+        run_start_resp, run_end_resp = runs[run_idx]","+        run_idx += 1","+        if run_end_resp <= run_start_resp:","+            continue","+        s_run_start = student_spans[prompt_tok_len + run_start_resp][0]","+        s_run_end = student_spans[prompt_tok_len + run_end_resp - 1][1]","+        t_region_start = teacher_cursor","+        # Bound this turn's teacher-side search by the next environment message, so a piece the","+        # teacher template dropped (e.g. stripped reasoning) cannot match a later echo of it.","+        t_bound =