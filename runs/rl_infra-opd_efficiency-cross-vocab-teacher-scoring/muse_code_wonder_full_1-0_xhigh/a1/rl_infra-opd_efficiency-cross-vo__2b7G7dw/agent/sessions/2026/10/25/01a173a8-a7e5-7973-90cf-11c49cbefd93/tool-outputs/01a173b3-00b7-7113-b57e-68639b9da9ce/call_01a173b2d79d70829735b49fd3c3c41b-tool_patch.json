{"files":[{"hunks":[{"lines":["+import torch, sys","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+models={'student':'/models/Qwen3.5-2B','qwen3':'/models/Qwen3-8B','falcon':'/models/Falcon-H1R-7B'}","+toks={k:AutoTokenizer.from_pretrained(v) for k,v in models.items()}","+# apply_chat_template tokenize=True vs encode rendered","+msgs=[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"héllo ✓ <|im_end|> literal\"},{\"role\":\"assistant\",\"content\":\"réponse ✓\",\"reasoning_content\":\"thïnk ✓\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"f\",\"arguments\":{\"q\":\"a\\\"b\\nc ✓ <x> &\",\"n\":3}}}]},{\"role\":\"tool\",\"content\":\"résult ✓\",\"tool_call_id\":\"c1\",\"name\":\"f\"},{\"role\":\"assistant\",\"content\":\"done\"}]","+tools=[{\"type\":\"function\",\"function\":{\"name\":\"f\",\"description\":\"d\",\"parameters\":{\"type\":\"object\",\"properties\":{\"q\":{\"type\":\"string\"}}}}}]","+for name,t in toks.items():","+    print('====',name)","+    for kw in [{}, {'enable_thinking':False}, {'enable_thinking':True}]:","+        try:","+            txt=t.apply_chat_template(msgs, tokenize=False, add_generation_prompt=False, tools=tools, **kw)","+            ids_template=t.apply_chat_template(msgs, tokenize=True, add_generation_prompt=False, tools=tools, return_dict=False, **kw)","+            ids_enc=t.encode(txt, add_special_tokens=False)","+            ids_call=t(txt, add_special_tokens=False)['input_ids']","+            print(kw, 'template==encode', list(ids_template)==ids_enc, 'call==encode', list(ids_call)==ids_enc, 'len', len(ids_enc))","+            if kw=={}: print(' text', repr(txt))","+        except Exception as e:","+            print(kw, 'ERR', type(e).__name__, str(e)[:200])","+    # offsets","+    txt=t.apply_chat_template(msgs, tokenize=False, add_generation_prompt=False, tools=tools)","+    enc=t(txt, add_special_tokens=False, return_offsets_mapping=True)","+    om=enc['offset_mapping']; ids=enc['input_ids']","+    bad=0","+    for (a,b),i in zip(om,ids):","+        piece=txt[a:b]","+        dec=t.decode([i], clean_up_tokenization_spaces=False)","+        if piece!=dec: bad+=1","+    print(' offsets: tokens', len(ids), 'piece!=per-token-decode', bad, 'coverage contiguous', om[0][0]==0 and all(om[i][1]==om[i+1][0] for i in range(len(om)-1)), 'ends', om[-1][1], len(txt))","+    # examples where differ","+    shown=0","+    for (a,b),i in zip(om,ids):","+        piece=txt[a:b]; dec=t.decode([i], clean_up_tokenization_spaces=False)","+        if piece!=dec and shown<8:","+            print('   id',i,'span',repr(piece),'decode1',repr(dec),'convtoken',repr(t.convert_ids_to_tokens([i])))","+            shown+=1","+# student rollout per-token decode concat vs full decode; convert tokens byte mapping","+st=toks['student']","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt', map_location='cpu', weights_only=True)","+    neq=0; tot=0; examples=[]","+    for r in d['samples']:","+        ids=r['tokens']","+        full=st.decode(ids)","+        concat=''.join(st.decode([i], clean_up_tokenization_spaces=False) for i in ids)","+        tot+=1","+        if concat!=full:","+            neq+=1","+            if len(examples)<2:","+                j=next((j for j,(a,b) in enumerate(zip(concat,full)) if a!=b), min(len(concat),len(full)))","+                examples.append((r['index'], j, repr(full[max(0,j-40):j+40]), repr(concat[max(0,j-40):j+40])))","+    print(kind, 'per-token decode concat != full decode eps:', neq, '/', tot, examples)","+# falcon/qwen3 encode of student decoded texts per-token concat check (sample)","+for name in ['qwen3','falcon']:","+    t=toks[name]; neq=0","+    for kind in ['mswea','terminus_think','sql']:","+        d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt', map_location='cpu', weights_only=True)","+        for r in d['samples'][:4]:","+