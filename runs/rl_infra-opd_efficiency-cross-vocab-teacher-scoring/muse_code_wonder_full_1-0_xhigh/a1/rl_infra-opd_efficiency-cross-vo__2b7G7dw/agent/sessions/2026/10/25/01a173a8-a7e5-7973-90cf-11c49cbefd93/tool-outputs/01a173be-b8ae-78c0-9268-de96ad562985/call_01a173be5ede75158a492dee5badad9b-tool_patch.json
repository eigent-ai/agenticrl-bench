{"files":[{"hunks":[{"lines":["+\"\"\"Teacher scoring for teachers whose tokenizer differs from the student's.","+","+The episode is rendered once with the teacher's own chat template (the full conversation from","+``sample.metadata[opd_prompt_messages_key]``, with ``metadata[\"tools\"]`` and the run's","+``opd_teacher_chat_template_kwargs``), tokenized with the teacher tokenizer, and sent to the teacher","+server as ``input_ids``.  Teacher log-probs are then mapped back onto student response positions at","+the byte level: the semantic pieces the student wrote (reasoning, content, tool-call names, argument","+keys and values) are located in both the student's token bytes and the teacher's token bytes, and a","+student token receives the teacher's log-prob only when the teacher tokenization contains exactly","+the same token bytes at the corresponding offset.  Every other position keeps the student's rollout","+log-prob, which is the sampled-token OPD encoding of \"no teacher signal\".","+","+Settings come from the run's --custom-config-path YAML (teacher_tokenizer_path,","+opd_prompt_messages_key, opd_teacher_chat_template_kwargs, opd_teacher_timeout / _retries /","+_concurrency).  ``is_cross_vocab`` decides whether the named teacher really tokenizes differently","+from the student: a teacher sharing the student's vocabulary is scored by the legacy same-tokenizer","+path in ``miles.rollout.on_policy_distillation``.","+\"\"\"","+","+import asyncio","+import bisect","+import difflib","+import json","+import logging","+import math","+","+import aiohttp","+import torch","+","+from miles.utils.types import Sample","+","+logger = logging.getLogger(__name__)","+","+","+def _get_teacher_semaphore(args):","+    loop = asyncio.get_running_loop()","+    loop_key = id(loop)","+    semaphores_by_loop = getattr(args, \"_opd_teacher_semaphores\", None)","+    if semaphores_by_loop is None:","+        semaphores_by_loop = {}","+        args._opd_teacher_semaphores = semaphores_by_loop","+","+    concurrency = int(getattr(args, \"opd_teacher_concurrency\", 0) or 0)","+    if concurrency <= 0:","+        return None","+","+    semaphore = semaphores_by_loop.get(loop_key)","+    if semaphore is None:","+        semaphore = asyncio.Semaphore(concurrency)","+        semaphores_by_loop[loop_key] = semaphore","+    return semaphore","+","+","+def _teacher_payload_summary(payload):","+    if \"input_ids\" in payload:","+        return f\"input_tokens={len(payload['input_ids'])}\"","+    if \"text\" in payload:","+        return f\"text_chars={len(payload['text'])}\"","+    return \"payload_size=unknown\"","+","+","+async def _post_teacher_once(session, teacher_url, payload):","+    async with session.post(teacher_url, json=payload) as resp:","+        if resp.status >= 400:","+            body = (await resp.text())[:500]","+            raise aiohttp.ClientResponseError(","+                request_info=resp.request_info,","+                history=resp.history,","+                status=resp.status,","+                message=f\"{resp.reason}; body={body}\",","+                headers=resp.headers,","+            )","+        return await resp.json()","+","+","+async def _post_teacher_json(args, teacher_url, payload, sample, warning_prefix):","+    retries = max(0, int(getattr(args, \"opd_teacher_retries\", 2)))","+    timeout = aiohttp.ClientTimeout(total=float(getattr(args, \"opd_teacher_timeout\", 300.0)))","+    semaphore = _get_teacher_semaphore(args)","+    last_exc = None","+","+    for attempt in range(retries + 1):","+        try:","+            async with aiohttp.ClientSession(timeout=timeout) as session:","+                if semaphore is None:","+                    return await _post_teacher_once(session, teacher_url, payload)","+                async with semaphore:","+                    return await _post_teacher_once(session, teacher_url, payload)","+        except (TimeoutError, asyncio.TimeoutError, aiohttp.ClientError) as exc:","+            last_exc = exc","+            if attempt < retries:","+                await asyncio.sleep(min(0.2 * (2**attempt), 2.0))","+                continue","+","+    logger.warning(","+        \"%s failed after %s attempt(s); using student rollout logprobs as teacher logprobs \"","+        \"for sample index=%s (%s): %s: %s\",","+        warning_prefix,","+        retries + 1,","+        getattr(sample, \"index\", None),","+        _teacher_payload_summary(payload),","+        type(last_exc).__name__,","+        last_exc,","+    )","+    return {\"_opd_teacher_fallback\": True, \"_opd_teacher_fallback_reason\": type(last_exc).__name__}","+","+","+def _student_rollout_lps(sample: Sample, resp_len: int) -> list[float]:","+    \"\"\"The student's own per-response-token log-probs (\"no teacher signal\"), zero-padded when absent.\"\"\"","+    rollout_lps = sample.rollout_log_probs","+    if rollout_lps is None or resp_len == 0:","+        return [0.0] * resp_len","+    values = torch.as_tensor(rollout_lps, dtype=torch.float32).flatten()","+    if values.numel() >= resp_len:","+        values = values[-resp_len:]","+    else:","+        values = torch.cat([torch.zeros(resp_len - values.numel(), dtype=torch.float32), values])","+    return [float(v) for v in values.tolist()]","+","+","+def _use_student_log_probs_for_teacher(sample: Sample, reason: str) -> None:","+    resp_len = sample.response_length","+    if resp_len == 0:","+        sample.teacher_log_probs = torch.empty(0, dtype=torch.float32)","+    else:","+        sample.teacher_log_probs = torch.tensor(_student_rollout_lps(sample, resp_len), dtype=torch.float32)","+","+    if sample.metadata is None:","+        sample.metadata = {}","+    sample.metadata[\"opd_teacher_fallback\"] = True","+    sample.metadata[\"opd_teacher_fallback_reason\"] = reason","+","+","+def _load_cross_vocab_tokenizers(args):","+    \"\"\"Lazy-load teacher and student tokenizers, caching them on args.\"\"\"","+    if hasattr(args, \"_cross_vocab_student_tok\") and hasattr(args, \"_cross_vocab_teacher_tok\"):","+        return","+","+    teacher_path = getattr(args, \"teacher_tokenizer_path\", None)","+    if not teacher_path:","+        raise ValueError(","+            \"teacher_tokenizer_path is required for cross-vocabulary OPD. \"","+            \"It must point to the teacher model tokenizer.\"","+        )","+","+    from transformers import AutoTokenizer","+","+    student_tok = AutoTokenizer.from_pretrained(args.hf_checkpoint, trust_remote_code=True)","+    teacher_tok = AutoTokenizer.from_pretrained(teacher_path, trust_remote_code=True)","+    args._cross_vocab_student_tok = student_tok","+    args._cross_vocab_teacher_tok = teacher_tok","+","+","+def _tokenizers_share_vocab(student_tok, teacher_tok) -> bool:","+    \"\"\"True when student token ids mean the same tokens to the teacher.","+","+    Scoring pre-tokenized ids only relies on the id<->token mapping, so equal vocabularies","+    (including added special tokens) make the same-tokenizer path exact, whatever the merge","+    rules that produced the ids.","+    \"\"\"","+    try:","+        student_vocab = student_tok.get_vocab()","+        teacher_vocab = teacher_tok.get_vocab()","+    except Exception:  # noqa: BLE001 - fall through to the backend comparison","+        student_vocab = teacher_vocab = None","+    if student_vocab and teacher_vocab:","+        if dict(student_vocab) != dict(teacher_vocab):","+            return False","+        student_added = getattr(student_tok, \"added_tokens_encoder\", None) or {}","+        teacher_added = getattr(teacher_tok, \"added_tokens_encoder\", None) or {}","+        return dict(student_added) == dict(teacher_added)","+    try:","+        return student_tok.backend_tokenizer.to_str() == teacher_tok.backend_tokenizer.to_str()","+    except Exception:  # noqa: BLE001","+        return False","+","+","+def is_cross_vocab(args) -> bool:","+    \"\"\"Whether the run's named teacher tokenizes differently from the student.","+","+    Every run names its teacher, including same-tokenizer teachers; those must keep the legacy","+    same-tokenizer scoring exactly, so sameness is detected here instead of being inferred from","+    the mere presence of ``teacher_tokenizer_path``.","+    \"\"\"","+    teacher_path = getattr(args, \"teacher_tokenizer_path\", None)","+    if not teacher_path:","+        return False","+    key = (str(teacher_path), str(getattr(args, \"hf_checkpoint\", \"\")))","+    cached = getattr(args, \"_opd_cross_vocab_decision\", None)","+    if cached is not None and cached[0] == key:","+        return cached[1]","+    try:","+        _load_cross_vocab_tokenizers(args)","+        cross = not _tokenizers_share_vocab(args._cross_vocab_student_tok, args._cross_vocab_teacher_tok)","+    except Exception:  # noqa: BLE001 - let the cross-vocab path surface the load error itself","+        cross = True","+    try:","+        args._opd_cross_vocab_decision = (key, cross)","+    except Exception:  # noqa: BLE001 - args may be read-only in exotic callers","+        pass","+    return cross","+","+","+# -----------------------------------------------------------------------------------------------","+# Token byte spans","+# -----------------------------------------------------------------------------------------------","+","+def _build_unicode_to_byte() -> dict[str, int]:","+    \"\"\"Inverse of the GPT-2 bytes-to-unicode mapping used by byte-level BPE tokenizers.\"\"\"","+    bs = list(range(ord(\"!\"), ord(\"~\") + 1)) + list(range(ord(\"¡\"), ord(\"¬\") + 1)) + list(range(ord(\"®\"), ord(\"ÿ\") + 1))","+    cs = bs[:]","+    n = 0","+    for b in range(256):","+        if b not in bs:","+            bs.append(b)","+            cs.append(256 + n)","+            n += 1","+    return {chr(c): b for b, c in zip(bs, cs, strict=True)}","+","+","+_UNICODE_TO_BYTE = _build_unicode_to_byte()","+_BYTE_MODE_CACHE: dict[int, str] = {}","+","+","+def _token_str_bytes(mode: str, token_str: str) -> bytes:","+    if not token_str:","+        return b\"\"","+    if mode == \"byte\" and all(c in _UNICODE_TO_BYTE for c in token_str):","+        return bytes(_UNICODE_TO_BYTE[c] for c in token_str)","+    if mode == \"sentencepiece\":","+        if token_str.startswith(\"<0x\") and token_str.endswith(\">\"):","+            try:","+                return bytes([int(token_str[3:-1], 16)])","+            except ValueError:","+                pass","+        return token_str.replace(\"▁\", \" \").encode()","+    return token_str.encode()","+","+","+def _tokenizer_byte_mode(tokenizer) -> str:","+    key = id(tokenizer)","+    mode = _BYTE_MODE_CACHE.get(key)","+    if mode is not None:","+        return mode","+    mode = \"decode\"","+    for candidate in (\"byte\", \"sentencepiece\"):","+        try:","+            ok = True","+            for probe in (\" hello é✓\", \"a b\\nc\"):","+                ids = tokenizer.encode(probe, add_special_tokens=False)","+                pieces = tokenizer.convert_ids_to_tokens(ids)","+                if isinstance(pieces, str):","+                    pieces = [pieces]","+                if b\"\".join(_token_str_bytes(candidate, p) for p in pieces) != probe.encode():","+                    ok = False","+                    break","+            if ok:","+                mode = candidate","+                break","+        except Exception:  # noqa: BLE001","+            continue","+    _BYTE_MODE_CACHE[key] = mode","+    return mode","+","+","+def _token_byte_spans(tokenizer, token_ids: list[int]) -> tuple[list[tuple[int, int]], bytes]:","+    \"\"\"Per-token byte spans of *token_ids*; spans are contiguous over the concatenated bytes.","+","+    Works even when tokens split multi-byte characters, where decoding tokens one by one (or","+    character offsets) corrupts the mapping.","+    \"\"\"","+    mode = _tokenizer_byte_mode(tokenizer)","+    if mode == \"decode\":","+        pieces = [","+            (tokenizer.decode([tid], skip_special_tokens=False, clean_up_tokenization_spaces=False) or \"\").encode()","+            for tid in token_ids","+        ]","+    else:","+        token_strs = tokenizer.convert_ids_to_tokens(list(token_ids))","+        if isinstance(token_strs, str):","+            token_strs = [token_strs]","+        pieces = [_token_str_bytes(mode, ts) if ts is not None else b\"\" for ts in token_strs]","+    spans, offset, blob_parts = [], 0, []","+    for piece in pieces:","+        spans.append((offset, offset + len(piece)))","+        offset += len(piece)","+        blob_parts.append(piece)","+    return spans, b\"\".join(blob_parts)"],"newLines":288,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/new_teacher_scoring.py"}]}