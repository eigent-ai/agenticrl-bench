{"files":[{"hunks":[{"lines":["         offset += len(piece)","         blob_parts.append(piece)","     return spans, b\"\".join(blob_parts)","+","+","+# -----------------------------------------------------------------------------------------------","+# Rendering the episode for the teacher","+# -----------------------------------------------------------------------------------------------","+","+def _full_messages(args, sample: Sample):","+    \"\"\"The episode's whole conversation from metadata, if the session hook stored it.\"\"\"","+    metadata = sample.metadata or {}","+    key = getattr(args, \"opd_prompt_messages_key\", None) or \"messages\"","+    messages = metadata.get(key)","+    if isinstance(messages, list) and messages and all(isinstance(m, dict) for m in messages):","+        return messages","+    return None","+","+","+def _normalize_messages(messages: list[dict]) -> list[dict]:","+    \"\"\"Shallow-copy messages into the shape HF chat templates expect (dict tool arguments).\"\"\"","+    normalized = []","+    for msg in messages:","+        msg = dict(msg)","+        if msg.get(\"role\") == \"assistant\" and msg.get(\"content\") is None:","+            msg[\"content\"] = \"\"","+        if isinstance(msg.get(\"tool_calls\"), list):","+            calls = []","+            for call in msg[\"tool_calls\"]:","+                if not isinstance(call, dict):","+                    calls.append(call)","+                    continue","+                call = dict(call)","+                fn = call.get(\"function\")","+                if isinstance(fn, dict):","+                    fn = dict(fn)","+                    if isinstance(fn.get(\"arguments\"), str):","+                        try:","+                            parsed = json.loads(fn[\"arguments\"])","+                        except (ValueError, TypeError):","+                            parsed = None","+                        if isinstance(parsed, dict):","+                            fn[\"arguments\"] = parsed","+                    call[\"function\"] = fn","+                calls.append(call)","+            msg[\"tool_calls\"] = calls","+        normalized.append(msg)","+    return normalized","+","+","+def _render_with_teacher_template(args, sample, teacher_tok, messages, *, add_generation_prompt: bool) -> str:","+    metadata = sample.metadata or {}","+    tools = metadata.get(\"tools\")","+    kwargs = dict(getattr(args, \"opd_teacher_chat_template_kwargs\", None) or {})","+","+    def render(with_tools):","+        call_kwargs = {\"tokenize\": False, \"add_generation_prompt\": add_generation_prompt, **kwargs}","+        if with_tools and tools is not None:","+            call_kwargs[\"tools\"] = tools","+        return teacher_tok.apply_chat_template(messages, **call_kwargs)","+","+    try:","+        return render(True)","+    except Exception:","+        if tools is None:","+            raise","+        # Some teacher templates reject tool definitions; rendering without them still lets the","+        # teacher judge the rest of the episode (tool-call positions then get no signal).","+        logger.warning(","+            \"Teacher chat template rejected tools for sample index=%s; retrying without tools\",","+            getattr(sample, \"index\", None),","+        )","+        return render(False)","+","+","+# -----------------------------------------------------------------------------------------------","+# Byte alignment between the student's tokens and the teacher's tokens","+# -----------------------------------------------------------------------------------------------","+","+def _content_text(content) -> str:","+    if isinstance(content, str):","+        return content","+    if isinstance(content, list):","+        parts = []","+        for item in content:","+            if isinstance(item, dict) and isinstance(item.get(\"text\"), str):","+                parts.append(item[\"text\"])","+            elif isinstance(item, str):","+                parts.append(item)","+        return \"\".join(parts)","+    return \"\"","+","+","+def _student_arg_text(value) -> str:","+    if isinstance(value, str):","+        return value","+    if isinstance(value, (dict, list, tuple)):","+        return json.dumps(value, ensure_ascii=False)","+    return str(value)","+","+","+def _teacher_arg_texts(value) -> list[str]:","+    if isinstance(value, str):","+        return [value, json.dumps(value, ensure_ascii=False)[1:-1], json.dumps(value)[1:-1]]","+    return [json.dumps(value, ensure_ascii=False), json.dumps(value), _student_arg_text(value)]","+","+","+def _assistant_pieces(msg: dict) -> list[tuple[str, list[str]]]:","+    \"\"\"What the student wrote on this turn, as (student text, teacher-rendering candidates).\"\"\"","+    pieces: list[tuple[str, list[str]]] = []","+    reasoning = msg.get(\"reasoning_content\")","+    if isinstance(reasoning, str) and reasoning.strip():","+        pieces.append((reasoning, [reasoning]))","+    content = _content_text(msg.get(\"content\"))","+    if content.strip():","+        pieces.append((content, [content]))","+    for call in msg.get(\"tool_calls\") or []:","+        if not isinstance(call, dict):","+            continue","+        fn = call.get(\"function\")","+        if not isinstance(fn, dict):","+            fn = call","+        name = fn.get(\"name\")","+        if isinstance(name, str) and name:","+            pieces.append((name, [name]))","+        arguments = fn.get(\"arguments\")","+        if isinstance(arguments, str):","+            try:","+                arguments = json.loads(arguments)","+            except (ValueError, TypeError):","+                arguments = None","+        if isinstance(arguments, dict):","+            for arg_name, arg_value in arguments.items():","+                pieces.append((str(arg_name), [str(arg_name)]))","+                student_text = _student_arg_text(arg_value)","+                if student_text:","+                    pieces.append((student_text, _teacher_arg_texts(arg_value)))","+    return pieces","+","+","+def _bytes_variants(texts: list[str]) -> list[bytes]:","+    variants: list[bytes] = []","+    for text in texts:","+        for variant in (text, text.strip()):","+            if variant:","+                try:","+                    encoded = variant.encode()","+                except (UnicodeEncodeError, AttributeError):","+                    continue","+                if encoded not in variants:","+                    variants.append(encoded)","+    return variants","+","+","+def _equal_subspans(a: bytes, b: bytes, min_size: int = 1) -> list[tuple[int, int, int]]:","+    \"\"\"Matching (a_off, b_off, size) blocks; bounded to small inputs.\"\"\"","+    if not a or not b:","+        return []","+    if a == b:","+        return [(0, 0, len(a))]","+    if max(len(a), len(b)) > 8192:","+        return []","+    matcher = difflib.SequenceMatcher(None, a, b, autojunk=False)","+    return [(x.a, x.b, x.size) for x in matcher.get_matching_blocks() if x.size >= min_size]","+","+","+def _loss_runs(sample: Sample) -> list[tuple[int, int]]:","+    resp_len = sample.response_length","+    mask = sample.loss_mask","+    if mask is None or len(mask) != resp_len:","+        return [(0, resp_len)] if resp_len else []","+    runs, start = [], None","+    for i, value in enumerate(mask):","+        if value and start is None:","+            start = i","+        if not value and start is not None:","+            runs.append((start, i))","+            start = None","+    if start is not None:","+        runs.append((start, resp_len))","+    return runs","+","+","+def _exact_token_pairs(student_spans, teacher_spans, prompt_tok_len, resp_len, equal_spans):","+    \"\"\"Student response positions whose token bytes occur at the matching offset on the teacher side.\"\"\"","+    student_starts = [s for s, _ in student_spans]","+    teacher_starts = [s for s, _ in teacher_spans]","+    pairs, seen = [], set()","+    for s_start, s_end, t_start, t_end in equal_spans:","+        if s_end - s_start != t_end - t_start or s_end <= s_start:","+            continue","+        teacher_by_span = {}","+        ti = bisect.bisect_left(teacher_starts, t_start)","+        while ti < len(teacher_spans) and teacher_spans[ti][0] < t_end:","+            ts, te = teacher_spans[ti]","+            if te <= t_end:","+                teacher_by_span[(ts - t_start, te - t_start)] = ti","+            ti += 1","+        si = bisect.bisect_left(student_starts, s_start)","+        while si < len(student_spans) and student_spans[si][0] < s_end:","+            ss, se = student_spans[si]","+            resp_pos = si - prompt_tok_len","+            if se <= s_end and 0 <= resp_pos < resp_len and resp_pos not in seen:","+                teacher_idx = teacher_by_span.get((ss - s_start, se - s_start))","+                if teacher_idx is not None:","+                    pairs.append((resp_pos, teacher_idx))","+                    seen.add(resp_pos)","+            si += 1","+    return pairs","+"],"newLines":210,"newStart":286,"oldLines":3,"oldStart":286}],"path":"/tmp/new_teacher_scoring.py"}]}