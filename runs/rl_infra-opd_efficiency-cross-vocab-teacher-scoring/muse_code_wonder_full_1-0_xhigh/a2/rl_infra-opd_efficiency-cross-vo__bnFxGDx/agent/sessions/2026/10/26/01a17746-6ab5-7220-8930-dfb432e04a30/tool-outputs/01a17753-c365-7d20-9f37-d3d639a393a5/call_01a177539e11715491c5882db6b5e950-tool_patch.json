{"files":[{"hunks":[{"lines":["+import torch, collections, json, sys","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+stud=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+teachers={","+ 'q8-nothink':(AutoTokenizer.from_pretrained('/models/Qwen3-8B',trust_remote_code=True),{\"enable_thinking\":False}),","+ 'q8-think':(AutoTokenizer.from_pretrained('/models/Qwen3-8B',trust_remote_code=True),{\"enable_thinking\":True}),","+ 'falcon':(AutoTokenizer.from_pretrained('/models/Falcon-H1R-7B',trust_remote_code=True),{}),","+}","+def lcp(a,b):","+    n=min(len(a),len(b)); i=0","+    while i<n and a[i]==b[i]: i+=1","+    return i","+def render(tok,msgs,tools,kwargs,gen):","+    kw=dict(tokenize=False,add_generation_prompt=gen)","+    kw.update(kwargs)","+    if tools is not None: kw['tools']=tools","+    return tok.apply_chat_template(msgs,**kw)","+","+for tname,(ttok,tkw) in teachers.items():","+    print(\"\\n#####\",tname)","+    for kind in ['mswea','terminus_think','sql']:","+        d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+        stats=collections.Counter(); examples=[]","+        for si,s in enumerate(d['samples'][:6]):","+            msgs=s['metadata']['messages']; tools=s['metadata'].get('tools')","+            # full render","+            try:","+                full=render(ttok,msgs,tools,tkw,False); stats['full_ok']+=1","+            except Exception as e:","+                stats['full_err:'+type(e).__name__]+=1; examples.append(('full',si,str(e)[:200])); continue","+            for i,m in enumerate(msgs):","+                if m['role']!='assistant': continue","+                stats['turns']+=1","+                try:","+                    before=render(ttok,msgs[:i],tools,tkw,False) if i>0 else ''","+                    beforegen=render(ttok,msgs[:i],tools,tkw,True) if i>0 else ''","+                    thru=render(ttok,msgs[:i+1],tools,tkw,False)","+                except Exception as e:","+                    stats['turn_err:'+type(e).__name__]+=1","+                    if len(examples)<5: examples.append(('turn',si,i,str(e)[:250]))","+                    continue","+                stats['thru_startswith_before']+= thru.startswith(before)","+                stats['gen_startswith_before']+= beforegen.startswith(before)","+                seg=thru[len(before):] if thru.startswith(before) else thru[lcp(before,thru):]","+                gensuf=beforegen[len(before):] if beforegen.startswith(before) else beforegen[lcp(before,beforegen):]","+                c=lcp(gensuf,seg)","+                emitted=seg[c:]","+                # check field presence in emitted vs full segment","+                for field in ['reasoning_content','content']:","+                    v=m.get(field)","+                    if isinstance(v,str) and v.strip():","+                        stats[field+'_turns']+=1","+                        stats[field+'_in_emitted_exact']+= v in emitted","+                        stats[field+'_in_emitted_strip']+= v.strip() in emitted","+                        stats[field+'_in_seg_exact']+= v in seg","+                        # in full: find after ??? approximate any occurrence","+                        stats[field+'_in_full_strip']+= v.strip() in full","+                if m.get('tool_calls'):","+                    stats['tc_turns']+=1","+                    ok=True","+                    for tc in m['tool_calls']:","+                        fn=tc.get('function',tc)","+                        if fn.get('name') not in emitted: ok=False","+                        if isinstance(fn.get('arguments'),dict):","+                            for av in fn['arguments'].values():","+                                if isinstance(av,str) and av not in emitted and json.dumps(av)[1:-1] not in emitted: ok=False","+                    stats['tc_all_in_emitted']+=ok","+                if si==0 and i in ( [x for x,mm in enumerate(msgs) if mm['role']=='assistant'][:1] ):","+                    print(f\" {kind} first turn gensuf={repr(gensuf[:160])} seg[:220]={repr(seg[:220])} emitted[:220]={repr(emitted[:220])}\")","+        print(kind,dict(stats))","+        for e in examples[:3]: print('  ex',e)"],"newLines":72,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/explore5.py"}]}