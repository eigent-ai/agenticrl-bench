{"files":[{"hunks":[{"lines":["+import torch, sys, collections","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+def make_bd():","+    bs=list(range(33,127))+list(range(161,173))+list(range(174,256)); cs=bs[:]; n=0","+    for b in range(256):","+        if b not in bs: bs.append(b); cs.append(256+n); n+=1","+    return {chr(c):b for b,c in zip(bs,cs)}","+BD=make_bd()","+def byte_pieces(tok,ids):","+    out=[]","+    for t in tok.convert_ids_to_tokens(ids):","+        if all(c in BD for c in t): out.append(bytes(BD[c] for c in t))","+        else: out.append(t.encode('utf-8'))","+    return out","+for name in ['Qwen3.5-2B','Qwen3-8B','Falcon-H1R-7B']:","+    tok=AutoTokenizer.from_pretrained(f'/models/{name}',trust_remote_code=True)","+    for txt in [\"Hello world! Café — тест 中文 ✓\\n\\n```code\\x00x``` <|im_end|> end \\U0001F600\", \"a  b\\tc\\r\\nd\"]:","+        ids=tok.encode(txt,add_special_tokens=False)","+        print(name, b''.join(byte_pieces(tok,ids))==txt.encode(), tok.convert_ids_to_tokens(ids)[:6])","+stud=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    c=collections.Counter()","+    for s in d['samples']:","+        text=stud.decode(s['tokens'])","+        bp=b''.join(byte_pieces(stud,s['tokens']))","+        ok=bp==text.encode('utf-8'); c[ok]+=1","+        if not ok:","+            tb=text.encode('utf-8'); i=next((k for k,(a,b) in enumerate(zip(bp,tb)) if a!=b),min(len(bp),len(tb)))","+            print(kind,'mismatch byte',i,bp[max(0,i-40):i+40],tb[max(0,i-40):i+40],len(bp),len(tb))","+    print(kind,c)"],"newLines":32,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/explore8.py"}]}