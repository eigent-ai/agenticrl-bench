{"files":[{"hunks":[{"lines":["+import torch, collections, json, sys","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+stud=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    stats=collections.Counter()","+    for s in d['samples']:","+        msgs=s['metadata']['messages']","+        na=sum(1 for m in msgs if m['role']=='assistant')","+        lm=s['loss_mask'] or []","+        runs=0; prev=0","+        for x in lm:","+            if x==1 and prev==0: runs+=1","+            prev=x","+        stats[f'runs_eq_assist:{runs==na}']+=1","+        if runs!=na: stats[f'diff:{runs-na}']+=1","+        # re-encode full decoded","+        text=stud.decode(s['tokens'])","+        enc=stud(text,add_special_tokens=False,return_offsets_mapping=True)","+        stats[f'reencode_eq:{list(enc[\"input_ids\"])==list(s[\"tokens\"])}']+=1","+        # per-token decode concat","+        pieces=[stud.decode([t],skip_special_tokens=False,clean_up_tokenization_spaces=False) for t in s['tokens']]","+        stats[f'pertok_concat_eq:{\"\".join(pieces)==text}']+=1","+        if \"\".join(pieces)!=text:","+            # count replacement chars","+            stats['pertok_repl']+=\"\".join(pieces).count('\\ufffd')","+        # rollout len","+        stats[f'lm_len_eq_resp:{len(lm)==s[\"response_length\"]}']+=1","+        stats[f'rollout_len_eq_resp:{len(s[\"rollout_log_probs\"] or [])==s[\"response_length\"]}']+=1","+        stats[f'response_eq_dec_resp:{stud.decode(s[\"tokens\"][len(s[\"tokens\"])-s[\"response_length\"]:])==s[\"response\"]}']+=1","+    print(kind,dict(stats))","+# anomalies: mswea/sql reasoning_content ones","+for kind in ['mswea','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    for si,s in enumerate(d['samples']):","+        for mi,m in enumerate(s['metadata']['messages']):","+            if 'reasoning_content' in m:","+                print(kind,si,mi,repr(m)[:800])","+    # non-ascii in assistant writing","+    cnt=collections.Counter()","+    for s in d['samples']:","+        for m in s['metadata']['messages']:","+            if m['role']=='assistant':","+                txt=(m.get('content') or '')+(m.get('reasoning_content') or '')","+                for ch in txt:","+                    if ord(ch)>127: cnt[ch]+=1","+    print(kind,'nonascii assistant',cnt.most_common(20))","+d=torch.load(f'/app/data/rollouts/terminus_think/rollout_0.pt',map_location='cpu',weights_only=True)","+cnt=collections.Counter()","+for s in d['samples']:","+    for m in s['metadata']['messages']:","+        if m['role']=='assistant':","+            for ch in (m.get('content') or '')+(m.get('reasoning_content') or ''):","+                if ord(ch)>127: cnt[ch]+=1","+print('terminus nonascii',cnt.most_common(30))","+# check EOS/last trained token in runs","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    c=collections.Counter()","+    for s in d['samples']:","+        plen=len(s['tokens'])-s['response_length']; lm=s['loss_mask']","+        i=0","+        while i<len(lm):","+            if lm[i]==1:","+                j=i","+                while j<len(lm) and lm[j]==1: j+=1","+                last=s['tokens'][plen+j-1]","+                c[(last==stud.eos_token_id, stud.decode([last])[:20])]+=1","+                i=j","+            else: i+=1","+    print(kind,'run last tokens',c.most_common(8))"],"newLines":72,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/explore6.py"}]}