{"files":[{"hunks":[{"lines":["             pass","     ids = [int(t) for t in tokenizer.encode(text, add_special_tokens=True)]","     return ids, _token_byte_spans(tokenizer, ids, text_bytes)","+","+","+# ---------------------------------------------------------------------------","+# Conversation access and teacher rendering","+# ---------------------------------------------------------------------------","+","+","+def _conversation_messages(args, sample: Sample):","+    metadata = sample.metadata or {}","+    key = getattr(args, \"opd_prompt_messages_key\", None) or \"messages\"","+    messages = metadata.get(key)","+    if messages is None and isinstance(sample.prompt, list):","+        messages = sample.prompt","+    return messages if isinstance(messages, list) else None","+","+","+def _chat_kwargs(args) -> dict:","+    kwargs = dict(getattr(args, \"opd_teacher_chat_template_kwargs\", None) or {})","+    for reserved in (\"tokenize\", \"add_generation_prompt\", \"tools\", \"chat_template\"):","+        kwargs.pop(reserved, None)","+    return kwargs","+","+","+def _content_texts(content) -> list[str]:","+    if isinstance(content, str):","+        return [content]","+    if isinstance(content, list):","+        out = []","+        for item in content:","+            if isinstance(item, str):","+                out.append(item)","+            elif isinstance(item, dict):","+                text = item.get(\"text\")","+                if not isinstance(text, str):","+                    text = item.get(\"content\")","+                if isinstance(text, str):","+                    out.append(text)","+        return out","+    return []","+","+","+def _clean_messages(","+    messages,","+    *,","+    arguments_as_json: bool = False,","+    tool_to_user: bool = False,","+    merge_system: bool = False,","+    merge_consecutive_user: bool = False,","+    drop_tool_calls: bool = False,","+):","+    cleaned = []","+    for message in messages:","+        if not isinstance(message, dict):","+            continue","+        role = message.get(\"role\")","+        content = message.get(\"content\")","+        if isinstance(content, list) and all(isinstance(t, str) for t in _content_texts(content)):","+            texts = _content_texts(content)","+            if len(texts) == len(content):","+                content = \"\".join(texts)","+        if content is None:","+            content = \"\"","+        new: dict = {\"role\": role, \"content\": content}","+        if isinstance(message.get(\"reasoning_content\"), str):","+            new[\"reasoning_content\"] = message[\"reasoning_content\"]","+        for extra in (\"name\", \"tool_call_id\"):","+            if message.get(extra) is not None:","+                new[extra] = message[extra]","+        tool_calls = message.get(\"tool_calls\")","+        if tool_calls and not drop_tool_calls:","+            new_calls = []","+            for call in tool_calls:","+                if not isinstance(call, dict):","+                    continue","+                call = dict(call)","+                fn = call.get(\"function\")","+                if isinstance(fn, dict):","+                    fn = dict(fn)","+                    if arguments_as_json and isinstance(fn.get(\"arguments\"), (dict, list)):","+                        fn[\"arguments\"] = json.dumps(fn[\"arguments\"], ensure_ascii=False)","+                    call[\"function\"] = fn","+                elif arguments_as_json and isinstance(call.get(\"arguments\"), (dict, list)):","+                    call[\"arguments\"] = json.dumps(call[\"arguments\"], ensure_ascii=False)","+                new_calls.append(call)","+            if new_calls:","+                new[\"tool_calls\"] = new_calls","+        if tool_to_user and role == \"tool\":","+            new[\"role\"] = \"user\"","+            new.pop(\"tool_call_id\", None)","+        cleaned.append(new)","+    if merge_system and cleaned and cleaned[0].get(\"role\") == \"system\":","+        system = cleaned.pop(0)","+        system_text = \"\\n\".join(_content_texts(system.get(\"content\")))","+        target = next((m for m in cleaned if m.get(\"role\") == \"user\"), None)","+        if target is None:","+            system[\"role\"] = \"user\"","+            cleaned.insert(0, system)","+        elif system_text:","+            rest = \"\\n\".join(_content_texts(target.get(\"content\")))","+            target[\"content\"] = system_text + (\"\\n\\n\" + rest if rest else \"\")","+    if merge_consecutive_user:","+        merged = []","+        for message in cleaned:","+            if merged and message.get(\"role\") == \"user\" and merged[-1].get(\"role\") == \"user\":","+                prev = \"\\n\".join(_content_texts(merged[-1].get(\"content\")))","+                cur = \"\\n\".join(_content_texts(message.get(\"content\")))","+                merged[-1][\"content\"] = prev + (\"\\n\\n\" + cur if cur else \"\")","+            else:","+                merged.append(message)","+        cleaned = merged","+    return cleaned","+","+","+def _lcp(a: str, b: str) -> int:","+    n = min(len(a), len(b))","+    i = 0","+    while i < n and a[i] == b[i]:","+        i += 1","+    return i","+","+","+class _TurnRenderer:","+    \"\"\"Renders ('before the turn', 'before with generation prompt', 'through the turn') consistently.","+","+    Tries the conversation as recorded first. Only if the teacher template refuses it does it fall back","+    to progressively adapted forms (OpenAI-style JSON-string arguments, no ``tools`` argument, ``tool``","+    rendered as ``user``, system merged into the first user message, ...), so families whose templates","+    lack a system/tool surface still see the conversation instead of nothing.","+    \"\"\"","+","+    _PLANS = (","+        (\"as_recorded\", {}, True),","+        (\"json_arguments\", {\"arguments_as_json\": True}, True),","+        (\"as_recorded_no_tools\", {}, False),","+        (\"tool_as_user\", {\"tool_to_user\": True}, True),","+        (\"system_merged\", {\"merge_system\": True}, True),","+        (","+            \"tool_as_user_system_merged\",","+            {\"tool_to_user\": True, \"merge_system\": True, \"merge_consecutive_user\": True},","+            False,","+        ),","+        (","+            \"minimal\",","+            {","+                \"tool_to_user\": True,","+                \"merge_system\": True,","+                \"merge_consecutive_user\": True,","+                \"drop_tool_calls\": True,","+                \"arguments_as_json\": True,","+            },","+            False,","+        ),","+    )","+","+    def __init__(self, teacher_tok, messages, tools, chat_kwargs):","+        self.tok = teacher_tok","+        self.messages = messages","+        self.tools = tools","+        self.chat_kwargs = chat_kwargs","+        self._cache: dict = {}","+","+    def _render(self, plan_idx: int, n_messages: int, add_generation_prompt: bool) -> str:","+        key = (plan_idx, n_messages, add_generation_prompt)","+        if key not in self._cache:","+            _name, clean_kwargs, use_tools = self._PLANS[plan_idx]","+            messages = self.messages[:n_messages]","+            if clean_kwargs:","+                messages = _clean_messages(messages, **clean_kwargs)","+            kwargs = {\"tokenize\": False, \"add_generation_prompt\": add_generation_prompt}","+            kwargs.update(self.chat_kwargs)","+            if use_tools and self.tools is not None:","+                kwargs[\"tools\"] = self.tools","+            text = self.tok.apply_chat_template(messages, **kwargs)","+            if not isinstance(text, str):","+                raise TypeError(\"chat template did not return text\")","+            self._cache[key] = text","+        return self._cache[key]","+","+    def score_text(self, msg_index: int):","+        \"\"\"Return ``(score_text, emitted_text)`` for the assistant message at ``msg_index``, or ``None``.\"\"\"","+        assistant = self.messages[msg_index]","+        first_ok = None","+        for plan_idx in range(len(self._PLANS)):","+            try:","+                before = self._render(plan_idx, msg_index, False)","+                before_gen = self._render(plan_idx, msg_index, True)","+                thru = self._render(plan_idx, msg_index + 1, False)","+            except Exception:","+                continue","+            segment = thru[_lcp(before, thru) :]","+            gen_suffix = before_gen[_lcp(before, before_gen) :]","+            emitted = segment[_lcp(gen_suffix, segment) :]","+            if not emitted:","+                continue","+            candidate = (before_gen + emitted, emitted)","+            if first_ok is None:","+                first_ok = candidate","+            if assistant.get(\"tool_calls\") and not _emitted_has_tool_content(emitted, assistant):","+                continue  # this form dropped the calls; a later form may keep them","+            return candidate","+        return first_ok","+","+","+def _emitted_has_tool_content(emitted: str, assistant: dict) -> bool:","+    for call in assistant.get(\"tool_calls\") or []:","+        if not isinstance(call, dict):","+            continue","+        fn = call.get(\"function\") if isinstance(call.get(\"function\"), dict) else call","+        name = fn.get(\"name\")","+        if name and str(name) in emitted:","+            return True","+        arguments = fn.get(\"arguments\")","+        values = arguments.values() if isinstance(arguments, dict) else []","+        for value in values:","+            if isinstance(value, str) and value and (value in emitted or json.dumps(value)[1:-1] in emitted):","+                return True","+    return False"],"newLines":220,"newStart":350,"oldLines":3,"oldStart":350}],"path":"/app/miles/examples/terminal_opd/teacher_scoring.py"}]}