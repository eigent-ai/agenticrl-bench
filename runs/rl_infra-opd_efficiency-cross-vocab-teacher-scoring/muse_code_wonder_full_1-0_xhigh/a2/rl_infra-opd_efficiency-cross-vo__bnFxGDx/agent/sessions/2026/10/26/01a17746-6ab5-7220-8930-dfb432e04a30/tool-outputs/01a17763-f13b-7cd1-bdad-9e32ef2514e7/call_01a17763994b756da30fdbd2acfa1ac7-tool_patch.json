{"files":[{"hunks":[{"lines":["+\"\"\"Focused tests for cross-vocab teacher scoring. Run explicitly (examples are outside testpaths):","+","+    python -m pytest examples/terminal_opd/test_teacher_scoring.py -o addopts='' -p no:cacheprovider","+\"\"\"","+","+import argparse","+import asyncio","+import math","+import os","+","+import pytest","+import torch","+","+MODELS = \"/models\"","+DUMPS = \"/app/data/rollouts\"","+","+pytestmark = pytest.mark.skipif(","+    not (os.path.isdir(f\"{MODELS}/Qwen3-8B\") and os.path.isdir(DUMPS)), reason=\"local tokenizers/dumps not present\"","+)","+","+","+def _args(teacher, **overrides):","+    a = argparse.Namespace(","+        hf_checkpoint=f\"{MODELS}/Qwen3.5-2B\",","+        rm_url=\"http://teacher.invalid/generate\",","+        teacher_tokenizer_path=f\"{MODELS}/{teacher}\",","+        opd_prompt_messages_key=\"messages\",","+        opd_teacher_chat_template_kwargs={\"enable_thinking\": False},","+        opd_teacher_timeout=30,","+        opd_teacher_retries=0,","+        opd_teacher_concurrency=8,","+        advantage_estimator=\"grpo\",","+        rewards_normalization=False,","+        opd_log_prob_top_k=0,","+    )","+    for k, v in overrides.items():","+        setattr(a, k, v)","+    return a","+","+","+def _load_sample(kind, idx=0):","+    import sys","+","+    if \"/app/miles\" not in sys.path:","+        sys.path.insert(0, \"/app/miles\")","+    from miles.utils.types import Sample","+","+    d = torch.load(f\"{DUMPS}/{kind}/rollout_0.pt\", map_location=\"cpu\", weights_only=True)","+    return Sample.from_dict(d[\"samples\"][idx])","+","+","+def _stub_teacher(monkeypatch, captured):","+    from examples.terminal_opd import teacher_scoring","+","+    async def fake_post(args, url, payload, sample, prefix):","+        captured.append(payload)","+        ids = payload[\"input_ids\"]","+        entries = [[None if i == 0 else -1.0 - (tid % 13) * 0.111, tid, None] for i, tid in enumerate(ids)]","+        return {\"meta_info\": {\"input_token_logprobs\": entries}}","+","+    monkeypatch.setattr(teacher_scoring, \"_post_teacher_json\", fake_post)","+","+","+def _score(monkeypatch, kind, teacher=\"Qwen3-8B\", idx=0, **overrides):","+    import sys","+","+    if \"/app/miles\" not in sys.path:","+        sys.path.insert(0, \"/app/miles\")","+    from examples.terminal_opd import reward as reward_mod","+","+    captured = []","+    _stub_teacher(monkeypatch, captured)","+    sample = _load_sample(kind, idx)","+    args = _args(teacher, **overrides)","+    sample.reward = asyncio.run(reward_mod.reward_func(args, sample))","+    raw, _ = reward_mod.post_process_rewards(args, [sample])","+    return sample, captured, raw","+","+","+def test_same_tokenizer_detection():","+    import sys","+","+    if \"/app/miles\" not in sys.path:","+        sys.path.insert(0, \"/app/miles\")","+    from examples.terminal_opd import teacher_scoring","+","+    assert teacher_scoring.same_tokenizer_as_student(_args(\"Qwen3.5-9B\")) is True","+    assert teacher_scoring.same_tokenizer_as_student(_args(\"Qwen3-8B\")) is False","+    assert teacher_scoring.same_tokenizer_as_student(_args(\"Falcon-H1R-7B\")) is False","+","+","+def test_byte_spans_survive_split_unicode_and_boundaries():","+    import sys","+","+    if \"/app/miles\" not in sys.path:","+        sys.path.insert(0, \"/app/miles\")","+    from transformers import AutoTokenizer","+","+    from examples.terminal_opd import teacher_scoring","+","+    tok = AutoTokenizer.from_pretrained(f\"{MODELS}/Qwen3.5-2B\", trust_remote_code=True)","+    text = \"Café — тест 中文 ✓\\n\\n```x```<|im_end|>\"","+    ids = tok.encode(\"Café — тест \", add_special_tokens=False) + tok.encode(","+        \"中文 ✓\\n\\n```x```<|im_end|>\", add_special_tokens=False","+    )","+    spans = teacher_scoring._token_byte_spans(tok, ids, text.encode())","+    assert spans is not None","+    assert b\"\".join(text.encode()[a:b] for a, b in spans) == text.encode()","+","+","+def test_every_turn_scored_in_teacher_format_with_input_ids(monkeypatch):","+    sample, captured, _raw = _score(monkeypatch, \"terminus_think\")","+    assistants = [m for m in sample.metadata[\"messages\"] if m[\"role\"] == \"assistant\"]","+    assert captured, \"no teacher payloads\"","+    assert all(\"input_ids\" in p and \"text\" not in p for p in captured)","+    assert len(captured) == len(assistants)","+","+    from transformers import AutoTokenizer","+","+    teacher_tok = AutoTokenizer.from_pretrained(f\"{MODELS}/Qwen3-8B\", trust_remote_code=True)","+    second_turn_text = teacher_tok.decode(captured[1][\"input_ids\"])","+    # Second turn is judged with its own reasoning, in a history the teacher","+    # template renders (which drops the first turn's reasoning).","+    assert assistants[1][\"reasoning_content\"].strip()[:40] in second_turn_text","+    assert assistants[0][\"reasoning_content\"].strip()[:40] not in second_turn_text","+    # No student-format generation scaffold from a later turn leaks in as raw response text.","+    assert \"<|im_start|>user\\nPrevious response had warnings\" in second_turn_text","+","+    teacher = sample.teacher_log_probs","+    assert isinstance(teacher, torch.Tensor) and len(teacher) == sample.response_length","+    assert all(math.isfinite(v) for v in teacher.tolist())","+    rollout = list(sample.rollout_log_probs)[-sample.response_length :]","+    trained = [i for i, x in enumerate(sample.loss_mask) if x]","+    with_signal = [i for i in trained if abs(float(teacher[i]) - rollout[i]) > 1e-6]","+    assert len(with_signal) / len(trained) > 0.8","+","+","+def test_sql_tool_calls_scored_in_teacher_serialisation(monkeypatch):","+    sample, captured, _raw = _score(monkeypatch, \"sql\")","+    from transformers import AutoTokenizer","+","+    teacher_tok = AutoTokenizer.from_pretrained(f\"{MODELS}/Qwen3-8B\", trust_remote_code=True)","+    first_text = teacher_tok.decode(captured[0][\"input_ids\"])","+    assert '\"name\": \"execute_sql\"' in first_text  # teacher JSON tool-call format","+    assert \"SELECT name, age, doctor_name\" in first_text  # the student's actual query","+    assert \"<parameter=query>\" not in first_text  # not the student XML format","+","+    teacher = sample.teacher_log_probs.tolist()","+    rollout = list(sample.rollout_log_probs)[-sample.response_length :]","+    trained = [i for i, x in enumerate(sample.loss_mask) if x]","+    with_signal = [i for i in trained if abs(teacher[i] - rollout[i]) > 1e-6]","+    assert len(with_signal) / len(trained) > 0.4","+","+","+def test_missing_messages_gives_no_signal_not_crash(monkeypatch):","+    sample = _load_sample(\"mswea\")","+    sample.metadata = {k: v for k, v in sample.metadata.items() if k != \"messages\"}","+    captured = []","+    _stub_teacher(monkeypatch, captured)","+    import sys","+","+    if \"/app/miles\" not in sys.path:","+        sys.path.insert(0, \"/app/miles\")","+    from examples.terminal_opd import reward as reward_mod","+","+    args = _args(\"Qwen3-8B\")","+    sample.reward = asyncio.run(reward_mod.reward_func(args, sample))","+    reward_mod.post_process_rewards(args, [sample])","+    rollout = list(sample.rollout_log_probs)[-sample.response_length :]","+    assert [float(v) for v in sample.teacher_log_probs.tolist()] == [float(v) for v in rollout]"],"newLines":170,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/examples/terminal_opd/test_teacher_scoring.py"}]}