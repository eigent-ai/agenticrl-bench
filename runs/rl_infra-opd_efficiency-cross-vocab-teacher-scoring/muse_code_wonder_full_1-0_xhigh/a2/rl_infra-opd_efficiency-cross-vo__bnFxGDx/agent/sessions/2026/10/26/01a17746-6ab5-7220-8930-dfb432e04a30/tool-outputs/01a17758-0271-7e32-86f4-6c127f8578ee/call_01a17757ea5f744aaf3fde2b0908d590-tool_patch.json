{"files":[{"hunks":[{"lines":["+import torch, sys, collections","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+def byte_pieces(tok, ids):","+    toks=tok.convert_ids_to_tokens(ids)","+    bd=getattr(tok,'byte_decoder',None)","+    out=[]","+    specials=set(tok.all_special_tokens)","+    added=set(tok.get_added_vocab().keys()) if hasattr(tok,'get_added_vocab') else set()","+    for t in toks:","+        if t in specials or t in added:","+            out.append(t.encode('utf-8'))","+        elif bd is not None and all(c in bd for c in t):","+            out.append(bytes(bd[c] for c in t))","+        else:","+            out.append(t.encode('utf-8'))","+    return out","+","+for name in ['Qwen3.5-2B','Qwen3-8B','Falcon-H1R-7B']:","+    tok=AutoTokenizer.from_pretrained(f'/models/{name}',trust_remote_code=True)","+    print(name,'byte_decoder',hasattr(tok,'byte_decoder'),type(tok).__name__)","+    for txt in [\"Hello world! Café — тест 中文 ✓\\n\\n```code x=1``` <|im_end|> end\", \"a  b\\tc\\r\\nd\"]:","+        ids=tok.encode(txt,add_special_tokens=False)","+        bp=b''.join(byte_pieces(tok,ids))","+        print('  eq',bp==txt.encode(), 'tokens',tok.convert_ids_to_tokens(ids)[:12])","+        enc=tok(txt,add_special_tokens=False,return_offsets_mapping=True)","+        print('  offsets',enc['offset_mapping'][:8])","+","+stud=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    c=collections.Counter()","+    for s in d['samples']:","+        text=stud.decode(s['tokens'])","+        bp=b''.join(byte_pieces(stud,s['tokens']))","+        c[bp==text.encode('utf-8')]+=1","+        if bp!=text.encode('utf-8'):","+            # find first diff","+            tb=text.encode('utf-8')","+            i=next((k for k,(a,b) in enumerate(zip(bp,tb)) if a!=b),min(len(bp),len(tb)))","+            print(kind,'mismatch at byte',i,bp[max(0,i-30):i+30],tb[max(0,i-30):i+30],'lens',len(bp),len(tb))","+    print(kind,'byte_pieces eq',c)"],"newLines":42,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/explore7.py"}]}