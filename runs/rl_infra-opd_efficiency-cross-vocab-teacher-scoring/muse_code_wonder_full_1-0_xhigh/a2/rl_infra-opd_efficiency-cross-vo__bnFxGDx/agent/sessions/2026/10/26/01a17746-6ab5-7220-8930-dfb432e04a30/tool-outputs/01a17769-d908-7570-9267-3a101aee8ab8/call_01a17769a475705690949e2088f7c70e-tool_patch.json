{"files":[{"hunks":[{"lines":["+import torch, sys, math, collections, json","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+stud=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+def spans(ids):","+    # reuse proto byte alphabet","+    bs=list(range(33,127))+list(range(161,173))+list(range(174,256)); cs=bs[:]; n=0","+    for b in range(256):","+        if b not in bs: bs.append(b); cs.append(256+n); n+=1","+    BD={chr(c):b for b,c in zip(bs,cs)}","+    out=[]; cur=0","+    for t in stud.convert_ids_to_tokens(ids):","+        piece=bytes(BD[c] for c in t) if all(c in BD for c in t) else t.encode()","+        out.append((cur,cur+len(piece))); cur+=len(piece)","+    return out","+for cfg in ['qwen3-8b','qwen3-8b-think','falcon-h1r-7b']:","+  for kind in ['mswea','terminus_think','sql']:","+    path=f'/tmp/full_{kind}_{cfg}.pt'","+    try: d=torch.load(path,map_location='cpu',weights_only=True)","+    except Exception: continue","+    orig=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    stats=collections.Counter(); max_mapped=-1e9; min_mapped=1e9","+    turn_cov=collections.defaultdict(lambda:[0,0])  # bucket by turn quartile index-first/mid/last -> use run ordinal relative: first, middle, last","+    field_cov=collections.defaultdict(lambda:[0,0])","+    for s,so in zip(d['samples'],orig['samples']):","+        R=s['response_length']; t=s['teacher_log_probs']; t=t.tolist() if hasattr(t,'tolist') else list(t)","+        r=list(s['rollout_log_probs'])[-R:]; lm=s['loss_mask']","+        assert len(t)==R, (len(t),R)","+        assert all(math.isfinite(x) for x in t)","+        # verdict raw rewards? s.reward is normalized; metadata reward unchanged","+        assert s['metadata']['reward']==so['metadata']['reward']","+        plen=len(s['tokens'])-R","+        mapped=[i for i in range(R) if abs(t[i]-r[i])>1e-6]","+        for i in mapped:","+            max_mapped=max(max_mapped,t[i]); min_mapped=min(min_mapped,t[i])","+            if not lm[i]: stats['mapped_untrained']+=1","+        stats['trained']+=sum(lm); stats['mapped_trained']+=sum(1 for i in mapped if lm[i])","+        # runs buckets","+        runs=[]; i=0","+        while i<R:","+            if lm[i]:","+                j=i","+                while j<R and lm[j]: j+=1","+                runs.append((i,j)); i=j","+            else: i+=1","+        for ri,(a,b) in enumerate(runs):","+            bucket='first' if ri==0 else ('last' if ri==len(runs)-1 else 'mid')","+            turn_cov[bucket][1]+=b-a; turn_cov[bucket][0]+=sum(1 for k in range(a,b) if abs(t[k]-r[k])>1e-6)","+        # field coverage: sequential find reasoning/content/arg values in student text","+        text=stud.decode(s['tokens']); tb=text.encode(); sp=spans(s['tokens'])","+        # token token index by byte start","+        cursor=0","+        for m in s['metadata']['messages']:","+            fields=[]","+            if m['role']=='assistant':","+                if m.get('reasoning_content'): fields.append(('reasoning',m['reasoning_content']))","+                if m.get('content'): fields.append(('content',m['content']))","+                for tc in m.get('tool_calls') or []:","+                    fn=tc['function']; fields.append(('tool_name',fn['name']))","+                    for k,v in fn['arguments'].items(): fields.append(('arg_'+k,v))","+            else:","+                if isinstance(m.get('content'),str) and m['content'].strip(): fields.append(('ctx',m['content']))","+            for fname,val in fields:","+                core=val.strip() if isinstance(val,str) else ''","+                if not core: continue","+                idx=tb.find(core.encode(),cursor)","+                if idx<0: ","+                    if fname!='ctx': field_cov[fname+'_notfound'][1]+=1","+                    continue","+                cursor=idx+len(core.encode())","+                if fname=='ctx': continue","+                for full_i,(a,b) in enumerate(sp):","+                    ri=full_i-plen","+                    if 0<=ri<R and lm[ri] and a>=idx and b<=idx+len(core.encode()):","+                        field_cov[fname][1]+=1","+                        if abs(t[ri]-r[ri])>1e-6: field_cov[fname][0]+=1","+    print(f\"\\n{cfg} {kind}: trained_cov={stats['mapped_trained']/stats['trained']:.4f} mapped_untrained={stats['mapped_untrained']} teacher_mapped_range=[{min_mapped:.2f},{max_mapped:.4f}]\")","+    print(' turn buckets', {k:f\"{v[0]}/{v[1]}={v[0]/max(v[1],1):.3f}\" for k,v in turn_cov.items()})","+    print(' fields', {k:f\"{v[0]}/{v[1]}={v[0]/max(v[1],1):.3f}\" for k,v in sorted(field_cov.items()) if v[1]})","+print(\"\\nAll length/finite/verdict assertions passed\")"],"newLines":80,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/verify_saved.py"}]}