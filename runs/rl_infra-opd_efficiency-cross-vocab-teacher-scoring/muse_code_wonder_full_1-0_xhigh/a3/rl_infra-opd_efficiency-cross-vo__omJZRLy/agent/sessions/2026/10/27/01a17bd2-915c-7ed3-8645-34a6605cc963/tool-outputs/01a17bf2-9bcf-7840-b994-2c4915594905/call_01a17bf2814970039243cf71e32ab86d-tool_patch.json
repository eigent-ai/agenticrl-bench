{"files":[{"hunks":[{"lines":["+import sys, asyncio, argparse","+sys.path.insert(0,'/app/miles')","+from miles.utils.types import Sample","+from transformers import AutoTokenizer","+from examples.terminal_opd.reward import reward_func, post_process_rewards","+","+stok=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+prompt=[{\"role\":\"system\",\"content\":\"You are helpful.\"},{\"role\":\"user\",\"content\":\"What is the capital of France?\"}]","+prompt_text=stok.apply_chat_template(prompt, tokenize=False, add_generation_prompt=True, enable_thinking=False)","+prompt_ids=stok.encode(prompt_text, add_special_tokens=False)","+resp=\"The capital of France is Paris.\"","+resp_ids=stok.encode(resp, add_special_tokens=False)+[stok.eos_token_id]","+s=Sample(index=0, group_index=0, prompt=prompt, tokens=prompt_ids+resp_ids, response=resp,","+         response_length=len(resp_ids), loss_mask=[1]*len(resp_ids), rollout_log_probs=[-0.5]*len(resp_ids),","+         metadata={\"reward\":1.0}, status=Sample.Status.COMPLETED)","+args=argparse.Namespace(hf_checkpoint='/models/Qwen3.5-2B', rm_url='http://127.0.0.1:30020/generate',","+  teacher_tokenizer_path='/models/Qwen3-8B', opd_prompt_messages_key='messages',","+  opd_teacher_chat_template_kwargs={'enable_thinking':False}, opd_teacher_timeout=30, opd_teacher_retries=0,","+  opd_teacher_concurrency=4, advantage_estimator='grpo', rewards_normalization=False,","+  opd_log_prob_top_k=0, sglang_router_request_timeout_secs=None, opd_teacher_urls=None)","+async def main():","+    s.reward=await reward_func(args,s)","+    print('reward keys', s.reward.keys(), 'teacher aligned', s.reward['teacher'])","+asyncio.run(main())","+raw,rew=post_process_rewards(args,[s])","+print('teacher_log_probs', s.teacher_log_probs.tolist())","+print('pieces', [stok.decode([i]) for i in resp_ids])","+sig=sum(abs(a+0.5)>1e-6 for a in s.teacher_log_probs.tolist())","+print('with signal',sig,'/',len(resp_ids),'rewards',raw,rew)","+assert sig>=len(resp_ids)-2","+# plain string prompt variant, no messages anywhere","+s2=Sample(index=1, group_index=0, prompt=\"Question: capital of France?\\nAnswer:\", tokens=stok.encode(\"Question: capital of France?\\nAnswer:\",add_special_tokens=False)+resp_ids,","+  response=resp, response_length=len(resp_ids), loss_mask=[1]*len(resp_ids), rollout_log_probs=[-0.5]*len(resp_ids),","+  metadata={\"reward\":0.0}, status=Sample.Status.COMPLETED)","+async def main2():","+    s2.reward=await reward_func(args,s2)","+    print('plain aligned', s2.reward['teacher'])","+asyncio.run(main2())","+post_process_rewards(args,[s2])","+print('plain teacher', s2.teacher_log_probs.tolist())","+sig2=sum(abs(a+0.5)>1e-6 for a in s2.teacher_log_probs.tolist())","+print('plain with signal',sig2)","+assert sig2>=len(resp_ids)-2","+print('SINGLE TURN PROBES OK')"],"newLines":44,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/probe_single_turn.py"}]}