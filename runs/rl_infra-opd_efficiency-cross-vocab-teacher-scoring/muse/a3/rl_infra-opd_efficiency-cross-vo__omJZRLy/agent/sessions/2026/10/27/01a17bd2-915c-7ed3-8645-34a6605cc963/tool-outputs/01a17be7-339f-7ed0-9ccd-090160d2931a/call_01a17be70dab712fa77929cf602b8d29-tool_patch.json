{"files":[{"hunks":[{"lines":["     return await _score_plain(args, sample, student_tok, teacher_tok)"," "," ","+def _aligned_from_legacy_result(args, sample, reward):","+    \"\"\"Align an old-format teacher reply (``meta_info`` + ``_cross_vocab_meta``), if present.\"\"\"","+    try:","+        all_info = reward[\"meta_info\"][\"input_token_logprobs\"]","+        teacher_prompt_len = int(reward[\"_cross_vocab_meta\"][\"teacher_prompt_len\"])","+    except (KeyError, TypeError, ValueError):","+        return None","+    student_tok, teacher_tok = _load_tokenizers(args)","+    if teacher_tok is None:","+        return None","+    resp_info = all_info[teacher_prompt_len:]","+    teacher_ids = [int(item[1]) for item in resp_info]","+    teacher_lps = [item[0] for item in resp_info]","+    prompt_len = len(sample.tokens) - sample.response_length","+    student_text, student_spans = _decode_with_spans(student_tok, sample.tokens[prompt_len:])","+    teacher_text, teacher_spans = _decode_with_spans(teacher_tok, teacher_ids)","+    if student_spans is None or teacher_spans is None:","+        return []","+    teacher_tokens = [(a, b, teacher_lps[i]) for i, (a, b) in enumerate(teacher_spans)]","+    aligned = _align_text_spans(student_text, student_spans, teacher_text, teacher_tokens)","+    return [[j, lp] for j, lp in sorted(aligned.items())]","+","+","+def post_process_cross_vocab(args, samples: list[Sample], teacher_results: list) -> None:","+    \"\"\"Fill ``teacher_log_probs`` from aligned pairs; unaligned positions get no signal.\"\"\"","+    for sample, reward in zip(samples, teacher_results, strict=True):","+        resp_len = sample.response_length","+        if resp_len == 0:","+            sample.teacher_log_probs = torch.empty(0, dtype=torch.float32)","+            continue","+        if reward is None or (isinstance(reward, dict) and reward.get(\"_opd_teacher_fallback\")):","+            reason = \"no_teacher\" if reward is None else reward.get(\"_opd_teacher_fallback_reason\", \"teacher_failed\")","+            _use_student_log_probs_for_teacher(sample, reason)","+            continue","+","+        aligned = reward.get(_ALIGNED_KEY) if isinstance(reward, dict) else None","+        if aligned is None and isinstance(reward, dict):","+            aligned = _aligned_from_legacy_result(args, sample, reward)","+        if aligned is None:","+            _use_student_log_probs_for_teacher(sample, \"unrecognised_teacher_reply\")","+            continue","+","+        values = _student_fallback_values(sample)","+        applied = 0","+        for pair in aligned:","+            try:","+                pos, lp = int(pair[0]), float(pair[1])","+            except (TypeError, ValueError, IndexError):","+                continue","+            if 0 <= pos < resp_len and math.isfinite(lp):","+                values[pos] = lp","+                applied += 1","+        sample.teacher_log_probs = torch.tensor(values, dtype=torch.float32)","+        if sample.metadata is None:","+            sample.metadata = {}","+        if sample.loss_mask is not None and len(sample.loss_mask) == resp_len:","+            trained = sum(1 for m in sample.loss_mask if m)","+            trained_aligned = sum(","+                1 for pair in aligned","+                if 0 <= int(pair[0]) < resp_len and sample.loss_mask[int(pair[0])]","+            )","+            sample.metadata[\"cross_vocab_token_overlap\"] = trained_aligned / trained if trained else 0.0","+        else:","+            sample.metadata[\"cross_vocab_token_overlap\"] = applied / resp_len if resp_len else 0.0","+        stats = reward.get(_STATS_KEY) if isinstance(reward, dict) else None","+        if isinstance(stats, dict):","+            sample.metadata[\"cross_vocab_scored_turns\"] = stats.get(\"scored_turns\")","+            sample.metadata[\"cross_vocab_turns\"] = stats.get(\"turns\")","+            if stats.get(\"turns\") and not stats.get(\"scored_turns\"):","+                sample.metadata[\"opd_teacher_fallback\"] = True","+                sample.metadata[\"opd_teacher_fallback_reason\"] = \"no_turn_scored\"","+","+"],"newLines":76,"newStart":689,"oldLines":3,"oldStart":689}],"path":"/app/miles/examples/terminal_opd/teacher_scoring.py"}]}