{"files":[{"hunks":[{"lines":["+\"\"\"Regression tests for cross-tokenizer teacher scoring.","+","+Run from the miles repo root:  python -m unittest examples.terminal_opd.test_teacher_scoring","+Needs the tokenizers under /models and the recorded episodes under","+/app/data/rollouts; tests are skipped when either is absent.  A stub teacher","+stands in for the SGLang server: it captures the payloads it receives and","+answers with deterministic per-token log-probs (first returned entry empty,","+as SGLang does).","+\"\"\"","+","+import argparse","+import asyncio","+import os","+import unittest","+","+import torch","+","+MODELS = \"/models\"","+ROLLOUTS = \"/app/data/rollouts\"","+HAVE_ASSETS = os.path.isdir(os.path.join(MODELS, \"Qwen3-8B\")) and os.path.isdir(ROLLOUTS)","+","+","+def make_args(teacher_path, chat_kwargs=None):","+    return argparse.Namespace(","+        hf_checkpoint=os.path.join(MODELS, \"Qwen3.5-2B\"),","+        rm_url=\"http://stub/generate\",","+        teacher_tokenizer_path=teacher_path,","+        opd_prompt_messages_key=\"messages\",","+        opd_teacher_chat_template_kwargs=chat_kwargs or {\"enable_thinking\": False},","+        opd_teacher_timeout=30,","+        opd_teacher_retries=0,","+        opd_teacher_concurrency=4,","+    )","+","+","+def load_sample(kind, index=0):","+    from miles.utils.types import Sample","+","+    data = torch.load(os.path.join(ROLLOUTS, kind, \"rollout_0.pt\"), map_location=\"cpu\", weights_only=True)","+    return Sample.from_dict(data[\"samples\"][index])","+","+","+def stub_teacher(captured):","+    async def _stub(args, url, payload, sample, warning_prefix):","+        captured.append(payload)","+        ids = payload[\"input_ids\"]","+        start = payload[\"logprob_start_len\"]","+        entries = [","+            [None if offset == 0 else -(((token_id * 31 + idx) % 97) / 10.0 + 0.01), token_id, None]","+            for offset, (idx, token_id) in enumerate(","+                (i, ids[i]) for i in range(start, len(ids))","+            )","+        ]","+        return {\"meta_info\": {\"input_token_logprobs\": entries, \"prompt_tokens\": len(ids)}}","+","+    return _stub","+","+","<redacted-email>(HAVE_ASSETS, \"needs /models tokenizers and /app/data/rollouts\")","+class TestRouting(unittest.TestCase):","+    def test_same_tokenizer_is_not_cross_vocab(self):","+        from examples.terminal_opd import teacher_scoring","+","+        self.assertFalse(teacher_scoring.is_cross_vocab(make_args(os.path.join(MODELS, \"Qwen3.5-9B\"))))","+        self.assertFalse(teacher_scoring.is_cross_vocab(make_args(os.path.join(MODELS, \"Qwen3.5-2B\"))))","+        self.assertFalse(teacher_scoring.is_cross_vocab(make_args(None)))","+","+    def test_other_tokenizer_is_cross_vocab(self):","+        from examples.terminal_opd import teacher_scoring","+","+        self.assertTrue(teacher_scoring.is_cross_vocab(make_args(os.path.join(MODELS, \"Qwen3-8B\"))))","+        self.assertTrue(teacher_scoring.is_cross_vocab(make_args(os.path.join(MODELS, \"Falcon-H1R-7B\"))))","+","+","+class TestAlignment(unittest.TestCase):","+    def test_shared_boundary_blocks(self):","+        from examples.terminal_opd.teacher_scoring import _align_text_spans","+","+        # student: \"ab\" | \"c\" | \"de\" ; teacher: \"a\" | \"b\" | \"cd\" | \"e\"","+        aligned = _align_text_spans(","+            \"abcde\",","+            [(0, 2), (2, 3), (3, 5)],","+            \"abcde\",","+            [(0, 1, -1.0), (1, 2, -2.0), (2, 4, -4.0), (4, 5, -8.0)],","+        )","+        # \"ab\" is one student token made of two teacher tokens: summed.","+        self.assertEqual(aligned[0], -3.0)","+        # \"c\"+\"de\" share only the block boundaries with \"cd\"+\"e\": the block","+        # lands on its first student token; \"de\" starts mid-teacher-token.","+        self.assertEqual(aligned[1], -12.0)","+        self.assertNotIn(2, aligned)","+","+    def test_unshared_text_gets_nothing(self):","+        from examples.terminal_opd.teacher_scoring import _align_text_spans","+","+        aligned = _align_text_spans(","+            \"<x>keep</x>\",","+            [(0, 3), (3, 7), (7, 11)],","+            '{\"v\": \"keep\"}',","+            [(0, 7, -1.0), (7, 11, -2.0), (11, 13, -4.0)],","+        )","+        self.assertEqual(aligned, {1: -2.0})","+","+    def test_missing_logprob_breaks_block(self):","+        from examples.terminal_opd.teacher_scoring import _align_text_spans","+","+        aligned = _align_text_spans(\"ab\", [(0, 2)], \"ab\", [(0, 1, None), (1, 2, -1.0)])","+        self.assertEqual(aligned, {})","+","+","<redacted-email>(HAVE_ASSETS, \"needs /models tokenizers and /app/data/rollouts\")","+class TestPerTurnScoring(unittest.TestCase):","+    def run_hooks(self, kind, index, chat_kwargs=None, teacher=\"Qwen3-8B\"):","+        from examples.terminal_opd import teacher_scoring","+","+        sample = load_sample(kind, index)","+        args = make_args(os.path.join(MODELS, teacher), chat_kwargs)","+        captured = []","+        original = teacher_scoring._post_teacher_json","+        teacher_scoring._post_teacher_json = stub_teacher(captured)","+        try:","+            result = asyncio.run(teacher_scoring.reward_func_cross_vocab(args, sample))","+        finally:","+            teacher_scoring._post_teacher_json = original","+        teacher_scoring.post_process_cross_vocab(args, [sample], [result])","+        return sample, captured","+","+    def test_sql_turns_sent_as_teacher_input_ids(self):","+        from transformers import AutoTokenizer","+","+        sample, captured = self.run_hooks(\"sql\", 2)","+        messages = sample.metadata[\"messages\"]","+        tools = sample.metadata[\"tools\"]","+        assistant_idx = [i for i, m in enumerate(messages) if m[\"role\"] == \"assistant\"]","+        self.assertEqual(len(captured), len(assistant_idx))","+        teacher_tok = AutoTokenizer.from_pretrained(os.path.join(MODELS, \"Qwen3-8B\"), trust_remote_code=True)","+        for payload, ai in zip(captured, assistant_idx, strict=True):","+            self.assertNotIn(\"text\", payload)","+            expected_text = teacher_tok.apply_chat_template(","+                messages[: ai + 1], tokenize=False, add_generation_prompt=False,","+                tools=tools, enable_thinking=False,","+            )","+            self.assertEqual(payload[\"input_ids\"], teacher_tok.encode(expected_text, add_special_tokens=False))","+","+    def test_sql_student_markup_gets_no_signal_but_query_does(self):","+        from transformers import AutoTokenizer","+","+        sample, _ = self.run_hooks(\"sql\", 0)","+        student_tok = AutoTokenizer.from_pretrained(os.path.join(MODELS, \"Qwen3.5-2B\"), trust_remote_code=True)","+        plen = len(sample.tokens) - sample.response_length","+        teacher = sample.teacher_log_probs.tolist()","+        rollout = list(sample.rollout_log_probs or [])","+        pieces = [","+            student_tok.decode([sample.tokens[plen + i]], skip_special_tokens=False)","+            for i in range(sample.response_length)","+        ]","+        signal = [abs(teacher[i] - rollout[i]) > 1e-6 and bool(sample.loss_mask[i]) for i in range(len(pieces))]","+        # Student-only XML scaffolding has no teacher counterpart.","+        for piece, has in zip(pieces, signal, strict=True):","+            if piece in (\"parameter\", \"function\"):","+                self.assertFalse(has, f\"scaffolding token {piece!r} must not get teacher signal\")","+        # The SQL text the student wrote does.","+        self.assertTrue(any(has for piece, has in zip(pieces, signal, strict=True) if \"SELECT\" in piece))","+","+    def test_reasoning_scored_on_every_turn_not_only_last(self):","+        from transformers import AutoTokenizer","+","+        sample, captured = self.run_hooks(\"terminus_think\", 0, chat_kwargs={\"enable_thinking\": True})","+        messages = sample.metadata[\"messages\"]","+        n_turns = sum(1 for m in messages if m[\"role\"] == \"assistant\")","+        self.assertEqual(len(captured), n_turns)","+        teacher = sample.teacher_log_probs.tolist()","+        rollout = list(sample.rollout_log_probs or [])","+        # Signal must exist in an early generated span (its reasoning would be","+        # dropped by a one-shot render of the finished conversation).","+        runs = []","+        start = None","+        for i, m in enumerate(sample.loss_mask):","+            if m and start is None:","+                start = i","+            elif not m and start is not None:","+                runs.append((start, i))","+                start = None","+        first_start, first_end = runs[0]","+        fraction = sum(","+            abs(teacher[i] - rollout[i]) > 1e-6 for i in range(first_start, first_end)","+        ) / (first_end - first_start)","+        self.assertGreater(fraction, 0.8)","+        # And in the last turn too.","+        last_start, last_end = runs[-1]","+        fraction_last = sum(","+            abs(teacher[i] - rollout[i]) > 1e-6 for i in range(last_start, last_end)","+        ) / (last_end - last_start)","+        self.assertGreater(fraction_last, 0.8)","+        self.assertEqual(len(teacher), sample.response_length)","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"newLines":199,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/examples/terminal_opd/test_teacher_scoring.py"}]}