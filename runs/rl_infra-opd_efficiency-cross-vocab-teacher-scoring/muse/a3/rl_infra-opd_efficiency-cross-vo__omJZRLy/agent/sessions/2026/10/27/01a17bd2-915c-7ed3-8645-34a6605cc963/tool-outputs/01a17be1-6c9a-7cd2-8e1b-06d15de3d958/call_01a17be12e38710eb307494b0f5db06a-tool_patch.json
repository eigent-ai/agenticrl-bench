{"files":[{"hunks":[{"lines":["+import torch,sys,difflib,collections","+sys.path.insert(0,'/app/miles')","+from miles.utils.types import Sample","+from transformers import AutoTokenizer","+","+def lcp(a,b):","+    n=min(len(a),len(b)); i=0","+    while i<n and a[i]==b[i]: i+=1","+    return i","+","+def spans_fast_or_none(tok, ids, text):","+    if not getattr(tok,'is_fast',False): return None","+    enc=tok(text, add_special_tokens=False, return_offsets_mapping=True)","+    if list(enc['input_ids'])!=list(ids): return None","+    return [tuple(x) for x in enc['offset_mapping']]","+","+def spans_incr(tok, ids):","+    # cumulative decode (small runs in proto)","+    spans=[]; prev=0","+    for k in range(1,len(ids)+1):","+        t=tok.decode(ids[:k], skip_special_tokens=False)","+        spans.append((prev,len(t))); prev=len(t)","+    return spans","+","+def get_spans(tok, ids):","+    text=tok.decode(ids, skip_special_tokens=False)","+    sp=spans_fast_or_none(tok,ids,text)","+    if sp is None: sp=spans_incr(tok,ids)","+    return text,sp","+","+def trained_runs(s):","+    out=[]; cur=None","+    for i,m in enumerate(s.loss_mask or []):","+        if cur is None or cur[0]!=m: cur=[m,i,i]; out.append(cur)","+        else: cur[2]=i","+    return [x for x in out if x[0]]","+","+def align_stats(student_text, sspans, teacher_text, tspans_full, seg_start):","+    # teacher spans shifted to segment coords","+    tseg=[(a-seg_start,b-seg_start) for a,b in tspans_full]","+    sm=difflib.SequenceMatcher(None, student_text, teacher_text, autojunk=False)","+    blocks=[b for b in sm.get_matching_blocks() if b.size>0]","+    stats=collections.Counter()","+    # build mapped teacher boundary: for matching block, student char x <-> teacher char y=x + (t0-s0)","+    # student token assignable (first-in-block scheme / exact span scheme counts)","+    covered_first=0; covered_exact=0; covered_any_block=0","+    # teacher boundaries set in teacher coords","+    tb=set()","+    for a,b in tseg: tb.add(a); tb.add(b)","+    for (s0,t0,size) in blocks:","+        stats['blocks']+=1; stats['block_chars']+=size","+        if size<3: stats['tiny_blocks']+=1","+        # student tokens completely in block","+        toks=[(a,b) for a,b in sspans if a>=s0 and b<=s0+size and b>a]","+        # teacher boundaries mapped to student coords","+        mapped_bounds=sorted(s0+(tbv-t0) for tbv in tb if t0<=tbv<=t0+size)","+        stud_bounds=sorted({a for a,b in toks} | {b for a,b in toks})","+        common=sorted(set(mapped_bounds)&set(stud_bounds))","+        # blocks between common boundaries","+        for c0,c1 in zip(common, common[1:]):","+            ms=sum(1 for a,b in toks if a>=c0 and b<=c1)","+            if ms:","+                covered_first+=1","+                covered_any_block+=ms","+                if ms==1: covered_exact+=1","+    stats['stud_tokens']=sum(1 for a,b in sspans if b>a)","+    stats['first']=covered_first; stats['exact']=covered_exact; stats['anyblock']=covered_any_block","+    return stats, blocks","+","+student_tok=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+configs={","+ 'Qwen3-8B(no-think)':('/models/Qwen3-8B',{'enable_thinking':False}),","+ 'Qwen3-8B(think)':('/models/Qwen3-8B',{'enable_thinking':True}),","+ 'Falcon':('/models/Falcon-H1R-7B',{}),","+}","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    samples=[Sample.from_dict(r) for r in d['samples'][:4]]","+    for cname,(path,tkw) in configs.items():","+        ttok=AutoTokenizer.from_pretrained(path,trust_remote_code=True)","+        tot=collections.Counter(); errs=0; turns=0","+        for s in samples:","+            msgs=s.metadata['messages']; tools=s.metadata.get('tools')","+            plen=len(s.tokens)-s.response_length","+            asst_idx=[i for i,m in enumerate(msgs) if m['role']=='assistant']","+            for ai,(m,a,b) in zip(asst_idx, trained_runs(s)):","+                turns+=1","+                kw=dict(tokenize=False, add_generation_prompt=False, **tkw)","+                kwg=dict(tokenize=False, add_generation_prompt=True, **tkw)","+                if tools: kw['tools']=tools; kwg['tools']=tools","+                try:","+                    full=ttok.apply_chat_template(msgs[:ai+1], **kw)","+                    gen=ttok.apply_chat_template(msgs[:ai], **kwg) if ai>0 else \"\"","+                except Exception as e:","+                    errs+=1; continue","+                seg_start=lcp(full,gen)","+                enc=ttok(full, add_special_tokens=False, return_offsets_mapping=True)","+                tspans=[tuple(x) for x in enc['offset_mapping']]","+                sids=s.tokens[plen+a:plen+b+1]","+                stext,sspans=get_spans(student_tok, sids)","+                tseg=full[seg_start:]","+                st,blocks=align_stats(stext,sspans,tseg,tspans,seg_start)","+                tot.update(st)","+                if kind=='sql' and s.index==samples[0].index and ai==asst_idx[0]:","+                    print(f\"\\nSQL segment example {cname} seg={tseg!r}\")","+                    print(f\" student raw={stext!r}\")","+                    print(' blocks', [(x.a,x.b,x.size, stext[x.a:x.a+x.size][:40]) for x in blocks])","+        print(f\"{kind:16s} {cname:20s} turns={turns} errs={errs} studtok={tot['stud_tokens']} firstcov={tot['first']/max(tot['stud_tokens'],1):.3f} exactcov={tot['exact']/max(tot['stud_tokens'],1):.3f} anyblockcov={tot['anyblock']/max(tot['stud_tokens'],1):.3f} blockchars_ratio calls tinyblocks={tot['tiny_blocks']}/{tot['blocks']}\")"],"newLines":108,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/proto_align.py"}]}