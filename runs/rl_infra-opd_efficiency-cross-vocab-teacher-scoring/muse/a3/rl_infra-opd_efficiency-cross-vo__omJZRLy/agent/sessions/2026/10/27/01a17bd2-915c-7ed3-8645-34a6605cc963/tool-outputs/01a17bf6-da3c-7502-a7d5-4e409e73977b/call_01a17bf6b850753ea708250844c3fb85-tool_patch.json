{"files":[{"hunks":[{"lines":["+import sys, json, urllib.request","+sys.path.insert(0,'/app/miles')","+import torch","+from miles.utils.types import Sample","+from transformers import AutoTokenizer","+from examples.terminal_opd import teacher_scoring as ts","+","+def post(payload):","+    req=urllib.request.Request('http://127.0.0.1:30000/generate', data=json.dumps(payload).encode(), headers={'Content-Type':'application/json'})","+    with urllib.request.urlopen(req, timeout=300) as r: return json.loads(r.read())","+","+stok=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+ttok=AutoTokenizer.from_pretrained('/models/Falcon-H1R-7B',trust_remote_code=True)","+raw=torch.load('/app/data/rollouts/mswea/rollout_0.pt',map_location='cpu',weights_only=True)","+scored=torch.load('/tmp/real_mswea.pt',map_location='cpu',weights_only=True)","+s0=Sample.from_dict(raw['samples'][0]); ss=Sample.from_dict(scored['samples'][0])","+plen=len(s0.tokens)-s0.response_length","+msgs=s0.metadata['messages']","+ais=[i for i,m in enumerate(msgs) if m['role']=='assistant']","+for run_i in [5]:","+    ai=ais[run_i]","+    hist=ttok.apply_chat_template(msgs[:ai], tokenize=False, add_generation_prompt=False)","+    full=ttok.apply_chat_template(msgs[:ai+1], tokenize=False, add_generation_prompt=False)","+    print('hist prefix of full?', full.startswith(hist), 'lcp', ts._lcp_len(full,hist), 'len hist', len(hist))","+    print('hist tail:', repr(hist[-200:]))","+    print('full around hist end:', repr(full[len(hist)-50:len(hist)+300]))","+    tids,tspans,eff=ts._encode_with_spans(ttok, full)","+    hids,hspans,effh=ts._encode_with_spans(ttok, hist)","+    print('eff hist prefix?', eff.startswith(effh), 'seg start char', len(effh))","+    print('segment head:', repr(eff[len(effh):len(effh)+300]))","+    print('hist ids prefix of full ids?', tids[:len(hids)]==hids, len(hids), len(tids))","+    # first divergence token","+    for k,(x,y) in enumerate(zip(hids,tids)):","+        if x!=y: print('token divergence at',k,x,y, tspans[k-2:k+3]); break","+    # student run","+    runs=ts._trained_runs(s0)","+    a,b=runs[run_i]","+    sids=s0.tokens[plen+a:plen+b]","+    stext,sspans=ts._decode_with_spans(stok,sids)","+    print('student run text:', repr(stext[:200]))","+    print('student first spans:', list(zip(sspans[:8],[stext[x:y] for x,y in sspans[:8]])))","+    # teacher tokens in segment around content","+    seg=len(effh)","+    for i,(x,y) in enumerate(tspans):","+        if y>=seg and x<seg+250:","+            print(' T',i,(x-seg,y-seg),repr(eff[x:y]), tids[i])","+    vals=ss.teacher_log_probs.tolist()","+    print('stored first 8 teacher vals', vals[a:a+8])","+    print('rollout first 8', s0.rollout_log_probs[a:a+8])","+    # fresh post like module start_len","+    out=post({\"input_ids\":tids,\"sampling_params\":{\"temperature\":0,\"max_new_tokens\":0,\"skip_special_tokens\":False},\"return_logprob\":True,\"logprob_start_len\":0})","+    ents=out['meta_info']['input_token_logprobs']","+    for i,(x,y) in enumerate(tspans):","+        if y>=seg and x<seg+80:","+            print(' fresh lp',i,repr(eff[x:y]),ents[i][0])"],"newLines":55,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/debug_mismatch.py"}]}