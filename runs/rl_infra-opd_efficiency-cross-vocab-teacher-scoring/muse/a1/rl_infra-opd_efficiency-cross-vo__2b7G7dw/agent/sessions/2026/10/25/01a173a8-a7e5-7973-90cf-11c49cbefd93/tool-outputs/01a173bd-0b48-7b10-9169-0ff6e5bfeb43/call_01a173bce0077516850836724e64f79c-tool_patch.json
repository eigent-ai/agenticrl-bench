{"files":[{"hunks":[{"lines":["+\"\"\"Focused checks for cross-tokenizer teacher scoring (run: python -m pytest examples/terminal_opd/test_teacher_scoring.py).","+","+Uses the tokenizers and recorded episodes on this box; the teacher server is faked in-process.","+\"\"\"","+","+import argparse","+import asyncio","+","+import torch","+","+from examples.terminal_opd import reward, teacher_scoring","+from miles.utils.types import Sample","+","+STUDENT = \"/models/Qwen3.5-2B\"","+","+","+def _args(teacher_path, kwargs=None):","+    return argparse.Namespace(","+        hf_checkpoint=STUDENT,","+        rm_url=\"http://teacher.invalid/generate\",","+        teacher_tokenizer_path=teacher_path,","+        opd_prompt_messages_key=\"messages\",","+        opd_teacher_chat_template_kwargs=kwargs or {},","+        opd_teacher_timeout=30,","+        opd_teacher_retries=0,","+        opd_teacher_concurrency=4,","+        advantage_estimator=\"grpo\",","+        rewards_normalization=True,","+    )","+","+","+def _sample(kind, pick_smallest=False):","+    d = torch.load(f\"/app/data/rollouts/{kind}/rollout_0.pt\", map_location=\"cpu\", weights_only=True)","+    rows = d[\"samples\"]","+    row = min(rows, key=lambda r: len(r[\"tokens\"])) if pick_smallest else rows[0]","+    return Sample.from_dict(row)","+","+","+def _fake_teacher(captured):","+    async def post(args, url, payload, sample, prefix):","+        captured.update(payload)","+        ids = payload[\"input_ids\"]","+        entries = [[None if i == 0 else -0.01 - ((tid * 2654435761) % 1000) / 100.0, tid, None] for i, tid in enumerate(ids)]","+        return {\"meta_info\": {\"input_token_logprobs\": entries}}","+","+    return post","+","+","+def test_same_tokenizer_teacher_is_not_cross_vocab():","+    assert reward._cross_vocab(_args(\"/models/Qwen3.5-9B\")) is False","+    assert reward._cross_vocab(_args(\"/models/Qwen3-8B\")) is True","+    assert reward._cross_vocab(_args(None)) is False","+","+","+def test_sql_episode_scored_in_teacher_format_on_every_turn(monkeypatch=None):","+    captured = {}","+    orig = teacher_scoring._post_teacher_json","+    teacher_scoring._post_teacher_json = _fake_teacher(captured)","+    try:","+        args = _args(\"/models/Qwen3-8B\", {\"enable_thinking\": False})","+        sample = _sample(\"sql\")","+        result = asyncio.run(teacher_scoring.reward_func_cross_vocab(args, sample))","+        teacher_scoring.post_process_cross_vocab(args, [sample], [result])","+    finally:","+        teacher_scoring._post_teacher_json = orig","+","+    # The teacher is sent token ids of its own rendering of the whole conversation.","+    assert \"input_ids\" in captured and captured.get(\"logprob_start_len\") == 0","+    from transformers import AutoTokenizer","+","+    stok = AutoTokenizer.from_pretrained(STUDENT)","+    ttok = AutoTokenizer.from_pretrained(\"/models/Qwen3-8B\")","+    teacher_text = ttok.decode(captured[\"input_ids\"])","+    assert \"You may call one or more functions\" in teacher_text  # Qwen3 tools prompt, not the student's","+    assert '{\"name\": \"execute_sql\", \"arguments\":' in teacher_text  # teacher tool-call format","+    assert \"<parameter=\" not in teacher_text  # no student XML tool calls anywhere","+    # Both the first and a later turn's queries are in the teacher sequence.","+    queries = [","+        tc[\"function\"][\"arguments\"][\"query\"]","+        for m in sample.metadata[\"messages\"]","+        if m[\"role\"] == \"assistant\"","+        for tc in (m.get(\"tool_calls\") or [])","+    ]","+    assert len(queries) > 2 and all(q in teacher_text for q in queries[:3])","+","+    assert sample.teacher_log_probs is not None","+    assert len(sample.teacher_log_probs) == sample.response_length","+    # A SELECT token written on the second turn carries teacher signal.","+    prompt_len = len(sample.tokens) - sample.response_length","+    runs, start = [], None","+    for i, v in enumerate(sample.loss_mask):","+        if v and start is None:","+            start = i","+        if not v and start is not None:","+            runs.append((start, i))","+            start = None","+    s, e = runs[1]","+    pos = next(i for i in range(s, e) if stok.decode([sample.tokens[prompt_len + i]]) == \"SELECT\")","+    assert float(sample.teacher_log_probs[pos]) != float(sample.rollout_log_probs[pos])","+","+","+def test_token_byte_spans_partition_text_for_split_utf8():","+    from transformers import AutoTokenizer","+","+    tok = AutoTokenizer.from_pretrained(\"/models/Falcon-H1R-7B\")","+    ids = tok.encode(\"héllo ✓ done\", add_special_tokens=False)","+    spans, blob = teacher_scoring._token_byte_spans(tok, ids)","+    assert blob == \"héllo ✓ done\".encode()","+    assert spans[0][0] == 0 and spans[-1][1] == len(blob)","+    assert all(spans[i][1] == spans[i + 1][0] for i in range(len(spans) - 1))","+","+","+if __name__ == \"__main__\":","+    test_same_tokenizer_teacher_is_not_cross_vocab()","+    test_sql_episode_scored_in_teacher_format_on_every_turn()","+    test_token_byte_spans_partition_text_for_split_utf8()","+    print(\"all teacher_scoring checks passed\")"],"newLines":117,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/miles/examples/terminal_opd/test_teacher_scoring.py"}]}