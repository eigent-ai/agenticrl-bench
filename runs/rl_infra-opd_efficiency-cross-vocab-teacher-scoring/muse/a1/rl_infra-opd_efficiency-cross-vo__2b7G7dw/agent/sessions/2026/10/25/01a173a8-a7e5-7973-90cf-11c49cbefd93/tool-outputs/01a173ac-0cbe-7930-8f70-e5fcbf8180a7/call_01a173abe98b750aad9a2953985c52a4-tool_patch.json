{"files":[{"hunks":[{"lines":["+import torch, sys, collections, json, difflib","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+stok = AutoTokenizer.from_pretrained('/models/Qwen3.5-2B')","+fixed = open('/app/miles/miles/utils/chat_template_utils/templates/qwen3.5_fixed.jinja').read()","+","+def runs(lm):","+    out=[]; s=None","+    for i,v in enumerate(lm):","+        if v and s is None: s=i","+        if not v and s is not None: out.append((s,i)); s=None","+    if s is not None: out.append((s,len(lm)))","+    return out","+","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt', map_location='cpu', weights_only=True)","+    rows=d['samples']","+    print('='*20, kind)","+    # 1) full render vs decoded tokens, first sample only detailed; count prefix relations all","+    stats=collections.Counter()","+    for r in rows:","+        md=r['metadata']; msgs=md['messages']","+        kw=dict(md.get('chat_template_kwargs') or {})","+        try:","+            rendered=stok.apply_chat_template(msgs, chat_template=fixed, tokenize=False, add_generation_prompt=False, tools=md.get('tools'), **kw)","+        except Exception as e:","+            stats[f'render_err {type(e).__name__}: {e}'[:120]]+=1; continue","+        dec=stok.decode(r['tokens'])","+        if rendered==dec: stats['equal']+=1","+        elif dec.startswith(rendered): stats['decoded startswith rendered']+=1","+        elif rendered.startswith(dec): stats['rendered startswith decoded']+=1","+        else:","+            # first diff position bucket relative","+            i=next((i for i,(a,b) in enumerate(zip(rendered,dec)) if a!=b), min(len(rendered),len(dec)))","+            stats[f'diverge@{i}/{len(dec)}']+=1","+    print(' full-render vs decode(tokens):', stats.most_common(8))","+    # detailed first diverge","+    for r in rows[:3]:","+        md=r['metadata']; msgs=md['messages']; kw=dict(md.get('chat_template_kwargs') or {})","+        rendered=stok.apply_chat_template(msgs, chat_template=fixed, tokenize=False, add_generation_prompt=False, tools=md.get('tools'), **kw)","+        dec=stok.decode(r['tokens'])","+        i=next((i for i,(a,b) in enumerate(zip(rendered,dec)) if a!=b), min(len(rendered),len(dec)))","+        print(f'  idx{r[\"index\"]} len rendered {len(rendered)} decoded {len(dec)} firstdiff {i}')","+        if i < min(len(rendered),len(dec)):","+            print('   rendered ctx', repr(rendered[max(0,i-120):i+200]))","+            print('   decoded  ctx', repr(dec[max(0,i-120):i+200]))","+        else:","+            longer = rendered if len(rendered)>len(dec) else dec","+            print('   tail extra', repr(longer[i:i+300]))","+    # 2) loss runs vs assistant messages","+    print(' loss-run examples (first sample, first 2 runs and last run):')","+    r=rows[0]; P=len(r['tokens'])-r['response_length']","+    assistants=[m for m in r['metadata']['messages'] if m['role']=='assistant']","+    rr=runs(r['loss_mask'])","+    for j in [0,1,len(rr)-1]:","+        if j>=len(rr): continue","+        s,e=rr[j]","+        txt=stok.decode(r['tokens'][P+s:P+e])","+        print(f'  run{j} tokens[{s}:{e}] len={e-s} txt={txt[:400]!r} ... tail={txt[-120:]!r}')","+        print(f'    msg content={assistants[j].get(\"content\",\"\")[:200]!r} reasoning={str(assistants[j].get(\"reasoning_content\"))[:200]!r} tool_calls={json.dumps(assistants[j].get(\"tool_calls\"))[:300]}')","+    print('  tokens after last loss run:', repr(stok.decode(r['tokens'][P+rr[-1][1]:]))[:400] if rr else None)","+    print('  tokens before first loss run (promptpart+resp prefix) tail:', repr(stok.decode(r['tokens'][:P+rr[0][0]])[-200:]) if rr else None)"],"newLines":62,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze2.py"}]}