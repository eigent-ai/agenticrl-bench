[(r['status'], last_tok==im_end, bool(r['loss_mask'] and r['loss_mask'][-1]))]+=1","+    print(kind, '(status,last=im_end,last loss=1)', cc)"],"newLines":73,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/analyze4.py"}]}