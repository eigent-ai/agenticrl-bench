{"files":[{"hunks":[{"lines":["+import torch, sys, collections, json","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+stok=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B')","+d=torch.load('/app/data/rollouts/sql/rollout_0.pt', map_location='cpu', weights_only=True)","+argtypes=collections.Counter(); ntc=collections.Counter(); esc=collections.Counter(); examples=[]","+for r in d['samples']:","+    for m in r['metadata']['messages']:","+        if m['role']=='assistant' and m.get('tool_calls'):","+            ntc[len(m['tool_calls'])]+=1","+            for tc in m['tool_calls']:","+                args=tc['function']['arguments']","+                for k,v in args.items():","+                    argtypes[(k,type(v).__name__)]+=1","+                    if isinstance(v,str):","+                        if '\"' in v: esc['dquote']+=1","+                        if '\\\\' in v: esc['backslash']+=1","+                        if '\\n' in v: esc['newline']+=1","+                        if any(ord(c)>127 for c in v): esc['nonascii']+=1","+                        if '<' in v or '>' in v: esc['angle']+=1","+                        if '&' in v: esc['amp']+=1","+                if len(m['tool_calls'])>1 and len(examples)<3:","+                    examples.append((r['index'], m))","+print('n tool_calls per assistant msg', ntc)","+print('arg types', argtypes)","+print('escapes', esc)","+for idx,m in examples:","+    print('multi example sample', idx, json.dumps(m)[:900])","+# find the sql reasoning assistant and mswea reasoning assistant","+for kind in ['sql','mswea']:","+    dd=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt', map_location='cpu', weights_only=True)","+    for r in dd['samples']:","+        for i,m in enumerate(r['metadata']['messages']):","+            if m['role']=='assistant' and m.get('reasoning_content'):","+                print(kind, 'sample', r['index'], 'msg#', i, json.dumps(m)[:700])","+# terminus empty content assistan