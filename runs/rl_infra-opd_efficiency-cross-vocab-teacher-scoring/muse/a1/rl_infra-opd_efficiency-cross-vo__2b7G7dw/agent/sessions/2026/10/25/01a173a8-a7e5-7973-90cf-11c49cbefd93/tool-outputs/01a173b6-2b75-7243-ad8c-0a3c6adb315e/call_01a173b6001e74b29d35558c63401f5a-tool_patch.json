{"files":[{"hunks":[{"lines":["+import torch, sys, difflib, collections, time","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+","+def bytes_to_unicode():","+    bs=list(range(ord(\"!\"),ord(\"~\")+1))+list(range(ord(\"¡\"),ord(\"¬\")+1))+list(range(ord(\"®\"),ord(\"ÿ\")+1))","+    cs=bs[:]; n=0","+    for b in range(256):","+        if b not in bs: bs.append(b); cs.append(256+n); n+=1","+    return {b:chr(c) for b,c in zip(bs,cs)}","+U2B={v:k for k,v in bytes_to_unicode().items()}","+def token_bytes(tok, ids):","+    out=[]","+    for ts in tok.convert_ids_to_tokens(ids):","+        if ts is None: out.append(b''); continue","+        if all(c in U2B for c in ts): out.append(bytes(U2B[c] for c in ts))","+        elif ts.startswith('<0x') and ts.endswith('>'):","+            try: out.append(bytes([int(ts[3:-1],16)]))","+            except: out.append(ts.encode())","+        else: out.append(ts.replace('▁',' ').encode())","+    return out","+def spans(tok, ids):","+    bs=token_bytes(tok,ids); sp=[]; o=0","+    for b in bs: sp.append((o,o+len(b))); o+=len(b)","+    return sp, b''.join(bs)","+def loss_runs(lm):","+    out=[]; s=None","+    for i,v in enumerate(lm):","+        if v and s is None: s=i","+        if not v and s is not None: out.append((s,i)); s=None","+    if s is not None: out.append((s,len(lm)))","+    return out","+","+stok=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B')","+teachers={'qwen3':(AutoTokenizer.from_pretrained('/models/Qwen3-8B'), None),'falcon':(AutoTokenizer.from_pretrained('/models/Falcon-H1R-7B'), {})}","+for tname,(ttok,_) in teachers.items():","+  for kind in ['mswea','terminus_think','sql']:","+    kw={'enable_thinking': kind=='terminus_think'} if tname=='qwen3' else {}","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt', map_location='cpu', weights_only=True)","+    tot=match=inblock=turns=0; t0=time.time(); render_err=0; seg_prefix_fail=0","+    for r in d['samples'][:4]:","+        md=r['metadata']; msgs=md['messages']; P=len(r['tokens'])-r['response_length']","+        sspans, sbytes = spans(stok, r['tokens'])","+        # sanity vs decode","+        # per-turn","+        assistants=[i for i,m in enumerate(msgs) if m['role']=='assistant']","+        rr=loss_runs(r['loss_mask'])","+        assert len(assistants)==len(rr)","+        for ai,(mi,(rs,re)) in enumerate(zip(assistants,rr)):","+            turns+=1","+            s_ids=r['tokens'][P+rs:P+re]","+            s_sp_local=[]; o=sspans[P+rs][0]","+            run_bytes=sbytes[sspans[P+rs][0]:sspans[P+re-1][1] if re>rs else sspans[P+rs][0]]","+            run_spans=[(a-o,b-o) for a,b in sspans[P+rs:P+re]]","+            try:","+                full=ttok.apply_chat_template(msgs[:mi+1], tokenize=False, add_generation_prompt=False, tools=md.get('tools'), **kw)","+                base=ttok.apply_chat_template(msgs[:mi], tokenize=False, add_generation_prompt=False, tools=md.get('tools'), **kw) if mi>0 else ''","+            except Exception as e:","+                render_err+=1; continue","+            if full.startswith(base): seg=full[len(base):]","+            else:","+                seg_prefix_fail+=1","+                # common prefix","+                p=0","+                while p<min(len(full),len(base)) and full[p]==base[p]: p+=1","+                seg=full[p:]","+            t_ids=ttok.encode(seg, add_special_tokens=False)","+            # NOTE tokenizing segment alone differs from tokenizing in full context at boundaries; only for coverage prototype","+            t_sp, t_bytes = spans(ttok, t_ids)","+            seg_bytes=seg.encode()","+            if t_bytes!=seg_bytes:","+                # use seg_bytes spans mismatch; skip count anomaly","+                pass","+            sm=difflib.SequenceMatcher(None, run_bytes, seg_bytes, autojunk=False)","+            tmap={}","+            # build per block later","+            matched=set(); inb=set()","+            tspan_by_rel={}","+            for a,b,size in sm.get_matching_blocks():","+                if size==0: continue","+                # teacher dict for tokens fully inside block region t[b:b+size]","+                td={}","+                for ti,(ta,tb) in enumerate(t_sp):","+                    if ta>=b and tb<=b+size: td[(ta-b,tb-b)]=ti","+                for si,(sa,sb) in enumerate(run_spans):","+                    if sa>=a and sb<=a+size:","+                        inb.add(si)","+                        if (sa-a,sb-a) in td: matched.add(si)","+            tot+=len(s_ids); match+=len(matched); inblock+=len(inb)","+    print(tname, kind, f'turns={turns} trained_tokens={tot} exact1to1={match} ({match/max(tot,1):.3f}) in_matching_bytes={inblock} ({inblock/max(tot,1):.3f}) render_err={render_err} seg_prefix_fail={seg_prefix_fail} time={time.time()-t0:.1f}s')"],"newLines":90,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/proto_align.py"}]}