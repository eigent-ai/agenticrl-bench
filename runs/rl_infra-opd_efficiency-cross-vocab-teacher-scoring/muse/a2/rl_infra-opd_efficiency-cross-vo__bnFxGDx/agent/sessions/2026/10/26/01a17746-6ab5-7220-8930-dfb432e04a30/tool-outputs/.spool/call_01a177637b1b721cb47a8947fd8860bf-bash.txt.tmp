39:[tool.pytest.ini_options]
40-# durations=0 will display all tests execution time, sorted in ascending order starting from from the slowest one.
41-# -vv will also display tests with duration = 0.00s
42-addopts = "--verbose --pyargs --durations=0 --strict-markers"  # always add these arguments to pytest
43:testpaths = ["./tests"]  # must be an explicit path to avoid importing another "tests" module
44-# directories to ignore when discovering tests
45-norecursedirs = [
46-    "external",
47-    "snapshots",
48-    "examples",
49-    "docs",
50-    "scripts",
51-    "tools",
