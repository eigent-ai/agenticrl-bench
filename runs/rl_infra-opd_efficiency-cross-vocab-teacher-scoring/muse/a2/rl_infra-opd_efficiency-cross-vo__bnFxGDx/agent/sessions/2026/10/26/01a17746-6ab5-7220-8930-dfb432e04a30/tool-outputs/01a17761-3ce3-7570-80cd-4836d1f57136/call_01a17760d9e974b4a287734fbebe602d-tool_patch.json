{"files":[{"hunks":[{"lines":["         sample.metadata = {}","     sample.metadata[\"opd_teacher_fallback\"] = True","     sample.metadata[\"opd_teacher_fallback_reason\"] = reason","+","+","+# ---------------------------------------------------------------------------","+# Tokenizer loading / identity","+# ---------------------------------------------------------------------------","+","+","+def _tokenizer_fingerprint(tokenizer) -> str:","+    \"\"\"Identity of a tokenizer's id assignment (vocab + merges + processing), excluding its chat template.\"\"\"","+    parts: list[str] = []","+    backend = getattr(tokenizer, \"backend_tokenizer\", None)","+    if backend is not None:","+        try:","+            parts.append(backend.to_str())","+        except Exception:","+            backend = None","+    if backend is None:","+        try:","+            parts.append(json.dumps(tokenizer.get_vocab(), sort_keys=True, ensure_ascii=False))","+        except Exception:","+            parts.append(type(tokenizer).__name__)","+        for attr in (\"merges\", \"vocab\", \"encoder\"):","+            value = getattr(tokenizer, attr, None)","+            if value is not None:","+                try:","+                    parts.append(json.dumps(value, sort_keys=True, ensure_ascii=False, default=str))","+                except Exception:","+                    parts.append(str(value)[:100000])","+    try:","+        parts.append(json.dumps(tokenizer.special_tokens_map, sort_keys=True, default=str))","+    except Exception:","+        pass","+    parts.append(type(tokenizer).__name__)","+    return hashlib.sha256(\"\\n\".join(parts).encode(\"utf-8\")).hexdigest()","+","+","+def _load_cross_vocab_tokenizers(args):","+    \"\"\"Load (and cache per path pair on ``args``) the student/teacher tokenizers.","+","+    Returns ``(student_tok, teacher_tok, same_tokenizer)``. ``same_tokenizer`` means the teacher assigns","+    the student's ids identically, so the teacher can score ``sample.tokens`` directly.","+    \"\"\"","+    teacher_path = getattr(args, \"teacher_tokenizer_path\", None)","+    if not teacher_path:","+        raise ValueError(","+            \"teacher_tokenizer_path is required for cross-vocabulary OPD. \"","+            \"It must point to the teacher model tokenizer.\"","+        )","+    student_path = getattr(args, \"hf_checkpoint\", None)","+    cache = getattr(args, \"_cross_vocab_tok_cache\", None)","+    if cache is None:","+        cache = {}","+        args._cross_vocab_tok_cache = cache","+    key = (student_path, teacher_path)","+    if key not in cache:","+        from transformers import AutoTokenizer","+","+        student_tok = AutoTokenizer.from_pretrained(student_path, trust_remote_code=True)","+        teacher_tok = AutoTokenizer.from_pretrained(teacher_path, trust_remote_code=True)","+        same = _tokenizer_fingerprint(student_tok) == _tokenizer_fingerprint(teacher_tok)","+        cache[key] = (student_tok, teacher_tok, same)","+    student_tok, teacher_tok, same = cache[key]","+    args._cross_vocab_student_tok = student_tok","+    args._cross_vocab_teacher_tok = teacher_tok","+    return student_tok, teacher_tok, same","+","+","+def same_tokenizer_as_student(args) -> bool:","+    \"\"\"True when no teacher tokenizer is named (legacy runs) or it is the student's own tokenizer.\"\"\"","+    if not getattr(args, \"teacher_tokenizer_path\", None):","+        return True","+    return _load_cross_vocab_tokenizers(args)[2]","+","+","+# ---------------------------------------------------------------------------","+# Byte spans of token sequences","+# ---------------------------------------------------------------------------","+","+","+def _make_byte_decoder() -> dict[str, int]:","+    # The GPT-2 byte-level alphabet used by Qwen/Falcon/Llama-3-style BPE tokenizers.","+    bs = list(range(33, 127)) + list(range(161, 173)) + list(range(174, 256))","+    cs = bs[:]","+    n = 0","+    for b in range(256):","+        if b not in bs:","+            bs.append(b)","+            cs.append(256 + n)","+            n += 1","+    return {chr(c): b for b, c in zip(bs, cs)}","+","+","+_BYTE_DECODER = _make_byte_decoder()","+_SPM_BYTE_RE = re.compile(r\"^<0x([0-9A-Fa-f]{2})>$\")","+","+","+def _pieces_byte_alphabet(tokenizer, token_ids) -> list[bytes] | None:","+    pieces = []","+    for tok in tokenizer.convert_ids_to_tokens(list(token_ids)):","+        if tok is None:","+            return None","+        if all(ch in _BYTE_DECODER for ch in tok):","+            pieces.append(bytes(_BYTE_DECODER[ch] for ch in tok))","+        else:","+            pieces.append(tok.encode(\"utf-8\"))","+    return pieces","+","+","+def _pieces_sentencepiece(tokenizer, token_ids) -> list[bytes] | None:","+    pieces = []","+    for tok in tokenizer.convert_ids_to_tokens(list(token_ids)):","+        if tok is None:","+            return None","+        m = _SPM_BYTE_RE.match(tok)","+        if m:","+            pieces.append(bytes([int(m.group(1), 16)]))","+        else:","+            pieces.append(tok.replace(\"▁\", \" \").encode(\"utf-8\"))","+    return pieces","+","+","+def _pieces_decoded(tokenizer, token_ids) -> list[bytes] | None:","+    return [","+        tokenizer.decode([tid], skip_special_tokens=False, clean_up_tokenization_spaces=False).encode(\"utf-8\")","+        for tid in token_ids","+    ]","+","+","+def _align_pieces_to_text(tokenizer, token_ids, pieces, text_bytes) -> list[tuple[int, int]] | None:","+    if pieces is None or len(pieces) != len(token_ids):","+        return None","+    try:","+        special_ids = set(tokenizer.all_special_ids or [])","+    except Exception:","+        special_ids = set()","+    spans: list[tuple[int, int]] = []","+    cur = 0","+    for tid, piece in zip(token_ids, pieces):","+        if piece and text_bytes.startswith(piece, cur):","+            spans.append((cur, cur + len(piece)))","+            cur += len(piece)","+        elif piece[:1] == b\" \" and len(piece) > 1 and text_bytes.startswith(piece[1:], cur):","+            # SentencePiece-style dummy prefix space that is not part of the text.","+            spans.append((cur, cur + len(piece) - 1))","+            cur += len(piece) - 1","+        elif not piece or int(tid) in special_ids:","+            spans.append((cur, cur))","+        else:","+            return None","+    return spans if cur == len(text_bytes) else None","+","+","+def _token_byte_spans(tokenizer, token_ids, text_bytes) -> list[tuple[int, int]] | None:","+    \"\"\"Byte span of every token in ``text_bytes``; verified against the text, ``None`` if not derivable.\"\"\"","+    token_ids = [int(t) for t in token_ids]","+    for make_pieces in (_pieces_byte_alphabet, _pieces_sentencepiece, _pieces_decoded):","+        try:","+            spans = _align_pieces_to_text(tokenizer, token_ids, make_pieces(tokenizer, token_ids), text_bytes)","+        except Exception:","+            spans = None","+        if spans is not None:","+            return spans","+    if 0 < len(token_ids) <= 2000:","+        spans = []","+        prev = 0","+        ok = True","+        for k in range(1, len(token_ids) + 1):","+            try:","+                b = len(","+                    tokenizer.decode(","+                        token_ids[:k], skip_special_tokens=False, clean_up_tokenization_spaces=False","+                    ).encode(\"utf-8\")","+                )","+            except Exception:","+                ok = False","+                break","+            b = max(b, prev)","+            spans.append((prev, b))","+            prev = b","+        if ok and prev == len(text_bytes):","+            return spans","+    return None","+","+","+def _encode_with_spans(tokenizer, text: str):","+    \"\"\"Tokenize ``text`` as the teacher server would (special tokens on) and return (ids, byte spans).\"\"\"","+    text_bytes = text.encode(\"utf-8\")","+    if getattr(tokenizer, \"is_fast\", False):","+        try:","+            enc = tokenizer(text, add_special_tokens=True, return_offsets_mapping=True)","+            ids = [int(t) for t in enc[\"input_ids\"]]","+            c2b = [0] * (len(text) + 1)","+            b = 0","+            for i, ch in enumerate(text):","+                c2b[i] = b","+                b += len(ch.encode(\"utf-8\"))","+            c2b[len(text)] = b","+            spans = [(c2b[a], c2b[z]) for a, z in enc[\"offset_mapping\"]]","+            covered = bytearray(len(text_bytes))","+            for a, z in spans:","+                for p in range(a, z):","+                    covered[p] = 1","+            if all(covered) or not text_bytes:","+                return ids, spans","+        except Exception:","+            pass","+    ids = [int(t) for t in tokenizer.encode(text, add_special_tokens=True)]","+    return ids, _token_byte_spans(tokenizer, ids, text_bytes)"],"newLines":211,"newStart":147,"oldLines":3,"oldStart":147}],"path":"/app/miles/examples/terminal_opd/teacher_scoring.py"}]}