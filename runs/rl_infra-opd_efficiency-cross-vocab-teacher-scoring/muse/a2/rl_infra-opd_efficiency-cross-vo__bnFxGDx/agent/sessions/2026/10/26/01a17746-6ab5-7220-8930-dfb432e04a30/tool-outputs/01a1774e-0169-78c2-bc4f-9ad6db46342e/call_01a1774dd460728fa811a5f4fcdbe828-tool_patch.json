{"files":[{"hunks":[{"lines":["+import torch, collections, json, sys","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+stud=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+for kind in ['mswea','terminus_think','sql']:","+    d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+    print(\"\\n==\",kind)","+    c=collections.Counter(); msgkeys=collections.Counter(); lastrole=collections.Counter(); lasttok=collections.Counter()","+    toolargtypes=collections.Counter(); contenttypes=collections.Counter()","+    empty_content=0; think_in_content=0; im_in_content=0","+    for s in d['samples']:","+        msgs=s['metadata'].get('messages') or []","+        lastrole[(s['status'], msgs[-1]['role'] if msgs else None)]+=1","+        lt=stud.decode([s['tokens'][-1]]) if s['tokens'] else ''","+        lasttok[(s['status'],lt)]+=1","+        for m in msgs:","+            msgkeys[tuple(sorted(m.keys()))]+=1","+            ct=m.get('content'); contenttypes[(m['role'],type(ct).__name__, ct is None)]+=1","+            if isinstance(ct,str):","+                if '</think>' in ct: think_in_content+=1","+                if '<|im_' in ct: im_in_content+=1","+                if ct=='': empty_content+=1","+            if m.get('tool_calls'):","+                for tc in m['tool_calls']:","+                    fn=tc.get('function',tc)","+                    toolargtypes[(type(fn.get('arguments')).__name__, tuple(sorted(tc.keys())), tuple(sorted(fn.keys())) if isinstance(fn,dict) else type(fn).__name__)]+=1","+                    if isinstance(fn.get('arguments'),dict):","+                        for k,v in fn['arguments'].items(): toolargtypes[('argval',k,type(v).__name__)]+=1","+        # loss mask segments","+        lm=s['loss_mask']","+        runs=[]","+        cur=lm[0] if lm else None; start=0","+        for i,x in enumerate(lm[1:],1):","+            if x!=cur: runs.append((cur,start,i)); cur,start=x,i","+        if lm: runs.append((cur,start,len(lm)))","+        c['runs_'+str(len([r for r in runs if r[0]==1]))]+=0","+    print('lastrole',lastrole)","+    print('lasttok',lasttok.most_common(10))","+    print('msgkeys',msgkeys)","+    print('contenttypes',contenttypes)","+    print('empty',empty_content,'think_in_content',think_in_content,'im_in_content',im_in_content)","+    print('toolargtypes',toolargtypes)","+    # detail first sample loss runs decoded start/end","+    s=d['samples'][0]; plen=len(s['tokens'])-s['response_length']","+    lm=s['loss_mask']; runs=[]; cur=lm[0]; start=0","+    for i,x in enumerate(lm[1:],1):","+        if x!=cur: runs.append((cur,start,i)); cur,start=x,i","+    runs.append((cur,start,len(lm)))","+    print('sample0 loss runs',len(runs))","+    for v,a,b in runs[:8]:","+        txt=stud.decode(s['tokens'][plen+a:plen+b])","+        print(f\" run mask={v} [{a}:{b}] len={b-a} text={repr(txt[:220])}...{repr(txt[-120:])}\")","+    for v,a,b in runs[-3:]:","+        txt=stud.decode(s['tokens'][plen+a:plen+b])","+        print(f\" lastrun mask={v} [{a}:{b}] len={b-a} text={repr(txt[:220])}...{repr(txt[-120:])}\")","+    # truncated example","+    tr=[x for x in d['samples'] if x['status']=='truncated']","+    if tr:","+        s=tr[0]; plen=len(s['tokens'])-s['response_length']; lm=s['loss_mask']","+        print('truncated sample len tok',len(s['tokens']),'resp',s['response_length'],'msgs last',s['metadata']['messages'][-1]['role'] if s['metadata'].get('messages') else None)","+        print(' trunc last msgs:', json.dumps(s['metadata']['messages'][-2:])[:1500])","+        print(' trunc full tail:', repr(stud.decode(s['tokens'])[-600:]))","+        print(' trunc loss tail', lm[-20:])"],"newLines":63,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/explore3.py"}]}