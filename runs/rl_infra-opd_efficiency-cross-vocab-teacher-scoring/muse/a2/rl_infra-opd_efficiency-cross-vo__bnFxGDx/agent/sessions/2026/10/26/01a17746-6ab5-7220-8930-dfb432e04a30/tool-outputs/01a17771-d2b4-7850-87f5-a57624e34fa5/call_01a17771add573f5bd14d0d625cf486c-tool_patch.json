{"files":[{"hunks":[{"lines":["+import sys","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+from examples.terminal_opd.teacher_scoring import _TurnRenderer","+msgs=[","+ {\"role\":\"developer\",\"content\":\"Be terse.\"},","+ {\"role\":\"user\",\"content\":\"Run the query\"},","+ {\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"execute_sql\",\"arguments\":{\"database\":\"db\",\"query\":\"SELECT \\\"x\\\"\\nFROM t;\"}}}]},","+ {\"role\":\"tool\",\"content\":\"rows\",\"tool_call_id\":\"c1\",\"name\":\"execute_sql\"},","+ {\"role\":\"tool\",\"content\":\"more\",\"tool_call_id\":\"c2\",\"name\":\"execute_sql\"},","+ {\"role\":\"assistant\",\"content\":\"Done ✓\",\"reasoning_content\":\"thinking\\nstep\"},","+]","+tools=[{\"type\":\"function\",\"function\":{\"name\":\"execute_sql\",\"description\":\"q\",\"parameters\":{\"type\":\"object\",\"properties\":{\"database\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"}}}}}]","+for name,kw in [('Qwen3-8B',{\"enable_thinking\":False}),('Qwen3-8B',{\"enable_thinking\":True}),('Falcon-H1R-7B',{})]:","+    tok=AutoTokenizer.from_pretrained(f'/models/{name}',trust_remote_code=True)","+    r=_TurnRenderer(tok,msgs,tools,kw)","+    for i,m in enumerate(msgs):","+        if m['role']!='assistant': continue","+        out=r.score_text(i)","+        print(name,kw,'turn',i,'OK' if out else 'NONE')","+        if out: print('  emitted=',repr(out[1][:240]))","+# system + tools starting sql-like for falcon index bug probe","+msgs2=[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"q\"},{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":msgs[2][\"tool_calls\"]}] ","+for name,kw in [('Falcon-H1R-7B',{}),('Qwen3-8B',{\"enable_thinking\":False})]:","+    tok=AutoTokenizer.from_pretrained(f'/models/{name}',trust_remote_code=True)","+    out=_TurnRenderer(tok,msgs2,tools,kw).score_text(2)","+    print('sys+tool',