_loss_runs(sample)","+        assistant_indices = [i for i, m in enumerate(messages) if isinstance(m, dict) and m.get(\"role\") == \"assistant\"]","+        run_by_msg = {}","+        if runs is not None and len(runs) == len(assistant_indices):","+            run_by_msg = dict(zip(assistant_indices, runs))","+","+        turns_by_msg = {t.get(\"msg_index\"): t for t in reward.get(\"turns\") or [] if isinstance(t, dict)}","+        unscored = 0","+        global_cursor = 0","+        student_eos_ids = _eos_token_ids(student_tok)","+        teacher_special_ids = _special_token_ids(teacher_tok)","+","+        for msg_index, message in enumerate(messages):","+            if not isinstance(message, dict):","+                continue","+            if message.get(\"role\") != \"assistant\":","+                if not run_by_msg:","+                    for text in _content_texts(message.get(\"content\")):","+                        if text.strip():","+                            hit = _find_form(student_bytes, _field_forms(text), global_cursor, len(student_bytes))","+                            if hit:","+                                global_cursor = max(global_cursor, hit[1])","+                continue","+            turn = turns_by_msg.get(msg_index)","+            if turn is None or not turn.get(\"emitted_text\"):","+                unscored += 1","+                continue","+            if not isinstance(turn.get(\"result\"), dict) or turn[\"result\"].get(\"_opd_teacher_fallback\"):","+                unscored += 1","+                continue","+            lp_map = _teacher_lp_map(turn)","+            if not lp_map:","+                unscored += 1","+                continue","+            teacher_tokens = [","+                (tok_idx, tok_id, a, b, lp_map.get(tok_idx))","+                for tok_idx, tok_id, a, b in (turn.get(\"teacher_tokens\") or [])","+            ]","+            emitted_bytes = turn[\"emitted_text\"].encode(\"utf-8\")","+","+            run = run_by_msg.get(msg_index)","+            if run is not None:","+                region_start = student_spans[prompt_len + run[0]][0]","+                region_end = student_spans[prompt_len + run[1] - 1][1] if run[1] > run[0] else region_start","+            else:","+                region_start, region_end = global_cursor, len(student_bytes)","+","+            pairs: list = []","+            s_cur, t_cur = region_start, 0","+            for field in _assistant_fields(message):","+                found, s_cur, t_cur = _locate_field(","+                    student_bytes, emitted_bytes, s_cur, region_end, t_cur, len(emitted_bytes), field","+                )","+                pairs.extend(found)","+            if pairs:","+                global_cursor = max(global_cursor, max(s[1] for s, _t in pairs))","+","+            # Identical scaffolding between fields (turn markers the student also emitted, \"</think>\",","+            # shared \"<tool_call>\" wrappers, the turn end) carries the teacher's judgement too.","+            ordered = sorted(pairs, key=lambda p: (p[0][0], p[1][0]))","+            cleaned = []","+            for pair in ordered:","+                if cleaned and (pair[0][0] < cleaned[-1][0][1] or pair[1][0] < cleaned[-1][1][1]):","+                    continue","+                cleaned.append(pair)","+            gap_pairs = []","+            if cleaned:","+                bounds = [((region_start, region_start), (0, 0)), *cleaned, ((region_end, region_end), (len(emitted_bytes), len(emitted_bytes)))]","+                for (_ps, _pt), (ns, nt) in zip(","+                    [(p[0], p[1]) for p in bounds], [(p[0], p[1]) for p in bounds[1:]]","+                ):","+                    s_gap = student_bytes[_ps[1] : ns[0]]","+                    t_gap = emitted_bytes[_pt[1] : nt[0]]","+                    if not s_gap or not t_gap:","+                        continue","+                    if s_gap == t_gap:","+                        gap_pairs.app