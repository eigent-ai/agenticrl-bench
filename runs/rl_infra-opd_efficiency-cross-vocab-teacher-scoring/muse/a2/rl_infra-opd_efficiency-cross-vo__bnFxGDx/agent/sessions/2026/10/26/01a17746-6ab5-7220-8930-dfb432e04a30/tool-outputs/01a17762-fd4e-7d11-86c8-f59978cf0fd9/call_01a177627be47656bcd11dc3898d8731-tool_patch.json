{"files":[{"hunks":[{"lines":["             mapped[resp_idx] = True","             count += 1","     return count","+","+","+# ---------------------------------------------------------------------------","+# Hook entry points","+# ---------------------------------------------------------------------------","+","+","+async def reward_func_cross_vocab(args, sample: Sample, **kwargs):","+    \"\"\"Score every assistant turn once, in the teacher's rendering of the conversation at that turn.\"\"\"","+    _student_tok, teacher_tok, _same = _load_cross_vocab_tokenizers(args)","+    messages = _conversation_messages(args, sample)","+    if not messages:","+        return {\"_cross_vocab_v2\": True, \"turns\": [], \"_opd_teacher_fallback_reason\": \"no_messages\"}","+","+    tools = (sample.metadata or {}).get(\"tools\")","+    renderer = _TurnRenderer(teacher_tok, messages, tools, _chat_kwargs(args))","+    assistant_indices = [i for i, m in enumerate(messages) if isinstance(m, dict) and m.get(\"role\") == \"assistant\"]","+    runs = _loss_runs(sample)","+    if runs is not None and len(runs) == len(assistant_indices):","+        score_indices = [idx for idx, (a, b) in zip(assistant_indices, runs) if b > a]","+    else:","+        score_indices = assistant_indices","+","+    turns = []","+    pending = []  # (turn entry, payload)","+    for msg_index in score_indices:","+        entry: dict = {\"msg_index\": msg_index, \"result\": None}","+        turns.append(entry)","+        if msg_index == 0:","+            entry[\"reason\"] = \"no_prefix\"","+            continue","+        rendered = renderer.score_text(msg_index)","+        if rendered is None:","+            entry[\"reason\"] = \"render_failed\"","+            continue","+        score_text, emitted = rendered","+        try:","+            teacher_ids, teacher_spans = _encode_with_spans(teacher_tok, score_text)","+        except Exception as exc:  # tokenizer refused its own template output","+            entry[\"