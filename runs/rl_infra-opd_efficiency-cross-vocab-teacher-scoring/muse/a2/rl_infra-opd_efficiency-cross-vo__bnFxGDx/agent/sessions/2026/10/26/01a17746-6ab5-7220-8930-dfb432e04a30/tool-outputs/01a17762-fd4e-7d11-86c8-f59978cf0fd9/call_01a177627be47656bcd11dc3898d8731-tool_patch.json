p in teacher_tokens:","+                        if a >= after and int(tok_id) in teacher_special_ids and lp is not None and math.isfinite(lp):","+                            values[eos_resp_idx] = lp","+                            mapped[eos_resp_idx] = True","+                            break","+","+        sample.teacher_log_probs = torch.tensor(values, dtype=torch.float32)","+        if sample.metadata is None:","+            sample.metadata = {}","+        trained_count = sum(trained)","+        mapped_trained = sum(1 for i in range(resp_len) if mapped[i] and trained[i])","+        sample.metadata[\"cross_vocab_token_overlap\"] = sum(mapped) / resp_len if resp_len else 0.0","+        sample.metadata[\"cross_vocab_trained_coverage\"] = mapped_trained / trained_count if trained_count else 0.0","+        if unscored:","+            sample.metadata[\"opd_teacher_unscored_turns\"] = unscored"],"newLines":307,"newStart":792,"oldLines":3,"oldStart":792}],"path":"/app/miles/examples/terminal_opd/teacher_scoring.py"}]}