{"files":[{"hunks":[{"lines":["+import torch, sys, json, collections","+sys.path.insert(0,'/app/miles')","+from transformers import AutoTokenizer","+def make_bd():","+    bs=list(range(33,127))+list(range(161,173))+list(range(174,256)); cs=bs[:]; n=0","+    for b in range(256):","+        if b not in bs: bs.append(b); cs.append(256+n); n+=1","+    return {chr(c):b for b,c in zip(bs,cs)}","+BD=make_bd()","+def spans_byte_alphabet(tok,ids,text_bytes):","+    spans=[]; cur=0","+    for tid,t in zip(ids,tok.convert_ids_to_tokens(ids)):","+        if all(c in BD for c in t): piece=bytes(BD[c] for c in t)","+        else: piece=t.encode()","+        if text_bytes.startswith(piece,cur) and piece:","+            spans.append((cur,cur+len(piece))); cur+=len(piece)","+        else:","+            return None","+    return spans if cur==len(text_bytes) else None","+def spans_offsets(tok,text):","+    enc=tok(text,add_special_tokens=True,return_offsets_mapping=True)","+    ids=list(enc['input_ids']); offs=enc['offset_mapping']","+    # char->byte","+    c2b=[0]*(len(text)+1); b=0","+    for i,ch in enumerate(text): c2b[i]=b; b+=len(ch.encode())","+    c2b[len(text)]=b","+    return ids,[(c2b[a],c2b[z]) for a,z in offs]","+","+def lcp(a,b):","+    n=min(len(a),len(b)); i=0","+    while i<n and a[i]==b[i]: i+=1","+    return i","+def render(tok,msgs,tools,kwargs,gen):","+    kw=dict(tokenize=False,add_generation_prompt=gen); kw.update(kwargs)","+    if tools is not None: kw['tools']=tools","+    return tok.apply_chat_template(msgs,**kw)","+def candidates(v):","+    out=[]","+    def add(x):","+        if x and x not in out: out.append(x)","+    add(v); add(v.strip()); add(v.strip('\\n')); add(v.lstrip('\\n')); add(v.rstrip()); add(v.lstrip())","+    add(json.dumps(v,ensure_ascii=False)[1:-1]); add(json.dumps(v)[1:-1])","+    return [c for c in out if c.strip()]","+def find_field(text_b, v, start):","+    best=None","+    for c in candidates(v):","+        cb=c.encode(); i=text_b.find(cb,start)","+        if i>=0: return (i,i+len(cb))","+    return None","+","+def group_stats(s_spans,t_spans,s_range,t_range):","+    # tokens fully inside ranges","+    S=[(idx,a,b) for idx,(a,b) in enumerate(s_spans) if a>=s_range[0] and b<=s_range[1] and b>a]","+    T=[(idx,a-s_range[0]+0,b) for idx,(a,b) in enumerate(t_spans) if a>=t_range[0] and b<=t_range[1] and b>a]","+    # relative coords","+    S=[(idx,a-s_range[0],b-s_range[0]) for idx,a,b in S]","+    T=[(idx,a-t_range[0],b-t_range[0]) for idx,(a,b) in enumerate(t_spans) if a>=t_range[0] and b<=t_range[1] and b>a]","+    if not S or not T: return (0,0,0,0)","+    tb=set()","+    for _,a,b in T: tb.add(a); tb.add(b)","+    exact=sum(1 for _,a,b in S if a in tb and b in tb)","+    # groups at common boundaries within [max start, min end]","+    lo=max(S[0][1],T[0][1]); hi=min(S[-1][2],T[-1][2])","+    in_group=sum(1 for _,a,b in S if a>=lo and b<=hi)","+    return (len(S),exact,in_group, len(T))","+","+stud=AutoTokenizer.from_pretrained('/models/Qwen3.5-2B',trust_remote_code=True)","+teachers={'q8-nothink':(AutoTokenizer.from_pretrained('/models/Qwen3-8B',trust_remote_code=True),{\"enable_thinking\":False}),","+ 'q8-think':(AutoTokenizer.from_pretrained('/models/Qwen3-8B',trust_remote_code=True),{\"enable_thinking\":True}),","+ 'falcon':(AutoTokenizer.from_pretrained('/models/Falcon-H1R-7B',trust_remote_code=True),{})}","+for tname,(ttok,tkw) in teachers.items():","+    for kind in ['mswea','terminus_think','sql']:","+        d=torch.load(f'/app/data/rollouts/{kind}/rollout_0.pt',map_location='cpu',weights_only=True)","+        tot=collections.Counter()","+        for s in d['samples'][:8]:","+            msgs=s['metadata']['messages']; tools=s['metadata'].get('tools')","+            stext=stud.decode(s['tokens']); sb=stext.encode()","+            sspans=spans_byte_alphabet(stud,s['tokens'],sb)","+            plen=len(s['tokens'])-s['response_length']","+            trained=[plen+k for k,x in enumerate(s['loss_mask']) if x]","+            tot['trained']+=len(trained)","+            # runs","+            runs=[]; lm=s['loss_mask']; i=0","+            while i<len(lm):","+                if lm[i]==1:","+                    j=i","+                    while j<len(lm) and lm[j]==1: j+=1","+                    runs.append((plen+i,plen+j)); i=j","+                else: i+=1","+            assists=[(idx,m) for idx,m in enumerate(msgs) if m['role']=='assistant']","+            covered_exact=set(); covered_group=set(); covered_anchor=set()","+            for (mi,m),(ra,rb) in zip(assists,runs):","+                try:","+                    before=render(ttok,msgs[:mi],tools,tkw,False); beforegen=render(ttok,msgs[:mi],tools,tkw,True); thru=render(ttok,msgs[:mi+1],tools,tkw,False)","+                except Exception as e:","+                    tot['render_err']+=1; continue","+                if not thru.startswith(before) or not beforegen.startswith(before): tot['prefix_fail']+=1; continue","+                seg=thru[len(before):]; gensuf=beforegen[len(before):]; emitted=seg[lcp(gensuf,seg):]","+                score=beforegen+emitted","+                tids,tspans=spans_offsets(ttok,score)","+                emit_b_start=len(beforegen.encode())","+                s_lo=sspans[ra][0]; s_hi=sspans[rb-1][1]","+                scur=s_lo; tcur=emit_b_start","+                fields=[]","+                if isinstance(m.get('reasoning_content'),str) and m['reasoning_content'].strip(): fields.append(m['reasoning_content'])","+                if isinstance(m.get('content'),str) and m['content'].strip(): fields.append(m['content'])","+                for tc in m.get('tool_calls') or []:","+                    fn=tc.get('function',tc); fields.append(fn.get('name') or '')","+                    if isinstance(fn.get('arguments'),dict):","+                        for av in fn['arguments'].values(): fields.append(av if isinstance(av,str) else json.dumps(av))","+                score_b=score.encode()","+                for v in fields:","+                    if not v or not v.strip(): continue","+                    sf=find_field(sb,v,scur); tf=find_field(score_b,v,tcur)","+                    if sf and tf and sf[1]<=s_hi:","+                        scur=sf[1]; tcur=tf[1]","+                        n,ex,gr,nt=group_stats(sspans,tspans,sf,tf)","+                        # mark covered token indices approx","+                        for idx,(a,b) in enumerate(sspans):","+                            if a>=sf[0] and b<=sf[1] and plen<=idx and s['loss_mask'][idx-plen]:","+                                covered_anchor.add(idx)","+                        # exact/group marking detailed","+                        S=[idx for idx,(a,b) in enumerate(sspans) if a>=sf[0] and b<=sf[1] and b>a]","+                        tb=set()","+                        for a,b in tspans:","+                            if a>=tf[0] and b<=tf[1]: tb.add(a-tf[0]); tb.add(b-tf[0])","+                        for idx in S:","+                            a,b=sspans[idx]","+                            if (a-sf[0]) in tb and (b-sf[0]) in tb: covered_exact.add(idx)","+                            covered_group.add(idx)  # approx: any fully-in-span token is group-coverable ignoring edges","+                    else:","+                        tot['field_notfound']+=1","+            tot['anchor']+=len([x for x in covered_anchor if x in set(trained)])","+            tot['exact']+=len([x for x in covered_exact if x in set(trained)])","+            tot['group']+=len([x for x in covered_group if x in set(trained)])","+        print(tname,kind,dict(tot), 'exact/trained=%.3f group=%.3f anchor=%.3f'%(tot['exact']/max(tot['trained'],1),tot['group']/max(tot['trained'],1),tot['anchor']/max(tot['trained'],1)))"],"newLines":136,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/proto.py"}]}