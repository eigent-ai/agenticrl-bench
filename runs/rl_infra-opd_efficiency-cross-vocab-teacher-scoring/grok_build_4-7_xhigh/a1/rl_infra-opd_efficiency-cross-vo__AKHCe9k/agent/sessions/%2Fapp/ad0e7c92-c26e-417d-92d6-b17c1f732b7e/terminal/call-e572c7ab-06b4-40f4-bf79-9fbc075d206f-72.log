sks as setsid'd session leaders, so killing   # each child's process group also reaps grandchildren (npm -> node etc.).   # Children sharing the script's own group (never grok's task style) get a   # plain kill so grok and this script are never signalled.   OWN_PGID=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')   kill_pids() {     SIG=$1; shift     for PID in "$@"; do       PGID=$(ps -o pgid= -p "$PID" 2>/dev/null | tr -d ' ')       if [ -n "$PGID" ] && [ "$PGID" != "$OWN_PGID" ]; then         kill -"$SIG" -- "-$PGID" 2>/dev/null || kill -"$SIG" "$PID" 2>/dev/null       else         kill -"$SIG" "$PID" 2>/dev/null       fi     done   }   # Sleep in poll-sized slices so we react promptly once grok exits.   wait_for_exit() {     REMAIN=$1     while [ "$REMAIN" -gt 0 ]; do       [ -f /tmp/.grok-build-ad0e7c92-c26e-417d-92d6-b17c1f732b7e.exit ] && return 0       sleep 5       REMAIN=$((REMAIN - 5))     done     [ -f /tmp/.grok-build-ad0e7c92-c26e-417d-92d6-b17c1f732b7e.exit ]   }   while [ ! -f /tmp/.grok-build-ad0e7c92-c26e-417d-92d6-b17c1f732b7e.exit ]; do     GROK_PID=$(cat /tmp/.grok-build-ad0e7c92-c26e-417d-92d6-b17c1f732b7e.pid 2>/dev/null)     # Snapshot live children so orphans can be swept after grok exits.     [ -n "$GROK_PID" ] && ps -o pid= --ppid "$GROK_PID" 2>/dev/null > /tmp/.grok-build-ad0e7c92-c26e-417d-92d6-b17c1f732b7e.children     sleep 5     grep -qs '"type":"turn_ended"' "$HOME"/.grok/sessions/*/ad0e7c92-c26e-417d-92d6-b17c1f732b7e/events.jsonl || continue     wait_for_exit 27060 && break     [ -n "$GROK_PID" ] || continue     CHILDREN=$(ps -o pid= --ppid "$GROK_PID" 2>/dev/null)     [ -n "$CHILDREN" ] || continue     echo "$(date -u +%FT%TZ) grok-build watchdog: grok still running 27060s after turn end; terminating leftover child process groups: $CHILDREN" | tee -a /logs/agent/grok-build-watchdog.log >&2     kill_pids TERM $CHILDREN     wait_for_exit 10 && break     CHILDREN=$(ps -o pid= --ppid "$GROK_PID" 2>/dev/null)     [ -n "$CHILDREN" ] && kil