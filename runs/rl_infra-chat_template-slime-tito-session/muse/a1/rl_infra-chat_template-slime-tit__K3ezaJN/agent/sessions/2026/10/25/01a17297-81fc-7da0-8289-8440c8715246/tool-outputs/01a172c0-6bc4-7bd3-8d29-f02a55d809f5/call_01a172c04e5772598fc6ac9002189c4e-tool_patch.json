{"files":[{"hunks":[{"lines":["         self.assertEqual(self.tok.decode(trained, skip_special_tokens=True), \"kept answer\")"," "," ","+class ParsingTest(unittest.TestCase):","+    @classmethod","+    def setUpClass(cls):","+        cls.tok = AutoTokenizer.from_pretrained(MODEL, trust_remote_code=True)","+","+    def test_reasoning_split_matches_sglang(self):","+        reasoning, content = ReasoningParser().split(\" reasoning \\n</think>\\n content \", True)","+        self.assertEqual((reasoning, content), (\"reasoning \\n\", \"content\"))","+        reasoning, content = ReasoningParser().split(\" plain \", False)","+        self.assertEqual((reasoning, content), (None, \" plain \"))","+","+    def test_glm_tool_call_parsing_uses_tool_schema_types(self):","+        parser = OutputParser(self.tok, reasoning_parser=\"none\", tool_call_parser=\"glm47\")","+        tools = [{\"type\": \"function\", \"function\": {\"description\": None, \"name\": \"get\",","+                                                   \"parameters\": {\"type\": \"object\", \"properties\": {","+                                                       \"n\": {\"type\": \"integer\"}, \"s\": {\"type\": \"string\"}}},","+                                                   \"strict\": False}}]","+        text = (\"before <tool_call>get<arg_key>n</arg_key><arg_value>3</arg_value>\"","+                \"<arg_key>s</arg_key><arg_value>hi</arg_value></tool_call> after\")","+        ids = self.tok.encode(text, add_special_tokens=False) + [self.tok.eos_token_id]","+        msg, finish = parser.to_message([], ids, {\"type\": \"stop\", \"matched\": self.tok.eos_token_id},","+                                        tools=tools, tool_choice=\"auto\")","+        self.assertEqual(finish, \"tool_calls\")","+        self.assertEqual(msg[\"content\"], \"before  after\")","+        self.assertEqual(msg[\"tool_calls\"][0][\"function\"][\"name\"], \"get\")","+        self.assertEqual(__import__(\"json\").loads(msg[\"tool_calls\"][0][\"function\"][\"arguments\"]),","+                         {\"n\": 3, \"s\": \"hi\"})","+","+    def test_tool_call_history_arguments_are_parsed_before_template(self):","+        renderer = MessageRenderer(self.tok)","+        out = renderer.render_request({","+            \"messages\": [","+                {\"role\": \"user\", \"content\": \"hi\"},","+                {\"role\": \"assistant\", \"content\": None, \"tool_calls\": [","+                    {\"id\": \"c1\", \"type\": \"function\",","+                     \"function\": {\"name\": \"get\", \"arguments\": \"{\\\"x\\\": 1}\"}}]},","+                {\"role\": \"tool\", \"tool_call_id\": \"c1\", \"content\": \"ok\"},","+                {\"role\": \"user\", \"content\": \"go on\"},","+            ],","+            \"tools\": [{\"type\": \"function\",","+                       \"function\": {\"name\": \"get\", \"parameters\": {\"type\": \"object\"}}}],","+        })","+        self.assertIn('\"arguments\": {\"x\": 1}', out.text)","+","+"," if __name__ == \"__main__\":","     unittest.main()"],"newLines":50,"newStart":170,"oldLines":5,"oldStart":170}],"path":"/app/terminal_rl/tests/test_proxy.py"}]}