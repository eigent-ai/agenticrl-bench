           return _error(400, f\"Tool '{name}' not found in tools list.\")","+        for i, tool in enumerate(tools_raw):","+            try:","+                params = dump_tool(tool)[\"function\"].get(\"parameters\")","+            except RequestError as e:","+                return _error(400, str(e))","+            except Exception:","+                params = None","+            if params is None:","+                continue","             try:","-                input_ids = session.prompt_ids(messages, body.get(\"tools\"))","-            except Exception as e:  # template errors are client errors","-                logger.exception(\"session %s: cannot build prompt\", sid)","-                return _error(400, f\"cannot apply chat template: {e}\")","-            if len(input_ids) >= self.context_length:","-                return _error(","-                    400,","-                    f\"This model's maximum context length is {self.context_length} tokens. However, your messages \"","-                    f\"resulted in {len(input_ids)} tokens. Please reduce the length of the messages.\",","-                )","+                from jsonschema import Draft202012Validator, SchemaError","+                Draft202012Validator.check_schema(params)","+            except SchemaError as e:","+                return _error(400, f\"Tool {i} function has invalid 'parameters' schema: {e}\")","+            except Exception:","+                pass","+        explicit_max = body.get(\"max_completion_tokens\") or body.get(\"max_tokens\")","+        if explicit_max:","             try:","-                out = await self.engine.generate(input_ids, self._sampling_params(body, len(input_ids)))","-            except Exception as e:","-                logger.exception(\"session %s: engine call failed\", sid)","-                return _error(502, f\"engine error: {e}\", \"InternalServerError\")","-            session.add_output(out[\"output_ids\"], out[\"log_probs\"], out[\"fin