       for tool in tools:","+            params = tool[\"function\"].get(\"parameters\")","+            if isinstance(params, dict):","+                for k, v in (params.get(\"$defs\") or {}).items():","+                    if k in defs and defs[k] != v:","+                        raise RequestError(f\"tool definition '{k}' has multiple schemas\")","+                    defs[k] = v","+        if defs:","+            schema[\"$defs\"] = defs","+        return schema","+    return None","+","+"," class ProxyApp:","     def __init__(self, tokenizer, engine_url: str, *, served_model_name: str = \"policy\", template_kwargs=None,","                  reasoning_parser: str = \"think\", tool_call_parser: str = \"none\", context_length: int = 65536,","-                 default_max_tokens: int = 8192):","+                 default_max_tokens: int = 8192, generation_defaults: dict | None = None):","         self.tokenizer = tokenizer","         self.engine = EngineClient(engine_url)","-        self.store = SessionStore(MessageRenderer(tokenizer, template_kwargs))","-        self.parser = OutputParser(tokenizer, reasoning_parser, tool_call_parser)","+        self.renderer = MessageRenderer(tokenizer, template_kwargs)","+        self.store = SessionStore(self.renderer)","+        self.parser = OutputParser(tokenizer, reasoning_parser, tool_call_parser,","+                                    force_reasoning_template=self.renderer.force_reasoning_template)","         self.served_model_name = served_model_name","         self.context_length = context_length","         self.default_max_tokens = default_max_tokens","+        self.generation_defaults = (dict(generation_defaults) if generation_defaults is not None","+                                     else self._load_generation_defaults(tokenizer))","         self.num_requests = 0"," ","+    @staticmethod","+    def _load_generation_defaults(tokenizer) -> dict:","+        path = getattr(tokenizer, \"name_or_path\", None)","+        i