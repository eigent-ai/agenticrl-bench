{"files":[{"hunks":[{"lines":["         if output_ids and self.turn_end_ids and output_ids[-1] == self.turn_end_ids[0]:","             return output_ids, self.turn_end_ids[1:]","         return output_ids, []","+","+","+@dataclass","+class _Candidate:","+    ids: list[int]","+    text: str","+    seq: int","+    owner_group: int | None = None  # request group whose generation this is (None for prompts)","+","+","+@dataclass","+class PreparedPrompt:","+    ids: list[int]","+    text: str","+    rendered: RenderedPrompt","+","+","+@dataclass","+class _Turn:","+    prompt_ids: list[int]","+    output_ids: list[int]","+    log_probs: list[float]","+    finish_type: str","+    group: int","+    seq: int","+","+","+class Session:","+    \"\"\"One agent's turns. Generations stay tentative until the agent's next,","+    different request confirms it actually received them; an identical","+    re-send instead replaces them (the previous response never arrived).\"\"\"","+","+    def __init__(self, sid: str, renderer: MessageRenderer):","+        self.sid = sid","+        self.renderer = renderer","+        self.lock = asyncio.Lock()","+        self.turns: list[_Turn] = []","+        self._candidates: list[_Candidate] = []","+        self._seq = 0","+        self._next_group = 0","+        self._pending_group: int | None = None","+        self._pending_fingerprint: str | None = None","+        self._inflight: dict[str, asyncio.Event] = {}","+        self._last_prepared: PreparedPrompt | None = None","+        self.created = time.time()","+","+    # -- token-id splicing --------------------------------------------------","+    def _decode_ids(self, ids: list[int]) -> str:","+        tok = self.renderer.tokenizer","+        try:","+            return tok.decode(ids, skip_special_tokens=False, spaces_between_special_tokens=False,","+                              clean_up_tokenization_spaces=False)","+        except TypeError:","+            return tok.decode(ids, skip_special_tokens=False)","+","+    def _add_candidate(self, ids, text, owner_group=None):","+        if not ids or not text:","+            return","+        self._seq += 1","+        self._candidates.append(_Candidate(ids=list(ids), text=text, seq=self._seq, owner_group=owner_group))","+","+    def prepare(self, rendered: RenderedPrompt) -> PreparedPrompt:","+        text, fresh = rendered.text, list(rendered.ids)","+        best = None","+        for cand in sorted(self._candidates, key=lambda c: (-len(c.text), -c.seq)):","+            if len(cand.text) <= len(text) and text.startswith(cand.text):","+                best = cand","+                break","+        if best is None:","+            ids = fresh","+        elif len(best.text) == len(text):","+            ids = list(best.ids)","+        else:","+            remainder = text[len(best.text):]","+            try:","+                suffix = list(self.renderer.tokenizer.encode(remainder, add_special_tokens=False))","+            except Exception:","+                logger.exception(\"session %s: cannot tokenize prompt remainder; using fresh ids\", self.sid)","+                ids = fresh","+            else:","+                ids = list(best.ids) + suffix","+        prep = PreparedPrompt(ids=ids, text=text, rendered=rendered)","+        self._last_prepared = prep","+        return prep","+","+    def mark_prompt_sent(self, prep: PreparedPrompt):","+        self._add_candidate(prep.ids, prep.text)","+","+    # -- request lifecycle --------------------------------------------------","+    def begin_request(self, fingerprint: str | None) -> int:","+        \"\"\"Start a request under the lock; resolve the previous tentative group.\"\"\"","+        if self._pending_group is not None:","+            if fingerprint is not None and fingerprint == self._pending_fingerprint:","+                gone = self._pending_group","+                self.turns = [t for t in self.turns if t.group != gone]","+                self._candidates = [c for c in self._candidates if c.owner_group != gone]","+                logger.debug(\"session %s: identical retry; discarded undelivered group %s\", self.sid, gone)","+            self._pending_group = None","+            self._pending_fingerprint = None","+        self._next_group += 1","+        return self._next_group","+","+    def register_inflight(self, fingerprint: str | None) -> asyncio.Event:","+        event = asyncio.Event()","+        if fingerprint is not None:","+            self._inflight[fingerprint] = event","+        return event","+","+    def unregister_inflight(self, fingerprint: str | None, event: asyncio.Event):","+        if fingerprint is not None and self._inflight.get(fingerprint) is event:","+            self._inflight.pop(fingerprint, None)","+","+    def abort_inflight_duplicate(self, fingerprint: str | None) -> bool:","+        if fingerprint is None:","+            return False","+        event = self._inflight.get(fingerprint)","+        if event is not None and not event.is_set():","+            event.set()","+            return True","+        return False","+","+    def add_turn(self, prep: PreparedPrompt, output_ids, log_probs, finish_type: str,","+                 fingerprint: str | None, group: int, matched=None):","+        output_ids = [int(t) for t in output_ids]","+        lps = [float(x) for x in (log_probs or [])][: len(output_ids)]","+        lps += [0.0] * (len(output_ids) - len(lps))","+        self._seq += 1","+        turn = _Turn(prompt_ids=list(prep.ids), output_ids=output_ids, log_probs=lps,","+                     finish_type=finish_type, group=group, seq=self._seq)","+        self.turns.append(turn)","+        self._pending_group = group","+        self._pending_fingerprint = fingerprint","+        if output_ids:","+            seq_ids = list(prep.ids) + output_ids","+            self._add_candidate(seq_ids, self._decode_ids(seq_ids), owner_group=group)","+            # Variant without a trailing stop token, for templates that do not","+            # render the sampled stop token into the following history.","+            tok = self.renderer.tokenizer","+            special = set(getattr(tok, \"all_special_ids\", []) or [])","+            if finish_type == \"stop\" and (output_ids[-1] in special or output_ids[-1] == matched):","+                trimmed = list(prep.ids) + output_ids[:-1]","+                if trimmed and trimmed != seq_ids:","+                    self._add_candidate(trimmed, self._decode_ids(trimmed), owner_group=group)","+        return turn","+","+    # -- legacy API -----------------------------------------------------------","+    def prompt_ids(self, messages: list[dict], tools: list[dict] | None = None) -> list[int]:","+        prep = self.prepare(self.renderer.render_request({\"messages\": messages, \"tools\": tools}))","+        self.mark_prompt_sent(prep)","+        return list(prep.ids)","+","+    def add_output(self, output_ids: list[int], log_probs: list[float], finish_reason):","+        finish_type = finish_reason.get(\"type\") if isinstance(finish_reason, dict) else str(finish_reason)","+        if finish_type == \"abort\" or self._last_prepared is None:","+            return","+        group = self.begin_request(None)","+        self.add_turn(self._last_prepared, output_ids, log_probs, finish_type, None, group)","+","+    # -- samples --------------------------------------------------------------","+    def to_samples(self) -> list[Sample]:","+        chains: list[list[_Turn]] = []","+        chain_of: dict[int, list[_Turn]] = {}","+        has_successor: set[int] = set()","+        for turn in self.turns:","+            best = None","+            best_len = -1","+            for prev in self.turns:","+                if prev.seq >= turn.seq or prev.seq in has_successor:","+                    continue","+                seq_ids = prev.prompt_ids + prev.output_ids","+                if len(seq_ids) > best_len and turn.prompt_ids[: len(seq_ids)] == seq_ids:","+                    best, best_len = prev, len(seq_ids)","+            if best is not None:","+                has_successor.add(best.seq)","+                chain = chain_of[best.seq]","+            else:","+                chain = []","+                chains.append(chain)","+            chain.append(turn)","+            chain_of[turn.seq] = chain","+","+        samples = []","+        for chain in chains:","+            first, last = chain[0], chain[-1]","+            tokens = list(last.prompt_ids) + list(last.output_ids)","+            prompt_length = len(first.prompt_ids)","+            response_length = len(tokens) - prompt_length","+            if response_length < 0:","+                continue","+            loss_mask = [0] * response_length","+            rollout_lps = [0.0] * response_length","+            for turn in chain:","+                start = len(turn.prompt_ids) - prompt_length","+                for i, lp in enumerate(turn.log_probs):","+                    if 0 <= start + i < response_length:","+                        loss_mask[start + i] = 1","+                        rollout_lps[start + i] = lp","+            samples.append(Sample(","+                tokens=tokens,","+                response_length=response_length,","+                loss_mask=loss_mask,","+                rollout_log_probs=rollout_lps,","+                status=Sample.Status.TRUNCATED if last.finish_type == \"length\" else Sample.Status.COMPLETED,","+                session_id=self.sid,","+                metadata={\"num_turns\": len(chain)},","+            ))","+        return samples","+","+","+class SessionStore:","+    \"\"\"Sessions keyed by agent id, grouped by the episode URL they arrived on.\"\"\"","+","+    def __init__(self, renderer: MessageRenderer):","+        self.renderer = renderer","+        self._sessions: dict[str, Session] = {}","+        self._episodes: dict[str, dict[str, None]] = {}","+","+    def get_agent(self, agent_id: str, episode_id: str | None = None) -> Session:","+        agent_id = str(agent_id)","+        session = self._sessions.get(agent_id)","+        if session is None:","+            session = self._sessions[agent_id] = Session(agent_id, self.renderer)","+        episode_id = str(episode_id) if episode_id else agent_id","+        self._episodes.setdefault(episode_id, {})[agent_id] = None","+        return session","+","+    def get(self, sid: str) -> Session:","+        return self.get_agent(sid, sid)","+","+    def sessions_for_episode(self, sid: str) -> list[Session]:","+        sid = str(sid)","+        ids: dict[str, None] = {}","+        if sid in self._sessions:","+            ids[sid] = None  # main agent first","+        for agent_id in self._episodes.get(sid, {}):","+            ids[agent_id] = None","+        for agent_id in self._sessions:  # fallback: \"<episode>/...\" agents","+            if agent_id.startswith(sid + \"/\"):","+                ids[agent_id] = None","+        return [self._sessions[i] for i in ids if i in self._sessions]","+","+    def finish(self, sid: str) -> list[Sample]:","+        sessions = self.sessions_for_episode(sid)","+        if not sessions:","+            logger.warning(\"finish for unknown session %s\", sid)","+            return []","+        done = {s.sid for s in sessions}","+        for agent_id in done:","+            self._sessions.pop(agent_id, None)","+        for episode_id in list(self._episodes):","+            members = self._episodes[episode_id]","+            for agent_id in done:","+                members.pop(agent_id, None)","+            if not members:","+                self._episodes.pop(episode_id, None)","+        samples: list[Sample] = []","+        for session in sessions:","+            samples.extend(session.to_samples())","+        return samples","+","+    def __len__(self):","+        return len(self._sessions)"],"newLines":265,"newStart":444,"oldLines":3,"oldStart":444}],"path":"/app/terminal_r