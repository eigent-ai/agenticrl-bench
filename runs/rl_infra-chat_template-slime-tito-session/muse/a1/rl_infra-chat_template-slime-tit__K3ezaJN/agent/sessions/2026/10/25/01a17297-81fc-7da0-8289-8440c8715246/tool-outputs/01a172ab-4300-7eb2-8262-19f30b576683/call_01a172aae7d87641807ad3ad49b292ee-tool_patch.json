{"files":[{"hunks":[{"lines":["     if name in {\"qwen3\", \"glm45\", \"glm4\", \"nano_v3\", \"interns1\"}:","         return not ctk or ctk.get(\"enable_thinking\") is not False","     return True","+","+","+# ---------------------------------------------------------------------------","+# tool-call detectors (non-streaming detect_and_parse equivalents)","+# ---------------------------------------------------------------------------","+","+class Glm47ToolParser:","+    \"\"\"``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value>...</tool_call>`` (GLM-4.7).\"\"\"","+","+    bot_token = \"<tool_call>\"","+    _call_re = re.compile(r\"<tool_call>.*?</tool_call>\", re.DOTALL)","+    _detail_re = re.compile(r\"<tool_call>(.*?)(<arg_key>.*?)?</tool_call>\", re.DOTALL)","+    _arg_re = re.compile(r\"<arg_key>(.*?)</arg_key>(?:\\\\n|\\s)*<arg_value>(.*?)</arg_value>\", re.DOTALL)","+","+    def has_tool_call(self, text: str) -> bool:","+        return self.bot_token in text","+","+    def _parse_pairs(self, pairs, func_name, tools):","+        arguments = {}","+        for arg_key, arg_value in pairs:","+            arg_key, arg_value = arg_key.strip(), arg_value.strip()","+            arg_type = get_argument_type(func_name, arg_key, tools) if tools is not None else None","+            parsed, good = parse_arguments(arg_value, arg_type)","+            if arg_type == \"string\":","+                if isinstance(parsed, str):","+                    arguments[arg_key] = parsed","+                elif isinstance(parsed, (dict, list)):","+                    arguments[arg_key] = json.dumps(parsed, ensure_ascii=False)","+                else:","+                    arguments[arg_key] = str(parsed)","+            else:","+                arguments[arg_key] = parsed if good else arg_value","+        return arguments","+","+    def parse_internal(self, text: str, tools=None):","+        if self.bot_token not in text:","+            return text, []","+        parts, last_end = [], 0","+        for m in self._call_re.finditer(text):","+            if m.start() > last_end:","+                parts.append(text[last_end:m.start()])","+            last_end = m.end()","+        if last_end < len(text):","+            parts.append(text[last_end:])","+        normal_text = \"\".join(parts).strip()","+        calls = []","+        try:","+            for raw in self._call_re.findall(text):","+                detail = self._detail_re.search(raw)","+                if detail is None:","+                    continue","+                func_name = (detail.group(1) or \"\").strip()","+                func_args = detail.group(2) or \"\"","+                arguments = self._parse_pairs(self._arg_re.findall(func_args), func_name, tools) if func_args else {}","+                calls.extend(parse_base_json({\"name\": func_name, \"parameters\": arguments}, tools))","+            return normal_text, calls","+        except Exception:","+            logger.exception(\"GLM tool-call parsing failed\")","+            return text, []","+","+    def parse(self, text: str, tools=None) -> tuple[str, list[dict]]:","+        normal, calls = self.parse_internal(text, tools)","+        if not calls and self.bot_token in text:","+            return text, []","+        return normal, _openai_calls(calls)","+","+","+class _TagJsonToolParser:","+    \"\"\"``<tool_call>{json}</tool_call>`` families (Hermes / Qwen2.5-Qwen3).\"\"\"","+","+    def __init__(self, bot=\"<tool_call>\", eot=\"</tool_call>\", allow_unclosed=False):","+        self.bot_token, self.eot_token, self.allow_unclosed = bot, eot, allow_unclosed","+","+    def has_tool_call(self, text: str) -> bool:","+        return self.bot_token in text","+","+    def parse_internal(self, text: str, tools=None):","+        idx = text.find(self.bot_token)","+        if idx == -1:","+            return text, []","+        normal_text = text[:idx].strip()","+        pattern = rf\"{re.escape(self.bot_token)}(.*?){re.escape(self.eot_token)}\"","+        matches = re.findall(pattern, text, re.DOTALL)","+        if self.allow_unclosed:","+            matched = [(m if isinstance(m, str) else m[0] or m[1])","+                       for m in re.findall(rf\"{re.escape(self.bot_token)}(.*?){re.escape(self.eot_token)}\"","+                                            rf\"|{re.escape(self.bot_token)}(.*)\", text, re.DOTALL)]","+            matches = [m for m in matched if m]","+        calls = []","+        for raw in matches:","+            try:","+                calls.extend(parse_base_json(json.loads(raw.strip()), tools))","+            except json.JSONDecodeError:","+                logger.warning(\"failed to parse tool-call JSON: %r\", raw[:200])","+                if self.allow_unclosed:","+                    return text, []","+                continue","+        return normal_text, calls","+","+    def parse(self, text: str, tools=None):","+        normal, calls = self.parse_internal(text, tools)","+        return (normal if calls else text), _openai_calls(calls)","+","+","+class _Qwen3CoderToolParser:","+    bot_token = \"<tool_call>\"","+","+    def has_tool_call(self, text):","+        return self.bot_token in text","+","+    def _convert(self, value, name, config, func):","+        if value.lower() == \"null\":","+            return None","+        spec = config.get(name)","+        ptype = str(spec[\"type\"]).strip().lower() if isinstance(spec, dict) and \"type\" in spec else \"string\"","+        if name not in config or ptype in (\"string\", \"str\", \"text\", \"varchar\", \"char\", \"enum\"):","+            return value","+        if ptype.startswith((\"int\", \"uint\", \"long\", \"short\", \"unsigned\")):","+            try:","+                return int(value)","+            except Exception:","+                return value","+        if ptype.startswith((\"num\", \"float\")):","+            try:","+                num = float(value)","+                return int(num) if (\".\" not in value and \"e\" not in value.lower() and num.is_integer()) else num","+            except Exception:","+                return value","+        if ptype in (\"boolean\", \"bool\", \"binary\"):","+            return value.lower() == \"true\"","+        try:","+            return json.loads(value)","+        except Exception:","+            pass","+        try:","+            return ast.literal_eval(value)","+        except Exception:","+            return value","+","+    def parse_internal(self, text, tools=None):","+        if self.bot_token not in text:","+            return text, []","+        blocks = re.findall(r\"<tool_call>(.*?)</tool_call>\", text, re.DOTALL)","+        if not blocks and \"<function=\" in text:","+            blocks = [text]","+        calls, tool_idx = [], 0","+        for block in blocks:","+            for func_match in re.findall(r\"<function=(.*?)</function>|<function=(.*)$\", block, re.DOTALL):","+                body = func_match[0] or func_match[1]","+                if \">\" not in body:","+                    continue","+                name_end = body.index(\">\")","+                func_name, params_str = body[:name_end], body[name_end + 1:]","+                config = {}","+                for tool in tools or []:","+                    if _tool_name(tool) == func_name:","+                        params = _tool_params(tool)","+                        config = params.get(\"properties\", params) if isinstance(params, dict) else {}","+                parsed = {}","+                for p_match in re.findall(r\"<parameter=(.*?)(?:</parameter>|(?=<parameter=)|(?=</function>)|$)\",","+                                           params_str, re.DOTALL):","+                    if \">\" not in p_match:","+                        continue","+                    p_idx = p_match.index(\">\")","+                    p_name, p_val = p_match[:p_idx], p_match[p_idx + 1:]","+                    if p_val.startswith(\"\\n\"):","+                        p_val = p_val[1:]","+                    if p_val.endswith(\"\\n\"):","+                        p_val = p_val[:-1]","+                    parsed[p_name] = self._convert(p_val, p_name, config, func_name)","+                calls.append({\"tool_index\": tool_idx, \"name\": func_name,","+                              \"parameters\": json.dumps(parsed, ensure_ascii=False)})","+                tool_idx += 1","+        start = text.find(self.bot_token)","+        if start == -1:","+            start = text.find(\"<function=\")","+        return (text[:start] if start > 0 else \"\"), calls","+","+    def parse(self, text, tools=None):","+        normal, calls = self.parse_internal(text, tools)","+        return (normal if calls else text), _openai_calls(calls)","+","+","+class _GenericJsonToolParser:","+    \"\"\"Llama-3 / Mistral / pythonic outputs: JSON (array) actions, optionally tagged.\"\"\"","+","+    def __init__(self, markers=(\"<|python_tag|>\", \"[TOOL_CALLS]\")):","+        self.markers = markers","+","+    def has_tool_call(self, text):","+        return any(m in text for m in self.markers) or text.lstrip().startswith((\"{\", \"[\"))","+","+    def parse_internal(self, text, tools=None):","+        stripped = text.replace(\"<|python_start|>\", \"\").replace(\"<|python_end|>\", \"\")","+        normal, action_text = \"\", stripped","+        for marker in self.markers:","+            if marker in stripped:","+                normal, action_text = stripped.split(marker, 1)","+                normal = normal.strip()","+                break","+        action_text = action_text.strip()","+        # Mistral compact: name[ARGS]{json}","+        m = re.match(r\"\\]?\\s*([A-Za-z_]\\w*)\\s*\\[ARGS\\]\\s*(\\{.*\\})\\s*$\", action_text, re.DOTALL)","+        if m:","+            try:","+                return normal, parse_base_json({\"name\": m.group(1), \"arguments\": json.loads(m.group(2))}, tools)","+            except json.JSONDecodeError:","+                return text, []","+        if action_text.startswith(\"]\"):","+            action_text = action_text[1:].strip()","+        # pythonic: [f(a=1), g(b=2)]","+        if action_text.startswith(\"[\") and not action_text.startswith(\"[{\"):","+            try:","+                parsed = ast.parse(action_text).body[0].value","+                if isinstance(parsed, ast.List) and all(isinstance(e, ast.Call) for e in parsed.elts):","+                    names = {_tool_name(t) for t in tools} if tools is not None else None","+                    calls = []","+                    for i, e in enumerate(parsed.elts):","+                        if not isinstance(e.func, ast.Name):","+                            continue","+                        if names is not None and e.func.id not in names:","+                            continue","+                        args = {kw.arg: ast.literal_eval(kw.value) for kw in e.keywords if kw.arg}","+                        calls.append({\"tool_index\": i, \"name\": e.func.id,","+                                      \"parameters\": json.dumps(args, ensure_ascii=False)})","+                    return normal, calls","+            except Exception:","+                pass","+        decoder, actions, idx = json.JSONDecoder(), [], 0","+        while idx < len(action_text):","+            while idx < len(action_text) and action_text[idx] in \" \\t\\r\\n;,\":","+                idx += 1","+            if idx >= len(action_text):","+                break","+            try:","+                obj, end = decoder.raw_decode(action_text[idx:])","+            except json.JSONDecodeError:","+                nxt = action_text.find('{\"name\":', idx + 1)","+                if nxt == -1:","+                    break","+                idx = nxt","+                continue","+            actions.extend(obj if isinstance(obj, list) else [obj])","+            idx += end","+        if not actions:","+            return text, []","+        return normal, parse_base_json(actions, tools)","+","+    def parse(self, text, tools=None):","+        normal, calls = self.parse_internal(text, tools)","+        return (normal if calls else text), _openai_calls(calls)","+","+","+TOOL_PARSERS = {","+    \"glm47\": Glm47ToolParser, \"glm\": Glm47ToolParser, \"glm45\": Glm47ToolParser, \"glm4\": Glm47ToolParser,","+    \"qwen\": lambda: _TagJsonToolParser(\"<tool_call>\\n\", \"\\n</tool_call>\"),","+    \"qwen25\": lambda: _TagJsonToolParser(\"<tool_call>\\n\", \"\\n</tool_call>\"),","+    \"trinity\": lambda: _TagJsonToolParser(\"<tool_call>\\n\", \"\\n</tool_call>\"),","+    \"hermes\": lambda: _TagJsonToolParser(\"<tool_call>\", \"</tool_call>\", allow_unclosed=True),","+    \"qwen3_coder\": _Qwen3CoderToolParser, \"step3p5\": _Qwen3CoderToolParser,","+    \"llama3\": _GenericJsonToolParser, \"mistral\": _GenericJsonToolParser, \"pythonic\": _GenericJsonToolParser,","+    \"deepseekv3\": _GenericJsonToolParser, \"deepseekv31\": _GenericJsonToolParser,","+    \"deepseekv32\": _GenericJsonToolParser, \"kimi_k2\": _GenericJsonToolParser,","+    \"interns1\": _GenericJsonToolParser, \"step3\": _GenericJsonToolParser,","+    \"none\": None,","+}","+REASONING_PARSERS = {\"think\": ReasoningParser, \"none\": None}"],"newLines":270,"newStart":225,"oldLines":3,"oldStart":225}],"path":"/app/terminal_rl/terminal_rl/proxy/parsing.py"}]}