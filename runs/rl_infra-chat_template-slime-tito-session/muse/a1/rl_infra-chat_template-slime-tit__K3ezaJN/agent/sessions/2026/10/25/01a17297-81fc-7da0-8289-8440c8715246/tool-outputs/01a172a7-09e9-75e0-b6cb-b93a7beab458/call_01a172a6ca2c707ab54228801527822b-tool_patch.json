{"files":[{"hunks":[{"lines":["+\"\"\"Focused regression tests for the agent proxy (stdlib unittest, CPU only).","+","+Run:  python -m unittest discover -s tests -v","+\"\"\"","+","+import asyncio","+import unittest","+","+from aiohttp import ClientSession, web","+from aiohttp.test_utils import TestClient, TestServer","+from transformers import AutoTokenizer","+","+from terminal_rl.proxy.server import ProxyApp","+","+MODEL = \"/models/Qwen3-4B-Instruct-2507\"","+","+","+class FakeEngine:","+    def __init__(self, tok):","+        self.tok = tok","+        self.queue = []  # list of (text, finish_type)","+        self.prompts = []","+        self.aborted = []","+","+    def push(self, text, finish=\"stop\"):","+        ids = self.tok.encode(text, add_special_tokens=False)","+        if finish == \"stop\":","+            ids = ids + [self.tok.eos_token_id]","+        self.queue.append((ids, finish))","+","+    async def generate(self, request):","+        body = await request.json()","+        self.prompts.append(list(body[\"input_ids\"]))","+        ids, finish = self.queue.pop(0) if self.queue else ([self.tok.eos_token_id], \"stop\")","+        fr = {\"type\": finish}","+        if finish == \"stop\":","+            fr[\"matched\"] = ids[-1]","+        elif finish == \"length\":","+            fr[\"length\"] = len(ids)","+        return web.json_response({","+            \"text\": self.tok.decode(ids, skip_special_tokens=True),","+            \"output_ids\": ids,","+            \"meta_info\": {\"id\": body.get(\"rid\") or \"x\", \"finish_reason\": fr,","+                          \"prompt_tokens\": len(body[\"input_ids\"]), \"completion_tokens\": len(ids),","+                          \"cached_tokens\": 0,","+                          \"output_token_logprobs\": [[-0.1 * (i + 1), t, None] for i, t in enumerate(ids)]},","+        })","+","+    async def abort(self, request):","+        self.aborted.append((await request.json()).get(\"rid\"))","+        return web.json_response({\"ok\": True})","+","+    def app(self):","+        a = web.Application()","+        a.router.add_post(\"/generate\", self.generate)","+        a.router.add_post(\"/abort_request\", self.abort)","+        return a","+","+","+class ProxyTest(unittest.IsolatedAsyncioTestCase):","+    tok = None","+","+    @classmethod","+    def setUpClass(cls):","+        cls.tok = AutoTokenizer.from_pretrained(MODEL, trust_remote_code=True)","+","+    async def asyncSetUp(self):","+        self.engine = FakeEngine(self.tok)","+        self.engine_client = TestClient(TestServer(self.engine.app()))","+        await self.engine_client.start_server()","+        engine_url = str(self.engine_client.session.connector._conns)  # placeholder, replaced below","+        engine_url = f\"http://{self.engine_client.host}:{self.engine_client.port}\"","+        proxy = ProxyApp(self.tok, engine_url, reasoning_parser=\"none\", tool_call_parser=\"none\",","+                         context_length=32768)","+        self.client = TestClient(TestServer(proxy.build_app()))","+        await self.client.start_server()","+","+    async def asyncTearDown(self):","+        await self.client.close()","+        await self.engine_client.close()","+","+    async def chat(self, sid, messages, hdr=None, **kw):","+        body = {\"model\": \"policy\", \"messages\": messages, \"temperature\": 1.0, **kw}","+        headers = {\"X-Session-ID\": hdr} if hdr else {}","+        async with self.client.post(f\"/s/{sid}/v1/chat/completions\", json=body, headers=headers) as r:","+            return r.status, await r.json()","+","+    async def finish(self, sid):","+        async with self.client.post(f\"/s/{sid}/finish\", json={}) as r:","+            data = await r.json()","+        return data[\"samples\"]","+","+    def fresh(self, messages):","+        return list(self.tok.apply_chat_template(messages, tokenize=True, add_generation_prompt=True))","+","+    async def test_explorers_get_own_samples_and_finish_returns_all(self):","+        self.engine.push(\"explorer answer\")","+        self.engine.push(\"main answer\")","+        st, _ = await self.chat(\"ep1\", [{\"role\": \"user\", \"content\": \"look around\"}], hdr=\"ep1/explore-0\")","+        self.assertEqual(st, 200)","+        st, _ = await self.chat(\"ep1\", [{\"role\": \"user\", \"content\": \"do task\"}], hdr=\"ep1\")","+        self.assertEqual(st, 200)","+        samples = await self.finish(\"ep1\")","+        self.assertEqual({s[\"session_id\"] for s in samples}, {\"ep1\", \"ep1/explore-0\"})","+","+    async def test_prompt_is_fresh_render_after_history_change_and_samples_split(self):","+        self.engine.push(\"first answer\")","+        self.engine.push(\"second answer\")","+        m1 = [{\"role\": \"user\", \"content\": \"original task\"}]","+        st, _ = await self.chat(\"ep2\", m1, hdr=\"ep2\")","+        self.assertEqual(st, 200)","+        # Summarization-style reset: a completely new conversation.","+        m2 = [{\"role\": \"user\", \"content\": \"picking up from a summary\"}]","+        st, _ = await self.chat(\"ep2\", m2, hdr=\"ep2\")","+        self.assertEqual(st, 200)","+        self.assertEqual(self.engine.prompts[0], self.fresh(m1))","+        self.assertEqual(self.engine.prompts[1], self.fresh(m2))","+        samples = await self.finish(\"ep2\")","+        self.assertEqual(len(samples), 2)","+        for s, msgs in zip(samples, (m1, m2)):","+            self.assertEqual(s[\"tokens\"][: len(self.fresh(msgs))], self.fresh(msgs))","+","+    async def test_extending_conversation_merges_into_one_sample(self):","+        self.engine.push(\"answer one\")","+        self.engine.push(\"answer two\")","+        m1 = [{\"role\": \"user\", \"content\": \"hello\"}]","+        st, r1 = await self.chat(\"ep3\", m1, hdr=\"ep3\")","+        self.assertEqual(st, 200)","+        content = r1[\"choices\"][0][\"message\"][\"content\"]","+        m2 = m1 + [{\"role\": \"assistant\", \"content\": content}, {\"role\": \"user\", \"content\": \"next\"}]","+        st, _ = await self.chat(\"ep3\", m2, hdr=\"ep3\")","+        self.assertEqual(st, 200)","+        samples = await self.finish(\"ep3\")","+        self.assertEqual(len(samples), 1)","+        s = samples[0]","+        trained = [t for t, m in zip(s[\"tokens\"][-s[\"response_length\"]:], s[\"loss_mask\"]) if m]","+        expected = self.tok.encode(\"answer one\", add_special_tokens=False) + [self.tok.eos_token_id]","+        expected += self.tok.encode(\"answer two\", add_special_tokens=False) + [self.tok.eos_token_id]","+        self.assertEqual(trained, expected)","+","+    async def test_aborted_generation_is_error_and_not_trained(self):","+        self.engine.push(\"partial thi\", finish=\"abort\")","+        self.engine.push(\"real answer\")","+        m = [{\"role\": \"user\", \"content\": \"hello\"}]","+        st, _ = await self.chat(\"ep4\", m, hdr=\"ep4\")","+        self.assertGreaterEqual(st, 500)","+        st, _ = await self.chat(\"ep4\", m, hdr=\"ep4\")  # identical retry","+        self.assertEqual(st, 200)","+        samples = await self.finish(\"ep4\")","+        self.assertEqual(len(samples), 1)","+        trained_text = self.tok.decode(","+            [t for t, mk in zip(samples[0][\"tokens\"][-samples[0][\"response_length\"]:],","+                                 samples[0][\"loss_mask\"]) if mk], skip_special_tokens=True)","+        self.assertEqual(trained_text, \"real answer\")","+","+    async def test_identical_retry_discards_undelivered_generation(self):","+        # Gateway dropped the first (successful) response: agent re-sends the identical request.","+        self.engine.push(\"lost answer\")","+        self.engine.push(\"kept answer\")","+        m = [{\"role\": \"user\", \"content\": \"hello\"}]","+        st, _ = await self.chat(\"ep5\", m, hdr=\"ep5\")","+        self.assertEqual(st, 200)","+        st, _ = await self.chat(\"ep5\", m, hdr=\"ep5\")","+        self.assertEqual(st, 200)","+        samples = await self.finish(\"ep5\")","+        trained = []","+        for s in samples:","+            trained += [t for t, mk in zip(s[\"tokens\"][-s[\"response_length\"]:], s[\"loss_mask\"]) if mk]","+        self.assertEqual(self.tok.decode(trained, skip_special_tokens=True), \"kept answer\")","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"newLines":173,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/terminal_rl/tests/test_proxy.py"}]}