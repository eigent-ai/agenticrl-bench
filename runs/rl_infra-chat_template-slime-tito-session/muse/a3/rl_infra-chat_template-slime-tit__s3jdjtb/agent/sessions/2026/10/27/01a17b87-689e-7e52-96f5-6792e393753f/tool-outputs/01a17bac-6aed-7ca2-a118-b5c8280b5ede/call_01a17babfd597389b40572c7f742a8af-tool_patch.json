    raise ValueError(\"required tool choice expects a JSON array\")","+        calls = []","+        for item in data:","+            params = item.get(\"parameters\", item.get(\"arguments\", {}))","+            calls.append(","+                {","+                    \"id\": f\"call_{uuid.uuid4().hex[:24]}\",","+                    \"type\": \"function\",","+                    \"function\": {\"name\": item[\"name\"], \"arguments\": json.dumps(params, ensure_ascii=False)},","+                }","+            )","+        return calls","+","+    def to_message(self, prompt_ids: list[int], output_ids: list[int], finish_reason: str, *,","+                   tools=_UNSET, tool_choice=\"auto\", separate_reasoning: bool = True,","+                   matched_stop=None, no_stop_trim: bool = False, skip_special_tokens: bool = True,","+                   prompt_text: str | None = None) -> tuple[dict, str]:","+        ids = list(output_ids)","+        if finish_reason == \"stop\" and not no_stop_trim and ids:","+            if isinstance(matched_stop, int) and ids[-1] == matched_stop:","+                ids = ids[:-1]","+            elif not isinstance(matched_stop, str) and ids[-1] in self.special_ids:","+                ids = ids[:-1]","+        text = self.tokenizer.decode(ids, skip_special_tokens=skip_special_tokens)","+        if finish_reason == \"stop\" and not no_stop_trim and isinstance(matched_stop, str) and matched_stop:","+            if text.endswith(matched_stop):","+                text = text[: -len(matched_stop)]","+","         reasoning = None","-        if self.reasoning is not None:","-            reasoning, text = self.reasoning.split(text, self.starts_in_reasoning(prompt_ids))","+        if self.reasoning is not None and separate_reasoning:","+            reasoning, text = self.reasoning.split(","+                text, self.starts_in_reasoning(prompt_ids, prompt_text)","+            )","+","         tool_calls = []","-        if self.tools is not None:"