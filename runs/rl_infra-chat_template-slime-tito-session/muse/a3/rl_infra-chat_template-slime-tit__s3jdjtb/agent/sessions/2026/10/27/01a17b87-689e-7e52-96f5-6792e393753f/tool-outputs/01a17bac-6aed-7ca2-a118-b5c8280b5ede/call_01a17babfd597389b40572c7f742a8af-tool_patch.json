{"files":[{"hunks":[{"lines":["-\"\"\"Turn engine output ids into an OpenAI chat message (reasoning split + tool calls).","+\"\"\"Turn engine output ids into an OpenAI chat message."," ","-Mirrors what SGLang's reasoning parser (Qwen3Detector, used for the ``<think>`` families) and the GLM-4.7 function-call","-detector return from the chat endpoint, so agents see the same message shape as in our eval runs.","+Mirrors SGLang 0.5.9's non-streaming chat response handling: the text is","+detokenized with the request's special-token / stop-trim settings, split by","+the reasoning detector, and parsed for tool calls only when the request","+actually supplied tools (with argument types taken from their schemas)."," \"\"\""," ","+import ast"," import json"," import re"," import uuid"],"newLines":12,"newStart":1,"oldLines":9,"oldStart":1},{"lines":[" THINK_START = \"<think>\""," THINK_END = \"</think>\""," ","+_UNSET = object()","+"," "," class ReasoningParser:","+    \"\"\"SGLang's BaseReasoningFormatDetector.detect_and_parse for <think>.\"\"\"","+","     def __init__(self, think_start: str = THINK_START, think_end: str = THINK_END):","         self.think_start = think_start","         self.think_end = think_end"," ","     def split(self, text: str, in_reasoning: bool) -> tuple[str | None, str]:","-        if self.think_start in text:","-            in_reasoning = True","-            text = text.replace(self.think_start, \"\", 1)","+        in_reasoning = in_reasoning or self.think_start in text","         if not in_reasoning:","-            return None, text.strip()","-        if self.think_end not in text:","-            # Still thinking when the output stopped.","-            return text.strip(), \"\"","-        reasoning, content = text.split(self.think_end, 1)","-        return reasoning.strip(), content.strip()","+            return None, text","+        processed = text.replace(self.think_start, \"\").strip()","+        if self.think_end not in processed:","+            # Reasoning was truncated before the end tag.","+            return processed, \"\"","+        reasoning, content = processed.split(self.think_end, 1)","+        return reasoning, content.strip()","+","+","+def _infer_schema_type(schema) -> str | None:","+    \"\"\"SGLang's infer_type_from_json_schema.\"\"\"","+    if not isinstance(schema, dict):","+        return None","+    if \"type\" in schema:","+        value = schema[\"type\"]","+        if isinstance(value, str):","+            return value","+        if isinstance(value, list) and value:","+            non_null = [t for t in value if t != \"null\"]","+            return non_null[0] if non_null else \"string\"","+    if \"anyOf\" in schema or \"oneOf\" in schema:","+        subs = schema.get(\"anyOf\") or schema.get(\"oneOf\")","+        types = []","+        if isinstance(subs, list):","+            for sub in subs:","+                inferred = _infer_schema_type(sub)","+                if inferred:","+                    types.append(inferred)","+        if types:","+            if len(set(types)) == 1:","+                return types[0]","+            return \"string\" if \"string\" in types else types[0]","+    if \"enum\" in schema and isinstance(schema[\"enum\"], list):","+        if not schema[\"enum\"]:","+            return \"string\"","+        kinds = set()","+        for value in schema[\"enum\"]:","+            if value is None:","+                kinds.add(\"null\")","+            elif isinstance(value, bool):","+                kinds.add(\"boolean\")","+            elif isinstance(value, int):","+                kinds.add(\"integer\")","+            elif isinstance(value, float):","+                kinds.add(\"number\")","+            elif isinstance(value, str):","+                kinds.add(\"string\")","+            elif isinstance(value, list):","+                kinds.add(\"array\")","+            elif isinstance(value, dict):","+                kinds.add(\"object\")","+        return kinds.pop() if len(kinds) == 1 else \"string\"","+    if \"allOf\" in schema and isinstance(schema[\"allOf\"], list):","+        for sub in schema[\"allOf\"]:","+            inferred = _infer_schema_type(sub)","+            if inferred and inferred != \"string\":","+                return inferred","+        return \"string\"","+    if \"properties\" in schema:","+        return \"object\"","+    if \"items\" in schema:","+        return \"array\"","+    return None"," "," ","+def _argument_type(func_name: str, arg_key: str, tools) -> str | None:","+    for tool in tools or []:","+        if not isinstance(tool, dict):","+            continue","+        fn = tool.get(\"function\") if isinstance(tool.get(\"function\"), dict) else tool","+        if fn.get(\"name\") != func_name:","+            continue","+        params = fn.get(\"parameters\")","+        if not isinstance(params, dict):","+            return None","+        props = params.get(\"properties\")","+        if not isinstance(props, dict):","+            return None","+        spec = props.get(arg_key)","+        return _infer_schema_type(spec) if isinstance(spec, dict) else None","+    return None","+","+","+def _convert_to_number(value: str):","+    try:","+        return float(value) if (\".\" in value or \"e\" in value.lower()) else int(value)","+    except (ValueError, AttributeError):","+        return value","+","+","+def _parse_argument_value(raw: str, arg_type: str | None):","+    \"\"\"SGLang GLM-4.7 parse_arguments: JSON, unescaped JSON, literal, string.\"\"\"","+    try:","+        parsed = json.loads(raw)","+        if arg_type == \"number\" and isinstance(parsed, str):","+            parsed = _convert_to_number(parsed)","+        return parsed, True","+    except (json.JSONDecodeError, ValueError):","+        pass","+    try:","+        wrapped = json.loads('{\"tmp\": \"' + raw + '\"}')","+        parsed = json.loads(wrapped[\"tmp\"])","+        if arg_type == \"number\" and isinstance(parsed, str):","+            parsed = _convert_to_number(parsed)","+        return parsed, True","+    except (json.JSONDecodeError, ValueError, KeyError, TypeError):","+        pass","+    try:","+        return ast.literal_eval(raw), True","+    except (ValueError, SyntaxError):","+        pass","+    try:","+        return json.loads(json.dumps(str(raw))), True","+    except (json.JSONDecodeError, ValueError):","+        return raw, False","+","+"," class Glm47ToolParser:","     \"\"\"``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value>...</tool_call>``\"\"\""," ","-    _call = re.compile(r\"<tool_call>(.*?)</tool_call>\", re.DOTALL)","-    _arg = re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>(.*?)</arg_value>\", re.DOTALL)","+    _call = re.compile(r\"<tool_call>.*?</tool_call>\", re.DOTALL)","+    _detail = re.compile(r\"<tool_call>(.*?)(<arg_key>.*?)?</tool_call>\", re.DOTALL)","+    _arg = re.compile(r\"<arg_key>(.*?)</arg_key>(?:\\\\n|\\s)*<arg_value>(.*?)</arg_value>\", re.DOTALL)","+","+    def has_tool_call(self, text: str) -> bool:","+        return \"<tool_call>\" in text"," ","-    def parse(self, text: str) -> tuple[str, list[dict]]:","+    def parse(self, text: str, tools=None) -> tuple[str, list[dict]]:","         if \"<tool_call>\" not in text:","             return text, []","-        content = text.split(\"<tool_call>\", 1)[0].strip()","+        parts = []","+        last = 0","+        for match in self._call.finditer(text):","+            if match.start() > last:","+                parts.append(text[last : match.start()])","+            last = match.end()","+        if last < len(text):","+            parts.append(text[last:])","+        normal_text = \"\".join(parts).strip()","+","+        known = None","+        if tools is not None:","+            known = set()","+            for tool in tools:","+                if isinstance(tool, dict):","+                    fn = tool.get(\"function\") if isinstance(tool.get(\"function\"), d