{"files":[{"hunks":[{"lines":["+import asyncio","+import unittest","+","+from aiohttp.test_utils import TestClient, TestServer","+from transformers import AutoTokenizer","+","+from terminal_rl.proxy.parsing import OutputParser","+from terminal_rl.proxy.server import ProxyApp","+from terminal_rl.proxy.session import MessageRenderer, Session","+","+","+class RendererTests(unittest.TestCase):","+    @classmethod","+    def setUpClass(cls):","+        cls.tok = AutoTokenizer.from_pretrained(\"/models/Qwen3-4B-Instruct-2507\")","+        cls.renderer = MessageRenderer(cls.tok)","+","+    def render(self, messages, tools=None):","+        return list(","+            self.tok.apply_chat_template(","+                messages, tools=tools, tokenize=True, add_generation_prompt=True, return_dict=False","+            )","+        )","+","+    def test_content_parts_flattened_like_sglang_string_templates(self):","+        messages = [{\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": \"hello\"}, {\"type\": \"text\", \"text\": \"world\"}]}]","+        self.assertEqual(","+            self.renderer.conversation(messages, body={\"messages\": messages}),","+            self.render([{\"role\": \"user\", \"content\": \"hello world\"}]),","+        )","+","+    def test_tool_choice_none_omits_tools_and_none_content_becomes_empty(self):","+        tools = [{\"type\": \"function\", \"function\": {\"name\": \"f\", \"parameters\": {\"type\": \"object\", \"properties\": {}}}}]","+        messages = [","+            {\"role\": \"user\", \"content\": \"hi\"},","+            {","+                \"role\": \"assistant\",","+                \"content\": None,","+                \"tool_calls\": [","+                    {\"id\": \"call_1\", \"type\": \"function\", \"function\": {\"name\": \"f\", \"arguments\": \"{\\\"x\\\": 1}\"}}","+                ],","+            },","+            {\"role\": \"tool\", \"tool_call_id\": \"call_1\", \"content\": \"done\"},","+        ]","+        got = self.renderer.conversation(messages, tools=tools, body={\"messages\": messages, \"tools\": tools, \"tool_choice\": \"none\"})","+        expected_messages = [","+            {\"role\": \"user\", \"content\": \"hi\"},","+            {","+                \"role\": \"assistant\",","+                \"content\": \"\",","+                \"tool_calls\": [","+                    {","+                        \"id\": \"call_1\",","+                        \"type\": \"function\",","+                        \"function\": {\"name\": \"f\", \"arguments\": {\"x\": 1}},","+                    }","+                ],","+            },","+            {\"role\": \"tool\", \"tool_call_id\": \"call_1\", \"content\": \"done\"},","+        ]","+        self.assertEqual(got, self.render(expected_messages, tools=None))","+","+    def test_last_assistant_converted_to_user_by_default(self):","+        messages = [{\"role\": \"user\", \"content\": \"hi\"}, {\"role\": \"assistant\", \"content\": \"prefill\"}]","+        got = self.renderer.conversation(messages, body={\"messages\": messages})","+        self.assertEqual(got, self.render([{\"role\": \"user\", \"content\": \"hi\"}, {\"role\": \"user\", \"content\": \"prefill\"}]))","+","+    def test_last_assistant_continued_when_requested(self):","+        messages = [{\"role\": \"user\", \"content\": \"hi\"}, {\"role\": \"assistant\", \"content\": \"prefill\"}]","+        got = self.renderer.conversation(","+            messages, body={\"messages\": messages, \"continue_final_message\": True}","+        )","+        prefix = self.render([{\"role\": \"user\", \"content\": \"hi\"}])","+        self.assertEqual(got[: len(prefix)], prefix)","+        self.assertTrue(self.tok.decode(got[len(prefix) :], skip_special_tokens=False).endswith(\"prefill\"))","+","+","+class SessionTests(unittest.TestCase):","+    @classmethod","+    def setUpClass(cls):","+        cls.tok = AutoTokenizer.from_pretrained(\"/models/Qwen3-4B-Instruct-2507\")","+        cls.renderer = MessageRenderer(cls.tok)","+        cls.eos = cls.tok.eos_token_id","+","+    def _turn(self, session, messages, output_text):","+        prompt = session.prompt_ids(messages, body={\"messages\": messages})","+        output = self.tok.encode(output_text, add_special_tokens=False) + [self.eos]","+        session.add_output(output, [-0.1] * len(output), \"stop\")","+        return prompt, output","+","+    def test_preserves_sampled_ids_and_chains_one_sample(self):","+        session = Session(\"s1\", self.renderer)","+        # A deliberately non-canonical tokenization of \"hello\": one character at a time.","+        first_prompt = session.prompt_ids([{\"role\": \"user\", \"content\": \"say hello\"}], body={\"messages\": [{\"role\": \"user\", \"content\": \"say hello\"}]})","+        output = []","+        for ch in \"hello\":","+            output += self.tok.encode(ch, add_special_tokens=False)","+        output += [self.eos]","+        session.add_output(output, [-0.1] * len(output), \"stop\")","+","+        messages = [","+            {\"role\": \"user\", \"content\": \"say hello\"},","+            {\"role\": \"assistant\", \"content\": \"hello\"},","+            {\"role\": \"user\", \"content\": \"again\"},","+        ]","+        second_prompt, second_output = self._turn(session, messages, \"world\")","+        self.assertEqual(second_prompt[: len(first_prompt) + len(output)], first_prompt + output)","+        samples = session.to_samples()","+        self.assertEqual(len(samples), 1)","+        self.assertEqual(samples[0].tokens, second_prompt + second_output)","+        self.assertEqual(sum(samples[0].loss_mask), len(output) + len(second_output))","+","+    def test_rewritten_history_starts_new_sample_and_trains_each_generation_once(self):","+        session = Session(\"s2\", self.renderer)","+        self._turn(session, [{\"role\": \"user\", \"content\": \"original task\"}], \"first\")","+        messages = [{\"role\": \"user\", \"content\": \"summary replaces the original task\"}]","+        prompt2, output2 = self._turn(session, messages, \"second\")","+        samples = session.to_samples()","+        self.assertEqual(len(samples), 2)","+        self.assertEqual(samples[1].tokens, prompt2 + output2)","+        self.assertEqual(sum(sum(s.loss_mask) for s in samples), sum(s.loss_mask.count(1) for s in samples))","+","+","+class ParserTests(unittest.TestCase):","+    @classmethod","+    def setUpClass(cls):","+        cls.tok = AutoTokenizer.from_pretrained(\"/models/GLM-4.7-Flash-agent\")","+","+    def test_glm_tool_parser_only_when_tools_supplied_and_validates_names(self):","+        parser = OutputParser(self.tok, \"think\", \"glm47\")","+        prompt = self.tok.encode(\"x\", add_special_tokens=False)","+        text = \"<tool_call>lookup<arg_key>n</arg_key><arg_value>3</arg_value></tool_call>\"","+        output = self.tok.encode(text, add_special_tokens=False)","+        tools = [{\"type\": \"function\", \"function\": {\"name\": \"lookup\", \"parameters\": {\"type\": \"object\", \"properties\": {\"n\": {\"type\": \"integer\"}}}}}]","+","+        message, finish = parser.to_message(prompt, output, \"stop\", tools=tools)","+        self.assertEqual(finish, \"tool_calls\")","+        self.assertEqual(message[\"tool_calls\"][0][\"function\"][\"arguments\"], \"{\\\"n\\\": 3}\")","+","+        message, finish = parser.to_message(prompt, output, \"stop\", tools=None)","+        self.assertEqual(finish, \"stop\")","+        self.assertNotIn(\"tool_calls\", message)","+        self.assertEqual(message[\"content\"], text)","+","+","+class FakeEngine:","+    def __init__(self, tok):","+        self.tok = tok","+        self.calls = 0","+        self.abort_first = False","+        self.aborted = []","+","+    async def generate(self, input_ids, sampling_params, rid=None):","+        self.calls += 1","+        if self.abort_first and self.calls == 1:","+            ids = self.tok.encode(\"partial\", add_special_tokens=False)","+            return {\"output_ids\": ids, \"log_probs\": [-1.0] * len(ids), \"finish_reason\": \"abort\", \"cached_tokens\": 0}","+        ids = self.tok.encode(f\"answer{self.calls}\", add_special_tokens=False) + [self.tok.eos_token_id]","+        return {\"output_ids\": ids, \"log_probs\": [-0.5] * len(ids), \"finish_reason\": \"stop\", \"cached_tokens\": 0}","+","+    async def abort(self, rid):","+        self.aborted.append(rid)","+","+    async def close(self):","+        pass","+","+","+class ProxyHttpTests(unittest.IsolatedAsyncioTestCase):","+    @classmethod","+    def setUpClass(cls):","+        cls.tok = AutoTokenizer.from_pretrained(\"/models/Qwen3-4B-Instruct-2507\")","+","+    async def asyncSetUp(self):","+        self.proxy = ProxyApp(self.tok, \"http://engine.invalid\", reasoning_parser=\"none\", tool_call_parser=\"none\")","+        self.engine = FakeEngine(self.tok)","+        self.proxy.engine = self.engine","+        self.client = TestClient(TestServer(self.proxy.build_app()))","+        await self.client.start_server()","+","+    async def asyncTearDown(self):","+        await self.client.close()","+","+    async def _chat(self, episode, agent, text=\"hi\"):","+        body = {\"model\": \"policy\", \"messages\": [{\"role\": \"user\", \"content\": text}], \"session_id\": agent}","+        async with self.client.post(","+            f\"/s/{episode}/v1/chat/completions\", json=body, headers={\"X-Session-ID\": agent}","+        ) as resp:","+            return resp.status, await resp.json()","+","+    async def test_explorers_have_own_samples_under_episode_finish(self):","+        self.assertEqual((await self._chat(\"ep1\", \"ep1/explore-0\"))[0], 200)","+        self.assertEqual((await self._chat(\"ep1\", \"ep1\"))[0], 200)","+        async with self.client.post(\"/s/ep1/finish\", json={}) as resp:","+            samples = (await resp.json())[\"samples\"]","+        self.assertEqual({s[\"session_id\"] for s in samples}, {\"ep1\", \"ep1/explore-0\"})","+","+    async def test_abort_is_error_and_duplicate_retry_replaces_undelivered_generation(self):","+        self.engine.abort_first = True","+        status, _ = await self._chat(\"ep2\", \"ep2\")","+        self.assertGreaterEqual(status, 500)","+        status, _ = await self._chat(\"ep2\", \"ep2\")","+        self.assertEqual(status, 200)","+        # Simulate a gateway drop of the successful response: the identical retry","+        # must replace, not duplicate, the previous generation.","+        status, _ = await self._chat(\"ep2\", \"ep2\")","+        self.assertEqual(status, 200)","+        async with self.client.post(\"/s/ep2/finish\", json={}) as resp:","+            samples = (await resp.json())[\"samples\"]","+        self.assertEqual(len(samples), 1)","+        trained = [","+            tok for tok, mask in zip(samples[0][\"tokens\"][len(samples[0][\"tokens\"]) - samples[0][\"response_length\"] :], samples[0][\"loss_mask\"]) if mask","+        ]","+        self.assertEqual(self.tok.decode(trained, skip_special_tokens=True), \"answer3\")","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"newLines":217,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/terminal_rl/tests/test_proxy.py"}]}