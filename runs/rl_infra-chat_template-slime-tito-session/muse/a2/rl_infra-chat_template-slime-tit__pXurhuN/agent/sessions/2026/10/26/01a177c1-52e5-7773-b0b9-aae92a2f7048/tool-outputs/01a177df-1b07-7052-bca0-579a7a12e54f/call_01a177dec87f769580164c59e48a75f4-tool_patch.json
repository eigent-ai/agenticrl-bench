{"files":[{"hunks":[{"lines":["         if tools is not None:","             body[\"tools\"] = tools","         return list(self.render_request(body).canonical_ids)","+","+","+# ---------------------------------------------------------------------------","+# Training-sample bookkeeping","+# ---------------------------------------------------------------------------","+","+_KIND_PRIORITY = {\"gen\": 0, \"gen_trim\": 1, \"prompt\": 2}","+","+","+@dataclass","+class _Candidate:","+    tokens: tuple","+    text: str","+    kind: str","+    seq: int","+    segment: object = None","+","+","+class Segment:","+    \"\"\"One training sample under construction: a prompt followed by turns","+    whose prompts token-extend everything before them.\"\"\"","+","+    def __init__(self, prompt_ids):","+        self.tokens = list(prompt_ids)","+        self.prompt_length = len(prompt_ids)","+        self.loss_mask = [0] * len(prompt_ids)","+        self.rollout_log_probs = [0.0] * len(prompt_ids)","+        self.num_turns = 0","+        self.status = Sample.Status.COMPLETED","+        self.tail_candidate = None","+","+    def append_turn(self, prompt_ids, output_ids, log_probs, finish_type):","+        suffix = list(prompt_ids[len(self.tokens):])","+        self.tokens.extend(suffix)","+        self.loss_mask.extend([0] * len(suffix))","+        self.rollout_log_probs.extend([0.0] * len(suffix))","+        self.tokens.extend(output_ids)","+        self.loss_mask.extend([1] * len(output_ids))","+        lps = list(log_probs[:len(output_ids)])","+        if len(lps) < len(output_ids):","+            lps.extend([0.0] * (len(output_ids) - len(lps)))","+        self.rollout_log_probs.extend(lps)","+        self.num_turns += 1","+        if finish_type == \"length\":","+            self.status = Sample.Status.TRUNCATED","+","+    def to_sample(self, sid):","+        start = self.prompt_length","+        return Sample(","+            tokens=list(self.tokens),","+            response_length=len(self.tokens) - start,","+            loss_mask=self.loss_mask[start:],","+            rollout_log_probs=self.rollout_log_probs[start:],","+            status=self.status,","+            session_id=sid,","+            metadata={\"num_turns\": self.num_turns},","+        )","+","+","+class Session:","+    \"\"\"One agent conversation (its own session id), belonging to an episode.\"\"\"","+","+    def __init__(self, sid: str, renderer: MessageRenderer, episode_id: str | None = None):","+        self.sid = sid","+        self.renderer = renderer","+        self.episodes = {episode_id or sid}","+        self.lock = asyncio.Lock()","+        self.segments: list[Segment] = []","+        self._candidates: dict[tuple, _Candidate] = {}","+        self._seq = 0","+        self.num_turns = 0","+        self.created = time.time()","+        self.pending_fingerprint = None","+        self.pending_payload = None","+","+    # -- candidates ---------------------------------------------------------","+    def _add_candidate(self, tokens, kind, segment=None, text=None):","+        tokens = tuple(tokens)","+        if not tokens:","+            return None","+        existing = self._candidates.get(tokens)","+        if existing is not None and _KIND_PRIORITY.get(existing.kind, 9) <= _KIND_PRIORITY.get(kind, 9):","+            if segment is not None and existing.segment is None:","+                existing.segment = segment","+            return existing","+        self._seq += 1","+        cand = _Candidate(tokens=tokens,","+                          text=self.renderer.decode_ids(tokens) if text is None else text,","+                          kind=kind, seq=self._seq, segment=segment)","+        self._candidates[tokens] = cand","+        return cand","+","+    def register_prompt(self, prompt_ids, text=None):","+        return self._add_candidate(prompt_ids, \"prompt\", text=text)","+","+    # -- prompt splicing ------------------------------------------------------","+    def _splice(self, cand: _Candidate, rendered: RenderedRequest):","+        text = rendered.text","+        cut = len(cand.text)","+        if cut == len(text):","+            return list(cand.tokens)","+        suffix = text[cut:]","+        suffix_ids = None","+        offsets = rendered.offsets","+        if offsets:","+            starts = rendered.offset_starts","+            idx = bisect.bisect_left(starts, cut)","+            if idx < len(offsets) and starts[idx] == cut and (idx == 0 or offsets[idx - 1][1] <= cut):","+                cand_ids = rendered.canonical_ids[idx:]","+                if self.renderer.decode_ids(cand_ids) == suffix:","+                    suffix_ids = cand_ids","+        if suffix_ids is None:","+            for ids in self.renderer.encode_suffix_variants(suffix):","+                if self.renderer.decode_ids(ids) == suffix:","+                    suffix_ids = ids","+                    break","+        if suffix_ids is None:","+            return None","+        return list(cand.tokens) + list(suffix_ids)","+","+    def prepare_prompt(self, rendered: RenderedRequest):","+        \"\"\"Returns (actual_prompt_ids, segment_it_extends_or_None).\"\"\"","+        ordered = sorted(self._candidates.values(),","+                         key=lambda c: (-len(c.text), _KIND_PRIORITY.get(c.kind, 9), -c.seq))","+        for cand in ordered:","+            if cand.text and rendered.text.startswith(cand.text):","+                actual = self._splice(cand, rendered)","+                if actual is None:","+                    continue","+                target = None","+                seg = cand.segment","+                if cand.kind == \"gen\" and seg is not None and seg.tail_candidate is cand:","+                    target = seg","+                return actual, target","+        return list(rendered.canonical_ids), None","+","+    # -- recording ------------------------------------------------------------","+    def _trim_variant(self, full, output_ids, finish_detail):","+        if not output_ids or not isinstance(finish_detail, dict):","+            return None","+        if finish_detail.get(\"type\") != \"stop\":","+            return None","+        matched = finish_detail.get(\"matched\")","+        if isinstance(matched, int) and not isinstance(matched, bool):","+            return full[:-1] if full and full[-1] == matched else None","+        if isinstance(matched, str) and matched:","+            full_text = self.renderer.decode_ids(full)","+            if not full_text.endswith(matched):","+                return None","+            target = full_text[:-len(matched)]","+            lo = max(0, len(full) - 64)","+            for k in range(len(full) - 1, lo - 1, -1):","+                if self.renderer.decode_ids(full[:k]) == target:","+                    return full[:k]","+            return None","+        if output_ids[-1] in self.renderer.special_ids:","+            return full[:-1]","+        return None","+","+    def record_generation(self, prompt_ids, output_ids, log_probs, finish_type,","+                          finish_detail=None, target_segment=None):","+        \"\"\"Record one delivered generation. Returns its Segment (or None).\"\"\"","+        prompt_ids = list(prompt_ids)","+        output_ids = list(output_ids)","+        if not output_ids:","+            self._add_candidate(prompt_ids, \"gen\")","+            return None","+        seg = target_segment","+        if seg is not None and prompt_ids[:len(seg.tokens)] != seg.tokens:","+            seg = None","+        if seg is None and self.segments:","+            last = self.segments[-1]","+            if prompt_ids[:len(last.tokens)] == last.tokens:","+                seg = last","+        if seg is None:","+            seg = Segment(prompt_ids)","+            self.segments.append(seg)","+        seg.append_turn(prompt_ids, output_ids, log_probs, finish_type)","+        self.num_turns += 1","+        full = tuple(prompt_ids + output_ids)","+        cand = self._add_candidate(full, \"gen\", segment=seg)","+        seg.tail_candidate = cand","+        variant = self._trim_variant(full, output_ids, finish_detail or {})","+        if variant and variant != full:","+            self._add_candidate(variant, \"gen_trim\", segment=seg)","+        return seg","+","+    def to_samples(self):","+        return [seg.to_sample(self.sid) for seg in self.segments if seg.num_turns]","+","+","+class SessionStore:","+    def __init__(self, renderer: MessageRenderer):","+        self.renderer = renderer","+        self._sessions: dict[str, Session] = {}","+","+    def get(self, sid: str, episode_id: str | None = None) -> Session:","+        session = self._sessions.get(sid)","+        if session is None:","+            session = self._sessions[sid] = Session(sid, self.renderer, episode_id or sid)","+        elif episode_id:","+            session.episodes.add(episode_id)","+        return session","+","+    def matching(self, sid: str) -> list:","+        out = []","+        for session in self._sessions.values():","+            if (sid in session.episodes or session.sid == sid","+                    or session.sid.startswith(sid + \"/\")):","+                out.append(session)","+        return out","+","+    def finish(self, sid: str) -> list:","+        sessions = self.matching(sid)","+        if not sessions:","+            logger.warning(\"finish for unknown session %s\", sid)","+            return []","+        samples = []","+        for session in sessions:","+            self._sessions.pop(session.sid, None)","+            samples.extend(session.to_samples())","+        return samples","+","+    def __len__(self):","+        return len(self._sessions)"],"newLines":228,"newStart":453,"oldLines":3,"oldStart":453}],"path":"/app/terminal_rl/terminal_rl/proxy/session.py"}]}