{"files":[{"hunks":[{"lines":["         self.assertEqual(json.loads(calls[0][\"function\"][\"arguments\"]), {\"cmd\": \"123\"})"," "," ","+class TestRendererSemantics(unittest.TestCase):","+    @classmethod","+    def setUpClass(cls):","+        from terminal_rl.proxy.session import MessageRenderer","+        cls.tok = AutoTokenizer.from_pretrained(QWEN, trust_remote_code=True)","+        cls.renderer = MessageRenderer(cls.tok)","+","+    def apply(self, messages, tools=None):","+        return list(self.tok.apply_chat_template(messages, tools=tools, tokenize=True,","+                                                 add_generation_prompt=True, return_dict=False))","+","+    def test_last_assistant_becomes_user_without_continue(self):","+        body = {\"messages\": [{\"role\": \"user\", \"content\": \"hi\"}, {\"role\": \"assistant\", \"content\": \"draft\"}]}","+        rendered = self.renderer.render_request(body)","+        self.assertEqual(rendered.canonical_ids,","+                         self.apply([{\"role\": \"user\", \"content\": \"hi\"}, {\"role\": \"user\", \"content\": \"draft\"}]))","+","+    def test_continue_final_message_appends_prefix_tokens(self):","+        body = {\"messages\": [{\"role\": \"user\", \"content\": \"hi\"}, {\"role\": \"assistant\", \"content\": \"partial ans\"}],","+                \"continue_final_message\": True}","+        rendered = self.renderer.render_request(body)","+        expected = self.apply([{\"role\": \"user\", \"content\": \"hi\"}]) + self.tok.encode(\"partial ans\")","+        self.assertEqual(rendered.canonical_ids, expected)","+        self.assertTrue(rendered.text.endswith(\"partial ans\"))","+","+    def test_content_parts_flattened_for_string_templates(self):","+        body = {\"messages\": [{\"role\": \"user\", \"content\": [","+            {\"type\": \"text\", \"text\": \"hello\"}, {\"type\": \"text\", \"text\": \"world\"}]}]}","+        rendered = self.renderer.render_request(body)","+        self.assertEqual(rendered.canonical_ids, self.apply([{\"role\": \"user\", \"content\": \"hello world\"}]))","+","+    def test_tool_choice_none_omits_tools_from_prompt(self):","+        tools = [{\"type\": \"function\", \"function\": {\"name\": \"run\", \"parameters\": {\"type\": \"object\"}}}]","+        msgs = [{\"role\": \"user\", \"content\": \"hi\"}]","+        rendered = self.renderer.render_request({\"messages\": msgs, \"tools\": tools, \"tool_choice\": \"none\"})","+        self.assertEqual(rendered.canonical_ids, self.apply(msgs, tools=None))","+        self.assertTrue(rendered.skip_special_tokens)","+","+"," if __name__ == \"__main__\":","     unittest.main()"],"newLines":44,"newStart":270,"oldLines":5,"oldStart":270}],"path":"/app/terminal_rl/tests/test_proxy.py"}]}