{"files":[{"hunks":[{"lines":["+\"\"\"Focused contract tests for terminal_rl.proxy (run: python -m unittest discover -s tests).\"\"\"","+","+import asyncio","+import json","+import unittest","+","+from aiohttp import ClientTimeout, web","+from aiohttp.test_utils import TestClient, TestServer","+from transformers import AutoTokenizer","+","+from terminal_rl.proxy.server import ProxyApp","+","+QWEN = \"/models/Qwen3-4B-Instruct-2507\"","+GLM = \"/models/GLM-4.7-Flash-agent\"","+","+","+class FakeEngine:","+    \"\"\"HTTP stand-in for SGLang /generate (+ /abort_request). handler(prompt_ids, params, n) ->","+    (output_ids, finish_reason_dict) or a coroutine returning that.\"\"\"","+","+    def __init__(self, handler):","+        self.handler = handler","+        self.calls = []","+        self.aborts = []","+","+    async def generate(self, request):","+        body = await request.json()","+        ids = [int(x) for x in body[\"input_ids\"]]","+        params = body.get(\"sampling_params\") or {}","+        rid = body.get(\"rid\") or f\"rid{len(self.calls)}\"","+        self.calls.append({\"input_ids\": ids, \"sampling_params\": params, \"rid\": rid})","+        out = self.handler(ids, params, len(self.calls) - 1)","+        if asyncio.iscoroutine(out):","+            out = await out","+        output_ids, finish = out","+        lps = [-0.5 - 0.01 * i for i in range(len(output_ids))]","+        return web.json_response({","+            \"text\": \"\",","+            \"output_ids\": output_ids,","+            \"meta_info\": {\"id\": rid, \"finish_reason\": finish, \"prompt_tokens\": len(ids),","+                          \"completion_tokens\": len(output_ids), \"cached_tokens\": 0,","+                          \"output_token_logprobs\": [[lp, t, None] for lp, t in zip(lps, output_ids)]},","+        })","+","+    async def abort(self, request):","+        self.aborts.append(await request.json())","+        return web.json_response({\"ok\": True})","+","+    def app(self):","+        a = web.Application()","+        a.router.add_post(\"/generate\", self.generate)","+        a.router.add_post(\"/abort_request\", self.abort)","+        return a","+","+","+def stop(ids, matched):","+    return list(ids), {\"type\": \"stop\", \"matched\": matched}","+","+","+class ProxyCase(unittest.IsolatedAsyncioTestCase):","+    model = QWEN","+    proxy_kwargs = {}","+","+    @classmethod","+    def setUpClass(cls):","+        cls.tok = AutoTokenizer.from_pretrained(cls.model, trust_remote_code=True)","+","+    async def asyncSetUp(self):","+        self.clients = []","+","+    async def asyncTearDown(self):","+        for c in self.clients:","+            await c.close()","+","+    async def start(self, handler, **kw):","+        self.engine = FakeEngine(handler)","+        eng_client = TestClient(TestServer(self.engine.app()))","+        await eng_client.start_server()","+        self.clients.append(eng_client)","+        proxy = ProxyApp(self.tok, str(eng_client.session._connector_owner and eng_client._server.sockets[0].getsockname()).join([\"http://127.0.0.1:\", \"\"]) if False else f\"http://127.0.0.1:{eng_client.server.port}\", **{**self.proxy_kwargs, **kw})","+        client = TestClient(TestServer(proxy.build_app()))","+        await client.start_server()","+        self.clients.append(client)","+        self.client = client","+        return client","+","+    async def chat(self, episode, agent, messages, **body_kw):","+        body = {\"model\": \"policy\", \"messages\": messages, \"session_id\": agent, **body_kw}","+        async with self.client.post(f\"/s/{episode}/v1/chat/completions\", json=body,","+                                    headers={\"X-Session-ID\": agent}) as r:","+            return r.status, await r.json(content_type=None)","+","+    async def finish(self, episode):","+        async with self.client.post(f\"/s/{episode}/finish\", json={}) as r:","+            self.assertEqual(r.status, 200)","+            return (await r.json())[\"samples\"]","+","+    def enc(self, text):","+        return self.tok.encode(text, add_special_tokens=False)","+","+    def canonical(self, messages, tools=None, **kw):","+        return list(self.tok.apply_chat_template(messages, tools=tools, tokenize=True,","+                                                 add_generation_prompt=True, return_dict=False, **kw))","+","+","+class TestQwenProxy(ProxyCase):","+    eos = 151645","+","+    async def test_summarized_history_is_rerendered_and_split(self):","+        outs = [stop(self.enc(\"first answer\") + [self.eos], self.eos),","+                stop(self.enc(\"second answer\") + [self.eos], self.eos)]","+        await self.start(lambda ids, p, n: outs[n])","+        m1 = [{\"role\": \"user\", \"content\": \"task one\"}]","+        s, r1 = await self.chat(\"ep1\", \"ep1\", m1)","+        self.assertEqual(s, 200)","+        # Summarization replaces the whole history with a handoff conversation.","+        m2 = [{\"role\": \"user\", \"content\": \"You are picking up work. Summary: did things.\"},","+              {\"role\": \"assistant\", \"content\": \"What remains?\"},","+              {\"role\": \"user\", \"content\": \"Here are the answers. Continue.\"}]","+        s, _ = await self.chat(\"ep1\", \"ep1\", m2)","+        self.assertEqual(s, 200)","+        self.assertEqual(self.engine.calls[1][\"input_ids\"], self.canonical(m2))","+        samples = await self.finish(\"ep1\")","+        self.assertEqual(len(samples), 2)","+        for sample, msgs, out in zip(samples, (m1, m2), outs):","+            prompt = self.canonical(msgs)","+            self.assertEqual(sample[\"tokens\"][:len(prompt)], prompt)","+            self.assertEqual(sample[\"tokens\"][len(prompt):], out[0])","+            self.assertEqual(sample[\"loss_mask\"], [1] * len(out[0]))","+            self.assertEqual(sample[\"session_id\"], \"ep1\")","+","+    async def test_linear_history_is_one_sample_with_sampled_ids(self):","+        # Deliberately non-canonical tokenization of the assistant text.","+        weird = self.enc(\"hel\") + self.enc(\"lo world\") + [self.eos]","+        self.assertNotEqual(weird[:-1], self.enc(\"hello world\"))","+        outs = [stop(weird, self.eos), stop(self.enc(\"done\") + [self.eos], self.eos)]","+        await self.start(lambda ids, p, n: outs[n])","+        m1 = [{\"role\": \"user\", \"content\": \"say hi\"}]","+        s, r1 = await self.chat(\"ep2\", \"ep2\", m1)","+        self.assertEqual(s, 200)","+        content = r1[\"choices\"][0][\"message\"][\"content\"]","+        m2 = m1 + [{\"role\": \"assistant\", \"content\": content}, {\"role\": \"user\", \"content\": \"again\"}]","+        s, _ = await self.chat(\"ep2\", \"ep2\", m2)","+        self.assertEqual(s, 200)","+        p1 = self.engine.calls[0][\"input_ids\"]","+        # Engine sees the very ids it sampled, not a re-tokenization.","+        self.assertEqual(self.engine.calls[1][\"input_ids\"][:len(p1) + len(weird)], p1 + weird)","+        # ... while decoding to exactly SGLang's rendered prompt.","+        self.assertEqual(self.tok.decode(self.engine.calls[1][\"input_ids\"], skip_special_tokens=False),","+                         self.tok.decode(self.canonical(m2), skip_special_tokens=False))","+        samples = await self.finish(\"ep2\")","+        self.assertEqual(len(samples), 1)","+        trained = sum(samples[0][\"loss_mask\"])","+        self.assertEqual(trained, len(weird) + len(outs[1][0]))","+","+    async def test_explorers_get_own_samples_and_finish_returns_all(self):","+        outs = [stop(self.enc(\"explored\") + [self.eos], self.eos),","+                stop(self.enc(\"main work\") + [self.eos], self.eos)]","+        await self.start(lambda ids, p, n: outs[n])","+        s, _ = await self.chat(\"ep3\", \"ep3/explore-0\", [{\"role\": \"user\", \"content\": \"look around\"}])","+        self.assertEqual(s, 200)","+        s, _ = await self.chat(\"ep3\", \"ep3\", [{\"role\": \"user\", \"content\": \"do task\"}])","+        self.assertEqual(s, 200)","+        samples = await self.finish(\"ep3\")","+        self.assertEqual(sorted(s[\"session_id\"] for s in samples), [\"ep3\", \"ep3/explore-0\"])","+        by_id = {s[\"session_id\"]: s for s in samples}","+        self.assertEqual(self.tok.decode(by_id[\"ep3/explore-0\"][\"tokens\"], skip_special_tokens=True).count(\"explored\"), 1)","+        self.assertEqual(self.tok.decode(by_id[\"ep3\"][\"tokens\"], skip_special_tokens=True).count(\"explored\"), 0)","+","+    async def test_abort_is_an_error_and_never_trained(self):","+        outs = [(self.enc(\"partial\"), {\"type\": \"abort\", \"message\": \"weight update\"}),","+                stop(self.enc(\"full answer\") + [self.eos], self.eos)]","+        await self.start(lambda ids, p, n: outs[n])","+        m = [{\"role\": \"user\", \"content\": \"q\"}]","+        s, _ = await self.chat(\"ep4\", \"ep4\", m)","+        self.assertGreaterEqual(s, 500)","+        s, r = await self.chat(\"ep4\", \"ep4\", m)  # identical retry","+        self.assertEqual(s, 200)","+        self.assertEqual(r[\"choices\"][0][\"message\"][\"content\"], \"full answer\")","+        samples = await self.finish(\"ep4\")","+        self.assertEqual(sum(sum(s[\"loss_mask\"]) for s in samples), len(outs[1][0]))","+","+    async def test_identical_retry_after_success_resends_without_retraining(self):","+        out = stop(self.enc(\"answer\") + [self.eos], self.eos)","+        await self.start(lambda ids, p, n: out)","+        m = [{\"role\": \"user\", \"content\": \"q\"}]","+        s, r1 = await self.chat(\"ep5\", \"ep5\", m)","+        self.assertEqual(s, 200)","+        s, r2 = await self.chat(\"ep5\", \"ep5\", m)  # gateway dropped r1; agent retries verbatim","+        self.assertEqual(s, 200)","+        self.assertEqual(r2[\"choices\"][0][\"message\"][\"content\"], r1[\"choices\"][0][\"message\"][\"content\"])","+        self.assertEqual(len(self.engine.calls), 1)","+        samples = await self.finish(\"ep5\")","+        self.assertEqual(sum(sum(s[\"loss_mask\"]) for s in samples), len(out[0]))","+","+    async def test_sampling_params_follow_sglang_defaults_and_stop(self):","+        await self.start(lambda ids, p, n: stop(self.enc(\"x\") + [self.eos], self.eos))","+        s, _ = await self.chat(\"ep6\", \"ep6\", [{\"role\": \"user\", \"content\": \"q\"}],","+                               temperature=1.0, stop=[\"STOPHERE\"])","+        self.assertEqual(s, 200)","+        p = self.engine.calls[0][\"sampling_params\"]","+        self.assertEqual(p.get(\"top_p\"), 0.8)   # Qwen generation_config defaults, as SGLang","+        self.assertEqual(p.get(\"top_k\"), 20)","+        self.assertEqual(p.get(\"stop\"), [\"STOPHERE\"])","+","+    async def test_tool_history_and_tool_definitions_render_like_sglang(self):","+        await self.start(lambda ids, p, n: stop(self.enc(\"ok\") + [self.eos], self.eos))","+        tools = [{\"type\": \"function\", \"function\": {\"name\": \"run\", \"parameters\": {","+            \"type\": \"object\", \"properties\": {\"cmd\": {\"type\": \"string\"}}}}}]","+        msgs = [{\"role\": \"user\", \"content\": \"go\"},","+                {\"role\": \"assistant\", \"content\": None, \"tool_calls\": [","+                    {\"id\": \"call_1\", \"type\": \"function\",","+                     \"function\": {\"name\": \"run\", \"arguments\": \"{\\\"cmd\\\": \\\"ls\\\"}\"}}]},","+                {\"role\": \"tool\", \"tool_call_id\": \"call_1\", \"content\": \"file.txt\"}]","+        s, _ = await self.chat(\"ep7\", \"ep7\", msgs, tools=tools)","+        self.assertEqual(s, 200)","+        dumped_tools = [{\"type\": \"function\", \"function\": {\"description\": None, \"name\": \"run\",","+                         \"parameters\": tools[0][\"function\"][\"parameters\"], \"strict\": False}}]","+        expected_msgs = [msgs[0],","+                         {\"role\": \"assistant\", \"content\": \"\", \"tool_calls\": [","+                             {\"id\": \"call_1\", \"index\": None, \"type\": \"function\",","+                              \"function\": {\"name\": \"run\", \"arguments\": {\"cmd\": \"ls\"}}}]},","+                         {\"role\": \"tool\", \"content\": \"file.txt\", \"tool_call_id\": \"call_1\"}]","+        self.assertEqual(self.engine.calls[0][\"input_ids\"], self.canonical(expected_msgs, tools=dumped_tools))","+","+    async def test_client_giving_up_trains_nothing(self):","+        async def slow(ids, p, n):","+            await asyncio.sleep(2.0)","+            return stop(self.enc(\"late\") + [self.eos], self.eos)","+        await self.start(slow)","+        body = {\"model\": \"policy\", \"messages\": [{\"role\": \"user\", \"content\": \"q\"}], \"session_id\": \"ep8\"}","+        with self.assertRaises(asyncio.TimeoutError):","+            async with asyncio.timeout(0.3):","+                async with self.client.post(\"/s/ep8/v1/chat/completions\", json=body,","+                                            headers={\"X-Session-ID\": \"ep8\"}) as r:","+                    await r.read()","+        await asyncio.sleep(0.6)","+        samples = await self.finish(\"ep8\")","+        self.assertEqual(samples, [])","+","+","+class TestGlmProxy(ProxyCase):","+    model = GLM","+    proxy_kwargs = {\"reasoning_parser\": \"think\", \"tool_call_parser\": \"glm47\"}","+    eos = 154827  # <|user|>","+","+    async def test_request_chat_template_kwargs_are_honoured(self):","+        await self.start(lambda ids, p, n: stop(self.enc(\"plain\") + [self.eos], self.eos))","+        m = [{\"role\": \"user\", \"content\": \"q\"}]","+        s, _ = await self.chat(\"g1\", \"g1\", m, chat_template_kwargs={\"enable_thinking\": False})","+        self.assertEqual(s, 200)","+        expected = list(self.tok.apply_chat_template(","+            m, tokenize=True, add_generation_prompt=True, return_dict=False, enable_thinking=False))","+        self.assertEqual(self.engine.calls[0][\"input_ids\"], expected)","+","+    async def test_reasoning_split_and_glm_tool_parsing(self):","+        text = (\"thinking here</think>intro<tool_call>run<arg_key>cmd</arg_key>\"","+                \"<arg_value>123</arg_value></tool_call> tail\")","+        await self.start(lambda ids, p, n: stop(self.enc(text) + [self.eos], self.eos))","+        tools = [{\"type\": \"function\", \"function\": {\"name\": \"run\", \"parameters\": {","+            \"type\": \"object\", \"properties\": {\"cmd\": {\"type\": \"string\"}}}}}]","+        s, r = await self.chat(\"g2\", \"g2\", [{\"role\": \"user\", \"content\": \"go\"}], tools=tools)","+        self.assertEqual(s, 200)","+        msg = r[\"choices\"][0][\"message\"]","+        self.assertEqual(msg.get(\"reasoning_content\"), \"thinking here\")","+        self.assertIn(\"tail\", msg.get(\"content\") or \"\")","+        calls = msg.get(\"tool_calls\") or []","+        self.assertEqual(len(calls), 1)","+        # Schema says string: \"123\" must stay a string in the arguments JSON.","+        self.assertEqual(json.loads(calls[0][\"function\"][\"arguments\"]), {\"cmd\": \"123\"})","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"newLines":274,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/terminal_rl/tests/test_proxy.py"}]}