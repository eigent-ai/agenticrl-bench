{"files":[{"hunks":[{"lines":[" \"\"\"OpenAI-compatible chat endpoint in front of the rollout engine."," ","-Agents (Terminus-2 through LiteLLM, our tool-calling agent) get ``http://<proxy>/s/<session_id>/v1`` as their base URL.","-Every request is turned into token ids for the session, sent to SGLang's ``/generate``, and the reply is parsed back into","-an OpenAI chat completion. When the episode is over the rollout function calls ``POST /s/<session_id>/finish`` and gets","-the slime samples of that session.","+Agents (Terminus-2 through LiteLLM, our tool-calling agent) get ``http://<proxy>/s/<episode_id>/v1`` as their base","+URL and name their own conversation with ``X-Session-ID`` (and ``session_id`` in the body); explorers therefore get","+token bookkeeping of their own. Every request is rendered exactly as SGLang's chat endpoint would render it (see","+session.MessageRenderer), spliced onto the ids this agent's earlier turns were sampled with where the rendered","+text begins with them, sent to SGLang's ``/generate``, and parsed back into an OpenAI chat completion."," ","+Only a generation the agent actually receives is trained: an engine abort becomes a 502 (agents retry the","+identical request), a client that goes away mid-generation aborts the engine request and trains nothing, and an","+identical retry of the last successful request (which is how a response lost downstream shows up) is answered","+from cache without a second engine call or a second copy in training.","+","     POST /s/{sid}/v1/chat/completions   (also /v1/chat/completions with \"session_id\" in the body)","-    POST /s/{sid}/finish                -> {\"samples\": [Sample.to_dict(), ...]}","+    POST /s/{sid}/finish                -> {\"samples\": [Sample.to_dict(), ...]} for every agent of the episode","     GET  /health, GET /v1/models"," \"\"\""," ","+import asyncio","+import copy","+import hashlib"," import json"," import logging","+import os"," import time"," import uuid"," "," from aiohttp import web"," ","-from terminal_rl.proxy.engine import EngineClient","+from terminal_rl.proxy.engine import EngineClient, EngineError"," from terminal_rl.proxy.parsing import OutputParser","-from terminal_rl.proxy.session import MessageRenderer, SessionStore","+from terminal_rl.proxy.session import MessageRenderer, RequestError, SessionStore, tool_choice_name"," "," logger = logging.getLogger(__name__)"," ","+_OPENAI_SAMPLING_DEFAULTS = {\"temperature\": 1.0, \"top_p\": 1.0, \"top_k\": -1, \"min_p\": 0.0, \"repetition_penalty\": 1.0}","+"," "," def _error(status: int, message: str, err_type: str = \"BadRequestError\") -> web.Response:","     return web.json_response({\"error\": {\"message\": message, \"type\": err_type, \"code\": status}}, status=status)"," "," ","+def _model_sampling_defaults(tokenizer):","+    keys = tuple(_OPENAI_SAMPLING_DEFAULTS)","+    path = getattr(tokenizer, \"name_or_path\", None)","+    if path and os.path.isdir(path):","+        try:","+            with open(os.path.join(path, \"generation_config.json\")) as f:","+                raw = json.load(f)","+            return {k: raw[k] for k in keys if raw.get(k) is not None}","+        except Exception:","+            pass","+    try:","+        from transformers import GenerationConfig","+","+        diff = GenerationConfig.from_pretrained(path).to_diff_dict()","+        return {k: diff[k] for k in keys if diff.get(k) is not None}","+    except Exception:","+        return {}","+","+","+def _get_tool_schema(tool):","+    fn = tool[\"function\"]","+    return {\"properties\": {\"name\": {\"type\": \"string\", \"enum\": [fn[\"name\"]]},","+                           \"parameters\": fn.get(\"parameters\") or {\"type\": \"object\", \"properties\": {}}},","+            \"required\": [\"name\", \"parameters\"]}","+","+","+def _json_schema_constraint(tools, tool_choice):","+    if isinstance(tool_choice, dict):","+        name = tool_choice_name(tool_choice)","+        for tool in tools:","+            if tool[\"function\"][\"name\"] == name:","+                return {\"type\": \"array\", \"minItems\": 1, \"maxItems\": 1, \"items\": _get_tool_schema(tool)}","+        return None","+    if tool_choice == \"required\":","+        schema = {\"type\": \"array\", \"minItems\": 1,","+                  \"items\": {\"type\": \"object\", \"anyOf\": [_get_tool_schema(t) for t in tools]}}","+        defs = {}","+        for tool in tools:","+            params = tool[\"function\"].get(\"parameters\")","+            if isinstance(params, dict):","+                for k, v in (params.get(\"$defs\") or {}).items():","+                    if k in defs and defs[k] != v:","+                        raise RequestError(f\"Tool definition '{k}' has multiple schemas, which is not supported.\")","+                    defs[k] = v","+        if defs:","+            schema[\"$defs\"] = defs","+        return schema","+    return None","+","+"," class ProxyApp:","     def __init__(self, tokenizer, engine_url: str, *, served_model_name: str = \"policy\", template_kwargs=None,","                  reasoning_parser: str = \"think\", tool_call_parser: str = \"none\", context_length: int = 65536,","-                 default_max_tokens: int = 8192):","+                 default_max_tokens: int = 8192, model_sampling_defaults: dict | None = None):","         self.tokenizer = tokenizer","         self.engine = EngineClient(engine_url)","         self.store = SessionStore(MessageRenderer(tokenizer, template_kwargs))","+        self.renderer = self.store.renderer","         self.parser = OutputParser(tokenizer, reasoning_parser, tool_call_parser)","         self.served_model_name = served_model_name","         self.context_length = context_length","         self.default_max_tokens = default_max_tokens","+        self.model_sampling_defaults = (dict(model_sampling_defaults) if model_sampling_defaults is not None","+                                         else _model_sampling_defaults(tokenizer))","         self.num_requests = 0"," ","     def build_app(self) -> web.Application:"],"newLines":109,"newStart":1,"oldLines":44,"oldStart":1},{"lines":["     async def models(self, request):","         return web.json_response({\"object\": \"list\", \"data\": [{\"id\": self.served_model_name, \"object\": \"model\"}]})"," ","-    def _sampling_params(self, body: dict, prompt_len: int) -> dict:","+    # -- sampling ---------------------------------------------------------------","+    def _sampling_params(self, body: dict, rendered, prompt_len: int) -> dict:","+        def get_param(name):","+            value = body.get(name)","+            if value is None:","+                return self.model_sampling_defaults.get(name, _OPENAI_SAMPLING_DEFAULTS[name])","+            return value","+","         max_tokens = body.get(\"max_completion_tokens\") or body.get(\"max_tokens\") or self.default_max_tokens","         params = {","+            \"temperature\": get_param(\"temperature\"),","             \"max_new_tokens\": max(1, min(int(max_tokens), self.context_length - prompt_len)),","-            \"temperature\": body.get(\"temperature\", 1.0),","-            \"top_p\": body.get(\"top_p\", 1.0),","-            \"skip_special_tokens\": False,","-            \"no_stop_trim\": True,","+            \"min_new_tokens\": int(body.get(\"min_tokens\") or 0),","+            \"stop\": body.get(\"stop\"),","+            \"stop_token_ids\": body.get(\"stop_token_ids\"),","+            \"stop_regex\": body.get(\"stop_regex\"),","+            \"top_p\": get_param(\"top_p\"),","+            \"top_k\": get_param(\"top_k\"),","+            \"min_p\": get_param(\"min_p\"),","+            \"presence_penalty\": body.get(\"presence_penalty\") or 0.0,","+            \"frequency_penalty\": body.get(\"frequency_penalty\") or 0.0,","+            \"repetition_penalty\": get_param(\"repetition_penalty\"),","+            \"regex\": body.get(\"regex\"),","+            \"ebnf\": body.get(\"ebnf\