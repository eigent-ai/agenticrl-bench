 not None:","+                    params[\"json_schema\"] = json.dumps(constraint)","         return params"," ","+    # -- engine call with client-disconnect handling ------------------------------","+    @staticmethod","+    def _client_gone(request) -> bool:","+        transport = request.transport","+        return transport is None or transport.is_closing()","+","+    async def _generate(self, request, input_ids, params, rid):","+        \"\"\"Returns ('ok', result) | ('disconnected', None) | ('error', exception).\"\"\"","+        task = asyncio.ensure_future(self.engine.generate(input_ids, params, rid=rid))","+        try:","+            while not task.done():","+                try:","+                    await asyncio.wait_for(asyncio.shield(task), timeout=0.05)","+                except asyncio.TimeoutError:","+                    pass","+                if not task.done() and self._client_gone(request):","+                    asyncio.ensure_future(self.engine.abort(rid))","+                    task.cancel()","+                    try:","+                        await task","+                    except (asyncio.CancelledError, Exception):","+                        pass","+                    return \"disconnected\", None","+            result = task.result()","+        except asyncio.CancelledError:","+            asyncio.ensure_future(self.engine.abort(rid))","+            task.cancel()","+            raise","+        except Exception as e:  # engine HTTP error, timeout, malformed reply","+            return \"error\", e","+        if self._client_gone(request):","+            return \"disconnected\", None","+        return \"ok\", result","+","+    # -- chat completions -----------------------------------------------------------","     async def chat_completions(self, request: web.Request) -> web.Response:","         try:","             body = await request.json()","-        except json.JSONDecodeError:","+        except (json.JSONDecodeError, ValueError