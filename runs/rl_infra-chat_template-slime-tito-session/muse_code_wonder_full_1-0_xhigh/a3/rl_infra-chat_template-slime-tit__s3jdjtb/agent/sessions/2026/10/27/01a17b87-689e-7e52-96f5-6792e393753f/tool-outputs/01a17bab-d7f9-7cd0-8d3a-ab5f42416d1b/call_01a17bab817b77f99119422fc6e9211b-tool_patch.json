{"files":[{"hunks":[{"lines":[" ","     def conversation(self, messages: list[dict], tools: list[dict] | None = None, body: dict | None = None) -> list[int]:","         return self.render_prompt(messages=messages, tools=tools, body=body).ids","+","+","+@dataclass","+class _Segment:","+    tokens: list[int] = field(default_factory=list)","+    loss_mask: list[int] = field(default_factory=list)  # aligned with tokens","+    log_probs: list[float] = field(default_factory=list)  # aligned with tokens","+    prompt_length: int = 0","+    text_parts: list[str] = field(default_factory=list)","+    text_length: int = 0","+    num_turns: int = 0","+    truncated: bool = False","+","+    def append(self, ids, mask, log_probs=None, text=None):","+        self.tokens.extend(ids)","+        self.loss_mask.extend([mask] * len(ids))","+        self.log_probs.extend(log_probs if log_probs is not None else [0.0] * len(ids))","+        if text:","+            self.text_parts.append(text)","+            self.text_length += len(text)","+","+","+@dataclass","+class _Candidate:","+    \"\"\"A token sequence the engine has already seen or produced for this","+    agent: a prefix of one segment, identified by its token and text ends.\"\"\"","+","+    segment: _Segment","+    token_end: int","+    text_parts_end: int","+    text_length: int","+    kind: str","+","+    def ids(self) -> list[int]:","+        return self.segment.tokens[: self.token_end]","+","+    def matches(self, text: str) -> bool:","+        if self.text_length > len(text):","+            return False","+        pos = 0","+        for part in self.segment.text_parts[: self.text_parts_end]:","+            if not text.startswith(part, pos):","+                return False","+            pos += len(part)","+        return pos == self.text_length","+","+","+@dataclass","+class _Undo:","+    segment: _Segment","+    new_segment: bool","+    token_length: int","+    text_parts_length: int","+    text_length: int","+    num_turns: int","+    truncated: bool","+    candidates_length: int","+    request_key: object = None","+","+","+@dataclass","+class _Pending:","+    rendered: RenderedPrompt","+    prompt_ids: list[int]","+    request_key: object = None","+","+","+class Session:","+    \"\"\"One agent.  Holds every Sample segment its delivered generations","+    form, in the order the segments were started.\"\"\"","+","+    def __init__(self, sid: str, renderer: MessageRenderer):","+        self.sid = sid","+        self.renderer = renderer","+        self.lock = asyncio.Lock()","+        self.segments: list[_Segment] = []","+        self.candidates: list[_Candidate] = []","+        self.pending: _Pending | None = None","+        self._last_unconfirmed: _Undo | None = None","+        self.closed = False","+        self.created = time.time()","+","+    # -- duplicate / undelivered handling ----------------------------------","+","+    def begin_request(self, request_key) -> None:","+        \"\"\"An identical retry is the only sign that the previous response","+        never reached the agent (e.g. the gateway dropped it after we sent","+        it): take that generation back out.  Any different request means","+        the agent moved on, so the previous generation stands.\"\"\"","+        self.pending = None","+        if self._last_unconfirmed is not None:","+            if request_key is not None and request_key == self._last_unconfirmed.request_key:","+                self._rollback(self._last_unconfirmed)","+            self._last_unconfirmed = None","+","+    def _rollback(self, undo: _Undo) -> None:","+        del self.candidates[undo.candidates_length :]","+        seg = undo.segment","+        if undo.new_segment:","+            self.segments = [s for s in self.segments if s is not seg]","+        else:","+            del seg.tokens[undo.token_length :]","+            del seg.loss_mask[undo.token_length :]","+            del seg.log_probs[undo.token_length :]","+            del seg.text_parts[undo.text_parts_length :]","+            seg.text_length = undo.text_length","+            seg.num_turns = undo.num_turns","+            seg.truncated = undo.truncated","+","+    def discard_pending(self) -> None:","+        self.pending = None","+","+    # -- prompt preparation -------------------------------------------------","+","+    def _preserve_ids(self, rendered: RenderedPrompt) -> list[int]:","+        \"\"\"Replace a re-tokenized prefix with the ids the engine saw and","+        sampled earlier, where the new prompt's text starts with an earlier","+        prompt (or prompt + generation) of this agent.\"\"\"","+        reference = rendered.ids","+        best = None","+        for cand in self.candidates:","+            if cand.text_length and cand.matches(rendered.text):","+                if best is None or cand.text_length >= best.text_length:","+                    best = cand","+        if best is None:","+            return reference","+        cand_ids = best.ids()","+        if reference[: len(cand_ids)] == cand_ids:","+            return reference","+        if not rendered.offsets:","+            return reference","+        length = best.text_length","+        k = bisect_left(rendered.offsets, length, key=lambda span: span[0])","+        if k < len(rendered.offsets) and rendered.offsets[k][0] != length:","+            return reference","+        if k > 0 and rendered.offsets[k - 1][1] > length:","+            return reference  # a token straddles the boundary; cannot splice","+        prompt = cand_ids + reference[k:]","+        try:","+            if self.renderer.tokenizer.decode(prompt, skip_special_tokens=False) != rendered.text:","+                return reference","+        except Exception:","+            return reference","+        return prompt","+","+    def prepare_prompt(self, messages=None, tools=None, body: dict | None = None, request_key=None) -> RenderedPrompt:","+        if request_key is not None:","+            self.begin_request(request_key)","+        rendered = self.renderer.render_prompt(messages=messages, tools=tools, body=body)","+        rendered.reference_ids = list(rendered.ids)","+        rendered.ids = self._preserve_ids(rendered)","+        self.pending = _Pending(rendered=rendered, prompt_ids=list(rendered.ids), request_key=request_key)","+        return rendered","+","+    def prompt_ids(self, messages: list[dict], tools: list[dict] | None = None, body: dict | None = None,","+                   request_key=None) -> list[int]:","+        return list(self.prepare_prompt(messages=messages, tools=tools, body=body, request_key=request_key).ids)","+","+    # -- committing a delivered generation ----------------------------------","+","+    def add_output(self, output_ids: list[int], log_probs: list[float], finish_reason: str):","+        if self.pending is None:","+            raise RuntimeError(\"add_output without a prepared prompt\")","+        pending = self.pending","+        self.pending = None","+        rendered = pending.rendered","+        prompt = pending.prompt_ids","+        output = [int(t) for t in output_ids]","+        lps = [float(x) for x in (log_probs or [])][: len(output)]","+        lps += [0.0] * (len(output) - len(lps))","+        output_text = self.renderer.tokenizer.decode(output, skip_special_tokens=False) if output else \"\"","+","+        segment = None","+        for seg in self.segments:","+            if seg.tokens and prompt[: len(seg.tokens)] == seg.tokens:","+                if segment is None or len(seg.tokens) > len(segment.tokens):","+                    segment = seg","+","+        if segment is not None:","+            undo = _Undo(segment, False, len(segment.tokens), len(segment.text_parts), segment.text_length,","+                         segment.num_turns, segment.truncated, len(self.candidates), pending.request_key)","+            suffix = prompt[len(segment.tokens) :]","+            if suffix:","+                suffix_text = self.renderer.tokenizer.decode(suffix, skip_special_tokens=False)","+                segment.append(suffix, 0, text=suffix_text)","+        else:","+            segment = _Segment(prompt_length=len(prompt))","+            segment.append(list(prompt), 0, text=rendered.text)","+            self.segments.append(segment)","+            undo = _Undo(segment, True, 0, 0, 0, 0, False, len(self.candidates), pending.request_key)","+","+        self.candidates.append(","+            _Candidate(segment, len(segment.tokens), len(segment.text_parts), segment.text_length, \"prompt\")","+        )","+        segment.append(output, 1, log_probs=lps, text=output_text)","+        self.candidates.append(","+            _Candidate(segment, len(segment.tokens), len(segment.text_parts), segment.text_length, \"generation\")","+        )","+        segment.num_turns += 1","+        if finish_reason == \"length\":","+            segment.truncated = True","+        self._last_unconfirmed = undo","+","+    def to_samples(self) -> list[Sample]:","+        samples = []","+        for seg in self.segments:","+            if not seg.num_turns:","+                continue","+            samples.append(","+                Sample(","+                    tokens=list(seg.tokens),","+                    response_length=len(seg.tokens) - seg.prompt_length,","+                    loss_mask=list(seg.loss_mask[seg.prompt_length :]),","+                    rollout_log_probs=list(seg.log_probs[seg.prompt_length :]),","+                    status=Sample.Status.TRUNCATED if seg.truncated else Sample.Status.COMPLETED,","+                    session_id=self.sid,","+                    metadata={\"num_turns\": seg.num_turns},","+                )","+            )","+        return samples","+","+","+class SessionStore:","+    \"\"\"Agent sessions, grouped by the episode base URL they arrived on.\"\"\"","+","+    def __init__(self, renderer: MessageRenderer):","+        self.renderer = renderer","+        self._sessions: dict[str, Session] = {}","+        self._episodes: dict[str, dict[str, None]] = {}","+","+    def get(self, sid: str, episode_id: str | None = None) -> Session:","+        session = self._sessions.get(sid)","+        if session is None or session.closed:","+            session = self._sessions[sid] = Session(sid, self.renderer)","+        if episode_id is not None:","+            self._episodes.setdefault(episode_id, {})[sid] = None","+        return session","+","+    def _finish_targets(self, sid: str) -> list[str]:","+        ids: list[str] = []","+        for agent in self._episodes.get(sid, {}):","+            if agent in self._sessions and agent not in ids:","+                ids.append(agent)","+        if sid in self._sessions and sid not in ids:","+            ids.append(sid)","+        for agent in self._sessions:","+            if agent.startswith(sid + \"/\") and agent not in ids:","+                ids.append(agent)","+        return ids","+","+    def _collect(self, sid: str, ids: list[str]) -> list[Sample]:","+        samples: list[Sample] = []","+        for agent in ids:","+            session = self._sessions.pop(agent, None)","+            if session is None:","+                continue","+            session.closed = True","+            samples.extend(session.to_samples())","+        self._episodes.pop(sid, None)","+        for members in self._episodes.values():","+            for agent in ids:","+                members.pop(agent, None)","+        if not ids:","+            logger.warning(\"finish for unknown session %s\", sid)","+        return samples","+","+    def finish(self, sid: str) -> list[Sample]:","+        return self._collect(sid, self._finish_targets(sid))","+","+    async def finish_async(self, sid: str) -> list[Sample]:","+        ids = self._finish_targets(sid)","+        sessions = [self._sessions[agent] for agent in ids if agent in self._sessions]","+        acquired = []","+        try:","+            for session in sessions:","+                await session.lock.acquire()","+                acquired.append(session)","+            return self._collect(sid, ids)","+        finally:","+            for session in reversed(acquired):","+                session.lock.release()","+","+    def __len__(self):","+        return len(self._sessions)","+"],"newLines":288,"newStart":359,"oldLines":3,"oldStart":359}],"path":"/app/terminal_rl/terminal_rl/proxy/session.py"}]}