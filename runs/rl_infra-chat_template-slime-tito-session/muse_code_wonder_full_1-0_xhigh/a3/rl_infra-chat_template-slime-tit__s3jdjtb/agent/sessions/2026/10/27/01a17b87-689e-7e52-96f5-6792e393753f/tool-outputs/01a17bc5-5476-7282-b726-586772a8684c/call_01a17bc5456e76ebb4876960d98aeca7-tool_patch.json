{"files":[{"hunks":[{"lines":["+import asyncio, json, aiohttp","+async def main():","+ async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=300)) as http:","+  msgs=[{\"role\":\"user\",\"content\":\"Reply with a short sentence about Paris.\"}]","+  async with http.post(\"http://127.0.0.1:8199/s/smoke1/v1/chat/completions\",json={\"model\":\"policy\",\"messages\":msgs,\"temperature\":0.7,\"max_tokens\":64,\"session_id\":\"smoke1\"}) as r:","+   print(\"first\",r.status); d=await r.json(); print(json.dumps(d,indent=1)[:2000])","+  msg=d[\"choices\"][0][\"message\"]","+  msgs2=msgs+[{\"role\":\"assistant\",\"content\":msg.get(\"content\")},{\"role\":\"user\",\"content\":\"Now reply with exactly: done\"}]","+  async with http.post(\"http://127.0.0.1:8199/s/smoke1/v1/chat/completions\",json={\"model\":\"policy\",\"messages\":msgs2,\"temperature\":0.0,\"max_tokens\":16,\"session_id\":\"smoke1\"}) as r:","+   print(\"second\",r.status); d2=await r.json(); print(json.dumps(d2,indent=1)[:2000])","+  async with http.post(\"http://127.0.0.1:8199/s/smoke1/finish\",json={}) as r:","+   s=await r.json(); print(\"samples\",[(x[\"session_id\"],len(x[\"tokens\"]),x[\"response_length\"],sum(x[\"loss_mask\"]),x[\"status\"]) for x in s[\"samples\"]])","+asyncio.run(main())"],"newLines":13,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/smoke_real.py"}]}