{"files":[{"hunks":[{"lines":["         return normal_text, calls"," "," ","-TOOL_PARSERS = {\"glm47\": Glm47ToolParser, \"none\": None}","+class JsonToolParser:","+    \"\"\"`<tool_call>{json}</tool_call>` detectors (SGLang qwen25 / hermes).\"\"\"","+","+    def __init__(self, bot_token: str = \"<tool_call>\\n\", eot_token: str = \"\\n</tool_call>\"):","+        self.bot_token = bot_token","+        self.eot_token = eot_token","+","+    def has_tool_call(self, text: str) -> bool:","+        return self.bot_token in text","+","+    def parse(self, text: str, tools=None) -> tuple[str, list[dict]]:","+        idx = text.find(self.bot_token)","+        if idx == -1:","+            return text, []","+        normal_text = text[:idx].strip()","+        known = None","+        if tools is not None:","+            known = set()","+            for tool in tools:","+                if isinstance(tool, dict):","+                    fn = tool.get(\"function\") if isinstance(tool.get(\"function\"), dict) else tool","+                    if fn.get(\"name\"):","+                        known.add(fn[\"name\"])","+        pattern = rf\"{re.escape(self.bot_token)}(.*?){re.escape(self.eot_token)}\"","+        calls = []","+        for raw in re.findall(pattern, text, re.DOTALL):","+            try:","+                parsed = json.loads(raw.strip())","+            except (json.JSONDecodeError, ValueError):","+                continue","+            actions = parsed if isinstance(parsed, list) else [parsed]","+            for action in actions:","+                if not isinstance(action, dict):","+                    continue","+                name = action.get(\"name\")","+                if not name or (known is not None and name not in known):","+                    continue","+                params = action.get(\"parameters\") or action.get(\"arguments\", {})","+                calls.append(","+                    {","+                        \"id\": f\"call_{uuid.uuid4().hex[: