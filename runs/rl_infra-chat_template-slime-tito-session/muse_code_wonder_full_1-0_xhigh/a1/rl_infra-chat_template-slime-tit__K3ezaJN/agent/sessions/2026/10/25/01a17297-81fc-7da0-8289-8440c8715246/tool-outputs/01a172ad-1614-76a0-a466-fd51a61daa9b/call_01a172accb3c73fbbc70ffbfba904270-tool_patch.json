{"files":[{"hunks":[{"lines":["             if constraint is not None:","                 params[\"json_schema\"] = json.dumps(constraint)","         return params","+","+    # -- engine call with disconnect / duplicate watching --------------------","+    @staticmethod","+    def _client_gone(request) -> bool:","+        try:","+            transport = request.transport","+        except Exception:","+            return False","+        try:","+            return transport is None or bool(transport.is_closing())","+        except Exception:","+            return False","+","+    async def _poll_disconnect(self, request):","+        while True:","+            if self._client_gone(request):","+                return True","+            await asyncio.sleep(0.02)","+","+    async def _generate(self, request, abort_event, input_ids, sampling_params, rid):","+        gen_task = asyncio.create_task(self.engine.generate(input_ids, sampling_params, rid=rid))","+        abort_task = asyncio.create_task(abort_event.wait())","+        disc_task = asyncio.create_task(self._poll_disconnect(request))","+        try:","+            done, _ = await asyncio.wait({gen_task, abort_task, disc_task},","+                                         return_when=asyncio.FIRST_COMPLETED)","+            if gen_task in done:","+                return gen_task.result()","+            # The agent gave up (disconnected or already re-sent this request).","+            await self.engine.abort(rid)","+            try:","+                await asyncio.wait_for(asyncio.shield(gen_task), timeout=2.0)","+            except Exception:","+                gen_task.cancel()","+                with contextlib.suppress(BaseException):","+                    await gen_task","+            raise _ClientGone()","+        except asyncio.CancelledError:","+            gen_task.cancel()","+            with contextlib.suppress(BaseException):","+                await asyncio.shield(self.engine.abort(rid))","+            raise","+        finally:","+            for task in (abort_task, disc_task):","+                task.cancel()","+                with contextlib.suppress(BaseException):","+                    await task","+","+    # -- endpoints ------------------------------------------------------------","+    async def chat_completions(self, request: web.Request) -> web.Response:","+        try:","+            body = await request.json()","+        except (json.JSONDecodeError, ValueError):","+            return _error(400, \"request body is not JSON\")","+        if not isinstance(body, dict):","+            return _error(400, \"request body must be a JSON object\")","+        episode_id = request.match_info.get(\"sid\")","+        agent_id = request.headers.get(\"X-Session-ID\") or body.get(\"session_id\") or episode_id","+        if not agent_id:","+            return _error(400, \"no session id (use /s/<session_id>/v1 as base URL)\")","+        agent_id = str(agent_id)","+        episode_id = str(episode_id) if episode_id else agent_id","+        messages = body.get(\"messages\") or []","+        if not messages:","+            return _error(400, \"messages must not be empty\")","+        self.num_requests += 1","+        fingerprint = _fingerprint(body)","+","+        session = self.store.get_agent(agent_id, episode_id)","+        # An identical request arriving while the original is still running means","+        # the agent has given up on the original: stop its generation now.","+        session.abort_inflight_duplicate(fingerprint)","+","+        outputs = []","+        choices = []","+        stream = bool(body.get(\"stream\", False))","+        await session.lock.acquire()","+        inflight_event = None","+        try:","+            group = session.begin_request(fingerprint)","+            validation_error = self._validate_request(body)","+            if validation_error is not None:","+                return validation_error","+            try:","+                rendered = self.renderer.render_request(body)","+            except RequestError as e:","+                return _error(e.status, str(e))","+            except Exception as e:","+                logger.exception(\"session %s: cannot build prompt\", agent_id)","+                return _error(400, f\"cannot apply chat template: {e}\")","+            prep = session.prepare(rendered)","+            input_ids = prep.ids","+            if len(input_ids) >= self.context_length:","+                return _error(","+                    400,","+                    f\"This model's maximum context length is {self.context_length} tokens. However, your messages \"","+                    f\"resulted in {len(input_ids)} tokens. Please reduce the length of the messages.\",","+                )","+            explicit_max = body.get(\"max_completion_tokens\") or body.get(\"max_tokens\")","+            if explicit_max and len(input_ids) + int(explicit_max) >= self.context_length:","+                return _error(","+                    400,","+                    f\"Requested token count exceeds the model's maximum context length of {self.context_length} \"","+                    f\"tokens. You requested a total of {len(input_ids) + int(explicit_max)} tokens: \"","+                    f\"{len(input_ids)} tokens from the input messages and {int(explicit_max)} tokens for the \"","+                    f\"completion. Please reduce the number of tokens in the input messages or the completion.\",","+                )","+            try:","+                n_choices = int(body.get(\"n\") or 1)","+            except (TypeError, ValueError):","+                return _error(400, \"n must be an integer\")","+            if n_choices < 1:","+                return _error(400, \"n must be at least 1\")","+            sampling_params = self._sampling_params(body, rendered, len(input_ids))","+            inflight_event = session.register_inflight(fingerprint)","+            session.mark_prompt_sent(prep)","+            try:","+                for _ in range(n_choices):","+                    out = await self._generate(request, inflight_event, input_ids, sampling_params,","+                                                uuid.uuid4().hex)","+                    if out[\"finish_reason\"] == \"abort\":","+                        return _error(503, \"generation aborted by the engine\", \"InternalServerError\")","+                    outputs.append(out)","+            except _ClientGone:","+                return _error(503, \"client disconnected\", \"InternalServerError\")","+            except Exception as e:","+                logger.exception(\"session %s: engine call failed\", agent_id)","+                return _error(502, f\"engine error: {e}\", \"InternalServerError\")","+            if self._client_gone(request):","+                return _error(503, \"client disconnected\", \"InternalServerError\")","+            for out in outputs:","+                session.add_turn(prep, out[\"output_ids\"], out[\"log_probs\"], out[\"finish_reason\"],","+                                 fingerprint, group, matched=out.get(\"matched_stop\"))","+","+            history_tool_cnt = 0","+            for m in messages:","+                if isinstance(m, dict) and m.get(\"role\") == \"assistant\" and isinstance(m.get(\"tool_calls\"), list):","+                    history_tool_cnt += len(m[\"tool_calls\"])","+            for index, out in enumerate(outputs):","+                message, finish_reason = self.parser.to_message(","+                    input_ids, out[\"output_ids\"], out.get(\"finish_reason_raw\") or out[\"finish_reason\"],","+                    tools=rendered.tools, tool_choice=rendered.tool_choice,","+                    matched_stop=out.get(\"matched_stop\"),","+                    skip_special_tokens=rendered.skip_special_tokens,","+                    spaces_between_special_tokens=rendered.spaces_between_special_tokens,","+                    no_stop_trim=rendered.no_stop_trim,","+                    separate_reasoning=rendered.separate_reasoning,","+                    chat_template_kwargs=rendered.chat_template_kwargs,","+                    continue_final_message=rendered.continue_final_message,","+                    previous_content=rendered.assistant_prefix or \"\",","+                    history_tool_calls_cnt=history_tool_cnt,","+                )","+                choices.append({\"index\": index, \"message\": message, \"finish_reason\": finish_reason,","+                                \"logprobs\": None})","+        finally:","+            session.unregister_inflight(fingerprint, inflight_event) if inflight_event else None","+            if session.lock.locked():","+                session.lock.release()","+","+        completion_tokens = sum(len(o[\"output_ids\"]) for o in outputs)","+        payload = {","+            \"id\": f\"chatcmpl-{uuid.uuid4().hex}\",","+            \"object\": \"chat.completion\",","+            \"created\": int(time.time()),","+            \"model\": body.get(\"model\") or self.served_model_name,","+            \"choices\": choices,","+            \"usage\": {","+                \"prompt_tokens\": len(input_ids),","+                \"completion_tokens\": completion_tokens,","+                \"total_tokens\": len(input_ids) + completion_tokens,","+                \"prompt_tokens_details\": {\"cached_tokens\": outputs[0].get(\"cached_tokens\", 0) if outputs else 0},","+            },","+        }","+        if not stream:","+            return web.json_response(payload)","+        return await self._stream_response(request, payload, body)","+","+    async def _stream_response(self, request, payload, body):","+        resp = web.StreamResponse(status=200, headers={\"Content-Type\": \"text/event-stream\",","+                                                        \"Cache-Control\": \"no-cache\"})","+        await resp.prepare(request)","+        base = {\"id\": payload[\"id\"], \"object\": \"chat.completion.chunk\", \"created\": payload[\"created\"],","+                \"model\": payload[\"model\"]}","+        chunks = [{**base, \"choices\": [{\"index\": c[\"index\"], \"delta\": {\"role\": \"assistant\", \"content\": \"\"},","+                                          \"finish_reason\": None}]} for c in payload[\"choices\"]]","+        for c in payload[\"choices\"]:","+            msg = c[\"message\"]","+            delta = {}","+            if msg.get(\"content\"):","+                delta[\"content\"] = msg[\"content\"]","+            if msg.get(\"reasoning_content\"):","+                delta[\"reasoning_content\"] = msg[\"reasoning_content\"]","+            if msg.get(\"tool_calls\"):","+                delta[\"tool_calls\"] = msg[\"tool_calls\"]","+            chunks.append({**base, \"choices\": [{\"index\": c[\"index\"], \"delta\": delta, \"finish_reason\": None}]})","+            chunks.append({**base, \"choices\": [{\"index\": c[\"index\"], \"delta\": {},","+                                                 \"finish_reason\": c[\"finish_reason\"]}]})","+        if (body.get(\"stream_options\") or {}).get(\"include_usage\"):","+            chunks.append({**base, \"choices\": [], \"usage\": payload[\"usage\"]})","+        try:","+            for chunk in chunks:","+                await resp.write(f\"data: {json.dumps(chunk)}\\n\\n\".encode())","+            await resp.write(b\"data: [DONE]\\n\\n\")","+        except (ConnectionResetError, BrokenPipeError):","+            logger.debug(\"stream client disconnected while writing\")","+        return resp","+","+    async def finish(self, request: web.Request) -> web.Response:","+        sid = request.match_info[\"sid\"]","+        sessions = self.store.sessions_for_episode(sid)","+        async with contextlib.AsyncExitStack() as stack:","+            for session in sessions:","+                await stack.enter_async_context(session.lock)","+            samples = self.store.finish(sid)","+        return web.json_response({\"session_id\": sid, \"samples\": [s.to_dict() for s in samples]})"],"newLines":218,"newStart":239,"oldLines":3,"oldStart":239}],"path":"/app/terminal_rl/terminal_rl/proxy/server.py"}]}