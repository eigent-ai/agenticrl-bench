{"files":[{"hunks":[{"lines":["-\"\"\"Turn engine output ids into an OpenAI chat message (reasoning split + tool calls).","+\"\"\"Turn engine output ids into an OpenAI chat message."," ","-Mirrors what SGLang's reasoning parser (Qwen3Detector, used for the ``<think>`` families) and the GLM-4.7 function-call","-detector return from the chat endpoint, so agents see the same message shape as in our eval runs.","+This mirrors SGLang's chat endpoint (``serving_chat.py``) non-streaming","+path: detokenize with the request's skip-special-tokens / stop-trim","+settings, split reasoning with the configured reasoning detector, then --","+only when the request actually carried tools -- extract tool calls with","+the configured function-call detector."," \"\"\""," ","+import ast"," import json","+import logging"," import re"," import uuid"," ","+logger = logging.getLogger(__name__)","+"," THINK_START = \"<think>\""," THINK_END = \"</think>\"","+_UNSET = object()","+","+","+# ---------------------------------------------------------------------------","+# tool-schema helpers (SGLang function_call/utils.py, glm47 detector)","+# ---------------------------------------------------------------------------","+","+def _tool_name(tool):","+    if isinstance(tool, dict):","+        fn = tool.get(\"function\") or tool","+        return fn.get(\"name\") if isinstance(fn, dict) else None","+    fn = getattr(tool, \"function\", tool)","+    return getattr(fn, \"name\", None)","+","+","+def _tool_params(tool):","+    if isinstance(tool, dict):","+        fn = tool.get(\"function\") or tool","+        return fn.get(\"parameters\") if isinstance(fn, dict) else None","+    fn = getattr(tool, \"function\", tool)","+    return getattr(fn, \"parameters\", None)","+"," ","+def infer_type_from_json_schema(schema):","+    if not isinstance(schema, dict):","+        return None","+    if \"type\" in schema:","+        t = schema[\"type\"]","+        if isinstance(t, str):","+            return t","+        if isinstance(t, list) and t:","+            non_null = [x for x in t if x != \"null\"]","+            return non_null[0] if non_null else \"string\"","+    if \"anyOf\" in schema or \"oneOf\" in schema:","+        types = []","+        for sub in (schema.get(\"anyOf\") or schema.get(\"oneOf\") or []):","+            it = infer_type_from_json_schema(sub)","+            if it:","+                types.append(it)","+        if types:","+            if len(set(types)) == 1:","+                return types[0]","+            return \"string\" if \"string\" in types else types[0]","+    if \"enum\" in schema and isinstance(schema[\"enum\"], list):","+        if not schema[\"enum\"]:","+            return \"string\"","+        kinds = set()","+        for v in schema[\"enum\"]:","+            kinds.add({type(None): \"null\", bool: \"boolean\", int: \"integer\", float: \"number\",","+                       str: \"string\", list: \"array\", dict: \"object\"}.get(type(v), \"string\"))","+        return kinds.pop() if len(kinds) == 1 else \"string\"","+    if \"allOf\" in schema and isinstance(schema[\"allOf\"], list):","+        for sub in schema[\"allOf\"]:","+            it = infer_type_from_json_schema(sub)","+            if it and it != \"string\":","+                return it","+        return \"string\"","+    if \"properties\" in schema:","+        return \"object\"","+    if \"items\" in schema:","+        return \"array\"","+    return None"," ","-class ReasoningParser:","-    def __init__(self, think_start: str = THINK_START, think_end: str = THINK_END):","-        self.think_start = think_start","-        self.think_end = think_end"," ","-    def split(self, text: str, in_reasoning: bool) -> tuple[str | None, str]:","-        if self.think_start in text:","-            in_reasoning = True","-            text = text.replace(self.think_start, \"\", 1)","-        if not in_reasoning:","-            return None, text.strip()","-        if self.think_end not in text:","-            # Still thinking when the output stopped.","-            return text.strip(), \"\"","-        reasoning, content = text.split(self.think_end, 1)","-        return reasoning.strip(), content.strip()","+def get_argument_type(func_name, arg_key, tools):","+    for tool in tools or []:","+        if _tool_name(tool) != func_name:","+            continue","+        params = _tool_params(tool)","+        if not isinstance(params, dict):","+            return None","+        props = params.get(\"properties\")","+        if not isinstance(props, dict):","+            return None","+        spec = props.get(arg_key)","+        if isinstance(spec, dict):","+            return infer_type_from_json_schema(spec)","+        return None","+    return None"," "," ","-class Glm47ToolParser:","-    \"\"\"``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value>...</tool_call>``\"\"\"","+def _convert_to_number(value: str):","+    try:","+        return float(value) if (\".\" in value or \"e\" in value.lower()) else int(value)","+    except (ValueError, AttributeError):","+        return value"," ","-    _call = re.compile(r\"<tool_call>(.*?)</tool_call>\", re.DOTALL)","-    _arg = re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>(.*?)</arg_value>\", re.DOTALL)"," ","-    def parse(self, text: str) -> tuple[str, list[dict]]:","-        if \"<tool_call>\" not in text:","-            return text, []","-        content = text.split(\"<tool_call>\", 1)[0].strip()","-        calls = []","-        for body in self._call.findall(text):","-            name = body.split(\"<arg_key>\", 1)[0].strip()","-            arguments = {}","-            for key, value in self._arg.findall(body):","-                try:","-                    arguments[key.strip()] = json.loads(value)","-                except json.JSONDecodeError:","-                    arguments[key.strip()] = value","-            calls.append(","-                {","-                    \"id\": f\"call_{uuid.uuid4().hex[:24]}\",","+def parse_arguments(json_value: str, arg_type=None):","+    try:","+        parsed = json.loads(json_value)","+        if arg_type == \"number\" and isinstance(parsed, str):","+            parsed = _convert_to_number(parsed)","+        return parsed, True","+    except (json.JSONDecodeError, ValueError):","+        pass","+    try:","+        wrapped = json.loads('{\"tmp\": \"' + json_value + '\"}')","+        parsed = json.loads(wrapped[\"tmp\"])","+        if arg_type == \"number\" and isinstance(parsed, str):","+            parsed = _convert_to_number(parsed)","+        return parsed, True","+    except (json.JSONDecodeError, ValueError, KeyError):","+        pass","+    try:","+        return ast.literal_eval(json_value), True","+    except (ValueError, SyntaxError):","+        pass","+    try:","+        return json.loads(json.dumps(str(json_value))), True","+    except (json.JSONDecodeError, ValueError):","+        return json_value, False","+","+","+def parse_base_json(action, tools):","+    \"\"\"SGLang BaseFormatDetector.parse_base_json. tools=None means unknown (forward all).\"\"\"","+    indices = {}","+    if tools is not None:","+        indices = {name: i for i, name in enumerate(_tool_name(t) for t in tools) if name}","+    if not isinstance(action, list):","+        action = [action]","+    results = []","+    for act in action:","+        if not isinstance(act, dict):","+            continue","+        name = act.get(\"name\")","+        if tools is not None and not (name and name in indices):","+            logger.warning(\"model attempted to call undefined function: %s\", name)","+            continue","+        results.append({\"tool_index\": indices.get(name, -1), \"name\": name,","+                        \"parameters\": json.dumps(act.get(\"parameters\") or act.get(\"arguments\", {}),","+                                                ensure_ascii=False)})","+    return results","+","+","+def _openai_calls(calls, parser_