= False, previous_content: str = \"\"):","+        in_reasoning = force_reasoning","+        if self.think_start in previous_content:","+            in_reasoning = True","+        if self.think_end in previous_content:","+            in_reasoning = False","+        in_reasoning = in_reasoning or self.think_start in text","+        if not in_reasoning:","+            return \"\", text","+        processed = text.replace(self.think_start, \"\").strip()","+        if self.think_end not in processed and self.think_end not in previous_content:","+            return processed, \"\"","+        if self.think_end in processed:","+            reasoning, normal = processed.split(self.think_end, 1)","+            return reasoning, normal.strip()","+        return \"\", processed"," ","-    def starts_in_reasoning(self, prompt_ids: list[int]) -> bool:","-        if self.reasoning is None:","-            return False","-        tail = self.tokenizer.decode(prompt_ids[-8:], skip_special_tokens=False)","-        return tail.rstrip().endswith(self.reasoning.think_start)","+    def split(self, text: str, in_reasoning: bool) -> tuple[str | None, str]:","+        reasoning, normal = self.detect(text, force_reasoning=in_reasoning)","+        return (reasoning if (in_reasoning or reasoning) else None), normal"," ","-    def to_message(self, prompt_ids: list[int], output_ids: list[int], finish_reason: str) -> tuple[dict, str]:","-        ids = output_ids","-        if finish_reason == \"stop\" and ids and ids[-1] in self.special_ids:","-            ids = ids[:-1]","-        text = self.tokenizer.decode(ids, skip_special_tokens=False)","-        reasoning = None","-        if self.reasoning is not None:","-            reasoning, text = self.reasoning.split(text, self.starts_in_reasoning(prompt_ids))","-        tool_calls = []","-        if self.tools is not None:","-            text, tool_calls = self.tools.parse(text)","-        message = {\"role\": \"assistant\", \"content\": text if (te