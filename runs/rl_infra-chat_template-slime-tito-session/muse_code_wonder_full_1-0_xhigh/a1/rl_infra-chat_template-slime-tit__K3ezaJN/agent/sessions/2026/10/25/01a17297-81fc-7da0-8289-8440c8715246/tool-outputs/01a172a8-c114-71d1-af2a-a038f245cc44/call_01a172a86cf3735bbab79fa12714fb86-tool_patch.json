{"files":[{"hunks":[{"lines":["     except Exception:","         logger.debug(\"cannot parse chat template AST; assuming string content format\", exc_info=True)","     return \"string\"","+","+","+@dataclass","+class RenderedPrompt:","+    ids: list[int]                  # fresh SGLang rendering, before token-id splicing","+    text: str                       # the rendered string (plus any continued assistant prefix)","+    messages: list[dict]            # processed messages fed to the template","+    tools: list[dict]               # normalized tools (all of them), [] if none","+    tools_for_template: list[dict] | None","+    tool_choice: object             # \"none\" | \"auto\" | \"required\" | {\"function\": {\"name\": ...}}","+    chat_template_kwargs: dict      # effective kwargs actually passed to the template","+    reasoning_effort: object = \"medium\"","+    assistant_prefix: str | None = None","+    continue_final_message: bool = False","+    separate_reasoning: bool = True","+    skip_special_tokens: bool = True","+    spaces_between_special_tokens: bool = True","+    no_stop_trim: bool = False","+","+","+class MessageRenderer:","+    \"\"\"Renders a chat request to prompt ids exactly as SGLang's chat endpoint does.\"\"\"","+","+    def __init__(self, tokenizer, template_kwargs: dict | None = None):","+        self.tokenizer = tokenizer","+        self.template_kwargs = dict(template_kwargs or {})","+        self._chat_template, template_str = self._resolve_template()","+        self.content_format = detect_content_format(template_str)","+        self.force_reasoning_template = bool(","+            template_str and re.search(r\"<\\|im_start\\|>assistant\\\\n<think>\\\\n\", template_str))","+        self._init_legacy()","+","+    def _resolve_template(self):","+        template = getattr(self.tokenizer, \"chat_template\", None)","+        if isinstance(template, dict):","+            if not template:","+                return None, None","+            # SGLang TemplateManager: first available named template when unspecified.","+            selected = next(iter(template.values()))","+            return selected, selected if isinstance(selected, str) else None","+        if isinstance(template, list):  # newer transformers list-of-dicts form","+            for item in template:","+                if isinstance(item, dict) and isinstance(item.get(\"template\"), str):","+                    if item.get(\"name\") in (None, \"default\"):","+                        return None, item[\"template\"]","+            return None, None","+        return None, template if isinstance(template, str) else None","+","+    # -- low-level template application -----------------------------------","+    def _apply(self, messages, tools=None, add_generation_prompt=False, tokenize=True, extra_kwargs=None):","+        kwargs = dict(extra_kwargs if extra_kwargs is not None else self.template_kwargs)","+        call = dict(tools=tools, tokenize=tokenize, add_generation_prompt=add_generation_prompt,","+                    return_dict=False)","+        if self._chat_template is not None:","+            call[\"chat_template\"] = self._chat_template","+        return self.tokenizer.apply_chat_template(messages, **call, **kwargs)","+","+    def _apply_sglang(self, messages, tools, ctk, reasoning_effort):","+        \"\"\"apply_chat_template with SGLang's arguments and flat-tools fallback. Returns (ids, text).\"\"\"","+        extra = dict(ctk)","+        extra.pop(\"reasoning_effort\", None)","+        attempts = [tools]","+        if tools:","+            attempts.append([t[\"function\"] if isinstance(t, dict) and \"function\" in t else t for t in tools])","+        last_exc = None","+        for cand in attempts:","+            try:","+                ids = self._apply(messages, tools=cand, add_generation_prompt=True, tokenize=True,","+                                  extra_kwargs={\"reasoning_effort\": reasoning_effort, **extra})","+                try:","+                    text = self._apply(messages, tools=cand, add_generation_prompt=True, tokenize=False,","+                                       extra_kwargs={\"reasoning_effort\": reasoning_effort, **extra})","+                except Exception:","+                    text = self.tokenizer.decode(list(ids), skip_special_tokens=False)","+                return list(ids), text if isinstance(text, str) else str(text)","+            except Exception as e:  # SGLang retries with flattened tools, then reports a client error","+                last_exc = e","+                continue","+        raise RequestError(f\"cannot apply chat template: {last_exc}\")","+","+    # -- request rendering -------------------------------------------------","+    def render_request(self, body: dict) -> RenderedPrompt:","+        messages_raw = body.get(\"messages\")","+        if not messages_raw or not isinstance(messages_raw, list):","+            raise RequestError(\"messages must be a non-empty list\")","+","+        # reasoning / reasoning_effort normalization (protocol + _convert_to_internal_request)","+        req_ctk = body.get(\"chat_template_kwargs\")","+        req_ctk = dict(req_ctk) if isinstance(req_ctk, dict) else {}","+        reasoning_effort = body.get(\"reasoning_effort\") or \"medium\"","+        reasoning = body.get(\"reasoning\")","+        if isinstance(reasoning, dict):","+            effort = reasoning.get(\"effort\") or reasoning.get(\"reasoning_effort\")","+            if effort in {\"low\", \"medium\", \"high\"}:","+                reasoning_effort = effort","+            enabled = reasoning.get(\"enabled\") if reasoning.get(\"enabled\") is not None else reasoning.get(\"enable\", False)","+            if isinstance(enabled, str):","+                enabled = enabled.strip().lower() in {\"1\", \"true\", \"yes\", \"y\", \"on\"}","+            if enabled:","+                req_ctk.setdefault(\"thinking\", True)","+        if \"reasoning_effort\" in req_ctk:","+            reasoning_effort = req_ctk.pop(\"reasoning_effort\")","+        cli_kwargs = dict(self.template_kwargs)","+        cli_effort = cli_kwargs.pop(\"reasoning_effort\", None)","+        if cli_effort is not None and not body.get(\"reasoning_effort\") and not isinstance(reasoning, dict):","+            reasoning_effort = cli_effort","+        ctk = {**cli_kwargs, **req_ctk}","+","+        # tools / tool_choice","+        tools_raw = body.get(\"tools\")","+        tools = [dump_tool(t) for t in tools_raw] if tools_raw else []","+        tool_choice = body.get(\"tool_choice\")","+        if tool_choice is None:","+            tool_choice = body.get(\"function_call\")  # legacy OpenAI spelling","+        if tool_choice is None:","+            tool_choice = \"auto\" if tools_raw else \"none\"","+        chosen_name = None","+        if isinstance(tool_choice, dict):","+            fn = tool_choice.get(\"function\") or {}","+            chosen_name = fn.get(\"name\") if isinstance(fn, dict) else None","+            chosen_name = chosen_name or tool_choice.get(\"name\")","+        elif isinstance(tool_choice, str):","+            tool_choice = tool_choice.lower()","+        tools_for_template = None","+        if tools and tool_choice != \"none\":","+            if chosen_name is not None:","+                tools_for_template = [t for t in tools if t[\"function\"][\"name\"] == chosen_name]","+            else:","+                tools_for_template = tools","+","+        # messages","+        processed = []","+        for raw in messages_raw:","+            msg = _dump_message(raw)","+            if msg.get(\"content\") is None:","+                msg[\"content\"] = \"\"","+            pmsg = _process_content(msg, self.content_format)","+            if pmsg.get(\"role\") == \"assistant\" and isinstance(pmsg.get(\"tool_calls\"), list):","+                for item in pmsg[\"tool_calls\"]:","+                    fn = item.get(\"function\") or {}","+                    if isinstance(fn.get(\"arguments\"), str):","+                        try:","+                            fn[\"arguments\"] = json.loads(fn[\"arguments\"])","+                        except json.JSONDecodeError as e:","+                            raise RequestError(f\"invalid tool call arguments JSON: {e}\")","+            processed.append(pmsg)","+","+        # last-assistant-message rule (_handle_last_assistant_message)","+        continue_final = bool(body.get(\"continue_final_message\", False))","+        assistant_prefix = None","+        if processed and processed[-1].get(\"role\") == \"assistant\":","+            last_content = processed[-1].get(\"content\")","+            if isinstance(last_content, str):","+                if continue_final:","+                    assistant_prefix = last_content","+                    processed = processed[:-1]","+                else:","+                    processed[-1] = {\"role\": \"user\", \"content\": last_content}","+","+        ids, text = self._apply_sglang(processed, tools_for_template, ctk, reasoning_effort)","+        if assistant_prefix:","+            encoded = list(self.tokenizer.encode(assistant_prefix))","+            bos = getattr(self.tokenizer, \"bos_token_id\", None)","+            if encoded and bos is not None and encoded[0] == bos:","+                encoded = encoded[1:]","+            ids = ids + encoded","+            text = text + assistant_prefix","+","+        skip_special = bool(body.get(\"skip_special_tokens\", True))","+        if tools_for_template:","+            skip_special = False","+        return RenderedPrompt(","+            ids=ids, text=text, messages=processed, tools=tools,","+            tools_for_template=tools_for_template, tool_choice=tool_choice,","+            chat_template_kwargs=ctk, reasoning_effort=reasoning_effort,","+            assistant_prefix=assistant_prefix, continue_final_message=continue_final,","+            separate_reasoning=bool(body.get(\"separate_reasoning\", True)),","+            skip_special_tokens=skip_special,","+            spaces_between_special_tokens=bool(ctk.get(\"spaces_between_special_tokens\", True)) if ctk else True,","+            no_stop_trim=bool(body.get(\"no_stop_trim\", False)),","+        )","+","+    def conversation(self, messages: list[dict], tools: list[dict] | None = None) -> list[int]:","+        return list(self.render_request({\"messages\": messages, \"tools\": tools}).ids)","+","+    # -- legacy per-message helpers (kept for compatibility, unused by the proxy) --","+    def _init_legacy(self):","+        self._probe_ids: list[int] = []","+        self.generation_prompt_ids: list[int] = []","+        self.turn_end_ids: list[int] = []","+        self.role_header_ids: set[int] = set()","+        try:","+            self._probe_ids = list(self._apply([_PROBE], extra_kwargs=dict(self.template_kwargs)))","+            self.generation_prompt_ids = list(","+                self._apply([_PROBE], add_generation_prompt=True, extra_kwargs=dict(self.template_kwargs))","+            )[len(self._probe_ids):]","+            self.turn_end_ids = self._assistant_turn_end()","+            self.role_header_ids = self._role_headers()","+        except Exception:","+            logger.debug(\"legacy per-message rendering unavailable for this template\", exc_info=True)","+","+    def message(self, message: dict) -> list[int]:","+        ids = list(self._apply([_PROBE, message], extra_kwargs=dict(self.template_kwargs)))","+        if ids[: len(self._probe_ids)] != self._probe_ids:","+            raise ValueError(f\"cannot render a {message.get('role')} message on its own\")","+        return ids[len(self._probe_ids):]","+","+    def _assistant_turn_end(self) -> list[int]:","+        marker = \"§§END§§\"","+        ids = self.message({\"role\": \"assistant\", \"content\": marker})","+        text = self.tokenizer.decode(ids, skip_special_tokens=False)","+        tail = text.split(marker, 1)[1] if marker in text else \"\"","+        return list(self.tokenizer.encode(tail, add_special_tokens=False)) if tail else []","+","+    def _role_headers(self) -> set[int]:","+        headers = set()","+        for role in (\"user\", \"system\"):","+            try:","+                ids = self.message({\"role\": role, \"content\": \"x\"})","+            except Exception:","+                continue","+            if ids and ids[0] in self.tokenizer.all_special_ids:","+                headers.add(ids[0])","+        return headers","+","+    def close_turn(self, output_ids: list[int]) -> tuple[list[int], list[int]]:","+        if output_ids and output_ids[-1] in self.role_header_ids:","+            return output_ids[:-1], []","+        if output_ids and self.turn_end_ids and output_ids[-1] == self.turn_end_ids[0]:","+            return output_ids, self.turn_end_ids[1:]","+        return output_ids, []"],"newLines":234,"newStart":213,"oldLines":3,"oldStart":213}],"path":"/app/terminal_rl/terminal_rl/proxy/session.py"}]}