rn headers","+            if ids not in outs:","+                outs.append(ids)","+        return outs","+","+    # -- message normalization --------------------------------------------","+    def _dump_content_part(self, chunk):","+        if isinstance(chunk, str) or not isinstance(chunk, dict):","+            return copy.deepcopy(chunk)","+        typ = chunk.get(\"type\")","+        if typ == \"text\":","+            return {\"type\": \"text\", \"text\": chunk.get(\"text\", \"\")}","+        if typ == \"image_url\":","+            obj = chunk.get(\"image_url\") if isinstance(chunk.get(\"image_url\"), dict) else {}","+            return {\"type\": \"image_url\",","+                    \"image_url\": {\"url\": obj.get(\"url\"), \"detail\": obj.get(\"detail\", \"auto\"),","+                                  \"max_dynamic_patch\": obj.get(\"max_dynamic_patch\"),","+                                  \"min_dynamic_patch\": obj.get(\"min_dynamic_patch\")},","+                    \"modalities\": chunk.get(\"modalities\", \"image\")}","+        if typ == \"video_url\":","+            obj = chunk.get(\"video_url\") if isinstance(chunk.get(\"video_url\"), dict) else {}","+            return {\"type\": \"video_url\",","+                    \"video_url\": {\"url\": obj.get(\"url\"), \"max_dynamic_patch\": obj.get(\"max_dynamic_patch\"),","+                                  \"min_dynamic_patch\": obj.get(\"min_dynamic_patch\")}}","+        if typ == \"audio_url\":","+            obj = chunk.get(\"audio_url\") if isinstance(chunk.get(\"audio_url\"), dict) else {}","+            return {\"type\": \"audio_url\", \"audio_url\": {\"url\": obj.get(\"url\")}}","+        return copy.deepcopy(chunk)","+","+    def _dump_tool_call(self, item):","+        if not isinstance(item, dict):","+            return copy.deepcopy(item)","+        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else None","+        if fn is None:","+            fn = {\"name\": item.get(\