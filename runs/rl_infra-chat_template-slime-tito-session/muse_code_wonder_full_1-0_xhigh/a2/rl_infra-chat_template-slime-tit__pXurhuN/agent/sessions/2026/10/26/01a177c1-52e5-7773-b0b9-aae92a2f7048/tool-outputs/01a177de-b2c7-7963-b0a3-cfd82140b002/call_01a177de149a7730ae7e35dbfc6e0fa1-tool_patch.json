,"+        except Exception:","+            env = jinja2.Environment()","+        ast = env.parse(template)","+    except Exception:","+        return \"string\"","+","+    def is_var(node, varname):","+        return isinstance(node, jinja2.nodes.Name) and node.ctx == \"load\" and node.name == varname","+","+    def is_attr(node, varname, key):","+        if isinstance(node, jinja2.nodes.Getitem):","+            return (is_var(node.node, varname) and isinstance(node.arg, jinja2.nodes.Const)","+                    and node.arg.value == key)","+        if isinstance(node, jinja2.nodes.Getattr):","+            return is_var(node.node, varname) and node.attr == key","+        return False","+","+    def is_var_or_elems(node, varname, key=None):","+        if isinstance(node, (jinja2.nodes.Filter, jinja2.nodes.Test)):","+            return node.node is not None and is_var_or_elems(node.node, varname, key)","+        if isinstance(node, jinja2.nodes.Getitem) and isinstance(node.arg, jinja2.nodes.Slice):","+            return is_var_or_elems(node.node, varname, key)","+        return is_attr(node, varname, key) if key else is_var(node, varname)","+","+    try:","+        for loop in ast.find_all(jinja2.nodes.For):","+            for varname in (\"message\", \"msg\", \"m\"):","+                if is_var_or_elems(loop.iter, varname, \"content\"):","+                    return \"openai\"","+    except Exception:","+        pass","+    return \"string\"","+","+","+@dataclass","+class RenderedRequest:","+    text: str","+    canonical_ids: list","+    offsets: list | None","+    tools: list | None","+    tool_choice: object","+    template_kwargs: dict","+    separate_reasoning: bool = True","+    skip_special_tokens: bool = True","+    spaces_between_special_tokens: bool = True","+    no_stop_trim: bool = False","+    continue_final_message: bool = False","+    assistant_prefix: str | None = None","+","+    @property","+    def offset_starts(self):","+        return [o[0] for