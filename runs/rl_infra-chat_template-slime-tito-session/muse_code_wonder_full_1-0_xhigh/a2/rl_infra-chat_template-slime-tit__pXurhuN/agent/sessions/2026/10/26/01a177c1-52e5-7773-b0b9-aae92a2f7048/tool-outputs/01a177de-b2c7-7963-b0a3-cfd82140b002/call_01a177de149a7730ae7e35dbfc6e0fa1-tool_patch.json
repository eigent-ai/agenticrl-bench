{"files":[{"hunks":[{"lines":["-\"\"\"Per-session token bookkeeping.","+\"\"\"Per-agent token bookkeeping and SGLang-compatible prompt rendering.","+","+Rendering mirrors SGLang 0.5.9's OpenAI chat path for HF Jinja templates","+(``serving_chat._apply_jinja_template``): pydantic-style normalization of","+messages/tools, content-format handling, tool-call argument conversion,","+``continue_final_message`` handling, and per-request chat-template kwargs.","+The rendered string is the only prompt specification: every engine prompt we","+send decodes to it exactly."," ","-A session is one agent episode. We keep the token ids exactly as the engine saw and produced them and append each","-turn to the same buffer, so the model's own outputs are never re-tokenized and the episode comes out as a single","-slime ``Sample`` (prompt = first request, response = everything after it, loss only on generated tokens).","+Bookkeeping never assumes turns append.  Each delivered generation is","+recorded against the exact prompt ids sent for it.  A generation extends an","+existing training sample only when the prompt actually sent for it begins","+(token-for-token) with that sample's token sequence; otherwise it starts a","+new sample.  To make extension possible wherever the conversation allows","+it, a new prompt whose rendered text starts with an earlier prompt or","+prompt+generation of the same agent reuses those exact token ids for the","+shared prefix instead of re-tokenizing it."," \"\"\""," "," import asyncio","+import bisect","+import copy","+import json"," import logging","+import re"," import time","+from dataclasses import dataclass, field"," "," from slime.utils.types import Sample"," "," logger = logging.getLogger(__name__)"," ","-# Same probe message slime's MultiTurnLossMaskGenerator uses to cut single messages out of a rendered conversation.","-_PROBE = {\"role\": \"user\", \"content\": \"FOR CALCULATING LOSS MASK ONLY\"}"," ","+class RequestError(ValueError):","+    \"\"\"A client error (400), as SGLang's chat endpoint would return.\"\"\"","+","+","+# ---------------------------------------------------------------------------","+# SGLang-style request normalization helpers","+# ---------------------------------------------------------------------------","+","+_GENERIC_ROLES = {\"system\", \"assistant\", \"tool\", \"function\", \"developer\"}","+_GENERIC_FIELDS = (\"tool_call_id\", \"name\", \"reasoning_content\", \"tool_calls\", \"tools\")","+","+","+def _normalize_tool(raw, index):","+    if not isinstance(raw, dict):","+        raise RequestError(f\"tool {index} is not an object\")","+    fn = raw.get(\"function\")","+    if not isinstance(fn, dict):","+        if \"name\" in raw:  # flat form some clients use","+            fn = raw","+        else:","+            raise RequestError(f\"tool {index} has no function definition\")","+    name = fn.get(\"name\")","+    if not isinstance(name, str) or not name:","+        raise RequestError(f\"tool {index} function has no name\")","+    params = copy.deepcopy(fn.get(\"parameters\"))","+    if isinstance(params, dict):","+        try:","+            from jsonschema import Draft202012Validator, SchemaError","+","+            try:","+                Draft202012Validator.check_schema(params)","+            except SchemaError as e:","+                raise RequestError(f\"Tool {index} function has invalid 'parameters' schema: {e}\")","+        except ImportError:","+            pass","+    # Field order matches SGLang's pydantic model_dump() of Tool/Function.","+    return {","+        \"type\": raw.get(\"type\", \"function\"),","+        \"function\": {","+            \"description\": copy.deepcopy(fn.get(\"description\")),","+            \"name\": name,","+            \"parameters\": params,","+            \"strict\": bool(fn.get(\"strict\", False)),","+        },","+    }","+","+","+def normalize_tools(raw):","+    if raw is None:","+        return None","+    if not isinstance(raw,