 content, calls","+        try:","+            for match_result in re.findall(self._call_re, text, re.DOTALL):","+                detail = self._detail.search(match_result)","+                if detail is None:","+                    continue","+                func_name = detail.group(1) or \"\"","+                func_args = detail.group(2) or \"\"","+                arguments = self._parse_pairs(self._arg.findall(func_args), func_name, tools) if func_args else {}","+                if tools is not None and func_name not in tool_indices:","+                    continue","+                calls.append({\"tool_index\": tool_indices.get(func_name, -1), \"name\": func_name,","+                              \"arguments\": json.dumps(arguments, ensure_ascii=False)})","+            return normal_text, calls","+        except Exception:","+            return text, []","+","+    def parse(self, text, tools=None):","+        if self.bot_token not in text:","+            return text, []","+        normal, items = self.detect_and_parse(text, tools)","+        if not items:","+            return text, []","+        calls = [{\"id\": f\"call_{uuid.uuid4().hex[:24]}\", \"index\": it[\"tool_index\"], \"type\": \"function\",","+                  \"function\": {\"name\": it[\"name\"], \"arguments\": it[\"arguments\"]}} for it in items]","+        return normal, calls"," "," "," TOOL_PARSERS = {\"glm47\": Glm47ToolParser, \"none\": None}"," REASONING_PARSERS = {\"think\": ReasoningParser, \"none\": None}"," ","+_FORCE_REASONING_RE = re.compile(r\"<\\|im_start\\|>assistant\\\\n<think>\\\\n\")","+"," "," class OutputParser:","     def __init__(self, tokenizer, reasoning_parser: str = \"think\", tool_call_parser: str = \"none\"):"],"newLines":216,"newStart":15,"oldLines":55,"oldStart":13},{"lines":["         tool_cls = TOOL_PARSERS[tool_call_parser]","         self.tools = tool_cls() if tool_cls else None","         self.special_ids = set(tokenizer.all_special_ids)","+        tmpl = ge