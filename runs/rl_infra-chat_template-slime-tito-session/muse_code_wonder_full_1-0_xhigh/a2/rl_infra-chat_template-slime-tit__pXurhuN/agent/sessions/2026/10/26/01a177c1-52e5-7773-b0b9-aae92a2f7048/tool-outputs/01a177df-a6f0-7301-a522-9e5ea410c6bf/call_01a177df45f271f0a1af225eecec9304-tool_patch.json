     kinds.add(\"string\")","+            elif isinstance(v, list):","+                kinds.add(\"array\")","+            elif isinstance(v, dict):","+                kinds.add(\"object\")","+        return kinds.pop() if len(kinds) == 1 else \"string\"","+    if \"allOf\" in schema and isinstance(schema[\"allOf\"], list):","+        for sub in schema[\"allOf\"]:","+            inferred = _infer_type_from_json_schema(sub)","+            if inferred and inferred != \"string\":","+                return inferred","+        return \"string\"","+    if \"properties\" in schema:","+        return \"object\"","+    if \"items\" in schema:","+        return \"array\"","+    return None"," "," ","+def _get_argument_type(func_name, arg_key, tools):","+    for tool in tools or []:","+        fn = tool.get(\"function\") if isinstance(tool, dict) else None","+        if not isinstance(fn, dict) or fn.get(\"name\") != func_name:","+            continue","+        params = fn.get(\"parameters\")","+        if not isinstance(params, dict):","+            return None","+        props = params.get(\"properties\")","+        if not isinstance(props, dict):","+            return None","+        spec = props.get(arg_key)","+        if isinstance(spec, dict):","+            return _infer_type_from_json_schema(spec)","+        return None","+    return None","+","+","+def _convert_to_number(value):","+    try:","+        return float(value) if (\".\" in value or \"e\" in value.lower()) else int(value)","+    except (ValueError, AttributeError):","+        return value","+","+","+def _parse_argument_value(json_value, arg_type=None):","+    try:","+        parsed = json.loads(json_value)","+        if arg_type == \"number\" and isinstance(parsed, str):","+            parsed = _convert_to_number(parsed)","+        return parsed, True","+    except (json.JSONDecodeError, ValueError):","+        pass","+    try:","+        wrapped = json.loads('{\"tmp\": \"' + json_value + '\"}')","+        parsed = json.loads(wrapped[\"tmp\"])","+        if arg_type == \"number\" and isinstance(parsed, str):","+            parsed = _convert_to_number(parsed)","+        return parsed, True","+    except (json.JSONDecodeError, ValueError, KeyError):","+        pass","+    try:","+        return ast.literal_eval(json_value), True","+    except (ValueError, SyntaxError, MemoryError, RecursionError):","+        pass","+    try:","+        return json.loads(json.dumps(str(json_value))), True","+    except (json.JSONDecodeError, ValueError):","+        return json_value, False","+","+"," class Glm47ToolParser:","-    \"\"\"``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value>...</tool_call>``\"\"\"","+    \"\"\"SGLang Glm47MoeDetector.detect_and_parse (non-streaming).\"\"\"","+","+    bot_token = \"<tool_call>\"","+    _call_re = r\"<tool_call>.*?</tool_call>\"","+    _detail = re.compile(r\"<tool_call>(.*?)(<arg_key>.*?)?</tool_call>\", re.DOTALL)","+    _arg = re.compile(r\"<arg_key>(.*?)</arg_key>(?:\\n|\\s)*<arg_value>(.*?)</arg_value>\", re.DOTALL)","+","+    def has_tool_call(self, text: str) -> bool:","+        return self.bot_token in text"," ","-    _call = re.compile(r\"<tool_call>(.*?)</tool_call>\", re.DOTALL)","-    _arg = re.compile(r\"<arg_key>(.*?)</arg_key>\\s*<arg_value>(.*?)</arg_value>\", re.DOTALL)","+    def _parse_pairs(self, pairs, func_name, tools):","+        arguments = {}","+        for arg_key, arg_value in pairs:","+            arg_key = arg_key.strip()","+            arg_value = arg_value.strip()","+            arg_type = _get_argument_type(func_name, arg_key, tools)","+            parsed, good = _parse_argument_value(arg_value, arg_type)","+            if arg_type == \"string\":","+                if isinstance(parsed, str):","+                    arguments[arg_key] = parsed","+                elif isinstance(parsed, (dict, list)):","+                    arguments[arg_key] = json.dumps(parsed, ensure_ascii=False)","+                els