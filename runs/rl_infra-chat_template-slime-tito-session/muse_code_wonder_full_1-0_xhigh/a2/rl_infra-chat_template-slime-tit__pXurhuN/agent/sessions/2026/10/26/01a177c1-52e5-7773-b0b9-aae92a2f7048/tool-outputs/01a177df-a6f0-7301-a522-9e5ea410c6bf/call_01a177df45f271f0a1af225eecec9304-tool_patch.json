{"files":[{"hunks":[{"lines":["-\"\"\"Turn engine output ids into an OpenAI chat message (reasoning split + tool calls).","-","-Mirrors what SGLang's reasoning parser (Qwen3Detector, used for the ``<think>`` families) and the GLM-4.7 function-call","-detector return from the chat endpoint, so agents see the same message shape as in our eval runs.","+\"\"\"Turn engine output ids into an OpenAI chat message, as SGLang's chat","+endpoint would: detokenize with stop trimming, split reasoning with the","+``<think>`` detector SGLang uses for the Qwen3/GLM families, and parse","+GLM-4.7 tool calls with SGLang's detector semantics (schema-typed argument","+coercion, unknown-tool filtering, normal text around calls preserved)."," \"\"\""," ","+import ast"," import json"," import re"," import uuid"],"newLines":11,"newStart":1,"oldLines":9,"oldStart":1},{"lines":[" "," "," class ReasoningParser:","+    \"\"\"SGLang BaseReasoningFormatDetector.detect_and_parse.\"\"\"","+","     def __init__(self, think_start: str = THINK_START, think_end: str = THINK_END):","         self.think_start = think_start","         self.think_end = think_end"," ","-    def split(self, text: str, in_reasoning: bool) -> tuple[str | None, str]:","-        if self.think_start in text:","-            in_reasoning = True","-            text = text.replace(self.think_start, \"\", 1)","+    def split(self, text: str, in_reasoning: bool, previous_content: str = \"\"):","+        in_reasoning = in_reasoning or self.think_start in text","+        if previous_content:","+            if self.think_start in previous_content:","+                in_reasoning = True","+            if self.think_end in previous_content:","+                in_reasoning = False","         if not in_reasoning:","-            return None, text.strip()","-        if self.think_end not in text:","-            # Still thinking when the output stopped.","-            return text.strip(), \"\"","-        reasoning, content = text.split(self.thi