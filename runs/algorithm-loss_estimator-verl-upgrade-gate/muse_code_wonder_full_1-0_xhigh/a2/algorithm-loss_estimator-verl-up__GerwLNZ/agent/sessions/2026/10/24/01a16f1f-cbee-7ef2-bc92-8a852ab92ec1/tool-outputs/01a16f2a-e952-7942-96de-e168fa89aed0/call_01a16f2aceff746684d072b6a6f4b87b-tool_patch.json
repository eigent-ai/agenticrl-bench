{"files":[{"hunks":[{"lines":["+import sys, re, json; sys.path.insert(0,\"/opt/verl\")","+from hydra import compose, initialize_config_dir","+from omegaconf import OmegaConf","+","+def parse_recipe(name):","+    # crude: extract key=value tokens from common.sh COMMON_ARGS and recipe file","+    toks=[]","+    for path in [\"/app/recipes/common.sh\", f\"/app/recipes/{name}.sh\"]:","+        txt=open(path).read()","+        # remove quotes around '${...}' and '[\"console\"...]'","+        for m in re.finditer(r\"(\\+?[A-Za-z_][\\w.]*=(?:'[^']*'|[^\\s\\\\]+))\", txt):","+            t=m.group(1)","+            toks.append(t)","+    out=[]","+    for t in toks:","+        t=t.replace(\"$MODEL\",\"/models/Qwen3.5-2B\")","+        t=t.strip(\"'\")","+        # handle 'key=${...}' already unquoted","+        k,_,v=t.partition(\"=\")","+        v=v.strip(\"'\")","+        out.append(f\"{k}={v}\")","+    return out","+","+names=[\"sql_bypass_is\",\"sql_dapo\",\"sql_drgrpo\",\"sql_grpo_compact\",\"sql_grpo_kl\",\"sql_gspo\",\"sql_opd_teacher\",\"sql_ppo\",\"sql_rpp\"]","+for n in names:","+    ov=parse_recipe(n)","+    print(n, len(ov), ov)","+    break","+","+with initialize_config_dir(config_dir=\"/opt/verl/verl/trainer/config\", version_base=None):","+    cfg=compose(config_name=\"ppo_trainer\", overrides=parse_recipe(\"sql_ppo\"))","+    print(\"actor optim\", OmegaConf.to_container(cfg.actor_rollout_ref.actor.optim))","+    print(\"actor engine keys\", list(cfg.actor_rollout_ref.actor.engine.keys()) if \"engine\" in cfg.actor_rollout_ref.actor else None)","+    try:","+        print(\"engine optim\", OmegaConf.to_container(cfg.actor_rollout_ref.actor.engine.optim))","+    except Exception as e: print(\"no engine optim\", e)","+    print(\"actor grad_clip?\", cfg.actor_rollout_ref.actor.get(\"grad_clip\"))","+    print(\"critic grad_clip?\", cfg.critic.get(\"grad_clip\"))","+    print(\"critic optim\", OmegaConf.to_container(cfg.critic.optim))","+    d=OmegaConf.to_container(cfg, resolve=True)","+    def walk(d,p=\"\"):","+        if isinstance(d,dict):","+            for k,v in d.items(): walk(v,p+\".\"+k if p else k)","+        elif any(s in p for s in [\"beta\",\"eps\",\"adam\",\"weight_decay\",\"grad_clip\",\"clip_grad\"]):","+            print(p,\"=\",d)","+    walk(d)"],"newLines":46,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/gen_cfg.py"}]}