{"files":[{"hunks":[{"lines":["+import sys; sys.path.insert(0,\"/opt/verl\")","+import torch","+from hydra import compose, initialize_config_dir","+from verl.utils.config import omega_conf_to_dataclass","+with initialize_config_dir(config_dir=\"/opt/verl/verl/trainer/config\", version_base=None):","+    cfg = compose(config_name=\"ppo_trainer\", overrides=[\"actor_rollout_ref.model.path=/models/x\",\"actor_rollout_ref.rollout.n=4\",\"actor_rollout_ref.actor.use_dynamic_bsz=True\"])","+actor_cfg = omega_conf_to_dataclass(cfg.actor_rollout_ref.actor)","+print(type(actor_cfg).__name__, actor_cfg.clip_ratio, actor_cfg.policy_loss.loss_mode, actor_cfg.strategy, flush=True)","+from tensordict import TensorDict","+from verl.utils import tensordict_utils as tu","+def nest(rows): return torch.nested.as_nested_tensor(rows, layout=torch.jagged)","+data = TensorDict({","+ \"prompts\": nest([torch.tensor([1,2]), torch.tensor([3])]),","+ \"responses\": nest([torch.tensor([4,5,6]), torch.tensor([7,8])]),","+ \"response_mask\": nest([torch.tensor([1,0,1]), torch.tensor([1,1])]),","+ \"old_log_probs\": nest([torch.tensor([-0.1,-0.2,-0.3]), torch.tensor([-0.4,-0.5])]),","+ \"advantages\": nest([torch.tensor([1.,1.,1.]), torch.tensor([-1.,-1.])]),","+}, batch_size=2)","+tu.assign_non_tensor(data, dp_size=1, batch_num_tokens=4, global_batch_size=2)","+full = nest([torch.tensor([0.,-0.15,-0.25,-0.35,0.]), torch.tensor([-0.45,-0.55,0.])])","+fullv = full.values().clone().requires_grad_(True)","+lp = torch.nested.nested_tensor_from_jagged(fullv, offsets=full.offsets())","+from verl.workers.utils.losses import ppo_loss","+loss, metrics = ppo_loss(actor_cfg, {\"log_probs\": lp}, data)","+print(\"loss\", float(loss), flush=True)","+loss.backward()","+print(\"grad\", fullv.grad, flush=True)","+critic_cfg = omega_conf_to_dataclass(cfg.critic)","+print(\"critic\", type(critic_cfg).__name__, critic_cfg.cliprange_value, flush=True)","+data2 = TensorDict({","+ \"prompts\": nest([torch.tensor([1,2]), torch.tensor([3])]),","+ \"responses\": nest([torch.tensor([4,5,6]), torch.tensor([7,8])]),","+ \"response_mask\": nest([torch.tensor([1,0,1]), torch.tensor([1,1])]),","+ \"values\": nest([torch.tensor([0.1,0.2,0.3]), torch.tensor([0.4,0.5])]),","+ \"returns\": nest([torch.tensor([1.,1.,1.]), torch.tensor([-1.,-1.])]),","+}, batch_size=2)","+tu.assign_non_tensor(data2, dp_size=1, batch_num_tokens=4, global_batch_size=2)","+vfull = nest([torch.tensor([0.,0.15,0.25,0.35,0.]), torch.tensor([0.45,0.55,0.])])","+vv = vfull.values().clone().requires_grad_(True)","+from verl.workers.utils.losses import value_loss","+vloss, vm = value_loss(critic_cfg, {\"values\": torch.nested.nested_tensor_from_jagged(vv, offsets=vfull.offsets())}, data2)","+print(\"vloss\", float(vloss), flush=True); vloss.backward(); print(\"vgrad\", vv.grad, flush=True)","+# distillation","+dcfg = omega_conf_to_dataclass(cfg.distillation)","+print(\"distill cfg ok\", dcfg.distillation_loss.loss_mode, dcfg.distillation_loss.loss_max_clamp, flush=True)"],"newLines":45,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/proto.py"}]}