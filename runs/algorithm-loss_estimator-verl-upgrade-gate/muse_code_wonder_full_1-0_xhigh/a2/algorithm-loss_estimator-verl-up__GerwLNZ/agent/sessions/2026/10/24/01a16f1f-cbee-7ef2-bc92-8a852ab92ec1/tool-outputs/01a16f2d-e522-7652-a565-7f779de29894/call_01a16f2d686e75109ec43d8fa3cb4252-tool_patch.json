{"files":[{"hunks":[{"lines":["     \"sql_ppo\": [\"algorithm.adv_estimator=gae\", \"algorithm.gamma=1.0\", \"algorithm.lam=0.95\", \"actor_rollout_ref.actor.loss_agg_mode=token-mean\", \"actor_rollout_ref.actor.use_kl_loss=False\", \"actor_rollout_ref.actor.entropy_coeff=0\", \"critic.model.path=/models/Qwen3.5-2B\", \"critic.optim.lr=5e-6\", \"critic.ppo_mini_batch_size=4\", \"critic.use_dynamic_bsz=True\", \"critic.ppo_max_token_len_per_gpu=32768\", \"critic.cliprange_value=0.5\", \"critic.loss_agg_mode=token-mean\", \"trainer.experiment_name=sql_ppo\"],","     \"sql_rpp\": [\"algorithm.adv_estimator=reinforce_plus_plus\", \"algorithm.gamma=1.0\", \"actor_rollout_ref.actor.loss_agg_mode=token-mean\", \"actor_rollout_ref.actor.use_kl_loss=True\", \"actor_rollout_ref.actor.kl_loss_coef=0.001\", \"actor_rollout_ref.actor.kl_loss_type=low_var_kl\", \"actor_rollout_ref.actor.entropy_coeff=0.001\", \"trainer.experiment_name=sql_rpp\"],"," }","+","+","+# ---------------------------------------------------------------------------","+# Independent reference implementation of the 0.9.1 semantics (torch only).","+# ---------------------------------------------------------------------------","+","+import torch","+","+","+def r_masked_sum(v, m, axis=None):","+    valid = torch.where(m.bool(), v, torch.zeros((), dtype=v.dtype))","+    return (valid * m).sum(dim=axis)","+","+","+def r_masked_mean(v, m, axis=None):","+    return r_masked_sum(v, m, axis) / (m.sum(dim=axis) + 1e-8)","+","+","+def r_masked_whiten(v, m):","+    mean = r_masked_mean(v, m)","+    var = r_masked_mean((v - mean) ** 2, m)","+    ms = m.sum()","+    var = var * (ms / (ms - 1))  # Bessel correction","+    return (v - mean) * torch.rsqrt(var + 1e-8)","+","+","+def r_agg(loss_mat, mask, mode, dp_size=1, batch_num_tokens=None,","+          global_batch_size=None, loss_scale_factor=None):","+    if mode == \"token-mean\":","+        if batch_num_tokens is None:","+            batch_num_tokens = mask.sum()","+        return r_masked_sum(loss_mat, mask) / batch_num_tokens * dp_size","+    if mode in (\"seq-mean-token-sum\", \"seq-mean-token-sum-norm\"):","+        seq_losses = torch.sum(loss_mat * mask, dim=-1)","+        seq_mask = (torch.sum(mask, dim=-1) > 0).float()","+        if global_batch_size is None:","+            global_batch_size = seq_mask.sum()","+        loss = r_masked_sum(seq_losses, seq_mask) / global_batch_size * dp_size","+        if mode == \"seq-mean-token-sum-norm\":","+            if loss_scale_factor is None:","+                loss_scale_factor = mask.shape[-1]","+            loss = loss / loss_scale_factor","+        return loss","+    if mode == \"seq-mean-token-mean\":","+        cnt = torch.sum(mask, dim=-1)","+        seq_losses = torch.sum(loss_mat * mask, dim=-1) / (cnt + 1e-8)","+        seq_mask = (cnt > 0).float()","+        if global_batch_size is None:","+            global_batch_size = seq_mask.sum()","+        return r_masked_sum(seq_losses, seq_mask) / global_batch_size * dp_size","+    raise ValueError(mode)","+","+","+def _gbi(spec_gbi):","+    return dict(dp_size=spec_gbi.get(\"dp_size\", 1),","+                batch_num_tokens=spec_gbi.get(\"batch_num_tokens\"),","+                global_batch_size=spec_gbi.get(\"global_batch_size\"),","+                loss_scale_factor=spec_gbi.get(\"loss_scale_factor\"))","+","+","+def r_kl_lowvar(logp, ref):","+    kl = torch.clamp(ref - logp, min=-20, max=20)","+    ratio = torch.exp(kl)","+    return torch.clamp((ratio - kl - 1).contiguous(), min=-10, max=10)","+","+","+def r_vanilla_pg(old, cur, adv, mask, agg, clip_low, clip_high, clip_c, gbi,","+                 is_weights=None):","+    nkl = torch.clamp(cur - old, min=-20.0, max=20.0)","+    ratio = torch.exp(nkl)","+    pg1 = -adv * ratio","+    pg2 = -adv * torch.clamp(ratio, 1 - clip_low, 1 + clip_high)","+    clip1 = torch.maximum(pg1, pg2)","+    pg3 = -adv * clip_c","+    clip2 = torch.min(pg3, clip1)","+    pg = torch.where(adv < 0, clip2, clip1)","+    if is_weights is not None:","+        pg = pg * is_weights","+    return r_agg(pg, mask, agg, **gbi)","+","+","+def r_gspo_pg(old, cur, adv, mask, agg, clip_low, clip_high, gbi,","+              is_weights=None):","+    nkl = cur - old","+    seq_len = torch.sum(mask, dim=-1).clamp(min=1)","+    nkl_seq = torch.sum(nkl * mask, dim=-1) / seq_len","+    log_ratio = cur - cur.detach() + nkl_seq.detach().unsqueeze(-1)","+    log_ratio = torch.clamp(log_ratio, max=10.0)","+    ratio = torch.exp(log_ratio)","+    pg1 = -adv * ratio","+    pg2 = -adv * torch.clamp(ratio, 1 - clip_low, 1 + clip_high)","+    pg = torch.maximum(pg1, pg2)","+    if is_weights is not None:","+        pg = pg * is_weights","+    return r_agg(pg, mask, agg, **gbi)","+","+","+def r_reinforce_pg(cur, adv, mask, agg, gbi, is_weights=None):","+    if is_weights is not None:","+        pg = -adv * cur * is_weights","+    else:","+        pg = -adv * cur","+    return r_agg(pg, mask, agg, **gbi)","+","+","+def r_is_weights_token(log_ratio, mask, threshold, batch_normalize=False):","+    \"\"\"Rollout IS at token level. threshold float -> TIS; 'lo_hi' -> IcePop.\"\"\"","+    if isinstance(threshold, str) and \"_\" in threshold:","+        lo, hi = (float(x) for x in threshold.split(\"_\", 1))","+        icepop = True","+    else:","+        hi, lo, icepop = float(threshold), None, False","+    raw = torch.exp(torch.clamp(log_ratio, min=-20.0, max=20.0)) * mask","+    if not icepop:","+        w = raw.clamp(max=hi)","+    else:","+        keep = (raw >= lo) & (raw <= hi)","+        w = torch.where(keep, raw, torch.zeros_like(raw))","+    w = w.detach()","+    if batch_normalize:","+        mean = r_masked_mean(w, mask)","+        if float(mean) > 1e-8:","+            w = w / mean","+    return w","+","+","+def r_rs_seq_mean_k1(log_ratio, mask, threshold_spec):","+    lo_s, hi_s = str(threshold_spec).split(\"_\", 1)","+    import math","+    lo_log, hi_log = math.log(float(lo_s)), math.log(float(hi_s))","+    token_k1 = -torch.clamp(log_ratio, min=-20.0, max=20.0)","+    seq_stat = r_masked_mean(token_k1, mask, axis=-1)","+    keep = (seq_stat >= lo_log) & (seq_stat <= hi_log)","+    return (mask * keep.unsqueeze(-1).to(mask.dtype)).to(mask.dtype)","+","+","+def r_bypass_pg(old_rollout, cur, adv, mask, agg, gbi, rc):","+    log_ratio = cur - old_rollout","+    w = r_is_weights_token(log_ratio, mask, rc[\"rollout_is_threshold\"],","+                           rc.get(\"rollout_is_batch_normalize\", False))","+    eff_mask = r_rs_seq_mean_k1(log_ratio, mask, rc[\"rollout_rs_threshold\"])","+    return r_reinforce_pg(cur, adv, eff_mask, agg, gbi, is_weights=w)","+","+","+def r_ppo_total(spec, old, cur, adv, mask, ref, entropy, is_weights, gbi):","+    mode = spec[\"loss_mode\"]","+    if mode == \"vanilla\":","+        loss = r_vanilla_pg(old, cur, adv, mask, spec[\"agg\"], spec[\"clip_low\"],","+                            spec[\"clip_high\"], spec[\"clip_c\"], gbi, is_weights)","+    elif mode == \"gspo\":","+        loss = r_gspo_pg(old, cur, adv, mask, spec[\"agg\"], spec[\"clip_low\"],","+                         spec[\"clip_high\"], gbi, is_weights)","+    elif mode == \"bypass_mode\":","+        loss = r_bypass_pg(old, cur, adv, mask, spec[\"agg\"], gbi, spec[\"rc\"])","+    else:","+        raise ValueError(mode)","+    if entropy is not None:","+        loss = loss - spec[\"entropy\"] * r_agg(entropy, mask, spec[\"agg\"], **gbi)","+    if spec[\"use_kl\"]:","+        loss = loss + spec[\"kl_coef\"] * r_agg(r_kl_lowvar(cur, ref), mask,","+                                              spec[\"agg\"], **gbi)","+    return loss","+","+","+def r_value_loss(vpred, returns, values, mask, cliprange, agg, gbi):","+    vclip = torch.max(torch.min(vpred, values + cliprange), values - cliprange)","+    l1 = (vpred - returns) ** 2","+    l2 = (vclip - returns) ** 2","+    return 0.5 * r_agg(torch.max(l1, l2), mask, agg, **gbi)","+","+","+def r_distill_total(spec, old, cur, teacher_resp, mask, gbi,","+                    task_old, task_cur_unused, task_adv, task_ref):","+    d = spec[\"distill\"]","+    dloss = r_kl_lowvar(cur, teacher_resp)  # k3 == low_var_kl branch","+    if d[\"loss_max_clamp\"] is not None:","+        dloss = dloss.clamp(min=-d[\"loss_max_clamp\"], max=d[\"loss_max_clamp\"])","+    distill = r_vanilla_pg(old, cur, -dloss.detach(), mask, spec[\"agg\"],","+                           d[\"clip_low\"], d[\"clip_high\"], d[\"clip_c\"], gbi, None)","+    # use_task_rewards=False: task policy loss is computed then zeroed; coef=1.","+    return distill * 1.0","+","+","+def _group_stats_loop(scores, index):","+    id2 = {}","+    for i, k in enumerate(index):","+        id2.setdefault(k, []).append(i)","+    mean = torch.zeros_like(scores)","+    std = torch.ones_like(scores)","+    for k, idxs in id2.items():","+        if len(idxs) == 1:","+            m_, s_ = 0.0, 1.0","+        else:","+            t = scores[idxs]","+            m_, s_ = float(torch.mean(t)), float(torch.std(t))","+        for i in idxs:","+            mean[i], std[i] = m_, s_","+    return mean, std","+","+","+def _group_stats_vec(scores, index):","+    # group_mean_std with eps=0.0: var uses max(count-1,1), singleton -> 0/1.","+    id2 = {}","+    for i, k in enumerate(index):","+        id2.setdefault(k, []).append(i)","+    mean = torch.zeros_like(scores)","+    std = torch.ones_like(scores)","+    for k, idxs in id2.items():","+        if len(idxs) <= 1:","+            m_, s_ = 0.0, 1.0","+        else:","+            t = scores[idxs]","+            m_ = float(torch.mean(t))","+            var = float(torch.sum((t - m_) ** 2)) / max(len(idxs) - 1, 1)","+            s_ = float(torch.sqrt(torch.tensor(max(var, 0.0))))","+        for i in idxs:","+            mean[i], std[i] = m_, s_","+    return mean, std","+","+","+def r_adv_direct(spec, token_rewards, mask, index, values=None):","+    est = spec[\"adv\"]","+    with torch.no_grad():","+        if est in (\"grpo\", \"grpo_vectorized\"):","+            scores = token_rewards.sum(dim=-1)","+            if est == \"grpo\":","+                mean, std = _group_stats_loop(scores, index)","+            else:","+                mean, std = _group_stats_vec(scores, index)","+            if spec[\"norm_std\"]:","+                scalars = (scores - mean) / (std + 1e-6)","+            else:","+                scalars = scores - mean","+            adv_ = scalars.unsqueeze(-1) * mask","+            return adv_, adv_.clone()","+        if est == \"gae\":","+            gamma, lam = spec[\"gamma\"], spec[\"lam\"]","+            nextvalues = 0","+            lastgaelam = 0","+            rev = []","+            for t in reversed(range(token_rewards.shape[-1])):","+                delta = token_rewards[:, t] + gamma * nextvalues - values[:, t]","+                lg = delta + gamma * lam * lastgaelam","+                nextvalues = values[:, t] * mask[:, t] + (1 - mask[:, t]) * nextvalues","+                lastgaelam = lg * mask[:, t] + (1 - mask[:, t]) * lastgaelam","+                rev.append(lastgaelam)","+            adv_ = torch.stack(rev[::-1], dim=1)","+            returns = adv_ + values","+            adv_ = r_masked_whiten(adv_, mask)","+            return adv_, returns","+        if est == \"reinforce_plus_plus\":","+            gamma = spec[\"gamma\"]","+            returns = torch.zeros_like(token_rewards)","+            running = 0","+            for t in reversed(range(token_rewards.shape[1])):","+                new = token_rewards[:, t] + gamma * running","+                returns[:, t] = new * mask[:, t]","+                running = new * mask[:, t] + running * (1 - mask[:, t])","+            adv_ = r_masked_whiten(returns, mask) * mask","+            return adv_, returns","+    raise ValueError(est)","+","+","+def r_adv_multi(spec, token_rewards, mask, index, sessions, values=None):","+    \"\"\"sessions: list of (uid, session_id, output_index) per row.\"\"\"","+    if spec[\"adv\"] != \"grpo\":","+        return r_adv_direct(spec, token_rewards, mask, index, values)","+    final = {}","+    row_skey = []","+    for i, (uid, sess, idx) in enumerate(sessions):","+        skey = f\"{uid}_{sess}\"","+        row_skey.append(skey)","+        if skey not in final or final[skey][0] < idx:","+            final[skey] = (idx, i)","+    final_idx = [v[1] for v in final.values()]","+    skey_to_local = {k: j for j, k in enumerate(final.keys())}","+    f_adv, _ = r_adv_direct(","+        spec, token_rewards[final_idx], mask[final_idx],","+        [index[i] for i in final_idx], None)","+    first_nnz = mask[final_idx].argmax(dim=1)","+    f_scores = f_adv[torch.arange(len(final_idx)), first_nnz]","+    scores = f_scores[[skey_to_local[k] for k in row_skey]]","+    out = scores.unsqueeze(-1) * mask","+    return out, out.clone()","+"],"newLines":288,"newStart":142,"oldLines":3,"oldStart":142}],"path":"/app/upgrade_gate/gate.py"}]}