{"files":[{"hunks":[{"lines":["             running = new_running * mask[:, t] + running * (1 - mask[:, t])","         advantages = g_masked_whiten(returns, mask) * mask","     return advantages, returns","+","+","+def g_kl(logprob, ref_logprob, kind=\"low_var_kl\"):","+    base = kind[:-1] if kind.endswith(\"+\") else kind","+    if base in (\"kl\", \"k1\"):","+        return logprob - ref_logprob","+    if base == \"abs\":","+        return (logprob - ref_logprob).abs()","+    if base in (\"mse\", \"k2\"):","+        return 0.5 * (logprob - ref_logprob).square()","+    if base in (\"low_var_kl\", \"k3\"):","+        kl = torch.clamp(ref_logprob - logprob, min=-20, max=20)","+        kld = (torch.exp(kl) - kl - 1).contiguous()","+        return torch.clamp(kld, min=-10, max=10)","+    raise ValueError(kind)","+","+","+def _vanilla_pg(old, logp, adv, low, high, ratio_c, is_weights=None):","+    neg = torch.clamp(logp - old, min=-20.0, max=20.0)","+    ratio = torch.exp(neg)","+    pg1 = -adv * ratio","+    pg2 = -adv * torch.clamp(ratio, 1 - low, 1 + high)","+    clip1 = torch.maximum(pg1, pg2)","+    pg3 = -adv * ratio_c","+    clip2 = torch.min(pg3, clip1)","+    pg = torch.where(adv < 0, clip2, clip1)","+    if is_weights is not None:","+        pg = pg * is_weights","+    return pg","+","+","+def g_vanilla_loss(old, logp, adv, mask, low, high, ratio_c, agg, is_weights=None, **agg_kw):","+    pg = _vanilla_pg(old, logp, adv, low, high, ratio_c, is_weights)","+    return g_agg_loss(pg, mask, agg, **agg_kw)","+","+","+def _gspo_pg(old, logp, adv, mask, low, high, is_weights=None):","+    neg = logp - old","+    seq_lengths = torch.sum(mask, dim=-1).clamp(min=1)","+    seq_mean = torch.sum(neg * mask, dim=-1) / seq_lengths","+    log_ratio = logp - logp.detach() + seq_mean.detach().unsqueeze(-1)","+    log_ratio = torch.clamp(log_ratio, max=10.0)","+    s = torch.exp(log_ratio)","+    pg1 = -adv * s","+    pg2 = -adv * torch.clamp(s, 1 - low, 1 + high)","+    pg = torch.maximum(pg1, pg2)","+    if is_weights is not None:","+        pg = pg * is_weights","+    return pg","+","+","+def g_gspo_loss(old, logp, adv, mask, low, high, agg, is_weights=None, **agg_kw):","+    return g_agg_loss(_gspo_pg(old, logp, adv, mask, low, high, is_weights), mask, agg, **agg_kw)","+","+","+def _parse_is_threshold(spec):","+    if isinstance(spec, str) and \"_\" in spec:","+        lo, hi = spec.split(\"_\", 1)","+        return float(hi), float(lo)","+    return float(spec), None","+","+","+def g_is_weights(log_ratio, mask, spec, batch_normalize=False):","+    \"\"\"Token-level IS only (recipes). TIS clamp-max or IcePop zero-outside.\"\"\"","+    upper, lower = _parse_is_threshold(spec)","+    safe = torch.clamp(log_ratio, min=-20.0, max=20.0)","+    raw = torch.exp(safe) * mask","+    if lower is None:","+        w = raw.clamp(max=upper)","+    else:","+        kept = (raw >= lower) & (raw <= upper)","+        w = torch.where(kept, raw, torch.zeros_like(raw))","+    w = w.detach()","+    if batch_normalize:","+        mean = g_masked_mean(w, mask)","+        if mean > 1e-8:","+            w = w / mean","+    return w","+","+","+def g_rs_seq_mean_k1(log_ratio, mask, thr_spec):","+    \"\"\"seq_mean_k1: statistic is masked-mean of -log_ratio; bounds are","+    log(lower)..log(upper) from the 'lower_upper' spec.\"\"\"","+    lo_s, hi_s = str(thr_spec).split(\"_\", 1)","+    lower_log, upper_log = math.log(float(lo_s)), math.log(float(hi_s))","+    safe = torch.clamp(log_ratio, min=-20.0, max=20.0)","+    stat = g_masked_mean(-safe, mask, axis=-1)","+    keep = ((stat >= lower_log) & (stat <= upper_log)).to(dtype=mask.dtype)","+    return mask * keep.unsqueeze(-1)","+","+","+def g_bypass_loss(rollout, logp, adv, mask, agg, is_spec, rs_spec, batch_normalize, **agg_kw):","+    with torch.no_grad():","+        log_ratio = logp - rollout","+        w = g_is_weights(log_ratio, mask, is_spec, batch_normalize)","+        eff = g_rs_seq_mean_k1(log_ratio, mask, rs_spec) if rs_spec is not None else mask.clone()","+    pg = -adv * logp * w","+    return g_agg_loss(pg, eff, agg, **agg_kw)","+","+","+def g_value_loss(vpreds, returns, values, mask, cliprange, agg, **agg_kw):","+    vpred_clipped = torch.max(torch.min(vpreds, values + cliprange), values - cliprange)","+    vf1 = (vpreds - returns) ** 2","+    vf2 = (vpred_clipped - returns) ** 2","+    clipped = torch.max(vf1, vf2)","+    return 0.5 * g_agg_loss(clipped, mask, agg, **agg_kw)","+","+","+def g_entropy_from_logits(logits):","+    pd = F.softmax(logits, dim=-1)","+    return torch.logsumexp(logits, dim=-1) - torch.sum(pd * logits, dim=-1)","+","+","+def g_logprobs_from_logits(logits, labels):","+    return torch.gather(F.log_softmax(logits, dim=-1), -1, labels.unsqueeze(-1)).squeeze(-1)","+"],"newLines":119,"newStart":144,"oldLines":3,"oldStart":144}],"path":"/app/upgrade_gate/golden.py"}]}