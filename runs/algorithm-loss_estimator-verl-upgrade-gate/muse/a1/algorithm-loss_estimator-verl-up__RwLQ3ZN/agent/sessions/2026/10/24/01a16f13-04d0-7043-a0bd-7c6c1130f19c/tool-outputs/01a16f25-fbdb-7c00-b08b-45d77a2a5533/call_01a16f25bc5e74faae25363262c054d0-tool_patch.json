{"files":[{"hunks":[{"lines":["+\"\"\"verl upgrade gate: check a candidate verl tree trains our SQL-agent","+recipes identically to verl 0.9.1 (same update from the same batch).","+","+Usage: gate.py /path/to/verl [--no-dumps]","+Exit 0 = equivalent, 1 = differs / cannot verify a required behaviour.","+The oracle is golden.py (0.9.1 math reimplemented); the candidate is only","+ever exercised through its public training-step entry points, discovered","+by registry / name so internal reorganisations do not fail the gate.","+\"\"\"","+import ast","+import importlib","+import inspect","+import math","+import os","+import pathlib","+import shlex","+import sys","+import traceback","+import warnings","+","+warnings.filterwarnings(\"ignore\")","+os.environ.setdefault(\"TOKENIZERS_PARALLELISM\", \"false\")","+os.environ.setdefault(\"VERL_LOGGING_LEVEL\", \"ERROR\")","+","+GATE_DIR = pathlib.Path(__file__).resolve().parent","+sys.path.insert(0, str(GATE_DIR))","+","+FAILURES = []","+NOTES = []","+","+","+def fail(check, msg):","+    FAILURES.append(f\"[{check}] {msg}\")","+    print(f\"FAIL [{check}] {msg}\", flush=True)","+","+","+def note(msg):","+    NOTES.append(msg)","+    print(f\"note: {msg}\", flush=True)","+","+","+def check_run(check, fn):","+    try:","+        fn()","+        print(f\"ok   [{check}]\", flush=True)","+    except GateMismatch as e:","+        fail(check, str(e))","+    except Exception as e:  # candidate cannot be driven = not verified","+        fail(check, f\"exception {type(e).__name__}: {e}\")","+","+","+class GateMismatch(AssertionError):","+    pass","+","+","+def assert_close(name, got, want, atol=2e-5, rtol=2e-4):","+    import torch","+","+    if not isinstance(got, torch.Tensor):","+        got = torch.as_tensor(got, dtype=torch.float32)","+    if not isinstance(want, torch.Tensor):","+        want = torch.as_tensor(want, dtype=torch.float32)","+    got = got.detach().to(dtype=torch.float64, device=\"cpu\")","+    want = want.detach().to(dtype=torch.float64, device=\"cpu\")","+    if got.shape != want.shape:","+        raise GateMismatch(f\"{name}: shape {tuple(got.shape)} != golden {tuple(want.shape)}\")","+    if not torch.isfinite(got).all():","+        raise GateMismatch(f\"{name}: non-finite candidate values\")","+    diff = (got - want).abs()","+    tol = atol + rtol * want.abs()","+    bad = diff > tol","+    if bad.any():","+        i = int((diff - tol).argmax())","+        raise GateMismatch(","+            f\"{name}: max diff {diff.max().item():.3e} at flat {i}: \"","+            f\"got {got.flatten()[i].item():.8g} want {want.flatten()[i].item():.8g} \"","+            f\"({int(bad.sum())}/{got.numel()} out of tol)\"","+        )","+","+","+def assert_scalar_close(name, got, want, atol=2e-5, rtol=2e-4):","+    g, w = float(got), float(want)","+    if not (math.isfinite(g)) or abs(g - w) > atol + rtol * abs(w):","+        raise GateMismatch(f\"{name}: got {g:.10g} want {w:.10g} (diff {abs(g-w):.3e})\")","+","+","+# ---------------------------------------------------------------- discovery","+class Discovery:","+    \"\"\"Find candidate callables by canonical import, else AST name search.\"\"\"","+","+    def __init__(self, root):","+        self.root = pathlib.Path(root).resolve()","+        if not (self.root / \"verl\" / \"__init__.py\").exists():","+            raise SystemExit(f\"candidate has no verl package: {self.root}\")","+        # fresh interpreter per gate run, so a plain path insert is enough","+        sys.path.insert(0, str(self.root))","+        import verl","+","+        got = pathlib.Path(verl.__file__).resolve()","+        if self.root not in got.parents:","+            raise SystemExit(f\"imported verl from {got}, not candidate {self.root}\")","+        self._scan = None","+        self._mods = {}","+","+    def module(self, name):","+        if name not in self._mods:","+            try:","+                self._mods[name] = importlib.import_module(name)","+            except Exception:","+                self._mods[name] = None","+        return self._mods[name]","+","+    def _ast_scan(self):","+        if self._scan is None:","+            self._scan = {}","+            base = self.root / \"verl\"","+            for py in base.rglob(\"*.py\"):","+                try:","+                    tree = ast.parse(py.read_text(errors=\"ignore\"))","+                except Exception:","+                    continue","+                modname = \"verl.\" + \".\".join(py.relative_to(base).with_suffix(\"\").parts)","+                if modname.endswith(\".__init__\"):","+                    modname = modname[: -len(\".__init__\")]","+                for node in tree.body:","+                    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):","+                        self._scan.setdefault(node.name, []).append(modname)","+        return self._scan","+","+    def find(self, symbol, canonical_modules=()):","+        for m in canonical_modules:","+            mod = self.module(m)","+            if mod is not None and hasattr(mod, symbol):","+                return getattr(mod, symbol)","+        for modname in self._ast_scan().get(symbol, []):","+            mod = self.module(modname)","+            if mod is not None and hasattr(mod, symbol):","+                return getattr(mod, symbol)","+        return None","+","+    def find_any(self, symbols, canonical_modules=()):","+        for s in symbols:","+            obj = self.find(s, canonical_modules)","+            if obj is not None:","+                return obj","+        return None","+","+","+def call_by_names(fn, pool, required=()):","+    \"\"\"Call fn passing pool entries matching its parameter names.\"\"\"","+    sig = inspect.signature(fn)","+    kwargs = {}","+    for name, p in sig.parameters.items():","+        if name in (\"self\", \"cls\"):","+            continue","+        if p.kind == inspect.Parameter.VAR_KEYWORD:","+            continue","+        if name in pool:","+            kwargs[name] = pool[name]","+        elif p.default is inspect.Parameter.empty and p.kind != inspect.Parameter.VAR_POSITIONAL:","+            # try close synonyms","+            hit = None","+            for syn in _SYNONYMS.get(name, []):","+                if syn in pool:","+                    hit = pool[syn]","+                    break","+            if hit is not None:","+                kwargs[name] = hit","+            else:","+                raise GateMismatch(f\"cannot supply required arg '{name}' to {fn}\")","+    return fn(**kwargs)","+","+","+_SYNONYMS = {","+    \"old_log_probs\": [\"old_log_prob\"],","+    \"old_log_prob\": [\"old_log_probs\"],","+    \"rollout_log_probs\": [\"rollout_log_prob\"],","+    \"rollout_log_prob\": [\"rollout_log_probs\"],","+    \"token_level_rewards\": [\"token_level_scores\"],","+    \"index\": [\"uid\", \"indices\"],","+    \"values\": [\"value\"],","+}"],"newLines":182,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/app/upgrade_gate/gate.py"}]}