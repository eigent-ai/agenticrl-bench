{"files":[{"hunks":[{"lines":[" def g_logprobs_from_logits(logits, labels):","     return torch.gather(F.log_softmax(logits, dim=-1), -1, labels.unsqueeze(-1)).squeeze(-1)"," ","+","+def g_distill_loss(student_resp, teacher_resp, old, mask, low, high, agg,","+                   loss_max_clamp=None, ratio_c=3.0, **agg_kw):","+    \"\"\"OPD recipe: k3(reverse KL) per token, used as detached negative","+    advantage in a vanilla PPO-clip loss (distillation clip ratios).\"\"\"","+    dloss = g_kl(student_resp, teacher_resp, \"k3\")","+    if loss_max_clamp is not None:","+        dloss = dloss.clamp(min=-loss_max_clamp, max=loss_max_clamp)","+    return g_vanilla_loss(old, student_resp, -dloss.detach(), mask, low, high,","+                          ratio_c, agg, **agg_kw)","+","+","+def g_slice_response(full_rows, prompt_lens, resp_lens, max_resp=None):","+    \"\"\"Left-shift slice: response token j takes full position P-1+j.","+    full_rows: list of 1-D tensors (P+R). Returns padded [B, max_resp].\"\"\"","+    if max_resp is None:","+        max_resp = max(resp_lens) if resp_lens else 0","+    outs = []","+    for full, p, r in zip(full_rows, prompt_lens, resp_lens):","+        seg = full[p - 1: p + r - 1]","+        outs.append(F.pad(seg, (0, max_resp - r)))","+    return torch.stack(outs, dim=0)","+","+","+def g_ppo_total(logp, old, adv, mask, agg, agg_kw, policy_mode=\"vanilla\",","+                low=0.2, high=0.2, ratio_c=3.0, is_weights=None,","+                entropy=None, entropy_coeff=0.0,","+                ref=None, use_kl_loss=False, kl_coef=0.0, kl_type=\"low_var_kl\",","+                bypass=None):","+    \"\"\"Whole-minibatch golden actor loss (response-aligned tensors).","+    bypass: dict(rollout=..., is_spec=..., rs_spec=..., batch_normalize=...)","+    for the bypass_mode recipe, evaluated per call (per micro-batch).\"\"\"","+    if bypass is not None:","+        loss = g_bypass_loss(bypass[\"rollout\"], logp, adv, mask, agg,","+                             bypass[\"is_spec\"], bypass[\"rs_spec\"],","+                             bypass[\"batch_normalize\"], **agg_kw)","+    elif policy_mode == \"gspo\":","+        loss = g_gspo_loss(old, logp, adv, mask, low, high, agg, is_weights, **agg_kw)","+    else:","+        loss = g_vanilla_loss(old, logp, adv, mask, low, high, ratio_c, agg,","+                              is_weights, **agg_kw)","+    if entropy is not None:","+        loss = loss - entropy_coeff * g_agg_loss(entropy, mask, agg, **agg_kw)","+    if use_kl_loss:","+        kld = g_kl(logp, ref, kl_type)","+        loss = loss + kl_coef * g_agg_loss(kld, mask, agg, **agg_kw)","+    return loss","+","+","+# --- Golden recipe summaries (resolved verl 0.9.1 configs for /app/recipes) ---","+# Only fields that move the training update for that recipe are pinned.","+COMMON_GOLDEN = dict(","+    rollout_n=4, temperature=1.0, calculate_log_probs=True, use_remove_padding=True,","+    ppo_mini_batch_size=4, use_dynamic_bsz=True, ppo_max_token_len_per_gpu=16384,","+    strategy=\"fsdp2\", optim_lr=1e-6, optim_weight_decay=0.01,","+    ppo_epochs=1, shuffle=False, use_kl_in_reward=False, use_pf_ppo=False,","+    filter_groups_enable=False, use_v1=True, v1_trainer_mode=\"sync\",","+    critic_warmup=0, reward_manager_name=\"naive\",","+)","+RECIPES_GOLDEN = {","+    \"sql_bypass_is\": dict(adv=\"grpo\", norm_std=True, gamma=1.0, lam=1.0,","+                          agg=\"token-mean\", scale=None, policy=\"bypass_mode\",","+                          use_kl_loss=False, entropy_coeff=0, kl_coef=0.001,","+                          rc=dict(bypass=True, loss_type=\"reinforce\", is_level=\"token\",","+                                  is_threshold=\"0.5_2.0\", rs=\"seq_mean_k1\",","+                                  rs_threshold=\"0.99_1.01\", batch_normalize=True)),","+    \"sql_dapo\": dict(adv=\"grpo_vectorized\", norm_std=True, gamma=1.0, lam=1.0,","+                     agg=\"token-mean\", scale=None, policy=\"vanilla\",","+                     clip=0.2, clip_low=0.2, clip_high=0.28, clip_c=3.0,","+                     use_kl_loss=False, entropy_coeff=0,","+                     rc=dict(bypass=False, is_level=\"token\", is_threshold=2.0,","+                             rs=None, batch_normalize=False)),","+    \"sql_drgrpo\": dict(adv=\"grpo\", norm_std=False, gamma=1.0, lam=1.0,","+                       agg=\"seq-mean-token-sum-norm\", scale=8192, policy=\"vanilla\",","+                       clip=0.2, clip_low=0.2, clip_high=0.2, clip_c=3.0,","+                       use_kl_loss=False, entropy_coeff=0,","+                       rc=dict(bypass=False, is_level=None, rs=None)),","+    \"sql_grpo_compact\": dict(adv=\"grpo\", norm_std=True, gamma=1.0, lam=1.0,","+                             agg=\"token-mean\", scale=None, policy=\"vanilla\",","+                             clip=0.2, clip_low=0.2, clip_high=0.2, clip_c=10.0,","+                             use_kl_loss=True, kl_coef=0.001, kl_type=\"low_var_kl\",","+                             entropy_coeff=0,","+                             rc=dict(bypass=False, is_level=None, rs=None)),","+    \"sql_grpo_kl\": dict(adv=\"grpo\", norm_std=True, gamma=1.0, lam=1.0,","+                        agg=\"seq-mean-token-mean\", scale=None, policy=\"vanilla\",","+                        clip=0.2, clip_low=0.2, clip_high=0.2, clip_c=3.0,","+                        use_kl_loss=True, kl_coef=0.01, kl_type=\"low_var_kl\",","+                        entropy_coeff=0.001,","+                        rc=dict(bypass=False, is_level=None, rs=None)),","+    \"sql_gspo\": dict(adv=\"grpo\", norm_std=True, gamma=1.0, lam=1.0,","+                     agg=\"token-mean\", scale=None, policy=\"gspo\",","+                     clip=0.2, clip_low=0.0003, clip_high=0.0004, clip_c=3.0,","+                     use_kl_loss=False, entropy_coeff=0,","+                     rc=dict(bypass=False, is_level=None, rs=None)),","+    \"sql_opd_teacher\": dict(adv=\"grpo\", norm_std=True, gamma=1.0, lam=1.0,","+                            agg=\"token-mean\", scale=None, policy=\"vanilla\",","+                            use_kl_loss=False, entropy_coeff=0,","+                            rc=dict(bypass=False, is_level=None, rs=None),","+                            distill=dict(enabled=True, loss_mode=\"k3\",","+                                         use_task_rewards=False,","+                                         use_policy_gradient=True,","+                                         policy_loss_mode=\"vanilla\",","+                                         loss_max_clamp=None, coef=1.0,","+                                         clip=0.2, clip_low=0.2, clip_high=0.2)),","+    \"sql_ppo\": dict(adv=\"gae\", norm_std=True, gamma=1.0, lam=0.95,","+                    agg=\"token-mean\", scale=None, policy=\"vanilla\",","+                    clip=0.2, clip_low=0.2, clip_high=0.2, clip_c=3.0,","+                    use_kl_loss=False, entropy_coeff=0,","+                    rc=dict(bypass=False, is_level=None, rs=None),","+                    critic=dict(cliprange_value=0.5, agg=\"token-mean\", scale=None,","+                                mini_batch_size=4, use_dynamic_bsz=True,","+                                max_token_len=32768, epochs=1, shuffle=False,","+                                lr=5e-6, weight_decay=0.01)),","+    \"sql_rpp\": dict(adv=\"reinforce_plus_plus\", norm_std=True, gamma=1.0, lam=1.0,","+                    agg=\"token-mean\", scale=None, policy=\"vanilla\",","+                    clip=0.2, clip_low=0.2, clip_high=0.2, clip_c=3.0,","+                    use_kl_loss=True, kl_coef=0.001, kl_type=\"low_var_kl\",","+                    entropy_coeff=0.001,","+                    rc=dict(bypass=False, is_level=None, rs=None)),","+}","+"],"newLines":124,"newStart":260,"oldLines":3,"oldStart":260}],"path":"/app/upgrade_gate/golden.py"}]}