{"files":[{"hunks":[{"lines":["     return out"," "," ","+def recipe_overrides(name):","+    \"\"\"Overrides from the launch scripts on disk when present, else embedded.\"\"\"","+    import re","+    paths = [os.path.join(RECIPES_DIR, \"common.sh\"),","+             os.path.join(RECIPES_DIR, name + \".sh\")]","+    if all(os.path.exists(p) for p in paths):","+        toks = []","+        for path in paths:","+            for m in re.finditer(r\"(\\+?[A-Za-z_][\\w.]*=(?:'[^']*'|[^\\s\\\\]+))\",","+                                 open(path).read()):","+                t = m.group(1)","+                if \".\" not in t.split(\"=\")[0]:","+                    continue","+                k, _, v = t.partition(\"=\")","+                toks.append(f\"{k}={v.strip(chr(39)).replace('$MODEL', '/models/Qwen3.5-2B')}\")","+        if toks:","+            return toks","+    return COMMON_OVERRIDES + RECIPE_OVERRIDES[name]","+","+","+def find_config(candidate):","+    import pathlib","+    root = pathlib.Path(candidate)","+    cand = root / \"verl\" / \"trainer\" / \"config\" / \"ppo_trainer.yaml\"","+    if cand.exists():","+        return str(cand.parent), \"ppo_trainer\"","+    for p in sorted(root.rglob(\"ppo_trainer.yaml\")):","+        return str(p.parent), p.stem","+    return None, None","+","+","+def expected_config(name, spec):","+    exp = {","+        \"algorithm.adv_estimator\": spec[\"adv\"],","+        \"algorithm.use_kl_in_reward\": False,","+        \"algorithm.use_pf_ppo\": False,","+        \"algorithm.filter_groups.enable\": False,","+        \"data.train_batch_size\": 16,","+        \"data.max_prompt_length\": 1536,","+        \"data.max_response_length\": 8192,","+        \"actor_rollout_ref.rollout.n\": 4,","+        \"actor_rollout_ref.rollout.temperature\": 1.0,","+        \"actor_rollout_ref.rollout.calculate_log_probs\": True,","+        \"actor_rollout_ref.actor.ppo_mini_batch_size\": 4,","+        \"actor_rollout_ref.actor.use_dynamic_bsz\": True,","+        \"actor_rollout_ref.actor.clip_ratio\": 0.2,","+        \"actor_rollout_ref.actor.clip_ratio_low\": spec[\"clip_low\"],","+        \"actor_rollout_ref.actor.clip_ratio_high\": spec[\"clip_high\"],","+        \"actor_rollout_ref.actor.clip_ratio_c\": spec[\"clip_c\"],","+        \"actor_rollout_ref.actor.loss_agg_mode\": spec[\"agg\"],","+        \"actor_rollout_ref.actor.loss_scale_factor\": spec.get(\"loss_scale_factor\"),","+        \"actor_rollout_ref.actor.entropy_coeff\": spec[\"entropy\"],","+        \"actor_rollout_ref.actor.use_kl_loss\": spec[\"use_kl\"],","+        \"actor_rollout_ref.actor.policy_loss.loss_mode\": spec[\"loss_mode\"],","+        \"actor_rollout_ref.actor.ppo_epochs\": 1,","+        \"actor_rollout_ref.actor.shuffle\": False,","+        \"actor_rollout_ref.actor.grad_clip\": 1.0,","+        \"actor_rollout_ref.actor.optim.optimizer\": \"AdamW\",","+        \"actor_rollout_ref.actor.optim.lr\": 1e-6,","+        \"actor_rollout_ref.actor.optim.weight_decay\": 0.01,","+        \"actor_rollout_ref.actor.optim.betas\": [0.9, 0.999],","+        \"actor_rollout_ref.actor.optim.clip_grad\": 1.0,","+        \"actor_rollout_ref.actor.optim.lr_scheduler_type\": \"constant\",","+        \"actor_rollout_ref.actor.optim.lr_warmup_steps_ratio\": 0.0,","+        \"actor_rollout_ref.actor.optim.min_lr_ratio\": 0.0,","+        \"trainer.use_v1\": True,","+        \"trainer.v1.trainer_mode\": \"sync\",","+        \"trainer.balance_batch\": True,","+        \"trainer.critic_warmup\": 0,","+    }","+    if spec[\"adv\"] in (\"grpo\", \"grpo_vectorized\"):","+        exp[\"algorithm.norm_adv_by_std_in_grpo\"] = spec[\"norm_std\"]","+    if spec[\"adv\"] in (\"gae\", \"reinforce_plus_plus\"):","+        exp[\"algorithm.gamma\"] = spec[\"gamma\"]","+    if spec[\"adv\"] == \"gae\":","+        exp[\"algorithm.lam\"] = spec[\"lam\"]","+    if spec[\"use_kl\"]:","+        exp[\"actor_rollout_ref.actor.kl_loss_coef\"] = spec[\"kl_coef\"]","+        exp[\"actor_rollout_ref.actor.kl_loss_type\"] = \"low_var_kl\"","+    for k, v in spec[\"rc\"].items():","+        exp[f\"algorithm.rollout_correction.{k}\"] = v","+    if \"critic\" in spec:","+        exp.update({","+            \"critic.cliprange_value\": 0.5, \"critic.loss_agg_mode\": \"token-mean\",","+            \"critic.loss_scale_factor\": None, \"critic.ppo_mini_batch_size\": 4,","+            \"critic.use_dynamic_bsz\": True, \"critic.ppo_epochs\": 1,","+            \"critic.shuffle\": False, \"critic.grad_clip\": 1.0,","+            \"critic.optim.lr\": 5e-6, \"critic.optim.weight_decay\": 0.01,","+            \"critic.optim.betas\": [0.9, 0.999], \"critic.optim.clip_grad\": 1.0,","+            \"critic.optim.lr_scheduler_type\": \"constant\",","+        })","+    if \"distill\" in spec:","+        d = spec[\"distill\"]","+        exp.update({","+            \"distillation.enabled\": True,","+            \"distillation.distillation_loss.loss_mode\": d[\"loss_mode\"],","+            \"distillation.distillation_loss.use_task_rewards\": d[\"use_task_rewards\"],","+            \"distillation.distillation_loss.use_policy_gradient\": d[\"use_policy_gradient\"],","+            \"distillation.distillation_loss.policy_loss_mode\": d[\"policy_loss_mode\"],","+            \"distillation.distillation_loss.distillation_loss_coef\": d[\"coef_when_task\"],","+            \"distillation.distillation_loss.loss_max_clamp\": d[\"loss_max_clamp\"],","+            \"distillation.distillation_loss.log_prob_min_clamp\": None,","+            \"distillation.distillation_loss.clip_ratio\": d[\"clip_ratio\"],","+            \"distillation.distillation_loss.clip_ratio_low\": d[\"clip_low\"],","+            \"distillation.distillation_loss.clip_ratio_high\": d[\"clip_high\"],","+        })","+    return exp","+","+","+def _val_eq(got, want):","+    if isinstance(want, float) or isinstance(got, float):","+        try:","+            return got is not None and abs(float(got) - float(want)) <= 1e-12","+        except (TypeError, ValueError):","+            return False","+    if isinstance(want, list):","+        try:","+            return list(got) == want","+        except TypeError:","+            return False","+    # thresholds may be str in one place and float in another","+    if isinstance(want, str) and not isinstance(got, str):","+        return str(got) == want","+    return got == want","+","+","+def compose_configs(candidate):","+    \"\"\"Compose every recipe against the candidate's hydra tree; compare the","+    training-relevant resolved values.  Returns {recipe: cfg or None}.\"\"\"","+    check = \"config\"","+    cfg_dir, cfg_name = find_config(candidate)","+    if cfg_dir is None:","+        fail(check, \"no ppo_trainer.yaml found in candidate tree\")","+        return {}","+    from hydra import compose, initialize_config_dir","+    from omegaconf import OmegaConf","+    out = {}","+    missing = object()","+    with initialize_config_dir(config_dir=cfg_dir, version_base=None):","+        for name, spec in RECIPES.items():","+            try:","+                cfg = compose(config_name=cfg_name,","+                              overrides=recipe_overrides(name))","+                OmegaConf.resolve(cfg)","+            except Exception as e:","+                fail(f\"{check}/{name}\", f\"recipe no longer composes: \"","+                                        f\"{type(e).__name__}: {str(e)[:300]}\")","+                out[name] = None","+                continue","+            out[name] = cfg","+            for key, want in expected_config(name, spec).items():","+                NCHECKS[0] += 1","+                got = OmegaConf.select(cfg, key, default=missing)","+                if got is missing:","+                    fail(f\"{check}/{name}\", f\"{key} missing in resolved config\")","+                elif not _val_eq(got, want):","+                    fail(f\"{check}/{name}\", f\"{key} = {got!r}, want {want!r}\")","+    return out","+","+","+def instantiate(node):","+    from hydra.utils import instantiate as hydra_instantiate","+    return hydra_instantiate(node, _convert_=\"partial\")","+","+","+def build_actor_cfg(check, cfg):","+    if cfg is None:","+        return None","+    try:","+        return instantiate(cfg.actor_rollout_ref.actor)","+    except Exception as e:","+        fail(check, f\"actor config no longer instantiates: \"","+                    f\"{type(e).__name__}: {str(e)[:300]}\")","+        return None","+","+","+def build_critic_cfg(sym, check, cfg):","+    cls = sym.get(\"CriticConfig\", [\"verl.workers.config.critic\",","+                                   \"verl.workers.config\"])","+    if cls is None:","+        fail(check, \"CriticConfig not found in candidate\")","+        return None","+    import inspect","+    from omegaconf import OmegaConf","+    vals = {}","+    if cfg is not None:","+        c = cfg.critic","+        for k in (\"strategy\", \"rollout_n\", \"ppo_mini_batch_size\",","+                  \"use_dynamic_bsz\", \"ppo_max_token_len_per_gpu\",","+                  \"cliprange_value\", \"loss_agg_mode\", \"loss_scale_factor\",","+                  \"ppo_epochs\", \"shuffle\", \"data_loader_seed\"):","+            v = OmegaConf.select(c, k, default=None)","+            if v is not None:","+                vals[k] = v","+    vals.setdefault(\"strategy\", \"fsdp2\")","+    vals.setdefault(\"rollout_n\", 4)","+    vals.setdefault(\"use_dynamic_bsz\", True)","+    try:","+        params = inspect.signature(cls).parameters","+        return cls(**{k: v for k, v in vals.items() if k in params})","+    except Exception as e:","+        fail(check, f\"CriticConfig construction failed: {type(e).__name__}: {e}\")","+        return None","+","+","+def build_distill_cfg(check, cfg):","+    if cfg is None:","+        return None","+    try:","+        return instantiate(cfg.distillation)","+    except Exception as e:","+        fail(check, f\"distillation config no longer instantiates: \"","+                    f\"{type(e).__name__}: {str(e)[:300]}\")","+        return None","+","+","+"],"newLines":220,"newStart":693,"oldLines":3,"oldStart":693}],"path":"/app/upgrade_gate/gate.py"}]}