{"files":[{"hunks":[{"lines":["+import sys, time; sys.path.insert(0,\"/opt/verl\")","+import torch","+t0=time.time()","+# recipe overrides parsing quick: bypass","+common = [\"data.train_batch_size=16\",\"actor_rollout_ref.model.path=/models/Qwen3.5-2B\",\"actor_rollout_ref.rollout.n=4\",\"actor_rollout_ref.actor.ppo_mini_batch_size=4\",\"actor_rollout_ref.actor.use_dynamic_bsz=True\",\"trainer.n_gpus_per_node=2\"]","+from hydra import compose, initialize_config_dir","+from verl.utils.config import omega_conf_to_dataclass","+with initialize_config_dir(config_dir=\"/opt/verl/verl/trainer/config\", version_base=None):","+    cfg = compose(config_name=\"ppo_trainer\", overrides=common+[","+      \"algorithm.adv_estimator=grpo\",\"algorithm.rollout_correction.bypass_mode=True\",","+      \"algorithm.rollout_correction.loss_type=reinforce\",\"algorithm.rollout_correction.rollout_is=token\",","+      \"algorithm.rollout_correction.rollout_is_threshold=0.5_2.0\",\"algorithm.rollout_correction.rollout_rs=seq_mean_k1\",","+      \"algorithm.rollout_correction.rollout_rs_threshold=0.99_1.01\",\"algorithm.rollout_correction.rollout_is_batch_normalize=True\",","+      \"actor_rollout_ref.actor.policy_loss.loss_mode=bypass_mode\",","+      \"+actor_rollout_ref.actor.policy_loss.rollout_correction=${algorithm.rollout_correction}\",","+      \"actor_rollout_ref.actor.loss_agg_mode=token-mean\"])","+print(\"compose ok\", time.time()-t0, flush=True)","+ac = omega_conf_to_dataclass(cfg.actor_rollout_ref.actor)","+print(\"actor\", type(ac).__name__, ac.policy_loss.loss_mode, type(ac.policy_loss.rollout_correction), flush=True)","+rc = ac.policy_loss.get(\"rollout_correction\", None)","+print(\"rc get\", rc, flush=True)","+if rc is not None:","+    print(\"rc fields\", rc.get(\"loss_type\"), rc.get(\"rollout_is\"), rc.get(\"rollout_is_threshold\"), rc.get(\"rollout_rs\"), rc.get(\"rollout_rs_threshold\"), rc.get(\"rollout_is_batch_normalize\"), flush=True)","+","+# critic direct","+from verl.workers.config import CriticConfig","+import inspect","+print(\"critic sig params\", [p for p in inspect.signature(CriticConfig).parameters][:25], flush=True)","+try:","+    cc = CriticConfig(strategy=\"fsdp2\", rollout_n=4, use_dynamic_bsz=True, cliprange_value=0.5, loss_agg_mode=\"token-mean\")","+    print(\"critic direct ok\", cc.cliprange_value, cc.loss_scale_factor, flush=True)","+except Exception as e:","+    print(\"critic direct err\", type(e), e, flush=True)","+","+# distillation instantiate","+try:","+    dc = omega_conf_to_dataclass(cfg.distillation)","+    print(\"distill ok\", dc.distillation_loss.loss_mode, dc.distillation_loss.loss_max_clamp, dc.enabled, flush=True)","+except Exception as e:","+    print(\"distill err\", type(e), str(e)[:300], flush=True)","+","+# import multi traj advantage","+t1=time.time()","+try:","+    from verl.trainer.ppo.v1.utils import compute_advantage_for_multi_trajectories","+    print(\"multi import ok\", time.time()-t1, flush=True)","+except Exception as e:","+    print(\"multi import err\", type(e), str(e)[:300], flush=True)","+","+# DataProto construct + compute_advantage grpo simple","+try:","+    import numpy as np","+    from tensordict import TensorDict","+    from verl.protocol import DataProto","+    td = TensorDict({\"token_level_rewards\": torch.zeros(4,3), \"response_mask\": torch.ones(4,3)}, batch_size=4)","+    td[\"token_level_rewards\"][:, -1] = torch.tensor([1.,0.,1.,0.])","+    dp = DataProto(batch=td, non_tensor_batch={\"uid\": np.array([\"a\",\"a\",\"b\",\"b\"], dtype=object)})","+    out = compute_advantage_for_multi_trajectories(dp, batch_keys=[\"a_0_0\",\"a_1_0\",\"b_0_0\",\"b_1_0\"], adv_estimator=\"grpo\", gamma=1.0, lam=1.0, num_repeat=4, norm_adv_by_std_in_grpo=True, config=cfg.algorithm)","+    print(\"adv ok\", out.batch[\"advantages\"][:,0], flush=True)","+except Exception as e:","+    import traceback; traceback.print_exc()","+","+# AgentLoopOutput","+try:","+    t1=time.time()","+    from verl.experimental.agent_loop.agent_loop import AgentLoopOutput","+    o = AgentLoopOutput(prompt_ids=[1,2], response_ids=[3,4,5], response_mask=[1,0,1], response_logprobs=[-0.1,-0.2,-0.3], reward_score=0.7, num_turns=1, metrics={})","+    d = o.as_dict()","+    print(\"alo ok\", time.time()-t1, d[\"rm_scores\"], d[\"rollout_log_probs\"], flush=True)","+except Exception as e:","+    import traceback; traceback.print_exc()","+print(\"total\", time.time()-t0, flush=True)"],"newLines":72,"newStart":1,"oldLines":0,"oldStart":1}],"path":"/tmp/proto2.py"}]}