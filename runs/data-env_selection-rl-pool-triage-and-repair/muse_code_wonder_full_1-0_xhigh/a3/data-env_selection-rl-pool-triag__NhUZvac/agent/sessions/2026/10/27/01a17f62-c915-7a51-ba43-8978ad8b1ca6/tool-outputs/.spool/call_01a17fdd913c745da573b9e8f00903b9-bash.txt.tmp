49:# Create the xbindkeysrc configuration file
50:cat > ~/.xbindkeysrc << 'XBINDKEYS_EOF'
51-# Keyboard shortcut remapping configuration
52-# Maps Super key combinations to Ctrl equivalents using keyremap.sh
53-
54-# Super+C -> Ctrl+C (copy)
55-"/usr/local/bin/keyremap.sh super+c"
56-    Mod4 + c
57-
58-# Super+V -> Ctrl+V (paste)
59-"/usr/local/bin/keyremap.sh super+v"
60-    Mod4 + v
61-
62-# Super+T -> Ctrl+T (new tab)
63-"/usr/local/bin/keyremap.sh super+t"
64-    Mod4 + t
65-
--
73:echo "Created ~/.xbindkeysrc"
28
