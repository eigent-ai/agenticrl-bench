ne     [ -f /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.exit ]   }   while [ ! -f /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.exit ]; do     GROK_PID=$(cat /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.pid 2>/dev/null)     # Snapshot live children so orphans can be swept after grok exits.     [ -n "$GROK_PID" ] && ps -o pid= --ppid "$GROK_PID" 2>/dev/null > /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.children     sleep 5     grep -qs '"type":"turn_ended"' "$HOME"/.grok/sessions/*/e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0/events.jsonl || continue     wait_for_exit 27060 && break     [ -n "$GROK_PID" ] || continue     CHILDREN=$(ps -o pid= --ppid "$GROK_PID" 2>/dev/null)     [ -n "$CHILDREN" ] || continue     echo "$(date -u +%FT%TZ) grok-build watchdog: grok still running 27060s after turn end; terminating leftover child process groups: $CHILDREN" | tee -a /logs/agent/grok-build-watchdog.log >&2     kill_pids TERM $CHILDREN     wait_for_exit 10 && break     CHILDREN=$(ps -o pid= --ppid "$GROK_PID" 2>/dev/null)     [ -n "$CHILDREN" ] && kill_pids KILL $CHILDREN   done } &  # Key on grok's own exit signal, not pipeline completion: an orphan holding # the stdout pipe would otherwise stall tee (and this script) until it dies. while [ ! -f /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.exit ]; do   sleep 5 done  # Pre-reap grok versions exit their background wait leaving tasks orphaned # (reparented to init); sweep the last child snapshot so nothing outlives the # agent phase or holds ports during verification. if [ -s /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.children ]; then   SWEPT=""   for PID in $(cat /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.children); do     kill -0 "$PID" 2>/dev/null && SWEPT="$SWEPT $PID"   done   if [ -n "$SWEPT" ]; then     echo "$(date -u +%FT%TZ) grok-build watchdog: sweeping orphaned processes:$SWEPT" | tee -a /logs/agent/grok-build-watchdog.log >&2     OWN_PGID=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')     for PID in $SWEPT; do       PGID=$(ps -o pgid= -p "$PID" 2>/dev/null | tr -d ' ')       if [ -n "$PGID" ] && [ "$PGID" != "$OWN_PGID" ]; then         kill -TERM -- "-$PGID" 2>/dev/null || kill -TERM "$PID" 2>/dev/null       else         kill -TERM "$PID" 2>/dev/null       fi     done   fi fi  # Orphans are gone, so tee gets EOF promptly and the watchdog sees the exit # file; both finish here. wait STATUS=$(cat /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.exit 2>/dev/null) rm -f /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.pid /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.exit /tmp/.grok-build-e6a7520b-ca7f-41a6-8b01-0a3ceb558fd0.children exit "${STATUS:-1}" 
