+@contextmanager
+def global_batch_info(**info):
+    """Scope the global-batch normalisation info (dp_size, batch_num_tokens, global_batch_size,
+    loss_scale_factor) of the micro-batch being processed. Set by the loss entry points; read by the policy
+    losses through :func:`current_global_batch_info`. Nothing is kept on the config between micro-batches."""
+    token = _GLOBAL_BATCH_INFO.set(dict(info))
+    try:
+        yield
+    finally:
+        _GLOBAL_BATCH_INFO.reset(token)
+
+
+def current_global_batch_info() -> dict:
+    return dict(_GLOBAL_BATCH_INFO.get())
+
