+def _shifted_response(values: torch.Tensor, seq_end, resp_len) -> torch.Tensor:
+    """Rows of a packed model output that score one sequence's response tokens.
+
+    Row t of the model output predicts token t + 1, so the ``resp_len`` response tokens that end the sequence at
+    ``seq_end`` are scored by the ``resp_len`` rows that end one row earlier.
+    """
+    start = seq_end - resp_len - 1
+    return values[start : start + resp_len]
+
