+def _rows_in_input_order(chunks, batch_idx_list, use_dynamic_bsz):
+    """Unbind per-micro-batch nested outputs into one jagged tensor with a row per input sample.
+
+    With dynamic batch size the micro-batches hold the samples in packing order: ``batch_idx_list`` gives the input
+    index of every packed row, and the rows are put back in input order before the nested tensor is built, so it is
+    built once instead of being built and then re-ordered.
+    """
+    rows = [row for nt in chunks for row in nt.unbind()]
+    if use_dynamic_bsz:
+        order = list(chain.from_iterable(batch_idx_list))
+        assert len(order) == len(rows), f"{len(order)} vs. {len(rows)}"
+        rows = [rows[i] for i in get_reverse_idx(order)]
+    return torch.nested.as_nested_tensor(rows, layout=torch.jagged)
+
