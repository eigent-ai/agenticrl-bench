cabal-version:      3.0
name:               adventure-engine
version:            0.1.0.0
synopsis:           A text adventure game engine
license:            BSD-3-Clause
build-type:         Simple

executable adventure-engine
  main-is:          Main.hs
  other-modules:    Types
                  , Dual
                  , SceneGraph
                  , DualMap
                  , Interactable
                  , GameState
                  , Serialization
                  , Validation
                  , TestMap
  hs-source-dirs:   src
  build-depends:    base >=4.17 && <5
                  , containers >=0.6
                  , mtl >=2.3
                  , aeson >=2.1
                  , bytestring >=0.11
                  , text >=2.0
  ghc-options:      -Wall -Werror
  default-language:  Haskell2010

test-suite adventure-engine-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test, src
  other-modules:    Types
                  , Dual
                  , SceneGraph
                  , DualMap
                  , Interactable
                  , GameState
                  , Serialization
                  , Validation
                  , TestMap
                  , Utils
  build-depends:    base >=4.17 && <5
                  , containers >=0.6
                  , mtl >=2.3
                  , aeson >=2.1
                  , bytestring >=0.11
                  , text >=2.0
                  , QuickCheck >=2.14
  ghc-options:      -Wall -Werror
  default-language:  Haskell2010
