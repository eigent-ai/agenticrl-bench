# ~/.bashrc: executed by bash for non-login shells

# Local software hierarchy
export PATH="$HOME/bn:$HOME/.local/usr/bin:$PATH"

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Aliases
alias ll='ls -alF'
alias la='ls -A'

HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
