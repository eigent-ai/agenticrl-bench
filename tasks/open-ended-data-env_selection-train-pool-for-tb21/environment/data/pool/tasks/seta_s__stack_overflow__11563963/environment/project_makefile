CXX = g++
CXXFLAGS = -std=c++11 -Wall -O2

SRCDIR = src
INCDIR = include
BINDIR = bin

all: $(BINDIR)/writer $(BINDIR)/reader

$(BINDIR)/writer: $(SRCDIR)/writer.cpp $(INCDIR)/common.h
	@mkdir -p $(BINDIR)
	$(CXX) $(CXXFLAGS) -I$(INCDIR) -o $@ $<

$(BINDIR)/reader: $(SRCDIR)/reader.cpp $(INCDIR)/common.h
	@mkdir -p $(BINDIR)
	$(CXX) $(CXXFLAGS) -I$(INCDIR) -o $@ $<

clean:
	rm -rf $(BINDIR)

.PHONY: all clean
