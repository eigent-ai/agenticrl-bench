" Vim configuration for development project
set nocompatible
filetype plugin indent on
syntax on

" General settings
set number
set ruler
set showcmd
set wildmenu
set backspace=indent,eol,start

" Indentation
set expandtab
set tabstop=2
set shiftwidth=2
set autoindent

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" SQL omni completion key prefix
let g:ftplugin_sql_omni_key = '<C-c>'

" Status line
set laststatus=2
