# ~/.bashrc

HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000

export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH"

# Vim nesting level tracking.
# VILVL increments each time you open vim from within a shell, so that
# shells started from inside vim (e.g. via :!) can show their nesting depth.
# The prompt below displays both shell nesting (S) and vim nesting (V).
export VILVL=0
vim() {
    command vim "$@"
}

# Prompt: [S:<shell-depth> V:<vim-depth>]
PS1='\u@\h:\w [S:$SHLVL V:$VILVL]\$ '

alias ll='ls -la'
alias la='ls -A'
alias grep='grep --color=auto'
