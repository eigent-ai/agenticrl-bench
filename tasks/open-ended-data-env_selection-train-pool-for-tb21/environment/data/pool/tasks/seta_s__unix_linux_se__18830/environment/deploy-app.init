#!/bin/bash
### BEGIN INIT INFO
# Provides:          deploy-app
# Required-Start:
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Deploy application
### END INIT INFO

PIDFILE="/var/run/deploy-app.pid"
LOGFILE="/var/log/deploy-app.log"

case "$1" in
    start)
        echo "Starting deploy-app..."
        echo "deploy-app started at $(date)" >> "$LOGFILE"
        echo $$ > "$PIDFILE"
        echo "deploy-app is running."
        ;;
    stop)
        echo "Stopping deploy-app..."
        rm -f "$PIDFILE"
        echo "deploy-app stopped at $(date)" >> "$LOGFILE"
        echo "deploy-app stopped."
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    status)
        if [ -f "$PIDFILE" ]; then
            echo "deploy-app is running."
            exit 0
        else
            echo "deploy-app is not running."
            exit 0
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0
