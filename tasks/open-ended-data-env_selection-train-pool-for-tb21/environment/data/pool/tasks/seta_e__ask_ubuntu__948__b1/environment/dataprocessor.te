module dataprocessor 1.0;

require {
    type unconfined_t;
    type bin_t;
    type shell_exec_t;
    class file { getattr open read write create append unlink setattr execute entrypoint };
    class dir { open read write search add_name remove_name getattr };
    class process { transition };
}

# Domain type for our application
type dataprocessor_t;
type dataprocessor_exec_t;

# Allow transition from unconfined to our domain
allow unconfined_t dataprocessor_exec_t:file { getattr open read execute };
allow unconfined_t dataprocessor_t:process transition;

# Basic permissions for the domain
allow dataprocessor_t bin_t:file { execute getattr open read };
allow dataprocessor_t shell_exec_t:file { execute getattr open read };
allow dataprocessor_t dataprocessor_exec_t:file { getattr open read execute entrypoint };
