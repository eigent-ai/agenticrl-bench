#!/usr/bin/env python3
"""
oom-analyze — parse dmesg OOM killer output and generate a summary report.

Usage: oom-analyze <log-file> [--json]
"""

import re
import sys
import json
from collections import Counter
from pathlib import Path


def parse_oom_events(log_path: str) -> Counter:
    """Parse 'Killed process' lines from a dmesg-format OOM log."""
    pattern = re.compile(r'Killed process \d+ \((\w+)\)')
    counts = Counter()

    with open(log_path) as f:
        for line in f:
            m = pattern.search(line)
            if m:
                counts[m.group(1)] += 1

    return counts


def main():
    if len(sys.argv) < 2:
        print("Usage: oom-analyze <log-file> [--json]", file=sys.stderr)
        sys.exit(1)

    log_file = sys.argv[1]
    as_json = "--json" in sys.argv

    if not Path(log_file).exists():
        print(f"Error: {log_file}: No such file", file=sys.stderr)
        sys.exit(1)

    counts = parse_oom_events(log_file)
    total = sum(counts.values())

    report = {
        "log_file": log_file,
        "total_kills": total,
        "by_process": dict(counts),
    }

    if as_json:
        print(json.dumps(report, indent=2))
    else:
        if total == 0:
            print("No OOM events found.")
        else:
            print(f"Total OOM kills: {total}")
            print()
            for name, cnt in sorted(counts.items(), key=lambda x: -x[1]):
                print(f"  {name:20s}  {cnt:4d} kill(s)")

    report_path = Path(log_file).with_suffix(".report.json")
    with open(report_path, "w") as f:
        json.dump(report, f, indent=2)


if __name__ == "__main__":
    main()
