#!/bin/bash
OUTPUT_FILE="/boot/grub/grub.cfg"
while getopts "o:" opt; do
  case $opt in
    o) OUTPUT_FILE="$OPTARG" ;;
  esac
done

. /etc/default/grub

cat > "$OUTPUT_FILE" << EOF
#
# DO NOT EDIT THIS FILE
#
# It is automatically generated by grub-mkconfig using templates
# from /etc/grub.d and settings from /etc/default/grub
#

set default="${GRUB_DEFAULT}"
set timeout=${GRUB_TIMEOUT}

menuentry 'Ubuntu' --class ubuntu {
    linux /boot/vmlinuz root=/dev/sda1 ro ${GRUB_CMDLINE_LINUX} ${GRUB_CMDLINE_LINUX_DEFAULT}
    initrd /boot/initrd.img
}

menuentry 'Ubuntu (recovery mode)' --class ubuntu {
    linux /boot/vmlinuz root=/dev/sda1 ro recovery nomodeset ${GRUB_CMDLINE_LINUX}
    initrd /boot/initrd.img
}
EOF

echo "Generating grub configuration file ..."
echo "Found linux image: /boot/vmlinuz"
echo "Found initrd image: /boot/initrd.img"
echo "done"
