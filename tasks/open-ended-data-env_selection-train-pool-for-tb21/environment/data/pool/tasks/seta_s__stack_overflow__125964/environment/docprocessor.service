[Unit]
Description=Document Processor Service
After=network.target

[Service]
Type=simple
User=docproc
Group=docproc
WorkingDirectory=/var/spool/docprocessor
ExecStart=/usr/bin/python3 /opt/docprocessor/main.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
