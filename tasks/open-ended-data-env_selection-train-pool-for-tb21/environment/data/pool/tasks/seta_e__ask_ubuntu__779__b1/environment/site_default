server {
    listen 80 default_server;
    server_name localhost;

    location / {
        root /var/www/html;
        index index.html;
    }

    location /api/ {
        proxy_pass http://backend_api;
        proxy_set_header X-Auth-Token "bearer_tok_abc123";
        proxy_set_header Host $host;
    }

    location /nginx_status {
        stub_status on;
        allow 127.0.0.1;
        deny all;
    }
}
