" General settings
set nocompatible
syntax on
filetype plugin indent on

" Display
set number
set ruler
set showcmd
set showmode
set laststatus=2

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Indentation
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent

" Colors
set t_Co=8
set background=dark
let g:solarized_termcolors=16
colorscheme desert

" Misc
set backspace=indent,eol,start
set wildmenu
set scrolloff=3
set encoding=utf-8
