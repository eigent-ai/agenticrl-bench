" Development environment vimrc
set nocompatible
syntax on
filetype plugin on

" Indentation
set tabstop=4
set shiftwidth=2
set expandtab
set autoindent

" Display
set number
set ruler
set laststatus=2
set statusline=%f\ [%{&ff}]\ %y\ %m\ %r\ %=%-14.(%l,%c%V%)\ %P

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Key mappings
nnoremap <C-s> :w
inoremap <C-s> <Esc>:w
nnoremap <C-q> :q!<CR>

" Folding
set foldmethod=indent
set foldlevel=99

" Colors
set background=dark
colorscheme desert
