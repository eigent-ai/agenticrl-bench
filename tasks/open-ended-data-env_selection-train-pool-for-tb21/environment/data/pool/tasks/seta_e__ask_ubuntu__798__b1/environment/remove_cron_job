#!/bin/bash
# Usage: remove_cron_job <username> [job_id]
if [ -z "$1" ]; then
  echo "Usage: remove_cron_job <username> [job_id]"
  exit 1
fi
USERNAME=$1
JOB_ID=$2
if [ -n "$JOB_ID" ]; then
  grep -v "^${USERNAME}|${JOB_ID}|" /var/spool/cron/managed_jobs.dat > /tmp/cron_tmp.dat
else
  grep -v "^${USERNAME}|" /var/spool/cron/managed_jobs.dat > /tmp/cron_tmp.dat
fi
mv /tmp/cron_tmp.dat /var/spool/cron/managed_jobs.dat
echo "Cron job(s) for $USERNAME removed"
