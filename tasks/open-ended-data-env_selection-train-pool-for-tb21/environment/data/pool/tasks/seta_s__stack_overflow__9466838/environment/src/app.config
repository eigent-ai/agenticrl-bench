<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.diagnostics>
    <trace autoflush="false" indentsize="4">
      <listeners>
        <add name="fileListener"
             type="System.Diagnostics.TextWriterTraceListener"
             initializeData="/tmp/processor_trace.log"/>
        <clear/>
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>
