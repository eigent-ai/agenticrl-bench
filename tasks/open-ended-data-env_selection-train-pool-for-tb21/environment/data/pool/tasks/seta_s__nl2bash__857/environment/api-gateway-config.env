# API Gateway Configuration
APP_NAME=api-gateway
LISTEN_PORT=443
TLS_CERT=/etc/ssl/gateway.pem

QRATE_LIMIT=100
QMAX_RETRIES=3
QTIMEOUT_MS=5000
QENABLE_CIRCUIT_BREAKER=true
QCOMPRESSION=gzip
QAVAILABILITY_TARGET=0.95
QRETRY_DELAY_SEC=30
QBACKOFF_STRATEGY=exponential
QLOG_LEVEL=warn
QBUFFER_SIZE=512
QDB_CONNECTION=host=primary;port=5432
