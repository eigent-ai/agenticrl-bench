# /etc/fstab: static file system information.
#
# Example showing CORRECT mount options for VFAT and NFS:
#
# VFAT with proper permissions (umask=0022 gives files 755, fmask=0133 gives files 644):
# /dev/sdb1 /mnt/vfat_backup vfat rw,uid=1000,gid=1000,umask=0022 0 0
#
# NFS with UID mapping:
# server:/export /mnt/nfs_share nfs rw,anonuid=1000,anongid=1000,all_squash 0 0
#
# The key insight: chmod doesn't work on VFAT - permissions are set at MOUNT TIME
# NFS uses server-side UID mapping or mount-time squash options
