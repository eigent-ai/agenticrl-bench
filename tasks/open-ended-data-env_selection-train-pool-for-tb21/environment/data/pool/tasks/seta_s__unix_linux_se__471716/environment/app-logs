/data/logs/*.log {
    daily
    rotate 7
    compress
    missingok
    notifempty
    prerotate
        /sbin/blkid -s UUID /opt/images/data.img 2>/dev/null | grep -q "deadbeef-cafe-babe-dead-aaaaaaaaaaaa" || exit 1
    endscript
    postrotate
        [ -d /data/logs/archive ] || mkdir -p /data/logs/archive
    endscript
}
