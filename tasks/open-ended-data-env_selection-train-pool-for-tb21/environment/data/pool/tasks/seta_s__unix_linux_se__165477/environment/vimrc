" Basic settings
set nocompatible
set number
set relativenumber
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set hlsearch
set incsearch
set ignorecase
set smartcase

" Escape mappings
inoremap jj <Esc>

" Leader key
let mapleader = " "
nnormap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

" Status line
set laststatus=2
set statusline=%f\ %m%r%h%w\ [%{&ff}]\ [%Y]\ [%l,%c]
