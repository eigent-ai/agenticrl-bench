#!/bin/bash
# Unmount the storage filesystem

STATE_DIR="/var/lib/storage_sim"

mounted=$(cat "$STATE_DIR/mounted" 2>/dev/null || echo "true")

if [[ "$mounted" == "true" ]]; then
    echo "false" > "$STATE_DIR/mounted"
    echo "unmounted" > "$STATE_DIR/mount_state"
    echo "Filesystem /mnt/storage unmounted successfully"
    exit 0
else
    echo "umount: /mnt/storage: not mounted."
    exit 1
fi
