" Development environment vim configuration
set nocompatible
filetype plugin indent on
syntax on

" Line numbers
set number

" Indentation
set tabstop=4
set shiftwidth=4
set expandtab

" Status line
set laststatus=1
set statusline=%t

" Diff settings
set diffopt=filler,vertical

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase
