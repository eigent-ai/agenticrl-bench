# Workspace Retention Policy
# Files matching ANY of these patterns (against relative path) will be PRESERVED
# All other files will be REMOVED
#
# NOTE: This file and the .cleanup-policy.d/ directory are always retained
# NOTE: The .git/ directory is always excluded from cleanup operations

# Source code
\.(py|js|ts|jsx|tsx)$

# Configuration
\.(yaml|yml|toml|conf|cfg|ini)$

# Documentation
\.(md|rst|txt)$

# Build system files
(^|/)Makefile$
(^|/)Dockerfile$
(^|/)docker-compose\.ya?ml$

# Version control metadata
(^|/)\.gitignore$
(^|/)\.gitattributes$

# Include additional project-specific patterns
@include .cleanup-policy.d/extra.conf
