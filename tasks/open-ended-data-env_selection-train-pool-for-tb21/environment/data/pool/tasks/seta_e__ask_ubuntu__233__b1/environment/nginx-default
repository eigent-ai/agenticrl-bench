server {
    listen 80 default_server;
    root /var/www/html;
    index index.html;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }

    # Security: block access to sensitive file types
    location ~ \.sql$ {
        deny all;
        return 403;
    }

    location ~ \.json$ {
        deny all;
        return 403;
    }

    location ~ \.env$ {
        deny all;
        return 403;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
