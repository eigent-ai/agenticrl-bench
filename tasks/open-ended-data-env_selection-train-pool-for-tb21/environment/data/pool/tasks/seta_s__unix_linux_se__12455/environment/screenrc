# Screen configuration
# Intended to use Ctrl+B as escape key to avoid conflicts with bash readline
set escape "^Bb"

hardstatus alwayslastline
hardstatus string '%{= kG}[%= %{= kw}%?%-Lw%?%{r}(%{W}%n*%f%t%?(%u)%?%{r})%{w}%?%+Lw%?%?%= %{g}][%{B} %m-%d %{W}%c %{g}]'
startup_message off
defscrollback 5000
