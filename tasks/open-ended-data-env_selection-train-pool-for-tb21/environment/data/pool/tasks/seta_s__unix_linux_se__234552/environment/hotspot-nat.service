[Unit]
Description=Hotspot NAT masquerade for internet sharing
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/iptables -t nat -A POSTROUTING -o ens3 -j MASQUERADE
ExecStop=/sbin/iptables -t nat -D POSTROUTING -o ens3 -j MASQUERADE

[Install]
WantedBy=multi-user.target
