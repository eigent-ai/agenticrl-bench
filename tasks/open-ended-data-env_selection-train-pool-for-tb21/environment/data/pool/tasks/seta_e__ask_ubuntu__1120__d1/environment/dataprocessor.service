[Unit]
Description=Data Processor Service
After=network.target dataprocessor-helper.service
Wants=dataprocessor-helper.service

[Service]
Type=simple
EnvironmentFile=/etc/dataprocessor/app.env
ExecStart=/opt/dataprocessor/bin/dataprocessor
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/dataprocessor/app.log
StandardError=append:/var/log/dataprocessor/error.log

[Install]
WantedBy=multi-user.target
