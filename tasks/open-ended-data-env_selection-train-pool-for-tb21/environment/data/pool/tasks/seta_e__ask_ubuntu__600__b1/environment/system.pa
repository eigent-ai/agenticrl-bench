#!/usr/bin/pulseaudio -nF

# Load necessary protocol modules
load-module module-native-protocol-unix auth-anonymous=1

# Null sinks to simulate audio devices
load-module module-null-sink sink_name=speakers sink_properties=device.description="Built-in\ Speakers"
load-module module-null-sink sink_name=headphones sink_properties=device.description="USB\ Headphones"
load-module module-null-sink sink_name=hdmi_output sink_properties=device.description="HDMI\ Audio\ Output"

# Explicit auto_null fallback device (must never be muted)
load-module module-null-sink sink_name=auto_null sink_properties=device.description="Null\ Output"

# Always-sink ensures a fallback exists
load-module module-always-sink

# Rescue streams module
load-module module-rescue-streams

# Default sink
set-default-sink speakers
