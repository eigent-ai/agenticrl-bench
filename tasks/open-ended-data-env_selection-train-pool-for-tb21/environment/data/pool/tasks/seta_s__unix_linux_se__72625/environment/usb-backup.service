[Unit]
Description=USB Drive Backup Service
Documentation=man:rsync(1)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/usb-backup.sh /home/backup-data /mnt/usb
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usb-backup
User=root
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
