CXX = g++
CXXFLAGS = -std=c++0x -O2 -I include
SRC_DIR = sources
INC_DIR = include
BUILD_DIR = build

all: $(BUILD_DIR)/collatz $(BUILD_DIR)/montecarlo $(BUILD_DIR)/popcount

$(BUILD_DIR)/collatz: $(SRC_DIR)/collatz.cpp $(INC_DIR)/common.h
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -o $@ $<

$(BUILD_DIR)/montecarlo: $(SRC_DIR)/montecarlo.cpp $(INC_DIR)/common.h
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -o $@ $<

$(BUILD_DIR)/popcount: $(SRC_DIR)/popcount.cpp $(INC_DIR)/common.h utils.o
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -o $@ $< utils.o

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all clean
