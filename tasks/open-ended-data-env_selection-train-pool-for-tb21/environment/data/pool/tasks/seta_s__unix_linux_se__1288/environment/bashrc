# User shell configuration
# Updated by admin - 2025-11-14

export PATH="$HOME/bin:$PATH"
export EDITOR=vim

# History settings
HISTSIZE=0
HISTFILESIZE=0
HISTCONTROL=ignoredups

# Aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'

# Custom prompt
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
