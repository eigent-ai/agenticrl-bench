# MetricStack Maintenance Cron Jobs
# Cleanup old data every night at 2am
0 2 * * * root /usr/bin/metricstack-cleanup --older-than 30d
# Send weekly reports
0 8 * * 1 root /usr/bin/metricstack-report --type weekly --email admin@example.com
# Check service health every 5 minutes
*/5 * * * * root /usr/bin/metricstack-healthcheck --notify
