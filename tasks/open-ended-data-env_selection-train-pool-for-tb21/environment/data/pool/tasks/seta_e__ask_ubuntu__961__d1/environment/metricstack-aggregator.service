[Unit]
Description=MetricStack Data Aggregation Service
After=network.target metricstack-collector.service
Requires=metricstack-collector.service

[Service]
Type=simple
ExecStart=/usr/bin/metricstack-aggregator --config /etc/metricstack/aggregator.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
