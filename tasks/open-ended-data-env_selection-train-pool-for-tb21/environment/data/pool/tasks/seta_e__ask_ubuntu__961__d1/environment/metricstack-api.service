[Unit]
Description=MetricStack REST API Server
After=network.target metricstack-aggregator.service
Requires=metricstack-aggregator.service

[Service]
Type=simple
User=metricstack-api
ExecStart=/usr/bin/metricstack-api --config /etc/metricstack/api.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
