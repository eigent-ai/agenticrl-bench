{
  "rules": {
    "default": {
      "allowed_extensions": ["*"],
      "allow_extensionless": true,
      "allow_dotfiles": true
    },
    "src": {
      "allowed_extensions": [".py", ".pyx", ".pxd"]
    },
    "src/lib": {
      "allowed_extensions": [".py", ".so", ".c"]
    },
    "docs": {
      "allowed_extensions": [".md", ".html", ".rst", ".txt", ".jpg", ".png", ".svg"]
    },
    "config": {
      "allowed_extensions": [".yaml", ".json", ".toml", ".conf", ".ini"],
      "allow_dotfiles": true
    },
    "scripts": {
      "allowed_extensions": [".sh", ".bash", ".py"],
      "allow_extensionless": true
    },
    "assets": {
      "allowed_extensions": [".png", ".jpg", ".svg", ".gif", ".webp", ".woff", ".woff2", ".ttf", ".ico"]
    },
    "data": {
      "allowed_extensions": [".csv", ".tsv", ".json", ".xml", ".tar.gz", ".tar.bz2", ".zip"],
      "allow_extensionless": true
    },
    "restricted": {
      "allowed_extensions": [".yaml", ".conf", ".json"]
    }
  },
  "compound_extensions": [".tar.gz", ".tar.bz2", ".tar.xz"],
  "report_path": "audit_report.json",
  "quarantine_dir": "quarantine"
}
