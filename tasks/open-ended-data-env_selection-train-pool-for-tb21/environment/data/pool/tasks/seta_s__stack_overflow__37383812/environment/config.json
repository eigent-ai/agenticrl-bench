{
    "application": {
        "name": "DataProcessor",
        "version": "2.1.0",
        "debug": false
    },
    "database": {
        "host": "localhost",
        "port": 5432,
        "credentials": {
            "username": "admin",
            "password": "secret123"
        },
        "options": {
            "pool_size": 10,
            "timeout": 30,
            "retry": {
                "max_attempts": 3,
                "delay_ms": 500
            }
        }
    },
    "logging": {
        "level": "INFO",
        "outputs": ["console", "file"],
        "file_config": {
            "path": "/var/log/dataproc.log",
            "max_size_mb": 100,
            "rotation": "daily"
        }
    },
    "pipelines": {
        "parse": {
            "enabled": true,
            "input_format": "json",
            "strict_mode": false
        },
        "sample": {
            "enabled": true,
            "sample_size": 15,
            "method": "weighted"
        },
        "aggregate": {
            "enabled": true,
            "group_field": "department",
            "metrics": ["count", "sum", "average"]
        },
        "plugins": {
            "enabled": true,
            "directory": "plugins",
            "auto_discover": true
        }
    }
}