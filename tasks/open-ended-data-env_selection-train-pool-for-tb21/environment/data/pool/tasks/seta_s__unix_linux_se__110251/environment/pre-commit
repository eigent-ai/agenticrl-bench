#!/bin/bash
# pre-commit hook: verify editor setup and format files

# Check that EDITOR is available
if ! command -v "$EDITOR" > /dev/null 2>&1; then
    echo "pre-commit: EDITOR ($EDITOR) is not available"
    exit 1
fi

$EDITOR --version > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo "pre-commit: EDITOR ($EDITOR) failed version check"
    exit 1
fi

# Run formatting
make format
if [ $? -ne 0 ]; then
    echo "pre-commit: make format failed"
    exit 1
fi

exit 0
