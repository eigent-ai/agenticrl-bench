#!/bin/bash
HIST_FILE="$HOME/.history"
PATTERNS=("password=" "PASSWORD=" "secret=" "SECRET=" "token=" "TOKEN=" "api_key=" "API_KEY=")
for pattern in "${PATTERNS[@]}"; do
    grep -v "$pattern" "$HIST_FILE" > "${HIST_FILE}.tmp"
    mv "${HIST_FILE}.tmp" "$HIST_FILE"
done
echo "History sanitized successfully."
