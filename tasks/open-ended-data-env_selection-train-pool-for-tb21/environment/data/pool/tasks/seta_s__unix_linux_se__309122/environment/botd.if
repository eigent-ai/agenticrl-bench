## <summary>policy for botd</summary>

########################################
## <summary>
##	Execute botd in the botd domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`botd_domtrans',`
	gen_require(`
		type botd_t, botd_exec_t;
	')

	domtrans_pattern($1, botd_exec_t, botd_t)
')
