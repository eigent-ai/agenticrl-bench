set nocompatible
filetype plugin indent on
syntax on
set hlsearch
set incsearch
set number
set backspace=indent,eol,start

" Search all open buffers for a pattern, collect results in quickfix list
command! -nargs=1 Search call setqflist([]) | silent bufdo grep! <args> %

" Navigate quickfix results
nnoremap <F8>  :cprev<CR>zvzz
nnoremap <F9>  :cnext<CR>zvzz
