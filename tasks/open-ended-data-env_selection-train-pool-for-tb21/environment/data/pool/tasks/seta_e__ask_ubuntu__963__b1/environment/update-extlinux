#!/bin/bash
# Simplified update-extlinux for container environment
# Reads /etc/extlinux/defaults and generates /boot/extlinux/extlinux.conf

echo "Generating extlinux configuration file ..."

# Source the defaults
if [ -f /etc/extlinux/defaults ]; then
    . /etc/extlinux/defaults
fi

DEFAULT_LABEL="${EXTLINUX_DEFAULT:-primary}"
TIMEOUT_VAL="${EXTLINUX_TIMEOUT:-50}"
PROMPT_VAL="${EXTLINUX_PROMPT:-0}"
DEFAULT_PARAMS="${EXTLINUX_CMDLINE_DEFAULT}"
EXTRA_PARAMS="${EXTLINUX_CMDLINE}"

# Build the APPEND strings
# Primary label gets: root + default params + extra params
PRIMARY_APPEND="root=/dev/sda1 ro ${DEFAULT_PARAMS} ${EXTRA_PARAMS}"
# Recovery label gets: root + recovery-specific + extra params
RECOVERY_APPEND="root=/dev/sda1 ro single nomodeset ${DEFAULT_PARAMS} ${EXTRA_PARAMS}"

# Clean up extra whitespace
PRIMARY_APPEND=$(echo "$PRIMARY_APPEND" | tr -s ' ')
RECOVERY_APPEND=$(echo "$RECOVERY_APPEND" | tr -s ' ')

cat > /boot/extlinux/extlinux.conf << EOF
# This file is automatically generated by update-extlinux
# Do not edit this file directly. Edit /etc/extlinux/defaults instead.

DEFAULT ${DEFAULT_LABEL}
PROMPT ${PROMPT_VAL}
TIMEOUT ${TIMEOUT_VAL}

LABEL primary
    MENU LABEL Ubuntu 5.4.0-generic
    KERNEL /boot/vmlinuz-5.4.0-generic
    INITRD /boot/initrd.img-5.4.0-generic
    APPEND ${PRIMARY_APPEND}

LABEL recovery
    MENU LABEL Ubuntu 5.4.0-generic (recovery mode)
    KERNEL /boot/vmlinuz-5.4.0-generic
    INITRD /boot/initrd.img-5.4.0-generic
    APPEND ${RECOVERY_APPEND}
EOF

echo "done"
