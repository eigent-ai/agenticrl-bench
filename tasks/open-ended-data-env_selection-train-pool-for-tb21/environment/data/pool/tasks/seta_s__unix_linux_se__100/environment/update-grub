#!/usr/bin/env python3
"""update-grub: regenerates /boot/grub/grub.cfg from /etc/default/grub"""
import re, os

config = {}
with open('/etc/default/grub') as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        m = re.match(r'^(\w+)=(.*)', line)
        if m:
            key = m.group(1)
            val = m.group(2).strip('"\'')
            config[key] = val

cmdline_default = config.get('GRUB_CMDLINE_LINUX_DEFAULT', '')
cmdline = config.get('GRUB_CMDLINE_LINUX', '')
full_cmdline = ' '.join(filter(None, [cmdline_default, cmdline]))
timeout = config.get('GRUB_TIMEOUT', '5')

os.makedirs('/boot/grub', exist_ok=True)
with open('/boot/grub/grub.cfg', 'w') as f:
    f.write(f"""# Generated by update-grub
# DO NOT EDIT THIS FILE
# Edit /etc/default/grub instead and run update-grub
set default="0"
set timeout={timeout}

menuentry 'Ubuntu Linux' {{
\tlinux\t/boot/vmlinuz-5.15.0-88-generic root=/dev/vda1 ro {full_cmdline}
\tinitrd\t/boot/initrd.img-5.15.0-88-generic
}}
""")
print("Generating grub configuration file ...")
print("Found linux image: /boot/vmlinuz-5.15.0-88-generic")
print("Found initrd image: /boot/initrd.img-5.15.0-88-generic")
print("done")
