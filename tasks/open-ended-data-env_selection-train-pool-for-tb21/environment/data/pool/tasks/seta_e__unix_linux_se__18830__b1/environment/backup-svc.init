#!/bin/bash
### BEGIN INIT INFO
# Provides:          backup-svc
# Required-Start:
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Backup service
### END INIT INFO

PIDFILE="/var/run/backup-svc.pid"
LOGFILE="/var/log/backup-svc.log"

case "$1" in
    start)
        echo "Starting backup-svc..."
        echo "backup-svc started at $(date)" >> "$LOGFILE"
        echo $$ > "$PIDFILE"
        echo "backup-svc is running."
        ;;
    stop)
        echo "Stopping backup-svc..."
        rm -f "$PIDFILE"
        echo "backup-svc stopped at $(date)" >> "$LOGFILE"
        echo "backup-svc stopped."
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    status)
        if [ -f "$PIDFILE" ]; then
            echo "backup-svc is running."
            exit 0
        else
            echo "backup-svc is not running."
            exit 0
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0
