# .bash_profile - login shell initialization

# Source bashrc for interactive settings
if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi

# Apply server-mandated defaults
if [ -f /etc/profile.d/server_defaults.sh ]; then
    . /etc/profile.d/server_defaults.sh
fi

# User local bin
export PATH="$HOME/.local/bin:$PATH"
