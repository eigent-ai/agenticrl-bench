{
  "name": "phaser3-game",
  "version": "1.0.0",
  "description": "Phaser 3 game with tileset processing pipeline",
  "scripts": {
    "process-terrain": "tile-extruder --tileWidth 16 --tileHeight 16 --input ./src/tilesets/terrain.png --output ./dist/tilesets/terrain.png",
    "process-items": "tile-extruder --tileWidth 16 --tileHeight 16 --input ./src/tilesets/items.png --output ./dist/tilesets/items.png",
    "process-assets": "npm run process-terrain && npm run process-items"
  },
  "dependencies": {
    "tile-extruder": "*"
  }
}
