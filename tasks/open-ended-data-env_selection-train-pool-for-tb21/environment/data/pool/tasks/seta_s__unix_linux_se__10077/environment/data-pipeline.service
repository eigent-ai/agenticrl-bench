[Unit]
Description=Nightly Data Processing Pipeline
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pipeline/process_data.py
WorkingDirectory=/opt/pipeline
Environment=PYTHONPATH=/opt/pipeline
MemoryMax=32M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
