#!/bin/bash
# update-grub: regenerate /boot/grub/grub.cfg from /etc/default/grub

set -euo pipefail

GRUB_DEFAULT_FILE="/etc/default/grub"
GRUB_CFG="/boot/grub/grub.cfg"

if [ ! -f "$GRUB_DEFAULT_FILE" ]; then
    echo "update-grub: $GRUB_DEFAULT_FILE not found" >&2
    exit 1
fi

source "$GRUB_DEFAULT_FILE"

mkdir -p /boot/grub

# Write grub.cfg by expanding variables from the sourced defaults file
{
    echo "# Generated by update-grub"
    echo "# Source: $GRUB_DEFAULT_FILE"
    echo ""
    echo "set default=\"${GRUB_DEFAULT:-0}\""
    echo "set timeout=\"${GRUB_TIMEOUT:-5}\""
    echo ""
    echo "menuentry 'Ubuntu 24.04 LTS' {"
    echo "    insmod gzio"
    echo "    insmod part_gpt"
    echo "    insmod ext2"
    echo "    linux   /boot/vmlinuz-6.8.0-42-generic root=/dev/sda1 ro ${GRUB_CMDLINE_LINUX_DEFAULT} ${GRUB_CMDLINE_LINUX}"
    echo "    initrd  /boot/initrd.img-6.8.0-42-generic"
    echo "}"
} > "$GRUB_CFG"

echo "Sourced: $GRUB_DEFAULT_FILE"
echo "Wrote:   $GRUB_CFG"
