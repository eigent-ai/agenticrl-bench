<?php
$pageTitle = "Welcome Home";
$breadcrumbs = "Home > Dashboard > Overview";
$parts = split(">", $breadcrumbs);
?>
<html>
<head><title><?php echo htmlspecialchars($pageTitle); ?></title></head>
<body>
    <nav>
        <?php for ($i = 0; $i < count($parts); $i++): ?>
            <span><?php echo trim($parts[$i]); ?></span>
        <?php endfor; ?>
    </nav>
    <h1><?php echo $pageTitle; ?></h1>
    <div class="content">
        <p>Welcome to the application dashboard.</p>
    </div>
</body>
</html>
