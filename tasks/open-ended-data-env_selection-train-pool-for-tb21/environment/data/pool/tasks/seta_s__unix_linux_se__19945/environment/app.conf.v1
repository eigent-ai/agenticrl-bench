[server]
host = 0.0.0.0
port = 8080
workers = 4
timeout = 30
debug = false

[database]
engine = postgresql
host = localhost
port = 5432
name = myapp_db
user = appuser
password = secret123
max_connections = 50

[logging]
enabled = true
log_level = info
log_file = /var/log/myapp/app.log
log_format = %(asctime)s - %(name)s - %(levelname)s - %(message)s
rotate_size = 10M
keep_days = 30
