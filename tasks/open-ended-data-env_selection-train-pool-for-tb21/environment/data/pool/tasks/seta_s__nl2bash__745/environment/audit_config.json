{
  "patterns": [
    {
      "name": "eval_usage",
      "regex": "eval\\s*\\(",
      "category": "code_injection",
      "severity": "critical"
    },
    {
      "name": "system_call",
      "regex": "system\\s*\\(",
      "category": "command_injection",
      "severity": "critical"
    },
    {
      "name": "env_access",
      "regex": "\\$ENV\\{",
      "category": "env_exposure",
      "severity": "high"
    },
    {
      "name": "unsafe_open",
      "regex": "open\\s*\\(\\s*[^,]+[|<>]",
      "category": "unsafe_file_ops",
      "severity": "high"
    },
    {
      "name": "hardcoded_password",
      "regex": "DBI->connect\\(.+password",
      "category": "hardcoded_creds",
      "severity": "critical"
    },
    {
      "name": "cgi_usage",
      "regex": "use\\s+CGI\\b",
      "category": "deprecated_module",
      "severity": "medium"
    },
    {
      "name": "chmod_777",
      "regex": "chmod\\s+0?777",
      "category": "insecure_perms",
      "severity": "high"
    },
    {
      "name": "insecure_http",
      "regex": "http://",
      "category": "insecure_protocol",
      "severity": "low"
    }
  ]
}
