#!/bin/sh
. /etc/default/grub
CMDLINE="${GRUB_CMDLINE_LINUX_DEFAULT:+${GRUB_CMDLINE_LINUX_DEFAULT} }${GRUB_CMDLINE_LINUX}"
CMDLINE="${CMDLINE% }"
printf "menuentry 'Ubuntu Server 24.04' --class ubuntu {\n"
printf "    linux /boot/vmlinuz-5.15.0-server root=/dev/sda1 ro %s\n" "$CMDLINE"
printf "    initrd /boot/initrd.img-5.15.0-server\n"
printf "}\n"
