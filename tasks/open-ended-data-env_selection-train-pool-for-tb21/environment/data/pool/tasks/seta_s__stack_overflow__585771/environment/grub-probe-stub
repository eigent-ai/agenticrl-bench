#!/bin/bash
TARGET=""
PATH_ARG="/"

while [ $# -gt 0 ]; do
    case "$1" in
        --target=*)
            TARGET="${1#--target=}"
            shift
            ;;
        -t|--target)
            TARGET="$2"
            shift 2
            ;;
        --device|-d)
            shift 2
            ;;
        -*)
            shift
            ;;
        *)
            PATH_ARG="$1"
            shift
            ;;
    esac
done

case "$TARGET" in
    device)
        echo "/dev/sda1"
        ;;
    fs)
        echo "ext2"
        ;;
    fs_uuid)
        echo "abcd1234-ef56-7890-abcd-ef1234567890"
        ;;
    fs_label)
        echo ""
        ;;
    partuuid)
        echo ""
        ;;
    abstraction)
        echo ""
        ;;
    disk)
        echo "/dev/sda"
        ;;
    partmap)
        echo "msdos"
        ;;
    cryptodisk_uuid)
        exit 1
        ;;
    drive)
        echo "(hd0)"
        ;;
    hints_string)
        echo ""
        ;;
    zero_check)
        exit 0
        ;;
    *)
        echo "/dev/sda1"
        ;;
esac
exit 0
