{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["generated_at", "period_days", "packages"],
  "properties": {
    "generated_at": { "type": "string" },
    "period_days":  { "type": "integer" },
    "packages": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["name", "action", "version", "timestamp"],
            "additionalProperties": false,
            "properties": {
              "name":      { "type": "string" },
              "action":    { "type": "string", "enum": ["installed"] },
              "version":   { "type": "string" },
              "timestamp": { "type": "string" }
            }
          },
          {
            "type": "object",
            "required": ["name", "action", "from_version", "to_version", "timestamp"],
            "additionalProperties": false,
            "properties": {
              "name":         { "type": "string" },
              "action":       { "type": "string", "enum": ["upgraded"] },
              "from_version": { "type": "string" },
              "to_version":   { "type": "string" },
              "timestamp":    { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
