# AppArmor profile for restic-backup service
# Last modified: 2024-11-15

#include <tunables/global>

/usr/local/bin/restic-backup {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Allow reading the backup configuration
  /etc/restic-backup/** r,

  # Allow reading the restic binary
  /usr/local/bin/restic-backup mr,
  /usr/bin/restic mr,

  # Allow writing logs
  /var/log/restic-backup.log w,

  # Allow reading /etc files needed for operation
  /etc/passwd r,
  /etc/group r,
  /etc/nsswitch.conf r,

  # Allow temporary file access
  /tmp/** rw,
}
