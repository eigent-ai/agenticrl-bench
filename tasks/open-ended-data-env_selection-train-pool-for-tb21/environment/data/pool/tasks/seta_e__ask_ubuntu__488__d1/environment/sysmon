#!/bin/bash
# System Monitoring Agent - sysmon command
# Provided by package: sysmon-agent

case "$1" in
    --version|-v)
        echo "sysmon version 1.0.0 (sysmon-agent package)"
        ;;
    status)
        echo "System Monitor Status: Active"
        echo "Monitoring: CPU, Memory, Disk, Network"
        ;;
    *)
        echo "sysmon - System Monitoring Agent"
        echo "Usage: sysmon [--version|status]"
        echo "Provided by: sysmon-agent package"
        ;;
esac
