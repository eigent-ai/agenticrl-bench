#!/bin/bash
set -e
# shellcheck source=/etc/default/grub
source /etc/default/grub

CMDLINE="${GRUB_CMDLINE_LINUX_DEFAULT:-} ${GRUB_CMDLINE_LINUX:-}"
# Trim leading/trailing whitespace
CMDLINE="${CMDLINE#"${CMDLINE%%[![:space:]]*}"}"
CMDLINE="${CMDLINE%"${CMDLINE##*[![:space:]]}"}"

mkdir -p /boot/grub
cat > /boot/grub/grub.cfg << EOF
# Generated by mock update-grub
set default=${GRUB_DEFAULT:-0}
set timeout=${GRUB_TIMEOUT:-5}

menuentry "Ubuntu" {
    linux /boot/vmlinuz ${CMDLINE}
    initrd /boot/initrd.img
}
EOF
echo "update-grub: /boot/grub/grub.cfg updated."
