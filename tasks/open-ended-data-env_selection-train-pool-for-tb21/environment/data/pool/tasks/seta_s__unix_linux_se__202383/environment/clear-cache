#!/bin/bash

APP_HOME_VAL=""
DB_HOST_VAL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --app-home)
            APP_HOME_VAL="$2"
            shift 2
            ;;
        --db-host)
            DB_HOST_VAL="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [ -z "$APP_HOME_VAL" ]; then
    echo "ERROR: --app-home is required"
    exit 1
fi

if [ -z "$DB_HOST_VAL" ]; then
    echo "ERROR: --db-host is required"
    exit 1
fi

echo "cleared_at=$(date +%s)" > "$APP_HOME_VAL/var/cache_cleared.stamp"
echo "db_host=$DB_HOST_VAL" >> "$APP_HOME_VAL/var/cache_cleared.stamp"

echo "OK: Cache cleanup completed"
exit 0
