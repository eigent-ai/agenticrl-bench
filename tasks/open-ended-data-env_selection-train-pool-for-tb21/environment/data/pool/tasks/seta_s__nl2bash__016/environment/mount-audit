#!/usr/bin/env python3
"""Mount compliance auditor — reads /etc/mount-policy.conf and checks mount types."""
import json, sys, os
from datetime import datetime, timezone

POLICY_FILE  = "/etc/mount-policy.conf"
REPORT_DIR   = "/var/log/mount-audit"
REPORT_FILE  = os.path.join(REPORT_DIR, "report.json")
MOUNT_DB     = "/var/lib/mount-state/mounts.db"

def get_fstype(path):
    """Read the mount state database to determine filesystem type for path."""
    try:
        with open(MOUNT_DB) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                # Format: <mountpoint> <fstype>
                if len(parts) >= 2 and parts[0] == path:
                    return parts[1]
        return "none"
    except Exception:
        return "error"

def main():
    os.makedirs(REPORT_DIR, exist_ok=True)
    violations = []
    paths_checked = 0

    with open(POLICY_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) < 2:
                continue
            path, expected_type = parts[0], parts[1]
            paths_checked += 1
            actual = get_fstype(path)

            if expected_type == "tmpfs" and actual != "tmpfs":
                violations.append({"path": path, "expected": "tmpfs", "actual": actual})
            elif expected_type == "persistent" and actual == "tmpfs":
                violations.append({"path": path, "expected": "persistent (non-tmpfs)", "actual": actual})

    status = "compliant" if not violations else "non-compliant"
    report = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "paths_checked": paths_checked,
        "status": status,
        "violations": violations,
    }

    with open(REPORT_FILE, "w") as f:
        json.dump(report, f, indent=2)

    print(json.dumps(report, indent=2))
    sys.exit(0 if not violations else 1)

if __name__ == "__main__":
    main()
