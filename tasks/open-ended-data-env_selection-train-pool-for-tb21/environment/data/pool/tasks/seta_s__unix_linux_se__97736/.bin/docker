#!/bin/bash
# Wrapper around /usr/bin/docker that sanitises docker compose project names
# AND image names generated by harbor (trial IDs like __XxXxXx start with
# double underscore which Docker Compose v5 and the Docker daemon reject).

# Fix the MAIN_IMAGE_NAME env var: remove consecutive underscores and
# ensure the name starts and ends with an alphanumeric character.
if [[ -n "$MAIN_IMAGE_NAME" ]]; then
    # Remove every occurrence of __ (double underscore) entirely
    fixed_image="${MAIN_IMAGE_NAME//__/}"
    # Strip any remaining leading/trailing underscores
    fixed_image="${fixed_image#_}"
    fixed_image="${fixed_image%_}"
    # Prefix 'h' if the result starts with a digit
    if [[ "$fixed_image" =~ ^[0-9] ]]; then
        fixed_image="h${fixed_image}"
    fi
    # Fall back to 'hbtask' if result is empty
    [[ -z "$fixed_image" ]] && fixed_image="hbtask"
    export MAIN_IMAGE_NAME="$fixed_image"
fi

# Fix -p <project_name> argument: strip leading underscores.
args=()
fix_next=false
for arg in "$@"; do
    if $fix_next; then
        fixed="${arg#_}"
        fixed="${fixed#_}"
        if [[ "$fixed" =~ ^[0-9] ]]; then
            fixed="h${fixed}"
        fi
        args+=("$fixed")
        fix_next=false
    elif [ "$arg" = "-p" ]; then
        args+=("$arg")
        fix_next=true
    else
        args+=("$arg")
    fi
done

exec /usr/bin/docker "${args[@]}"
