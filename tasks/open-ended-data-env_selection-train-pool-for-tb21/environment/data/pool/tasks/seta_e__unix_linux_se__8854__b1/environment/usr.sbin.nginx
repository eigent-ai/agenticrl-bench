#include <tunables/global>

/usr/sbin/nginx {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  capability dac_override,
  capability net_bind_service,
  capability setgid,
  capability setuid,

  /usr/sbin/nginx mr,
  /etc/nginx/** r,
  /run/nginx.pid rw,
  /var/log/nginx/** w,
  /var/www/html/** r,

  # Local customizations
  #include <local/usr.sbin.nginx>
}
