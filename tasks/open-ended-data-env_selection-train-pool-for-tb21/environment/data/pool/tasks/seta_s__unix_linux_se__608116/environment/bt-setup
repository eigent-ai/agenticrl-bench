#!/bin/bash
set -eu

CONFIG_FILE="/etc/bt-setup.conf"
source "$CONFIG_FILE"

LOG_FILE="/var/log/bluetooth-setup.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Bluetooth setup service starting" >> "$LOG_FILE"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Device: $DEVICE_NAME" >> "$LOG_FILE"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Auto-enable: $AUTO_ENABLE" >> "$LOG_FILE"

rfkill unblock bluetooth 2>/dev/null || true
echo "[$(date '+%Y-%m-%d %H:%M:%S')] rfkill unblock completed" >> "$LOG_FILE"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Setup complete" >> "$LOG_FILE"
