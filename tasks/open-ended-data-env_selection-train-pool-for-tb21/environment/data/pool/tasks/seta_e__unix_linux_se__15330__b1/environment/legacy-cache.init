#!/bin/bash
# chkconfig: 2345 20 80
# description: Legacy Cache Service - obsolete caching layer

DAEMON_NAME="legacy-cache"
DAEMON_DESC="Legacy Cache Service"

case "$1" in
  start)
    echo "Starting ${DAEMON_DESC}..."
    ;;
  stop)
    echo "Stopping ${DAEMON_DESC}..."
    ;;
  status)
    echo "${DAEMON_DESC}: no process running"
    exit 0
    ;;
  restart)
    echo "Restarting ${DAEMON_DESC}..."
    ;;
  *)
    echo "Usage: /etc/rc.d/init.d/${DAEMON_NAME} {start|stop|status|restart}" >&2
    exit 1
    ;;
esac

exit 0
