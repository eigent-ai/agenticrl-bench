Host tunneluser-gw
    HostName localhost
    Port 2222
    User tunneluser
    IdentityFile /root/.ssh/tunneluser_key
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Host newadmin-gw
    HostName localhost
    Port 2222
    User newadmin
    IdentityFile /root/.ssh/newadmin_key
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
