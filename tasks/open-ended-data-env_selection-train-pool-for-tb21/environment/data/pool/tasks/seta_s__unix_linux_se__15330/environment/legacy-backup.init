#!/bin/bash
### BEGIN INIT INFO
# Provides:          legacy-backup
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Legacy Backup Service
# Description:       Legacy backup connector for decommissioned applications
### END INIT INFO

DAEMON_NAME="legacy-backup"
DAEMON_DESC="Legacy Backup Service"

case "$1" in
  start)
    echo "Starting ${DAEMON_DESC}..."
    ;;
  stop)
    echo "Stopping ${DAEMON_DESC}..."
    ;;
  status)
    echo "${DAEMON_DESC}: no process running"
    exit 0
    ;;
  restart|force-reload)
    echo "Restarting ${DAEMON_DESC}..."
    ;;
  *)
    echo "Usage: /etc/init.d/${DAEMON_NAME} {start|stop|status|restart|force-reload}" >&2
    exit 1
    ;;
esac

exit 0
