<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>utilities-terminal</icon>
    <name>Open Terminal Here</name>
    <submenu></submenu>
    <command>xfce4-terminal --working-directory=%f</command>
    <description>Open a terminal in the selected folder</description>
    <patterns>*</patterns>
    <startup-notify>false</startup-notify>
    <directories/>
  </action>
  <action>
    <icon>text-editor</icon>
    <name>Edit as Root</name>
    <submenu></submenu>
    <command>pkexec mousepad %f</command>
    <description>Open the selected file in a text editor as root</description>
    <patterns>*</patterns>
    <startup-notify>false</startup-notify>
    <text-files/>
  </action>
</actions>
