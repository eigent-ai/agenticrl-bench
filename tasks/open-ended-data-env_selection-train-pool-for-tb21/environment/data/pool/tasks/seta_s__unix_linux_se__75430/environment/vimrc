" Development environment settings
set nocompatible
filetype plugin indent on
syntax on

" Editor appearance
set number
set ruler
set showcmd
set laststatus=2

" Indentation
set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Automatically strip trailing whitespace before writing source files
augroup CleanWhitespace
    autocmd!
    autocmd BufWritePre *.py,*.rb,*.sh :%s/\s+$//e
augroup END

" Auto-format XML files with xmllint before writing
augroup XmlFormat
    autocmd!
    autocmd BufWritePost *.xml :%!xmllint --format -
augroup END
