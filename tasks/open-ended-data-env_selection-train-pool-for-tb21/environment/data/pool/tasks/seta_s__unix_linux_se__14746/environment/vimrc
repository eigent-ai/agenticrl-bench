set nocompatible
filetype plugin indent on
syntax on
set number
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent
set hlsearch
set incsearch
set ignorecase
set smartcase
set ruler
set showcmd
set showmatch
set wildmenu
set wildmode=longest:full,full
set backspace=indent,eol,start
autocmd VimEnter * call input("Press enter to continue")
set laststatus=2
set encoding=utf-8
set fileencoding=utf-8
