set nocompatible
set autoindent
set smartindent
set cindent
set number
set ruler
set expandtab
set shiftwidth=4
set tabstop=4
set softtabstop=4
set hlsearch
set incsearch
set showmatch
set laststatus=2
set background=dark
syntax on
filetype plugin indent on
autocmd BufRead *.txt set filetype=html
set backspace=indent,eol,start
set wildmenu
set showcmd
