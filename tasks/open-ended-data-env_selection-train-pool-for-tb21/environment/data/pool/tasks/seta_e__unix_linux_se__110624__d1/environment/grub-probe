#!/bin/bash
for arg in "$@"; do
    case "$arg" in
        --target=fs)           echo "ext2";   exit 0 ;;
        --target=device)       echo "/dev/sda"; exit 0 ;;
        --target=drive)        echo "(hd0)";  exit 0 ;;
        --target=abstraction)  echo "";        exit 0 ;;
        --target=fs_uuid)      echo "a1b2c3d4-e5f6-7890-abcd-ef1234567890"; exit 0 ;;
        --target=hints_string) echo "";        exit 0 ;;
        --target=partmap)      echo "msdos";  exit 0 ;;
        --target=mountpoint)   echo "/";       exit 0 ;;
        --target=fs_label)     echo "";        exit 0 ;;
        --target=disk)         echo "/dev/sda"; exit 0 ;;
    esac
done
exit 0
