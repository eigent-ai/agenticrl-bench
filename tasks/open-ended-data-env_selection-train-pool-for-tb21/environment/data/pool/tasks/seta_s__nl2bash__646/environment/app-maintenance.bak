# Application maintenance jobs
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 2 * * * root /opt/app/maintenance/db-vacuum.sh # change-enabled
15 3 * * 0 root /opt/app/maintenance/index-rebuild.sh # change-enabled
30 4 * * * root /opt/app/maintenance/log-compress.sh
