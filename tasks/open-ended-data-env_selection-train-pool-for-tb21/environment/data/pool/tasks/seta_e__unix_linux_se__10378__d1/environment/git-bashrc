# ~/.bashrc for git user
export PATH="$HOME/bin:$PATH"

# Check encrypted storage status
if [ -d "$HOME/.ecryptfs" ]; then
    MNT=$(cat "$HOME/.ecryptfs/Private.mnt" 2>/dev/null)
    if [ -n "$MNT" ] && mountpoint -q "$MNT" 2>/dev/null; then
        echo "Encrypted storage is mounted at $MNT"
    else
        echo "Warning: Encrypted storage is not currently mounted."
        echo "Run 'git-vault-mount' to mount it."
    fi
fi
