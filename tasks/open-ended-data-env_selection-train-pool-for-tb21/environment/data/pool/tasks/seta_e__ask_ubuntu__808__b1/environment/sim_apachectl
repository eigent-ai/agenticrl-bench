#!/bin/bash
if [ "$1" = "-M" ]; then
    cat /usr/local/share/apachectl_modules.txt
elif [ "$1" = "-S" ]; then
    cat /usr/local/share/apachectl_vhosts.txt
elif [ "$1" = "-t" ]; then
    echo "Syntax OK"
else
    echo "Usage: sim_apachectl [-M|-S|-t]"
    echo "  -M  List loaded modules"
    echo "  -S  Show virtual host settings"
    echo "  -t  Test configuration syntax"
fi
