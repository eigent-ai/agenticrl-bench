{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
        }
    },
    "handlers": {
        "pipeline_file": {
            "class": "logging.FileHandler",
            "filename": "/app/logs/pipeline.log",
            "formatter": "standard",
            "mode": "a"
        },
        "worker_handler": {
            "class": "logging.NullHandler"
        }
    },
    "loggers": {
        "pipeline": {
            "handlers": ["pipeline_file"],
            "level": "DEBUG",
            "propagate": false
        },
        "worker": {
            "handlers": ["worker_handler"],
            "level": "DEBUG",
            "propagate": false
        }
    }
}
